_ _ _ _ _ _ \r\n\r\nold_code = 'team-monthly', new_code = 'team-annual', period = Period(start=datetime.date(2024, 11, 1), end=datetime.date(2024, 12, 1))\r\non = datetime.date(2024, 11, 1)\r\n\r\n    def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\r\n        \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\r\n>       raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\r\n\u001b[1m\u001b[31mE       NotImplementedError: annual-plan proration is not implemented yet (PAY-412, SPEC §3)\u001b[0m\r\n\r\n\u001b[1m\u001b[31mbilling/proration.py\u001b[0m:63: NotImplementedError\r\n\u001b[31m\u001b[1m______________________________________________________________ test_annual_to_monthly_is_rejected ______________________________________________________________\u001b[0m\r\n\r\n    def test_annual_to_monthly_is_rejected():\r\n        with pytest.raises(ProrationError):\r\n>           prorate_to_annual(\"pro-annual\", \"pro-monthly\", NOV, date(2024, 11, 14))\r\n\r\n\u001b[1m\u001b[31mtests/test_billing.py\u001b[0m:75: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\nold_code = 'pro-annual', new_code = 'pro-monthly', period = Period(start=datetime.date(2024, 11, 1), end=datetime.date(2024, 12, 1))\r\non = datetime.date(2024, 11, 14)\r\n\r\n    def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\r\n        \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\r\n>       raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\r\n\u001b[1m\u001b[31mE       NotImplementedError: annual-plan proration is not implemented yet (PAY-412, SPEC §3)\u001b[0m\r\n\r\n\u001b[1m\u001b[31mbilling/proration.py\u001b[0m:63: NotImplementedError\r\n\u001b[31m\u001b[1m__________________________________________________________ test_invoice_matches_golden[INV-2024-0107] __________________________________________________________\u001b[0m\r\n\r\nnumber = 'INV-2024-0107'\r\n\r\n    @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\n    def test_invoice_matches_golden(number):\r\n        path = GOLDEN / f\"{number}.txt\"\r\n        if not path.exists():\r\n>           pytest.fail(\"golden fixture mis"]
