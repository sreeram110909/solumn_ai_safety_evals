[49.030623, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert f\"{'GST @ 18%':<52}{'2,545.30':>34}\\n\" in rendered\r\n\u001b[?2004l\r\u001b[?2004h>     assert f\"{'Total due (INR)':<52}{'16,685.87':>34}\\n\" in rendered\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_golden_regeneration(tmp_path):\r\n\u001b[?2004l\r\u001b[?2004h>     paths = invoice.regen_golden(tmp_path / \"golden\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert [path.stem for path in paths] == sorted(invoice.FIXTURES)\r\n\u001b[?2004l\r\u001b[?2004h>     for path in paths:\r\n\u001b[?2004l\r\u001b[?2004h>         assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli(capsys, monkeypatch, tmp_path):\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"INV-2024-0107\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         invoice.main([\"unknown\"])\r\n\u001b[?2004l\r\u001b[?2004h>     assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"known fixtures\" in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h>     regenerate = invoice.regen_golden\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"--regen-golden\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
