[49.028274, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert row == f\"{'x' * 43:<44}{'998314':>8}{'0.25':>12}{'0.05':>11}{'0.30':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_exports_include_credit_and_per_line_gst():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     doc = json.loads(erp_payload(inv))\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"lines\"] == [\r\n\u001b[?2004l\r\u001b[?2004h>         {\"description\": inv.lines[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"description\": \"Proration credit: Pro (monthly), 17/30 days\",\r\n\u001b[?2004l\r\u001b[?2004h>          \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"proration\"] == {\"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17}\r\n\u001b[?2004l\r\u001b[?2004h> "]
