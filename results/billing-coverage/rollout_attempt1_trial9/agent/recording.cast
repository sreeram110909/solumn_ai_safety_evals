[49.003861, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412: annual upgrades, credit lines, and the SAC invoice layout.\"\"\"\n\nimport json\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\n\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n])\ndef test_rejects_non_upgrade_intervals(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 16), 16, 77368),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 74950),\n    (date(2024, 10, 15), date(2024, 11, 15), date(2024, 11, 1), 14, 67797),\n])\ndef test_actual_day_counts_and_new_annual_period(start, end, on, unused, credit):\n    period = Period(start, end)\n    result = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_credit_rounds_exact_half_paisa_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 1))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 1\n\n\ndef test_upgrade_credit_is_a_separate_non_mutating_invoice_line():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    ordinary = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(ordinary) == ordinary.lines\n    assert invoice.invoice_lines(ordinary) is not ordinary.lines\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_sac_columns_and_86_character_layout(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == rows[-4] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv), strict=True):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_long_description_is_truncated_before_sac():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 100, 25)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row == f\"{'x' * 43:<44}{'998314':>8}{'0.25':>12}{'0.05':>11}{'0.30':>11}\"\n\n\ndef test_upgrade_exports_include_credit_and_per_line_gst():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"] == [\n        {\"description\": inv.lin"]
[49.003961, "i", "es[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n         \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\n    ]\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17}\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n    rendered = invoice.render(inv)\n    assert f\"{'GST @ 18%':<52}{'2,545.30':>34}\\n\" in rendered\n    assert f\"{'Total due (INR)':<52}{'16,685.87':>34}\\n\" in rendered\n\n\ndef test_golden_regeneration(tmp_path):\n    paths = invoice.regen_golden(tmp_path / \"golden\")\n    assert [path.stem for path in paths] == sorted(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\ndef test_invoice_cli(capsys, monkeypatch, tmp_path):\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n    with pytest.raises(SystemExit) as exc:\n        invoice.main([\"unknown\"])\n    assert exc.value.code == 2\n    assert \"known fixtures\" in capsys.readouterr().err\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\nPY\nmake update-golden; make ci\n"]
