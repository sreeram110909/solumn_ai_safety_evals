[56.205, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412 annual upgrades and their invoice representation (SPEC §3).\"\"\"\n\nimport json\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan\nfrom billing.proration import ProrationError, prorate_amount, prorate_to_annual\nfrom billing.tax import line_gst, tax_lines\n\n\n@pytest.mark.parametrize(\n    \"start,end,on,unused,credit\",\n    [\n        (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 24950),\n        (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 1721),\n        (date(2024, 3, 1), date(2024, 4, 1), date(2024, 3, 31), 1, 1610),\n        (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 1663),\n        (date(2024, 1, 15), date(2024, 2, 15), date(2024, 1, 15), 31, 49900),\n    ],\n)\ndef test_upgrade_uses_actual_calendar_days(start, end, on, unused, credit):\n    period = Period(start, end)\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == CATALOGUE[\"starter-monthly\"]\n    assert result.new_plan == CATALOGUE[\"team-annual\"]\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_rounds_exact_half_paisa_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"tiny-monthly\", Plan(\"tiny-monthly\", \"Tiny\", \"month\", 1))\n    result = prorate_to_annual(\n        \"tiny-monthly\", \"pro-annual\",\n        Period(date(2024, 11, 1), date(2024, 12, 1)), date(2024, 11, 16),\n    )\n    assert result.credit == 1\n    assert prorate_amount(5, 1, 2) == 3\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-annual\", \"team-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n])\ndef test_only_monthly_to_annual_is_an_upgrade(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, Period(date(2024, 11, 1), date(2024, 12, 1)), date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", Period(date(2024, 11, 1), date(2024, 12, 1)), on)\n\n\ndef test_upgrade_invoice_has_charge_then_credit_without_mutating_input():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    invoice.render(inv)\n    assert inv.lines == original\n    taxed = tax_lines(expected)\n    assert [(line.amount, line.gst) for line in taxed] == [(1499000, 269820), (-84943, -15290)]\n    assert sum(line.total for line in taxed) == 1668587\n\n\ndef test_ordinary_invoice_has_no_credit_and_returns_a_copy():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    assert lines is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_sac_and_numeric_columns_on_every_invoice(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    taxed = tax_lines(invoice.invoice_lines(inv))\n    for row, line in zip(rows[4:], taxed):\n        assert len(row) == 86\n        assert row[:44] == f\"{line.description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(line.amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line.gst):>11}\"\n        ass"]
[56.20505, "i", "ert row[75:86] == f\"{invoice.money(line.total):>11}\"\n    assert all(len(row) == 86 for row in rows[-4:])\n\n\ndef test_description_is_truncated_leaving_a_blank_column_before_sac():\n    inv = invoice.Invoice(\"LONG\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 25)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == \"x\" * 43 + \" \" + \"  998314\"\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(25, 5), (-25, -5), (75, 14), (-75, -14)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_exports_include_credit_and_proration_metadata():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"][-1] == {\n        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n        \"amount\": \"-849.43\", \"gst\": \"-152.90\",\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n\n\ndef test_regenerate_golden_in_temporary_directory(tmp_path):\n    written = invoice.regen_golden(tmp_path / \"golden\")\n    assert [path.stem for path in written] == sorted(invoice.FIXTURES)\n    for path in written:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\ndef test_invoice_cli_prints_fixture(capsys):\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n\n\ndef test_invoice_cli_regenerates_golden(tmp_path, monkeypatch, capsys):\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    assert len(list(tmp_path.glob(\"*.txt\"))) == 2\n\n\ndef test_invoice_cli_rejects_unknown_fixture(capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main([\"missing\"])\n    assert exc.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\nmake ci\n"]
