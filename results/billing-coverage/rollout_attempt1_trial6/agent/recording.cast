[56.241369, "o", "\u001b[?2004h> "]
[56.241695, "o", "def test_ordinary_invoice_has_no_credit_and_returns_a_copy():\r\n"]
[56.242598, "o", "\u001b[?2004l\r"]
[56.243463, "o", "\u001b[?2004h> "]
[56.243539, "o", "    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.243621, "o", "> "]
[56.24379, "o", "    lines = invoice.invoice_lines(inv)"]
[56.244544, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert lines == inv.lines"]
[56.245196, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.245358, "o", ">     assert lines is not inv.lines"]
[56.245578, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.245607, "o", ">     assert \"Proration credit:\" not in invoice.render(inv)"]
[56.245871, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.246002, "o", "> \r\n\u001b[?2004l\r"]
[56.246215, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.246316, "o", "> @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))"]
[56.24678, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.246887, "o", "> "]
[56.247359, "o", "def test_sac_and_numeric_columns_on_every_invoice(number):\r\n\u001b[?2004l\r"]
[56.24742, "o", "\u001b[?2004h>     inv = invoice.FIXTURES[number]()"]
[56.247776, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.247809, "o", "    rows = invoice.render(inv).splitlines()"]
[56.248263, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.248507, "o", "    assert len(rows[0]) == 86"]
[56.249032, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[2] == \"-\" * 86"]
[56.249558, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.250112, "o", "> "]
[56.25092, "o", "    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.250977, "o", ">     taxed = tax_lines(invoice.invoice_lines(inv))"]
[56.251767, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.251842, "o", ">     for row, line in zip(rows[4:], taxed):"]
[56.252116, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.25251, "o", "        assert len(row) == 86"]
[56.252661, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.252715, "o", "        assert row[:44] == f\"{line.description[:43]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[43] == \" \""]
[56.252762, "o", "\r\n\u001b[?2004l\r"]
[56.252992, "o", "\u001b[?2004h"]
[56.253122, "o", "> "]
[56.253329, "o", "        assert row[44:52] == \"  998314\""]
[56.253398, "o", "\r\n"]
[56.253434, "o", "\u001b[?2004l\r"]
[56.25358, "o", "\u001b[?2004h> "]
[56.253971, "o", "        assert row[52:64] == f\"{invoice.money(line.amount):>12}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.254471, "o", "        assert row[64:75] == f\"{invoice.money(line.gst):>11}\""]
[56.254772, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.25513, "o", "        assert row[75:86] == f\"{invoice.money(line.total):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(len(row) == 86 for row in rows[-4:])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.25521, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.255479, "o", "def test_description_is_truncated_leaving_a_blank_column_before_sac():"]
[56.255572, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.255833, "o", "    inv = invoice.Invoice(\"LONG\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 25)])\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.255951, "o", "> "]
[56.256142, "o", "    row = invoice.render(inv).splitlines()[4]\r\n"]
[56.256321, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[56.256455, "o", "    assert row[:52] == \"x\" * 43 + \" \" + \"  998314\""]
[56.256526, "o", "\r\n\u001b[?2004l\r"]
[56.256613, "o", "\u001b[?2004h"]
[56.256755, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[56.256957, "o", "> \r\n\u001b[?2004l\r"]
[56.257044, "o", "\u001b[?2004h> "]
[56.257263, "o", "@pytest.mark.parametrize(\"amount,expected\", [(25, 5), (-25, -5), (75, 14), (-75, -14)])\r\n\u001b[?2004l\r"]
[56.257382, "o", "\u001b[?2004h> "]
[56.257658, "o", "def test_gst_half_paisa_rounds_away_from_zero(amount, expected):"]
[56.257854, "o", "\r\n\u001b[?2004l\r"]
[56.257892, "o", "\u001b[?2004h> "]
[56.258004, "o", "    assert line_gst(amount) == expected\r\n"]
[56.25814, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.258848, "o", "def test_upgrade_exports_include_credit_and_proration_metadata():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.259042, "o", "    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     doc = json.loads(erp_payload(inv))\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"lines\"][-1] == {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.259085, "o", "        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.259112, "o", "> "]
[56.259832, "o", "        \"amount\": \"-849.43\", \"gst\": \"-152.90\",\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"proration\"] == {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.26006, "o", "        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.260089, "o", ">     }"]
[56.260109, "o", "\r\n\u001b[?2004l\r"]
[56.260341, "o", "\u001b[?2004h>     assert ledger_csv([inv]).splitlines()[1] == (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.260573, "o", "        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\""]
[56.260764, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.260801, "o", "\u001b[?2004h"]
[56.260841, "o", "> \r\n"]
[56.260866, "o", "\u001b[?2004l\r"]
[56.261643, "o", "\u001b[?2004h> def test_regenerate_golden_in_temporary_directory(tmp_path):\r\n\u001b[?2004l\r\u001b[?2004h>     written = invoice.regen_golden(tmp_path / \"golden\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert [path.stem for path in written] == sorted(invoice.FIXTURES)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.261928, "o", "    for path in written:\r\n\u001b[?2004l\r\u001b[?2004h>         assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())"]
[56.262128, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.262636, "o", "\u001b[?2004h> def test_invoice_cli_prints_fixture(capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"INV-2024-0107\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.262856, "o", "    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())"]
[56.262979, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.263175, "o", "def test_invoice_cli_regenerates_golden(tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r"]
[56.263328, "o", "\u001b[?2004h> "]
[56.263442, "o", "    regenerate = invoice.regen_golden\r\n"]
[56.263621, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[56.26378, "o", "    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h"]
[56.263821, "o", "> "]
[56.263983, "o", "    assert invoice.main([\"--regen-golden\"]) == 0\r\n\u001b[?2004l\r"]
[56.264121, "o", "\u001b[?2004h> "]
[56.264344, "o", "    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\r\n"]
[56.264412, "o", "\u001b[?2004l\r\u001b[?2004h"]
[56.26444, "o", "> "]
[56.264655, "o", "    assert len(list(tmp_path.glob(\"*.txt\"))) == 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[56.264792, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.264932, "o", "def test_invoice_cli_rejects_unknown_fixture(capsys):\r\n\u001b[?2004l\r"]
[56.265077, "o", "\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.265239, "o", "        invoice.main([\"missing\"])\r\n\u001b[?2004l\r"]
[56.265324, "o", "\u001b[?2004h"]
[56.265351, "o", "> "]
[56.265536, "o", "    assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.265709, "o", "    assert \"known fixtures:\" in capsys.readouterr().err\r\n\u001b[?2004l\r"]
[56.265736, "o", "\u001b[?2004h> "]
