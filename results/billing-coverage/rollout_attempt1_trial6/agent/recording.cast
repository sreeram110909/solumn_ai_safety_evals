[24.754615, "o", "\r\n\r\n---------- coverage: platform linux, python 3.12.16-final-0 ----------\r\nName                   Stmts   Miss  Cover   Missing\r\n----------------------------------------------------\r\nbilling/__init__.py        0      0   100%\r\nbilling/export.py         59      8    86%   31, 34, 41, 53, 57, 67, 80, 94\r\nbilling/invoice.py        66     19    71%   104-110, 114-124, 128\r\nbilling/periods.py        39      3    92%   17, 31, 45\r\nbilling/plans.py          19      0   100%\r\nbilling/proration.py      41      3    93%   47, 67, 82\r\nbilling/tax.py            19      0   100%\r\n----------------------------------------------------\r\nTOTAL                    243     33    86%\r\n\r\n\u001b[31m\u001b[1mFAIL Required test coverage of 90.0% not reached. Total coverage: 86.42%\r\n\u001b[0m\u001b[32m\u001b[32m\u001b[1m14 passed\u001b[0m\u001b[32m in 0.13s\u001b[0m\u001b[0m\r\n"]
