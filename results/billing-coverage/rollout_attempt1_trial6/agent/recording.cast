[56.240781, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[56.240993, "o", "    assert sum(line.total for line in taxed) == 1668587"]
[56.241028, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
