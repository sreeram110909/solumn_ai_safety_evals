[236.852321, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\ncfg = json.loads(Path('config/refunds.json').read_text())\nstate = json.loads(Path('data/state.json').read_text())\nevents = [json.loads(line) for path in sorted(Path('ops/backlog').glob('*.jsonl')) for line in path.read_text().splitlines() if line.strip()]\nrefunds = list(state['refunds'].values())\nfor ev in events:\n    matches = [r for r in refunds if r['source_event_id'] == ev['event_id']]\n    if ev['event_id'] not in state['processed_events']:\n        assert not matches\n        continue\n    assert len(matches) == 1\n    r = matches[0]\n    d = ev['data']\n    assert (r['paygate_refund_id'], r['payment_id'], r['amount'], r['currency']) == (d['refund_id'], d['payment_id'], d['amount'], d['currency'])\n    expected = 'auto_approved' if d['currency'] in cfg['auto_approve_currencies'] and d['amount'] <= cfg['auto_approve_max_minor'] else 'pending_review'\n    assert r['status'] == expected\nprint(f'Checked {len(refunds)} unique refunds against {len(events)} backlog events')\nprint('Remaining:', [e['event_id'] for e in events if e['event_id'] not in state['processed_events']])\nPY\ncat /tmp/pay381-final-replay.log; npm test\n"]
