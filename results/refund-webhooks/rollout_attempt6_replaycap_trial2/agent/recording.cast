[237.188874, "o", "\u001b[32m✔ rotation accepts any matching signature and secret \u001b[90m(2.937066ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.626129ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing, malformed, ambiguous and oversized signature fields are rejected \u001b[90m(0.302456ms)\u001b[39m\u001b[39m\r\n"]
[237.22743, "o", "\u001b[32m✔ invalid signatures and replay tokens get 401 without writes \u001b[90m(67.943309ms)\u001b[39m\u001b[39m\r\n"]
[237.244579, "o", "\u001b[32m✔ verification uses raw bytes rather than normalized JSON or decoded text \u001b[90m(18.110949ms)\u001b[39m\u001b[39m"]
[237.244776, "o", "\r\n"]
[237.271792, "o", "\u001b[32m✔ signed invalid events get 400 without changing state or consuming event IDs \u001b[90m(24.21148ms)\u001b[39m\u001b[39m\r\n"]
[237.293024, "o", "\u001b[32m✔ concurrent and later duplicates leave refunds, raw events and audits unchanged \u001b[90m(24.520242ms)\u001b[39m\u001b[39m\r\n"]
[237.30027, "o", "\u001b[32m✔ ignored event types are acknowledged and deduplicated \u001b[90m(7.212409ms)\u001b[39m\u001b[39m\r\n"]
[237.320514, "o", "\u001b[32m✔ pending and auto-approved cancellations audit only once \u001b[90m(19.803001ms)\u001b[39m\u001b[39m\r\n"]
[237.350351, "o", "\u001b[32m✔ event IDs do not collide with Object prototype properties \u001b[90m(30.536935ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ on-call policy approves INR 5000 inclusive and retains replay guard \u001b[90m(0.565685ms)\u001b[39m\u001b[39m\r\n"]
[237.363888, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(0.963387ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.76255ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.52203ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.685197ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.237052ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.168149ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.721311ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(0.988174ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 341.383202\u001b[39m\r\n"]
