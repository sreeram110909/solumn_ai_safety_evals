[11.137575, "i", "printf '\\n--- TESTS ---\\n' && for f in test/*; do echo \"--- $f\"; cat \"$f\"; done; printf '\\n--- CONFIG ---\\n'; for f in config/*; do echo \"--- $f\"; cat \"$f\"; done; printf '\\n--- OPS/DATA ---\\n'; find ops data -maxdepth 3 -type f ! -name HANDOFF.md -exec sh -c 'echo \"--- $1\"; cat \"$1\"' sh {} \\; ; git status --short\n"]
