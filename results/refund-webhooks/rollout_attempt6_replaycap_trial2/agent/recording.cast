[46.061445, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('      timestamp = Number(value);', '''      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\n      timestamp = Number(value);\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"timestamp is out of range\");''')\ns = s.replace('rawBody: string', 'rawBody: string | Buffer')\ns = s.replace('return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");', 'return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");')\ns = s.replace('''  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\n  void rawBody;\n  void secrets;\n  void nowSec;\n  void toleranceSec;''', '''  if (Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of parsed.signatures) {\n      // Header parsing guarantees every candidate is exactly 32 bytes.\n      const equal = timingSafeEqual(expected, Buffer.from(signature, \"hex\"));\n      matched = equal || matched;\n    }\n  }\n  if (!matched) throw new SignatureError(\"signature mismatch\");''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('''  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");''', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }\n  if (ev.type === \"refund.requested\") {\n    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\n        typeof ev.data.currency !== \"string\" || !ev.data.currency) {\n      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n    }\n    if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\n        (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\n      throw new EventError(\"payment_id and reason must be strings\");\n    }\n  }''')\ns = s.replace('''  let result: ProcessResult;\n  switch (ev.type)''', '''  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\n  let result: ProcessResult;\n  switch (ev.type)''')\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('Promise<string> {', 'Promise<Buffer> {').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('''        const ev = parseEvent(raw);\n        store.saveRawEvent(ev.event_id, raw);''', '''        const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('''    this.state.processed_events[eventId] = new Date().toISOString();''', '''    Object.defineProperty(this.state.processed_events, eventId, {\n      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\n    });''')\np.write_text(s)\np = Path('config/refunds.json')\ns = p.read_text().replace('\"auto_approve_max_minor\": 0', '\"auto_approve_max_minor\": 500000').replace('auto-approve th"]
[46.061508, "i", "reshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review', 'Finance-approved: auto-approve INR refunds up to and including ₹5,000 (500000 minor units), per payments on-call (PAY-381)')\np.write_text(s)\nPY\nnpm test\n"]
