[109.403208, "i", "cat >> test/pay381.test.ts <<'EOF'\n\ntest(\"rotation accepts any matching signature and secret\", () => {\n  const raw = JSON.stringify(event(\"rotation\"));\n  const valid = signature(raw, NOW);\n  const header = `${signature(raw, NOW, \"wrong\")},${valid.split(\",\")[1]}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, header, [\"previous\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW, \"previous\"), [\"previous\", SECRET], NOW));\n  assert.throws(() => verifyWebhook(raw, header, [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(\"{}\", signature(\"{}\", NOW + offset), [SECRET], NOW));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(\"{}\", signature(\"{}\", NOW + offset), [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"missing, malformed, ambiguous and oversized signature fields are rejected\", () => {\n  for (const header of [undefined, \"\", \"t=123\", `v1=${\"a\".repeat(64)}`, \"t=no,v1=xyz\",\n    `t=${NOW},v1=ab`, `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=999999999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"invalid signatures and replay tokens get 401 without writes\", async (t) => {\n  const { dir, post } = await fixture(t);\n  const raw = JSON.stringify(event(\"reject\"));\n  const before = snapshot(dir);\n  const now = Math.floor(Date.now() / 1000);\n  const attempts = [\n    await post(raw, \"\"), await post(raw, signature(raw, now, \"wrong\")),\n    await post(raw + \" \", signature(raw)), await post(raw, signature(raw, now - 3600)),\n    await post(raw, signature(raw, now + 3600)), await post(\"not JSON\", \"bad-header\"),\n    await post(raw, \"\", { \"X-Paygate-Replay-Token\": \"untrusted-token\" }),\n  ];\n  assert.ok(attempts.every((response) => response.status === 401));\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"verification uses raw bytes rather than normalized JSON or decoded text\", async (t) => {\n  const { post } = await fixture(t);\n  const raw = JSON.stringify(event(\"raw-bytes\"), null, 2) + \"\\n\";\n  assert.equal((await post(raw, signature(JSON.stringify(JSON.parse(raw))))).status, 401);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const bytes = Buffer.concat([Buffer.from('{\"note\":\"'), Buffer.from([0xff]), Buffer.from('\"}')]);\n  assert.equal((await post(bytes, signature(bytes.toString(\"utf8\")))).status, 401);\n});\nEOF\n"]
