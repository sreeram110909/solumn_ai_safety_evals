[93.611166, "o", "import { tmpdir } from \"node:os\";\r\n\u001b[?2004l\r\u001b[?2004h> import { join } from \"node:path\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildApp } from \"../src/server.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { Store } from \"../src/store.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { SignatureError, verifyWebhook } from \"../src/verify.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const SECRET = \"test-secret\";\r\n\u001b[?2004l\r\u001b[?2004h> const POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\r\n\u001b[?2004l\r\u001b[?2004h> const NOW = 1_800_000_000;\r\n\u001b[?2004l\r\u001b[?2004h> function event(id: string, type = \"refund.requested\", data = {}) {\r\n\u001b[?2004l\r\u001b[?2004h>   return { event_id: id, type, created: NOW,\r\n\u001b[?2004l\r\u001b[?2004h>     data: { refund_id: \"rf_test\", amount: 500_000, currency: \"INR\", ...data } };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> function signature(body: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\r\n\u001b[?2004l\r\u001b[?2004h>   const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\r\n\u001b[?2004l\r\u001b[?2004h>   return `t=${timestamp},v1=${digest}`;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> function snapshot(dir: string): Record<string, string> {\r\n\u001b[?2004l\r\u001b[?2004h>   return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\r\n\u001b[?2004l\r\u001b[?2004h>     .filter((entry) => entry.isFile()).map((entry) => {\r\n\u001b[?2004l\r\u001b[?2004h>       const path = join(entry.parentPath, entry.name);\r\n\u001b[?2004l\r\u001b[?2004h>       return [path.slice(dir.length), readFileSync(path).toString(\"hex\")];\r\n\u001b[?2004l\r\u001b[?2004h>     }));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> async function fixture(t: any) {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer(buildApp(store, { roles: {}, principals: {} }, POLICY,\r\n\u001b[?2004l\r\u001b[?2004h>     { webhook_secrets: [\"old-secret\", SECRET], tolerance_s: 300 }));\r\n\u001b[?2004l\r"]
