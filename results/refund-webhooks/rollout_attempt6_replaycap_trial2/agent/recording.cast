[46.532551, "o", "\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.195027ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.090725ms)\u001b[39m\u001b[39m\r\n"]
[46.532718, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.844744ms)\u001b[39m\u001b[39m\r\n"]
[46.532821, "o", "\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.162278ms)\u001b[39m\u001b[39m\r\n"]
