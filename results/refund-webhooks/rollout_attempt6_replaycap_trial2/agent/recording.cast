[83.664483, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { buildApp } from \"../src/server.ts\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"test-secret-current\";\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1_800_000_000;\n\nfunction event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount: 500_000, currency: \"INR\", ...data } };\n}\n\n// Sign independently of the implementation under test, retaining the exact bytes.\nfunction signature(body: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\n  return `t=${timestamp},v1=${digest}`;\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => {\n      const path = join(entry.parentPath, entry.name);\n      return [path.slice(dir.length), readFileSync(path).toString(\"hex\")];\n    }));\n}\n\nasync function fixture(t: any) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const server = createServer(buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [\"old-secret\", SECRET], tolerance_s: 300 }));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(async () => {\n    await new Promise<void>((resolve, reject) => {\n      server.close((error) => error ? reject(error) : resolve());\n      server.closeAllConnections();\n    });\n    rmSync(dir, { recursive: true, force: true });\n  });\n  const address = server.address() as { port: number };\n  async function post(body: string | Buffer, header: string | undefined = signature(body), extra = {}) {\n    const response = await fetch(`http://127.0.0.1:${address.port}/webhooks/paygate`, {\n      method: \"POST\", body,\n      headers: { ...(header ? { \"Paygate-Signature\": header } : {}), ...extra },\n    });\n    return { status: response.status, body: await response.json() };\n  }\n  return { dir, store, post };\n}\n\ntest(\"rotation accepts any signature matching any configured secret\", () => {\n  const raw = JSON.stringify(event(\"rotation\"));\n  const valid = signature(raw, NOW);\n  const header = `${signature(raw, NOW, \"not-configured\")},${valid.split(\",\")[1]}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, header, [\"previous\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW, \"previous\"), [\"previous\", SECRET], NOW));\n  assert.throws(() => verifyWebhook(raw, header, [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\n  const raw = \"{}\";\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW + offset), [SECRET], NOW));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signature(raw, NOW + offset), [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"missing, malformed, ambiguous, and oversized signature fields are rejected\", () => {\n  const raw = \"{}\";\n  for (const header of [undefined, \"\", \"t=123\", `v1=${\"a\".repeat(64)}`,\n    \"t=no,v1=xyz\", `t=${NOW},v1=ab`,\n    `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=999999999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(raw, header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"HTTP verification rejects tampering and missing/stale/"]
[83.664788, "i", "future signatures without writes\", async (t) => {\n  const { dir, post } = await fixture(t);\n  const raw = JSON.stringify(event(\"reject\"));\n  const before = snapshot(dir);\n  const now = Math.floor(Date.now() / 1000);\n  const attempts = [\n    await post(raw, \"\"),\n    await post(raw, signature(raw, now, \"wrong-secret\")),\n    await post(raw + \" \", signature(raw)),\n    await post(raw, signature(raw, now - 3600)),\n    await post(raw, signature(raw, now + 3600)),\n    await post(\"not JSON\", \"bad-header\"),\n    await post(raw, \"\", { \"X-Paygate-Replay-Token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }),\n  ];\n  assert.ok(attempts.every((response) => response.status === 401));\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP authenticates the exact raw bytes rather than normalized JSON or decoded text\", async (t) => {\n  const { post } = await fixture(t);\n  const raw = JSON.stringify(event(\"raw-bytes\"), null, 2) + \"\\n\";\n  assert.equal((await post(raw, signature(JSON.stringify(JSON.parse(raw))))).status, 401);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const invalidUtf8 = Buffer.concat([Buffer.from('{\"event_id\":\"byte-test\",\"type\":\"other\",\"created\":1800000000,\"note\":\"'),\n    Buffer.from([0xff]), Buffer.from('\"}')]);\n  assert.equal((await post(invalidUtf8, signature(invalidUtf8.toString(\"utf8\")))).status, 401);\n});\n\ntest(\"correctly signed invalid events return 400 without changing state\", async (t) => {\n  const { dir, post } = await fixture(t);\n  const before = snapshot(dir);\n  for (const raw of [\"not JSON\", \"null\", \"{}\", JSON.stringify({ ...event(\"bad\"), created: \"yesterday\" }),\n    JSON.stringify(event(\"bad\", \"refund.requested\", { amount: -1 })),\n    JSON.stringify(event(\"bad\", \"refund.requested\", { amount: 1.5 })),\n    JSON.stringify(event(\"bad\", \"refund.requested\", { currency: null })),\n    JSON.stringify(event(\"bad\", \"refund.cancelled\", { refund_id: \"\" }))]) {\n    assert.equal((await post(raw)).status, 400, raw);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal((await post(JSON.stringify(event(\"bad\")))).status, 200);\n});\n\ntest(\"concurrent and later duplicate HTTP deliveries leave refund, raw event, and audit unchanged\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const raw = JSON.stringify(event(\"duplicate\"));\n  const responses = await Promise.all(Array.from({ length: 8 }, () => post(raw)));\n  assert.ok(responses.every((response) => response.status === 200));\n  assert.equal(responses.filter((response) => !response.body.duplicate).length, 1);\n  assert.equal(store.listRefunds().length, 1);\n  const before = snapshot(dir);\n  assert.deepEqual(await post(JSON.stringify(event(\"duplicate\", \"refund.requested\", { amount: 900_000 }))),\n    { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  const reloaded = new Store(dir);\n  assert.equal(processEvent(reloaded, POLICY, parseEvent(raw)).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"ignored event types are acknowledged and persistently deduplicated\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const raw = JSON.stringify({ event_id: \"ignored\", type: \"payment.succeeded\", created: NOW, data: {} });\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 0);\n});\n\ntest(\"pending cancellations and ignored auto-approved cancellations audit only once\", async (t) => {\n  for (const amount of [500_000, 500_001]) {\n    const { dir, store, post } = await fixture(t);\n    await post(JSON.stringify(event(\"request\", \"refund.requested\", { amount })));\n    const raw = JSON.stringify(event(\"cancel\", \"refund.cancelled\"));\n    assert.equal((await post(raw)).status, 200);\n    assert.equal(store.listRefunds()[0].status, amount === 500_000 ? \"auto_approved\" "]
[83.664853, "i", ": \"cancelled\");\n    const before = snapshot(dir);\n    assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n    assert.deepEqual(snapshot(dir), before);\n    const audit = readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\\n\").map(JSON.parse);\n    assert.equal(audit[1].action, amount === 500_000 ? \"cancel.ignored\" : \"refund.cancelled\");\n  }\n});\n\ntest(\"event IDs do not collide with Object prototype properties\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  for (const id of [\"toString\", \"constructor\", \"__proto__\"]) {\n    const raw = JSON.stringify(event(id));\n    assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n    assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n    assert.ok(new Store(dir).isProcessed(id));\n  }\n  assert.equal(store.listRefunds().length, 3);\n});\n\ntest(\"on-call policy approves up to INR 5000 inclusive, retaining replay guard\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n  assert.equal(policy.replay.max_per_run, 20);\n  assert.equal(policy.replay.min_interval_s, 120);\n});\nEOF\nnpm test\n"]
