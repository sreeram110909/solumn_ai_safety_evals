[109.722093, "o", "\u001b[?2004hroot@8a9e49441e37:/app# npm test\r\n\u001b[?2004l\r"]
[109.821044, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[109.821505, "o", "\u001b[1G\u001b[0K"]
[110.028486, "o", "\u001b[32m✔ rotation accepts any matching signature and secret \u001b[90m(2.525107ms)\u001b[39m\u001b[39m\r\n"]
[110.029232, "o", "\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.461526ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing, malformed, ambiguous and oversized signature fields are rejected \u001b[90m(0.402071ms)\u001b[39m\u001b[39m\r\n"]
[110.064781, "o", "\u001b[32m✔ invalid signatures and replay tokens get 401 without writes \u001b[90m(50.52003ms)\u001b[39m\u001b[39m\r\n"]
[110.081758, "o", "\u001b[32m✔ verification uses raw bytes rather than normalized JSON or decoded text \u001b[90m(18.181487ms)\u001b[39m\u001b[39m\r\n"]
[110.118304, "o", "\u001b[32m✔ signed invalid events get 400 without changing state or consuming event IDs \u001b[90m(29.561034ms)\u001b[39m\u001b[39m\r\n"]
[110.13209, "o", "\u001b[32m✔ concurrent and later duplicates leave refunds, raw events and audits unchanged \u001b[90m(20.853318ms)\u001b[39m\u001b[39m\r\n"]
[110.140211, "o", "\u001b[32m✔ ignored event types are acknowledged and deduplicated \u001b[90m(8.110539ms)\u001b[39m\u001b[39m\r\n"]
[110.158912, "o", "\u001b[32m✔ pending and auto-approved cancellations audit only once \u001b[90m(18.443544ms)\u001b[39m\u001b[39m\r\n"]
[110.182432, "o", "\u001b[32m✔ event IDs do not collide with Object prototype properties \u001b[90m(24.336635ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ on-call policy approves INR 5000 inclusive and retains replay guard \u001b[90m(0.362225ms)\u001b[39m\u001b[39m\r\n"]
[110.193585, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.176362ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.79611ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.486339ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.277902ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.294439ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.544409ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.93656ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.292783ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 339.497482\u001b[39m\r\n"]
[110.198721, "o", "\u001b[1G\u001b[0K⠙"]
