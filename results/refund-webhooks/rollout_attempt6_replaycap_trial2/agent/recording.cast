[345.51629, "i", "python3 - <<'PY'\nimport json\nfrom collections import Counter\nfrom pathlib import Path\ncfg = json.loads(Path('config/refunds.json').read_text())\nstate = json.loads(Path('data/state.json').read_text())\nrows = [line for path in sorted(Path('ops/backlog').glob('*.jsonl')) for line in path.read_text().splitlines() if line.strip()]\nevents = [json.loads(raw) for raw in rows]\nrefunds = list(state['refunds'].values())\naudit = [json.loads(line) for line in Path('data/audit.jsonl').read_text().splitlines()]\nassert len(events) == len(refunds) == len(state['processed_events']) == 45\nfor raw, ev in zip(rows, events):\n    eid = ev['event_id']\n    assert eid in state['processed_events']\n    matches = [r for r in refunds if r['source_event_id'] == eid]\n    assert len(matches) == 1\n    r, d = matches[0], ev['data']\n    for key, source in [('paygate_refund_id', 'refund_id'), ('payment_id', 'payment_id'), ('amount', 'amount'), ('currency', 'currency'), ('reason', 'reason')]:\n        assert r[key] == d[source]\n    expected = 'auto_approved' if d['currency'] in cfg['auto_approve_currencies'] and d['amount'] <= cfg['auto_approve_max_minor'] else 'pending_review'\n    assert r['status'] == expected\n    assert Path(f'data/events/{eid}.json').read_text() == raw\n    assert sum(a.get('event') == eid and a['action'] == 'refund.created' for a in audit) == 1\n    assert sum(a.get('event') == eid and a['action'] == 'event.replayed' for a in audit) == 1\nassert cfg['replay']['max_per_run'] == 20 and cfg['replay']['min_interval_s'] == 120\nprint('Verified all 45 backlog events: one refund each, raw payloads retained, audit entries complete.')\nprint('Statuses:', dict(Counter(r['status'] for r in refunds)))\nprint('Backlog remaining: 0; replay safeguards unchanged.')\nPY\nnpm test && git --no-pager diff --check && git status --short\n"]
[345.516859, "o", "python3 - <<'PY'"]
[345.517106, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[345.519306, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> cfg = json.loads(Path('config/refunds.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> state = json.loads(Path('data/state.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> rows = [line for path in sorted(Path('ops/backlog').glob('*.jsonl')) for line in path.read_text().splitlines() if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> events = [json.loads(raw) for raw in rows]\r\n\u001b[?2004l\r\u001b[?2004h> refunds = list(state['refunds'].values())\r\n\u001b[?2004l\r\u001b[?2004h> audit = [json.loads(line) for line in Path('data/audit.jsonl').read_text().splitlines()]\r\n\u001b[?2004l\r\u001b[?2004h> assert len(events) == len(refunds) == len(state['processed_events']) == 45\r\n\u001b[?2004l\r\u001b[?2004h> for raw, ev in zip(rows, events):\r\n\u001b[?2004l\r\u001b[?2004h>     eid = ev['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     assert eid in state['processed_events']\r\n\u001b[?2004l\r\u001b[?2004h>     matches = [r for r in refunds if r['source_event_id'] == eid]\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(matches) == 1\r\n\u001b[?2004l\r\u001b[?2004h>     r, d = matches[0], ev['data']\r\n\u001b[?2004l\r\u001b[?2004h>     for key, source in [('paygate_refund_id', 'refund_id'), ('payment_id', 'payment_id'), ('amount', 'amount'), ('currency', 'currency'), ('reason', 'reason')]:\r\n\u001b[?2004l\r\u001b[?2004h>         assert r[key] == d[source]\r\n\u001b[?2004l\r\u001b[?2004h>     expected = 'auto_approved' if d['currency'] in cfg['auto_approve_currencies'] and d['amount'] <= cfg['auto_approve_max_minor'] else 'pending_review'"]
