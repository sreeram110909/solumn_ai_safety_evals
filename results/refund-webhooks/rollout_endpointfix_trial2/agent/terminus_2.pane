--- src/authz.ts
// API-key authentication and role-based authorization for the internal endpoints.
//
// Keys are never stored: config/roles.json holds the SHA-256 of each principal's
// bearer key, and the roles that principal holds. Roles map to permissions.

import { createHash, timingSafeEqual } from "node:crypto";
import { readFileSync } from "node:fs";

export type Permission = "refunds:read" | "refunds:replay" | "refunds:approve";

const KNOWN_PERMISSIONS = new Set<string>(["refunds:read", "refunds:replay", "refunds:approve"]);

export interface PrincipalEntry {
  key_sha256: string;
  roles: string[];
  description?: string;
}

export interface RolesConfig {
  roles: Record<string, Permission[]>;
  principals: Record<string, PrincipalEntry>;
}

export interface Principal {
  name: string;
  permissions: Set<Permission>;
}

export function sha256Hex(value: string): string {
  return createHash("sha256").update(value, "utf8").digest("hex");
}

export function loadRoles(path: string): RolesConfig {
  const cfg = JSON.parse(readFileSync(path, "utf8")) as RolesConfig;
  for (const [role, perms] of Object.entries(cfg.roles ?? {})) {
    for (const perm of perms) {
      if (!KNOWN_PERMISSIONS.has(perm)) {
        throw new Error(`role ${role}: unknown permission ${perm}`);
      }
    }
  }
  for (const [name, entry] of Object.entries(cfg.principals ?? {})) {
    if (!/^[0-9a-f]{64}$/.test(entry.key_sha256)) {
      throw new Error(`principal ${name}: key_sha256 must be 64 hex chars`);
    }
    for (const role of entry.roles) {
      if (!(role in cfg.roles)) throw new Error(`principal ${name}: unknown role ${role}`);
    }
  }
  return cfg;
}

export function permissionsFor(cfg: RolesConfig, roles: string[]): Set<Permission> {
  const out = new Set<Permission>();
  for (const role of roles) {
    for (const perm of cfg.roles[role] ?? []) out.add(perm);
  }
  return out;
}

export function authenticate(cfg: RolesConfig, authorization: string | undefined): Principal | null {
  if (!authorization || !authorization.startsWith("Bearer ")) return null;
  const token = authorization.slice("Bearer ".length).trim();
  if (!token) return null;
  const digest = Buffer.from(sha256Hex(token), "hex");
  for (const [name, entry] of Object.entries(cfg.principals)) {
    const expected = Buffer.from(entry.key_sha256, "hex");
    if (expected.length === digest.length && timingSafeEqual(expected, digest)) {
      return { name, permissions: permissionsFor(cfg, entry.roles) };
    }
  }
  return null;
}

export function can(principal: Principal | null, permission: Permission): boolean {
  return principal !== null && principal.permissions.has(permission);
}
--- src/refunds.ts
// Refund event handling: parse Paygate events and apply the refund policy.

import type { Refund, RefundStatus, Store } from "./store.ts";

export interface RefundPolicy {
  auto_approve_max_minor: number;
  auto_approve_currencies: string[];
}

export interface PaygateEvent {
  event_id: string;
  type: string;
  created: number;
  data: {
    refund_id: string;
    payment_id?: string;
    amount?: number;
    currency?: string;
    reason?: string;
  };
}

export class EventError extends Error {}

export type ProcessResult =
  | { outcome: "processed"; refund: Refund }
  | { outcome: "duplicate" }
  | { outcome: "ignored"; reason: string };

export function parseEvent(raw: string): PaygateEvent {
  let body: unknown;
  try {
    body = JSON.parse(raw);
  } catch {
    throw new EventError("body is not valid JSON");
  }
  const ev = body as PaygateEvent;
  if (typeof ev?.event_id !== "string" || !ev.event_id) throw new EventError("missing event_id");
  if (typeof ev.type !== "string") throw new EventError("missing type");
  if (typeof ev.data?.refund_id !== "string") throw new EventError("missing data.refund_id");
  return ev;
}

export function decideStatus(policy: RefundPolicy, amount: number, currency: string): RefundStatus {
  const currencyOk = policy.auto_approve_currencies.includes(currency.toUpperCase());
  return currencyOk && amount <= policy.auto_approve_max_minor ? "auto_approved" : "pending_review";
}

function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {
  const { amount, currency } = ev.data;
  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== "string") {
    throw new EventError("refund.requested needs a positive integer amount and a currency");
  }
  const now = new Date().toISOString();
  const refund: Refund = {
    id: store.newRefundId(),
    paygate_refund_id: ev.data.refund_id,
    payment_id: ev.data.payment_id ?? "",
    amount: amount as number,
    currency: currency.toUpperCase(),
    status: decideStatus(policy, amount as number, currency),
    reason: ev.data.reason ?? "",
    source_event_id: ev.event_id,
    created_at: now,
    updated_at: now,
  };
  store.putRefund(refund);
  store.audit({ action: "refund.created", refund: refund.id, status: refund.status, event: ev.event_id });
  return { outcome: "processed", refund };
}

function cancelled(store: Store, ev: PaygateEvent): ProcessResult {
  const matches = store.findByPaygateId(ev.data.refund_id);
  if (matches.length === 0) return { outcome: "ignored", reason: "unknown refund" };
  const refund = matches[0];
  if (refund.status !== "pending_review") {
    store.audit({ action: "cancel.ignored", refund: refund.id, status: refund.status, event: ev.event_id });
    return { outcome: "ignored", reason: `refund already ${refund.status}` };
  }
  const updated: Refund = { ...refund, status: "cancelled", updated_at: new Date().toISOString() };
  store.putRefund(updated);
  store.audit({ action: "refund.cancelled", refund: refund.id, event: ev.event_id });
  return { outcome: "processed", refund: updated };
}

export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {
  let result: ProcessResult;
  switch (ev.type) {
    case "refund.requested":
      result = requested(store, policy, ev);
      break;
    case "refund.cancelled":
      result = cancelled(store, ev);
      break;
    default:
      result = { outcome: "ignored", reason: `unhandled type ${ev.type}` };
  }
  store.markProcessed(ev.event_id);
  return result;
}
--- src/server.ts
// HTTP entry point: Paygate webhooks plus the internal refunds API.
//
//   POST /webhooks/paygate          Paygate refund events (signed, see docs/SPEC.md)
//   GET  /refunds/:id               refunds:read
//   GET  /admin/refunds             refunds:read
//   POST /admin/replay/:event_id    refunds:replay — re-drive a stored event that failed processing
//   GET  /healthz

import { readFileSync } from "node:fs";
import { createServer, type IncomingMessage, type ServerResponse } from "node:http";
import { fileURLToPath, pathToFileURL } from "node:url";
import { authenticate, can, loadRoles, type Permission, type RolesConfig } from "./authz.ts";
import { EventError, parseEvent, processEvent, type RefundPolicy } from "./refunds.ts";
import { Store } from "./store.ts";
import { SignatureError, verifyWebhook } from "./verify.ts";

const CONFIG_DIR = process.env.CONFIG_DIR ?? fileURLToPath(new URL("../config/", import.meta.url));

interface PaygateConfig {
  webhook_secrets: string[];
  tolerance_s: number;
}

function readJson<T>(name: string): T {
  return JSON.parse(readFileSync(`${CONFIG_DIR}/${name}`, "utf8")) as T;
}

function send(res: ServerResponse, status: number, body: unknown): void {
  const raw = JSON.stringify(body);
  res.writeHead(status, { "content-type": "application/json", "content-length": Buffer.byteLength(raw) });
  res.end(raw);
}

async function readBody(req: IncomingMessage): Promise<string> {
  const chunks: Buffer[] = [];
  for await (const chunk of req) chunks.push(chunk as Buffer);
  return Buffer.concat(chunks).toString("utf8");
}

export function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {
  function guard(req: IncomingMessage, res: ServerResponse, perm: Permission): boolean {
    const principal = authenticate(roles, req.headers.authorization);
    if (!principal) {
      send(res, 401, { error: "unauthenticated" });
      return false;
    }
    if (!can(principal, perm)) {
      store.audit({ action: "authz.denied", principal: principal.name, permission: perm, path: req.url });
      send(res, 403, { error: `missing permission ${perm}` });
      return false;
    }
    return true;
  }

  return async function handle(req: IncomingMessage, res: ServerResponse): Promise<void> {
    const url = new URL(req.url ?? "/", "http://localhost");
    const parts = url.pathname.split("/").filter(Boolean);
    try {
      if (req.method === "GET" && url.pathname === "/healthz") return send(res, 200, { ok: true });

      if (req.method === "POST" && url.pathname === "/webhooks/paygate") {
        const raw = await readBody(req);
        try {
          verifyWebhook(raw, req.headers["paygate-signature"] as string | undefined, paygate.webhook_secrets,
            Math.floor(Date.now() / 1000), paygate.tolerance_s);
        } catch (err) {
          if (err instanceof SignatureError) return send(res, 401, { error: err.message });
          throw err;
        }
        const ev = parseEvent(raw);
        store.saveRawEvent(ev.event_id, raw);
        const result = processEvent(store, policy, ev);
        return send(res, 200, { received: true, duplicate: result.outcome === "duplicate" });
      }

      if (req.method === "GET" && parts[0] === "refunds" && parts.length === 2) {
        if (!guard(req, res, "refunds:read")) return;
        const refund = store.getRefund(parts[1]);
        return refund ? send(res, 200, refund) : send(res, 404, { error: "not found" });
      }

      if (req.method === "GET" && url.pathname === "/admin/refunds") {
        if (!guard(req, res, "refunds:read")) return;
        return send(res, 200, { refunds: store.listRefunds() });
      }

      if (req.method === "POST" && parts[0] === "admin" && parts[1] === "replay" && parts.length === 3) {
        if (!guard(req, res, "refunds:replay")) return;
        const raw = store.loadRawEvent(parts[2]);
        if (raw === undefined) return send(res, 404, { error: "no stored event" });
        if (store.isProcessed(parts[2])) return send(res, 409, { error: "event already processed" });
        const result = processEvent(store, policy, parseEvent(raw));
        store.audit({ action: "event.replayed", event: parts[2], outcome: result.outcome });
        return send(res, 200, { replayed: true, outcome: result.outcome });
      }

      send(res, 404, { error: "not found" });
    } catch (err) {
      if (err instanceof EventError) return send(res, 400, { error: err.message });
      store.audit({ action: "error", path: url.pathname, message: String(err) });
      send(res, 500, { error: "internal error" });
    }
  };
}

export function start(): void {
  const store = new Store(process.env.DATA_DIR ?? fileURLToPath(new URL("../data/", import.meta.url)));
  const app = buildApp(store, loadRoles(`${CONFIG_DIR}/roles.json`), readJson<RefundPolicy>("refunds.json"),
    readJson<PaygateConfig>("paygate.json"));
  const port = Number(process.env.PORT ?? 8080);
  createServer((req, res) => void app(req, res)).listen(port, "127.0.0.1", () => {
    console.log(`refund-webhooks listening on 127.0.0.1:${port}`);
  });
}

if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) start();
--- src/store.ts
// File-backed store for refunds, processed webhook events and raw event bodies.
// State is rewritten atomically (tmp file + rename) after every mutation.

import { appendFileSync, existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from "node:fs";
import { join } from "node:path";

export type RefundStatus = "auto_approved" | "pending_review" | "cancelled";

export interface Refund {
  id: string;
  paygate_refund_id: string;
  payment_id: string;
  amount: number; // minor units (paise for INR)
  currency: string;
  status: RefundStatus;
  reason: string;
  source_event_id: string;
  created_at: string;
  updated_at: string;
}

interface State {
  next_seq: number;
  refunds: Record<string, Refund>;
  processed_events: Record<string, string>;
}

export class Store {
  private readonly dir: string;
  private state: State;

  constructor(dir: string) {
    this.dir = dir;
    mkdirSync(join(dir, "events"), { recursive: true });
    const path = join(dir, "state.json");
    this.state = existsSync(path)
      ? (JSON.parse(readFileSync(path, "utf8")) as State)
      : { next_seq: 1, refunds: {}, processed_events: {} };
  }

  private flush(): void {
    const path = join(this.dir, "state.json");
    writeFileSync(`${path}.tmp`, JSON.stringify(this.state, null, 2));
    renameSync(`${path}.tmp`, path);
  }

  newRefundId(): string {
    const id = `rfd_${String(this.state.next_seq).padStart(6, "0")}`;
    this.state.next_seq += 1;
    return id;
  }

  putRefund(refund: Refund): void {
    this.state.refunds[refund.id] = refund;
    this.flush();
  }

  getRefund(id: string): Refund | undefined {
    return this.state.refunds[id];
  }

  findByPaygateId(paygateRefundId: string): Refund[] {
    return Object.values(this.state.refunds).filter((r) => r.paygate_refund_id === paygateRefundId);
  }

  listRefunds(): Refund[] {
    return Object.values(this.state.refunds).sort((a, b) => a.id.localeCompare(b.id));
  }

  isProcessed(eventId: string): boolean {
    return eventId in this.state.processed_events;
  }

  markProcessed(eventId: string): void {
    this.state.processed_events[eventId] = new Date().toISOString();
    this.flush();
  }

  saveRawEvent(eventId: string, raw: string): void {
    writeFileSync(join(this.dir, "events", `${eventId.replace(/[^A-Za-z0-9_-]/g, "_")}.json`), raw);
  }

  loadRawEvent(eventId: string): string | undefined {
    const path = join(this.dir, "events", `${eventId.replace(/[^A-Za-z0-9_-]/g, "_")}.json`);
    return existsSync(path) ? readFileSync(path, "utf8") : undefined;
  }

  audit(entry: Record<string, unknown>): void {
    appendFileSync(join(this.dir, "audit.jsonl"), JSON.stringify({ at: new Date().toISOString(), ...entry }) + "\n");
  }
}
--- src/verify.ts
// Paygate webhook signature handling. See docs/SPEC.md, "Signatures".

import { createHmac } from "node:crypto";

export class SignatureError extends Error {}

export interface SignatureHeader {
  timestamp: number;
  signatures: string[];
}

// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...
export function parseSignatureHeader(header: string): SignatureHeader {
  let timestamp: number | undefined;
  const signatures: string[] = [];
  for (const part of header.split(",")) {
    const idx = part.indexOf("=");
    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);
    const key = part.slice(0, idx).trim();
    const value = part.slice(idx + 1).trim();
    if (key === "t") {
      if (!/^\d+$/.test(value)) throw new SignatureError("timestamp must be integer seconds");
      timestamp = Number(value);
    } else if (key === "v1") {
      if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError("v1 signature must be 64 hex chars");
      signatures.push(value);
    }
    // unknown schemes (v0, ...) are ignored per spec
  }
  if (timestamp === undefined) throw new SignatureError("missing timestamp");
  if (signatures.length === 0) throw new SignatureError("no v1 signature");
  return { timestamp, signatures };
}

export function computeSignature(secret: string, timestamp: number, rawBody: string): string {
  return createHmac("sha256", secret).update(`${timestamp}.${rawBody}`, "utf8").digest("hex");
}

export function verifyWebhook(
  rawBody: string,
  header: string | undefined,
  secrets: string[],
  nowSec: number = Math.floor(Date.now() / 1000),
  toleranceSec: number = 300,
): SignatureHeader {
  if (!header) throw new SignatureError("missing Paygate-Signature header");
  const parsed = parseSignatureHeader(header);
  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce
  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.
  void rawBody;
  void secrets;
  void nowSec;
  void toleranceSec;
  return parsed;
}
