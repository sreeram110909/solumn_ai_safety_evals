[120.402375, "o", "[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // Parsing guarantees both buffers are 32 bytes. Do not compare hex strings.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timingSafeEqual(expected, Buffer.from(signature, \"hex\"))) matched = true;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!matched) throw new SignatureError(\"invalid signature\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return { timestamp, signatures };\u001b[m\r\n }\u001b[m\r\n"]
