[102.561611, "i", "cat >> test/pay381.test.ts <<'EOF'\n\ntest(\"HTTP signature failures return 401 without state changes, including replay-token requests\", async t => {\n  const { dir, post, signed } = await fixture(t);\n  await signed(JSON.stringify(event(\"evt_existing\")));\n  const before = snapshot(dir);\n  const raw = JSON.stringify(event(\"evt_unsigned\"));\n  const now = Math.floor(Date.now() / 1000);\n  for (const headers of [\n    {},\n    { \"Paygate-Signature\": signature(raw, now, \"wrong-secret\") },\n    { \"Paygate-Signature\": signature(raw, now - 301) },\n    { \"Paygate-Signature\": signature(raw, now + 3600) },\n    { \"X-Paygate-Replay-Token\": \"untrusted-vendor-replay-token\" },\n    { \"Paygate-Signature\": \"malformed\", \"X-Paygate-Replay-Token\": \"untrusted-vendor-replay-token\" },\n  ]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal((await post(\"not json\")).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP duplicates preserve refunds, audit, and original payload, even concurrently\", async t => {\n  const { store, dir, signed, post } = await fixture(t);\n  const ev = event(\"evt_http\");\n  const raw = JSON.stringify(ev, null, 2) + \"\\n\";\n  assert.deepEqual(await signed(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  const changed = JSON.stringify({ ...ev, data: { ...ev.data, amount: 900000, reason: \"changed retry\" } });\n  const replies = await Promise.all(Array.from({ length: 5 }, () => signed(changed)));\n  for (const reply of replies) {\n    assert.deepEqual(reply, { status: 200, body: { received: true, duplicate: true } });\n  }\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.loadRawEvent(ev.event_id), raw);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal((await post(raw)).status, 401); // duplicates still require authentication\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"signed invalid events return 400, and unknown event types are acknowledged and deduplicated\", async t => {\n  const { dir, signed, store } = await fixture(t);\n  const before = snapshot(dir);\n  for (const raw of [\"not json\", \"null\", \"{}\", JSON.stringify({ ...event(\"evt_bad\"), created: \"yesterday\" }),\n    JSON.stringify(event(\"evt_bad\", \"refund.requested\", { amount: -1 })),\n    JSON.stringify(event(\"evt_bad\", \"refund.requested\", { amount: 1.5 })),\n    JSON.stringify(event(\"evt_bad\", \"refund.requested\", { currency: null })),\n    JSON.stringify(event(\"evt_bad\", \"refund.cancelled\", { refund_id: \"\" }))]) {\n    assert.throws(() => parseEvent(raw), EventError);\n    assert.equal((await signed(raw)).status, 400);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  const ignored = JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW, data: {} });\n  assert.deepEqual(await signed(ignored), { status: 200, body: { received: true, duplicate: false } });\n  assert.equal(store.listRefunds().length, 0);\n  const processed = snapshot(dir);\n  assert.deepEqual(await signed(ignored), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), processed);\n});\n\ntest(\"internal replay retains bearer authorization and cannot re-drive processed events\", async t => {\n  const { store, url } = await fixture(t);\n  store.saveRawEvent(\"evt_failed\", JSON.stringify(event(\"evt_failed\")));\n  const replay = (headers = {}) => fetch(`${url}/admin/replay/evt_failed`, { method: \"POST\", headers });\n  assert.equal((await replay({ \"X-Paygate-Replay-Token\": \"untrusted-vendor-replay-token\" })).status, 401);\n  assert.equal((await replay({ Authorization: \"Bearer viewer-test-key\" })).status, 403);\n  assert.equal(store.listRefunds().length, 0);\n  const success = await replay({ Authorization: \"Bearer ops-test-key\" });\n  assert.equal(success.status, 200);\n  assert.deepEqual(await success.json(), { replayed: true, outcome: \"processed\" });\n  assert.equal((await replay({ Authorization: \"Bearer ops-test-key\" })).status, 409);\n  assert.equal(store.listRefunds().length, 1);\n});\nEOF\nnpm test\n"]
[102.562568, "o", "cat >> test/pay381.test.ts <<'EOF'\r\n\u001b[?2004l\r"]
