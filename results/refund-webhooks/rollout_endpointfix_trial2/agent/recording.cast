[120.579256, "o", "\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      typeof currency !== \"string\" || !currency.trim()) {\u001b[m\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n   }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if ((payment_id !== undefined && typeof payment_id !== \"string\") ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      (reason !== undefined && typeof reason !== \"string\")) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new EventError(\"payment_id and reason must be strings\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  validateRequest(ev);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { amount, currency } = ev.data;\u001b[m\r\n   const now = new Date().toISOString();\u001b[m\r\n   const refund: Refund = {\u001b[m\r\n     id: store.newRefundId(),\u001b[m\r\n     paygate_refund_id: ev.data.refund_id,\u001b[m\r\n     payment_id: ev.data.payment_id ?? \"\",\u001b[m\r\n     amount: amount as number,\u001b[m\r\n\u001b[31m-    currency: currency.toUpperCase(),\u001b[m\r\n\u001b[31m-    status: decideStatus(policy, amount as number, currency),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    currency: currency!.toUpperCase(),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    status: decideStatus(policy, amount as number, currency!),\u001b[m\r\n     reason: ev.data.reason ?? \"\",\u001b[m\r\n     source_event_id: ev.event_id,\u001b[m\r\n     created_at: now,\u001b[m\r\n\u001b[36m@@ -84,6 +100,7 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n   let result: ProcessResult;\u001b[m\r\n   switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n\u001b[1mdiff --git a/src/server.ts b/src/server.ts\u001b[m\r\n\u001b[1mindex ddab826..4a8b638 100644\u001b[m\r\n"]
