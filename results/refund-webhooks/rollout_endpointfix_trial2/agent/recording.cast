[54.145676, "o", "\u001b[1G\u001b[0K"]
[54.362074, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.37251ms)\u001b[39m\u001b[39m\r\n"]
[54.363245, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.21338ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.814114ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.821408ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.292158ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.707247ms)\u001b[39m\u001b[39m\r\n"]
[54.363299, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.130874ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.393956ms)\u001b[39m\u001b[39m\r\n"]
[54.379872, "o", "\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 8\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 191.057211\u001b[39m\r\n"]
