[120.762508, "i", "npm test && git status --short\n"]
[120.763547, "o", "npm test && git status --short\r\n\u001b[?2004l\r"]
[120.905919, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[120.906983, "o", "\u001b[1G"]
[120.907162, "o", "\u001b[0K"]
[121.187862, "o", "\u001b[32m✔ verification rejects missing/malformed signatures and empty secret lists \u001b[90m(2.692599ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ verification accepts any matching rotation signature and signs exact bytes \u001b[90m(1.232188ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.654259ms)\u001b[39m\u001b[39m\r\n"]
[121.188652, "o", "\u001b[32m✔ configured policy includes INR 5000 but not higher amounts or other currencies \u001b[90m(1.001327ms)\u001b[39m\u001b[39m\r\n"]
[121.188996, "o", "\u001b[32m✔ processed event IDs persist and do not collide with object properties \u001b[90m(27.586621ms)\u001b[39m\u001b[39m\r\n"]
[121.18925, "o", "\u001b[32m✔ cancellation retries never update or audit again \u001b[90m(3.961279ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ auto-approved cancellation is ignored and audited once \u001b[90m(3.196186ms)\u001b[39m\u001b[39m\r\n"]
[121.255401, "o", "\u001b[32m✔ HTTP signature failures return 401 without state changes, including replay-token requests \u001b[90m(79.578186ms)\u001b[39m\u001b[39m\r\n"]
[121.312068, "o", "\u001b[32m✔ HTTP duplicates preserve refunds, audit, and original payload, even concurrently \u001b[90m(55.533067ms)\u001b[39m\u001b[39m\r\n"]
[121.346531, "o", "\u001b[32m✔ signed invalid events return 400, and unknown event types are acknowledged and deduplicated \u001b[90m(38.474163ms)\u001b[39m\u001b[39m\r\n"]
[121.358919, "o", "\u001b[32m✔ internal replay retains bearer authorization and cannot re-drive processed events \u001b[90m(15.523274ms)\u001b[39m\u001b[39m\r\n"]
[121.375762, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.062957ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.079271ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(2.178583ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.484045ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.187106ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.924056ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.100316ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.410045ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 427.036319\u001b[39m\r\n"]
[121.382915, "o", "\u001b[1G\u001b[0K⠙"]
[121.385015, "o", "\u001b[1G"]
[121.385247, "o", "\u001b[0K"]
[121.393344, "o", " \u001b[31mM\u001b[m config/refunds.json\r\n \u001b[31mM\u001b[m src/refunds.ts\r\n \u001b[31mM\u001b[m src/server.ts\r\n \u001b[31mM\u001b[m src/store.ts\r\n \u001b[31mM\u001b[m src/verify.ts\r\n\u001b[31m??\u001b[m test/pay381.test.ts\r\n"]
[121.393573, "o", "\u001b[?2004hroot@0f94e7e939c5:/app# "]
