[86.022536, "o", "\u001b[?2004h> "]
[86.023004, "o", "  const address = server.address();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.023227, "o", "  assert.ok(address && typeof address === \"object\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.0235, "o", "  const url = `http://127.0.0.1:${address.port}`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.023688, "o", "  async function post(raw: string | Buffer, headers: Record<string, string> = {}) {"]
[86.027119, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     const response = await fetch(`${url}/webhooks/paygate`, { method: \"POST\", body: raw, headers });\r\n\u001b[?2004l\r\u001b[?2004h>     return { status: response.status, body: await response.json() };\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   async function signed(raw: string | Buffer) {\r\n\u001b[?2004l\r\u001b[?2004h>     return post(raw, { \"Paygate-Signature\": signature(raw, Math.floor(Date.now() / 1000)) });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return { dir, store, post, signed, url };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"verification rejects missing/malformed signatures and empty secret lists\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_verify\"));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`, `t=${NOW},v1=ab`,\r\n\u001b[?2004l\r\u001b[?2004h>     `t=${NOW},v1=${\"A\".repeat(64)}`, `t=1.2,v1=${\"a\".repeat(64)}`,\r\n\u001b[?2004l\r\u001b[?2004h>     `t=${NOW},${signature(raw)}`, `t=${\"9\".repeat(400)},v1=${\"a\".repeat(64)}`]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.throws(() => verifyWebhook(raw, header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(raw, signature(raw), [], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"verification accepts any matching rotation signature and signs exact bytes\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = Buffer.from(' { \"message\": \"₹ refund\", \"n\": 1 }\\n');\r\n\u001b[?2004l\r\u001b[?2004h>   const header = signature(raw, NOW, \"old-secret\") + \",\" + signature(raw).split(\",\")[1];\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(raw, header, [\"unrelated\", SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW, \"old-secret\"), [SECRET, \"old-secret\"], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw.toString())), header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   const bytes = Buffer.from([0xff, 0x00, 0x80]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(bytes, signature(bytes), [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signature(bytes), [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const offset of [-301, -300, 0, 300, 301]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const raw = \"{}\";\r\n\u001b[?2004l\r\u001b[?2004h>     const check = () => verifyWebhook(raw, signature(raw, NOW + offset), [SECRET], NOW);\r\n\u001b[?2004l\r\u001b[?2004h>     if (Math.abs(offset) <= 300) assert.doesNotThrow(check);\r\n\u001b[?2004l\r\u001b[?2004h>     else assert.throws(check, SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(\"{}\", signature(\"{}\", NOW + 11), [SECRET], NOW, 10), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\rcel).outcome, \"ignored\");\r\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\r\n  assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel\\.ignored/);\r\n  const before = snapshot(dir);\r\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\r\n  assert.deepEqual(snapshot(dir), before);\r\n});\r\nEOF\r\n"]
