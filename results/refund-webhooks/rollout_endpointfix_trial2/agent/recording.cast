[54.394619, "o", "\u001b[?2004hroot@0f94e7e939c5:/app# "]
[86.005936, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { once } from \"node:events\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { sha256Hex } from \"../src/authz.ts\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_test_current\";\nconst NOW = 1731920000;\nconst POLICY = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n\nfunction event(id: string, type = \"refund.requested\", data = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount: 500000, currency: \"INR\", ...data } };\n}\n\nfunction signature(raw: string | Buffer, at = NOW, secret = SECRET): string {\n  const digest = createHmac(\"sha256\", secret).update(`${at}.`).update(raw).digest(\"hex\");\n  return `t=${at},v1=${digest}`;\n}\n\nfunction fresh(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return { dir, store: new Store(dir) };\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  const out: Record<string, string> = {};\n  function visit(path: string, prefix = \"\") {\n    for (const entry of readdirSync(path, { withFileTypes: true })) {\n      const name = prefix + entry.name;\n      if (entry.isDirectory()) visit(join(path, entry.name), `${name}/`);\n      else out[name] = readFileSync(join(path, entry.name)).toString(\"base64\");\n    }\n  }\n  visit(dir);\n  return out;\n}\n\nasync function fixture(t: TestContext) {\n  const { store, dir } = fresh(t);\n  const roles = {\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"] as const, viewer: [\"refunds:read\"] as const },\n    principals: {\n      ops: { key_sha256: sha256Hex(\"ops-test-key\"), roles: [\"admin\"] },\n      viewer: { key_sha256: sha256Hex(\"viewer-test-key\"), roles: [\"viewer\"] },\n    },\n  };\n  const app = buildApp(store, { ...roles, roles: {\n    admin: [...roles.roles.admin], viewer: [...roles.roles.viewer],\n  } }, POLICY, { webhook_secrets: [SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  server.listen(0, \"127.0.0.1\");\n  await once(server, \"listening\");\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close(err => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const address = server.address();\n  assert.ok(address && typeof address === \"object\");\n  const url = `http://127.0.0.1:${address.port}`;\n  async function post(raw: string | Buffer, headers: Record<string, string> = {}) {\n    const response = await fetch(`${url}/webhooks/paygate`, { method: \"POST\", body: raw, headers });\n    return { status: response.status, body: await response.json() };\n  }\n  async function signed(raw: string | Buffer) {\n    return post(raw, { \"Paygate-Signature\": signature(raw, Math.floor(Date.now() / 1000)) });\n  }\n  return { dir, store, post, signed, url };\n}\n\ntest(\"verification rejects missing/malformed signatures and empty secret lists\", () => {\n  const raw = JSON.stringify(event(\"evt_verify\"));\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`, `t=${NOW},v1=ab`,\n    `t=${NOW},v1=${\"A\".repeat(64)}`, `t=1.2,v1=${\"a\".repeat(64)}`,\n    `t=${NOW},${signature(raw)}`, `t=${\"9\".repeat(400)},v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(raw, header, [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, signature(raw), [], NOW), SignatureError);\n});\n\ntest(\"verification accepts any matching rotation signature and signs exact bytes\", () => {\n  const raw = Buffer.from(' { \"message\": \"₹ refund\", \"n\": 1 }\\n');\n  const header = signature(raw, "]
[86.006, "i", "NOW, \"old-secret\") + \",\" + signature(raw).split(\",\")[1];\n  assert.doesNotThrow(() => verifyWebhook(raw, header, [\"unrelated\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW, \"old-secret\"), [SECRET, \"old-secret\"], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw.toString())), header, [SECRET], NOW), SignatureError);\n  const bytes = Buffer.from([0xff, 0x00, 0x80]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signature(bytes), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signature(bytes), [SECRET], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\n  for (const offset of [-301, -300, 0, 300, 301]) {\n    const raw = \"{}\";\n    const check = () => verifyWebhook(raw, signature(raw, NOW + offset), [SECRET], NOW);\n    if (Math.abs(offset) <= 300) assert.doesNotThrow(check);\n    else assert.throws(check, SignatureError);\n  }\n  assert.throws(() => verifyWebhook(\"{}\", signature(\"{}\", NOW + 11), [SECRET], NOW, 10), SignatureError);\n});\n\ntest(\"configured policy includes INR 5000 but not higher amounts or other currencies\", () => {\n  assert.equal(POLICY.auto_approve_max_minor, 500000);\n  assert.deepEqual(POLICY.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(POLICY, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(POLICY, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(POLICY, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"processed event IDs persist and do not collide with object properties\", t => {\n  const { store, dir } = fresh(t);\n  for (const id of [\"evt_persist\", \"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"duplicate\");\n  }\n  const before = snapshot(dir);\n  const reopened = new Store(dir);\n  for (const id of [\"evt_persist\", \"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(reopened, POLICY, event(id)).outcome, \"duplicate\");\n  }\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(reopened.listRefunds().length, 4);\n});\n\ntest(\"cancellation retries never update or audit again\", t => {\n  const { store, dir } = fresh(t);\n  processEvent(store, POLICY, event(\"evt_pending\", \"refund.requested\", { amount: 500001 }));\n  const cancel = event(\"evt_cancel\", \"refund.cancelled\");\n  processEvent(store, POLICY, cancel);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"auto-approved cancellation is ignored and audited once\", t => {\n  const { store, dir } = fresh(t);\n  processEvent(store, POLICY, event(\"evt_approved\"));\n  const cancel = event(\"evt_ignore_cancel\", \"refund.cancelled\");\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"ignored\");\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel\\.ignored/);\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\nEOF\n"]
