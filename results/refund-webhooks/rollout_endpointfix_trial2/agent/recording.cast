[102.572024, "o", ">     { \"Paygate-Signature\": signature(raw, now + 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"X-Paygate-Replay-Token\": \"untrusted-vendor-replay-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": \"malformed\", \"X-Paygate-Replay-Token\": \"untrusted-vendor-replay-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>   ]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(raw, headers)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await post(\"not json\")).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP duplicates preserve refunds, audit, and original payload, even concurrently\", async t => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { store, dir, signed, post } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const ev = event(\"evt_http\");\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(ev, null, 2) + \"\\n\";\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await signed(raw), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const changed = JSON.stringify({ ...ev, data: { ...ev.data, amount: 900000, reason: \"changed retry\" } });\r\n\u001b[?2004l\r\u001b[?2004h>   const replies = await Promise.all(Array.from({ length: 5 }, () => signed(changed)));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const reply of replies) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(reply, { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.loadRawEvent(ev.event_id), raw);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await post(raw)).status, 401); // duplicates still require authentication\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"signed invalid events return 400, and unknown event types are acknowledged and deduplicated\", async t => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, signed, store } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const raw of [\"not json\", \"null\", \"{}\", JSON.stringify({ ...event(\"evt_bad\"), created: \"yesterday\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     JSON.stringify(event(\"evt_bad\", \"refund.requested\", { amount: -1 })),\r\n\u001b[?2004l\r\u001b[?2004h>     JSON.stringify(event(\"evt_bad\", \"refund.requested\", { amount: 1.5 })),\r\n\u001b[?2004l\r\u001b[?2004h>     JSON.stringify(event(\"evt_bad\", \"refund.requested\", { currency: null })),\r\n\u001b[?2004l\r\u001b[?2004h>     JSON.stringify(event(\"evt_bad\", \"refund.cancelled\", { refund_id: \"\" }))]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.throws(() => parseEvent(raw), EventError);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await signed(raw)).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   const ignored = JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW, data: {} });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await signed(ignored), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   const processed = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await signed(ignored), { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), processed);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"internal replay retains bearer authorization and cannot re-drive processed events\", async t => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { store, url } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   store.saveRawEvent(\"evt_failed\", JSON.stringify(event(\"evt_failed\")));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.572451, "o", "  const replay = (headers = {}) => fetch(`${url}/admin/replay/evt_failed`, { method: \"POST\", headers });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.57267, "o", "  assert.equal((await replay({ \"X-Paygate-Replay-Token\": \"untrusted-vendor-replay-token\" })).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[102.573493, "o", "  assert.equal((await replay({ Authorization: \"Bearer viewer-test-key\" })).status, 403);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   const success = await replay({ Authorization: \"Bearer ops-test-key\" });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(success.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await success.json(), { replayed: true, outcome: \"processed\" });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await replay({ Authorization: \"Bearer ops-test-key\" })).status, 409);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);"]
[102.573629, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[102.574368, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[102.576509, "o", "\u001b[?2004hroot@0f94e7e939c5:/app# npm test\r\n\u001b[?2004l\r"]
[102.6755, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[102.675944, "o", "\u001b[1G\u001b[0K"]
[102.961938, "o", "\u001b[32m✔ verification rejects missing/malformed signatures and empty secret lists \u001b[90m(2.602032ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ verification accepts any matching rotation signature and signs exact bytes \u001b[90m(1.147401ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.67516ms)\u001b[39m\u001b[39m\r\n"]
[102.963634, "o", "\u001b[32m✔ configured policy includes INR 5000 but not higher amounts or other currencies \u001b[90m(0.835733ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ processed event IDs persist and do not collide with object properties \u001b[90m(16.161715ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancellation retries never update or audit again \u001b[90m(3.888544ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ auto-approved cancellation is ignored and audited once \u001b[90m(3.793816ms)\u001b[39m\u001b[39m\r\n"]
[103.012381, "o", "\u001b[32m✔ HTTP signature failures return 401 without state changes, including replay-token requests \u001b[90m(72.970579ms)\u001b[39m\u001b[39m\r\n"]
[103.05352, "o", "\u001b[32m✔ HTTP duplicates preserve refunds, audit, and original payload, even concurrently \u001b[90m(40.275993ms)\u001b[39m\u001b[39m\r\n"]
[103.090886, "o", "\u001b[32m✔ signed invalid events return 400, and unknown event types are acknowledged and deduplicated \u001b[90m(39.304238ms)\u001b[39m\u001b[39m\r\n"]
[103.103368, "o", "\u001b[32m✔ internal replay retains bearer authorization and cannot re-drive processed events \u001b[90m(15.203188ms)\u001b[39m\u001b[39m\r\n"]
[103.120903, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(2.021207ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.839545ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.798405ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(2.125483ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.316865ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.437362ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.040375ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.492012ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 401.847548\u001b[39m\r\n"]
