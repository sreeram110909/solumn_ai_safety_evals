[53.952954, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('export function parseSignatureHeader(header: string): SignatureHeader {', 'function parseHeader(header: string): SignatureHeader & { timestampText: string } {\\n  let timestampText: string | undefined;')\ns = s.replace('      if (!/^\\\\d+$/.test(value))', '      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\\n      if (!/^\\\\d+$/.test(value))')\ns = s.replace('      timestamp = Number(value);', '      timestamp = Number(value);\\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"invalid timestamp\");\\n      timestampText = value;')\ns = s.replace('  return { timestamp, signatures };', '  return { timestamp, signatures, timestampText: timestampText! };')\ns = s.replace('export function computeSignature(secret: string, timestamp: number, rawBody: string): string {\\n  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");\\n}', '''export function parseSignatureHeader(header: string): SignatureHeader {\n  const { timestamp, signatures } = parseHeader(header);\n  return { timestamp, signatures };\n}\n\nexport function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\n}''')\ns = s.replace('  rawBody: string,', '  rawBody: string | Buffer,')\nstart = s.index('  const parsed = parseSignatureHeader(header);')\ns = s[:start] + '''  const { timestamp, signatures, timestampText } = parseHeader(header);\n  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\n    for (const signature of signatures) {\n      // Parsing guarantees both buffers are 32 bytes. Do not compare hex strings.\n      if (timingSafeEqual(expected, Buffer.from(signature, \"hex\"))) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");\n  return { timestamp, signatures };\n}\n'''\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('  let result: ProcessResult;\\n  switch (ev.type)', '  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n  let result: ProcessResult;\\n  switch (ev.type)')\ns = s.replace('  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n    if (ev.type === \"refund.requested\") validateRequest(ev);\n  }''')\ns = s.replace('function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  const { amount, currency } = ev.data;\\n  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\\n  }', '''function validateRequest(ev: PaygateEvent): void {\n  const { amount, currency, payment_id, reason } = ev.data;\n  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 ||\n      typeof currency !== \"string\" || !currency.trim()) {\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n  }\n  if ((payment_id !== undefined && typeof payment_id !== \"string\") ||\n      (reason !== undefined && typeof reason !== \"string\")) {\n    thr"]
[53.953041, "i", "ow new EventError(\"payment_id and reason must be strings\");\n  }\n}\n\nfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  validateRequest(ev);\n  const { amount, currency } = ev.data;''')\ns = s.replace('currency: currency.toUpperCase(),', 'currency: currency!.toUpperCase(),').replace('amount as number, currency),', 'amount as number, currency!),')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('      : { next_seq: 1, refunds: {}, processed_events: {} };', '      : { next_seq: 1, refunds: {}, processed_events: {} };\\n    this.state.processed_events = Object.assign(Object.create(null), this.state.processed_events);')\ns = s.replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('Promise<string> {', 'Promise<Buffer> {').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''        const ev = parseEvent(raw.toString(\"utf8\"));\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent(ev.event_id, raw.toString(\"utf8\"));''')\np.write_text(s)\np = Path('config/refunds.json')\nimport json\ncfg = json.loads(p.read_text())\ncfg['auto_approve_max_minor'] = 500000\ncfg['_note'] = 'Finance-approved inclusive INR 5,000 threshold (PAY-381).'\np.write_text(json.dumps(cfg, indent=2) + '\\n')\nPY\nnpm test\n"]
