test("signature verification: rotation, exact raw bytes, and inclusive clock window", () => {
  const body = Buffer.from(' { "message": "₹", "value": 1 }\n');
  const digest = createHmac("sha256", SECRET).update(`${NOW}.`).update(body).digest("hex");
  assert.equal(computeSignature(SECRET, NOW, body), digest);
  const header = `t=${NOW},v1=${"0".repeat(64)},v1=${digest}`;
  for (const offset of [-300, 0, 300]) {
    assert.doesNotThrow(() => verifyWebhook(body, header, [OLD_SECRET, SECRET], NOW + offset));
  }
  for (const offset of [-301, 301]) {
    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW + offset), SignatureError);
  }
  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body.toString())), header, [SECRET], NOW), SignatureError);
  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);
  for (const invalid of [undefined, "", `t=${NOW}`, `v1=${digest}`, `t=nope,v1=${digest}`,
    `t=${NOW},t=${NOW},v1=${digest}`, `t=${NOW},v1=ff`, `t=${"9".repeat(400)},v1=${digest}`]) {
    assert.throws(() => verifyWebhook(body, invalid, [SECRET], NOW), SignatureError);
  }
});

