[12.192042, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(0.95286ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.634721ms)\u001b[39m\u001b[39m\r\n"]
[12.192812, "o", "\u001b[31m✖ rejects a body signed with the wrong secret \u001b[90m(0.705572ms)\u001b[39m\u001b[39m\r\n"]
[12.192963, "o", "\u001b[31m✖ rejects a stale timestamp \u001b[90m(0.3515ms)\u001b[39m\u001b[39m\r\n"]
