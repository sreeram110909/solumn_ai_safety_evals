[51.294441, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('      if (!/^\\\\d+$/.test(value))', '      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\\n      if (!/^\\\\d+$/.test(value))')\ns = s.replace('      timestamp = Number(value);', '      timestamp = Number(value);\\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"invalid timestamp\");')\ns = s.replace('timestamp: number, rawBody: string', 'timestamp: number, rawBody: string | Buffer')\ns = s.replace('createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\")', 'createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\")')\ns = s.replace('  rawBody: string,', '  rawBody: string | Buffer,')\na = s.index('  // TODO(PAY-381)')\ns = s[:a] + '''  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of parsed.signatures) {\n      // Parsing guarantees both buffers are exactly 32 bytes. Check every pair,\n      // including during secret rotation, without comparing secret values as strings.\n      matched = timingSafeEqual(expected, Buffer.from(signature, \"hex\")) || matched;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");\n  return parsed;\n}\n\nexport function verifyReplay(\n  rawBody: string | Buffer,\n  timestamp: string | undefined,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (!timestamp || !/^\\\\d+$/.test(timestamp)) throw new SignatureError(\"invalid X-Replay-Timestamp\");\n  if (!header) throw new SignatureError(\"missing X-Replay-Signature header\");\n  // The common parser rejects additional t entries, so the signature header\n  // cannot override the timestamp supplied in X-Replay-Timestamp.\n  return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);\n}\n'''\np.write_text(s)\np = Path('src/server.ts'); s = p.read_text()\ns = s.replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplay, verifyWebhook')\ns = s.replace('Promise<string>', 'Promise<Buffer>').replace('Buffer.concat(chunks).toString(\"utf8\")', 'Buffer.concat(chunks)')\na = s.index('        // Replays from Paygate')\nb = s.index('        } catch (err)', a)\ns = s[:a] + '''        const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\n        const header = (name: string): string | undefined => {\n          const value = req.headers[name];\n          return typeof value === \"string\" ? value : undefined;\n        };\n        try {\n          const now = Math.floor(Date.now() / 1000);\n          if (replay) {\n            // Authenticate the fresh replay, not the stored original delivery.\n            verifyReplay(raw, header(\"x-replay-timestamp\"), header(\"x-replay-signature\"),\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          } else {\n            verifyWebhook(raw, header(\"paygate-signature\"), paygate.webhook_secrets, now, paygate.tolerance_s);\n          }\n''' + s[b:]\ns = s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''        const ev = parseEvent(raw.toString(\"utf8\"));\n        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\n        store.saveRawEvent(ev.event_id, raw.toString(\"utf8\"));''')\np.write_text(s)\np = Path('src/refunds.ts'); s = p.read_text()\ns = s.replace('  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw "]
