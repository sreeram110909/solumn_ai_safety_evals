[88.418628, "o", "test(\"replay verification requires its own valid signature and fresh timestamp\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.419026, "o", "  const body = JSON.stringify(event());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.419275, "o", "  const header = `v1=${\"0\".repeat(64)},v1=${computeSignature(SECRET, NOW, body)}`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.419835, "o", "  assert.doesNotThrow(() => verifyReplay(body, String(NOW), header, [OLD_SECRET, SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.41997, "o", "  for (const offset of [-301, 301]) {\r\n\u001b[?2004l\repl\u001b[?2004h> "]
[88.420158, "o", "    const t = NOW + offset;\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.420188, "o", "> "]
[88.420889, "o", "    assert.throws(() => verifyReplay(body, String(t), `v1=${computeSignature(SECRET, t, body)}`, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.421019, "o", "> "]
[88.421384, "o", "  for (const h of [undefined, \"\", `v1=${\"0\".repeat(64)}`, `t=${NOW},${header}`]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.421666, "o", "    assert.throws(() => verifyReplay(body, String(NOW), h, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[88.421708, "o", "atur\u001b[?2004h> "]
[88.422711, "o", "  assert.throws(() => verifyReplay(body, \"NaN\", header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.422811, "o", "});\r\n\u001b[?2004l\r(\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[88.422843, "o", "> "]
[88.423408, "o", "test(\"HTTP: unauthenticated requests and invalid signed events do not change state\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.42358, "o", "  await withApp(async (store, dir, post) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.42382, "o", "    const body = JSON.stringify(event());\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.423902, "o", "> "]
[88.424012, "o", "    const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.424358, "o", "    const valid = { \"paygate-signature\": signature(body, now) };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.424623, "o", "    const before = snapshot(dir);\r\n\u001b[?2004l\r \u001b[?2004h> "]
[88.424823, "o", "    const badHeaders = [\r\n\u001b[?2004l\r\u001b[?2004h>       {},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.42522, "o", "      { \"paygate-signature\": signature(body, now, \"wrong\") },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.425546, "o", "      { \"paygate-signature\": signature(body, now - 3600) },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.425872, "o", "      { \"paygate-signature\": signature(body, now + 3600) },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.426199, "o", "      { ...valid, \"x-replay-timestamp\": String(now) },\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.426357, "o", "> "]
[88.426388, "o", "      { ...valid, \"x-replay-timestamp\": \"\" },\r\n\u001b[?2004l\r"]
[88.426613, "o", "\u001b[?2004h> "]
[88.42677, "o", "      { ...valid, \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${\"0\".repeat(64)}` },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.427002, "o", "      { ...valid, \"x-replay-timestamp\": String(now - 3600),\r\n\u001b[?2004l\ro\u001b[?2004h> "]
[88.427482, "o", "        \"x-replay-signature\": `v1=${computeSignature(SECRET, now - 3600, body)}` },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.427716, "o", "      { ...valid, \"x-replay-timestamp\": String(now + 3600),\r\n\u001b[?2004l\ry\u001b[?2004h> "]
[88.427887, "o", "        \"x-replay-signature\": `v1=${computeSignature(SECRET, now + 3600, body)}` },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.427926, "o", "    ];\r\n\u001b[?2004l\r}\u001b[?2004h> "]
[88.428243, "o", "    for (const headers of badHeaders) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.428385, "o", "      const response = await post(body, headers);\r\n\u001b[?2004l\r"]
[88.428413, "o", "\u001b[?2004h> "]
[88.428543, "o", "      assert.equal(response.status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.428734, "o", "      assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>     }"]
[88.428877, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.429042, "o", "    const invalidBodies = [\"{\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(), created: \"yesterday\" }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.42932, "o", "      JSON.stringify(event(\"bad_amount\", \"refund.requested\", { amount: -1 })),\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.429417, "o", "> "]
[88.429589, "o", "      JSON.stringify(event(\"bad_currency\", \"refund.requested\", { currency: null })),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.430046, "o", "      JSON.stringify(event(\"bad_refund\", \"refund.cancelled\", { refund_id: \"\" }))];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.430318, "o", "    for (const raw of invalidBodies) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.430452, "o", "> "]
[88.431135, "o", "      const response = await post(raw, { \"paygate-signature\": signature(raw, now) });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.431304, "o", "      assert.equal(response.status, 400, raw);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.431609, "o", "      assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.43176, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.431884, "o", "    assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.432022, "o", "  });\r\n\u001b[?2004l\r   assert.equal(pro\u001b[?2004h> });\r\n\u001b[?2004l\rcess\u001b[?2004h> "]
