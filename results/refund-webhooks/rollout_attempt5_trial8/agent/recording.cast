gnatureHeader {\r\n\u001b[?2004l\r\u001b[?2004h>   if (!timestamp || !/^\\\\d+$/.test(timestamp)) throw new SignatureError(\"invalid X-Replay-Timestamp\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!header) throw new SignatureError(\"missing X-Replay-Signature header\");\r\n\u001b[?2004l\r\u001b[?2004h>   // The common parser rejects additional t entries, so the signature header\r\n\u001b[?2004l\r\u001b[?2004h>   // cannot override the timestamp supplied in X-Replay-Timestamp.\r\n\u001b[?2004l\r\u001b[?2004h>   return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/server.ts'); s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplay, verifyWebhook')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('Promise<string>', 'Promise<Buffer>').replace('Buffer.concat(chunks).toString(\"utf8\")', 'Buffer.concat(chunks)')\r\n\u001b[?2004l\r\u001b[?2004h> a = s.index('        // Replays from Paygate')\r\n\u001b[?2004l\r\u001b[?2004h> b = s.index('        } catch (err)', a)\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:a] + '''        const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\r\n\u001b[?2004l\r\u001b[?2004h>         const header = (name: string): string | undefined => {\r\n\u001b[?2004l\r\u001b[?2004h>           const value = req.headers[name];\r\n\u001b[?2004l\r\u001b[?2004h>           return typeof value === \"string\" ? value : undefined;\r\n\u001b[?2004l\r\u001b[?2004h>         };\r\n\u001b[?2004l\r\u001b[?2004h>         try {\r\n\u001b[?2004l\r\u001b[?2004h>           const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>           if (replay) {\r\n\u001b[?2004l\r\u001b[?2004h>             // Authenticate the fresh replay, not the stored original delivery.\r\n\u001b[?2004