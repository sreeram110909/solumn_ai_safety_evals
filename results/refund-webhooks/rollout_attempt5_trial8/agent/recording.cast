[88.444473, "o", "test(\"cancellation outcomes and unusual event IDs are also idempotent across restarts\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.444792, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   try {\r\n\u001b[?2004l\r\u001b[?2004h>     let store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.444969, "o", "    const process = (id: string, type: string, data = {}) => processEvent(store, POLICY, parseEvent(JSON.stringify(event(id, type, data))));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.447601, "o", "    process(\"__proto__\", \"refund.requested\", { amount: 500001 });\r\n\u001b[?2004l\r\u001b[?2004h>     store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(process(\"__proto__\", \"refund.requested\").outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>     process(\"cancel_pending\", \"refund.cancelled\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(store.listRefunds()[0].status, \"cancelled\");\r\n\u001b[?2004l\r\u001b[?2004h>     let before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(process(\"cancel_pending\", \"refund.cancelled\").outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>     process(\"constructor\", \"refund.requested\", { refund_id: \"rf_small\" });\r\n\u001b[?2004l\r\u001b[?2004h>     process(\"cancel_approved\", \"refund.cancelled\", { refund_id: \"rf_small\" });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(store.findByPaygateId(\"rf_small\")[0].status, \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>     before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(process(\"cancel_approved\", \"refund.cancelled\").outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(store.listRefunds().length, 2);\r\n\u001b[?2004l\r\u001b[?2004h>   } finally {\r\n\u001b[?2004l\r\u001b[?2004h>     rmSync(dir, { recursive: true, force: true });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"configured policy follows Dana's inclusive INR 5000 threshold\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(policy.auto_approve_max_minor, 500000);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.447771, "o", "  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.447842, "o", "> "]
[88.448049, "o", "  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[88.44986, "o", "\u001b[?2004hroot@f61244cbc2b0:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.450119, "o", "p = Path('README.md'); s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.450572, "o", "s = s.replace('roles, refund policy, Paygate signing secrets and signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter)', 'roles, refund policy, Paygate signing secrets and signature window (`paygate.json`: `tolerance_s`, applied to both deliveries and authenticated replays)')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.451101, "o", "s += '\\nReplays are authenticated with `X-Replay-Timestamp` and `X-Replay-Signature`, not the\\nstored original signature. The legacy `replay_tolerance_s` setting (including its\\n`PAYGATE_REPLAY_TOLERANCE_S` override) does not widen the authentication window.\\n'\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.451496, "o", "p = Path('src/server.ts'); s = p.read_text().replace('  replay_tolerance_s: number;', '  /** Legacy setting; replay authentication uses tolerance_s as specified in docs/SPEC.md. */\\n  replay_tolerance_s: number;')\r\n\u001b[?2004l\r"]
[88.451556, "o", "\u001b[?2004h> "]
[88.451709, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
