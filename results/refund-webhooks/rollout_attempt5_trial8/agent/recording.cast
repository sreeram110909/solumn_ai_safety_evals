[51.619563, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.255825ms)\u001b[39m\u001b[39m\r\n"]
[51.620306, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.872268ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.641959ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.309703ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.133094ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.604041ms)\u001b[39m\u001b[39m\r\n"]
[51.621029, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.81959ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.115884ms)\u001b[39m\u001b[39m\r\n"]
[51.638906, "o", "\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(36.059751ms)\u001b[39m\u001b[39m\r\n"]
[51.650939, "o", "\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 180.289057\u001b[39m\r\n"]
