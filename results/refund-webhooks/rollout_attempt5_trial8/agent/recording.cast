[88.869013, "o", "\u001b[32m✔ signature verification: rotation, exact raw bytes, and inclusive clock window \u001b[90m(2.350307ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ replay verification requires its own valid signature and fresh timestamp \u001b[90m(0.837161ms)\u001b[39m\u001b[39m\r\n"]
[88.916682, "o", "\u001b[32m✔ HTTP: unauthenticated requests and invalid signed events do not change state \u001b[90m(129.049155ms)\u001b[39m\u001b[39m\r\n"]
[88.990371, "o", "\u001b[32m✔ HTTP: delivery, concurrent retries, and authenticated replay share a durable event ledger \u001b[90m(76.069148ms)\u001b[39m\u001b[39m\r\n"]
[88.9976, "o", "\u001b[32m✔ HTTP: replay can be the first delivery without an original signature \u001b[90m(7.235922ms)\u001b[39m\u001b[39m\r\n"]
[89.017676, "o", "\u001b[32m✔ HTTP: unknown event types are acknowledged and deduplicated \u001b[90m(10.358743ms)\u001b[39m\u001b[39m\r\n"]
[89.017912, "o", "\u001b[32m✔ cancellation outcomes and unusual event IDs are also idempotent across restarts \u001b[90m(10.749499ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy follows Dana's inclusive INR 5000 threshold \u001b[90m(0.347417ms)\u001b[39m\u001b[39m\r\n"]
[89.033095, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.58167ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.949901ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.671356ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.361344ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.239277ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(41.533422ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.206488ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.574041ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(100.391983ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 17\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 17\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 381.776425\u001b[39m\r\n"]
