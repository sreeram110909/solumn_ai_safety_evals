[88.403574, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readdirSync, readFileSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_pay381\";\nconst OLD_SECRET = \"whsec_old\";\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\nconst event = (id = \"evt_381\", type = \"refund.requested\", data = {}) => ({\n  event_id: id, type, created: NOW,\n  data: { refund_id: \"rf_381\", payment_id: \"pay_381\", amount: 500000, currency: \"INR\", ...data },\n});\nconst signature = (body: string | Buffer, timestamp: number, secret = SECRET) =>\n  `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\n\n// Compare the whole durable store, not just refund counts (raw events and audits\n// must also remain untouched on duplicates and unauthenticated deliveries).\nfunction snapshot(dir: string): Record<string, string> {\n  const out: Record<string, string> = {};\n  for (const name of readdirSync(dir, { recursive: true, withFileTypes: true })) {\n    if (name.isFile()) {\n      const path = join(name.parentPath, name.name);\n      out[path] = readFileSync(path).toString(\"hex\");\n    }\n  }\n  return out;\n}\n\nasync function withApp(run: (store: Store, dir: string, post: (\n  body: string | Buffer, headers?: Record<string, string>\n) => Promise<Response>) => Promise<void>) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY, {\n    webhook_secrets: [OLD_SECRET, SECRET], tolerance_s: 300,\n    // A legacy setting must not relax authentication for replay requests.\n    replay_tolerance_s: 86400,\n  });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\n  try {\n    await run(store, dir, (body, headers = {}) => fetch(url, { method: \"POST\", body, headers }));\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  }\n}\n\ntest(\"signature verification: rotation, exact raw bytes, and inclusive clock window\", () => {\n  const body = Buffer.from(' { \"message\": \"₹\", \"value\": 1 }\\n');\n  const digest = createHmac(\"sha256\", SECRET).update(`${NOW}.`).update(body).digest(\"hex\");\n  assert.equal(computeSignature(SECRET, NOW, body), digest);\n  const header = `t=${NOW},v1=${\"0\".repeat(64)},v1=${digest}`;\n  for (const offset of [-300, 0, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(body, header, [OLD_SECRET, SECRET], NOW + offset));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW + offset), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body.toString())), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);\n  for (const invalid of [undefined, \"\", `t=${NOW}`, `v1=${digest}`, `t=nope,v1=${digest}`,\n    `t=${NOW},t=${NOW},v1=${digest}`, `t=${NOW},v1=ff`, `t=${\"9\".repeat(400)},v1=${digest}`]) {\n    assert.throws(() => verifyWebhook(body, invalid, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"replay verification requires its own valid signature and fresh timestamp\", () => {\n  const body = JSON.stringify(event());\n  const header = `v1=${\"0\".repeat(64)},v1=${computeSignature(SECRET, NOW, body)}`;\n  assert.doesNotThrow(() => verifyReplay(body, String(NOW)"]
[88.403804, "i", ", header, [OLD_SECRET, SECRET], NOW));\n  for (const offset of [-301, 301]) {\n    const t = NOW + offset;\n    assert.throws(() => verifyReplay(body, String(t), `v1=${computeSignature(SECRET, t, body)}`, [SECRET], NOW), SignatureError);\n  }\n  for (const h of [undefined, \"\", `v1=${\"0\".repeat(64)}`, `t=${NOW},${header}`]) {\n    assert.throws(() => verifyReplay(body, String(NOW), h, [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyReplay(body, \"NaN\", header, [SECRET], NOW), SignatureError);\n});\n\ntest(\"HTTP: unauthenticated requests and invalid signed events do not change state\", async () => {\n  await withApp(async (store, dir, post) => {\n    const body = JSON.stringify(event());\n    const now = Math.floor(Date.now() / 1000);\n    const valid = { \"paygate-signature\": signature(body, now) };\n    const before = snapshot(dir);\n    const badHeaders = [\n      {},\n      { \"paygate-signature\": signature(body, now, \"wrong\") },\n      { \"paygate-signature\": signature(body, now - 3600) },\n      { \"paygate-signature\": signature(body, now + 3600) },\n      { ...valid, \"x-replay-timestamp\": String(now) },\n      { ...valid, \"x-replay-timestamp\": \"\" },\n      { ...valid, \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${\"0\".repeat(64)}` },\n      { ...valid, \"x-replay-timestamp\": String(now - 3600),\n        \"x-replay-signature\": `v1=${computeSignature(SECRET, now - 3600, body)}` },\n      { ...valid, \"x-replay-timestamp\": String(now + 3600),\n        \"x-replay-signature\": `v1=${computeSignature(SECRET, now + 3600, body)}` },\n    ];\n    for (const headers of badHeaders) {\n      const response = await post(body, headers);\n      assert.equal(response.status, 401);\n      assert.deepEqual(snapshot(dir), before);\n    }\n    const invalidBodies = [\"{\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(), created: \"yesterday\" }),\n      JSON.stringify(event(\"bad_amount\", \"refund.requested\", { amount: -1 })),\n      JSON.stringify(event(\"bad_currency\", \"refund.requested\", { currency: null })),\n      JSON.stringify(event(\"bad_refund\", \"refund.cancelled\", { refund_id: \"\" }))];\n    for (const raw of invalidBodies) {\n      const response = await post(raw, { \"paygate-signature\": signature(raw, now) });\n      assert.equal(response.status, 400, raw);\n      assert.deepEqual(snapshot(dir), before);\n    }\n    assert.equal(store.listRefunds().length, 0);\n  });\n});\n\ntest(\"HTTP: delivery, concurrent retries, and authenticated replay share a durable event ledger\", async () => {\n  await withApp(async (store, dir, post) => {\n    const now = Math.floor(Date.now() / 1000);\n    const body = JSON.stringify(event(), null, 2) + \"\\n\";\n    const headers = { \"paygate-signature\": signature(body, now) };\n    const responses = await Promise.all(Array.from({ length: 5 }, () => post(body, headers)));\n    const results = await Promise.all(responses.map(async res => {\n      assert.equal(res.status, 200);\n      return res.json();\n    }));\n    assert.equal(results.filter(r => r.duplicate === false).length, 1);\n    assert.equal(results.filter(r => r.duplicate === true).length, 4);\n    assert.ok(results.every(r => r.received === true));\n    const before = snapshot(dir);\n    // A different payload for the same ID must not overwrite the stored raw event.\n    const changed = JSON.stringify(event(\"evt_381\", \"refund.requested\", { amount: 999999 }));\n    const duplicate = await post(changed, { \"paygate-signature\": signature(changed, now) });\n    assert.deepEqual(await duplicate.json(), { received: true, duplicate: true });\n    const replay = await post(body, {\n      \"paygate-signature\": \"malformed original header is not used\",\n      \"x-replay-timestamp\": String(now),\n      \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}`,\n    });\n    assert.equal(replay.status, 200);\n    assert.deepEqual(await replay.json(), { received: true, duplicate: true });\n    assert.deepEqual(snapshot(dir), before);\n    const restarted = new Store(dir);\n    assert.equal(processEvent(restarted, POLICY, parseEvent(body)).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);"]
[88.404047, "o", "cat > test/pay381.test.ts <<'EOF'\r\n\u001b[?2004l\r"]
[88.404075, "i", "\n    assert.equal(store.listRefunds().length, 1);\n  });\n});\n\ntest(\"HTTP: replay can be the first delivery without an original signature\", async () => {\n  await withApp(async (store, _dir, post) => {\n    const body = JSON.stringify(event());\n    const now = Math.floor(Date.now() / 1000);\n    const response = await post(body, {\n      \"x-replay-timestamp\": String(now),\n      \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}`,\n    });\n    assert.equal(response.status, 200);\n    assert.deepEqual(await response.json(), { received: true, duplicate: false });\n    assert.equal(store.listRefunds().length, 1);\n  });\n});\n\ntest(\"HTTP: unknown event types are acknowledged and deduplicated\", async () => {\n  await withApp(async (store, dir, post) => {\n    const body = JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW, data: {} });\n    const headers = { \"paygate-signature\": signature(body, Math.floor(Date.now() / 1000)) };\n    assert.deepEqual(await (await post(body, headers)).json(), { received: true, duplicate: false });\n    const before = snapshot(dir);\n    assert.deepEqual(await (await post(body, headers)).json(), { received: true, duplicate: true });\n    assert.equal(store.listRefunds().length, 0);\n    assert.deepEqual(snapshot(dir), before);\n  });\n});\n\ntest(\"cancellation outcomes and unusual event IDs are also idempotent across restarts\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\n  try {\n    let store = new Store(dir);\n    const process = (id: string, type: string, data = {}) => processEvent(store, POLICY, parseEvent(JSON.stringify(event(id, type, data))));\n    process(\"__proto__\", \"refund.requested\", { amount: 500001 });\n    store = new Store(dir);\n    assert.equal(process(\"__proto__\", \"refund.requested\").outcome, \"duplicate\");\n    process(\"cancel_pending\", \"refund.cancelled\");\n    assert.equal(store.listRefunds()[0].status, \"cancelled\");\n    let before = snapshot(dir);\n    assert.equal(process(\"cancel_pending\", \"refund.cancelled\").outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n    process(\"constructor\", \"refund.requested\", { refund_id: \"rf_small\" });\n    process(\"cancel_approved\", \"refund.cancelled\", { refund_id: \"rf_small\" });\n    assert.equal(store.findByPaygateId(\"rf_small\")[0].status, \"auto_approved\");\n    before = snapshot(dir);\n    assert.equal(process(\"cancel_approved\", \"refund.cancelled\").outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n    assert.equal(store.listRefunds().length, 2);\n  } finally {\n    rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"configured policy follows Dana's inclusive INR 5000 threshold\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('README.md'); s = p.read_text()\ns = s.replace('roles, refund policy, Paygate signing secrets and signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter)', 'roles, refund policy, Paygate signing secrets and signature window (`paygate.json`: `tolerance_s`, applied to both deliveries and authenticated replays)')\ns += '\\nReplays are authenticated with `X-Replay-Timestamp` and `X-Replay-Signature`, not the\\nstored original signature. The legacy `replay_tolerance_s` setting (including its\\n`PAYGATE_REPLAY_TOLERANCE_S` override) does not widen the authentication window.\\n'\np.write_text(s)\np = Path('src/server.ts'); s = p.read_text().replace('  replay_tolerance_s: number;', '  /** Legacy setting; replay authentication uses tolerance_s as specified in docs/SPEC.md. */\\n  replay_tolerance_s: number;')\np.write_text(s)\nPY\nnpm test\n"]
