[88.432861, "o", "test(\"HTTP: delivery, concurrent retries, and authenticated replay share a durable event ledger\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.433213, "o", "  await withApp(async (store, dir, post) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.433496, "o", "    const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.433982, "o", "    const body = JSON.stringify(event(), null, 2) + \"\\n\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.434289, "o", "    const headers = { \"paygate-signature\": signature(body, now) };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.43474, "o", "    const responses = await Promise.all(Array.from({ length: 5 }, () => post(body, headers)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.435024, "o", "    const results = await Promise.all(responses.map(async res => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.435252, "o", "      assert.equal(res.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.435299, "o", "      return res.json();\r\n\u001b[?2004l\r\u001b[?2004h>     }));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.435569, "o", "    assert.equal(results.filter(r => r.duplicate === false).length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.435908, "o", "    assert.equal(results.filter(r => r.duplicate === true).length, 4);\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.436035, "o", "> "]
[88.436171, "o", "    assert.ok(results.every(r => r.received === true));\r\n\u001b[?2004l\rro"]
[88.436243, "o", "\u001b[?2004h> "]
[88.436474, "o", "    const before = snapshot(dir);\r\n\u001b[?2004l\rlib import Path\r\np = Path('RE\u001b[?2004h> "]
[88.436691, "o", "    // A different payload for the same ID must not overwrite the stored raw event.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.437198, "o", "    const changed = JSON.stringify(event(\"evt_381\", \"refund.requested\", { amount: 999999 }));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.437667, "o", "    const duplicate = await post(changed, { \"paygate-signature\": signature(changed, now) });\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.437697, "o", "> "]
[88.43816, "o", "    assert.deepEqual(await duplicate.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.438418, "o", "    const replay = await post(body, {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.438832, "o", "      \"paygate-signature\": \"malformed original header is not used\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.438997, "o", "      \"x-replay-timestamp\": String(now),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.439427, "o", "      \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}`,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.439679, "o", "    });\r\n\u001b[?2004l\r` \u001b[?2004h> "]
[88.439718, "o", "    assert.equal(replay.status, 200);\r\n\u001b[?2004l\r"]
[88.439741, "o", "\u001b[?2004h"]
[88.439802, "o", "> "]
[88.440085, "o", "    assert.deepEqual(await replay.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.440255, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>     const restarted = new Store(dir);\r\n\u001b[?2004l\r"]
[88.440365, "o", "\u001b[?2004h> "]
[88.440628, "o", "    assert.equal(processEvent(restarted, POLICY, parseEvent(body)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.440857, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.440955, "o", ">     assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r"]
