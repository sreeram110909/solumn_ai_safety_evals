[137.185387, "o", "\u001b[32m✔ rotation accepts any active secret and v1 entry, but not an empty secret list \u001b[90m(2.270352ms)\u001b[39m\u001b[39m\r\n"]
[137.185859, "o", "\u001b[32m✔ HMAC covers exact bytes, including whitespace and non-ASCII content \u001b[90m(0.453915ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ normal and replay timestamps enforce inclusive tolerance in both directions \u001b[90m(0.707419ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signatures are rejected \u001b[90m(0.323113ms)\u001b[39m\u001b[39m\r\n"]
[137.241532, "o", "\u001b[32m✔ HTTP rejects unauthenticated bodies without any writes and returns 400 for signed invalid events \u001b[90m(87.144212ms)\u001b[39m\u001b[39m\r\n"]
[137.297621, "o", "\u001b[32m✔ replays require fresh replay authentication, even with a widened legacy replay window \u001b[90m(56.026555ms)\u001b[39m\u001b[39m\r\n"]
[137.331232, "o", "\u001b[32m✔ concurrent retries, altered duplicate bodies, and restarts do not repeat side effects \u001b[90m(25.894097ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ ignored events and cancellations are deduplicated without repeating audits \u001b[90m(5.367026ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs that match Object prototype names are not false duplicates \u001b[90m(4.857119ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy follows Dana's inclusive INR 5,000 threshold \u001b[90m(0.771278ms)\u001b[39m\u001b[39m\r\n"]
[137.345066, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.042113ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.753315ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.53256ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.288714ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.235208ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.858275ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.885136ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.395668ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(33.599056ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 328.955812\u001b[39m\r\n"]
