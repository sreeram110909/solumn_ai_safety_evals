[110.72273, "o", "\u001b[?2004h> "]
[110.722856, "o", "      assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.723034, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.723164, "o", "    // The original signature is deliberately invalid: replay authentication stands alone.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.723473, "o", "    const headers = { \"paygate-signature\": \"invalid\", \"x-replay-timestamp\": String(now),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.723885, "o", "      \"x-replay-signature\": `v1=${\"0\".repeat(64)},v1=${computeSignature(SECRET, now, body)}` };\r\n\u001b[?2004l\r\u001b[?2004h> "]
