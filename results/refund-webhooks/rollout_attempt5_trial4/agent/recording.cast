[146.715567, "o", "\u001b[1mdiff --git a/config/refunds.json b/config/refunds.json\u001b[m\r\n\u001b[1mindex 01e3041..be3ce10 100644\u001b[m\r\n\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,5 +1,5 @@\u001b[m\r\n {\u001b[m\r\n"]
