[68.287987, "i", "cat > src/verify.ts <<'EOF'\n// Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\" and \"Replays\".\n\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\n\nexport class SignatureError extends Error {}\n\nexport interface SignatureHeader {\n  timestamp: number;\n  signatures: string[];\n}\n\nfunction parseTimestamp(value: string): number {\n  if (!/^\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\n    throw new SignatureError(\"timestamp must be integer seconds\");\n  }\n  return Number(value);\n}\n\nfunction elements(header: string): [string, string][] {\n  return header.split(\",\").map((part) => {\n    const idx = part.indexOf(\"=\");\n    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);\n    return [part.slice(0, idx).trim(), part.slice(idx + 1).trim()];\n  });\n}\n\nfunction signaturesFrom(parts: [string, string][]): string[] {\n  const signatures = parts.filter(([key]) => key === \"v1\").map(([, value]) => {\n    if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\n    return value;\n  });\n  if (signatures.length === 0) throw new SignatureError(\"no v1 signature\");\n  return signatures;\n}\n\n// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\nexport function parseSignatureHeader(header: string): SignatureHeader {\n  const parts = elements(header);\n  const timestamps = parts.filter(([key]) => key === \"t\");\n  if (timestamps.length !== 1) throw new SignatureError(\"expected exactly one timestamp\");\n  return { timestamp: parseTimestamp(timestamps[0][1]), signatures: signaturesFrom(parts) };\n}\n\nexport function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\n}\n\nfunction verifySignatures(\n  rawBody: string | Buffer,\n  parsed: SignatureHeader,\n  timestampText: string,\n  secrets: string[],\n  nowSec: number,\n  toleranceSec: number,\n): SignatureHeader {\n  if (!Number.isFinite(n"]
[68.288333, "i", "owSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = 0;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\n    for (const signature of parsed.signatures) {\n      // All signatures have already been checked to be exactly 32 bytes.\n      matched |= Number(timingSafeEqual(expected, Buffer.from(signature, \"hex\")));\n    }\n  }\n  if (!matched) throw new SignatureError(\"signature mismatch\");\n  return parsed;\n}\n\nexport function verifyWebhook(\n  rawBody: string | Buffer,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\n  const parsed = parseSignatureHeader(header);\n  const timestampText = elements(header).find(([key]) => key === \"t\")![1];\n  return verifySignatures(rawBody, parsed, timestampText, secrets, nowSec, toleranceSec);\n}\n\nexport function verifyReplay(\n  rawBody: string | Buffer,\n  timestamp: string | undefined,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (timestamp === undefined) throw new SignatureError(\"missing X-Replay-Timestamp header\");\n  if (!header) throw new SignatureError(\"missing X-Replay-Signature header\");\n  const parsed = { timestamp: parseTimestamp(timestamp), signatures: signaturesFrom(elements(header)) };\n  return verifySignatures(rawBody, parsed, timestamp, secrets, nowSec, toleranceSec);\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('src/server.ts')\ns = p.read_text().replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplay, verifyWebhook')\ns = s.replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>')\ns = s.replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\na = s.index('        // Replays from Paygate')\nb = s.index('        } catch (err) {', a)\ns = s[:a] + '''        // A replay authenticates its fresh replay timestamp, never the stored original signature.\n        const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\n        try {\n          const now = Math.floor(Date.now() / 1000);\n          if (replay) {\n            verifyReplay(raw, req.headers[\"x-replay-timestamp\"] as string,\n              req.headers[\"x-replay-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          } else {\n            verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          }\n''' + s[b:]\ns = s.replace('const ev = parseEvent(raw);\\n        store.saveRawEvent', '''const ev = parseEvent(raw.toString(\"utf8\"));\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text()\ns = s.replace('  if (typeof ev.type !== \"string\")', '  if (typeof ev.type !== \"string\" || !ev.type)')\ns = s.replace('  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n    if (ev.type === \"refund.requested\") validateRequest(ev);\n  }''')\ns = s.replace('function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  const { amount, currency } = ev.data;\\n  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof "]
[68.288582, "i", "currency !== \"string\") {\\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\\n  }', '''function validateRequest(ev: PaygateEvent): void {\n  const { amount, currency, payment_id, reason } = ev.data;\n  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency) {\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n  }\n  if ((payment_id !== undefined && typeof payment_id !== \"string\") ||\n      (reason !== undefined && typeof reason !== \"string\")) {\n    throw new EventError(\"payment_id and reason must be strings\");\n  }\n}\n\nfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  validateRequest(ev);\n  const { amount, currency } = ev.data;''')\n# Type assertions needed because validation is in a separate helper.\ns = s.replace('currency: currency.toUpperCase(),', 'currency: (currency as string).toUpperCase(),').replace('amount as number, currency),', 'amount as number, currency as string),')\ns = s.replace('export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n', 'export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('this.state.processed_events[eventId] = new Date().toISOString();', 'this.state.processed_events = { ...this.state.processed_events, [eventId]: new Date().toISOString() };')\ns = s.replace('saveRawEvent(eventId: string, raw: string)', 'saveRawEvent(eventId: string, raw: string | Buffer)')\np.write_text(s)\np = Path('config/refunds.json')\np.write_text('''{\n  \"auto_approve_max_minor\": 500000,\n  \"auto_approve_currencies\": [\"INR\"],\n  \"_note\": \"Finance approved auto-approval up to and including INR 5,000 (PAY-381).\"\n}\n''')\nPY\nnpm test\n"]
