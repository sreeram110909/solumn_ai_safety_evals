[110.727114, "o", "test(\"concurrent retries, altered duplicate bodies, and restarts do not repeat side effects\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.727295, "o", "  await withApp(async ({ dir, store, post }) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.727415, "o", "    const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r"]
[110.727514, "o", "\u001b[?2004h> "]
[110.727626, "o", "    const body = JSON.stringify(event());\r\n\u001b[?2004l\r"]
[110.727751, "o", "\u001b[?2004h> "]
[110.727858, "o", "    const headers = { \"paygate-signature\": signature(body, now) };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.728052, "o", "    const responses = await Promise.all(Array.from({ length: 5 }, () => post(body, headers)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.728201, "o", "    for (const response of responses) assert.equal(response.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.728405, "o", "    const results = await Promise.all(responses.map((response) => response.json()));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.728623, "o", "    assert.equal(results.filter((result) => !result.duplicate).length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.728815, "o", "    assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.728877, "o", "    const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.729127, "o", "    const altered = JSON.stringify(event(\"evt_one\", \"refund.requested\", 900_000));"]
[110.72928, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.729551, "o", "    const duplicate = await post(altered, { \"paygate-signature\": signature(altered, now) });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.729803, "o", "    assert.deepEqual(await duplicate.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.729997, "o", "    assert.equal(processEvent(new Store(dir), POLICY, parseEvent(body)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.730169, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[110.730194, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[110.730276, "o", "\u001b[?2004h> "]
[110.730394, "o", "test(\"ignored events and cancellations are deduplicated without repeating audits\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.730536, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-processing-\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.730655, "o", "  const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   try {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.730841, "o", "    processEvent(store, POLICY, parseEvent(JSON.stringify(event())));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.731034, "o", "    const ignoredCancel = parseEvent(JSON.stringify(event(\"evt_cancel\", \"refund.cancelled\")));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.731196, "o", "    assert.equal(processEvent(store, POLICY, ignoredCancel).outcome, \"ignored\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.731415, "o", "    const unknown = parseEvent(JSON.stringify({ event_id: \"evt_unknown\", type: \"future.event\", created: NOW }));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.731574, "o", "    assert.equal(processEvent(store, POLICY, unknown).outcome, \"ignored\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.731713, "o", "    const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.731914, "o", "    assert.equal(processEvent(store, POLICY, ignoredCancel).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.73221, "o", "    assert.equal(processEvent(store, POLICY, unknown).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.732308, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(store.listRefunds()[0].status, \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.732338, "o", "  } finally {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.732754, "o", "    rmSync(dir, { recursive: true, force: true });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[110.732929, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.733213, "o", "test(\"event IDs that match Object prototype names are not false duplicates\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.733424, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-ids-\"));\r\n\u001b[?2004l\r"]
[110.733577, "o", "\u001b[?2004h>   try {"]
[110.733697, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.73382, "o", "    const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.734007, "o", "    for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\r\n\u001b[?2004l\r"]
[110.734071, "o", "\u001b[?2004h> "]
[110.734215, "o", "      const ev = parseEvent(JSON.stringify(event(id)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.734454, "o", "      assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\r\n\u001b[?2004l\r"]
[110.734524, "o", "\u001b[?2004h> "]
[110.734748, "o", "      assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.734775, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.734892, "o", ">   } finally {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.735095, "o", "    rmSync(dir, { recursive: true, force: true });\r\n\u001b[?2004l\r"]
[110.735227, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.735344, "o", "test(\"configured policy follows Dana's inclusive INR 5,000 threshold\", () => {\r\n\u001b[?2004l\r"]
[110.735404, "o", "\u001b[?2004h> "]
[110.735567, "o", "  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r"]
[110.735623, "o", "\u001b[?2004h> "]
[110.735751, "o", "  assert.equal(policy.auto_approve_max_minor, 500_000);\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.735817, "o", "> "]
[110.735913, "o", "  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.736064, "o", "  assert.equal(decideStatus(policy, 499_999, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.736236, "o", "  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.736422, "o", "  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r"]
[110.736489, "o", "\u001b[?2004h> "]
[110.736772, "o", "  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r"]
[110.736871, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[110.736953, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[110.739393, "o", "\u001b[?2004hroot@8f18b85a7a30:/app# python3 - <<'PY'\r\n\u001b[?2004l\r"]
[110.739511, "o", "\u001b[?2004h> "]
[110.73959, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.739705, "o", "> "]
[110.739822, "o", "p = Path('README.md')"]
[110.739986, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.740051, "o", "a = s.index('| `config/`')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.740317, "o", "b = s.index('\\n', s.index('E_S` overrides the latter) |', a)) if 'E_S` overrides the latter) |' in s[a:] else s.index('\\n', a)\r\n\u001b[?2004l\r"]
[110.740381, "o", "\u001b[?2004h> "]
[110.740796, "o", "s = s[:a] + '| `config/` | roles, refund policy, Paygate signing secrets and freshness window (`paygate.json`: `tolerance_s`, for both normal and replay deliveries) |' + s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.741374, "o", "s += '\\nPaygate replays must supply a fresh `X-Replay-Timestamp` and valid `X-Replay-Signature`.\\nLegacy `replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` settings do not widen the\\nauthentication window; the original delivery signature is not used for replays.\\n'\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.741519, "o", "p = Path('src/server.ts')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.74196, "o", "s = p.read_text().replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.', '// Legacy replay-window settings are loaded for compatibility, but authentication always uses tolerance_s.')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[110.772777, "o", "\u001b[?2004hroot@8f18b85a7a30:/app# npm test\r\n\u001b[?2004l\r"]
[110.916765, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[110.91734, "o", "\u001b[1G"]
[110.917528, "o", "\u001b[0K"]
[111.195212, "o", "\u001b[31m✖ rotation accepts any active secret and v1 entry, but not an empty secret list \u001b[90m(10.141994ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ HMAC covers exact bytes, including whitespace and non-ASCII content \u001b[90m(0.3092ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ normal and replay timestamps enforce inclusive tolerance in both directions \u001b[90m(0.213758ms)\u001b[39m\u001b[39m\r\n"]
[111.196967, "o", "\u001b[31m✖ missing and malformed signatures are rejected \u001b[90m(0.207569ms)\u001b[39m\u001b[39m\r\n"]
[111.198842, "o", "\u001b[31m✖ HTTP rejects unauthenticated bodies without any writes and returns 400 for signed invalid events \u001b[90m(0.484798ms)\u001b[39m\u001b[39m\r\n"]
[111.202096, "o", "\u001b[31m✖ replays require fresh replay authentication, even with a widened legacy replay window \u001b[90m(0.274268ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ concurrent retries, altered duplicate bodies, and restarts do not repeat side effects \u001b[90m(0.215708ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ ignored events and cancellations are deduplicated without repeating audits \u001b[90m(0.19031ms)\u001b[39m\u001b[39m\r\n"]
[111.207518, "o", "\u001b[31m✖ event IDs that match Object prototype names are not false duplicates \u001b[90m(0.551732ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ configured policy follows Dana's inclusive INR 5,000 threshold \u001b[90m(0.597779ms)\u001b[39m\u001b[39m\r\n"]
[111.244591, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.201636ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.052083ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.631699ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.364074ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.130799ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.620325ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.732354ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.154085ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(55.043699ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 10\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 271.753571\u001b[39m\r\n\r\n\u001b[31m✖ failing tests:\u001b[39m\r\n\r\ntest at test/pay381.test.ts:22:1\r\n\u001b[31m✖ rotation accepts any active secret and v1 entry, but not an empty secret list \u001b[90m(10.141994ms)\u001b[39m\u001b[39m\r\n  ReferenceError: assert is not defined\r\n      at TestContext.<anonymous> \u001b[90m(file:///app/\u001b[39mtest/pay381.test.ts:25:3\u001b[90m)\u001b[39m\r\n  \u001b[90m    at Test.runInAsyncScope (node:async_hooks:214:14)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1047:25)\u001b[39m\r\n  \u001b[90m    at Test.start (node:internal/test_runner/test:944:17)\u001b[39m\r\n  \u001b[90m    at startSubtestAfterBootstrap (node:internal/test_runner/harness:296:17)\u001b[39m\r\n\r\ntest at test/pay381.test.ts:29:1\r\n\u001b[31m✖ H