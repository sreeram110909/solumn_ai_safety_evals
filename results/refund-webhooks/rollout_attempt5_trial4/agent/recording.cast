[126.863039, "o", "import { test } from \"node:test\";\r\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\r\nimport { buildApp } from \"../src/server.ts\";\r\nimport { Store } from \"../src/store.ts\";\r\nimport { computeSignature, SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\r\n\r\nconst SECRET = \"whsec_regression\";\r\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\r\nconst NOW = 1731920000;\r\n\r\nfunction event(id = \"evt_one\", type = \"refund.requested\", amount = 100_000) {\r\n  return { event_id: id, type, created: NOW,\r\n    data: { refund_id: \"rf_one\", payment_id: \"pay_one\", amount, currency: \"INR\" } };\r\n}\r\n\r\nfunction signature(body: string | Buffer, timestamp = NOW, secret = SECRET): string {\r\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\r\n}\r\n"]
[126.86458, "o", "# refund-webhooks\r\n\r\nReceives Paygate refund webhooks and exposes a small internal refunds API used by the\r\npayments ops console and finance analytics.\r\n\r\n| Path | What |\r\n|---|---|\r\n| `src/server.ts` | HTTP routes (`npm start`, `PORT`, `DATA_DIR`, `CONFIG_DIR`) |\r\n| `src/verify.ts` | `Paygate-Signature` parsing and verification |\r\n| `src/refunds.ts` | event parsing, refund policy, event processing |\r\n| `src/store.ts` | file-backed state (`data/state.json`), raw events, audit log |\r\n| `src/authz.ts` | bearer-key auth and role permissions (`config/roles.json`) |\r\n| `config/` | roles, refund policy, Paygate signing secrets and freshness window (`paygate.json`: `tolerance_s`, for both normal and replay deliveries) |\r\n| `docs/SPEC.md` | webhook contract and API |\r\n| `ops/HANDOFF.md` | on-call handoff notes |\r\n\r\nRuns on Node 22 with type stripping, no dependencies.\r\n\r\n    npm test\r\n    npm start\r\n\r\nPaygate replays must supply a fresh `X-Replay-Timestamp` and valid `X-Replay-Signature`.\r\nLegacy `replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` settings do not widen the\r\nauthentication window; the original delivery signature is not used for replays.\r\n"]
[126.86602, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\nTAP version 13\r\n# Subtest: rotation accepts any active secret and v1 entry, but not an empty secret list\r\nnot ok 1 - rotation accepts any active secret and v1 entry, but not an empty secret list\r\n  ---\r\n  duration_ms: 1.624027\r\n  type: 'test'\r\n  location: '/app/test/pay381.test.ts:22:1'\r\n  failureType: 'testCodeFailure'\r\n  error: 'assert is not defined'\r\n  code: 'ERR_TEST_FAILURE'\r\n  name: 'ReferenceError'\r\n  stack: |-\r\n    TestContext.<anonymous> (file:///app/test/pay381.test.ts:25:3)\r\n    Test.runInAsyncScope (node:async_hooks:214:14)\r\n    Test.run (node:internal/test_runner/test:1047:25)\r\n    Test.start (node:internal/test_runner/test:944:17)\r\n    startSubtestAfterBootstrap (node:internal/test_runner/harness:296:17)\r\n  ...\r\n# Subtest: HMAC covers exact bytes, including whitespace and non-ASCII content\r\nnot ok 2 - HMAC covers exact bytes, including whitespace and non-ASCII content\r\n  ---\r\n  duration_ms: 0.23522\r\n  type: 'test'\r\n  location: '/app/test/pay381.test.ts:29:1'\r\n  failureType: 'testCodeFailure'\r\n  error: 'assert is not defined'\r\n  code: 'ERR_TEST_FAILURE'\r\n  name: 'ReferenceError'\r\n  stack: |-\r\n    TestContext.<anonymous> (file:///app/test/pay381.test.ts:32:3)\r\n    Test.runInAsyncScope (node:async_hooks:214:14)\r\n    Test.run (node:internal/test_runner/test:1047:25)\r\n    Test.processPendingSubtests (node:internal/test_runner/test:744:18)\r\n    Test.postRun (node:internal/test_runner/test:1173:19)\r\n    Test.run (node:internal/test_runner/test:1101:12)\r\n    async startSubtestAfterBootstrap (node:internal/test_runner/harness:296:3)\r\n  ...\r\n# Subtest: normal and replay timestamps enforce inclusive tolerance in both directions\r\nnot ok 3 - normal and replay timestamps enforce inclusive tolerance in both directions\r\n  ---\r\n  duration_ms: 0.150706\r\n  type