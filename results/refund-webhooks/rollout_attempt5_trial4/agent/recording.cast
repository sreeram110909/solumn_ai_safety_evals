[68.660177, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.346152ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.020706ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(1.022918ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.444092ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.210119ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.756973ms)\u001b[39m\u001b[39m\r\n"]
[68.661436, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.979634ms)\u001b[39m\u001b[39m\r\n"]
[68.663192, "o", "\u001b[32m✔ authz: keys map to role permissions \u001b[90m(2.039949ms)\u001b[39m\u001b[39m\r\n"]
[68.689421, "o", "\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(51.008979ms)\u001b[39m\u001b[39m\r\n"]
[68.705252, "o", "\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 225.539343\u001b[39m\r\n"]
