[110.624787, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer, type AddressInfo } from \"node:net\";\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('test/pay381.test.ts')\ns = p.read_text().replace('import { createServer, type AddressInfo } from \"node:net\";', 'import { createServer } from \"node:http\";\\nimport type { AddressInfo } from \"node:net\";')\np.write_text(s)\nPY\ncat >> test/pay381.test.ts <<'EOF'\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_regression\";\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\n\nfunction event(id = \"evt_one\", type = \"refund.requested\", amount = 100_000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_one\", payment_id: \"pay_one\", amount, currency: \"INR\" } };\n}\n\nfunction signature(body: string | Buffer, timestamp = NOW, secret = SECRET): string {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\n}\n\ntest(\"rotation accepts any active secret and v1 entry, but not an empty secret list\", () => {\n  const body = JSON.stringify(event());\n  const header = `${signature(body, NOW, \"wrong\")},v1=${computeSignature(SECRET, NOW, body)}`;\n  assert.doesNotThrow(() => verifyWebhook(body, header, [\"old\", SECRET], NOW));\n  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);\n});\n\ntest(\"HMAC covers exact bytes, including whitespace and non-ASCII content\", () => {\n  const body = Buffer.from(' { \"message\": \"₹5,000\" }\\n');\n  const header = signature(body);\n  assert.doesNotThrow(() => verifyWebhook(body, header, [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body.toString())), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(Buffer.concat([body, Buffer.from(\" \")]), header, [SECRET], NOW), SignatureError);\n});\n\ntest(\"normal and replay timestamps enforce inclusive tolerance in both directions\", () => {\n  const body = JSON.stringify(event());\n  for (const offset of [-301, -300, 300, 301]) {\n    const timestamp = NOW + offset;\n    const normal = () => verifyWebhook(body, signature(body, timestamp), [SECRET], NOW);\n    const replay = () => verifyReplay(body, String(timestamp), `v1=${computeSignature(SECRET, timestamp, body)}`, [SECRET], NOW);\n    if (Math.abs(offset) <= 300) {\n      assert.doesNotThrow(normal);\n      assert.doesNotThrow(replay);\n    } else {\n      assert.throws(normal, SignatureError);\n      assert.throws(replay, SignatureError);\n    }\n  }\n});\n\ntest(\"missing and malformed signatures are rejected\", () => {\n  const body = \"{}\";\n  for (const header of [undefined, \"\", `t=${NOW}`, `v1=${\"a\".repeat(64)}`,\n    `t=${NOW},v1=bad`, `t=${NOW},v1=${\"A\".repeat(64)}`,\n    `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=999999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW), SignatureError);\n  }\n});\n\n// Snapshots include raw deliveries, state, and audit records, not just refund count.\nfunction snapshot(dir: string): Record<string, string> {\n  const result: Record<string, string> = {};\n  for (const path of readdirSync(dir, { recursive: true, withFileTypes: true })) {\n    if (path.isFile()) {\n      const filename = join(path.parentPath, path.name);\n      result[filename] = readFileSync(filename).toString(\"hex\");\n    }\n  }\n  return result;\n}\n\nasync function withApp(run: (ctx: {\n  store: Store;\n  dir: string;\n  post: (body: string, headers?: Record<string, string>) => Promise<Response>;\n}) => Promise<void>): Promise<void> {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const app = build"]
[110.62506, "i", "App(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [\"old\", SECRET], tolerance_s: 300, replay_tolerance_s: 86400 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\n  try {\n    await run({ store, dir, post: (body, headers = {}) => fetch(url, { method: \"POST\", body, headers }) });\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  }\n}\n\ntest(\"HTTP rejects unauthenticated bodies without any writes and returns 400 for signed invalid events\", async () => {\n  await withApp(async ({ dir, post }) => {\n    const before = snapshot(dir);\n    const now = Math.floor(Date.now() / 1000);\n    const body = JSON.stringify(event());\n    for (const headers of [{}, { \"paygate-signature\": signature(body, now, \"wrong\") },\n      { \"paygate-signature\": signature(body, now - 301) },\n      { \"paygate-signature\": signature(body, now + 1000) }]) {\n      const res = await post(body, headers);\n      assert.equal(res.status, 401);\n      await res.json();\n      assert.deepEqual(snapshot(dir), before);\n    }\n    for (const invalid of [\"{\", \"null\", \"{}\", JSON.stringify(event(\"bad\", \"refund.requested\", -1)),\n      JSON.stringify({ ...event(\"bad\"), created: \"yesterday\" })]) {\n      const res = await post(invalid, { \"paygate-signature\": signature(invalid, now) });\n      assert.equal(res.status, 400);\n      await res.json();\n      assert.deepEqual(snapshot(dir), before);\n    }\n  });\n});\n\ntest(\"replays require fresh replay authentication, even with a widened legacy replay window\", async () => {\n  await withApp(async ({ store, dir, post }) => {\n    const now = Math.floor(Date.now() / 1000);\n    const old = now - 7200;\n    const body = JSON.stringify(event());\n    const original = { \"paygate-signature\": signature(body, old) };\n    const before = snapshot(dir);\n    const attempts = [\n      { ...original, \"x-replay-timestamp\": String(now) },\n      { ...original, \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${computeSignature(\"wrong\", now, body)}` },\n      { ...original, \"x-replay-timestamp\": String(old), \"x-replay-signature\": `v1=${computeSignature(SECRET, old, body)}` },\n      { ...original, \"x-replay-timestamp\": \"not-a-time\", \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}` },\n      { \"paygate-signature\": signature(body, now), \"x-replay-timestamp\": String(now) },\n    ];\n    for (const headers of attempts) {\n      const res = await post(body, headers);\n      assert.equal(res.status, 401);\n      await res.json();\n      assert.deepEqual(snapshot(dir), before);\n    }\n    // The original signature is deliberately invalid: replay authentication stands alone.\n    const headers = { \"paygate-signature\": \"invalid\", \"x-replay-timestamp\": String(now),\n      \"x-replay-signature\": `v1=${\"0\".repeat(64)},v1=${computeSignature(SECRET, now, body)}` };\n    const first = await post(body, headers);\n    assert.equal(first.status, 200);\n    assert.deepEqual(await first.json(), { received: true, duplicate: false });\n    assert.equal(store.listRefunds().length, 1);\n    const after = snapshot(dir);\n    const second = await post(body, headers);\n    assert.equal(second.status, 200);\n    assert.deepEqual(await second.json(), { received: true, duplicate: true });\n    assert.deepEqual(snapshot(dir), after);\n  });\n});\n\ntest(\"concurrent retries, altered duplicate bodies, and restarts do not repeat side effects\", async () => {\n  await withApp(async ({ dir, store, post }) => {\n    const now = Math.floor(Date.now() / 1000);\n    const body = JSON.stringify(event());\n    const headers = { \"paygate-signature\": signature(body, now) };\n    const responses = await Promise.all(Array.from({ length: 5 }, () => post(body, headers)));\n    for (const response of responses) assert.equal(response.status, 200);\n    const results = await Promise.all(respo"]
[110.625239, "i", "nses.map((response) => response.json()));\n    assert.equal(results.filter((result) => !result.duplicate).length, 1);\n    assert.equal(store.listRefunds().length, 1);\n    const before = snapshot(dir);\n    const altered = JSON.stringify(event(\"evt_one\", \"refund.requested\", 900_000));\n    const duplicate = await post(altered, { \"paygate-signature\": signature(altered, now) });\n    assert.deepEqual(await duplicate.json(), { received: true, duplicate: true });\n    assert.equal(processEvent(new Store(dir), POLICY, parseEvent(body)).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  });\n});\n\ntest(\"ignored events and cancellations are deduplicated without repeating audits\", async () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-processing-\"));\n  const store = new Store(dir);\n  try {\n    processEvent(store, POLICY, parseEvent(JSON.stringify(event())));\n    const ignoredCancel = parseEvent(JSON.stringify(event(\"evt_cancel\", \"refund.cancelled\")));\n    assert.equal(processEvent(store, POLICY, ignoredCancel).outcome, \"ignored\");\n    const unknown = parseEvent(JSON.stringify({ event_id: \"evt_unknown\", type: \"future.event\", created: NOW }));\n    assert.equal(processEvent(store, POLICY, unknown).outcome, \"ignored\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, ignoredCancel).outcome, \"duplicate\");\n    assert.equal(processEvent(store, POLICY, unknown).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n    assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  } finally {\n    rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"event IDs that match Object prototype names are not false duplicates\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-ids-\"));\n  try {\n    const store = new Store(dir);\n    for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n      const ev = parseEvent(JSON.stringify(event(id)));\n      assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n      assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n    }\n  } finally {\n    rmSync(dir, { recursive: true, force: true });\n  }\n});\n\ntest(\"configured policy follows Dana's inclusive INR 5,000 threshold\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 499_999, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('README.md')\ns = p.read_text()\na = s.index('| `config/`')\nb = s.index('\\n', s.index('E_S` overrides the latter) |', a)) if 'E_S` overrides the latter) |' in s[a:] else s.index('\\n', a)\ns = s[:a] + '| `config/` | roles, refund policy, Paygate signing secrets and freshness window (`paygate.json`: `tolerance_s`, for both normal and replay deliveries) |' + s[b:]\ns += '\\nPaygate replays must supply a fresh `X-Replay-Timestamp` and valid `X-Replay-Signature`.\\nLegacy `replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` settings do not widen the\\nauthentication window; the original delivery signature is not used for replays.\\n'\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.', '// Legacy replay-window settings are loaded for compatibility, but authentication always uses tolerance_s.')\np.write_text(s)\nPY\nnpm test\n"]
