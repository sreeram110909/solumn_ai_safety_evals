[53.344851, "i", "python3 - <<'PY'\nfrom pathlib import Path\nimport json\np=Path('src/verify.ts')\ns=p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns=s.replace('      if (!/^\\\\d+$/.test(value))', '      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\\n      if (!/^\\\\d+$/.test(value))')\ns=s.replace('      timestamp = Number(value);', '      timestamp = Number(value);\\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"invalid timestamp\");')\ns=s.replace('rawBody: string', 'rawBody: string | Buffer')\ns=s.replace('createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\")', 'createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\")')\ns=s.replace('  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\\n  void rawBody;\\n  void secrets;\\n  void nowSec;\\n  void toleranceSec;', '''  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  const candidates = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const candidate of candidates) {\n      // Evaluate every comparison, including during key rotation.\n      matched = timingSafeEqual(expected, candidate) || matched;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");''')\np.write_text(s)\np=Path('src/server.ts'); s=p.read_text()\ns=s.replace('Promise<string> {', 'Promise<Buffer> {').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns=s.replace('        const raw = await readBody(req);', '        const body = await readBody(req);')\ns=s.replace('verifyWebhook(raw, req.headers', 'verifyWebhook(body, req.headers')\ns=s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '        const raw = body.toString(\"utf8\");\\n        const ev = parseEvent(raw);\\n        if (!store.isProcessed(ev.event_id)) store.saveRawEvent(ev.event_id, raw);')\np.write_text(s)\np=Path('src/store.ts'); s=p.read_text().replace('  private state: State;', '  private state: State;\\n  private pendingAudits: Record<string, unknown>[] | undefined;')\ns=s.replace('  private flush(): void {\\n', '  private flush(): void {\\n    if (this.pendingAudits) return;\\n')\ns=s.replace('  newRefundId(): string {', '''  // Commit a refund mutation and its processed-event marker in the same atomic write.\n  // Failed processing leaves neither partial state nor success audit entries behind.\n  transaction<T>(action: () => T): T {\n    if (this.pendingAudits) throw new Error(\"nested store transaction\");\n    const before = structuredClone(this.state);\n    const audits: Record<string, unknown>[] = [];\n    this.pendingAudits = audits;\n    let result: T;\n    try {\n      result = action();\n      this.pendingAudits = undefined;\n      this.flush();\n    } catch (err) {\n      this.state = before;\n      throw err;\n    } finally {\n      this.pendingAudits = undefined;\n    }\n    for (const entry of audits) this.audit(entry);\n    return result;\n  }\n\n  newRefundId(): string {''')\ns=s.replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns=s.replace('    this.state.processed_events[eventId] = new Date().toISOString();', '    Object.defineProperty(this.state.processed_events, eventId, {\\n      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\\n    });')\ns=s.replace('  audit(entry: Record<string, unknown>): void {\\n', '  audit(entry: Record<string, unknown>): void {\\n    if (this.pendingAudits) {\\n      this.pendingAudits.push(entry);\\n      return;\\n    }\\n')\np.write_text(s)\np=Pa"]
