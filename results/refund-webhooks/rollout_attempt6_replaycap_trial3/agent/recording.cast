[114.700293, "o", "\u001b[?2004h> "]
[114.700667, "o", "test(\"configured threshold is inclusive ₹5,000, INR-only; replay guards remain\", () => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.700737, "o", "> "]
[114.701349, "o", "  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h"]
[114.701412, "o", "> "]
[114.701947, "o", "  assert.equal(policy.auto_approve_max_minor, 500000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.70289, "o", "  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");"]
[114.70351, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
