[87.093053, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { buildApp } from \"../src/server.ts\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"test-secret\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nfunction event(id = \"evt_test\", type = \"refund.requested\", amount = 500000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" } };\n}\nfunction header(body: string | Buffer, timestamp = NOW, secret = SECRET): string {\n  // Independent reference implementation, including the original raw bytes.\n  const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\n  return `t=${timestamp},v1=${digest}`;\n}\nfunction fixture(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return { dir, store: new Store(dir) };\n}\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => [join(entry.parentPath, entry.name).slice(dir.length),\n      readFileSync(join(entry.parentPath, entry.name)).toString(\"base64\")]));\n}\nasync function httpFixture(t: TestContext) {\n  const { dir, store } = fixture(t);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  async function post(raw: string | Buffer, headers: Record<string, string> = {}) {\n    return fetch(`http://127.0.0.1:${address.port}/webhooks/paygate`, {\n      method: \"POST\", body: raw, headers,\n    });\n  }\n  function signed(raw: string | Buffer) {\n    return post(raw, { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000)) });\n  }\n  return { dir, store, post, signed };\n}\n\ntest(\"rotation accepts any v1 with any configured secret\", () => {\n  const raw = JSON.stringify(event());\n  const h = `${header(raw, NOW, \"old-secret\")},v1=${computeSignature(SECRET, NOW, raw)}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, h, [\"unrelated\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, h, [\"old-secret\", \"new-secret\"], NOW));\n  assert.throws(() => verifyWebhook(raw, h, [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and applies in both directions\", () => {\n  const raw = JSON.stringify(event());\n  for (const delta of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, header(raw), [SECRET], NOW + delta));\n  }\n  for (const delta of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, header(raw), [SECRET], NOW + delta), SignatureError);\n  }\n});\n\ntest(\"malformed or missing signatures are rejected\", () => {\n  const raw = JSON.stringify(event());\n  for (const h of [undefined, \"\", `t=${NOW}`, `v1=${\"a\".repeat(64)}`,\n    `t=NaN,v1=${\"a\".repeat(64)}`, `t=${NOW},v1=bad`,\n    `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`, `t=${NOW},v1=${\"A\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(raw, h, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"HMAC authenticates exact body bytes, not reserialized JSON\", () => {\n  const raw = Buffer.from(JSON.stringify(event(), null, 2) + \""]
[87.093164, "i", "\\n\");\n  assert.doesNotThrow(() => verifyWebhook(raw, header(raw), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(event()), header(raw), [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(Buffer.concat([raw, Buffer.from(\" \")]), header(raw), [SECRET], NOW), SignatureError);\n});\n\ntest(\"HTTP: invalid signatures and replay-token-only requests do not write anything\", async (t) => {\n  const { dir, post, signed } = await httpFixture(t);\n  const raw = JSON.stringify(event());\n  const before = snapshot(dir);\n  for (const headers of [{},\n    { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000), \"wrong-secret\") },\n    { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000) - 301) },\n    { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000) + 600) },\n    { \"X-Paygate-Replay-Token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\n    const response = await post(raw, headers);\n    assert.equal(response.status, 401);\n    await response.json();\n    assert.deepEqual(snapshot(dir), before);\n  }\n  // Authenticate bytes before UTF-8 decoding (0xff would otherwise turn into U+FFFD).\n  const bytes = Buffer.concat([Buffer.from('{\"extra\":\"'), Buffer.from([0xff]),\n    Buffer.from('\",'), Buffer.from(raw.slice(1))]);\n  const response = await signed(bytes);\n  assert.equal(response.status, 200);\n  await response.json();\n});\n\ntest(\"HTTP: signed invalid events get 400 without state changes\", async (t) => {\n  const { dir, signed } = await httpFixture(t);\n  const before = snapshot(dir);\n  for (const raw of [\"{\", \"null\", \"{}\", JSON.stringify({ ...event(), created: \"invalid\" }),\n    JSON.stringify(event(\"bad_amount\", \"refund.requested\", -1)),\n    JSON.stringify({ ...event(), data: {} })]) {\n    const response = await signed(raw);\n    assert.equal(response.status, 400);\n    await response.json();\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"HTTP: duplicates never update raw events, refunds, markers, or audit logs\", async (t) => {\n  const { dir, store, signed } = await httpFixture(t);\n  const raw = JSON.stringify(event());\n  const first = await signed(raw);\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  const before = snapshot(dir);\n  const responses = await Promise.all(Array.from({ length: 5 }, () =>\n    signed(JSON.stringify(event(\"evt_test\", \"refund.requested\", 999999)))));\n  for (const response of responses) {\n    assert.equal(response.status, 200);\n    assert.deepEqual(await response.json(), { received: true, duplicate: true });\n  }\n  assert.equal(store.listRefunds().length, 1);\n  assert.deepEqual(snapshot(dir), before);\n  const reopened = new Store(dir);\n  assert.equal(processEvent(reopened, POLICY, event()).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"ignored events and cancellations are deduplicated too\", (t) => {\n  const { dir, store } = fixture(t);\n  const unknown = parseEvent(JSON.stringify({ event_id: \"evt_other\", type: \"payment.created\", created: NOW }));\n  assert.equal(processEvent(store, POLICY, unknown).outcome, \"ignored\");\n  assert.equal(processEvent(store, POLICY, unknown).outcome, \"duplicate\");\n  processEvent(store, POLICY, event());\n  const cancel = event(\"evt_cancel\", \"refund.cancelled\");\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"ignored\");\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"failed processing remains retryable without partial state or audit\", (t) => {\n  const { dir, store } = fixture(t);\n  const invalid = event(\"evt_retry\", \"refund.requested\", -1);\n  assert.throws(() => processEvent(store, POLICY, invalid), EventError);\n  assert.equal(store.isProcessed(invalid.event_id), false);\n  assert.equal(store.listRefunds().length, 0);\n  assert.deepEqual(snapshot(dir), {});\n  assert.equal(processEvent(store, POLICY, event(\"evt_retry\")).outcome, \"processed\");"]
[87.09386, "o", "\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K/1.test.ts <<'EOF'\r\r\nPattern not found\r\n\r\u001b[Kassert.doesNotThrow(() => "]
[87.093895, "i", "\n});\n\ntest(\"prototype-named event IDs are real IDs, not inherited processed markers\", (t) => {\n  const { dir, store } = fixture(t);\n  for (const id of [\"toString\", \"__proto__\", \"constructor\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n  }\n  const reopened = new Store(dir);\n  for (const id of [\"toString\", \"__proto__\", \"constructor\"]) {\n    assert.equal(processEvent(reopened, POLICY, event(id)).outcome, \"duplicate\");\n  }\n});\n\ntest(\"configured refund threshold is inclusive ₹5,000 and INR-only; replay guards stay enabled\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n  assert.equal(policy.replay.max_per_run, 20);\n  assert.equal(policy.replay.min_interval_s, 120);\n});\nEOF\nnpm test\n"]
