[114.697345, "o", "\u001b[?2004h"]
[114.697472, "o", "> "]
[114.697852, "o", "  for (const id of [\"toString\", \"__proto__\", \"constructor\"]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[114.698636, "o", "    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   const reopened = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const id of [\"toString\", \"__proto__\", \"constructor\"]) {\r\n"]
[114.698825, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[114.699203, "o", "    assert.equal(processEvent(reopened, POLICY, event(id)).outcome, \"duplicate\");"]
[114.699344, "o", "\r\n"]
