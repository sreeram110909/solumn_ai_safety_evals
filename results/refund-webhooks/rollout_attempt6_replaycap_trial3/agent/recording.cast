[114.690995, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP: invalid signatures and token-only requests never write state\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, post, signed } = await httpFixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event());\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const headers of [{},\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000), \"wrong-secret\") },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000) - 301) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000) + 600) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"X-Paygate-Replay-Token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const response = await post(raw, headers);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(response.status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>     await response.json();\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   // The original bytes must be verified before UTF-8 decoding.\r\n\u001b[?2004l\r\u001b[?2004h>   const bytes = Buffer.concat([Buffer.from('{\"extra\":\"'), Buffer.from([0xff]),\r\n\u001b[?2004l\r\u001b[?2004h>     Buffer.from('\",'), Buffer.from(raw.slice(1))]);\r\n\u001b[?2004l\r\u001b[?2004h>   const response = await signed(bytes);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(response.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   await response.json();\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP: signed invalid events get 400 without state changes\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, signed } = await httpFixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const raw of [\"{\", \"null\", \"{}\", JSON.stringify({ ...event(), created: \"invalid\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     JSON.stringify(event(\"bad_amount\", \"refund.requested\", -1)),\r\n\u001b[?2004l\r\u001b[?2004h>     JSON.stringify({ ...event(), data: {} })]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const response = await signed(raw);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(response.status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>     await response.json();\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP: duplicates never update raw events, refunds, markers, or audit logs\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, store, signed } = await httpFixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const first = await signed(JSON.stringify(event()));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(first.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await first.json(), { received: true, duplicate: false });\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const responses = await Promise.all(Array.from({ length: 5 }, () =>\r\n\u001b[?2004l\r\u001b[?2004h>     signed(JSON.stringify(event(\"evt_test\", \"refund.requested\", 999999)))));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const response of responses) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(response.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(await response.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);"]
