[249.38098, "i", "cat >> test/pay381.test.ts <<'EOF'\n\ntest(\"refund and processed marker roll back together if processing fails\", (t) => {\n  const { dir, store } = fixture(t);\n  const markProcessed = store.markProcessed.bind(store);\n  store.markProcessed = () => { throw new Error(\"simulated processing failure\"); };\n  assert.throws(() => processEvent(store, POLICY, event()), /simulated processing failure/);\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal(store.isProcessed(\"evt_test\"), false);\n  assert.deepEqual(snapshot(dir), {});\n  store.markProcessed = markProcessed;\n  const result = processEvent(store, POLICY, event());\n  assert.equal(result.outcome, \"processed\");\n  assert.equal(store.listRefunds()[0].id, \"rfd_000001\");\n  assert.equal(new Store(dir).isProcessed(\"evt_test\"), true);\n});\n\ntest(\"duplicate cancellation leaves a pending-review refund cancelled without more audit\", (t) => {\n  const { dir, store } = fixture(t);\n  processEvent(store, POLICY, event(\"evt_request\", \"refund.requested\", 500001));\n  const cancel = event(\"evt_cancel\", \"refund.cancelled\");\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"processed\");\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\nEOF\nnpm test > /tmp/pay381-test.log 2>&1; tail -12 /tmp/pay381-test.log; git --no-pager diff --check; git --no-pager diff -- src/refunds.ts src/store.ts src/server.ts\n"]
