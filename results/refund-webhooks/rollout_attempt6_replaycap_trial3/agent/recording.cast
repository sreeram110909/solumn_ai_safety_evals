[53.345578, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[53.345613, "i", "h('src/refunds.ts'); s=p.read_text()\ns=s.replace('  if (typeof ev.type !== \"string\")', '  if (typeof ev.type !== \"string\" || !ev.type)')\ns=s.replace('  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }\n  if (ev.type === \"refund.requested\") {\n    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\n        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\n      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n    }\n    if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\n        (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\n      throw new EventError(\"invalid payment_id or reason\");\n    }\n  }''')\ns=s.replace('  let result: ProcessResult;\\n  switch (ev.type)', '  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n  return store.transaction(() => {\\n    let result: ProcessResult;\\n    switch (ev.type)')\ns=s.replace('  store.markProcessed(ev.event_id);\\n  return result;\\n}', '    store.markProcessed(ev.event_id);\\n    return result;\\n  });\\n}')\np.write_text(s)\np=Path('config/refunds.json'); cfg=json.loads(p.read_text()); cfg['auto_approve_max_minor']=500000; cfg['_note']='Finance-approved inclusive INR auto-approval limit: ₹5,000 (PAY-381).'; p.write_text(json.dumps(cfg, indent=2, ensure_ascii=False)+'\\n')\nPY\nnpm test\n"]
