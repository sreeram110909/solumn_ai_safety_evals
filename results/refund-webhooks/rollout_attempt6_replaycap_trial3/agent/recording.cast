[102.235369, "o", "> import { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\r\n\u001b[?2004l\r\u001b[?2004h> import { createServer } from \"node:http\";\r\n\u001b[?2004l\r\u001b[?2004h> import { tmpdir } from \"node:os\";\r\n\u001b[?2004l\r\u001b[?2004h> import { join } from \"node:path\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test, type TestContext } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildApp } from \"../src/server.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { Store } from \"../src/store.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { SignatureError, verifyWebhook } from \"../src/verify.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const SECRET = \"test-secret\";\r\n\u001b[?2004l\r\u001b[?2004h> const NOW = 1731920000;\r\n\u001b[?2004l\r\u001b[?2004h> const POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\r\n\u001b[?2004l\r\u001b[?2004h> function event(id = \"evt_test\", type = \"refund.requested\", amount = 500000) {\r\n\u001b[?2004l\r\u001b[?2004h>   return { event_id: id, type, created: NOW,\r\n\u001b[?2004l\r\u001b[?2004h>     data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" } };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> function header(body: string | Buffer, timestamp = NOW, secret = SECRET): string {\r\n\u001b[?2004l\r\u001b[?2004h>   const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\r\n\u001b[?2004l\r\u001b[?2004h>   return `t=${timestamp},v1=${digest}`;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> function fixture(t: TestContext) {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   t.after(() => rmSync(dir, { recursive: true, force: true }));"]
[102.238889, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   return { dir, store: new Store(dir) };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> function snapshot(dir: string): Record<string, string> {\r\n\u001b[?2004l\r\u001b[?2004h>   return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\r\n\u001b[?2004l\r\u001b[?2004h>     .filter((entry) => entry.isFile())\r\n\u001b[?2004l\r\u001b[?2004h>     .map((entry) => [join(entry.parentPath, entry.name).slice(dir.length),\r\n\u001b[?2004l\r\u001b[?2004h>       readFileSync(join(entry.parentPath, entry.name)).toString(\"base64\")]));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> async function httpFixture(t: TestContext) {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, store } = fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\r\n\u001b[?2004l\r\u001b[?2004h>     { webhook_secrets: [SECRET], tolerance_s: 300 });\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => void app(req, res));\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h>   t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\r\n\u001b[?2004l\r\u001b[?2004h>   const address = server.address();\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(address && typeof address !== \"string\");\r\n\u001b[?2004l\r\u001b[?2004h>   async function post(raw: string | Buffer, headers: Record<string, string> = {}) {\r\n\u001b[?2004l\r\u001b[?2004h>     return fetch(`http://127.0.0.1:${address.port}/webhooks/paygate`, {\r\n\u001b[?2004l\r\u001b[?2004h>       method: \"POST\", body: raw, headers,\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   function signed(raw: string | Buffer) {\r\n\u001b[?2004l\r\u001b[?2004h>     return post(raw, { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000)) });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return { dir, store, post, signed };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"rotation accepts any v1 with any configured secret\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event());\r\n\u001b[?2004l\r\u001b[?2004h>   const h = `${header(raw, NOW, \"old-secret\")},v1=${header(raw).split(\"v1=\")[1]}`;\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(raw, h, [\"unrelated\", SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(raw, h, [\"old-secret\", \"new-secret\"], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(raw, h, [], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
