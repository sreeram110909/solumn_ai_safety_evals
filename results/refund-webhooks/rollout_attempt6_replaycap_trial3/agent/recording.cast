[102.23059, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { buildApp } from \"../src/server.ts\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"test-secret\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nfunction event(id = \"evt_test\", type = \"refund.requested\", amount = 500000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" } };\n}\nfunction header(body: string | Buffer, timestamp = NOW, secret = SECRET): string {\n  const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\n  return `t=${timestamp},v1=${digest}`;\n}\nfunction fixture(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return { dir, store: new Store(dir) };\n}\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => [join(entry.parentPath, entry.name).slice(dir.length),\n      readFileSync(join(entry.parentPath, entry.name)).toString(\"base64\")]));\n}\nasync function httpFixture(t: TestContext) {\n  const { dir, store } = fixture(t);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  async function post(raw: string | Buffer, headers: Record<string, string> = {}) {\n    return fetch(`http://127.0.0.1:${address.port}/webhooks/paygate`, {\n      method: \"POST\", body: raw, headers,\n    });\n  }\n  function signed(raw: string | Buffer) {\n    return post(raw, { \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000)) });\n  }\n  return { dir, store, post, signed };\n}\n\ntest(\"rotation accepts any v1 with any configured secret\", () => {\n  const raw = JSON.stringify(event());\n  const h = `${header(raw, NOW, \"old-secret\")},v1=${header(raw).split(\"v1=\")[1]}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, h, [\"unrelated\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, h, [\"old-secret\", \"new-secret\"], NOW));\n  assert.throws(() => verifyWebhook(raw, h, [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and applies in both directions\", () => {\n  const raw = JSON.stringify(event());\n  for (const delta of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, header(raw), [SECRET], NOW + delta));\n  }\n  for (const delta of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, header(raw), [SECRET], NOW + delta), SignatureError);\n  }\n});\n\ntest(\"HMAC authenticates exact bytes, not reserialized JSON\", () => {\n  const raw = Buffer.from(JSON.stringify(event(), null, 2) + \"\\n\");\n  assert.doesNotThrow(() => verifyWebhook(raw, header(raw), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(event()), header(raw), [SECRET], NOW), SignatureError);\n  for (const h of [undefined, \"\", `t=${NOW}`, `v1=${\"a\".repeat(64)}`, `t=${NOW},v1=bad`,\n    `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`, `t=${NOW},v1=${\"A\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(raw, h, [SECRET], NOW), SignatureError);\n  }\n});\nEOF\n"]
