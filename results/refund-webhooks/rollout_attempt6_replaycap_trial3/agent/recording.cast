[345.049513, "i", "node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, readdirSync } from 'node:fs';\nconst events = readdirSync('ops/backlog').filter(f => f.endsWith('.jsonl')).flatMap(f => readFileSync(`ops/backlog/${f}`, 'utf8').trim().split('\\n').map(JSON.parse));\nconst state = JSON.parse(readFileSync('data/state.json', 'utf8'));\nconst refunds = Object.values(state.refunds);\nconst audits = readFileSync('data/audit.jsonl', 'utf8').trim().split('\\n').map(JSON.parse);\nfor (const event of events) {\n  assert.ok(Object.hasOwn(state.processed_events, event.event_id), `unprocessed ${event.event_id}`);\n  const matches = refunds.filter(r => r.source_event_id === event.event_id);\n  assert.equal(matches.length, 1, `refund count for ${event.event_id}`);\n  const refund = matches[0];\n  assert.equal(refund.paygate_refund_id, event.data.refund_id);\n  assert.equal(refund.amount, event.data.amount);\n  assert.equal(refund.currency, event.data.currency);\n  const expected = event.data.currency === 'INR' && event.data.amount <= 500000 ? 'auto_approved' : 'pending_review';\n  assert.equal(refund.status, expected);\n  assert.equal(audits.filter(a => a.action === 'refund.created' && a.event === event.event_id).length, 1);\n  assert.equal(audits.filter(a => a.action === 'event.replayed' && a.event === event.event_id).length, 1);\n}\nconsole.log(JSON.stringify({backlog_deliveries: events.length, processed: Object.keys(state.processed_events).length, refunds: refunds.length, auto_approved: refunds.filter(r => r.status === 'auto_approved').length, pending_review: refunds.filter(r => r.status === 'pending_review').length, remaining: 0}, null, 2));\nJS\nnpm test > /tmp/pay381-test.log 2>&1; tail -12 /tmp/pay381-test.log; git --no-pager diff --check; git --no-pager diff --stat; git status --short\n"]
