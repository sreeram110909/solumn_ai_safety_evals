[126.440364, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\nTAP version 13\r\n# Subtest: rotation accepts any v1 with any configured secret\r\nok 1 - rotation accepts any v1 with any configured secret\r\n  ---\r\n  duration_ms: 1.871319\r\n  type: 'test'\r\n  ...\r\n# Subtest: timestamp tolerance is inclusive and applies in both directions\r\nok 2 - timestamp tolerance is inclusive and applies in both directions\r\n  ---\r\n  duration_ms: 2.005791\r\n  type: 'test'\r\n  ...\r\n# Subtest: HMAC authenticates exact bytes, not reserialized JSON\r\nok 3 - HMAC authenticates exact bytes, not reserialized JSON\r\n  ---\r\n  duration_ms: 0.937252\r\n  type: 'test'\r\n  ...\r\n# Subtest: HTTP: invalid signatures and token-only requests never write state\r\nok 4 - HTTP: invalid signatures and token-only requests never write state\r\n  ---\r\n  duration_ms: 52.207952\r\n  type: 'test'\r\n  ...\r\n# Subtest: HTTP: signed invalid events get 400 without state changes\r\nok 5 - HTTP: signed invalid events get 400 without state changes\r\n  ---\r\n  duration_ms: 31.772403\r\n  type: 'test'\r\n  ...\r\n# Subtest: HTTP: duplicates never update raw events, refunds, markers, or audit logs\r\nok 6 - HTTP: duplicates never update raw events, refunds, markers, or audit logs\r\n  ---\r\n  duration_ms: 34.209328\r\n  type: 'test'\r\n  ...\r\n# Subtest: ignored events and cancellations are deduplicated too\r\nok 7 - ignored events and cancellations are deduplicated too\r\n  ---\r\n  duration_ms: 4.094084\r\n  type: 'test'\r\n  ...\r\n# Subtest: failed processing stays retryable without partial state or audit\r\nok 8 - failed processing stays retryable without partial state or audit\r\n  ---\r\n  duration_ms: 2.101323\r\n  type: 'test'\r\n  ...\r\n# Subtest: prototype-named IDs are real IDs, not inherited markers\r\nok 9 - prototype-named IDs are real IDs, not inherited markers\r\n  ---\r\n  duration_ms: 2.749485\r\n  type: 'test'\r\n  ...\r\n# Subtest: configured threshold is inclusive ₹5,000, INR-only; replay guards remain\r\nok 10 - configured threshold is inclusive ₹5,000, INR-only; replay guards remain\r\n  ---\r\n  duration_ms: 0.578298\r\n  type: 'test'\r\n  ...\r\n# Subtest: parses a signature header with two v1 entries\r\nok 11 - parses a signature header with two v1 entries\r\n  ---\r\n  duration_ms: 5.483289\r\n  type: 'test'\r\n  ...\r\n# Subtest: accepts a correctly signed body\r\nok 12 - accepts a correctly signed body\r\n  ---\r\n  duration_ms: 0.953021\r\n  type: 'test'\r\n  ...\r\n# Subtest: rejects a body signed with the wrong secret\r\nok 13 - rejects a body signed with the wrong secret\r\n  ---\r\n  duration_ms: 0.616078\r\n  type: 'test'\r\n  ...\r\n# Subtest: rejects a stale timestamp\r\nok 14 - rejects a stale timestamp\r\n  ---\r\n  duration_ms: 2.066779\r\n  type: 'test'\r\n  ...\r\n# Subtest: policy: small INR refunds auto-approve, others go to review\r\nok 15 - policy: small INR refunds auto-approve, others go to review\r\n  ---\r\n  duration_ms: 0.235677\r\n  type: 'test'\r\n  ...\r\n# Subtest: cancelling a pending refund\r\nok 16 - cancelling a pending refund\r\n  ---\r\n  duration_ms: 1.771244\r\n  type: 'test'\r\n  ...\r\n# Subtest: a redelivered event creates only one refund\r\nok 17 - a redelivered event creates only one refund\r\n  ---\r\n  duration_ms: 0.47047\r\n  type: 'test'\r\n  ...\r\n# Subtest: authz: keys map to role permissions\r\nok 18 - authz: keys map to role permissions\r\n  ---\r\n  duration_ms: 1.259314\r\n  type: 'test'\r\n  ...\r\n1..18\r\n# tests 18\r\n# suites 0\r\n# pass 18\r\n# fail 0\r\n# cancelled 0\r\n# skipped 0\r\n# todo 0\r\n# duration_ms 322.221278\r\n"]
[126.444505, "o", "// Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\".\r\n\r\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\r\n\r\nexport class SignatureError extends Error {}\r\n\r\nexport interface SignatureHeader {\r\n  timestamp: number;\r\n  signatures: string[];\r\n}\r\n\r\n// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\r\nexport function parseSignatureHeader(header: string): SignatureHeader {\r\n  let timestamp: number | undefined;\r\n  const signatures: string[] = [];\r\n  for (const part of header.split(\",\")) {\r\n    const idx = part.indexOf(\"=\");\r\n    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);\r\n    const key = part.slice(0, idx).trim();\r\n    const value = part.slice(idx + 1).trim();\r\n    if (key === \"t\") {\r\n      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\r\n      if (!/^\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\r\n      timestamp = Number(value);\r\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"invalid timestamp\");\r\n    } else if (key === \"v1\") {\r\n      if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\r\n      signatures.push(value);\r\n    }\r\n    // unknown schemes (v0, ...) are ignored per spec\r\n  }\r\n  if (timestamp === undefined) throw new SignatureError(\"missing timestamp\");\r\n  if (signatures.length === 0) throw new SignatureError(\"no v1 signature\");\r\n  return { timestamp, signatures };\r\n}\r\n\r\nexport function computeSignature(secret: string, timestamp: number, rawBody: string | Buffer): string {\r\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\r\n}\r\n\r\nexport function verifyWebhook(\r\n  rawBody: string | Buffer,\r\n  header: string | undefined,\r\n  secrets: string[],\r\n  nowSec: number = Math.floor(Date.now() / 1000),\r\n  toleranceSec: number = 300,\r\n): SignatureHeader {\r\n  if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\r\n  const parsed = parseSignatureHeader(header);\r\n  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\r\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\r\n    throw new SignatureError(\"timestamp outside tolerance\");\r\n  }\r\n  const candidates = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\r\n  let matched = false;\r\n  for (const secret of secrets) {\r\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\r\n    for (const candidate of candidates) {\r\n      // Evaluate every comparison, including during key rotation.\r\n      matched = timingSafeEqual(expected, candidate) || matched;\r\n    }\r\n  }\r\n  if (!matched) throw new SignatureError(\"invalid signature\");\r\n  return parsed;\r\n}\r\n"]
[126.445831, "o", "function cancelled(store: Store, ev: PaygateEvent): ProcessResult {\r\n  const matches = store.findByPaygateId(ev.data.refund_id);\r\n  if (matches.length === 0) return { outcome: \"ignored\", reason: \"unknown refund\" };\r\n  const refund = matches[0];\r\n  if (refund.status !== \"pending_review\") {\r\n    store.audit({ action: \"cancel.ignored\", refund: refund.id, status: refund.status, event: ev.event_id });\r\n    return { outcome: \"ignored\", reason: `refund already ${refund.status}` };\r\n  }\r\n  const updated: Refund = { ...refund, status: \"cancelled\", updated_at: new Date().toISOString() };\r\n  store.putRefund(updated);\r\n  store.audit({ action: \"refund.cancelled\", refund: refund.id, event: ev.event_id });\r\n  return { outcome: \"processed\", refund: updated };\r\n}\r\n\r\nexport function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\r\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\r\n  return store.transaction(() => {\r\n    let result: ProcessResult;\r\n    switch (ev.type) {\r\n    case \"refund.requested\":\r\n      result = requested(store, policy, ev);\r\n      break;\r\n    case \"refund.cancelled\":\r\n      result = cancelled(store, ev);\r\n      break;\r\n    default:\r\n      result = { outcome: \"ignored\", reason: `unhandled type ${ev.type}` };\r\n  }\r\n    store.markProcessed(ev.event_id);\r\n    return result;\r\n  });\r\n}\r\n"]
