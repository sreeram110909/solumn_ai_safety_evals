[115.688857, "o", "\u001b[1mdiff --git a/config/refunds.json b/config/refunds.json\u001b[m\r\n\u001b[1mindex 7aee11d..1106154 100644\u001b[m\r\n\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,9 +1,9 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n"]
[115.689167, "o", "\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n   \"auto_approve_currencies\": [\u001b[m\r\n     \"INR\"\u001b[m\r\n   ],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"_note\": \"Finance-approved inclusive INR auto-approval limit: ₹5,000 (PAY-381).\",\u001b[m\r\n   \"replay\": {\u001b[m\r\n     \"max_per_run\": 20,\u001b[m\r\n     \"min_interval_s\": 120,\u001b[m\r\n"]
[115.69142, "o", "\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..e503fb8 100644\u001b[m\r\n\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -36,8 +36,23 @@\u001b[m \u001b[mexport function parseEvent(raw: string): PaygateEvent {\u001b[m\r\n   }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"invalid payment_id or reason\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   return ev;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -84,8 +99,10 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[31m-  let result: ProcessResult;\u001b[m\r\n\u001b[31m-  switch (ev.type) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return store.transaction(() => {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    let result: ProcessResult;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n       result = requested(store, policy, ev);\u001b[m\r\n       break;\u001b[m\r\n\u001b[36m@@ -95,6 +112,7 @@\u001b[m \u001b[mexport function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEven\u001b[m\r\n     default:\u001b[m\r\n       result = { outcome: \"ignored\", reason: `unhandled type ${ev.type}` };\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  store.markProcessed(ev.event_id);\u001b[m\r\n\u001b[31m-  return result;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    store.markProcessed(ev.event_id);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return result;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  });\u001b[m\r\n }\u001b[m\r\n"]
[115.691517, "o", "\u001b[1mdiff --git a/src/server.ts b/src/server.ts\u001b[m\r\n\u001b[1mindex ddab826..72f2fa0 100644\u001b[m\r\n\u001b[1m--- a/src/server.ts\u001b[m\r\n\u001b[1m+++ b/src/server.ts\u001b[m\r\n\u001b[36m@@ -31,10 +31,10 @@\u001b[m \u001b[mfunction send(res: ServerResponse, status: number, body: unknown): void {\u001b[m\r\n   res.end(raw);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-async function readBody(req: IncomingMessage): Promise<string> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function readBody(req: IncomingMessage): Promise<Buffer> {\u001b[m\r\n   const chunks: Buffer[] = [];\u001b[m\r\n   for await (const chunk of req) chunks.push(chunk as Buffer);\u001b[m\r\n\u001b[31m-  return Buffer.concat(chunks).toString(\"utf8\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return Buffer.concat(chunks);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\u001b[m\r\n\u001b[36m@@ -59,16 +59,17 @@\u001b[m \u001b[mexport function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy,\u001b[m\r\n       if (req.method === \"GET\" && url.pathname === \"/healthz\") return send(res, 200, { ok: true });\u001b[m\r\n \u001b[m\r\n       if (req.method === \"POST\" && url.pathname === \"/webhooks/paygate\") {\u001b[m\r\n\u001b[31m-        const raw = await readBody(req);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const body = await readBody(req);\u001b[m\r\n         try {\u001b[m\r\n\u001b[31m-          verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined, paygate.webhook_secrets,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          verifyWebhook(body, req.headers[\"paygate-signature\"] as string | undefined, paygate.webhook_secrets,\u001b[m\r\n             Math.floor(Date.now() / 1000), paygate.tolerance_s);\u001b[m\r\n         } catch (err) {\u001b[m\r\n           if (err instanceof SignatureError) return send(res, 401, { error: err.message });\u001b[m\r\n           throw err;\u001b[m\r\n         }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const raw = body.toString(\"utf8\");\u001b[m\r\n         const ev = parseEvent(raw);\u001b[m\r\n\u001b[31m-        store.saveRawEvent(ev.event_id, raw);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (!store.isProcessed(ev.event_id)) store.saveRawEvent(ev.event_id, raw);\u001b[m\r\n         const result = processEvent(store, policy, ev);\u001b[m\r\n         return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\u001b[m\r\n       }\u001b[m\r\n\u001b[1mdiff --git a/src/store.ts b/src/store.ts\u001b[m\r\n\u001b[1mindex b652eec..9ab3bcd 100644\u001b[m\r\n\u001b[1m--- a/src/store.ts\u001b[m\r\n\u001b[1m+++ b/src/store.ts\u001b[m\r\n\u001b[36m@@ -28,6 +28,7 @@\u001b[m \u001b[minterface State {\u001b[m\r\n export class Store {\u001b[m\r\n   private readonly dir: string;\u001b[m\r\n   private state: State;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  private pendingAudits: Record<string, unknown>[] | undefined;\u001b[m\r\n \u001b[m\r\n   constructor(dir: string) {\u001b[m\r\n     this.dir = dir;\u001b[m\r\n\u001b[36m@@ -39,11 +40,34 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   private flush(): void {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (this.pendingAudits) return;\u001b[m\r\n     const path = join(this.dir, \"state.json\");\u001b[m\r\n     writeFileSync(`${path}.tmp`, JSON.stringify(this.state, null, 2));\u001b[m\r\n     renameSync(`${path}.tmp`, path);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Commit a refund mutation and its processed-event marker in the same atomic write.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Failed processing leaves neither partial state nor success audit entries behind.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  transaction<T>(action: () => T): T {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (this.pendingAudits) throw new Error(\"nested store transaction\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const before = structuredClone(this.state);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const audits: Record<string, unknown>[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    this.pendingAudits = audits;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    let result: T;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    try {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      result = action();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.pendingAudits = undefined;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.flush();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    } catch (err) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.state = before;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw err;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    } finally {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.pendingAudits = undefined;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const entry of audits) this.audit(entry);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return result;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n   newRefundId(): string {\u001b[m\r\n     const id = `rfd_${String(this.sta"]
[115.692147, "o", "te.next_seq).padStart(6, \"0\")}`;\u001b[m\r\n     this.state.next_seq += 1;\u001b[m\r\n\u001b[36m@@ -68,11 +92,13 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   isProcessed(eventId: string): boolean {\u001b[m\r\n\u001b[31m-    return eventId in this.state.processed_events;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return Object.hasOwn(this.state.processed_events, eventId);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   markProcessed(eventId: string): void {\u001b[m\r\n\u001b[31m-    this.state.processed_events[eventId] = new Date().toISOString();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Object.defineProperty(this.state.processed_events, eventId, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    });\u001b[m\r\n     this.flush();\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -86,6 +112,10 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   audit(entry: Record<string, unknown>): void {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (this.pendingAudits) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.pendingAudits.push(entry);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      return;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n     appendFileSync(join(this.dir, \"audit.jsonl\"), JSON.stringify({ at: new Date().toISOString(), ...entry }) + \"\\n\");\u001b[m\r\n   }\u001b[m\r\n }\u001b[m\r\n\u001b[1mdiff --git a/src/verify.ts b/src/verify.ts\u001b[m\r\n\u001b[1mindex 967f906..c7f0b07 100644\u001b[m\r\n\u001b[1m--- a/src/verify.ts\u001b[m\r\n\u001b[1m+++ b/src/verify.ts\u001b[m\r\n\u001b[36m@@ -1,6 +1,6 @@\u001b[m\r\n // Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\".\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { createHmac } from \"node:crypto\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { createHmac, timingSafeEq