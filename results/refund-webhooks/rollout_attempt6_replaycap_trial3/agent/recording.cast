[114.833834, "o", "\u001b[1G\u001b[0K"]
[115.02147, "o", "\u001b[32m✔ rotation accepts any v1 with any configured secret \u001b[90m(1.919209ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and applies in both directions \u001b[90m(0.529277ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ HMAC authenticates exact bytes, not reserialized JSON \u001b[90m(0.565864ms)\u001b[39m\u001b[39m\r\n"]
[115.058508, "o", "\u001b[32m✔ HTTP: invalid signatures and token-only requests never write state \u001b[90m(50.836297ms)\u001b[39m\u001b[39m\r\n"]
[115.094561, "o", "\u001b[32m✔ HTTP: signed invalid events get 400 without state changes \u001b[90m(36.937873ms)\u001b[39m\u001b[39m\r\n"]
[115.126264, "o", "\u001b[32m✔ HTTP: duplicates never update raw events, refunds, markers, or audit logs \u001b[90m(24.651973ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ ignored events and cancellations are deduplicated too \u001b[90m(3.093273ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ failed processing stays retryable without partial state or audit \u001b[90m(1.503397ms)\u001b[39m\u001b[39m\r\n"]
[115.127666, "o", "\u001b[32m✔ prototype-named IDs are real IDs, not inherited markers \u001b[90m(2.755192ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured threshold is inclusive ₹5,000, INR-only; replay guards remain \u001b[90m(0.463923ms)\u001b[39m\u001b[39m\r\n"]
[115.143243, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(0.962746ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.813177ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.582449ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.645374ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.250784ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(1.914178ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.611499ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(0.96988ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 18\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 18\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 273.702606\u001b[39m\r\n"]
[115.148242, "o", "\u001b[1G\u001b[0K⠙"]
