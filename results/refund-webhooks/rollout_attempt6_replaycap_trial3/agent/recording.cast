[114.703852, "o", ">   assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");"]
[114.703974, "o", "\r\n\u001b[?2004l\r"]
[114.704109, "o", "\u001b[?2004h>   assert.equal(policy.replay.max_per_run, 20);"]
