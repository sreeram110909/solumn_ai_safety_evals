test("processed IDs are own keys, including names inherited from Object", (t) => {
  const dir = directory(t);
  let store = new Store(dir);
  for (const id of ["toString", "constructor", "__proto__"]) {
    assert.equal(processEvent(store, POLICY, parseEvent(JSON.stringify(event(id)))).outcome, "processed");
    store = new Store(dir);
    assert.equal(processEvent(store, POLICY, event(id)).outcome, "duplicate");
  }
  assert.equal(store.listRefunds().length, 3);
});
