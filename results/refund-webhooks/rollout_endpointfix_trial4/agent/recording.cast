[122.47872, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('test/pay381.test.ts')\ns = p.read_text().replace('import { sha256Hex }', 'import { sha256Hex, type RolesConfig }')\ns = s.replace('  const roles = {', '  const roles: RolesConfig = {').replace('] as const', ']')\np.write_text(s)\nPY\ncat >> test/pay381.test.ts <<'EOF'\n\ntest(\"failed events stay retryable and ops replays retain bearer authorization\", async (t) => {\n  const { base, store, dir } = await app(t);\n  const invalid = event(\"failed\");\n  invalid.data.amount = -1;\n  assert.throws(() => processEvent(store, POLICY, invalid));\n  assert.equal(store.isProcessed(\"failed\"), false);\n  assert.equal(store.listRefunds().length, 0);\n\n  store.saveRawEvent(\"failed\", JSON.stringify(event(\"failed\")));\n  async function replay(token?: string) {\n    const response = await fetch(`${base}/admin/replay/failed`, {\n      method: \"POST\", headers: token ? { Authorization: `Bearer ${token}` } : {},\n    });\n    await response.json();\n    return response.status;\n  }\n  assert.equal(await replay(), 401);\n  assert.equal(await replay(\"viewer-key\"), 403);\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal(await replay(\"ops-key\"), 200);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.isProcessed(\"failed\"), true);\n  const before = snapshot(dir);\n  assert.equal(await replay(\"ops-key\"), 409);\n  assert.deepEqual(snapshot(dir), before);\n});\nEOF\nnpm test\n"]
[122.479268, "o", "python3 - <<'PY'\r\n"]
[122.479712, "o", "\u001b[?2004l\r"]
[122.480018, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('test/pay381.test.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('import { sha256Hex }', 'import { sha256Hex, type RolesConfig }')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[122.481169, "o", "s = s.replace('  const roles = {', '  const roles: RolesConfig = {').replace('] as const', ']')\r\n\u001b[?2004l\r\u001b[?2004h"]
[122.481426, "o", "> p.write_text(s)"]
[122.481902, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[122.520711, "o", "\u001b[?2004hroot@a07ea8ef16d5:/app# cat >> test/pay381.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"failed events stay retryable and ops replays retain bearer authorization\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { base, store, dir } = await app(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const invalid = event(\"failed\");\r\n\u001b[?2004l\r\u001b[?2004h>   invalid.data.amount = -1;\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => processEvent(store, POLICY, invalid));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.isProcessed(\"failed\"), false);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   store.saveRawEvent(\"failed\", JSON.stringify(event(\"failed\")));\r\n\u001b[?2004l\r\u001b[?2004h>   async function replay(token?: string) {\r\n\u001b[?2004l\r\u001b[?2004h>     const response = await fetch(`${base}/admin/replay/failed`, {\r\n\u001b[?2004l\r\u001b[?2004h>       method: \"POST\", headers: token ? { Authorization: `Bearer ${token}` } : {},\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>     await response.json();\r\n\u001b[?2004l\r\u001b[?2004h>     return response.status;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(await replay(), 401);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(await replay(\"viewer-key\"), 403);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(await replay(\"ops-key\"), 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.isProcessed(\"failed\"), true);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(await replay(\"ops-key\"), 409);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[122.523229, "o", "\u001b[?2004hroot@a07ea8ef16d5:/app# npm test\r\n\u001b[?2004l\r"]
[122.632639, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[122.633238, "o", "\u001b[1G\u001b[0K"]
[122.860359, "o", "\u001b[32m✔ rotation accepts any signature against any active secret \u001b[90m(3.115736ms)\u001b[39m\u001b[39m\r\n"]
[122.86072, "o", "\u001b[32m✔ timestamp tolerance is inclusive in both directions \u001b[90m(0.657594ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects malformed signatures without throwing non-signature errors \u001b[90m(0.821021ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover exact bytes, including whitespace and non-UTF8 bytes \u001b[90m(0.539591ms)\u001b[39m\u001b[39m\r\n"]
[122.861318, "o", "\u001b[32m✔ production policy approves through INR 5000 only \u001b[90m(1.098318ms)\u001b[39m\u001b[39m\r\n"]
[122.92086, "o", "\u001b[32m✔ HTTP: invalid signatures cannot change state, even on duplicates or with replay tokens \u001b[90m(73.309666ms)\u001b[39m\u001b[39m\r\n"]
[122.985752, "o", "\u001b[32m✔ HTTP: signed invalid events get 400 and unknown event types get 200 \u001b[90m(65.783378ms)\u001b[39m\u001b[39m\r\n"]
[123.029582, "o", "\u001b[32m✔ HTTP: duplicates preserve raw events, refunds and audits across restart \u001b[90m(27.856455ms)\u001b[39m\u001b[39m\r\n"]
[123.029989, "o", "\u001b[32m✔ cancellation retries neither update nor audit again \u001b[90m(8.258367ms)\u001b[39m\u001b[39m\r\n"]
[123.030086, "o", "\u001b[32m✔ processed IDs are own keys, including names inherited from Object \u001b[90m(10.808855ms)\u001b[39m\u001b[39m\r\n"]
[123.040429, "o", "\u001b[32m✔ failed events stay retryable and ops replays retain bearer authorization \u001b[90m(13.587132ms)\u001b[39m\u001b[39m\r\n"]
[123.054626, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.138716ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.961119ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.707688ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.862994ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.302225ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.873251ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.162567ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.471344ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 383.269123\u001b[39m\r\n"]
[123.058369, "o", "\u001b[1G\u001b[0K⠙"]
