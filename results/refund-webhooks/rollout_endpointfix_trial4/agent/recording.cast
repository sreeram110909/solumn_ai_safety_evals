[90.590733, "o", "test(\"cancellation retries neither update nor audit again\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const amount of [100_000, 900_000]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.590867, "o", "    const dir = directory(t);\r\n\u001b[?2004l\r\u001b[?2004h>     const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
