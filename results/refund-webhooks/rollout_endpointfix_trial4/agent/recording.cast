999999999,v1=${\"a\".repeat(64)}`]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"signatures cover exact bytes, including whitespace and non-UTF8 bytes\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = '{ \"message\": \"₹\", \"n\": 1 }\\n';\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(raw, signed(raw, NOW), [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), signed(raw, NOW), [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   const bytes = Buffer.from([0x7b, 0xff, 0x7d]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(bytes, signed(bytes, NOW), [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.585007, "o", "  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signed(bytes, NOW), [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[90.585258, "o", "test(\"production policy approves through INR 5000 only\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
