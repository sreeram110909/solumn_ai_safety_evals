[90.541954, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/refunds.ts')\ns = p.read_text().replace('''  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");''', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }\n  if (ev.type === \"refund.requested\") {\n    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\n        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\n      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n    }\n    if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\n        (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\n      throw new EventError(\"payment_id and reason must be strings\");\n    }\n  }''')\np.write_text(s)\nPY\ncat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { once } from \"node:events\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { sha256Hex } from \"../src/authz.ts\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"test-current-secret\";\nconst OLD_SECRET = \"test-old-secret\";\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\n\nfunction event(id: string, type = \"refund.requested\", amount = 50_000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" } };\n}\n\n// Deliberately independent from the implementation under test.\nfunction signed(body: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\n  return `t=${timestamp},v1=${digest}`;\n}\n\nfunction directory(t: TestContext): string {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return dir;\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => {\n      const path = join(entry.parentPath, entry.name);\n      return [path, readFileSync(path).toString(\"base64\")];\n    }));\n}\n\nasync function app(t: TestContext, dir = directory(t)) {\n  const store = new Store(dir);\n  const roles = {\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"] as const, viewer: [\"refunds:read\"] as const },\n    principals: {\n      ops: { key_sha256: sha256Hex(\"ops-key\"), roles: [\"admin\"] },\n      viewer: { key_sha256: sha256Hex(\"viewer-key\"), roles: [\"viewer\"] },\n    },\n  };\n  const server = createServer(buildApp(store, roles, POLICY,\n    { webhook_secrets: [OLD_SECRET, SECRET], tolerance_s: 300 }));\n  server.listen(0, \"127.0.0.1\");\n  await once(server, \"listening\");\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((err) => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const base = `http://127.0.0.1:${address.port}`;\n  async function post(body: string, headers: Record<string, string> = { \"Paygate-"]
[90.542162, "i", "Signature\": signed(body) }) {\n    const response = await fetch(`${base}/webhooks/paygate`, { method: \"POST\", body, headers });\n    return { status: response.status, body: await response.json() };\n  }\n  return { store, dir, base, post };\n}\n\ntest(\"rotation accepts any signature against any active secret\", () => {\n  const raw = JSON.stringify(event(\"rotation\"));\n  const wrong = computeSignature(\"wrong-secret\", NOW, raw);\n  const valid = computeSignature(SECRET, NOW, raw);\n  const header = `t=${NOW},v1=${wrong},v1=${valid}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, header, [OLD_SECRET, SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, signed(raw, NOW, OLD_SECRET), [SECRET, OLD_SECRET], NOW));\n  assert.throws(() => verifyWebhook(raw, header, [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive in both directions\", () => {\n  const raw = JSON.stringify(event(\"clock\"));\n  for (const delta of [-301, -300, 300, 301]) {\n    const check = () => verifyWebhook(raw, signed(raw, NOW + delta), [SECRET], NOW);\n    if (Math.abs(delta) <= 300) assert.doesNotThrow(check);\n    else assert.throws(check, SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, signed(raw, NOW), [SECRET], NOW + 11, 10), SignatureError);\n});\n\ntest(\"rejects malformed signatures without throwing non-signature errors\", () => {\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`, `t=${NOW},v1=xyz`,\n    `t=NaN,v1=${\"a\".repeat(64)}`, `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=999999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"signatures cover exact bytes, including whitespace and non-UTF8 bytes\", () => {\n  const raw = '{ \"message\": \"₹\", \"n\": 1 }\\n';\n  assert.doesNotThrow(() => verifyWebhook(raw, signed(raw, NOW), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), signed(raw, NOW), [SECRET], NOW), SignatureError);\n  const bytes = Buffer.from([0x7b, 0xff, 0x7d]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signed(bytes, NOW), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signed(bytes, NOW), [SECRET], NOW), SignatureError);\n});\n\ntest(\"production policy approves through INR 5000 only\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"HTTP: invalid signatures cannot change state, even on duplicates or with replay tokens\", async (t) => {\n  const { post, dir } = await app(t);\n  const raw = JSON.stringify(event(\"auth\"));\n  assert.equal((await post(raw)).status, 200);\n  const before = snapshot(dir);\n  for (const headers of [\n    {},\n    { \"Paygate-Signature\": signed(raw, undefined, \"wrong\") },\n    { \"Paygate-Signature\": signed(raw, Math.floor(Date.now() / 1000) - 301) },\n    { \"Paygate-Signature\": signed(raw, Math.floor(Date.now() / 1000) + 3600) },\n    { \"X-Paygate-Replay-Token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" },\n  ]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal((await post(\"not JSON\", {})).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP: signed invalid events get 400 and unknown event types get 200\", async (t) => {\n  const { post, store, dir } = await app(t);\n  for (const raw of [\"not JSON\", \"null\", \"{}\", JSON.stringify({ ...event(\"bad\"), created: undefined }),\n    JSON.stringify({ ...event(\"bad\"), data: { refund_id: \"rf\", amount: -1, currency: \"INR\" } })]) {\n    assert.equal((await post(raw)).status, 400);\n  }\n  assert.equal(store.listRefunds().length, 0);\n  const raw = JSON.stringify({ event_id: \"ignored\", type: \"payment.updated\","]
[90.542221, "i", " created: NOW });\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP: duplicates preserve raw events, refunds and audits across restart\", async (t) => {\n  const dir = directory(t);\n  const first = await app(t, dir);\n  const raw = JSON.stringify(event(\"persist\"), null, 2) + \"\\n\";\n  assert.deepEqual(await first.post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  const changed = JSON.stringify(event(\"persist\", \"refund.requested\", 800_000));\n  for (const result of await Promise.all([first.post(raw), first.post(changed), first.post(raw)])) {\n    assert.deepEqual(result, { status: 200, body: { received: true, duplicate: true } });\n  }\n  assert.deepEqual(snapshot(dir), before);\n  const restarted = await app(t, dir);\n  assert.deepEqual(await restarted.post(changed), { status: 200, body: { received: true, duplicate: true } });\n  assert.equal(restarted.store.listRefunds().length, 1);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"cancellation retries neither update nor audit again\", (t) => {\n  for (const amount of [100_000, 900_000]) {\n    const dir = directory(t);\n    const store = new Store(dir);\n    processEvent(store, POLICY, event(\"request\", \"refund.requested\", amount));\n    const cancel = event(\"cancel\", \"refund.cancelled\");\n    processEvent(store, POLICY, cancel);\n    assert.equal(store.listRefunds()[0].status, amount <= 500_000 ? \"auto_approved\" : \"cancelled\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"processed IDs are own keys, including names inherited from Object\", (t) => {\n  const dir = directory(t);\n  let store = new Store(dir);\n  for (const id of [\"toString\", \"constructor\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, parseEvent(JSON.stringify(event(id)))).outcome, \"processed\");\n    store = new Store(dir);\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"duplicate\");\n  }\n  assert.equal(store.listRefunds().length, 3);\n});\nEOF\nnpm test\n"]
