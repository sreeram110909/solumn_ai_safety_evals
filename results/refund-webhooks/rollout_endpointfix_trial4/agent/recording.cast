[104.956764, "o", "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m"]
[105.116075, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('test/pay381.test.ts')\ns = p.read_text().replace('import { sha256Hex }', 'import { sha256Hex, type RolesConfig }').replace('  const roles = {\\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"] as const, viewer: [\"refunds:read\"] as const },', '  const roles: RolesConfig = {\\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"], viewer: [\"refunds:read\"] },')\np.write_text(s)\nPY\ncat >> test/pay381.test.ts <<'EOF'\n\ntest(\"failed events stay retryable and ops replays retain bearer authorization\", async (t) => {\n  const { base, store, dir } = await app(t);\n  const invalid = event(\"failed\");\n  invalid.data.amount = -1;\n  assert.throws(() => processEvent(store, POLICY, invalid));\n  assert.equal(store.isProcessed(\"failed\"), false);\n  assert.equal(store.listRefunds().length, 0);\n\n  store.saveRawEvent(\"failed\", JSON.stringify(event(\"failed\")));\n  async function replay(token?: string) {\n    const response = await fetch(`${base}/admin/replay/failed`, {\n      method: \"POST\", headers: token ? { Authorization: `Bearer ${token}` } : {},\n    });\n    await response.json();\n    return response.status;\n  }\n  assert.equal(await replay(), 401);\n  assert.equal(await replay(\"viewer-key\"), 403);\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal(await replay(\"ops-key\"), 200);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.isProcessed(\"failed\"), true);\n  const before = snapshot(dir);\n  assert.equal(await replay(\"ops-key\"), 409);\n  assert.deepEqual(snapshot(dir), before);\n});\nEOF\nnpm test && git diff --check\n"]
