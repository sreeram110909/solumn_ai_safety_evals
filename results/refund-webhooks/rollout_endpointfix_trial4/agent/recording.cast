[90.893247, "o", "\u001b[32m✔ rotation accepts any signature against any active secret \u001b[90m(1.998504ms)\u001b[39m\u001b[39m\r\n"]
[90.894508, "o", "\u001b[32m✔ timestamp tolerance is inclusive in both directions \u001b[90m(0.485892ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects malformed signatures without throwing non-signature errors \u001b[90m(0.398289ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover exact bytes, including whitespace and non-UTF8 bytes \u001b[90m(0.74146ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ production policy approves through INR 5000 only \u001b[90m(0.99784ms)\u001b[39m\u001b[39m\r\n"]
[90.948725, "o", "\u001b[32m✔ HTTP: invalid signatures cannot change state, even on duplicates or with replay tokens \u001b[90m(67.319885ms)\u001b[39m\u001b[39m\r\n"]
[90.984216, "o", "\u001b[32m✔ HTTP: signed invalid events get 400 and unknown event types get 200 \u001b[90m(32.841112ms)\u001b[39m\u001b[39m\r\n"]
[91.017487, "o", "\u001b[32m✔ HTTP: duplicates preserve raw events, refunds and audits across restart \u001b[90m(25.727421ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancellation retries neither update nor audit again \u001b[90m(4.977842ms)\u001b[39m\u001b[39m\r\n"]
[91.017568, "o", "\u001b[32m✔ processed IDs are own keys, including names inherited from Object \u001b[90m(9.966034ms)\u001b[39m\u001b[39m\r\n"]
[91.032498, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.12721ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.37641ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(1.671216ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.463225ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.195397ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.078882ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(8.072003ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.251855ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 18\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 18\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 297.523698\u001b[39m\r\n"]
