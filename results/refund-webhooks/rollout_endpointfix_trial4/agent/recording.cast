ring): SignatureHeader {\u001b[m\r\n   return { timestamp, signatures };\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function computeSignature(secret: string, timestamp: number, rawBody: string): string {\u001b[m\r\n\u001b[31m-  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function computeSignature(secret: string, timestamp: number, rawBody: string | Buffer): string {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function verifyWebhook(\u001b[m\r\n\u001b[31m-  rawBody: string,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n   header: string | undefined,\u001b[m\r\n   secrets: string[],\u001b[m\r\n   nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n\u001b[36m@@ -45,11 +47,20 @@\u001b[m \u001b[mexport function verifyWebhook(\u001b[m\r\n ): SignatureHeader {\u001b[m\r\n   if (!header) throw new S"]
