[80.292769, "i", "cat > src/verify.ts <<'EOF'\n// Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\" and \"Replays\".\n\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\n\nexport class SignatureError extends Error {}\n\nexport interface SignatureHeader {\n  timestamp: number;\n  signatures: string[];\n}\n\ntype RawBody = string | Buffer;\n\nfunction timestampSeconds(value: string): number {\n  if (!/^\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\n    throw new SignatureError(\"timestamp must be integer seconds\");\n  }\n  return Number(value);\n}\n\nfunction signatureParts(header: string): { timestamp?: string; signatures: string[] } {\n  let timestamp: string | undefined;\n  const signatures: string[] = [];\n  for (const part of header.split(\",\")) {\n    const idx = part.indexOf(\"=\");\n    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);\n    const key = part.slice(0, idx).trim();\n    const value = part.slice(idx + 1).trim();\n    if (key === \"t\") {\n      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\n      timestampSeconds(value);\n      timestamp = value;\n    } else if (key === \"v1\") {\n      if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\n      signatures.push(value);\n    }\n    // Unknown signature versions are ignored.\n  }\n  if (signatures.length === 0) throw new SignatureError(\"no v1 signature\");\n  return { timestamp, signatures };\n}\n\n// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\nexport function parseSignatureHeader(header: string): SignatureHeader {\n  const parsed = signatureParts(header);\n  if (parsed.timestamp === undefined) throw new SignatureError(\"missing timestamp\");\n  return { timestamp: timestampSeconds(parsed.timestamp), signatures: parsed.signatures };\n}\n\nexport function computeSignature(secret: string, timestamp: number | string, rawBody: RawBody): string {\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\n}\n\nfunction verifySignatures(\n  rawBody: RawBody,\n  timestamp: string,\n  signatures: string[],\n  secrets: string[],\n  nowSec: number,\n  toleranceSec: number,\n): void {\n  const seconds = timestampSeconds(timestamp);\n  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - seconds) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  const candidates = signatures.map((signature) => Buffer.from(signature, \"hex\"));\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, timestamp, rawBody), \"hex\");\n    for (const candidate of candidates) {\n      // Evaluate every comparison, including during secret rotation.\n      matched = timingSafeEqual(expected, candidate) || matched;\n    }\n  }\n  if (!matched) throw new SignatureError(\"signature mismatch\");\n}\n\nexport function verifyWebhook(\n  rawBody: RawBody,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (typeof header !== \"string\" || !header) throw new SignatureError(\"missing Paygate-Signature header\");\n  const parsed = signatureParts(header);\n  if (parsed.timestamp === undefined) throw new SignatureError(\"missing timestamp\");\n  verifySignatures(rawBody, parsed.timestamp, parsed.signatures, secrets, nowSec, toleranceSec);\n  return { timestamp: Number(parsed.timestamp), signatures: parsed.signatures };\n}\n\nexport function verifyReplay(\n  rawBody: RawBody,\n  timestamp: string | undefined,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (typeof timestamp !== \"string\" || !timestamp) throw new SignatureError(\"missing X-Replay-Timestamp header\");\n  if (typeof header !== \"string\" || !header) throw new SignatureError(\"missing X-Replay-Signature header\");\n  const parsed = signatureParts(header);\n  if (parsed.timestamp !== undefined)"]
[80.292931, "i", " throw new SignatureError(\"unexpected replay signature timestamp\");\n  verifySignatures(rawBody, timestamp, parsed.signatures, secrets, nowSec, toleranceSec);\n  return { timestamp: Number(timestamp), signatures: parsed.signatures };\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('src/server.ts')\ns = p.read_text().replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplay, verifyWebhook')\ns = s.replace('  replay_tolerance_s: number;\\n', '')\ns = s.replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.\\nexport function loadPaygateConfig(env: NodeJS.ProcessEnv = process.env): PaygateConfig {\\n  const cfg = readJson<PaygateConfig>(\"paygate.json\");\\n  if (env.PAYGATE_REPLAY_TOLERANCE_S) cfg.replay_tolerance_s = Number(env.PAYGATE_REPLAY_TOLERANCE_S);\\n  return cfg;\\n}', '// Both ordinary deliveries and authenticated replays use tolerance_s.\\nexport function loadPaygateConfig(): PaygateConfig {\\n  return readJson<PaygateConfig>(\"paygate.json\");\\n}')\ns = s.replace('Promise<string>', 'Promise<Buffer>').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\nstart = s.index('        // Replays from Paygate')\nend = s.index('        } catch (err) {', start)\ns = s[:start] + '''        // A replay authenticates its fresh timestamp and body, not the old signature.\n        const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\n        try {\n          const now = Math.floor(Date.now() / 1000);\n          if (replay) {\n            verifyReplay(raw, req.headers[\"x-replay-timestamp\"] as string | undefined,\n              req.headers[\"x-replay-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          } else {\n            verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          }\n''' + s[end:]\ns = s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''        const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('  let result: ProcessResult;\\n', '  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n  let result: ProcessResult;\\n')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('    this.state.processed_events[eventId] = new Date().toISOString();', '''    Object.defineProperty(this.state.processed_events, eventId, {\n      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\n    });''')\np.write_text(s)\np = Path('config/refunds.json')\np.write_text('''{\n  \"auto_approve_max_minor\": 500000,\n  \"auto_approve_currencies\": [\"INR\"],\n  \"_note\": \"Finance-approved inclusive INR threshold: ₹5,000 (PAY-381)\"\n}\n''')\np = Path('config/paygate.json')\ns = p.read_text().replace('\"tolerance_s\": 300,\\n  \"replay_tolerance_s\": 300', '\"tolerance_s\": 300')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter)', 'signature window (`paygate.json`: `tolerance_s`, used for both deliveries and authenticated replays)')\np.write_text(s)\nPY\nnpm test\n"]
