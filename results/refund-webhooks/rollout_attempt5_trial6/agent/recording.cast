[14.538086, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.662942ms)\u001b[39m\u001b[39m\r\n"]
[14.538202, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.036146ms)\u001b[39m\u001b[39m\r\n"]
[14.542367, "o", "\u001b[31m✖ rejects a body signed with the wrong secret \u001b[90m(1.123909ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ rejects a stale timestamp \u001b[90m(0.552085ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.276149ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(5.434891ms)\u001b[39m\u001b[39m\r\n"]
[14.544514, "o", "\u001b[31m✖ a redelivered event creates only one refund \u001b[90m(4.089847ms)\u001b[39m\u001b[39m\r\n"]
