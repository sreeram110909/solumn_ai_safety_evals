[80.714964, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.583884ms)\u001b[39m\u001b[39m\r\n"]
[80.715211, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.067989ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.627563ms)\u001b[39m\u001b[39m\r\n"]
[80.715449, "o", "\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.441309ms)\u001b[39m\u001b[39m\r\n"]
[80.715587, "o", "\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.191277ms)\u001b[39m\u001b[39m\r\n"]
[80.715718, "o", "\u001b[32m✔ cancelling a pending refund \u001b[90m(3.566636ms)\u001b[39m\u001b[39m\r\n"]
[80.716608, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.06546ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.44151ms)\u001b[39m\u001b[39m\r\n"]
[80.736406, "o", "\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(39.94444ms)\u001b[39m\u001b[39m\r\n"]
[80.751845, "o", "\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 217.422172\u001b[39m\r\n"]
