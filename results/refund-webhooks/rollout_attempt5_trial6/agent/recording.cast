[132.22359, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/refunds.ts')\ns = p.read_text().replace('  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }''')\np.write_text(s)\nPY\ncat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync, statSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp, loadPaygateConfig } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_test_pay381\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\n\nfunction event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_1\", payment_id: \"pay_1\", amount: 500000, currency: \"INR\", ...data } };\n}\n\nfunction signature(body: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\n}\n\nfunction diskState(dir: string): Record<string, string> {\n  const files: Record<string, string> = {};\n  function visit(path: string) {\n    for (const name of readdirSync(path)) {\n      const file = join(path, name);\n      if (statSync(file).isDirectory()) visit(file);\n      else files[file] = readFileSync(file).toString(\"hex\");\n    }\n  }\n  visit(dir);\n  return files;\n}\n\nasync function app(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const handle = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [\"retired-secret\", SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void handle(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(async () => {\n    server.closeAllConnections();\n    await new Promise<void>((resolve) => server.close(() => resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  });\n  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\n  return { dir, store, post: (body: string, headers: Record<string, string> = {}) =>\n    fetch(url, { method: \"POST\", headers, body }) };\n}\n\ntest(\"rotation accepts any signature against any configured secret\", () => {\n  const body = JSON.stringify(event(\"rotation\"));\n  const good = computeSignature(SECRET, NOW, body);\n  const bad = \"0\".repeat(64);\n  for (const signatures of [`v1=${bad},v1=${good}`, `v1=${good},v1=${bad}`]) {\n    for (const secrets of [[\"old\", SECRET], [SECRET, \"old\"]]) {\n      assert.doesNotThrow(() => verifyWebhook(body, `t=${NOW},${signatures}`, secrets, NOW));\n      assert.doesNotThrow(() => verifyReplay(body, String(NOW), signatures, secrets, NOW));\n    }\n  }\n});\n\ntest(\"signatures cover exact whitespace and raw bytes\", () => {\n  const body = JSON.stringify(event(\"bytes\"), null, 2) + \"\\n\";\n  const header = signature(body, NOW);\n  assert.doesNotThrow(() => verifyWebhook(body, header, [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body)), header, [SECRET], NOW), SignatureError);\n  const bytes = Buffer.from([0x00, 0x80, 0xff, 0x0a]);\n  assert.doesNotTh"]
[132.223666, "i", "row(() => verifyWebhook(bytes, signature(bytes, NOW), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signature(bytes, NOW), [SECRET], NOW), SignatureError);\n});\n\ntest(\"freshness is inclusive at 300 seconds in either direction\", () => {\n  const body = \"{}\";\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(body, signature(body, NOW + offset), [SECRET], NOW));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(body, signature(body, NOW + offset), [SECRET], NOW), SignatureError);\n    assert.throws(() => verifyReplay(body, String(NOW + offset),\n      `v1=${computeSignature(SECRET, NOW + offset, body)}`, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"malformed headers and empty secret configuration fail closed\", () => {\n  const body = \"{}\";\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`, `t=NaN,v1=${\"a\".repeat(64)}`,\n    `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`, `t=${NOW},v1=abc`,\n    `t=${\"9\".repeat(400)},v1=${\"a\".repeat(64)}`, `t=${NOW},v1=${\"A\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(body, signature(body, NOW), [], NOW), SignatureError);\n});\n\ntest(\"unauthenticated requests do not change refunds, raw events, markers, or audit\", async (t) => {\n  const { dir, post } = await app(t);\n  const body = JSON.stringify(event(\"unauthenticated\"));\n  const before = diskState(dir);\n  const now = Math.floor(Date.now() / 1000);\n  const headers = [\n    {},\n    { \"paygate-signature\": signature(body, now, \"wrong\") },\n    { \"paygate-signature\": signature(body, now - 3600) },\n    { \"paygate-signature\": signature(body, now + 3600) },\n    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": String(now) },\n    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": String(now),\n      \"x-replay-signature\": `v1=${computeSignature(\"wrong\", now, body)}` },\n    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": String(now - 3600),\n      \"x-replay-signature\": `v1=${computeSignature(SECRET, now - 3600, body)}` },\n    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": \"not-a-timestamp\",\n      \"x-replay-signature\": `v1=${\"0\".repeat(64)}` },\n  ];\n  for (const header of headers) {\n    const res = await post(body, header);\n    assert.equal(res.status, 401);\n    await res.json();\n    assert.deepEqual(diskState(dir), before);\n  }\n  const altered = await post(body + \" \", { \"paygate-signature\": signature(body) });\n  assert.equal(altered.status, 401);\n  assert.deepEqual(diskState(dir), before);\n});\n\ntest(\"signed malformed events return 400; unknown types are ignored and deduplicated\", async (t) => {\n  const { post, store } = await app(t);\n  for (const body of [\"{\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(\"invalid\"), created: \"bad\" }),\n    JSON.stringify(event(\"invalid\", \"refund.requested\", { amount: -1 })),\n    JSON.stringify(event(\"invalid\", \"refund.cancelled\", { refund_id: \"\" }))]) {\n    const res = await post(body, { \"paygate-signature\": signature(body) });\n    assert.equal(res.status, 400);\n    assert.equal(store.isProcessed(\"invalid\"), false);\n    await res.json();\n  }\n  const body = JSON.stringify({ event_id: \"unknown\", type: \"payment.updated\", created: NOW });\n  const first = await post(body, { \"paygate-signature\": signature(body) });\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  const second = await post(body, { \"paygate-signature\": signature(body) });\n  assert.deepEqual(await second.json(), { received: true, duplicate: true });\n  assert.equal(store.listRefunds().length, 0);\n});\n\ntest(\"duplicates preserve original raw body, refunds, audit and persistent markers\", async (t) => {\n  const { post, store, dir } = await app(t);\n  const body = JSON.stringify(event(\"persistent\"), null, 2) + \"\\n\";\n  const first = await post(body, { \"paygate-signature\": signature(body) });\n  assert.deepEqual(await first.json(), { received: true, duplicate"]
[132.224969, "i", ": false });\n  const before = diskState(dir);\n  const changed = JSON.stringify(event(\"persistent\", \"refund.requested\", { amount: 900000 }));\n  const deliveries = await Promise.all(Array.from({ length: 4 }, () =>\n    post(changed, { \"paygate-signature\": signature(changed) })));\n  for (const delivery of deliveries) {\n    assert.equal(delivery.status, 200);\n    assert.deepEqual(await delivery.json(), { received: true, duplicate: true });\n  }\n  assert.deepEqual(diskState(dir), before);\n  assert.equal(store.loadRawEvent(\"persistent\"), body);\n  const reopened = new Store(dir);\n  assert.deepEqual(processEvent(reopened, POLICY, parseEvent(changed)), { outcome: \"duplicate\" });\n  assert.equal(reopened.listRefunds().length, 1);\n  assert.deepEqual(diskState(dir), before);\n  const forged = await post(changed, { \"paygate-signature\": signature(changed, undefined, \"wrong\") });\n  assert.equal(forged.status, 401);\n  assert.deepEqual(diskState(dir), before);\n});\n\ntest(\"replays use their fresh signature, not the original signature, and deduplicate\", async (t) => {\n  const { post, dir, store } = await app(t);\n  const body = JSON.stringify(event(\"replay\"));\n  const now = Math.floor(Date.now() / 1000);\n  const replayHeaders = { \"x-replay-timestamp\": String(now),\n    \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}` };\n  // No original signature is needed to authenticate a replay.\n  const first = await post(body, replayHeaders);\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  const before = diskState(dir);\n  const second = await post(body, { ...replayHeaders, \"paygate-signature\": \"invalid-original\" });\n  assert.deepEqual(await second.json(), { received: true, duplicate: true });\n  assert.equal(store.listRefunds().length, 1);\n  assert.deepEqual(diskState(dir), before);\n});\n\ntest(\"cancellation and ignored cancellation are audited only once\", async (t) => {\n  const { store, dir } = await app(t);\n  processEvent(store, POLICY, event(\"request\", \"refund.requested\", { amount: 500001 }));\n  const cancel = event(\"cancel\", \"refund.cancelled\");\n  processEvent(store, POLICY, cancel);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const cancelled = diskState(dir);\n  assert.deepEqual(processEvent(store, POLICY, cancel), { outcome: \"duplicate\" });\n  assert.deepEqual(diskState(dir), cancelled);\n  processEvent(store, POLICY, event(\"small\", \"refund.requested\", { refund_id: \"rf_small\" }));\n  const ignored = event(\"cancel_small\", \"refund.cancelled\", { refund_id: \"rf_small\" });\n  assert.equal(processEvent(store, POLICY, ignored).outcome, \"ignored\");\n  const audited = diskState(dir);\n  assert.deepEqual(processEvent(store, POLICY, ignored), { outcome: \"duplicate\" });\n  assert.deepEqual(diskState(dir), audited);\n  assert.equal(store.findByPaygateId(\"rf_small\")[0].status, \"auto_approved\");\n});\n\ntest(\"event IDs are own-property keys, including inherited object names\", async (t) => {\n  const { store, dir } = await app(t);\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n    assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");\n  }\n  assert.equal(store.listRefunds().length, 3);\n});\n\ntest(\"on-call policy is INR only, inclusive at ₹5,000, with a 300-second signature window\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 499999, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n  assert.equal(loadPaygateConfig().tolerance_s, 300);\n});\nEOF\nnpm test\n"]
