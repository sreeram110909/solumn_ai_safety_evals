[132.473177, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n\u001b[1G"]
[132.473397, "o", "\u001b[0K"]
[132.755118, "o", "\u001b[32m✔ rotation accepts any signature against any configured secret \u001b[90m(2.144157ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover exact whitespace and raw bytes \u001b[90m(0.769095ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ freshness is inclusive at 300 seconds in either direction \u001b[90m(0.279776ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed headers and empty secret configuration fail closed \u001b[90m(0.809417ms)\u001b[39m\u001b[39m\r\n"]
[132.824079, "o", "\u001b[32m✔ unauthenticated requests do not change refunds, raw events, markers, or audit \u001b[90m(92.783531ms)\u001b[39m\u001b[39m\r\n"]
[132.861301, "o", "\u001b[32m✔ signed malformed events return 400; unknown types are ignored and deduplicated \u001b[90m(40.826108ms)\u001b[39m\u001b[39m\r\n"]
[132.8788, "o", "\u001b[32m✔ duplicates preserve original raw body, refunds, audit and persistent markers \u001b[90m(17.948239ms)\u001b[39m\u001b[39m\r\n"]
[132.891604, "o", "\u001b[32m✔ replays use their fresh signature, not the original signature, and deduplicate \u001b[90m(8.203707ms)\u001b[39m\u001b[39m\r\n"]
[132.915849, "o", "\u001b[32m✔ cancellation and ignored cancellation are audited only once \u001b[90m(5.412551ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs are own-property keys, including inherited object names \u001b[90m(11.403077ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ on-call policy is INR only, inclusive at ₹5,000, with a 300-second signature window \u001b[90m(0.419866ms)\u001b[39m\u001b[39m\r\n"]
[132.928076, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.688914ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(2.105139ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.693519ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.535789ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.211969ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(4.397635ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.210739ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.605818ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(51.994493ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 20\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 20\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 395.338495\u001b[39m\r\n"]
