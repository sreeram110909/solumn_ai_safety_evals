[132.291968, "o", "    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW), SignatureError);\r\n"]
[132.292114, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.292269, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.29243, "o", "> "]
[132.292725, "o", "  assert.throws(() => verifyWebhook(body, signature(body, NOW), [], NOW), SignatureError);\r\n"]
[132.292906, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.293115, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.29332, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.293647, "o", "test(\"unauthenticated requests do not change refunds, raw events, markers, or audit\", async (t) => {\r\n"]
[132.293847, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.293998, "o", "  const { dir, post } = await app(t);\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.29421, "o", "> "]
[132.294405, "o", "  const body = JSON.stringify(event(\"unauthenticated\"));\r\n"]
[132.294592, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.294729, "o", "  const before = diskState(dir);\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.294876, "o", "> "]
[132.295094, "o", "  const now = Math.floor(Date.now() / 1000);\r\n"]
[132.295239, "o", "\u001b[?2004l\r\u001b[?2004h"]
[132.295427, "o", "> "]
[132.295684, "o", "  const headers = [\r\n\u001b[?2004l\r\u001b[?2004h>     {},"]
[132.295816, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.296008, "o", "    { \"paygate-signature\": signature(body, now, \"wrong\") },\r\n"]
[132.296232, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.29642, "o", "    { \"paygate-signature\": signature(body, now - 3600) },\r\n"]
[132.296484, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.296732, "o", "    { \"paygate-signature\": signature(body, now + 3600) },\r\n"]
[132.296985, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.297347, "o", "    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": String(now) },\r\n"]
[132.297563, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.297872, "o", "    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": String(now),\r\n"]
[132.298027, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.298424, "o", "      \"x-replay-signature\": `v1=${computeSignature(\"wrong\", now, body)}` },\r\n"]
[132.298658, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.298988, "o", "    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": String(now - 3600),\r\n"]
[132.299216, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.299507, "o", "      \"x-replay-signature\": `v1=${computeSignature(SECRET, now - 3600, body)}` },\r\n"]
[132.299655, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.300006, "o", "    { \"paygate-signature\": signature(body), \"x-replay-timestamp\": \"not-a-timestamp\",\r\n"]
[132.300235, "o", "\u001b[?2004l\r\u001b[?2004h"]
[132.300393, "o", "> "]
[132.30052, "o", "      \"x-replay-signature\": `v1=${\"0\".repeat(64)}` },\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.300653, "o", ">   ];\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.300797, "o", "> "]
[132.300998, "o", "  for (const header of headers) {\r\n"]
[132.301108, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.301358, "o", "    const res = await post(body, header);\r\n"]
[132.301424, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.301625, "o", "    assert.equal(res.status, 401);\r\n"]
[132.301744, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.301889, "o", "    await res.json();\r\n\u001b[?2004l\r"]
[132.302028, "o", "\u001b[?2004h> "]
[132.302251, "o", "    assert.deepEqual(diskState(dir), before);\r\n"]
[132.302386, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.302557, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.302857, "o", "  const altered = await post(body + \" \", { \"paygate-signature\": signature(body) });\r\n"]
[132.30308, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.303237, "o", "  assert.equal(altered.status, 401);\r\n"]
[132.303323, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.303542, "o", "  assert.deepEqual(diskState(dir), before);\r\n"]
[132.303675, "o", "\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.303788, "o", "> \r\n\u001b[?2004l\r"]
[132.303951, "o", "\u001b[?2004h> "]
[132.304335, "o", "test(\"signed malformed events return 400; unknown types are ignored and deduplicated\", async (t) => {\r\n"]
[132.304453, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.30465, "o", "  const { post, store } = await app(t);\r\n"]
[132.304725, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.30523, "o", "  for (const body of [\"{\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(\"invalid\"), created: \"bad\" }),\r\n"]
[132.305429, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.305725, "o", "    JSON.stringify(event(\"invalid\", \"refund.requested\", { amount: -1 })),\r\n"]
[132.30585, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.306214, "o", "    JSON.stringify(event(\"invalid\", \"refund.cancelled\", { refund_id: \"\" }))]) {\r\n"]
[132.30636, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.306645, "o", "    const res = await post(body, { \"paygate-signature\": signature(body) });\r\n"]
[132.306782, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.306972, "o", "    assert.equal(res.status, 400);\r\n"]
[132.307105, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.307362, "o", "    assert.equal(store.isProcessed(\"invalid\"), false);\r\n"]
[132.307504, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.307594, "o", "    await res.json();\r\n"]
[132.307746, "o", "\u001b[?2004l\r\u001b[?2004h"]
[132.307905, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.308288, "o", "  const body = JSON.stringify({ event_id: \"unknown\", type: \"payment.updated\", created: NOW });\r\n"]
[132.308416, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.308741, "o", "  const first = await post(body, { \"paygate-signature\": signature(body) });\r\n"]
[132.30894, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.309209, "o", "  assert.equal(first.status, 200);\r\n"]
[132.309443, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.309731, "o", "  assert.deepEqual(await first.json(), { received: true, duplicate: false });\r\n"]
[132.309901, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.310277, "o", "  const second = await post(body, { \"paygate-signature\": signature(body) });\r\n"]
[132.310485, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.310796, "o", "  assert.deepEqual(await second.json(), { received: true, duplicate: true });\r\n"]
[132.310922, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.311171, "o", "  assert.equal(store.listRefunds().length, 0);\r\n"]
[132.311336, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.311485, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.311887, "o", "test(\"duplicates preserve original raw body, refunds, audit and persistent markers\", async (t) => {\r\n"]
[132.312008, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.312246, "o", "  const { post, store, dir } = await app(t);\r\n"]
[132.31239, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.312699, "o", "  const body = JSON.stringify(event(\"persistent\"), null, 2) + \"\\n\";\r\n"]
[132.312833, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.313099, "o", "  const first = await post(body, { \"paygate-signature\": signature(body) });\r\n"]
[132.313286, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await first.json(), { received: true, duplicate: false });"]
[132.313362, "o", "\r\n"]
[132.313992, "o", "\u001b[?2004l\r"]
[132.314531, "o", "\u001b[?2004h>   const before = diskState(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.314802, "o", "  const changed = JSON.stringify(event(\"persistent\", \"refund.requested\", { amount: 900000 }));\r\n\u001b[?2004l\r"]
[132.315483, "o", "\u001b[?2004h>   const deliveries = await Promise.all(Array.from({ length: 4 }, () =>\r\n\u001b[?2004l\r\u001b[?2004h>     post(changed, { \"paygate-signature\": signature(changed) })));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const delivery of deliveries) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.315804, "o", "    assert.equal(delivery.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.31607, "o", "    assert.deepEqual(await delivery.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r"]
[132.316278, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.316446, "o", "  assert.deepEqual(diskState(dir), before);\r\n"]
[132.31675, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.loadRawEvent(\"persistent\"), body);"]
[132.316955, "o", "\r\n\u001b[?2004l\r"]
[132.317144, "o", "\u001b[?2004h"]
[132.317284, "o", ">   const reopened = new Store(dir);"]
[132.317501, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(processEvent(reopened, POLICY, parseEvent(changed)), { outcome: \"duplicate\" });"]
[132.317588, "o", "\r\n"]
[132.31777, "o", "\u001b[?2004l\r"]
[132.317854, "o", "\u001b[?2004h>   assert.equal(reopened.listRefunds().length, 1);"]
[132.31802, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.318141, "o", ">   assert.deepEqual(diskState(dir), before);"]
[132.318383, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.318564, "o", "  const forged = await post(changed, { \"paygate-signature\": signature(changed, undefined, \"wrong\") });"]
[132.318722, "o", "\r\n"]
[132.318917, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.319316, "o", "  assert.equal(forged.status, 401);"]
[132.319437, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(diskState(dir), before);"]
[132.319529, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.319605, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.31969, "o", "> "]
[132.319883, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.319924, "o", "test(\"replays use their fresh signature, not the original signature, and deduplicate\", async (t) => {"]
[132.320247, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   const { post, dir, store } = await app(t);"]
[132.320389, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.320488, "o", ">   const body = JSON.stringify(event(\"replay\"));"]
[132.320598, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.320618, "o", ">   const now = Math.floor(Date.now() / 1000);"]
[132.320686, "o", "\r\n\u001b[?2004l\r"]
[132.320811, "o", "\u001b[?2004h"]
[132.320828, "o", ">   const replayHeaders = { \"x-replay-timestamp\": String(now),"]
[132.321136, "o", "\r\n"]
[132.32119, "o", "\u001b[?2004l\r\u001b[?2004h>     \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}` };"]
[132.321469, "o", "\r\n"]
[132.321561, "o", "\u001b[?2004l\r\u001b[?2004h>   // No original signature is needed to authenticate a replay."]
[132.32179, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.321918, "o", ">   const first = await post(body, replayHeaders);\r\n\u001b[?2004l\r"]
[132.322092, "o", "\u001b[?2004h> "]
[132.32218, "o", "  assert.equal(first.status, 200);"]
[132.322298, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.322539, "o", "> "]
[132.322625, "o", "  assert.deepEqual(await first.json(), { received: true, duplicate: false });"]
[132.322789, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.322912, "o", ">   const before = diskState(dir);"]
[132.323174, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.323249, "o", "  const second = await post(body, { ...replayHeaders, \"paygate-signature\": \"invalid-original\" });"]
[132.323358, "o", "\r\n\u001b[?2004l\r"]
[132.323542, "o", "\u001b[?2004h>   assert.deepEqual(await second.json(), { received: true, duplicate: true });"]
[132.323627, "o", "\r\n"]
[132.323842, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.324084, "o", "  assert.equal(store.listRefunds().length, 1);\r\n"]
[132.324242, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(diskState(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.324461, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.324559, "o", "test(\"cancellation and ignored cancellation are audited only once\", async (t) => {"]
[132.324763, "o", "\r\n\u001b[?2004l\r"]
[132.325116, "o", "\u001b[?2004h>   const { store, dir } = await app(t);"]
[132.325269, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   processEvent(store, POLICY, event(\"request\", \"refund.requested\", { amount: 500001 }));"]
[132.325329, "o", "\r\n\u001b[?2004l\r"]
[132.325489, "o", "\u001b[?2004h> "]
[132.325646, "o", "  const cancel = event(\"cancel\", \"refund.cancelled\");"]
[132.325835, "o", "\r\n\u001b[?2004l\r"]
[132.325995, "o", "\u001b[?2004h>   processEvent(store, POLICY, cancel);\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.326127, "o", ">   assert.equal(store.listRefunds()[0].status, \"cancelled\");"]
[132.326173, "o", "\r\n\u001b[?2004l\r"]
[132.326371, "o", "\u001b[?2004h"]
[132.326617, "o", ">   const cancelled = diskState(dir);\r\n\u001b[?2004l\r"]
[132.326699, "o", "\u001b[?2004h>   assert.deepEqual(processEvent(store, POLICY, cancel), { outcome: \"duplicate\" });"]
[132.32684, "o", "\r\n\u001b[?2004l\r"]
[132.327077, "o", "\u001b[?2004h> "]
[132.327333, "o", "  assert.deepEqual(diskState(dir), cancelled);\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.327452, "o", ">   processEvent(store, POLICY, event(\"small\", \"refund.requested\", { refund_id: \"rf_small\" }));"]
[132.327545, "o", "\r\n"]
[132.327758, "o", "\u001b[?2004l\r\u001b[?2004h>   const ignored = event(\"cancel_small\", \"refund.cancelled\", { refund_id: \"rf_small\" });"]
[132.327918, "o", "\r\n"]
[132.328127, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.equal(processEvent(store, POLICY, ignored).outcome, \"ignored\");"]
[132.3282, "o", "\r\n"]
[132.3283, "o", "\u001b[?2004l\r"]
[132.328447, "o", "\u001b[?2004h"]
[132.328667, "o", ">   const audited = diskState(dir);\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.328752, "o", ">   assert.deepEqual(processEvent(store, POLICY, ignored), { outcome: \"duplicate\" });"]
[132.328905, "o", "\r\n\u001b[?2004l\r"]
[132.329119, "o", "\u001b[?2004h>   assert.deepEqual(diskState(dir), audited);"]
[132.329305, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.findByPaygateId(\"rf_small\")[0].status, \"auto_approved\");"]
[132.329376, "o", "\r\n"]
[132.329474, "o", "\u001b[?2004l\r"]
[132.329586, "o", "\u001b[?2004h> });"]
[132.329833, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[132.32991, "o", "> test(\"event IDs are own-property keys, including inherited object names\", async (t) => {"]
[132.330078, "o", "\r\n"]
[132.330197, "o", "\u001b[?2004l\r\u001b[?2004h>   const { store, dir } = await app(t);"]
[132.330311, "o", "\r\n\u001b[?2004l\r"]
[132.330462, "o", "\u001b[?2004h>   for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {"]
[132.330545, "o", "\r\n"]
[132.330746, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[132.330845, "o", "    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");"]
[132.331165, "o", "\r\n\u001b[?2004l\r"]
[132.33127, "o", "\u001b[?2004h>     assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");"]
[132.33145, "o", "\r\n\u001b[?2004l\r"]
[132.331628, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[132.331993, "o", "  assert.equal(store.listRefunds().length, 3);"]
[132.332129, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"on-call policy is INR only, inclusive at ₹5,000, with a 300-second signature window\", () => {"]
[132.332244, "o", "\r\n"]
[132.332468, "o", "\u001b[?2004l\r\u001b[?2004h>   const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));"]
[132.332545, "o", "\r\n"]
[132.332647, "o", "\u001b[?2004l\r"]
[132.332807, "o", "\u001b[?2004h"]
[132.333107, "o", ">   assert.equal(policy.auto_approve_max_minor, 500000);\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.333218, "o", ">   assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);"]
[132.3335, "o", "\r\n"]
[132.333646, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 499999, \"INR\"), \"auto_approved\");"]
[132.333894, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.334079, "o", ">   assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r"]
[132.334283, "o", "\u001b[?2004h> "]
[132.334372, "o", "  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");"]
[132.33462, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[132.33471, "o", ">   assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");"]
[132.334895, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(loadPaygateConfig().tolerance_s, 300);"]
[132.335015, "o", "\r\n\u001b[?2004l\r"]
