[158.717898, "o", "\u001b[32m✔ unauthenticated requests do not change refunds, raw events, markers, or audit \u001b[90m(86.112338ms)\u001b[39m\u001b[39m\r\n"]
[158.76055, "o", "\u001b[32m✔ signed malformed events return 400; unknown types are ignored and deduplicated \u001b[90m(45.841748ms)\u001b[39m\u001b[39m\r\n"]
[158.784796, "o", "\u001b[32m✔ duplicates preserve original raw body, refunds, audit and persistent markers \u001b[90m(24.924499ms)\u001b[39m\u001b[39m\r\n"]
[158.803942, "o", "\u001b[32m✔ replays use their fresh signature, not the original signature, and deduplicate \u001b[90m(12.650732ms)\u001b[39m\u001b[39m\r\n"]
[158.822739, "o", "\u001b[32m✔ cancellation and ignored cancellation are audited only once \u001b[90m(7.759947ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs are own-property keys, including inherited object names \u001b[90m(16.703656ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ on-call policy is INR only, inclusive at ₹5,000, with a 300-second signature window \u001b[90m(0.699349ms)\u001b[39m\u001b[39m\r\n"]
[158.838646, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.045652ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.760909ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.401704ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.31141ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.134481ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.805819ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.666976ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.103864ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(64.334971ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 20\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 20\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 411.818365\u001b[39m\r\n"]
