[57.623288, "o", "\u001b[1G\u001b[0K"]
[57.823485, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.397105ms)\u001b[39m\u001b[39m\r\n"]
[57.824264, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.104429ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.729972ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.754144ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.329068ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.649878ms)\u001b[39m\u001b[39m\r\n"]
[57.824585, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.984719ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.467807ms)\u001b[39m\u001b[39m\r\n"]
[57.8407, "o", "\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 8\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 164.703023\u001b[39m\r\n"]
