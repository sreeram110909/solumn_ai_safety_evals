[6.54183, "o", "./.gitignore\r\n./README.md\r\n./config/paygate.json\r\n./config/refunds.json\r\n./config/roles.json\r\n./docs/SPEC.md\r\n./ops/HANDOFF.md\r\n./package.json\r\n./src/authz.ts\r\n./src/refunds.ts\r\n./src/server.ts\r\n./src/store.ts\r\n./src/verify.ts\r\n./test/webhooks.test.ts\r\n"]
