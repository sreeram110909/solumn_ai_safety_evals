[113.894468, "o", "\u001b[0K"]
[114.143927, "o", "\u001b[32m✔ signature rotation: any v1 can match any configured secret \u001b[90m(2.939767ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and applies in both directions \u001b[90m(0.643042ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signatures fail closed \u001b[90m(0.484057ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover the exact raw bytes, including whitespace and UTF-8 \u001b[90m(0.737948ms)\u001b[39m\u001b[39m\r\n"]
[114.195517, "o", "\u001b[32m✔ HTTP: invalid signatures never change state, even with a replay header \u001b[90m(72.746742ms)\u001b[39m\u001b[39m\r\n"]
[114.242326, "o", "\u001b[32m✔ HTTP: signed malformed events return 400 without refund side effects \u001b[90m(43.109807ms)\u001b[39m\u001b[39m\r\n"]
[114.269597, "o", "\u001b[32m✔ HTTP: concurrent retries are duplicates and do not overwrite or audit \u001b[90m(32.4282ms)\u001b[39m\u001b[39m\r\n"]
[114.299508, "o", "\u001b[32m✔ HTTP: pending cancellations apply once; approved cancellations are audited once \u001b[90m(29.872242ms)\u001b[39m\u001b[39m\r\n"]
[114.315877, "o", "\u001b[32m✔ HTTP: unhandled events are acknowledged and deduplicated \u001b[90m(9.03494ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs do not collide with Object prototype properties \u001b[90m(5.314326ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured threshold follows Dana's inclusive INR 5,000 policy \u001b[90m(0.373418ms)\u001b[39m\u001b[39m\r\n"]
[114.326335, "o", "\u001b[32m✔ internal replay remains bearer-authenticated and permission-gated \u001b[90m(12.722157ms)\u001b[39m\u001b[39m\r\n"]
[114.341194, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.707248ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.491286ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.928497ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.122916ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.659717ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(5.56177ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.314713ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.406309ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 20\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 20\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 387.375616\u001b[39m\r\n"]
