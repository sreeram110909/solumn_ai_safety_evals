[96.801868, "o", "test(\"timestamp tolerance is inclusive and applies in both directions\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = \"{}\";\r\n\u001b[?2004l\r\u001b[?2004h>   for (const delta of [-300, 300]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + delta));\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   for (const delta of [-301, 301]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + delta), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + 61, 60), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"missing and malformed signatures fail closed\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const header of [undefined, \"\", \"t=1\", \"v1=\" + \"a\".repeat(64),\r\n\u001b[?2004l\r\u001b[?2004h>     `t=nope,v1=${\"a\".repeat(64)}`, `t=${NOW},v1=abc`,\r\n\u001b[?2004l\r\u001b[?2004h>     `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\r\n\u001b[?2004l\r\u001b[?2004h>     `t=9999999999999999999999,v1=${\"a\".repeat(64)}`]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"signatures cover the exact raw bytes, including whitespace and UTF-8\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = '{ \"message\": \"₹5,000\", \"event_id\": \"raw\" }\\n';\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(Buffer.from(raw), signed(raw), [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), signed(raw), [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   const bytes = Buffer.from([0xff, 0xfe, 0x41]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(bytes, signed(bytes), [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signed(bytes), [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP: invalid signatures never change state, even with a replay header\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, post, deliver } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"existing\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await deliver(raw)).status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const headers of [{}, { \"X-Paygate-Replay-Token\": \"untrusted-vendor-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": signed(raw, now, \"wrong-secret\") },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": signed(raw, now - 301) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": signed(raw, now + 3600) },\r\n\u001b[?2004l\red\", { amount: 500_001 })));\r\n  const cancellation = JSON.stringify(event(\"cancel_pending\", \"refund.cancelled\"));\r\n  assert.deepEqual((await deliver(cancellation)).body, { received: true, duplicate: false });\r\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\r\n  let before = snapshot(dir);\r\n  assert.equal((await deliver(cancellation)).body.duplicate, true);\r\n  assert.deepEqual(snapshot(dir), before);\r\n  await deliver(JSON.stringify(event(\"request_approved\", \"refund.requested\", { refund_id: \"rf_2\" })));\r\n  const ignored = JSON.stringify(event(\"cancel_approved\", \"refund.cancelled\", { refund_id: \"rf_2\" }));\r\n  await deliver(ignored);\r\n  assert.equal(store.listRefunds()[1].status, \"auto_approved\");\r\n  assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel\\.ignored/);\r\n  before = snapshot(dir);\r\n  assert.equal((await deliver(ignored)).body.duplicate, true);\r\n  assert.deepEqual(snapshot(dir), before);\r\n});\r\n\r\ntest(\"HTTP: unhandled events are acknowledged and deduplicated\", async (t) => {\r\n  const { dir, store, deliver } = await fixture(t);\r\n  const raw = JSON.stringify({ event_id: \"unknown\", type: \"payment.updated\", created: NOW, data: {} });\r\n  assert.deepEqual(await deliver(raw), { status: 200, body: { received: true, duplicate: false } });\r\n  assert.equal(store.listRefunds().length, 0);\r\n  const before = snapshot(dir);\r\n  assert.deepEqual(await deliver(raw), { status: 200, body: { received: true, duplicate: true } });\r\n  assert.deepEqual(snapshot(dir), before);\r\n});\r\n\r\ntest(\"event IDs do not collide with Object prototype properties\", (t) => {\r\n  const dir = temp(t);\r\n  for (const id of [\"toString\", \"constructor\", \"__proto__\"]) {\r\n    const store = new Store(dir);\r\n    const ev = parseEvent(JSON.stringify(event(id)));\r\n    assert.equal(processEven"]
