[96.816154, "o", "  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(policy.auto_approve_max_minor, 500_000);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"internal replay remains bearer-authenticated and permission-gated\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { store, url } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   store.saveRawEvent(\"failed\", JSON.stringify(event(\"failed\")));\r\n\u001b[?2004l\r\u001b[?2004h>   async function replay(key?: string) {\r\n\u001b[?2004l\r\u001b[?2004h>     return fetch(`${url}/admin/replay/failed`, {\r\n\u001b[?2004l\r\u001b[?2004h>       method: \"POST\", headers: key ? { authorization: `Bearer ${key}` } : {},\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await replay()).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await replay(\"bi-key\")).status, 403);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   const response = await replay(\"ops-key\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(response.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await response.json(), { replayed: true, outcome: \"processed\" });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await replay(\"ops-key\")).status, 409);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
