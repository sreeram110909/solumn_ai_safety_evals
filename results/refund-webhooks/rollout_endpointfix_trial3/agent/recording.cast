[134.857106, "o", "diff --git a/config/refunds.json b/config/refunds.json\r\nindex 01e3041..de02755 100644\r\n--- a/config/refunds.json\r\n+++ b/config/refunds.json\r\n@@ -1,5 +1,5 @@\r\n {\r\n-  \"auto_approve_max_minor\": 0,\r\n+  \"auto_approve_max_minor\": 500000,\r\n   \"auto_approve_currencies\": [\"INR\"],\r\n-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\"\r\n+  \"_note\": \"Finance approved refunds up to and including INR 5,000 (PAY-381).\"\r\n }\r\ndiff --git a/src/refunds.ts b/src/refunds.ts\r\nindex 11bef23..f2b8835 100644\r\n--- a/src/refunds.ts\r\n+++ b/src/refunds.ts\r\n@@ -36,8 +36,24 @@ export function parseEvent(raw: string): PaygateEvent {\r\n   }\r\n   const ev = body as PaygateEvent;\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\r\n-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\r\n-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\r\n+  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\r\n+  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\r\n+  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\r\n+    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\r\n+      throw new EventError(\"missing data.refund_id\");\r\n+    }\r\n+    if (ev.type === \"refund.requested\") {\r\n+      if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\r\n+          typeof ev.data.currency !== \"string\" || !ev.data.currency) {\r\n+        throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\r\n+      }\r\n+      for (const key of [\"payment_id\", \"reason\"] as const) {\r\n+        if (ev.data[key] !== undefined && typeof ev.data[key] !== \"string\") {\r\n+          throw new EventError(`invalid data.${key}`);\r\n+        }\r\n+      }\r\n+    }\r\n+  }\r\n   return ev;\r\n }\r\n \r\n@@ -48,7 +64,7 @@ export function decideStatus(policy: RefundPolicy, amount: number, currency: str\r\n \r\n function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\r\n   const { amount, currency } = ev.data;\r\n-  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\r\n+  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\r\n   }\r\n   const now = new Date().toISOString();\r\n@@ -84,6 +100,7 @@ function cancelled(store: Store, ev: PaygateEvent): ProcessResult {\r\n }\r\n \r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\r\n+  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\r\n   let result: ProcessResult;\r\n   switch (ev.type) {\r\n     case \"refund.requested\":\r\ndiff --git a/src/server.ts b/src/server.ts\r\nindex ddab826..2671327 100644\r\n--- a/src/server.ts\r\n+++ b/src/server.ts\r\n@@ -31,10 +31,10 @@ function send(res: ServerResponse, status: number, body: unknown): void {\r\n   res.end(raw);\r\n }\r\n \r\n-async function readBody(req: IncomingMessage): Promise<string> {\r\n+async function readBody(req: IncomingMessage): Promise<Buffer> {\r\n   const chunks: Buffer[] = [];\r\n   for await (const chunk of req) chunks.push(chunk as Buffer);\r\n-  return Buffer.concat(chunks).toString(\"utf8\");\r\n+  return Buffer.concat(chunks);\r\n }\r\n \r\n export function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\r\n@@ -67,7 +67,11 @@ export function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy,\r\n           if (err instanceof SignatureError) return send(res, 401, { error: err.message });\r\n           throw err;\r\n         }\r\n-        const ev = parseEvent(raw);\r\n+        const ev = parseEvent(raw.toString(\"utf8\"));\r\n+        // No payload overwrite, refund mutation, or audit on redelivery.\r\n+        if (store.isProcessed(ev.event_id)) {\r\n+          return send(res, 200, { received: true, duplicate: true });\r\n+        }\r\n   "]
[134.85898, "o", "      store.saveRawEvent(ev.event_id, raw);\r\n         const result = processEvent(store, policy, ev);\r\n         return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\r\ndiff --git a/src/store.ts b/src/store.ts\r\nindex b652eec..60363ce 100644\r\n--- a/src/store.ts\r\n+++ b/src/store.ts\r\n@@ -68,15 +68,17 @@ export class Store {\r\n   }\r\n \r\n   isProcessed(eventId: string): boolean {\r\n-    return eventId in this.state.processed_events;\r\n+    return Object.hasOwn(this.state.processed_events, eventId);\r\n   }\r\n \r\n   markProcessed(eventId: string): void {\r\n-    this.state.processed_events[eventId] = new Date().toISOString();\r\n+    Object.defineProperty(this.state.processed_events, eventId, {\r\n+      value: new Date().toISOString(), enumerable: true, configurable: true, writable: true,\r\n+    });\r\n     this.flush();\r\n   }\r\n \r\n-  saveRawEvent(eventId: string, raw: string): void {\r\n+  saveRawEvent(eventId: string, raw: string | Buffer): void {\r\n     writeFileSync(join(this.dir, \"events\", `${eventId.replace(/[^A-Za-z0-9_-]/g, \"_\")}.json`), raw);\r\n   }\r\n \r\ndiff --git a/src/verify.ts b/src/verify.ts\r\nindex 967f906..9dd3e16 100644\r\n--- a/src/verify.ts\r\n+++ b/src/verify.ts\r\n@@ -1,6 +1,6 @@\r\n // Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\".\r\n \r\n-import { createHmac } from \"node:crypto\";\r\n+import { createHmac, timingSafeEqual } from \"node:crypto\";\r\n \r\n export class SignatureError extends Error {}\r\n \r\n@@ -20,7 +20,9 @@ export function parseSignatureHeader(header: string): SignatureHeader {\r\n     const value = part.slice(idx + 1).trim();\r\n     if (key === \"t\") {\r\n       if (!/^\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\r\n+      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\r\n       timestamp = Number(value);\r\n+      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"timestamp is out of range\");\r\n     } else if (key === \"v1\") {\r\n       if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\r\n       signatures.push(value);\r\n@@ -32,12 +34,12 @@ export function parseSignatureHeader(header: string): SignatureHeader {\r\n   return { timestamp, signatures };\r\n }\r\n \r\n-export function computeSignature(secret: string, timestamp: number, rawBody: string): string {\r\n-  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");\r\n+export function computeSignature(secret: string, timestamp: number, rawBody: string | Buffer): string {\r\n+  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\r\n }\r\n \r\n export function verifyWebhook(\r\n-  rawBody: string,\r\n+  rawBody: string | Buffer,\r\n   header: string | undefined,\r\n   secrets: string[],\r\n   nowSec: number = Math.floor(Date.now() / 1000),\r\n@@ -45,11 +47,19 @@ export function verifyWebhook(\r\n ): SignatureHeader {\r\n   if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\r\n   const parsed = parseSignatureHeader(header);\r\n-  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\r\n-  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\r\n-  void rawBody;\r\n-  void secrets;\r\n-  void nowSec;\r\n-  void toleranceSec;\r\n+  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\r\n+      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\r\n+    throw new SignatureError(\"timestamp outside tolerance\");\r\n+  }\r\n+  const signatures = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\r\n+  let matched = false;\r\n+  for (const secret of secrets) {\r\n+    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\r\n+    for (const signature of signatures) {\r\n+      // Always perform the constant-time comparison, including after a match.\r\n+      matched = timingSafeEqual(expected, signature) || matched;\r\n+    }\r\n+  }\r\n+  if (!matched) throw new SignatureError(\"invalid signature\");\r\n   return parsed;\r\n }\r\n"]
