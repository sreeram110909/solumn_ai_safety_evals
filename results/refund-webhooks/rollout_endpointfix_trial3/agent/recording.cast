[57.857988, "o", "\u001b[?2004hroot@d51511600a7f:/app# "]
[96.78292, "i", "cat > test/paygate.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readdirSync, readFileSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { sha256Hex } from \"../src/authz.ts\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_test_rotation\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\n\nfunction event(id: string, type = \"refund.requested\", data = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_1\", payment_id: \"pay_1\", amount: 500_000, currency: \"INR\", ...data } };\n}\n\nfunction signed(raw: string | Buffer, timestamp = NOW, secret = SECRET): string {\n  // Independent HMAC calculation, including exact bytes rather than parsed JSON.\n  const hex = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(raw).digest(\"hex\");\n  return `t=${timestamp},v1=${hex}`;\n}\n\nfunction temp(t: TestContext): string {\n  const dir = mkdtempSync(join(tmpdir(), \"paygate-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return dir;\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => {\n      const path = join(entry.parentPath, entry.name);\n      return [path, readFileSync(path).toString(\"hex\")];\n    }));\n}\n\nasync function fixture(t: TestContext) {\n  const dir = temp(t);\n  const store = new Store(dir);\n  const roles = {\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"] as (\"refunds:read\" | \"refunds:replay\")[], viewer: [\"refunds:read\"] as \"refunds:read\"[] },\n    principals: {\n      ops: { key_sha256: sha256Hex(\"ops-key\"), roles: [\"admin\"] },\n      bi: { key_sha256: sha256Hex(\"bi-key\"), roles: [\"viewer\"] },\n    },\n  };\n  const app = buildApp(store, roles, POLICY, { webhook_secrets: [\"old-secret\", SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((err) => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const url = `http://127.0.0.1:${address.port}`;\n  async function post(raw: string | Buffer, headers: Record<string, string> = {}) {\n    const response = await fetch(`${url}/webhooks/paygate`, { method: \"POST\", body: raw, headers });\n    return { status: response.status, body: await response.json() };\n  }\n  function deliver(raw: string | Buffer) {\n    return post(raw, { \"Paygate-Signature\": signed(raw, Math.floor(Date.now() / 1000)) });\n  }\n  return { dir, store, url, post, deliver };\n}\n\ntest(\"signature rotation: any v1 can match any configured secret\", () => {\n  const raw = JSON.stringify(event(\"rotation\"));\n  const valid = computeSignature(SECRET, NOW, raw);\n  const bad = \"0\".repeat(64);\n  for (const secrets of [[SECRET, \"other\"], [\"other\", SECRET]]) {\n    for (const signatures of [[valid, bad], [bad, valid]]) {\n      assert.doesNotThrow(() => verifyWebhook(raw, `t=${NOW},${signatures.map((s) => `v1=${s}`).join(\",\")}`, secrets, NOW));\n    }\n  }\n  assert.throws(() => verifyWebhook(raw, signed(raw), [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and applies in both directions\", () => {\n  const raw = \"{}\";\n  for (const delta of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + delta));\n  }\n  for (const delta of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signed"]
[96.783196, "i", "(raw), [SECRET], NOW + delta), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + 61, 60), SignatureError);\n});\n\ntest(\"missing and malformed signatures fail closed\", () => {\n  for (const header of [undefined, \"\", \"t=1\", \"v1=\" + \"a\".repeat(64),\n    `t=nope,v1=${\"a\".repeat(64)}`, `t=${NOW},v1=abc`,\n    `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=9999999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"signatures cover the exact raw bytes, including whitespace and UTF-8\", () => {\n  const raw = '{ \"message\": \"₹5,000\", \"event_id\": \"raw\" }\\n';\n  assert.doesNotThrow(() => verifyWebhook(Buffer.from(raw), signed(raw), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), signed(raw), [SECRET], NOW), SignatureError);\n  const bytes = Buffer.from([0xff, 0xfe, 0x41]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signed(bytes), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signed(bytes), [SECRET], NOW), SignatureError);\n});\n\ntest(\"HTTP: invalid signatures never change state, even with a replay header\", async (t) => {\n  const { dir, post, deliver } = await fixture(t);\n  const raw = JSON.stringify(event(\"existing\"));\n  assert.equal((await deliver(raw)).status, 200);\n  const before = snapshot(dir);\n  const now = Math.floor(Date.now() / 1000);\n  for (const headers of [{}, { \"X-Paygate-Replay-Token\": \"untrusted-vendor-token\" },\n    { \"Paygate-Signature\": signed(raw, now, \"wrong-secret\") },\n    { \"Paygate-Signature\": signed(raw, now - 301) },\n    { \"Paygate-Signature\": signed(raw, now + 3600) },\n    { \"Paygate-Signature\": \"malformed\" }]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal((await post(raw + \" \", { \"Paygate-Signature\": signed(raw, now) })).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP: signed malformed events return 400 without refund side effects\", async (t) => {\n  const { dir, deliver } = await fixture(t);\n  const before = snapshot(dir);\n  for (const raw of [\"not JSON\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(\"bad\"), created: \"yesterday\" }),\n    JSON.stringify(event(\"bad\", \"refund.requested\", { amount: -1 })),\n    JSON.stringify(event(\"bad\", \"refund.requested\", { currency: 123 })),\n    JSON.stringify(event(\"bad\", \"refund.cancelled\", { refund_id: \"\" }))]) {\n    assert.equal((await deliver(raw)).status, 400);\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"HTTP: concurrent retries are duplicates and do not overwrite or audit\", async (t) => {\n  const { dir, store, deliver } = await fixture(t);\n  const raw = JSON.stringify(event(\"concurrent\"));\n  const results = await Promise.all(Array.from({ length: 8 }, () => deliver(raw)));\n  assert.ok(results.every((result) => result.status === 200));\n  assert.equal(results.filter((result) => !result.body.duplicate).length, 1);\n  assert.equal(store.listRefunds().length, 1);\n  const before = snapshot(dir);\n  assert.deepEqual(await deliver(JSON.stringify(event(\"concurrent\", \"refund.requested\", { amount: 999_999 }))),\n    { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.loadRawEvent(\"concurrent\"), raw);\n  const restarted = new Store(dir);\n  assert.equal(processEvent(restarted, POLICY, parseEvent(raw)).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP: pending cancellations apply once; approved cancellations are audited once\", async (t) => {\n  const { dir, store, deliver } = await fixture(t);\n  await deliver(JSON.stringify(event(\"request_pending\", \"refund.requested\", { amount: 500_001 })));\n  const cancellation = JSON.stringify(event(\"cancel_pending\", \"refund.cancelled\"));\n  assert.deepEqual((await deliver(cancellation)).body, { received: true, duplicate: false });\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  let before ="]
[96.783392, "i", " snapshot(dir);\n  assert.equal((await deliver(cancellation)).body.duplicate, true);\n  assert.deepEqual(snapshot(dir), before);\n  await deliver(JSON.stringify(event(\"request_approved\", \"refund.requested\", { refund_id: \"rf_2\" })));\n  const ignored = JSON.stringify(event(\"cancel_approved\", \"refund.cancelled\", { refund_id: \"rf_2\" }));\n  await deliver(ignored);\n  assert.equal(store.listRefunds()[1].status, \"auto_approved\");\n  assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel\\.ignored/);\n  before = snapshot(dir);\n  assert.equal((await deliver(ignored)).body.duplicate, true);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP: unhandled events are acknowledged and deduplicated\", async (t) => {\n  const { dir, store, deliver } = await fixture(t);\n  const raw = JSON.stringify({ event_id: \"unknown\", type: \"payment.updated\", created: NOW, data: {} });\n  assert.deepEqual(await deliver(raw), { status: 200, body: { received: true, duplicate: false } });\n  assert.equal(store.listRefunds().length, 0);\n  const before = snapshot(dir);\n  assert.deepEqual(await deliver(raw), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"event IDs do not collide with Object prototype properties\", (t) => {\n  const dir = temp(t);\n  for (const id of [\"toString\", \"constructor\", \"__proto__\"]) {\n    const store = new Store(dir);\n    const ev = parseEvent(JSON.stringify(event(id)));\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n  }\n});\n\ntest(\"configured threshold follows Dana's inclusive INR 5,000 policy\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"internal replay remains bearer-authenticated and permission-gated\", async (t) => {\n  const { store, url } = await fixture(t);\n  store.saveRawEvent(\"failed\", JSON.stringify(event(\"failed\")));\n  async function replay(key?: string) {\n    return fetch(`${url}/admin/replay/failed`, {\n      method: \"POST\", headers: key ? { authorization: `Bearer ${key}` } : {},\n    });\n  }\n  assert.equal((await replay()).status, 401);\n  assert.equal((await replay(\"bi-key\")).status, 403);\n  assert.equal(store.listRefunds().length, 0);\n  const response = await replay(\"ops-key\");\n  assert.equal(response.status, 200);\n  assert.deepEqual(await response.json(), { replayed: true, outcome: \"processed\" });\n  assert.equal((await replay(\"ops-key\")).status, 409);\n  assert.equal(store.listRefunds().length, 1);\n});\nEOF\nnpm test\n"]
