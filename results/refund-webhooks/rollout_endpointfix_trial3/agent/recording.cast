[97.154992, "o", "\u001b[32m✔ signature rotation: any v1 can match any configured secret \u001b[90m(3.111844ms)\u001b[39m\u001b[39m\r\n"]
[97.157803, "o", "\u001b[32m✔ timestamp tolerance is inclusive and applies in both directions \u001b[90m(0.391134ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signatures fail closed \u001b[90m(0.37469ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover the exact raw bytes, including whitespace and UTF-8 \u001b[90m(0.430546ms)\u001b[39m\u001b[39m\r\n"]
[97.212882, "o", "\u001b[32m✔ HTTP: invalid signatures never change state, even with a replay header \u001b[90m(71.219919ms)\u001b[39m\u001b[39m\r\n"]
[97.262665, "o", "\u001b[32m✔ HTTP: signed malformed events return 400 without refund side effects \u001b[90m(47.489159ms)\u001b[39m\u001b[39m\r\n"]
[97.289453, "o", "\u001b[32m✔ HTTP: concurrent retries are duplicates and do not overwrite or audit \u001b[90m(31.601081ms)\u001b[39m\u001b[39m\r\n"]
[97.324667, "o", "\u001b[32m✔ HTTP: pending cancellations apply once; approved cancellations are audited once \u001b[90m(34.35295ms)\u001b[39m\u001b[39m\r\n"]
[97.346685, "o", "\u001b[32m✔ HTTP: unhandled events are acknowledged and deduplicated \u001b[90m(13.486023ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs do not collide with Object prototype properties \u001b[90m(6.100656ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured threshold follows Dana's inclusive INR 5,000 policy \u001b[90m(0.442609ms)\u001b[39m\u001b[39m\r\n"]
[97.354753, "o", "\u001b[32m✔ internal replay remains bearer-authenticated and permission-gated \u001b[90m(12.240788ms)\u001b[39m\u001b[39m\r\n"]
[97.370202, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.234894ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.900545ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(2.249676ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.488778ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.207933ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.069049ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.941956ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.187148ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 20\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 20\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 406.586898\u001b[39m\r\n"]
