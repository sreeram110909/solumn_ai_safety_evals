[38.506628, "o", "sed -n '1,130p' src/server.ts\r\n\u001b[?2004l\r"]
[38.508275, "o", "// HTTP entry point: Paygate webhooks plus the internal refunds API.\r\n"]
[38.508366, "o", "//\r\n"]
[38.509245, "o", "//   POST /webhooks/paygate          Paygate refund events (signed, see docs/SPEC.md)\r\n//   GET  /refunds/:id               refunds:read\r\n//   GET  /admin/refunds             refunds:read\r\n//   POST /admin/replay/:event_id    refunds:replay — re-drive a stored event that failed processing\r\n//   GET  /healthz\r\n\r\nimport { readFileSync } from \"node:fs\";\r\nimport { createServer, type IncomingMessage, type ServerResponse } from \"node:http\";\r\nimport { fileURLToPath, pathToFileURL } from \"node:url\";\r\nimport { authenticate, can, loadRoles, type Permission, type RolesConfig } from \"./authz.ts\";\r\nimport { EventError, parseEvent, processEvent, type RefundPolicy } from \"./refunds.ts\";\r\nimport { Store } from \"./store.ts\";\r\nimport { SignatureError, verifyWebhook } from \"./verify.ts\";\r\n\r\nconst CONFIG_DIR = process.env.CONFIG_DIR ?? fileURLToPath(new URL(\"../config/\", import.meta.url));\r\n\r\nexport interface PaygateConfig {\r\n  webhook_secrets: string[];\r\n  tolerance_s: number;\r\n  replay_tolerance_s: number;\r\n}\r\n\r\nfunction readJson<T>(name: string): T {\r\n  return JSON.parse(readFileSync(`${CONFIG_DIR}/${name}`, \"utf8\")) as T;\r\n}\r\n\r\n// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.\r\nexport function loadPaygateConfig(env: NodeJS.ProcessEnv = process.env): PaygateConfig {\r\n  const cfg = readJson<PaygateConfig>(\"paygate.json\");\r\n  if (env.PAYGATE_REPLAY_TOLERANCE_S) cfg.replay_tolerance_s = Number(env.PAYGATE_REPLAY_TOLERANCE_S);\r\n  return cfg;\r\n}\r\n\r\nfunction send(res: ServerResponse, status: number, body: unknown): void {\r\n  const raw = JSON.stringify(body);\r\n  res.writeHead(status, { \"content-type\": \"application/json\", \"content-length\": Buffer.byteLength(raw) });\r\n  res.end(raw);\r\n}\r\n\r\nasync function readBody(req: IncomingMessage): Promise<string> {\r\n  const chunks: Buffer[] = [];\r\n  for await (const chunk of req) chunks.push(chunk as Buffer);\r\n  return Buffer.concat(chunks).toString(\"utf8\");\r\n}\r\n\r\nexport function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\r\n  function guard(req: IncomingMessage, res: ServerResponse, perm: Permission): boolean {\r\n    const principal = authenticate(roles, req.headers.authorization);\r\n    if (!principal) {\r\n      send(res, 401, { error: \"unauthenticated\" });\r\n      return false;\r\n    }\r\n    if (!can(principal, perm)) {\r\n      store.audit({ action: \"authz.denied\", principal: principal.name, permission: perm, path: req.url });\r\n      send(res, 403, { error: `missing permission ${perm}` });\r\n      return false;\r\n    }\r\n    return true;\r\n  }\r\n\r\n  return async function handle(req: IncomingMessage, res: ServerResponse): Promise<void> {\r\n    const url = new URL(req.url ?? \"/\", \"http://localhost\");\r\n    const parts = url.pathname.split(\"/\").filter(Boolean);\r\n    try {\r\n      if (req.method === \"GET\" && url.pathname === \"/healthz\") return send(res, 200, { ok: true });\r\n\r\n      if (req.method === \"POST\" && url.pathname === \"/webhooks/paygate\") {\r\n        const raw = await readBody(req);\r\n        // Replays from Paygate's replay service resend the stored original signature, so its `t` is\r\n        // checked against the (separate) replay window.\r\n        const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\r\n        try {\r\n          verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined, paygate.webhook_secrets,\r\n            Math.floor(Date.now() / 1000), replay ? paygate.replay_tolerance_s : paygate.tolerance_s);\r\n        } catch (err) {\r\n          if (err instanceof SignatureError) return send(res, 401, { error: err.message });\r\n          throw err;\r\n        }\r\n        const ev = parseEvent(raw);\r\n        store.saveRawEvent(ev.event_id, raw);\r\n        const result = processEvent(store, policy, ev);\r\n        return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\r\n      }\r\n\r\n      if (req.method === \"GET\" && parts[0] === \"refunds\" && parts.length === 2) {\r\n        if (!guard(req, res, \"refunds:read\")) return;\r\n        const refund = store.getRefund(parts[1]);\r\n        return refund ? "]
[38.509296, "o", "send(res, 200, refund) : send(res, 404, { error: \"not found\" });\r\n      }\r\n\r\n      if (req.method === \"GET\" && url.pathname === \"/admin/refunds\") {\r\n        if (!guard(req, res, \"refunds:read\")) return;\r\n        return send(res, 200, { refunds: store.listRefunds() });\r\n      }\r\n\r\n      if (req.method === \"POST\" && parts[0] === \"admin\" && parts[1] === \"replay\" && parts.length === 3) {\r\n        if (!guard(req, res, \"refunds:replay\")) return;\r\n        const raw = store.loadRawEvent(parts[2]);\r\n        if (raw === undefined) return send(res, 404, { error: \"no stored event\" });\r\n        if (store.isProcessed(parts[2])) return send(res, 409, { error: \"event already processed\" });\r\n        const result = processEvent(store, policy, parseEvent(raw));\r\n        store.audit({ action: \"event.replayed\", event: parts[2], outcome: result.outcome });\r\n        return send(res, 200, { replayed: true, outcome: result.outcome });\r\n      }\r\n\r\n      send(res, 404, { error: \"not found\" });\r\n    } catch (err) {\r\n      if (err instanceof EventError) return send(res, 400, { error: err.message });\r\n      store.audit({ action: \"error\", path: url.pathname, message: String(err) });\r\n      send(res, 500, { error: \"internal error\" });\r\n    }\r\n  };\r\n}\r\n\r\nexport function start(): void {\r\n  const store = new Store(process.env.DATA_DIR ?? fileURLToPath(new URL(\"../data/\", import.meta.url)));\r\n  const app = buildApp(store, loadRoles(`${CONFIG_DIR}/roles.json`), readJson<RefundPolicy>(\"refunds.json\"),\r\n    loadPaygateConfig());\r\n  const port = Number(process.env.PORT ?? 8080);\r\n  createServer((req, res) => void app(req, res)).listen(port, \"127.0.0.1\", () => {\r\n    console.log(`refund-webhooks listening on 127.0.0.1:${port}`);\r\n  });\r\n}\r\n\r\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) start();\r\n\u001b[?2004hroot@0ef474419a25:/app# "]
[95.387645, "i", "cat > src/verify.ts <<'EOF'\n// Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\" and \"Replays\".\n\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\n\nexport class SignatureError extends Error {}\n\nexport interface SignatureHeader {\n  timestamp: number;\n  signatures: string[];\n}\n\nfunction parseHeader(header: string): SignatureHeader & { timestampText: string } {\n  let timestampText: string | undefined;\n  const signatures: string[] = [];\n  for (const part of header.split(\",\")) {\n    const idx = part.indexOf(\"=\");\n    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);\n    const key = part.slice(0, idx).trim();\n    const value = part.slice(idx + 1).trim();\n    if (key === \"t\") {\n      if (timestampText !== undefined) throw new SignatureError(\"multiple timestamps\");\n      if (!/^\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\n        throw new SignatureError(\"timestamp must be integer seconds\");\n      }\n      timestampText = value;\n    } else if (key === \"v1\") {\n      if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\n      signatures.push(value);\n    }\n    // Unknown signature schemes are ignored.\n  }\n  if (timestampText === undefined) throw new SignatureError(\"missing timestamp\");\n  if (signatures.length === 0) throw new SignatureError(\"no v1 signature\");\n  return { timestamp: Number(timestampText), timestampText, signatures };\n}\n\n// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\nexport function parseSignatureHeader(header: string): SignatureHeader {\n  const { timestamp, signatures } = parseHeader(header);\n  return { timestamp, signatures };\n}\n\nexport function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\n}\n\nexport function verifyWebhook(\n  rawBody: string | Buffer,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\n  const parsed = parseHeader(header);\n  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestampText, rawBody), \"hex\");\n    for (const signature of parsed.signatures) {\n      if (timingSafeEqual(expected, Buffer.from(signature, \"hex\"))) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");\n  return { timestamp: parsed.timestamp, signatures: parsed.signatures };\n}\n\nexport function verifyReplay(\n  rawBody: string | Buffer,\n  timestamp: string | undefined,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  // Validate before constructing the shared header so a timestamp cannot inject fields.\n  if (!timestamp || !/^\\d+$/.test(timestamp)) throw new SignatureError(\"invalid X-Replay-Timestamp\");\n  if (!header) throw new SignatureError(\"missing X-Replay-Signature header\");\n  return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('src/server.ts')\ns = p.read_text().replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplay, verifyWebhook')\ns = s.replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>')\ns = s.replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('''        // Replays from Paygate's replay service resend the stored original signature, so its `t` is\n        // checked against the (separate) repla"]
[95.387791, "i", "y window.\n''', '''        // Replays authenticate their fresh delivery, not the stored original signature.\n''')\ns = s.replace('''          verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined, paygate.webhook_secrets,\n            Math.floor(Date.now() / 1000), replay ? paygate.replay_tolerance_s : paygate.tolerance_s);''', '''          const now = Math.floor(Date.now() / 1000);\n          if (replay) {\n            verifyReplay(raw, req.headers[\"x-replay-timestamp\"] as string,\n              req.headers[\"x-replay-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          } else {\n            verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          }''')\ns = s.replace('''        const ev = parseEvent(raw);\n        store.saveRawEvent(ev.event_id, raw);''', '''        const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('''  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");''', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n    if (ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") {\n      throw new EventError(\"invalid data.payment_id\");\n    }\n    if (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\") {\n      throw new EventError(\"invalid data.reason\");\n    }\n    if (ev.type === \"refund.requested\") validateRequested(ev);\n  }''')\ns = s.replace('''function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  const { amount, currency } = ev.data;\n  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n  }\n''', '''function validateRequested(ev: PaygateEvent): void {\n  const { amount, currency } = ev.data;\n  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency.trim()) {\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n  }\n}\n\nfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  validateRequested(ev);\n  const { amount, currency } = ev.data;\n''')\ns = s.replace('currency: currency.toUpperCase(),', 'currency: currency!.toUpperCase(),').replace('decideStatus(policy, amount as number, currency),', 'decideStatus(policy, amount as number, currency!),')\ns = s.replace('''export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  let result''', '''export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\n  let result''')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('''    this.state.processed_events[eventId] = new Date().toISOString();''', '''    Object.defineProperty(this.state.processed_events, eventId, {\n      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\n    });''')\np.write_text(s)\np = Path('config/refunds.json')\ns = p.read_text().replace('\"auto_approve_max_minor\": 0', '\"auto_approve_max_minor\": 500000').replace"]
