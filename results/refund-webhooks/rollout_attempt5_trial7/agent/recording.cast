[177.844903, "o", "\u001b[1G\u001b[0K"]
[178.080642, "o", "\u001b[32m✔ HMAC covers exact bytes and supports any signature/secret pairing \u001b[90m(2.316667ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ normal and replay timestamps have symmetric inclusive tolerance boundaries \u001b[90m(0.693043ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed, missing and ambiguous signature headers fail closed \u001b[90m(0.477149ms)\u001b[39m\u001b[39m\r\n"]
[178.154624, "o", "\u001b[32m✔ HTTP rejects unauthenticated deliveries without changing any state \u001b[90m(86.7049ms)\u001b[39m\u001b[39m\r\n"]
[178.183507, "o", "\u001b[32m✔ HTTP returns 400 for signed invalid events without committing them \u001b[90m(30.506739ms)\u001b[39m\u001b[39m\r\n"]
[178.199566, "o", "\u001b[32m✔ replays authenticate independently and duplicates leave all files unchanged \u001b[90m(13.849916ms)\u001b[39m\u001b[39m\r\n"]
[178.214886, "o", "\u001b[32m✔ concurrent retries process one event only \u001b[90m(17.647218ms)\u001b[39m\u001b[39m\r\n"]
[178.245073, "o", "\u001b[32m✔ ignored types and cancellation audits are idempotent \u001b[90m(15.602844ms)\u001b[39m\u001b[39m\r\n"]
[178.245294, "o", "\u001b[32m✔ event IDs that match object properties are handled and persist correctly \u001b[90m(14.870208ms)\u001b[39m\u001b[39m\r\n"]
[178.245528, "o", "\u001b[32m✔ configured policy implements Dana's inclusive INR 5,000 threshold \u001b[90m(0.697267ms)\u001b[39m\u001b[39m\r\n"]
[178.260835, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.185049ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.746995ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.45843ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.24363ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.221034ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.812186ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.717649ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.158617ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(31.19412ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 366.845975\u001b[39m\r\n"]
