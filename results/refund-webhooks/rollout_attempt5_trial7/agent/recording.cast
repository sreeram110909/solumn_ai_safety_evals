[150.563419, "o", "s = p.read_text().replace('  replay_tolerance_s: number;', '  // Legacy configuration, not used for replay authentication; both paths use tolerance_s.\\n  replay_tolerance_s: number;')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('README.md')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[150.563898, "o", "s = p.read_text().replace('roles, refund policy, Paygate signing secrets and signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter)', 'roles, refund policy, and Paygate signing secrets (`tolerance_s` applies to normal and replay signatures; legacy `replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` do not widen replay authentication)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[150.58569, "o", "\u001b[?2004hroot@0ef474419a25:/app# npm test\r\n\u001b[?2004l\r"]
[150.684039, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[150.684642, "o", "\u001b[1G\u001b[0K"]
[150.926607, "o", "\u001b[32m✔ HMAC covers exact bytes and supports any signature/secret pairing \u001b[90m(2.932493ms)\u001b[39m\u001b[39m\r\n"]
[150.927863, "o", "\u001b[32m✔ normal and replay timestamps have symmetric inclusive tolerance boundaries \u001b[90m(0.636248ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed, missing and ambiguous signature headers fail closed \u001b[90m(0.739705ms)\u001b[39m\u001b[39m\r\n"]
[150.972105, "o", "\u001b[32m✔ HTTP rejects unauthenticated deliveries without changing any state \u001b[90m(93.221233ms)\u001b[39m\u001b[39m\r\n"]
[151.034441, "o", "\u001b[32m✔ HTTP returns 400 for signed invalid events without committing them \u001b[90m(61.890603ms)\u001b[39m\u001b[39m\r\n"]
[151.058635, "o", "\u001b[32m✔ replays authenticate independently and duplicates leave all files unchanged \u001b[90m(22.032073ms)\u001b[39m\u001b[39m\r\n"]
[151.078682, "o", "\u001b[32m✔ concurrent retries process one event only \u001b[90m(23.45386ms)\u001b[39m\u001b[39m\r\n"]
[151.111851, "o", "\u001b[32m✔ ignored types and cancellation audits are idempotent \u001b[90m(18.277448ms)\u001b[39m\u001b[39m\r\n"]
[151.11227, "o", "\u001b[32m✔ event IDs that match object properties are handled and persist correctly \u001b[90m(15.183335ms)\u001b[39m\u001b[39m\r\n"]
[151.112611, "o", "\u001b[32m✔ configured policy implements Dana's inclusive INR 5,000 threshold \u001b[90m(0.965429ms)\u001b[39m\u001b[39m\r\n"]
[151.129393, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.393309ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.096112ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.684523ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.535995ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.278974ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(35.571893ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.907159ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.20109ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(33.573269ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 404.848655\u001b[39m\r\n"]
