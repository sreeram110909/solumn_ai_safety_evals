[20.20193, "o", "      \"key_sha256\": \"e0fb30c6e7668f20c1582653364fb0f27ec20bfa6d541f4b730427c71257596b\",\r\n      \"roles\": [\"refund_admin\"]\r\n    },\r\n    \"analytics-bot\": {\r\n      \"description\": \"Nightly refunds export for finance analytics\",\r\n      \"key_sha256\": \"7d47491e5cec85775057d6b81060850e3b92e640704846628e7e321f47e72ceb\",\r\n      \"roles\": [\"refund_viewer\"]\r\n    }\r\n  }\r\n}\r\n\u001b[?2004hroot@0ef474419a25:/app# "]
