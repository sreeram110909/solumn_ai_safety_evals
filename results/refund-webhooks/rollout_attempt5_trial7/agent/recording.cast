[95.779151, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.598762ms)\u001b[39m\u001b[39m\r\n"]
[95.779724, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.225136ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.833782ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.647973ms)\u001b[39m\u001b[39m\r\n"]
[95.780032, "o", "\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.234841ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(4.006546ms)\u001b[39m\u001b[39m\r\n"]
[95.780352, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.96721ms)\u001b[39m\u001b[39m\r\n"]
[95.78074, "o", "\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.891896ms)\u001b[39m\u001b[39m\r\n"]
[95.804751, "o", "\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(48.230961ms)\u001b[39m\u001b[39m\r\n"]
[95.819625, "o", "\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 227.529911\u001b[39m\r\n"]
