[150.513517, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer, type Server } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_pay381_test\";\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\nconst ev = (id: string, type = \"refund.requested\", data = {}) => ({\n  event_id: id, type, created: NOW,\n  data: { refund_id: \"rf_1\", payment_id: \"pay_1\", amount: 500000, currency: \"INR\", ...data },\n});\n// Independent signing implementation to avoid testing the verifier against itself.\nconst mac = (body: string | Buffer, timestamp: number, secret = SECRET) =>\n  createHmac(\"sha256\", secret).update(`${timestamp}.`).update(body).digest(\"hex\");\nconst signature = (body: string | Buffer, timestamp = Math.floor(Date.now() / 1000)) =>\n  `t=${timestamp},v1=${mac(body, timestamp)}`;\n\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter(entry => entry.isFile())\n    .map(entry => {\n      const path = join(entry.parentPath, entry.name);\n      return [path.slice(dir.length), readFileSync(path, \"utf8\")];\n    }));\n}\n\nasync function withApp(run: (ctx: {\n  dir: string; store: Store;\n  post: (body: string, headers?: Record<string, string>) => Promise<Response>;\n}) => Promise<void>) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  let server: Server | undefined;\n  try {\n    const store = new Store(dir);\n    const app = buildApp(store, { roles: {}, principals: {} }, POLICY, {\n      webhook_secrets: [\"retired-secret\", SECRET], tolerance_s: 300,\n      // A legacy setting must not widen the replay authentication window.\n      replay_tolerance_s: 86400,\n    });\n    server = createServer((req, res) => void app(req, res));\n    await new Promise<void>(resolve => server!.listen(0, \"127.0.0.1\", resolve));\n    const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\n    await run({ dir, store, post: (body, headers = {}) => fetch(url, {\n      method: \"POST\", headers: { \"content-type\": \"application/json\", ...headers }, body,\n    }) });\n  } finally {\n    if (server?.listening) await new Promise<void>((resolve, reject) => server!.close(err => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  }\n}\n\ntest(\"HMAC covers exact bytes and supports any signature/secret pairing\", () => {\n  const body = Buffer.from(' { \"message\": \"₹5,000\", \"amount\": 500000 }\\n');\n  assert.equal(computeSignature(SECRET, NOW, body), mac(body, NOW));\n  const header = `t=${NOW},v1=${mac(body, NOW, \"other\")},v1=${mac(body, NOW)}`;\n  assert.doesNotThrow(() => verifyWebhook(body, header, [\"old\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(body, header, [SECRET, \"old\"], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body.toString())), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(Buffer.concat([body, Buffer.from(\" \")]), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);\n});\n\ntest(\"normal and replay timestamps have symmetric inclusive tolerance boundaries\", () => {\n  const body = JSON.stringify(ev(\"evt_time\"));\n  for (const offset of [-301, -300, 0, 300, 301]) {\n    const ts = NOW + offset;\n    const check = () => verifyWebhook(body, signature(body, ts), [SECRET], NOW);\n    const replay = () => verifyReplay(body, String(ts), `v1=${mac(body, ts)}`, [SECRET], NOW);\n    if (Math.abs(offset) <= 300) {"]
[150.513686, "i", "\n      assert.doesNotThrow(check);\n      assert.doesNotThrow(replay);\n    } else {\n      assert.throws(check, SignatureError);\n      assert.throws(replay, SignatureError);\n    }\n  }\n});\n\ntest(\"malformed, missing and ambiguous signature headers fail closed\", () => {\n  const body = \"{}\";\n  for (const header of [undefined, \"\", `t=${NOW}`, `v1=${mac(body, NOW)}`,\n    `t=no,v1=${mac(body, NOW)}`, `t=${NOW},t=${NOW},v1=${mac(body, NOW)}`,\n    `t=99999999999999999999,v1=${mac(body, NOW)}`, `t=${NOW},v1=ab`,\n    `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW},v1=${\"z\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyReplay(body, `${NOW},v1=${mac(body, NOW)}`, \"v1=bad\", [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyReplay(body, String(NOW), `t=${NOW},v1=${mac(body, NOW)}`, [SECRET], NOW), SignatureError);\n});\n\ntest(\"HTTP rejects unauthenticated deliveries without changing any state\", async () => {\n  await withApp(async ({ dir, post }) => {\n    const before = snapshot(dir);\n    const body = JSON.stringify(ev(\"evt_rejected\"));\n    const now = Math.floor(Date.now() / 1000);\n    const valid = signature(body, now);\n    const headersToReject = [\n      {},\n      { \"paygate-signature\": `t=${now},v1=${mac(body, now, \"wrong\")}` },\n      { \"paygate-signature\": signature(body, now - 3600) },\n      { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now) },\n      { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${\"0\".repeat(64)}` },\n      { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now - 3600), \"x-replay-signature\": `v1=${mac(body, now - 3600)}` },\n      { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now + 3600), \"x-replay-signature\": `v1=${mac(body, now + 3600)}` },\n      { \"paygate-signature\": valid, \"x-replay-timestamp\": \"\", \"x-replay-signature\": `v1=${mac(body, now)}` },\n    ];\n    for (const headers of headersToReject) {\n      const response = await post(body, headers);\n      assert.equal(response.status, 401, JSON.stringify(headers));\n      await response.json();\n      assert.deepEqual(snapshot(dir), before);\n    }\n    const response = await post(body + \" \", { \"paygate-signature\": valid });\n    assert.equal(response.status, 401);\n    await response.json();\n    assert.deepEqual(snapshot(dir), before);\n  });\n});\n\ntest(\"HTTP returns 400 for signed invalid events without committing them\", async () => {\n  await withApp(async ({ dir, post }) => {\n    const before = snapshot(dir);\n    for (const body of [\"not json\", \"null\", \"{}\", JSON.stringify(ev(\"\", \"refund.requested\")),\n      JSON.stringify({ ...ev(\"evt_invalid\"), created: \"bad\" }),\n      JSON.stringify(ev(\"evt_invalid\", \"refund.requested\", { amount: -1 })),\n      JSON.stringify(ev(\"evt_invalid\", \"refund.requested\", { amount: 1.5 })),\n      JSON.stringify(ev(\"evt_invalid\", \"refund.requested\", { currency: null })),\n      JSON.stringify(ev(\"evt_invalid\", \"refund.cancelled\", { refund_id: null }))]) {\n      const response = await post(body, { \"paygate-signature\": signature(body) });\n      assert.equal(response.status, 400, body);\n      await response.json();\n      assert.deepEqual(snapshot(dir), before);\n    }\n  });\n});\n\ntest(\"replays authenticate independently and duplicates leave all files unchanged\", async () => {\n  await withApp(async ({ dir, store, post }) => {\n    const body = JSON.stringify(ev(\"evt_replay\"), null, 2) + \"\\n\";\n    const now = Math.floor(Date.now() / 1000);\n    const replayHeaders = {\n      \"paygate-signature\": \"not even a valid original signature\",\n      \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${mac(body, now)}`,\n    };\n    const first = await post(body, replayHeaders);\n    assert.equal(first.status, 200);\n    assert.deepEqual(await first.json(), { received: true, duplicate: false });\n    const before = snapshot(dir);\n    for (const headers of [replayHeaders, { \"paygate-signature\": signature(body) }]) {\n      const second = await post(body, headers);\n      assert.equal(second.status,"]
[150.514024, "o", "cat > test/pay381.test.ts <<'EOF'\r\n\u001b[?2004l\r      assert.doesNotThrow(check);"]
[150.514137, "i", " 200);\n      assert.deepEqual(await second.json(), { received: true, duplicate: true });\n      assert.deepEqual(snapshot(dir), before);\n    }\n    // Even a newly signed, changed payload with this ID cannot overwrite the original.\n    const changed = JSON.stringify(ev(\"evt_replay\", \"refund.requested\", { amount: 1 }));\n    assert.deepEqual(await (await post(changed, { \"paygate-signature\": signature(changed) })).json(),\n      { received: true, duplicate: true });\n    assert.deepEqual(snapshot(dir), before);\n    assert.equal(store.listRefunds().length, 1);\n    const restarted = new Store(dir);\n    assert.equal(processEvent(restarted, POLICY, parseEvent(body)).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  });\n});\n\ntest(\"concurrent retries process one event only\", async () => {\n  await withApp(async ({ store, post }) => {\n    const body = JSON.stringify(ev(\"evt_concurrent\"));\n    const results = await Promise.all(Array.from({ length: 8 }, async () => {\n      const response = await post(body, { \"paygate-signature\": signature(body) });\n      assert.equal(response.status, 200);\n      return response.json();\n    }));\n    assert.equal(results.filter(result => !result.duplicate).length, 1);\n    assert.equal(store.listRefunds().length, 1);\n  });\n});\n\ntest(\"ignored types and cancellation audits are idempotent\", async () => {\n  await withApp(async ({ dir, store, post }) => {\n    const deliver = async (body: string) => {\n      const response = await post(body, { \"paygate-signature\": signature(body) });\n      assert.equal(response.status, 200);\n      return response.json();\n    };\n    const ignored = JSON.stringify({ event_id: \"evt_ignored\", type: \"payment.updated\", created: NOW });\n    assert.equal((await deliver(ignored)).duplicate, false);\n    let before = snapshot(dir);\n    assert.equal((await deliver(ignored)).duplicate, true);\n    assert.deepEqual(snapshot(dir), before);\n    await deliver(JSON.stringify(ev(\"evt_requested\")));\n    const cancellation = JSON.stringify(ev(\"evt_cancel\", \"refund.cancelled\"));\n    assert.equal((await deliver(cancellation)).duplicate, false);\n    assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n    assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel.ignored/);\n    before = snapshot(dir);\n    assert.equal((await deliver(cancellation)).duplicate, true);\n    assert.deepEqual(snapshot(dir), before);\n  });\n});\n\ntest(\"event IDs that match object properties are handled and persist correctly\", async () => {\n  await withApp(async ({ dir, store }) => {\n    for (const id of [\"toString\", \"constructor\", \"__proto__\"]) {\n      assert.equal(processEvent(store, POLICY, parseEvent(JSON.stringify(ev(id)))).outcome, \"processed\");\n      assert.equal(processEvent(new Store(dir), POLICY, parseEvent(JSON.stringify(ev(id)))).outcome, \"duplicate\");\n    }\n    assert.equal(store.listRefunds().length, 3);\n  });\n});\n\ntest(\"configured policy implements Dana's inclusive INR 5,000 threshold\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('src/server.ts')\ns = p.read_text().replace('  replay_tolerance_s: number;', '  // Legacy configuration, not used for replay authentication; both paths use tolerance_s.\\n  replay_tolerance_s: number;')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('roles, refund policy, Paygate signing secrets and signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter)', 'roles, refund policy, and Paygate signing secrets (`tolerance_s` applies to normal and replay signatures; legacy `replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` do not widen "]
