[20.19809, "o", "{\r\n  \"webhook_secrets\": [\r\n    \"whsec_pg_live_2024Q4_c7d1e9a24b\"\r\n  ],\r\n  \"tolerance_s\": 300,\r\n"]
[20.19826, "o", "  \"replay_tolerance_s\": 300\r\n}\r\n"]
