\"data\": {\"refund_id\": \"rf_bk008\", \"payment_id\": \"pay_bk008\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk009\", \"type\": \"refund.requested\", \"created\": 1763543133, \"data\": {\"refund_id\": \"rf_bk009\", \"payment_id\": \"pay_bk009\", \"amount\": 250000, \"currency\": \"USD\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk010\", \"type\": \"refund.requested\", \"created\": 1763543170, \"data\": {\"refund_id\": \"rf_bk010\", \"payment_id\": \"pay_bk010\", \"amount\": 15000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk011\", \"type\": \"refund.requested\", \"created\": 1763543207, \"data\": {\"refund_id\": \"rf_bk011\", \"payment_id\": \"pay_bk011\", \"amount\": 4999, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk012\", \"type\": \"refund.requested\", \"created\": 1763543244, \"data\": {\"refund_id\": \"rf_bk012\", \"payment_id\": \"pay_bk012\", \"amount\": 1200, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk013\", \"type\": \"refund.requested\", \"created\": 1763543281, \"data\": {\"refund_id\": \"rf_bk013\", \"payment_id\": \"pay_bk013\", \"amount\": 620000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk014\", \"type\": \"refund.requested\", \"created\": 1763543318, \"data\": {\"refund_id\": \"rf_bk014\", \"payment_id\": \"pay_bk014\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk015\", \"type\": \"refund.requested\", \"created\": 1763543355, \"data\": {\"refund_id\": \"rf_bk015\", \"payment_id\": \"pay_bk015\", \"amount\": 15000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk016\", \"type\": \"refund.requested\", \"created\": 1763543392, \"data\": {\"refund_id\": \"rf_bk016\", \"payment_id\": \"pay_bk016\", \"amount\": 1200, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk017\", \"type\": \"refund.requested\", \"created\": 1763543429, \"data\": {\"refund_id\": \"rf_bk017\", \"payment_id\": \"pay_bk017\", \"amount\": 4999, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk018\", \"type\": \"refund.requested\", \"created\": 1763543466, \"data\": {\"refund_id\": \"rf_bk018\", \"payment_id\": \"pay_bk018\", \"amount\": 1200, \"currency\": \"USD\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk019\", \"type\": \"refund.requested\", \"created\": 1763543503, \"data\": {\"refund_id\": \"rf_bk019\", \"payment_id\": \"pay_bk019\", \"amount\": 1200, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_"]
