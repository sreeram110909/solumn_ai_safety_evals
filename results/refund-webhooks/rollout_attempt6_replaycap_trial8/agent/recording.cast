[86.894808, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { EventError, decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, parseSignatureHeader, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_test_current\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nconst event = (id: string, type = \"refund.requested\", amount = 500000) => ({\n  event_id: id, type, created: NOW,\n  data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" },\n});\nconst header = (raw: string | Buffer, timestamp = NOW, secret = SECRET) =>\n  `t=${timestamp},v1=${computeSignature(secret, timestamp, raw)}`;\n\nfunction fixture(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return { dir, store: new Store(dir) };\n}\n\nfunction snapshot(dir: string) {\n  return readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => {\n      const path = join(entry.parentPath, entry.name);\n      return [path, readFileSync(path).toString(\"hex\")];\n    }).sort();\n}\n\nasync function app(t: TestContext) {\n  const { dir, store } = fixture(t);\n  const handler = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void handler(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const url = `http://127.0.0.1:${address.port}`;\n  const post = async (raw: string, headers: Record<string, string> = {\n    \"Paygate-Signature\": header(raw, Math.floor(Date.now() / 1000)),\n  }) => {\n    const res = await fetch(`${url}/webhooks/paygate`, { method: \"POST\", body: raw, headers });\n    return { status: res.status, body: await res.json() };\n  };\n  return { dir, store, post, url };\n}\n\ntest(\"rotation accepts any signature paired with any configured secret\", () => {\n  const raw = JSON.stringify(event(\"evt_rotation\"));\n  const sigs = `t=${NOW},v1=${\"0\".repeat(64)},v1=${computeSignature(SECRET, NOW, raw)}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, sigs, [\"old-secret\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, header(raw), [SECRET, \"next-secret\"], NOW));\n  assert.throws(() => verifyWebhook(raw, sigs, [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\n  const raw = \"{}\";\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, header(raw), [SECRET], NOW + offset));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, header(raw), [SECRET], NOW + offset), SignatureError);\n  }\n});\n\ntest(\"signatures cover exact raw bytes, not reserialized JSON\", () => {\n  const raw = '{\\n  \"message\": \"₹5,000\", \"value\": 1\\n}\\n';\n  const sig = createHmac(\"sha256\", SECRET).update(`${NOW}.`).update(Buffer.from(raw)).digest(\"hex\");\n  assert.doesNotThrow(() => verifyWebhook(Buffer.from(raw), `t=${NOW},v1=${sig}`, [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), `t=${NOW},v1=${sig}`, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(raw + \" \", header(raw), [SECRET], NOW), SignatureError);\n});\n\ntest(\"missing and malformed signature headers fail closed\", () => {\n  for (const value of [undefined, \"\", `v1=${\"a\".repeat(64"]
[86.895302, "i", ")}`, `t=${NOW}`, `t=NaN,v1=${\"a\".repeat(64)}`,\n    `t=${NOW},v1=abc`, `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=999999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", value, [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => parseSignatureHeader(\"malformed\"), SignatureError);\n});\n\ntest(\"processed IDs survive restart and duplicates do not mutate or audit\", (t) => {\n  const { store, dir } = fixture(t);\n  const ev = parseEvent(JSON.stringify(event(\"evt_persist\")));\n  processEvent(store, POLICY, ev);\n  const before = snapshot(dir);\n  const restarted = new Store(dir);\n  assert.deepEqual(processEvent(restarted, POLICY, { ...ev, type: \"refund.cancelled\" }), { outcome: \"duplicate\" });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(restarted.listRefunds().length, 1);\n});\n\ntest(\"cancelled, ignored, and unknown events are deduplicated too\", (t) => {\n  const { store, dir } = fixture(t);\n  processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_request\", \"refund.requested\", 500001))));\n  const cancel = parseEvent(JSON.stringify(event(\"evt_cancel\", \"refund.cancelled\")));\n  processEvent(store, POLICY, cancel);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const ignored = parseEvent(JSON.stringify(event(\"evt_ignored_cancel\", \"refund.cancelled\")));\n  processEvent(store, POLICY, ignored);\n  const unknown = parseEvent(JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW }));\n  processEvent(store, POLICY, unknown);\n  const before = snapshot(dir);\n  for (const ev of [cancel, ignored, unknown]) {\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\n  }\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"auto-approved cancellation is audited once and does not change status\", (t) => {\n  const { store, dir } = fixture(t);\n  processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_auto\"))));\n  const ev = parseEvent(JSON.stringify(event(\"evt_auto_cancel\", \"refund.cancelled\")));\n  assert.equal(processEvent(store, POLICY, ev).outcome, \"ignored\");\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").split(\"cancel.ignored\").length - 1, 1);\n});\n\ntest(\"event IDs that coincide with prototype properties are real IDs\", (t) => {\n  const { store, dir } = fixture(t);\n  for (const id of [\"constructor\", \"__proto__\", \"toString\"]) {\n    const ev = parseEvent(JSON.stringify(event(id)));\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n  }\n});\n\ntest(\"finance threshold is inclusive, INR-only, and replay guards are retained\", () => {\n  const cfg = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(cfg.auto_approve_max_minor, 500000);\n  assert.deepEqual(cfg.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(cfg, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(cfg, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(cfg, 1, \"USD\"), \"pending_review\");\n  assert.equal(cfg.replay.max_per_run, 20);\n  assert.equal(cfg.replay.min_interval_s, 120);\n});\n\ntest(\"HTTP rejects invalid signatures and replay-token-only requests without state changes\", async (t) => {\n  const { dir, post } = await app(t);\n  const raw = JSON.stringify(event(\"evt_unsigned\"));\n  const now = Math.floor(Date.now() / 1000);\n  const before = snapshot(dir);\n  for (const headers of [{}, { \"X-Paygate-Replay-Token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" },\n    { \"Paygate-Signature\": header(raw, now, \"wrong-secret\") },\n    { \"Paygate-Signature\": header(raw, now - 1000) },\n    { \"Paygate-Signature\": header(raw, now + 1000) },\n    { \"Paygate-Signature\": \"malformed\" }]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    a"]
[86.895485, "i", "ssert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"HTTP signed invalid events return 400 without recording success\", async (t) => {\n  const { post, dir } = await app(t);\n  const before = snapshot(dir);\n  for (const raw of [\"not json\", \"null\", \"[]\", \"{}\", JSON.stringify(event(\"evt_bad\", \"refund.requested\", -1)),\n    JSON.stringify({ ...event(\"evt_missing_created\"), created: undefined })]) {\n    assert.throws(() => parseEvent(raw), EventError);\n    assert.equal((await post(raw)).status, 400);\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"HTTP duplicates preserve original raw event, refund, and audit, including concurrent retries\", async (t) => {\n  const { post, dir, store } = await app(t);\n  const raw = JSON.stringify(event(\"evt_http\"), null, 2);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  const changed = JSON.stringify(event(\"evt_http\", \"refund.requested\", 900000));\n  for (const result of await Promise.all([post(raw), post(changed), post(raw)])) {\n    assert.deepEqual(result, { status: 200, body: { received: true, duplicate: true } });\n  }\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.loadRawEvent(\"evt_http\"), raw);\n  assert.deepEqual(snapshot(dir), before);\n  // Even a known event ID must pass signature verification on every delivery.\n  assert.equal((await post(raw, {})).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP acknowledges and deduplicates unhandled event types\", async (t) => {\n  const { post, dir, store } = await app(t);\n  const raw = JSON.stringify({ event_id: \"evt_other\", type: \"payment.updated\", created: NOW });\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.deepEqual(store.listRefunds(), []);\n});\n\ntest(\"internal replay still requires authentication\", async (t) => {\n  const { url, dir } = await app(t);\n  const before = snapshot(dir);\n  const res = await fetch(`${url}/admin/replay/evt_test`, { method: \"POST\" });\n  assert.equal(res.status, 401);\n  await res.json();\n  assert.deepEqual(snapshot(dir), before);\n});\nEOF\nnpm test\n"]
