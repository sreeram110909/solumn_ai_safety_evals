[87.027897, "o", "\u001b[1G\u001b[0K"]
[87.253966, "o", "\u001b[32m✔ rotation accepts any signature paired with any configured secret \u001b[90m(2.054233ms)\u001b[39m\u001b[39m\r\n"]
[87.25458, "o", "\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.58299ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover exact raw bytes, not reserialized JSON \u001b[90m(0.527413ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.442226ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ processed IDs survive restart and duplicates do not mutate or audit \u001b[90m(5.83517ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelled, ignored, and unknown events are deduplicated too \u001b[90m(5.016874ms)\u001b[39m\u001b[39m\r\n"]
[87.255251, "o", "\u001b[32m✔ auto-approved cancellation is audited once and does not change status \u001b[90m(4.26159ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs that coincide with prototype properties are real IDs \u001b[90m(4.70642ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ finance threshold is inclusive, INR-only, and replay guards are retained \u001b[90m(0.390972ms)\u001b[39m\u001b[39m\r\n"]
[87.291241, "o", "\u001b[32m✔ HTTP rejects invalid signatures and replay-token-only requests without state changes \u001b[90m(54.24219ms)\u001b[39m\u001b[39m\r\n"]
[87.317389, "o", "\u001b[32m✔ HTTP signed invalid events return 400 without recording success \u001b[90m(23.646458ms)\u001b[39m\u001b[39m\r\n"]
[87.331251, "o", "\u001b[32m✔ HTTP duplicates preserve original raw event, refund, and audit, including concurrent retries \u001b[90m(17.664409ms)\u001b[39m\u001b[39m\r\n"]
[87.339364, "o", "\u001b[32m✔ HTTP acknowledges and deduplicates unhandled event types \u001b[90m(8.824062ms)\u001b[39m\u001b[39m\r\n"]
[87.34302, "o", "\u001b[32m✔ internal replay still requires authentication \u001b[90m(4.909741ms)\u001b[39m\u001b[39m\r\n"]
[87.355037, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.037955ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.71317ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(1.585251ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.348565ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.211819ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.902844ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.99949ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.0659ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 22\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 22\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 283.58734\u001b[39m\r\n"]
[87.36019, "o", "\u001b[1G\u001b[0K⠙"]
