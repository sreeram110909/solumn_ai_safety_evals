[86.912748, "o", "  const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const restarted = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(processEvent(restarted, POLICY, { ...ev, type: \"refund.cancelled\" }), { outcome: \"duplicate\" });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(restarted.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"cancelled, ignored, and unknown events are deduplicated too\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { store, dir } = fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_request\", \"refund.requested\", 500001))));\r\n\u001b[?2004l\r\u001b[?2004h>   const cancel = parseEvent(JSON.stringify(event(\"evt_cancel\", \"refund.cancelled\")));\r\n\u001b[?2004l\r\u001b[?2004h>   processEvent(store, POLICY, cancel);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds()[0].status, \"cancelled\");\r\n\u001b[?2004l\r\u001b[?2004h>   const ignored = parseEvent(JSON.stringify(event(\"evt_ignored_cancel\", \"refund.cancelled\")));\r\n\u001b[?2004l\r\u001b[?2004h>   processEvent(store, POLICY, ignored);\r\n\u001b[?2004l\r\u001b[?2004h>   const unknown = parseEvent(JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW }));\r\n\u001b[?2004l\r\u001b[?2004h>   processEvent(store, POLICY, unknown);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const ev of [cancel, ignored, unknown]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2