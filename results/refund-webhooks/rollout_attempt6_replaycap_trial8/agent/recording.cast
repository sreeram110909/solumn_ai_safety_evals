[86.916885, "o", "    { \"Paygate-Signature\": \"malformed\" }]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.916983, "o", "    assert.equal((await post(raw, headers)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[86.917049, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
