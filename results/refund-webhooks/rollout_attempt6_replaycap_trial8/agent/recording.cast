[86.914978, "o", "\u001b[?2004h> "]
[86.915132, "o", "  const cfg = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h"]
