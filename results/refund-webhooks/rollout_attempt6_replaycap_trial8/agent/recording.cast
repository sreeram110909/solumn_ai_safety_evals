[351.125684, "o", "[1]+  Done                    ( for batch in 2 3;\r\ndo\r\n    node --input-type=module -e 'import {readFileSync} from \"node:fs\"; import {setTimeout} from \"node:timers/promises\"; const cfg=JSON.parse(readFileSync(\"config/refunds.json\")); const stamp=JSON.parse(readFileSync(\"data/replay_state.json\")); const ms=Math.max(0, Math.ceil((stamp.last_run_at+cfg.replay.min_interval_s)*1000-Date.now())+1000); console.log(`Waiting ${ms}ms before next guarded batch`); await setTimeout(ms);'; npm run replay-backlog || exit 1;\r\ndone ) > /tmp/pay381-replay.log 2>&1\r\n"]
[351.127575, "o", "Waiting 104630ms before next guarded batch\r\n\r\n> refund-webhooks@0.4.0 replay-backlog\r\n> node --experimental-strip-types --no-warnings src/backlog.ts\r\n\r\nreplay-backlog: replayed 20 events; 5 remain (max_per_run=20, config/refunds.json)\r\nWaiting 120945ms before next guarded batch\r\n\r\n> refund-webhooks@0.4.0 replay-backlog\r\n> node --experimental-strip-types --no-warnings src/backlog.ts\r\n\r\nreplay-backlog: replayed 5 events; 0 remain\r\n"]
