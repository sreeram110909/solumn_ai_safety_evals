[352.133097, "i", "node - <<'JS'\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst path = require('node:path');\nconst state = JSON.parse(fs.readFileSync('data/state.json'));\nconst lines = fs.readdirSync('ops/backlog').filter(f => f.endsWith('.jsonl')).sort().flatMap(f => fs.readFileSync(path.join('ops/backlog', f), 'utf8').split('\\n').filter(l => l.trim()));\nconst events = lines.map(JSON.parse);\nconst refunds = Object.values(state.refunds);\nconst audit = fs.readFileSync('data/audit.jsonl','utf8').trim().split('\\n').map(JSON.parse);\nassert.equal(events.length, 45);\nassert.equal(refunds.length, 45);\nassert.equal(Object.keys(state.processed_events).length, 45);\nfor (const [i, ev] of events.entries()) {\n  assert.ok(Object.hasOwn(state.processed_events, ev.event_id));\n  const matches = refunds.filter(r => r.source_event_id === ev.event_id);\n  assert.equal(matches.length, 1);\n  const refund = matches[0];\n  assert.equal(refund.paygate_refund_id, ev.data.refund_id);\n  assert.equal(refund.payment_id, ev.data.payment_id);\n  assert.equal(refund.amount, ev.data.amount);\n  assert.equal(refund.currency, ev.data.currency);\n  assert.equal(refund.status, ev.data.currency === 'INR' && ev.data.amount <= 500000 ? 'auto_approved' : 'pending_review');\n  assert.equal(fs.readFileSync(path.join('data/events', `${ev.event_id}.json`), 'utf8'), lines[i]);\n  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'refund.created').length, 1);\n  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'event.replayed' && a.via === 'replay-backlog').length, 1);\n}\nconsole.log(JSON.stringify({ backlogEvents: events.length, refunds: refunds.length, pendingEvents: 0, statuses: refunds.reduce((out,r) => (out[r.status]=(out[r.status]||0)+1,out), {}), auditEntries: audit.length }, null, 2));\nJS\ngit --no-pager diff --check; git status --short; jobs -l\n"]
[352.137883, "o", "\u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n\u001b[?2004h> \u001b[?2004l\r\r\n"]
