[86.916709, "o", "    { \"Paygate-Signature\": header(raw, now, \"wrong-secret\") },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": header(raw, now - 1000) },\r\n\u001b[?2004l\r\u001b[?2004h> "]
