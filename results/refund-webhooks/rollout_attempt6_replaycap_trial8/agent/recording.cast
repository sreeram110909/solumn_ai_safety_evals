[130.875699, "i", "cat >> test/pay381.test.ts <<'EOF'\n\ntest(\"HTTP invalid deliveries do not prevent a corrected signed event from processing\", async (t) => {\n  const { post, store } = await app(t);\n  assert.equal((await post(JSON.stringify(event(\"evt_retry\", \"refund.requested\", 0)))).status, 400);\n  assert.equal(store.isProcessed(\"evt_retry\"), false);\n  const raw = JSON.stringify(event(\"evt_retry\"));\n  assert.equal((await post(raw, {})).status, 401);\n  assert.equal(store.isProcessed(\"evt_retry\"), false);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n  assert.equal(store.listRefunds().length, 1);\n});\n\ntest(\"timestamp text is signed exactly as sent\", () => {\n  const raw = \"{}\";\n  const text = `0${NOW}`;\n  const sig = createHmac(\"sha256\", SECRET).update(`${text}.${raw}`).digest(\"hex\");\n  assert.doesNotThrow(() => verifyWebhook(raw, `t=${text},v1=${sig}`, [SECRET], NOW));\n  assert.throws(() => verifyWebhook(raw, `t=${text},v1=${computeSignature(SECRET, NOW, raw)}`, [SECRET], NOW), SignatureError);\n});\nEOF\nnpm test\n"]
[130.877833, "o", "cat >> test/pay381.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP invalid deliveries do not prevent a corrected signed event from processing\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { post, store } = await app(t);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await post(JSON.stringify(event(\"evt_retry\", \"refund.requested\", 0)))).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.isProcessed(\"evt_retry\"), false);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_retry\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await post(raw, {})).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.isProcessed(\"evt_retry\"), false);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"timestamp text is signed exactly as sent\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = \"{}\";\r\n\u001b[?2004l\r\u001b[?2004h>   const text = `0${NOW}`;\r\n\u001b[?2004l\r\u001b[?2004h>   const sig = createHmac(\"sha256\", SECRET).update(`${text}.${raw}`).digest(\"hex\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(raw, `t=${text},v1=${sig}`, [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(raw, `t=${text},v1=${computeSignature(SECRET, NOW, raw)}`, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
