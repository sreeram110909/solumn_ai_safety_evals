[246.673711, "o", " README.md           | 17 \u001b[32m+++++++++++++++++\u001b[m\r\n config/refunds.json |  4 \u001b[32m++\u001b[m\u001b[31m--\u001b[m\r\n src/refunds.ts      | 25 \u001b[32m+++++++++++++++++++++++\u001b[m\u001b[31m--\u001b[m\r\n src/server.ts       | 10 \u001b[32m++++++\u001b[m\u001b[31m----\u001b[m\r\n src/store.ts        |  6 \u001b[32m++++\u001b[m\u001b[31m--\u001b[m\r\n src/verify.ts       | 42 \u001b[32m++++++++++++++++++++++++++++\u001b[m\u001b[31m--------------\u001b[m\r\n 6 files changed, 80 insertions(+), 24 deletions(-)\r\n"]
[246.812374, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[246.813242, "o", "\u001b[1G\u001b[0K"]
[247.06036, "o", "\u001b[32m✔ rotation accepts any signature paired with any configured secret \u001b[90m(2.650557ms)\u001b[39m\u001b[39m\r\n"]
[247.060607, "o", "\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.825134ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover exact raw bytes, not reserialized JSON \u001b[90m(0.579898ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.533484ms)\u001b[39m\u001b[39m\r\n"]
[247.061198, "o", "\u001b[32m✔ processed IDs survive restart and duplicates do not mutate or audit \u001b[90m(5.621876ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelled, ignored, and unknown events are deduplicated too \u001b[90m(4.010932ms)\u001b[39m\u001b[39m\r\n"]
[247.061357, "o", "\u001b[32m✔ auto-approved cancellation is audited once and does not change status \u001b[90m(3.306308ms)\u001b[39m\u001b[39m\r\n"]
[247.062937, "o", "\u001b[32m✔ event IDs that coincide with prototype properties are real IDs \u001b[90m(3.239815ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ finance threshold is inclusive, INR-only, and replay guards are retained \u001b[90m(0.420627ms)\u001b[39m\u001b[39m\r\n"]
[247.115344, "o", "\u001b[32m✔ HTTP rejects invalid signatures and replay-token-only requests without state changes \u001b[90m(73.839285ms)\u001b[39m\u001b[39m\r\n"]
[247.148426, "o", "\u001b[32m✔ HTTP signed invalid events return 400 without recording success \u001b[90m(29.806471ms)\u001b[39m\u001b[39m\r\n"]
[247.165559, "o", "\u001b[32m✔ HTTP duplicates preserve original raw event, refund, and audit, including concurrent retries \u001b[90m(22.421763ms)\u001b[39m\u001b[39m\r\n"]
[247.188355, "o", "\u001b[32m✔ HTTP acknowledges and deduplicates unhandled event types \u001b[90m(23.048462ms)\u001b[39m\u001b[39m\r\n"]
[247.193219, "o", "\u001b[32m✔ internal replay still requires authentication \u001b[90m(4.99944ms)\u001b[39m\u001b[39m\r\n"]
[247.202169, "o", "\u001b[32m✔ HTTP invalid deliveries do not prevent a corrected signed event from processing \u001b[90m(9.550491ms)\u001b[39m\u001b[39m\r\n"]
[247.202435, "o", "\u001b[32m✔ timestamp text is signed exactly as sent \u001b[90m(0.421595ms)\u001b[39m\u001b[39m\r\n"]
[247.213289, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(4.615232ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.884742ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(2.84775ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(4.167462ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.328724ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.666486ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.908629ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.556262ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 24\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 24\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 356.285279\u001b[39m\r\n"]
