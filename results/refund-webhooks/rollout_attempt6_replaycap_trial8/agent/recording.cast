[23.801919, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.136668ms)\u001b[39m\u001b[39m\r\n"]
[23.80239, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.815134ms)\u001b[39m\u001b[39m\r\n"]
[23.802878, "o", "\u001b[31m✖ rejects a body signed with the wrong secret \u001b[90m(0.77696ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ rejects a stale timestamp \u001b[90m(1.450271ms)\u001b[39m\u001b[39m\r\n"]
[23.803234, "o", "\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.304248ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.532158ms)\u001b[39m\u001b[39m\r\n"]
[23.803823, "o", "\u001b[31m✖ a redelivered event creates only one refund \u001b[90m(2.479598ms)\u001b[39m\u001b[39m\r\n"]
