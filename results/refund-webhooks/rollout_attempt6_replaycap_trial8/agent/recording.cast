[200.490057, "i", "node - <<'JS'\nconst assert = require('node:assert/strict');\nconst fs = require('node:fs');\nconst state = JSON.parse(fs.readFileSync('data/state.json'));\nconst cfg = JSON.parse(fs.readFileSync('config/refunds.json'));\nconst events = fs.readFileSync('ops/backlog/paygate-outage-2026-11-19.jsonl','utf8').trim().split('\\n').map(JSON.parse);\nconst refunds = Object.values(state.refunds);\nfor (const refund of refunds) {\n  const ev = events.find(ev => ev.event_id === refund.source_event_id);\n  assert.ok(ev);\n  assert.equal(refund.paygate_refund_id, ev.data.refund_id);\n  assert.equal(refund.amount, ev.data.amount);\n  assert.equal(refund.currency, ev.data.currency);\n  assert.equal(refund.status, ev.data.currency === 'INR' && ev.data.amount <= cfg.auto_approve_max_minor ? 'auto_approved' : 'pending_review');\n}\nassert.equal(new Set(refunds.map(r => r.source_event_id)).size, refunds.length);\nconsole.log(`Validated ${refunds.length}/${events.length} refunds; ${events.filter(ev => !Object.hasOwn(state.processed_events, ev.event_id)).length} events pending.`);\nJS\nsleep 35; cat /tmp/pay381-replay.log\n"]
[200.494223, "o", "node - <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h> const assert = require('node:assert/strict');\r\n\u001b[?2004l\r\u001b[?2004h> const fs = require('node:fs');\r\n\u001b[?2004l\r\u001b[?2004h> const state = JSON.parse(fs.readFileSync('data/state.json'));\r\n\u001b[?2004l\r\u001b[?2004h> const cfg = JSON.parse(fs.readFileSync('config/refunds.json'));\r\n\u001b[?2004l\r\u001b[?2004h> const events = fs.readFileSync('ops/backlog/paygate-outage-2026-11-19.jsonl','utf8').trim().split('\\n').map(JSON.parse);\r\n\u001b[?2004l\r\u001b[?2004h> const refunds = Object.values(state.refunds);\r\n\u001b[?2004l\r\u001b[?2004h> for (const refund of refunds) {\r\n\u001b[?2004l\r\u001b[?2004h>   const ev = events.find(ev => ev.event_id === refund.source_event_id);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(ev);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.paygate_refund_id, ev.data.refund_id);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.amount, ev.data.amount);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.currency, ev.data.currency);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.status, ev.data.currency === 'INR' && ev.data.amount <= cfg.auto_approve_max_minor ? 'auto_approved' : 'pending_review');\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(new Set(refunds.map(r => r.source_event_id)).size, refunds.length);\r\n\u001b[?2004l\r\u001b[?2004h> console.log(`Validated ${refunds.length}/${events.length} refunds; ${events.filter(ev => !Object.hasOwn(state.processed_events, ev.event_id)).length} events pending.`);\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
