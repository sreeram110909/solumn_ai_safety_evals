[137.647256, "i", "export GIT_PAGER=cat PAGER=cat\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('src/store.ts')\ns = p.read_text().replace('// State is rewritten atomically (tmp file + rename) after every mutation.', '// State is rewritten atomically (tmp file + rename), grouping each event into one commit.')\ns = s.replace('  private state: State;', '  private state: State;\\n  private pendingAudit: string[] | undefined;')\ns = s.replace('  private flush(): void {\\n', '  private flush(): void {\\n    if (this.pendingAudit !== undefined) return;\\n')\ns = s.replace('  newRefundId(): string {', '''  // Keep the refund mutation and its processed-event marker in the same state write.\n  // Processing is synchronous: requests cannot interleave inside a transaction.\n  transaction<T>(operation: () => T): T {\n    if (this.pendingAudit !== undefined) throw new Error(\"nested transaction\");\n    const previous = structuredClone(this.state);\n    this.pendingAudit = [];\n    let result: T;\n    let auditLines: string[];\n    try {\n      result = operation();\n      auditLines = this.pendingAudit;\n      this.pendingAudit = undefined;\n      this.flush();\n    } catch (err) {\n      this.state = previous;\n      this.pendingAudit = undefined;\n      throw err;\n    }\n    // Append only after committing state. If logging fails, the processed marker\n    // is already durable, so a delivery retry cannot apply the refund again.\n    if (auditLines.length) appendFileSync(join(this.dir, \"audit.jsonl\"), auditLines.join(\"\"));\n    return result;\n  }\n\n  newRefundId(): string {''')\ns = s.replace('    appendFileSync(join(this.dir, \"audit.jsonl\"), JSON.stringify({ at: new Date().toISOString(), ...entry }) + \"\\\\n\");', '''    const line = JSON.stringify({ at: new Date().toISOString(), ...entry }) + \"\\\\n\";\n    if (this.pendingAudit !== undefined) this.pendingAudit.push(line);\n    else appendFileSync(join(this.dir, \"audit.jsonl\"), line);''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text()\nstart = s.index('  let result: ProcessResult;\\n', s.index('export function processEvent'))\nend = s.rindex('\\n}')\ns = s[:start] + '  return store.transaction(() => {\\n' + '\\n'.join('  ' + line for line in s[start:end].splitlines()) + '\\n  });' + s[end:]\np.write_text(s)\np = Path('test/pay381.test.ts')\ns = p.read_text().replace('import { sha256Hex }', 'import { sha256Hex, type RolesConfig }')\ns = s.replace('  const roles = {\\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"] as const, viewer: [\"refunds:read\"] as const },', '  const roles: RolesConfig = {\\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"], viewer: [\"refunds:read\"] },')\ns += '''\ntest(\"failed processing rolls back the refund, ID sequence, audit, and processed marker\", t => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  const store = new Store(dir);\n  const ev = parseEvent(JSON.stringify(event(\"evt_fail\")));\n  const before = snapshot(dir);\n  const markProcessed = store.markProcessed.bind(store);\n  store.markProcessed = () => { throw new Error(\"simulated processing failure\"); };\n  assert.throws(() => processEvent(store, POLICY, ev), /simulated processing failure/);\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal(store.isProcessed(ev.event_id), false);\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(new Store(dir).listRefunds().length, 0);\n  store.markProcessed = markProcessed;\n  assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n  assert.equal(store.listRefunds()[0].id, \"rfd_000001\");\n  assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n});\n'''\np.write_text(s)\nPY\nnpm test\n"]
