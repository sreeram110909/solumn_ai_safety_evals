[88.342037, "o", "> });\r\n"]
[88.342304, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.342442, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.342813, "o", "test(\"rotation accepts any signature against any configured secret\", () => {\r\n"]
[88.343082, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.343473, "o", "  const raw = JSON.stringify(event(\"evt_rotation\"));\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.343628, "o", "> "]
[88.343891, "o", "  for (const secret of [\"old-secret\", SECRET]) {\r\n"]
[88.344058, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.344472, "o", "    for (const signatures of [\r\n"]
[88.344725, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.345171, "o", "      `v1=${\"0\".repeat(64)},v1=${computeSignature(secret, NOW, raw)}`,\r\n"]
[88.345303, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.34559, "o", "      `v1=${computeSignature(secret, NOW, raw)},v1=${\"0\".repeat(64)}`,\r\n"]
[88.345684, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.34577, "o", "    ]) {\r\n\u001b[?2004l\r"]
[88.34591, "o", "\u001b[?2004h"]
[88.346021, "o", "> "]
[88.346441, "o", "      assert.doesNotThrow(() => verifyWebhook(raw, `t=${NOW},${signatures}`, [\"old-secret\", SECRET], NOW));\r\n"]
[88.346557, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.346657, "o", "    }\r\n\u001b[?2004l\r"]
[88.346804, "o", "\u001b[?2004h> "]
[88.346848, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.346968, "o", "> "]
[88.347347, "o", "  assert.throws(() => verifyWebhook(raw, sign(raw, NOW), [], NOW), SignatureError);\r\n"]
[88.347459, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.347562, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.347662, "o", "> \r\n\u001b[?2004l\r"]
[88.347772, "o", "\u001b[?2004h> "]
[88.348146, "o", "test(\"timestamp tolerance is inclusive and protects against past and future replays\", () => {\r\n"]
[88.348281, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.348437, "o", "  const raw = \"{}\";\r\n"]
[88.348564, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.348743, "o", "  for (const offset of [-300, 300]) {\r\n"]
[88.348816, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.355163, "o", "    assert.doesNotThrow(() => verifyWebhook(raw, sign(raw, NOW + offset), [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   for (const offset of [-301, 301]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.throws(() => verifyWebhook(raw, sign(raw, NOW + offset), [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyWebhook(raw, sign(raw, NOW + 2), [SECRET], NOW, 1), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"missing and malformed signature headers fail closed\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const header of [undefined, \"\", `t=${NOW}`, `v1=${\"a\".repeat(64)}`,\r\n\u001b[?2004l\r\u001b[?2004h>     `t=${NOW},v1=xyz`, `t=${NOW},v1=${\"A\".repeat(64)}`, `t=NaN,v1=${\"a\".repeat(64)}`,\r\n\u001b[?2004l\r\u001b[?2004h>     `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`, `t=${\"9\".repeat(400)},v1=${\"a\".repeat(64)}`]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"configured policy implements Dana's inclusive INR-only threshold\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(policy.auto_approve_max_minor, 500000);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 499999, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP: invalid authentication and invalid events do not write anything\", async t => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, post } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_invalid\"));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const headers of [{}, { \"Paygate-Signature\": sign(raw, undefined, \"wrong-secret\") },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": sign(raw, Math.floor(Date.now() / 1000) + 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": sign(raw, Math.floor(Date.now() / 1000) - 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"X-Paygate-Replay-Token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(raw, headers)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   for (const invalid of [\"not json\", \"null\", \"{}\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", { amount: -1 })),\r\n\u001b[?2004l\r\u001b[?2004h>     JSON.stringify(event(\"evt_invalid\", \"refund.requested\", { currency: null }))]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(invalid, { \"Paygate-Signature\": sign(invalid) })).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP: concurrent retries are write-free duplicates and cannot overwrite raw events\", async t => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, store, post } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_retry\"), null, 2) + \"\\n\";\r\n\u001b[?2004l\r\u001b[?2004h>   const headers = { \"Paygate-Signature\": sign(raw) };\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await post(raw, headers), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const changed = JSON.stringify(event(\"evt_retry\", \"refund.requested\", { amount: 900000 }));\r\n\u001b[?2004l\r\u001b[?2004h>   const responses = await Promise.all(Array.from({ length: 5 }, () => post(changed, { \"Paygate-Signature\": sign(changed) })));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const response of responses) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.de"]
[88.355642, "o", "epEqual(response, { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds()[0].amount, 500000);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.loadRawEvent(\"evt_retry\"), raw);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   const restarted = new Store(dir);"]
[88.355671, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(processEvent(restarted, POLICY, parseEvent(raw)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.355873, "o", "  assert.deepEqual(snapshot(dir), before);"]
[88.356098, "o", "\r\n\u001b[?2004l\r"]
