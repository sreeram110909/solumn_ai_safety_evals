[88.356865, "o", "\u001b[?2004h> test(\"HTTP: cancellations and ignored types are also deduplicated\", async t => {"]
[88.35695, "o", "\r\n"]
[88.357004, "o", "\u001b[?2004l\r"]
[88.357169, "o", "\u001b[?2004h"]
[88.357189, "o", ">   const { dir, store, post } = await fixture(t);"]
[88.357314, "o", "\r\n"]
[88.357406, "o", "\u001b[?2004l\r\u001b[?2004h"]
[88.357494, "o", ">   async function deliver(ev: unknown) {"]
[88.357578, "o", "\r\n"]
[88.357645, "o", "\u001b[?2004l\r\u001b[?2004h"]
[88.357717, "o", "> "]
[88.357777, "o", "    const raw = JSON.stringify(ev);"]
[88.357872, "o", "\r\n\u001b[?2004l\r"]
[88.357981, "o", "\u001b[?2004h>     return post(raw, { \"Paygate-Signature\": sign(raw) });"]
[88.358073, "o", "\r\n"]
[88.358106, "o", "\u001b[?2004l\r"]
[88.358193, "o", "\u001b[?2004h"]
[88.358243, "o", ">   }"]
[88.358357, "o", "\r\n"]
[88.358498, "o", "\u001b[?2004l\r\u001b[?2004h"]
[88.358515, "o", ">   await deliver(event(\"evt_pending\", \"refund.requested\", { amount: 500001 }));"]
[88.358616, "o", "\r\n"]
[88.358698, "o", "\u001b[?2004l\r"]
[88.358813, "o", "\u001b[?2004h> "]
[88.358986, "o", "  const cancellation = event(\"evt_cancel\", \"refund.cancelled\");"]
[88.359085, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.359309, "o", "> "]
[88.359334, "o", "  assert.equal((await deliver(cancellation)).body.duplicate, false);"]
[88.35945, "o", "\r\n"]
[88.359554, "o", "\u001b[?2004l\r"]
[88.359678, "o", "\u001b[?2004h"]
[88.359714, "o", ">   assert.equal(store.listRefunds()[0].status, \"cancelled\");"]
[88.359876, "o", "\r\n\u001b[?2004l\r"]
[88.360075, "o", "\u001b[?2004h>   let before = snapshot(dir);"]
[88.360147, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.360307, "o", "> "]
[88.360375, "o", "  assert.equal((await deliver(cancellation)).body.duplicate, true);"]
[88.360532, "o", "\r\n"]
[88.3607, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[88.360737, "o", "  assert.deepEqual(snapshot(dir), before);"]
[88.360883, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.361036, "o", "> "]
[88.36107, "o", "  await deliver(event(\"evt_auto\", \"refund.requested\", { refund_id: \"rf_auto\" }));"]
[88.361882, "o", "\r\n\u001b[?2004l\r"]
[88.362079, "o", "\u001b[?2004h>   const ignored = event(\"evt_ignore_cancel\", \"refund.cancelled\", { refund_id: \"rf_auto\" });"]
[88.362344, "o", "\r\n"]
[88.362443, "o", "\u001b[?2004l\r\u001b[?2004h>   await deliver(ignored);"]
[88.362565, "o", "\r\n\u001b[?2004l\r"]
[88.362694, "o", "\u001b[?2004h> "]
[88.362794, "o", "  assert.equal(store.listRefunds()[1].status, \"auto_approved\");"]
[88.36295, "o", "\r\n\u001b[?2004l\r"]
[88.363138, "o", "\u001b[?2004h>   assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel.ignored/);"]
[88.363288, "o", "\r\n"]
[88.363446, "o", "\u001b[?2004l\r\u001b[?2004h>   before = snapshot(dir);"]
[88.363531, "o", "\r\n\u001b[?2004l\r"]
[88.363646, "o", "\u001b[?2004h>   assert.equal((await deliver(ignored)).body.duplicate, true);"]
[88.363723, "o", "\r\n"]
[88.363789, "o", "\u001b[?2004l\r"]
[88.363901, "o", "\u001b[?2004h> "]
[88.363921, "o", "  assert.deepEqual(snapshot(dir), before);"]
[88.36591, "o", "\r\n\u001b[?2004l\r"]
[88.36598, "o", "\u001b[?2004h>   const unknown = { event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW, data: {} };\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await deliver(unknown)).status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await deliver(unknown)).body.duplicate, true);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"internal replay remains permission-protected and processes only failed events\", async t => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { base, store } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_replay\"));\r\n\u001b[?2004l\r\u001b[?2004h>   store.saveRawEvent(\"evt_replay\", raw);\r\n\u001b[?2004l\r\u001b[?2004h>   const url = `${base}/admin/replay/evt_replay`;\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await fetch(url, { method: \"POST\" })).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await fetch(url, { method: \"POST\", headers: { Authorization: \"Bearer viewer-test\" } })).status, 403);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await fetch(url, { method: \"POST\", headers: { Authorization: \"Bearer ops-test\" } })).status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.366314, "o", "  assert.equal((await fetch(url, { method: \"POST\", headers: { Authorization: \"Bearer ops-test\" } })).status, 409);"]
[88.366465, "o", "\r\n"]
[88.366569, "o", "\u001b[?2004l\r"]
[88.366701, "o", "\u001b[?2004h"]
[88.366968, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.367235, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.367576, "o", "test(\"event IDs do not accidentally match inherited object properties\", t => {"]
[88.367844, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.367994, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));"]
[88.368232, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.368509, "o", "> "]
[88.368736, "o", "  t.after(() => rmSync(dir, { recursive: true, force: true }));"]
[88.368945, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.369094, "o", "  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {"]
[88.369266, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[88.36948, "o", "    const store = new Store(dir);"]
[88.369738, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.370048, "o", "> "]
[88.37027, "o", "    const ev = parseEvent(JSON.stringify(event(id)));"]
[88.371293, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.371761, "o", "> "]
[88.372039, "o", "    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");"]
[88.372124, "o", "\r\n\u001b[?2004l\r"]
[88.372816, "o", "\u001b[?2004h"]
[88.373278, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[88.373498, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[88.403161, "o", "\u001b[?2004hroot@83dd42b878cf:/app# npm test\r\n\u001b[?2004l\r"]
[88.928416, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n\u001b[1G\u001b[0K"]
[89.570957, "o", "\u001b[32m✔ HMAC covers exact bytes, including whitespace and non-ASCII data \u001b[90m(10.906052ms)\u001b[39m\u001b[39m\r\n"]
[89.572201, "o", "\u001b[32m✔ rotation accepts any signature against any configured secret \u001b[90m(0.713009ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and protects against past and future replays \u001b[90m(0.359964ms)\u001b[39m\u001b[39m\r\n"]
[89.574639, "o", "\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.341642ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy implements Dana's inclusive INR-only threshold \u001b[90m(0.961327ms)\u001b[39m\u001b[39m\r\n"]
[89.762919, "o", "\u001b[32m✔ HTTP: invalid authentication and invalid events do not write anything \u001b[90m(249.220777ms)\u001b[39m\u001b[39m\r\n"]
[89.863567, "o", "\u001b[32m✔ HTTP: concurrent retries are write-free duplicates and cannot overwrite raw events \u001b[90m(109.386397ms)\u001b[39m\u001b[39m\r\n"]
[89.911409, "o", "\u001b[32m✔ HTTP: cancellations and ignored types are also deduplicated \u001b[90m(49.452109ms)\u001b[39m\u001b[39m\r\n"]
[89.931708, "o", "\u001b[32m✔ internal replay remains permission-protected and processes only failed events \u001b[90m(17.814409ms)\u001b[39m\u001b[39m\r\n"]
[89.935569, "o", "\u001b[32m✔ event IDs do not accidentally match inherited object properties \u001b[90m(5.107314ms)\u001b[39m\u001b[39m\r\n"]
