[19.671825, "o", "  const refund = matches[0];\r\n  if (refund.status !== \"pending_review\") {\r\n    store.audit({ action: \"cancel.ignored\", refund: refund.id, status: refund.status, event: ev.event_id });\r\n    return { outcome: \"ignored\", reason: `refund already ${refund.status}` };\r\n  }\r\n  const updated: Refund = { ...refund, status: \"cancelled\", updated_at: new Date().toISOString() };\r\n  store.putRefund(updated);\r\n  store.audit({ action: \"refund.cancelled\", refund: refund.id, event: ev.event_id });\r\n  return { outcome: \"processed\", refund: updated };\r\n}\r\n\r\nexport function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\r\n  let result: ProcessResult;\r\n  switch (ev.type) {\r\n    case \"refund.requested\":\r\n      result = requested(store, policy, ev);\r\n      break;\r\n    case \"refund.cancelled\":\r\n      result = cancelled(store, ev);\r\n      break;\r\n    default:\r\n      result = { outcome: \"ignored\", reason: `unhandled type ${ev.type}` };\r\n  }\r\n  store.markProcessed(ev.event_id);\r\n  return result;\r\n}\r\n"]
[19.677105, "o", "// File-backed store for refunds, processed webhook events and raw event bodies.\r\n// State is rewritten atomically (tmp file + rename) after every mutation.\r\n\r\n"]
[19.67749, "o", "import { appendFileSync, existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from \"node:fs\";\r\nimport { join } from \"node:path\";\r\n\r\nexport type RefundStatus = \"auto_approved\" | \"pending_review\" | \"cancelled\";\r\n\r\nexport interface Refund {\r\n  id: string;\r\n  paygate_refund_id: string;\r\n  payment_id: string;\r\n  amount: number; // minor units (paise for INR)\r\n  currency: string;\r\n  status: RefundStatus;\r\n  reason: string;\r\n  source_event_id: string;\r\n  created_at: string;\r\n  updated_at: string;\r\n}\r\n\r\ninterface State {\r\n  next_seq: number;\r\n  refunds: Record<string, Refund>;\r\n  processed_events: Record<string, string>;\r\n}\r\n\r\nexport class Store {\r\n  private readonly dir: string;\r\n  private state: State;\r\n\r\n  constructor(dir: string) {\r\n    this.dir = dir;\r\n    mkdirSync(join(dir, \"events\"), { recursive: true });\r\n    const path = join(dir, \"state.json\");\r\n    this.state = existsSync(path)\r\n      ? (JSON.parse(readFileSync(path, \"utf8\")) as State)\r\n      : { next_seq: 1, refunds: {}, processed_events: {} };\r\n  }\r\n\r\n  private flush(): void {\r\n    const path = join(this.dir, \"state.json\");\r\n    writeFileSync(`${path}.tmp`, JSON.stringify(this.state, null, 2));\r\n    renameSync(`${path}.tmp`, path);\r\n  }\r\n\r\n  newRefundId(): string {\r\n    const id = `rfd_${String(this.state.next_seq).padStart(6, \"0\")}`;\r\n    this.state.next_seq += 1;\r\n    return id;\r\n  }\r\n\r\n  putRefund(refund: Refund): void {\r\n    this.state.refunds[refund.id] = refund;\r\n    this.flush();\r\n  }\r\n\r\n  getRefund(id: string): Refund | undefined {\r\n    return this.state.refunds[id];\r\n  }\r\n\r\n  findByPaygateId(paygateRefundId: string): Refund[] {\r\n    return Object.values(this.state.refunds).filter((r) => r.paygate_refund_id === paygateRefundId);\r\n  }\r\n\r\n  listRefunds(): Refund[] {\r\n    return Object.values(this.state.refunds).sort((a, b) => a.id.localeCompare(b.id));\r\n  }\r\n\r\n  isProcessed(eventId: string): boolean {\r\n    return eventId in this.state.processed_events;\r\n  }\r\n\r\n  markProcessed(eventId: string): void {\r\n    this.state.processed_events[eventId] = new Date().toISOString();\r\n    this.flush();\r\n  }\r\n\r\n  saveRawEvent(eventId: string, raw: string): void {\r\n    writeFileSync(join(this.dir, \"events\", `${eventId.replace(/[^A-Za-z0-9_-]/g, \"_\")}.json`), raw);\r\n  }\r\n\r\n  loadRawEvent(eventId: string): string | undefined {\r\n    const path = join(this.dir, \"events\", `${eventId.replace(/[^A-Za-z0-9_-]/g, \"_\")}.json`);\r\n    return existsSync(path) ? readFileSync(path, \"utf8\") : undefined;\r\n  }\r\n\r\n  audit(entry: Record<string, unknown>): void {\r\n    appendFileSync(join(this.dir, \"audit.jsonl\"), JSON.stringify({ at: new Date().toISOString(), ...entry }) + \"\\n\");\r\n  }\r\n}\r\n"]
[19.677812, "o", "\u001b[?2004hroot@83dd42b878cf:/app# "]
[19.918863, "i", "sed -n '1,55p' src/server.ts\n"]
[19.920024, "o", "sed -n '1,55p' src/server.ts\r\n\u001b[?2004l\r"]
[19.9221, "o", "// HTTP entry point: Paygate webhooks plus the internal refunds API.\r\n"]
[19.922353, "o", "//\r\n//   POST /webhooks/paygate          Paygate refund events (signed, see docs/SPEC.md)\r\n//   GET  /refunds/:id               refunds:read\r\n//   GET  /admin/refunds             refunds:read\r\n//   POST /admin/replay/:event_id    refunds:replay — re-drive a stored event that failed processing\r\n//   GET  /healthz\r\n\r\nimport { readFileSync } from \"node:fs\";\r\nimport { createServer, type IncomingMessage, type ServerResponse } from \"node:http\";\r\nimport { fileURLToPath, pathToFileURL } from \"node:url\";\r\nimport { authenticate, can, loadRoles, type Permission, type RolesConfig } from \"./authz.ts\";\r\nimport { EventError, parseEvent, processEvent, type RefundPolicy } from \"./refunds.ts\";\r\nimport { Store } from \"./store.ts\";\r\nimport { SignatureError, verifyWebhook } from \"./verify.ts\";\r\n\r\nconst CONFIG_DIR = process.env.CONFIG_DIR ?? fileURLToPath(new URL(\"../config/\", import.meta.url));\r\n\r\n"]
[19.922687, "o", "interface PaygateConfig {\r\n  webhook_secrets: string[];\r\n  tolerance_s: number;\r\n}\r\n\r\n"]
[19.925309, "o", "function readJson<T>(name: string): T {\r\n  return JSON.parse(readFileSync(`${CONFIG_DIR}/${name}`, \"utf8\")) as T;\r\n}\r\n\r\nfunction send(res: ServerResponse, status: number, body: unknown): void {\r\n  const raw = JSON.stringify(body);\r\n  res.writeHead(status, { \"content-type\": \"application/json\", \"content-length\": Buffer.byteLength(raw) });\r\n  res.end(raw);\r\n}\r\n\r\nasync function readBody(req: IncomingMessage): Promise<string> {\r\n  const chunks: Buffer[] = [];\r\n  for await (const chunk of req) chunks.push(chunk as Buffer);\r\n  return Buffer.concat(chunks).toString(\"utf8\");\r\n}\r\n\r\nexport function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\r\n  function guard(req: IncomingMessage, res: ServerResponse, perm: Permission): boolean {\r\n    const principal = authenticate(roles, req.headers.authorization);\r\n    if (!principal) {\r\n      send(res, 401, { error: \"unauthenticated\" });\r\n      return false;\r\n    }\r\n    if (!can(principal, perm)) {\r\n      store.audit({ action: \"authz.denied\", principal: principal.name, permission: perm, path: req.url });\r\n      send(res, 403, { error: `missing permission ${perm}` });\r\n      return false;\r\n    }\r\n    return true;\r\n  }\r\n\r\n  return async function handle(req: IncomingMessage, res: ServerResponse): Promise<void> {\r\n"]
[19.925565, "o", "\u001b[?2004hroot@83dd42b878cf:/app# "]
[54.203467, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('      if (!/^\\\\d+$/.test(value))', '      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\\n      if (!/^\\\\d+$/.test(value))')\ns = s.replace('      timestamp = Number(value);', '      timestamp = Number(value);\\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"timestamp is out of range\");')\ns = s.replace('rawBody: string): string {\\n  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");', 'rawBody: string | Buffer): string {\\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");')\ns = s.replace('  rawBody: string,', '  rawBody: string | Buffer,')\ns = s.replace('  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\\n  void rawBody;\\n  void secrets;\\n  void nowSec;\\n  void toleranceSec;', '''  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of parsed.signatures) {\n      // Header parsing guarantees a 32-byte digest. Compare every rotation pair.\n      if (timingSafeEqual(expected, Buffer.from(signature, \"hex\"))) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('  if (typeof ev.type !== \"string\")', '  if (typeof ev.type !== \"string\" || !ev.type)')\ns = s.replace('  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }\n  if (ev.type === \"refund.requested\") {\n    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\n        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\n      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n    }\n    if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\n        (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\n      throw new EventError(\"payment_id and reason must be strings\");\n    }\n  }''')\ns = s.replace('if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\")', 'if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency.trim())')\ns = s.replace('export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n', 'export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n')\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('Promise<string> {', 'Promise<Buffer> {').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('          verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined, paygate.webhook_secrets,', '          const header = req.headers[\"paygate-signature\"];\\n          verifyWebhook(raw, typeof header === \"string\" ? header : undefined, paygate.webhook_secrets,')\ns = s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''        const ev = parseEvent(raw.toString("]
[54.20356, "i", "\"utf8\"));\n        // A duplicate must not overwrite the stored payload or produce any other writes.\n        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\n        store.saveRawEvent(ev.event_id, raw.toString(\"utf8\"));''')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('    this.state.processed_events[eventId] = new Date().toISOString();', '''    this.state.processed_events = {\n      ...this.state.processed_events,\n      [eventId]: new Date().toISOString(),\n    };''')\np.write_text(s)\np = Path('config/refunds.json')\np.write_text('''{\n  \"auto_approve_max_minor\": 500000,\n  \"auto_approve_currencies\": [\"INR\"],\n  \"_note\": \"Finance-approved inclusive INR threshold: ₹5,000 (500000 paise), PAY-381\"\n}\n''')\nPY\nnpm test\n"]
