[54.658409, "o", "\u001b[1G\u001b[0K"]
[54.871864, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.440097ms)\u001b[39m\u001b[39m\r\n"]
[54.872813, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.357014ms)\u001b[39m\u001b[39m\r\n"]
[54.873624, "o", "\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.832841ms)\u001b[39m\u001b[39m\r\n"]
[54.873925, "o", "\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.53918ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.447255ms)\u001b[39m\u001b[39m\r\n"]
[54.874056, "o", "\u001b[32m✔ cancelling a pending refund \u001b[90m(4.108016ms)\u001b[39m\u001b[39m\r\n"]
[54.875388, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.258238ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.595694ms)\u001b[39m\u001b[39m\r\n"]
[54.890364, "o", "\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 8\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 180.318855\u001b[39m\r\n"]
[54.896967, "o", "\u001b[1G\u001b[0K⠙"]
[54.898369, "o", "\u001b[1G\u001b[0K"]
[54.904719, "o", "\u001b[?2004hroot@83dd42b878cf:/app# "]
[88.315564, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync, statSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { sha256Hex } from \"../src/authz.ts\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_pay381_test\";\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\n\nfunction event(event_id: string, type = \"refund.requested\", data = {}) {\n  return { event_id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount: 500000, currency: \"INR\", ...data } };\n}\n\nfunction sign(raw: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, raw)}`;\n}\n\nfunction snapshot(dir: string): unknown {\n  return readdirSync(dir).sort().map((name) => {\n    const path = join(dir, name);\n    return statSync(path).isDirectory() ? [name, snapshot(path)] :\n      [name, readFileSync(path).toString(\"hex\"), statSync(path, { bigint: true }).mtimeNs];\n  });\n}\n\nasync function fixture(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const roles = {\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"] as const, viewer: [\"refunds:read\"] as const },\n    principals: {\n      ops: { key_sha256: sha256Hex(\"ops-test\"), roles: [\"admin\"] },\n      viewer: { key_sha256: sha256Hex(\"viewer-test\"), roles: [\"viewer\"] },\n    },\n  };\n  const server = createServer(buildApp(store, roles, POLICY,\n    { webhook_secrets: [\"old-secret\", SECRET], tolerance_s: 300 }));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(async () => {\n    await new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  });\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const base = `http://127.0.0.1:${address.port}`;\n  async function post(raw: string | Buffer, headers: Record<string, string> = {}) {\n    const response = await fetch(`${base}/webhooks/paygate`, { method: \"POST\", headers, body: raw });\n    return { status: response.status, body: await response.json() };\n  }\n  return { dir, store, base, post };\n}\n\ntest(\"HMAC covers exact bytes, including whitespace and non-ASCII data\", () => {\n  const raw = Buffer.from('{ \"note\": \"₹5,000\" }\\n');\n  const expected = createHmac(\"sha256\", SECRET).update(Buffer.concat([\n    Buffer.from(`${NOW}.`), raw,\n  ])).digest(\"hex\");\n  assert.equal(computeSignature(SECRET, NOW, raw), expected);\n  assert.doesNotThrow(() => verifyWebhook(raw, sign(raw, NOW), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(raw.toString().trim(), sign(raw, NOW), [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(Buffer.from([0xff]), sign(Buffer.from([0xfe]), NOW), [SECRET], NOW), SignatureError);\n});\n\ntest(\"rotation accepts any signature against any configured secret\", () => {\n  const raw = JSON.stringify(event(\"evt_rotation\"));\n  for (const secret of [\"old-secret\", SECRET]) {\n    for (const signatures of [\n      `v1=${\"0\".repeat(64)},v1=${computeSignature(secret, NOW, raw)}`,\n      `v1=${computeSignature(secret, NOW, raw)},v1=${\"0\".repeat(64)}`,\n    ]) {\n      assert.doesNotThrow(() => verifyWebhook(raw, `t=${NOW},${signatures}`, [\"old-secret\", SECRET], NOW));\n    }\n  }\n  assert.throws(() => verifyWebhook(raw, sign(raw, NOW), [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and protects against past and future replays\", () => {\n  const raw = \"{}\";\n  for (const offset of [-300, 300"]
[88.316248, "i", "]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, sign(raw, NOW + offset), [SECRET], NOW));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, sign(raw, NOW + offset), [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, sign(raw, NOW + 2), [SECRET], NOW, 1), SignatureError);\n});\n\ntest(\"missing and malformed signature headers fail closed\", () => {\n  for (const header of [undefined, \"\", `t=${NOW}`, `v1=${\"a\".repeat(64)}`,\n    `t=${NOW},v1=xyz`, `t=${NOW},v1=${\"A\".repeat(64)}`, `t=NaN,v1=${\"a\".repeat(64)}`,\n    `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`, `t=${\"9\".repeat(400)},v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"configured policy implements Dana's inclusive INR-only threshold\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 499999, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"HTTP: invalid authentication and invalid events do not write anything\", async t => {\n  const { dir, post } = await fixture(t);\n  const before = snapshot(dir);\n  const raw = JSON.stringify(event(\"evt_invalid\"));\n  for (const headers of [{}, { \"Paygate-Signature\": sign(raw, undefined, \"wrong-secret\") },\n    { \"Paygate-Signature\": sign(raw, Math.floor(Date.now() / 1000) + 3600) },\n    { \"Paygate-Signature\": sign(raw, Math.floor(Date.now() / 1000) - 3600) },\n    { \"X-Paygate-Replay-Token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  for (const invalid of [\"not json\", \"null\", \"{}\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", { amount: -1 })),\n    JSON.stringify(event(\"evt_invalid\", \"refund.requested\", { currency: null }))]) {\n    assert.equal((await post(invalid, { \"Paygate-Signature\": sign(invalid) })).status, 400);\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"HTTP: concurrent retries are write-free duplicates and cannot overwrite raw events\", async t => {\n  const { dir, store, post } = await fixture(t);\n  const raw = JSON.stringify(event(\"evt_retry\"), null, 2) + \"\\n\";\n  const headers = { \"Paygate-Signature\": sign(raw) };\n  assert.deepEqual(await post(raw, headers), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  const changed = JSON.stringify(event(\"evt_retry\", \"refund.requested\", { amount: 900000 }));\n  const responses = await Promise.all(Array.from({ length: 5 }, () => post(changed, { \"Paygate-Signature\": sign(changed) })));\n  for (const response of responses) {\n    assert.deepEqual(response, { status: 200, body: { received: true, duplicate: true } });\n  }\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.listRefunds()[0].amount, 500000);\n  assert.equal(store.loadRawEvent(\"evt_retry\"), raw);\n  assert.deepEqual(snapshot(dir), before);\n  const restarted = new Store(dir);\n  assert.equal(processEvent(restarted, POLICY, parseEvent(raw)).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal((await post(raw)).status, 401); // Even known event IDs must authenticate.\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP: cancellations and ignored types are also deduplicated\", async t => {\n  const { dir, store, post } = await fixture(t);\n  async function deliver(ev: unknown) {\n    const raw = JSON.stringify(ev);\n    return post(raw, { \"Paygate-Signature\": sign(raw) });\n  }\n  await deliver(event(\"evt_pending\", \"refund.requested\", { amount: 500001 }));\n  const cancellation = event(\"evt_cancel\", \"refund.cancelled\");\n  assert.equal((await deliver(cancellation)).body.duplicat"]
[88.316372, "i", "e, false);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  let before = snapshot(dir);\n  assert.equal((await deliver(cancellation)).body.duplicate, true);\n  assert.deepEqual(snapshot(dir), before);\n  await deliver(event(\"evt_auto\", \"refund.requested\", { refund_id: \"rf_auto\" }));\n  const ignored = event(\"evt_ignore_cancel\", \"refund.cancelled\", { refund_id: \"rf_auto\" });\n  await deliver(ignored);\n  assert.equal(store.listRefunds()[1].status, \"auto_approved\");\n  assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel.ignored/);\n  before = snapshot(dir);\n  assert.equal((await deliver(ignored)).body.duplicate, true);\n  assert.deepEqual(snapshot(dir), before);\n  const unknown = { event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW, data: {} };\n  assert.equal((await deliver(unknown)).status, 200);\n  before = snapshot(dir);\n  assert.equal((await deliver(unknown)).body.duplicate, true);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"internal replay remains permission-protected and processes only failed events\", async t => {\n  const { base, store } = await fixture(t);\n  const raw = JSON.stringify(event(\"evt_replay\"));\n  store.saveRawEvent(\"evt_replay\", raw);\n  const url = `${base}/admin/replay/evt_replay`;\n  assert.equal((await fetch(url, { method: \"POST\" })).status, 401);\n  assert.equal((await fetch(url, { method: \"POST\", headers: { Authorization: \"Bearer viewer-test\" } })).status, 403);\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal((await fetch(url, { method: \"POST\", headers: { Authorization: \"Bearer ops-test\" } })).status, 200);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal((await fetch(url, { method: \"POST\", headers: { Authorization: \"Bearer ops-test\" } })).status, 409);\n});\n\ntest(\"event IDs do not accidentally match inherited object properties\", t => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    const store = new Store(dir);\n    const ev = parseEvent(JSON.stringify(event(id)));\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n  }\n});\nEOF\nnpm test\n"]
