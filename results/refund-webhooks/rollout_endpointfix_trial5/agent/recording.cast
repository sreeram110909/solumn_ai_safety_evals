[137.829447, "o", "\u001b[1G"]
[137.829618, "o", "\u001b[0K"]
[138.065194, "o", "\u001b[32m✔ HMAC covers exact bytes, including whitespace and non-ASCII data \u001b[90m(2.641392ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rotation accepts any signature against any configured secret \u001b[90m(1.088466ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and protects against past and future replays \u001b[90m(0.368594ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.636763ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy implements Dana's inclusive INR-only threshold \u001b[90m(1.076622ms)\u001b[39m\u001b[39m\r\n"]
[138.117754, "o", "\u001b[32m✔ HTTP: invalid authentication and invalid events do not write anything \u001b[90m(68.951278ms)\u001b[39m\u001b[39m\r\n"]
[138.181155, "o", "\u001b[32m✔ HTTP: concurrent retries are write-free duplicates and cannot overwrite raw events \u001b[90m(63.461735ms)\u001b[39m\u001b[39m\r\n"]
[138.223703, "o", "\u001b[32m✔ HTTP: cancellations and ignored types are also deduplicated \u001b[90m(42.950874ms)\u001b[39m\u001b[39m\r\n"]
[138.243952, "o", "\u001b[32m✔ internal replay remains permission-protected and processes only failed events \u001b[90m(14.610759ms)\u001b[39m\u001b[39m\r\n"]
[138.244484, "o", "\u001b[32m✔ event IDs do not accidentally match inherited object properties \u001b[90m(4.63072ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ failed processing rolls back the refund, ID sequence, audit, and processed marker \u001b[90m(2.792855ms)\u001b[39m\u001b[39m\r\n"]
[138.260365, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.144134ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.897196ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(2.29564ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.798393ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.292261ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.720221ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.143644ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.358984ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 391.210948\u001b[39m\r\n"]
[138.266339, "o", "\u001b[1G\u001b[0K⠙"]
[138.267951, "o", "\u001b[1G\u001b[0K"]
