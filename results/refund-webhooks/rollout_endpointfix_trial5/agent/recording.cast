[145.687089, "o", "diff --git a/src/refunds.ts b/src/refunds.ts\r\nindex 11bef23..699ad2f 100644\r\n--- a/src/refunds.ts\r\n+++ b/src/refunds.ts\r\n@@ -36,8 +36,23 @@ export function parseEvent(raw: string): PaygateEvent {\r\n   }\r\n   const ev = body as PaygateEvent;\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\r\n-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\r\n-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\r\n+  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\r\n+  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\r\n+  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\r\n+    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\r\n+      throw new EventError(\"missing data.refund_id\");\r\n+    }\r\n+  }\r\n+  if (ev.type === \"refund.requested\") {\r\n+    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\r\n+        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\r\n+      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\r\n+    }\r\n+    if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\r\n+        (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\r\n+      throw new EventError(\"payment_id and reason must be strings\");\r\n+    }\r\n+  }\r\n   return ev;\r\n }\r\n \r\n@@ -48,7 +63,7 @@ export function decideStatus(policy: RefundPolicy, amount: number, currency: str\r\n \r\n function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\r\n   const { amount, currency } = ev.data;\r\n-  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\r\n+  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency.trim()) {\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\r\n   }\r\n   const now = new Date().toISOString();\r\n@@ -84,17 +99,20 @@ function cancelled(store: Store, ev: PaygateEvent): ProcessResult {\r\n }\r\n \r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\r\n-  let result: ProcessResult;\r\n-  switch (ev.type) {\r\n-    case \"refund.requested\":\r\n-      result = requested(store, policy, ev);\r\n-      break;\r\n-    case \"refund.cancelled\":\r\n-      result = cancelled(store, ev);\r\n-      break;\r\n-    default:\r\n-      result = { outcome: \"ignored\", reason: `unhandled type ${ev.type}` };\r\n-  }\r\n-  store.markProcessed(ev.event_id);\r\n-  return result;\r\n+  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\r\n+  return store.transaction(() => {\r\n+    let result: ProcessResult;\r\n+    switch (ev.type) {\r\n+      case \"refund.requested\":\r\n+        result = requested(store, policy, ev);\r\n+        break;\r\n+      case \"refund.cancelled\":\r\n+        result = cancelled(store, ev);\r\n+        break;\r\n+      default:\r\n+        result = { outcome: \"ignored\", reason: `unhandled type ${ev.type}` };\r\n+    }\r\n+    store.markProcessed(ev.event_id);\r\n+    return result;\r\n+  });\r\n }\r\ndiff --git a/src/store.ts b/src/store.ts\r\nindex b652eec..2c09699 100644\r\n--- a/src/store.ts\r\n+++ b/src/store.ts\r\n@@ -1,5 +1,5 @@\r\n // File-backed store for refunds, processed webhook events and raw event bodies.\r\n-// State is rewritten atomically (tmp file + rename) after every mutation.\r\n+// State is rewritten atomically (tmp file + rename), grouping each event into one commit.\r\n \r\n import { appendFileSync, existsSync, mkdirSync, readFileSync, renameSync, writeFileSync } from \"node:fs\";\r\n import { join } from \"node:path\";\r\n@@ -28,6 +28,7 @@ interface State {\r\n export class Store {\r\n   private readonly dir: string;\r\n   private state: State;\r\n+  private pendingAudit: string[] | undefined;\r\n \r\n   constructor(dir: string) {\r\n     this.dir = dir;\r\n@@ -39,11 +40,36 @@ export class Store {\r\n   }\r\n \r\n   private flush(): void {\r\n+    if (this.pendingAud"]
[145.687512, "o", "it !== undefined) return;\r\n     const path = join(this.dir, \"state.json\");\r\n     writeFileSync(`${path}.tmp`, JSON.stringify(this.state, null, 2));\r\n     renameSync(`${path}.tmp`, path);\r\n   }\r\n \r\n+  // Keep the refund mutation and its processed-event marker in the same state write.\r\n+  // Processing is synchronous: requests cannot interleave inside a transaction.\r\n+  transaction<T>(operation: () => T): T {\r\n+    if (this.pendingAudit !== undefined) throw new Error(\"nested transaction\");\r\n+    const previous = structuredClone(this.state);\r\n+    this.pendingAudit = [];\r\n+    let result: T;\r\n+    let auditLines: string[];\r\n+    try {\r\n+      result = operation();\r\n+      auditLines = this.pendingAudit;\r\n+      this.pendingAudit = undefined;\r\n+      this.flush();\r\n+    } catch (err) {\r\n+      this.state = previous;\r\n+      this.pendingAudit = undefined;\r\n+      throw err;\r\n+    }\r\n+    // Append only after committing state. If logging fails, the processed marker\r\n+    // is already durable, so a delivery retry cannot apply the refund again.\r\n+    if (auditLines.length) appendFileSync(join(this.dir, \"audit.jsonl\"), auditLines.join(\"\"));\r\n+    return result;\r\n+  }\r\n+\r\n   newRefundId(): string {\r\n     const id = `rfd_${String(this.state.next_seq).padStart(6, \"0\")}`;\r\n     this.state.next_seq += 1;\r\n@@ -68,11 +94,14 @@ export class Store {\r\n   }\r\n \r\n   isProcessed(eventId: string): boolean {\r\n-    return eventId in this.state.processed_events;\r\n+    return Object.hasOwn(this.state.processed_events, eventId);\r\n   }\r\n \r\n   markProcessed(eventId: string): void {\r\n-    this.state.processed_events[eventId] = new Date().toISOString();\r\n+    this.state.processed_events = {\r\n+      ...this.state.processed_events,\r\n+      [eventId]: new Date().toISOString(),\r\n+    };\r\n     this.flush();\r\n   }\r\n \r\n@@ -86,6 +115,8 @@ export class Store {\r\n   }\r\n \r\n   