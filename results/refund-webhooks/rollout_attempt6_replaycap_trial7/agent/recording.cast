[126.812465, "i", "git --no-pager diff -- src/verify.ts src/refunds.ts src/server.ts src/store.ts config/refunds.json; git status --short; python3 - <<'PY'\nimport json\nfrom pathlib import Path\nrows=[json.loads(line) for p in Path('ops/backlog').glob('*.jsonl') for line in p.read_text().splitlines() if line.strip()]\nprint('Backlog:', len(rows), 'deliveries;', len({r['event_id'] for r in rows}), 'unique event IDs;', len({r['data']['refund_id'] for r in rows}), 'unique refund IDs')\nPY\n"]
