[225.396878, "o", "\u001b[32m✔ rotation accepts any configured secret and any v1 candidate \u001b[90m(2.269958ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive in both directions \u001b[90m(0.413267ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signature verification uses exact body bytes and signed timestamp text \u001b[90m(0.547521ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signatures fail closed \u001b[90m(0.472161ms)\u001b[39m\u001b[39m\r\n"]
[225.398852, "o", "\u001b[32m✔ processed requests, cancellations, and ignored events remain duplicates after restart \u001b[90m(9.699415ms)\u001b[39m\u001b[39m\r\n"]
[225.400789, "o", "\u001b[32m✔ cancelling auto-approved refunds is audited only once \u001b[90m(2.14639ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured INR auto-approval boundary is inclusive at 500000 minor units \u001b[90m(0.415248ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signed invalid events are rejected by parsing \u001b[90m(0.509702ms)\u001b[39m\u001b[39m\r\n"]
