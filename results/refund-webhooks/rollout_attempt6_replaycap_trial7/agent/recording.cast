[126.814728, "o", "rows=[json.loads(line) for p in Path('ops/backlog').glob('*.jsonl') for line in p.read_text().splitlines() if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> print('Backlog:', len(rows), 'deliveries;', len({r['event_id'] for r in rows}), 'unique event IDs;', len({r['data']['refund_id'] for r in rows}), 'unique refund IDs')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
