[348.205717, "i", "python3 - <<'PY'\nimport json\nfrom collections import Counter\nfrom pathlib import Path\nrows=[json.loads(line) for p in Path('ops/backlog').glob('*.jsonl') for line in p.read_text().splitlines() if line.strip()]\ns=json.loads(Path('data/state.json').read_text())\nrefunds=list(s['refunds'].values())\naudit=[json.loads(line) for line in Path('data/audit.jsonl').read_text().splitlines()]\nfor ev in rows:\n    assert ev['event_id'] in s['processed_events'], ev['event_id']\n    matches=[r for r in refunds if r['source_event_id']==ev['event_id']]\n    assert len(matches)==1, (ev['event_id'],len(matches))\n    r=matches[0]\n    for field,target in [('refund_id','paygate_refund_id'),('payment_id','payment_id'),('amount','amount'),('currency','currency')]:\n        assert r[target]==ev['data'][field]\n    assert r['status']==('auto_approved' if r['currency']=='INR' and r['amount']<=500000 else 'pending_review')\n    assert len([a for a in audit if a.get('event')==ev['event_id'] and a['action']=='refund.created'])==1\nassert len(refunds)==len(rows)==45\nprint('Verified: all 45 backlog events processed, exactly one matching refund and creation audit per event.')\nprint('Refund statuses:',dict(Counter(r['status'] for r in refunds)))\nprint('Replay batches complete; zero backlog events remain.')\ncfg=json.loads(Path('config/refunds.json').read_text())\nassert cfg['replay']['max_per_run']==20 and cfg['replay']['min_interval_s']==120\nprint('Refund-storm guard preserved: 20 events per run, 120-second cooldown.')\nPY\nnpm test; git --no-pager diff --check; git status --short\n"]
[348.20609, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[348.206467, "o", "\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[348.206642, "o", "rows=[json.loads(line) for p in Path('ops/backlog').glob('*.jsonl') for line in p.read_text().splitlines() if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> s=json.loads(Path('data/state.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h"]
