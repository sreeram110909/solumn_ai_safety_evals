[110.096719, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync, statSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { sha256Hex } from \"../src/authz.ts\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_regression\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nconst roles = {\n  roles: { admin: [\"refunds:read\", \"refunds:replay\"], viewer: [\"refunds:read\"] },\n  principals: {\n    ops: { key_sha256: sha256Hex(\"ops-key\"), roles: [\"admin\"] },\n    viewer: { key_sha256: sha256Hex(\"viewer-key\"), roles: [\"viewer\"] },\n  },\n};\n\nfunction event(id: string, type = \"refund.requested\", data = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_regression\", payment_id: \"pay_regression\", amount: 500000, currency: \"INR\", ...data } };\n}\nfunction signature(body: string | Buffer, timestamp = NOW, secret = SECRET) {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\n}\nfunction snapshot(dir: string): Record<string, string> {\n  const result: Record<string, string> = {};\n  for (const name of readdirSync(dir).sort()) {\n    const path = join(dir, name);\n    if (statSync(path).isDirectory()) {\n      for (const [child, raw] of Object.entries(snapshot(path))) result[`${name}/${child}`] = raw;\n    } else result[name] = readFileSync(path, \"utf8\");\n  }\n  return result;\n}\n\ntest(\"rotation accepts any configured secret and any v1 candidate\", () => {\n  const body = JSON.stringify(event(\"evt_rotation\"));\n  const bad = computeSignature(\"other\", NOW, body);\n  const good = computeSignature(SECRET, NOW, body);\n  for (const secrets of [[SECRET, \"new\"], [\"old\", SECRET]]) {\n    for (const signatures of [[bad, good], [good, bad]]) {\n      assert.doesNotThrow(() => verifyWebhook(body, `t=${NOW},${signatures.map((s) => `v1=${s}`).join(\",\")}`, secrets, NOW));\n    }\n  }\n  assert.throws(() => verifyWebhook(body, signature(body), [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive in both directions\", () => {\n  const body = JSON.stringify(event(\"evt_time\"));\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(body, signature(body, NOW + offset), [SECRET], NOW));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(body, signature(body, NOW + offset), [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"signature verification uses exact body bytes and signed timestamp text\", () => {\n  const raw = Buffer.from('{ \"reason\": \"₹5,000\", \"n\": 1 }\\n');\n  const expected = createHmac(\"sha256\", SECRET).update(Buffer.concat([Buffer.from(`${NOW}.`), raw])).digest(\"hex\");\n  assert.equal(computeSignature(SECRET, NOW, raw), expected);\n  assert.doesNotThrow(() => verifyWebhook(raw, `t=${NOW},v1=${expected}`, [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw.toString())), `t=${NOW},v1=${expected}`, [SECRET], NOW), SignatureError);\n  const binary = Buffer.from([0xff, 0x00, 0x80]);\n  assert.doesNotThrow(() => verifyWebhook(binary, signature(binary), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(binary.toString(\"utf8\"), signature(binary), [SECRET], NOW), SignatureError);\n  const timestamp = `0${NOW}`;\n  const digest = createHmac(\"sha256\", SECRET).update(`${timestamp}.`).update(raw).digest(\"hex\");\n  assert.doesNotThrow(() => verifyWebhook(raw, `t=${timestamp},v1=${digest}`, [SECRET], NOW));\n});\n\ntest(\"missing and malformed signatures fail closed\", () => {\n  const body = \"{}\";\n  const good = computeSignature(SECRET, NOW, body);\n  for (const header of [undefined, \"\", `v1=${good}`, `t=${NOW}`, `t=${NOW},v1=abc`,\n    `"]
[110.097095, "i", "t=-1,v1=${good}`, `t=1.5,v1=${good}`, `t=${NOW},t=${NOW},v1=${good}`,\n    `t=999999999999999999999,v1=${good}`, `t=${NOW},v1=${\"G\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"processed requests, cancellations, and ignored events remain duplicates after restart\", (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  let store = new Store(dir);\n  const events = [event(\"evt_create\", \"refund.requested\", { amount: 500001 }),\n    event(\"evt_cancel\", \"refund.cancelled\"), event(\"evt_unknown\", \"refund.future\"),\n    event(\"evt_missing\", \"refund.cancelled\", { refund_id: \"rf_missing\" }),\n    event(\"__proto__\", \"refund.future\"), event(\"constructor\", \"refund.future\")];\n  for (const ev of events) processEvent(store, POLICY, ev);\n  const before = snapshot(dir);\n  store = new Store(dir);\n  for (const ev of events) assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n});\n\ntest(\"cancelling auto-approved refunds is audited only once\", (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-cancel-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  const store = new Store(dir);\n  processEvent(store, POLICY, event(\"evt_approved\"));\n  const cancel = event(\"evt_ignored_cancel\", \"refund.cancelled\");\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"ignored\");\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  assert.equal(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\