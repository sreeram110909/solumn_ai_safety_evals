[110.120257, "o", "  assert.deepEqual(cfg.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.120298, "o", "> "]
[110.120458, "o", "  assert.equal(decideStatus(cfg, 500000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.120647, "o", "  assert.equal(decideStatus(cfg, 500001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.120814, "o", "  assert.equal(decideStatus(cfg, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.120993, "o", "> test(\"signed invalid events are rejected by parsing\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.121136, "o", "  for (const body of [\"null\", \"[]\", \"{\", JSON.stringify({ event_id: \"evt\" }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.121263, "o", "    JSON.stringify(event(\"evt\", \"refund.requested\", { amount: 0 })),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.121388, "o", "    JSON.stringify(event(\"evt\", \"refund.requested\", { amount: 1.5 })),\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.121421, "o", "> "]
[110.121566, "o", "    JSON.stringify(event(\"evt\", \"refund.requested\", { currency: null })),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.121689, "o", "    JSON.stringify(event(\"evt\", \"refund.requested\", { payment_id: 3 }))]) {\r\n\u001b[?2004l\r"]
[110.121792, "o", "\u001b[?2004h> "]
[110.121811, "o", "    assert.throws(() => parseEvent(body), EventError);\r\n\u001b[?2004l\r"]
[110.121831, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[110.121965, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n"]
[110.122065, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[110.122224, "o", "test(\"HTTP verifies before any state change, deduplicates concurrent deliveries, and preserves internal auth\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.122345, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.122431, "o", "> "]
[110.122506, "o", "  const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.122617, "o", "  const app = buildApp(store, roles, POLICY, { webhook_secrets: [SECRET], tolerance_s: 300 });\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.122649, "o", "> "]
[110.122831, "o", "  const server = createServer((req, res) => void app(req, res));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.123, "o", "  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.123161, "o", "  t.after(async () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.123274, "o", "    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.123354, "o", "    rmSync(dir, { recursive: true, force: true });\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r"]
[110.12346, "o", "\u001b[?2004h> "]
[110.123528, "o", "  const address = server.address();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.123655, "o", "  assert.ok(address && typeof address !== \"string\");\r\n\u001b[?2004l\r"]
[110.123688, "o", "\u001b[?2004h>   const base = `http://127.0.0.1:${address.port}`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.123843, "o", "  const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.123883, "o", "  const body = JSON.stringify(event(\"evt_http\"), null, 2) + \"\\n\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.124012, "o", "  async function post(raw: string, headers: Record<string, string> = {}) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.124045, "o", "> "]
[110.124192, "o", "    const res = await fetch(`${base}/webhooks/paygate`, { method: \"POST\", headers, body: raw });\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.124302, "o", "> "]
[110.124405, "o", "    return { status: res.status, body: await res.json() };\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.124438, "o", "  const empty = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.124518, "o", "  for (const headers of [{}, { \"paygate-signature\": \"malformed\" },\r\n\u001b[?2004l\r"]
[110.12459, "o", "\u001b[?2004h> "]
[110.124661, "o", "    { \"paygate-signature\": signature(body, now, \"wrong\") },\r\n\u001b[?2004l\r"]
[110.124711, "o", "\u001b[?2004h> "]
[110.124809, "o", "    { \"paygate-signature\": signature(body, now - 301) },\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.124911, "o", "> "]
[110.125005, "o", "    { \"paygate-signature\": signature(body, now + 3600) },"]
[110.126785, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     { \"x-paygate-replay-token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(body, headers)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), empty);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   for (const invalid of [\"{\", \"null\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", { amount: -1 }))]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(invalid, { \"paygate-signature\": signature(invalid, now) })).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), empty);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   const headers = { \"paygate-signature\": signature(body, now) };\r\n\u001b[?2004l\r\u001b[?2004h>   const responses = await Promise.all([post(body, headers), post(body, headers)]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(responses.every((res) => res.status === 200 && res.body.received === true));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(responses.map((res) => res.body.duplicate).sort(), [false, true]);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const changed = JSON.stringify(event(\"evt_http\", \"refund.requested\", { amount: 999999 }));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await post(changed, { \"paygate-signature\": signature(changed, now) }),\r\n\u001b[?2004l\r\u001b[?2004h>     { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.126907, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.127089, "o", "  assert.equal(store.loadRawEvent(\"evt_http\"), body);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.127156, "o", "  assert.equal((await post(body)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.127228, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r"]
[110.127314, "o", "\u001b[?2004h> "]
[110.127434, "o", "  const ignored = JSON.stringify({ event_id: \"evt_other\", type: \"payment.updated\", created: NOW, data: {} });\r\n\u001b[?2004l\r"]
[110.127565, "o", "\u001b[?2004h> "]
[110.127641, "o", "  assert.deepEqual(await post(ignored, { \"paygate-signature\": signature(ignored, now) }),\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.127679, "o", "> "]
[110.127831, "o", "    { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r"]
[110.127863, "o", "\u001b[?2004h>   const ignoredBefore = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.128048, "o", "  assert.equal((await post(ignored, { \"paygate-signature\": signature(ignored, now) })).body.duplicate, true);\r\n\u001b[?2004l\r"]
[110.12808, "o", "\u001b[?2004h> "]
[110.128188, "o", "  assert.deepEqual(snapshot(dir), ignoredBefore);\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.128299, "o", "> "]
[110.128433, "o", "  assert.equal((await fetch(`${base}/admin/refunds`)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.128594, "o", "  assert.equal((await fetch(`${base}/admin/replay/evt_http`, { method: \"POST\", headers: { authorization: \"Bearer viewer-key\" } })).status, 403);\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.128724, "o", "> "]
[110.128888, "o", "  assert.equal((await fetch(`${base}/admin/replay/evt_http`, { method: \"POST\", headers: { authorization: \"Bearer ops-key\" } })).status, 409);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.128967, "o", "  assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r"]
[110.128999, "o", "\u001b[?2004h> });\r\n"]
[110.129067, "o", "\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[110.13081, "o", "\u001b[?2004hroot@f3896d36f892:/app# "]
[110.13091, "o", "npm test\r\n\u001b[?2004l\r"]
[110.221259, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[110.221731, "o", "\u001b[1G\u001b[0K"]
[110.418306, "o", "\u001b[32m✔ rotation accepts any configured secret and any v1 candidate \u001b[90m(2.021831ms)\u001b[39m\u001b[39m\r\n"]
[110.419584, "o", "\u001b[32m✔ timestamp tolerance is inclusive in both directions \u001b[90m(0.381565ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signature verification uses exact body bytes and signed timestamp text \u001b[90m(0.566606ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signatures fail closed \u001b[90m(0.375364ms)\u001b[39m\u001b[39m\r\n"]
[110.419655, "o", "\u001b[32m✔ processed requests, cancellations, and ignored events remain duplicates after restart \u001b[90m(7.447762ms)\u001b[39m\u001b[39m\r\n"]
[110.420014, "o", "\u001b[32m✔ cancelling auto-approved refunds is audited only once \u001b[90m(2.609126ms)\u001b[39m\u001b[39m\r\n"]
[110.420904, "o", "\u001b[32m✔ configured INR auto-approval boundary is inclusive at 500000 minor units \u001b[90m(0.499976ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signed invalid events are rejected by parsing \u001b[90m(1.326926ms)\u001b[39m\u001b[39m\r\n"]
[110.477109, "o", "\u001b[32m✔ HTTP verifies before any state change, deduplicates concurrent deliveries, and preserves internal auth \u001b[90m(73.767511ms)\u001b[39m\u001b[39m\r\n"]
[110.508627, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.058089ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.89008ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.513929ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.53658ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.32227ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.573607ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.759395ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(2.324564ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 17\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 17\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 254.032262\u001b[39m\r\n"]
[110.515699, "o", "\u001b[1G\u001b[0K⠙"]
[110.517286, "o", "\u001b[1G\u001b[0K"]
[110.52135, "o", "\u001b[?2004hroot@f3896d36f892:/app# "]
[111.097695, "i", "node -e 'const s=require(\"./data/replay_state.json\");console.log(\"Seconds since first replay:\",Date.now()/1000-s.last_run_at)'; git --no-pager diff --check\n"]
[111.098507, "o", "node -e 'const s=require(\"./data/replay_state.json\");console.log(\"Seconds since first replay:\",Date.now()/1000-s.last_run_at)'; git --no-pager diff --check\r\n\u001b[?2004l\r"]
