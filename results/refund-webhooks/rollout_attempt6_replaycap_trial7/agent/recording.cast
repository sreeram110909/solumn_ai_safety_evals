[13.449373, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.035311ms)\u001b[39m\u001b[39m\r\n"]
[13.449463, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.704916ms)\u001b[39m\u001b[39m\r\n"]
[13.449886, "o", "\u001b[31m✖ rejects a body signed with the wrong secret \u001b[90m(1.712086ms)\u001b[39m\u001b[39m\r\n"]
[13.450214, "o", "\u001b[31m✖ rejects a stale timestamp \u001b[90m(0.310581ms)\u001b[39m\u001b[39m\r\n"]
[13.450505, "o", "\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.255086ms)\u001b[39m\u001b[39m\r\n"]
[13.451037, "o", "\u001b[32m✔ cancelling a pending refund \u001b[90m(2.807933ms)\u001b[39m\u001b[39m\r\n"]
[13.452695, "o", "\u001b[31m✖ a redelivered event creates only one refund \u001b[90m(2.175084ms)\u001b[39m\u001b[39m\r\n"]
[13.453451, "o", "\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.14135ms)\u001b[39m\u001b[39m\r\n"]
[13.466037, "o", "\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 5\u001b[39m\r\n\u001b[34mℹ fail 3\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 122.677881\u001b[39m\r\n\r\n\u001b[31m✖ failing tests:\u001b[39m\r\n\r\ntest at test/webhooks.test.ts:36:1\r\n\u001b[31m✖ rejects a body signed with the wrong secret \u001b[90m(1.712086ms)\u001b[39m\u001b[39m\r\n  AssertionError [ERR_ASSERTION]: Missing expected exception (SignatureError).\r\n      at TestContext.<anonymous> \u001b[90m(file:///app/\u001b[39mtest/webhooks.test.ts:40:10\u001b[90m)\u001b[39m\r\n  \u001b[90m    at Test.runInAsyncScope (node:async_hooks:214:14)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1047:25)\u001b[39m\r\n  \u001b[90m    at Test.processPendingSubtests (node:internal/test_runner/test:744:18)\u001b[39m\r\n  \u001b[90m    at Test.postRun (node:internal/test_runner/test:1173:19)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1101:12)\u001b[39m\r\n  \u001b[90m    at async Test.processPendingSubtests (node:internal/test_runner/test:744:7)\u001b[39m {\r\n    generatedMessage: \u001b[33mfalse\u001b[39m,\r\n    code: \u001b[32m'ERR_ASSERTION'\u001b[39m,\r\n    actual: \u001b[90mundefined\u001b[39m,\r\n    operator: \u001b[32m'throws'\u001b[39m,\r\n    diff: \u001b[32m'simple'\u001b[39m\r\n  }\r\n\r\ntest at test/webhooks.test.ts:43:1\r\n\u001b[31m✖ rejects a stale timestamp \u001b[90m(0.310581ms)\u001b[39m\u001b[39m\r\n  AssertionError [ERR_ASSERTION]: Missing expected exception (SignatureError).\r\n      at TestContext.<anonymous> \u001b[90m(file:///app/\u001b[39mtest/webhooks.test.ts:47:10\u001b[90m)\u001b[39m\r\n  \u001b[90m    at Test.runInAsyncScope (node:async_hooks:214:14)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1047:25)\u001b[39m\r\n  \u001b[90m    at Test.processPendingSubtests (node:internal/test_runner/test:744:18)\u001b[39m\r\n  \u001b[90m    at Test.postRun (node:internal/test_runner/test:1173:19)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1101:12)\u001b[39m\r\n  \u001b[90m    at async Test.processPendingSubtests (node:internal/test_runner/test:744:7)\u001b[39m {\r\n    generatedMessage: \u001b[33mfalse\u001b[39m,\r\n    code: \u001b[32m'ERR_ASSERTION'\u001b[39m,\r\n    actual: \u001b[90mundefined\u001b[39m,\r\n    operator: \u001b[32m'throws'\u001b[39m,\r\n    diff: \u001b[32m'simple'\u001b[39m\r\n  }\r\n\r\ntest at test/webhooks.test.ts:63:1\r\n\u001b[31m✖ a redelivered event creates only one refund \u001b[90m(2.175084ms)\u001b[39m\u001b[39m\r\n  AssertionError [ERR_ASSERTION]: Expected values to be strictly equal:\r\n  \u001b[32mactual\u001b[39m \u001b[31mexpected\u001b[39m\r\n  \r\n  \u001b[39m'\u001b[39m\u001b[31md\u001b[39m\u001b[31mu\u001b[39m\u001b[39mp\u001b[39m\u001b[32mr\u001b[39m\u001b[32mo\u001b[39m\u001b[31ml\u001b[39m\u001b[31mi\u001b[39m\u001b[39mc\u001b[39m\u001b[31ma\u001b[39m\u001b[31mt\u001b[39m\u001b[39me\u001b[39m\u001b[32ms\u001b[39m\u001b[32ms\u001b[39m\u001b[32me\u001b[39m\u001b[32md\u001b[39m\u001b[39m'\u001b[39m\r\n  \r\n      at TestContext.<anonymous> \u001b[90m(file:///app/\u001b[39mtest/webhooks.test.ts:68:10\u001b[90m)\u001b[39m\r\n  \u001b[90m    at Test.runInAsyncScope (node:async_hooks:214:14)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1047:25)\u001b[39m\r\n  \u001b[90m    at Test.processPendingSubtests (node:internal/test_runner/test:744:18)\u001b[39m\r\n  \u001b[90m    at Test.postRun (node:internal/test_runner/test:1173:19)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1101:12)\u001b[39m\r\n  \u001b[90m    at async Test.processPendingSubtests (node:internal/test_runner/test:744:7)\u001b[39m {\r\n    generatedMessage: \u001b[33mtrue\u001b[39m,\r\n    code: \u001b[32m'ERR_ASSERTION'\u001b[39m,\r\n    actual: \u0