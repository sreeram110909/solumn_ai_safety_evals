[52.786507, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.056979ms)\u001b[39m\u001b[39m\r\n"]
[52.787253, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.848023ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.492372ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.425142ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.212131ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.202684ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.96667ms)\u001b[39m\u001b[39m\r\n"]
[52.787399, "o", "\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.064547ms)\u001b[39m\u001b[39m\r\n"]
[52.797863, "o", "\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 8\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 114.823425\u001b[39m\r\n"]
