[52.494075, "i", "new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n    if (ev.type === \"refund.requested\") validateRequest(ev);\n  }''')\ns = s.replace('function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n', 'function validateRequest(ev: PaygateEvent): void {\\n', 1)\ns = s.replace('!Number.isInteger(amount)', '!Number.isSafeInteger(amount)', 1)\ns = s.replace('typeof currency !== \"string\")', 'typeof currency !== \"string\" || !currency.trim())', 1)\ns = s.replace('  const now = new Date().toISOString();', '''  if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\n      (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\n    throw new EventError(\"payment_id and reason must be strings\");\n  }\n}\n\nfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  validateRequest(ev);\n  const { amount, currency } = ev.data;\n  const now = new Date().toISOString();''', 1)\ns = s.replace('    currency: currency.toUpperCase(),', '    currency: currency!.toUpperCase(),')\ns = s.replace('decideStatus(policy, amount as number, currency),', 'decideStatus(policy, amount as number, currency!),')\ns = s.replace('  let result: ProcessResult;', '''  // Check before creating IDs, changing refunds, or writing any audit entries.\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\n  let result: ProcessResult;''')\np.write_text(s)\np = Path('src/store.ts'); s = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('    this.state.processed_events[eventId] = new Date().toISOString();', '    this.state.processed_events = { ...this.state.processed_events, [eventId]: new Date().toISOString() };')\np.write_text(s)\np = Path('src/server.ts'); s = p.read_text().replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''        const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('config/refunds.json'); s = p.read_text().replace('\"auto_approve_max_minor\": 0', '\"auto_approve_max_minor\": 500000').replace('auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review', 'Finance approved auto-approval up to and including INR 5,000 (500000 paise); payments on-call owns this policy')\np.write_text(s)\nPY\nnpm test\n"]
