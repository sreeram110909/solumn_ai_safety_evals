[108.708601, "o", "test(\"event IDs matching object prototype properties are processed exactly once\", async () => withApp(async ({ store, dir }) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.708706, "o", "  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.70879, "o", "    assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.708918, "o", "test(\"configured policy follows Dana's inclusive INR-only threshold\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.709035, "o", "  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.709199, "o", "  assert.equal(policy.auto_approve_max_minor, 500_000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.709311, "o", "  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.709447, "o", "  assert.equal(decideStatus(policy, 499_999, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.709952, "o", "  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.709984, "o", "  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.710123, "o", "  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h"]
