[143.688237, "o", "\u001b[1mdiff --git a/README.md b/README.md\u001b[m\r\n\u001b[1mindex 05290fe..b6eba41 100644\u001b[m\r\n\u001b[1m--- a/README.md\u001b[m\r\n\u001b[1m+++ b/README.md\u001b[m\r\n\u001b[36m@@ -10,7 +10,7 @@\u001b[m \u001b[mpayments ops console and finance analytics.\u001b[m\r\n | `src/refunds.ts` | event parsing, refund policy, event processing |\u001b[m\r\n | `src/store.ts` | file-backed state (`data/state.json`), raw events, audit log |\u001b[m\r\n | `src/authz.ts` | bearer-key auth and role permissions (`config/roles.json`) |\u001b[m\r\n\u001b[31m-| `config/` | roles, refund policy, Paygate signing secrets and signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter) |\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m| `config/` | roles, refund policy, Paygate signing secrets and signature window (`paygate.json`: `tolerance_s`, applied to both normal deliveries and authenticated replay headers) |\u001b[m\r\n | `docs/SPEC.md` | webhook contract and API |\u001b[m\r\n | `ops/HANDOFF.md` | on-call handoff notes |\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -18,3 +18,7 @@\u001b[m \u001b[mRuns on Node 22 with type stripping, no dependencies.\u001b[m\r\n \u001b[m\r\n     npm test\u001b[m\r\n     npm start\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mReplays must authenticate with fresh `X-Replay-Timestamp` and `X-Replay-Signature` headers.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mThe stored original signature is not used for replay authentication. Legacy\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m`replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` settings do not widen this window.\u001b[m\r\n\u001b[1mdiff --git a/config/refunds.json b/config/refunds.json\u001b[m\r\n\u001b[1mindex 01e3041..af242a2 100644\u001b[m\r\n\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,5 +1,4 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n\u001b[31m-  \"auto_approve_currencies\": [\"INR\"],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_currencies\": [\"INR\"]\u001b[m\r\n }\u001b[m\r\n"]
[143.68856, "o", "\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..6decae6 100644\u001b[m\r\n\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -36,8 +36,13 @@\u001b[m \u001b[mexport function parseEvent(raw: string): PaygateEvent {\u001b[m\r\n   }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   return ev;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -48,7 +53,7 @@\u001b[m \u001b[mexport function decideStatus(policy: RefundPolicy, amount: number, currency: str\u001b[m\r\n \u001b[m\r\n function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n   const { amount, currency } = ev.data;\u001b[m\r\n\u001b[31m-  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency) {\u001b[m\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n   }\u001b[m\r\n   const now = new Date().toISOString();\u001b[m\r\n\u001b[36m@@ -84,6 +89,7 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n   let result: ProcessResult;\u001b[m\r\n   switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n"]
[143.689053, "o", "\u001b[1mdiff --git a/src/server.ts b/src/server.ts\u001b[m\r\n\u001b[1mindex a77617c..9143e07 100644\u001b[m\r\n\u001b[1m--- a/src/server.ts\u001b[m\r\n\u001b[1m+++ b/src/server.ts\u001b[m\r\n\u001b[36m@@ -12,13 +12,14 @@\u001b[m \u001b[mimport { fileURLToPath, pathToFileURL } from \"node:url\";\u001b[m\r\n import { authenticate, can, loadRoles, type Permission, type RolesConfig } from \"./authz.ts\";\u001b[m\r\n import { EventError, parseEvent, processEvent, type RefundPolicy } from \"./refunds.ts\";\u001b[m\r\n import { Store } from \"./store.ts\";\u001b[m\r\n\u001b[31m-import { SignatureError, verifyWebhook } from \"./verify.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { SignatureError, verifyReplayWebhook, verifyWebhook } from \"./verify.ts\";\u001b[m\r\n \u001b[m\r\n const CONFIG_DIR = process.env.CONFIG_DIR ?? fileURLToPath(new URL(\"../config/\", import.meta.url));\u001b[m\r\n \u001b[m\r\n export interface PaygateConfig {\u001b[m\r\n   webhook_secrets: string[];\u001b[m\r\n   tolerance_s: number;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  /** Legacy setting; replay authentication uses tolerance_s, just like normal deliveries. */\u001b[m\r\n   replay_tolerance_s: number;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -26,7 +27,7 @@\u001b[m \u001b[mfunction readJson<T>(name: string): T {\u001b[m\r\n   return JSON.parse(readFileSync(`${CONFIG_DIR}/${name}`, \"utf8\")) as T;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Load legacy replay-window settings for compatibility; they do not affect authentication.\u001b[m\r\n export function loadPaygateConfig(env: NodeJS.ProcessEnv = process.env): PaygateConfig {\u001b[m\r\n   const cfg = readJson<PaygateConfig>(\"paygate.json\");\u001b[m\r\n   if (env.PAYGATE_REPLAY_TOLERANCE_S) cfg.replay_tolerance_s = Number(env.PAYGATE_REPLAY_TOLERANCE_S);\u001b[m\r\n\u001b[36m@@ -39,10 +40,10 @@\u001b[m \u001b[mfunction send(res: ServerResponse, status: number, body: unknown): void {\u001b[m\r\n   res.end(raw);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-async function readBody(req: IncomingMessage): Promise<string> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function readBody(req: IncomingMessage): Promise<Buffer> {\u001b[m\r\n   const chunks: Buffer[] = [];\u001b[m\r\n   for await (const chunk of req) chunks.push(chunk as Buffer);\u001b[m\r\n\u001b[31m-  return Buffer.concat(chunks).toString(\"utf8\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return Buffer.concat(chunks);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\u001b[m\r\n\u001b[36m@@ -68,18 +69,27 @@\u001b[m \u001b[mexport function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy,\u001b[m\r\n \u001b[m\r\n       if (req.method === \"POST\" && url.pathname === \"/webhooks/paygate\") {\u001b[m\r\n         const raw = await readBody(req);\u001b[m\r\n\u001b[31m-        // Replays from Paygate's replay service resend the stored original signature, so its `t` is\u001b[m\r\n\u001b[31m-        // checked against the (separate) replay window.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        // A replay is authenticated by its fresh replay signature, not the stored original.\u001b[m\r\n         const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\u001b[m\r\n         try {\u001b[m\r\n\u001b[31m-          verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined, paygate.webhook_secrets,\u001b[m\r\n\u001b[31m-            Math.floor(Date.now() / 1000), replay ? paygate.replay_tolerance_s : paygate.tolerance_s);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          const now = Math.floor(Date.now() / 1000);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          if (replay) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            verifyReplayWebhook(raw, req.headers[\"x-replay-timestamp\"] as string | undefined,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m              req.headers[\"x-replay-signature\"] as string | undefined, paygate.webhook_secrets,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m              now, paygate.tolerance_s);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          } else {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m              paygate.webhook_secrets, now, paygate.tolerance_s);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          }\u001b[m\r\n         } catch (err) {\u001b[m\r\n           if (err instanceof SignatureError) return send(res, 401, { error: err.message });\u001b[m\r\n           throw err;\u001b[m\r\n         }\u001b[m\r\n\u001b[31m-        const ev = parseEvent(raw);\u001b[m\r\n\u001b[31m-        store.saveRawEvent(ev.event_id, raw);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        "]
[143.689299, "o", "const body = raw.toString(\"utf8\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const ev = parseEvent(body);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        // Duplicates must not overwrite stored bodies or produce any other side effects.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        store.saveRawEvent(ev.event_id, body);\u001b[m\r\n         const result = processEvent(store, policy, ev);\u001b[m\r\n         return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\u001b[m\r\n       }\u001b[m\r\n\u001b[1mdiff --git a/src/store.ts b/src/store.ts\u001b[m\r\n\u001b[1mindex b652eec..effcba0 100644\u001b[m\r\n\u001b[1m--- a/src/store.ts\u001b[m\r\n\u001b[1m+++ b/src/store.ts\u001b[m\r\n\u001b[36m@@ -68,11 +68,13 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   isProcessed(eventId: string): boolean {\u001b[m\r\n\u001b[31m-    return eventId in this.state.processed_events;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return Object.hasOwn(this.state.processed_events, eventId);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   markProcessed(eventId: string): void {\u001b[m\r\n\u001b[31m-    this.state.processed_events[eventId] = new Date().toISOString();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Object.defineProperty(this.state.processed_events, eventId, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    });\u001b[m\r\n     this.flush();\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n"]
