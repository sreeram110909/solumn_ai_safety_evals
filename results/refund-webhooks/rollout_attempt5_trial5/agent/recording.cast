[108.707042, "o", "> "]
[108.707226, "o", "    assert.equal(store.findByPaygateId(refund_id)[0].status, amount === 500_000 ? \"auto_approved\" : \"cancelled\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.707296, "o", "    const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.707426, "o", "    assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.707504, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h"]
