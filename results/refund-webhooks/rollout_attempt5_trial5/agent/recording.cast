[108.706668, "o", "test(\"cancellation duplicates do not repeat audits or mutations\", async () => withApp(async ({ store, dir }) => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const amount of [500_000, 500_001]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const refund_id = `rf_${amount}`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.706808, "o", "    processEvent(store, POLICY, event(`evt_req_${amount}`, \"refund.requested\", { amount, refund_id }));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.706921, "o", "    const cancel = event(`evt_cancel_${amount}`, \"refund.cancelled\", { refund_id });\r\n\u001b[?2004l\r\u001b[?2004h"]
