[108.712653, "o", "\u001b[?2004hroot@871a9579edef:/app# npm test\r\n\u001b[?2004l\r"]
[108.810387, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[108.810931, "o", "\u001b[1G\u001b[0K"]
[109.019333, "o", "\u001b[32m✔ signatures support rotation and require the exact raw body \u001b[90m(2.474539ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.514846ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing, malformed, and ambiguous signature headers fail closed \u001b[90m(0.320294ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ replay verification checks fresh replay signatures with rotation and the same window \u001b[90m(0.483647ms)\u001b[39m\u001b[39m\r\n"]
[109.108296, "o", "\u001b[32m✔ HTTP authentication failures never change any state \u001b[90m(104.258667ms)\u001b[39m\u001b[39m\r\n"]
[109.136172, "o", "\u001b[32m✔ correctly signed invalid events return 400 \u001b[90m(28.796785ms)\u001b[39m\u001b[39m\r\n"]
[109.160888, "o", "\u001b[32m✔ HTTP duplicates preserve refunds, audit, state, and original raw events \u001b[90m(24.917814ms)\u001b[39m\u001b[39m\r\n"]
[109.173229, "o", "\u001b[32m✔ replays ignore original authentication and deduplicate with normal deliveries \u001b[90m(13.028375ms)\u001b[39m\u001b[39m\r\n"]
[109.197671, "o", "\u001b[32m✔ unknown event types are acknowledged and deduplicated without refunds \u001b[90m(19.788446ms)\u001b[39m\u001b[39m\r\n"]
[109.20332, "o", "\u001b[32m✔ cancellation duplicates do not repeat audits or mutations \u001b[90m(5.251209ms)\u001b[39m\u001b[39m\r\n"]
[109.203874, "o", "\u001b[32m✔ failed processing does not mark an event processed \u001b[90m(2.126743ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs matching object prototype properties are processed exactly once \u001b[90m(3.568991ms)\u001b[39m\u001b[39m\r\n"]
[109.204077, "o", "\u001b[32m✔ configured policy follows Dana's inclusive INR-only threshold \u001b[90m(0.387835ms)\u001b[39m\u001b[39m\r\n"]
[109.218119, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.545308ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.007514ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.755156ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.511901ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.221392ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.59444ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.894531ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.517486ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(43.872822ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 22\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 22\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 369.727828\u001b[39m\r\n"]
[109.223883, "o", "\u001b[1G\u001b[0K⠙"]
[109.225142, "o", "\u001b[1G"]
[109.225212, "o", "\u001b[0K"]
