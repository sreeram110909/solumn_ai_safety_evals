[108.699128, "o", "test(\"HTTP duplicates preserve refunds, audit, state, and original raw events\", async () => withApp(async ({ post, store, dir }) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.699373, "o", "  const original = JSON.stringify(event(\"evt_once\"), null, 2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.700029, "o", "  let res = await post(original, { \"paygate-signature\": signed(original) });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[108.700192, "o", "  assert.equal(res.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h> "]
