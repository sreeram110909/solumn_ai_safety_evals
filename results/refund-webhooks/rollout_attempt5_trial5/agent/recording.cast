[108.640724, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/refunds.ts')\ns = p.read_text().replace('''  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");''', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }''')\ns = s.replace('!Number.isInteger(amount)', '!Number.isSafeInteger(amount)').replace('typeof currency !== \"string\")', 'typeof currency !== \"string\" || !currency)')\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('  replay_tolerance_s: number;', '  /** Legacy setting; replay authentication uses tolerance_s, just like normal deliveries. */\\n  replay_tolerance_s: number;')\ns = s.replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.', '// Load legacy replay-window settings for compatibility; they do not affect authentication.')\np.write_text(s)\np = Path('README.md')\ns = p.read_text().replace('signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter)', 'signature window (`paygate.json`: `tolerance_s`, applied to both normal deliveries and authenticated replay headers)')\ns += '\\nReplays must authenticate with fresh `X-Replay-Timestamp` and `X-Replay-Signature` headers.\\nThe stored original signature is not used for replay authentication. Legacy\\n`replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` settings do not widen this window.\\n'\np.write_text(s)\nPY\ncat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyReplayWebhook, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_pay381_test\";\nconst OLD_SECRET = \"whsec_pay381_old\";\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\n\nfunction event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_381\", payment_id: \"pay_381\", amount: 500_000, currency: \"INR\", ...data } };\n}\n\nfunction signed(body: string | Buffer, time = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return `t=${time},v1=${computeSignature(secret, time, body)}`;\n}\n\n// Snapshot every stored file, including raw events and audit entries.\nfunction snapshot(dir: string, prefix = \"\"): Record<string, string> {\n  const files: Record<string, string> = {};\n  for (const entry of readdirSync(join(dir, prefix), { withFileTypes: true })) {\n    const path = join(prefix, entry.name);\n    if (entry.isDirectory()) Object.assign(files, snapshot(dir, path));\n    else files[path] = readFileSync(join(dir, path)).toString(\"hex\");\n  }\n  return files;\n}\n\nasync function withApp(run: (ctx: {\n  store: Store; dir: string; post: (body: string | Buffer, headers?: Record<string, string>) => Promise<Response>;\n}) => Promise<void>) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [OLD_SECRET, SECRET], tolerance_s: 300, replay_tolerance_s: 86400 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127"]
[108.640801, "i", ".0.0.1\", resolve));\n  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\n  try {\n    await run({ store, dir, post: (body, headers = {}) => fetch(url, { method: \"POST\", headers, body }) });\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  }\n}\n\ntest(\"signatures support rotation and require the exact raw body\", () => {\n  const body = JSON.stringify(event(\"evt_rotation\"), null, 2) + \"\\n\";\n  const header = `${signed(body, NOW, \"wrong\")},v1=${computeSignature(SECRET, NOW, body)}`;\n  assert.doesNotThrow(() => verifyWebhook(body, header, [OLD_SECRET, SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(body, signed(body, NOW, OLD_SECRET), [OLD_SECRET, SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body)), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\n  const body = JSON.stringify(event(\"evt_window\"));\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(body, signed(body, NOW + offset), [SECRET], NOW));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(body, signed(body, NOW + offset), [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"missing, malformed, and ambiguous signature headers fail closed\", () => {\n  const body = JSON.stringify(event(\"evt_malformed\"));\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`, `t=${NOW},v1=aa`,\n    `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW}.5,v1=${\"a\".repeat(64)}`,\n    `t=99999999999999999999,v1=${\"a\".repeat(64)}`, `${signed(body, NOW)},t=${NOW}`]) {\n    assert.throws(() => verifyWebhook(body, header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"replay verification checks fresh replay signatures with rotation and the same window\", () => {\n  const body = JSON.stringify(event(\"evt_replay_unit\"));\n  const sig = `v1=${computeSignature(\"wrong\", NOW, body)},v1=${computeSignature(SECRET, NOW, body)}`;\n  assert.doesNotThrow(() => verifyReplayWebhook(body, String(NOW), sig, [OLD_SECRET, SECRET], NOW));\n  for (const offset of [-301, 301]) {\n    const time = NOW + offset;\n    assert.throws(() => verifyReplayWebhook(body, String(time),\n      `v1=${computeSignature(SECRET, time, body)}`, [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyReplayWebhook(body + \" \", String(NOW), sig, [SECRET], NOW), SignatureError);\n});\n\ntest(\"HTTP authentication failures never change any state\", async () => withApp(async ({ post, dir }) => {\n  const body = JSON.stringify(event(\"evt_forbidden\"));\n  const before = snapshot(dir);\n  const now = Math.floor(Date.now() / 1000);\n  const valid = signed(body, now);\n  for (const headers of [\n    {},\n    { \"paygate-signature\": signed(body, now, \"wrong\") },\n    { \"paygate-signature\": signed(body, now - 3600) },\n    { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now) },\n    { \"paygate-signature\": valid, \"x-replay-timestamp\": \"invalid\", \"x-replay-signature\": \"v1=\" + \"a\".repeat(64) },\n    { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now), \"x-replay-signature\": \"v1=\" + \"a\".repeat(64) },\n    { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now - 3600),\n      \"x-replay-signature\": `v1=${computeSignature(SECRET, now - 3600, body)}` },\n    { \"paygate-signature\": valid, \"x-replay-timestamp\": String(now + 3600),\n      \"x-replay-signature\": `v1=${computeSignature(SECRET, now + 3600, body)}` },\n  ]) {\n    const res = await post(body, headers);\n    assert.equal(res.status, 401);\n    await res.json();\n    assert.deepEqual(snapshot(dir), before);\n  }\n  const invalidBody = \"not JSON\";\n  const res = await post(invalidBody);\n  assert.equal(res.status, 401); // Authenticate before parsing, even for invalid JSON.\n  await res.json();\n  assert.deepEqual(snapshot(dir), before);\n}));\n\ntest(\"correctly signed invalid events return 4"]
[108.640856, "i", "00\", async () => withApp(async ({ post }) => {\n  for (const body of [\"{\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(\"evt_bad\"), created: \"yesterday\" }),\n    JSON.stringify(event(\"evt_bad_amount\", \"refund.requested\", { amount: -1 })),\n    JSON.stringify(event(\"evt_bad_currency\", \"refund.requested\", { currency: \"\" }))]) {\n    const res = await post(body, { \"paygate-signature\": signed(body) });\n    assert.equal(res.status, 400, body);\n    await res.json();\n  }\n}));\n\ntest(\"HTTP duplicates preserve refunds, audit, state, and original raw events\", async () => withApp(async ({ post, store, dir }) => {\n  const original = JSON.stringify(event(\"evt_once\"), null, 2);\n  let res = await post(original, { \"paygate-signature\": signed(original) });\n  assert.equal(res.status, 200);\n  assert.deepEqual(await res.json(), { received: true, duplicate: false });\n  const before = snapshot(dir);\n  const changed = JSON.stringify(event(\"evt_once\", \"refund.requested\", { amount: 900_000 }));\n  const responses = await Promise.all(Array.from({ length: 4 }, () => post(changed, { \"paygate-signature\": signed(changed) })));\n  for (res of responses) {\n    assert.equal(res.status, 200);\n    assert.deepEqual(await res.json(), { received: true, duplicate: true });\n  }\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 1);\n  const restarted = new Store(dir);\n  assert.equal(processEvent(restarted, POLICY, parseEvent(changed)).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  res = await post(origin"]
[108.641383, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[108.641407, "i", "al, { \"paygate-signature\": signed(original, Math.floor(Date.now() / 1000), \"wrong\") });\n  assert.equal(res.status, 401); // Duplicates must still authenticate.\n  await res.json();\n  assert.deepEqual(snapshot(dir), before);\n}));\n\ntest(\"replays ignore original authentication and deduplicate with normal deliveries\", async () => withApp(async ({ post, dir }) => {\n  const body = JSON.stringify(event(\"evt_replay_http\"));\n  const now = Math.floor(Date.now() / 1000);\n  const headers = { \"x-replay-timestamp\": String(now),\n    \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}` };\n  let res = await post(body, headers); // No original signature needed.\n  assert.equal(res.status, 200);\n  assert.deepEqual(await res.json(), { received: true, duplicate: false });\n  const before = snapshot(dir);\n  res = await post(body, { ...headers, \"paygate-signature\": \"invalid original signature\" });\n  assert.equal(res.status, 200);\n  assert.deepEqual(await res.json(), { received: true, duplicate: true });\n  res = await post(body, { \"paygate-signature\": signed(body) });\n  assert.equal(res.status, 200);\n  assert.deepEqual(await res.json(), { received: true, duplicate: true });\n  assert.deepEqual(snapshot(dir), before);\n}));\n\ntest(\"unknown event types are acknowledged and deduplicated without refunds\", async () => withApp(async ({ post, store, dir }) => {\n  const body = JSON.stringify({ event_id: \"evt_unknown\", created: NOW, type: \"payment.updated\", data: {} });\n  let res = await post(body, { \"paygate-signature\": signed(body) });\n  assert.equal(res.status, 200);\n  assert.deepEqual(await res.json(), { received: true, duplicate: false });\n  assert.equal(store.listRefunds().length, 0);\n  const before = snapshot(dir);\n  res = await post(body, { \"paygate-signature\": signed(body) });\n  assert.equal(res.status, 200);\n  assert.deepEqual(await res.json(), { received: true, duplicate: true });\n  assert.deepEqual(snapshot(dir), before);\n}));\n\ntest(\"cancellation duplicates do not repeat audits or mutations\", async () => withApp(async ({ store, dir }) => {\n  for (const amount of [500_000, 500_001]) {\n    const refund_id = `rf_${amount}`;\n    processEvent(store, POLICY, event(`evt_req_${amount}`, \"refund.requested\", { amount, refund_id }));\n    const cancel = event(`evt_cancel_${amount}`, \"refund.cancelled\", { refund_id });\n    processEvent(store, POLICY, cancel);\n    assert.equal(store.findByPaygateId(refund_id)[0].status, amount === 500_000 ? \"auto_approved\" : \"cancelled\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  }\n}));\n\ntest(\"failed processing does not mark an event processed\", async () => withApp(async ({ store }) => {\n  assert.throws(() => processEvent(store, POLICY, event(\"evt_retry\", \"refund.requested\", { amount: 0 })), EventError);\n  assert.equal(store.isProcessed(\"evt_retry\"), false);\n  assert.equal(processEvent(store, POLICY, event(\"evt_retry\")).outcome, \"processed\");\n}));\n\ntest(\"event IDs matching object prototype properties are processed exactly once\", async () => withApp(async ({ store, dir }) => {\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n    assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");\n  }\n}));\n\ntest(\"configured policy follows Dana's inclusive INR-only threshold\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 499_999, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\nEOF\nnpm test\n"]
[108.645077, "o", "\u001b[?2004h> p = Path('src/refunds.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('''  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");''', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\r\n\u001b[?2004l\r\u001b[?2004h>   if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\r\n\u001b[?2004l\r\u001b[?2004h>     if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\r\n\u001b[?2004l\r\u001b[?2004h>       throw new EventError(\"missing data.refund_id\");\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('!Number.isInteger(amount)', '!Number.isSafeInteger(amount)').replace('typeof currency !== \"string\")', 'typeof currency !== \"string\" || !currency)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/server.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('  replay_tolerance_s: number;', '  /** Legacy setting; replay authentication uses tolerance_s, just like normal deliveries. */\\n  replay_tolerance_s: number;')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.', '// Load legacy replay-window settings for compatibility; they do not affect authentication.')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('README.md')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('signature windows (`paygate.json`: `tolerance_s`, `replay_tolerance_s`; `PAYGATE_REPLAY_TOLERANCE_S` overrides the latter)', 'signature window (`paygate.json`: `tolerance_s`, applied to both normal deliveries and authenticated replay headers)')\r\n\u001b[?2004l\r\u001b[?2004h> s += '\\nReplays must authenticate with fresh `X-Replay-Timestamp` and `X-Replay-Signature` headers.\\nThe stored original signature is not used for replay authentication. Legacy\\n`replay_tolerance_s` / `PAYGATE_REPLAY_TOLERANCE_S` settings do not widen this window.\\n'\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\r\n  try {\r\n    await run({ store, dir, post: (body, headers = {}) => fetch(url, { method: \"POST\", headers, body }) });\r\n  } finally {\r\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\r\n    rmSync(dir, { recursive: true, force: true });\r\n  }\r\n}\r\n\r\ntest(\"signatures support rotation and require the exact raw body\", () => {\r\n  const body = JSON.stringify(event(\"evt_rotation\"), null, 2) + \"\\n\";\r\n  const header = `${signed(body, NOW, \"wrong\")},v1=${computeSignature(SECRET, NOW, body)}`;\r\n  assert.doesNotThrow(() => verifyWebhook(body, header, [OLD_SECRET, SECRET], NOW));\r\n  assert.doesNotThrow(() => verifyWebhook(body, signed(body, NOW, OLD_SECRET), [OLD_SECRET, SECRET], NOW));\r\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body)), header, [SECRET], NOW), SignatureError);\r\n  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);\r\n});\r\n\r\ntest(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\r\n  const body = JSON.stringify(event(\"evt_window\"));\r\n  for (const offset of [-300, 300]) {\r\n    assert.doesNotThrow(() => verifyWebhook(body, signed(body, NOW + offset), [SECRET], NOW));\r\n  }\r\n  for (const offset of [-301, 301]) {\r\n    assert.throws(() => verifyWebhook(body, signed(body, NOW + offset), [SECRET], NOW), SignatureError);\r\n  }\r\n});\r\n\r\ntest(\"missing, malformed, and ambiguous signature headers fail closed\", () => {\r\n  const body = JSON.stringify(event(\"evt_malformed\"));\r\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`, `t=${NOW},v1=aa`,\r\n    `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW}.5,v1=${\"a\".repeat(64)}`,\r\n    `t=99999999999999999999,v1=${\"a\".repeat(64)}`, `${signed(body, NOW)},t=${NOW}`]) {\r\n    assert.throws(() => ve"]
