[142.712303, "i", "export GIT_PAGER=cat PAGER=cat\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('test/pay381.test.ts')\ns = p.read_text().replace('import assert from \"node:assert/strict\";', 'import assert from \"node:assert/strict\";\\nimport { createHmac } from \"node:crypto\";')\ns += '''\ntest(\"HTTP verification authenticates exact received bytes before UTF-8 decoding\", async () => withApp(async ({ post }) => {\n  const [before, after] = JSON.stringify(event(\"evt_bytes\", \"refund.requested\", { reason: \"SENTINEL\" })).split(\"SENTINEL\");\n  const body = Buffer.concat([Buffer.from(before), Buffer.from([0xff, 0xfe]), Buffer.from(after)]);\n  const now = Math.floor(Date.now() / 1000);\n  const digest = createHmac(\"sha256\", SECRET).update(`${now}.`).update(body).digest(\"hex\");\n  let res = await post(body, { \"paygate-signature\": `t=${now},v1=${digest}` });\n  assert.equal(res.status, 200);\n  assert.deepEqual(await res.json(), { received: true, duplicate: false });\n  res = await post(body.toString(\"utf8\"), { \"paygate-signature\": `t=${now},v1=${digest}` });\n  assert.equal(res.status, 401);\n  await res.json();\n}));\n'''\np.write_text(s)\nPY\nnpm test; git --no-pager diff --check; git --no-pager diff --stat\n"]
[142.717197, "o", "export GIT_PAGER=cat PAGER=cat\r\n\u001b[?2004l\r\u001b[?2004hroot@871a9579edef:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('test/pay381.test.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('import assert from \"node:assert/strict\";', 'import assert from \"node:assert/strict\";\\nimport { createHmac } from \"node:crypto\";')\r\n\u001b[?2004l\r\u001b[?2004h> s += '''\r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP verification authenticates exact received bytes before UTF-8 decoding\", async () => withApp(async ({ post }) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[142.717647, "o", "> "]
[142.718133, "o", "  const [before, after] = JSON.stringify(event(\"evt_bytes\", \"refund.requested\", { reason: \"SENTINEL\" })).split(\"SENTINEL\");\r\n\u001b[?2004l\r"]
[142.718493, "o", "\u001b[?2004h> "]
[142.720313, "o", "  const body = Buffer.concat([Buffer.from(before), Buffer.from([0xff, 0xfe]), Buffer.from(after)]);\r\n\u001b[?2004l\r\u001b[?2004h>   const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>   const digest = createHmac(\"sha256\", SECRET).update(`${now}.`).update(body).digest(\"hex\");\r\n\u001b[?2004l\r\u001b[?2004h>   let res = await post(body, { \"paygate-signature\": `t=${now},v1=${digest}` });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(res.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await res.json(), { received: true, duplicate: false });\r\n\u001b[?2004l\r\u001b[?2004h>   res = await post(body.toString(\"utf8\"), { \"paygate-signature\": `t=${now},v1=${digest}` });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(res.status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>   await res.json();\r\n\u001b[?2004l\r\u001b[?2004h> }));\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[142.747961, "o", "\u001b[?2004hroot@871a9579edef:/app# npm test; git --no-pager diff --check; git --no-pager diff --stat\r\n\u001b[?2004l\r"]
[142.865406, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[142.865959, "o", "\u001b[1G\u001b[0K"]
[143.086293, "o", "\u001b[32m✔ signatures support rotation and require the exact raw body \u001b[90m(2.307301ms)\u001b[39m\u001b[39m\r\n"]
[143.086825, "o", "\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.581814ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing, malformed, and ambiguous signature headers fail closed \u001b[90m(0.414533ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ replay verification checks fresh replay signatures with rotation and the same window \u001b[90m(0.838279ms)\u001b[39m\u001b[39m\r\n"]
[143.127527, "o", "\u001b[32m✔ HTTP authentication failures never change any state \u001b[90m(83.001004ms)\u001b[39m\u001b[39m\r\n"]
[143.153185, "o", "\u001b[32m✔ correctly signed invalid events return 400 \u001b[90m(21.5954ms)\u001b[39m\u001b[39m\r\n"]
[143.205536, "o", "\u001b[32m✔ HTTP duplicates preserve refunds, audit, state, and original raw events \u001b[90m(56.650675ms)\u001b[39m\u001b[39m\r\n"]
[143.215647, "o", "\u001b[32m✔ replays ignore original authentication and deduplicate with normal deliveries \u001b[90m(10.60791ms)\u001b[39m\u001b[39m\r\n"]
[143.227398, "o", "\u001b[32m✔ unknown event types are acknowledged and deduplicated without refunds \u001b[90m(7.748278ms)\u001b[39m\u001b[39m\r\n"]
[143.232973, "o", "\u001b[32m✔ cancellation duplicates do not repeat audits or mutations \u001b[90m(4.65211ms)\u001b[39m\u001b[39m\r\n"]
[143.234259, "o", "\u001b[32m✔ failed processing does not mark an event processed \u001b[90m(1.811758ms)\u001b[39m\u001b[39m\r\n"]
[143.234605, "o", "\u001b[32m✔ event IDs matching object prototype properties are processed exactly once \u001b[90m(3.466783ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy follows Dana's inclusive INR-only threshold \u001b[90m(0.285306ms)\u001b[39m\u001b[39m\r\n"]
[143.241143, "o", "\u001b[32m✔ HTTP verification authenticates exact received bytes before UTF-8 decoding \u001b[90m(8.116415ms)\u001b[39m\u001b[39m\r\n"]
[143.255913, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.092727ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.747765ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.398628ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.259662ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.193976ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.849265ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.732336ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.089006ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(33.161512ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 23\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 23\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 342.975557\u001b[39m\r\n"]
[143.262893, "o", "\u001b[1G\u001b[0K⠙"]
[143.264077, "o", "\u001b[1G"]
