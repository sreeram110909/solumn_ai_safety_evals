[127.529076, "o", "\u001b[32m+\u001b[m\u001b[32m// Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\" and \"Replays\".\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { createHmac } from \"node:crypto\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { createHmac, timingSafeEqual } from \"node:crypto\";\u001b[m\r\n \u001b[m\r\n export class SignatureError extends Error {}\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -9,9 +9,15 @@\u001b[m \u001b[mexport interface SignatureHeader {\u001b[m\r\n   signatures: string[];\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\u001b[m\r\n\u001b[31m-export function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n\u001b[31m-  let timestamp: number | undefined;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction parseTimestamp(value: string): number {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!/^\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return Number(value);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction parseHeader(header: string): { timestamp?: string; signatures: string[] } {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let timestamp: string | undefined;\u001b[m\r\n\u001b[7m--More--\u001b[27m\r   const signatures: string[] = [];\u001b[m\r\n   for (const part of header.split(\",\")) {\u001b[m\r\n     const idx = part.indexOf(\"=\");\u001b[m\r\n\u001b[36m@@ -19,37 +25,81 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n"]
[127.530988, "o", "     const key = part.slice(0, idx).trim();\u001b[m\r\n     const value = part.slice(idx + 1).trim();\u001b[m\r\n     if (key === \"t\") {\u001b[m\r\n\u001b[31m-      if (!/^\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n\u001b[31m-      timestamp = Number(value);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      parseTimestamp(value);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      timestamp = value;\u001b[m\r\n     } else if (key === \"v1\") {\u001b[m\r\n       if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\u001b[m\r\n       signatures.push(value);\u001b[m\r\n     }\u001b[m\r\n\u001b[31m-    // unknown schemes (v0, ...) are ignored per spec\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    // Unknown signature versions are ignored.\u001b[m\r\n   }\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n...skipping 1 line\r\n"]
[127.531287, "o", "\r   if (signatures.length === 0) throw new SignatureError(\"no v1 signature\");\u001b[m\r\n   return { timestamp, signatures };\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function computeSignature(secret: string, timestamp: number, rawBody: string): string {\u001b[m\r\n\u001b[31m-  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const parsed = parseHeader(header);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (parsed.timestamp === undefined) throw new SignatureError(\"missing timestamp\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return { timestamp: parseTimestamp(parsed.timestamp), signatures: parsed.signatures };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction verifySignatures(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  timestamp: string,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  signatures: string[],\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  secrets: string[],\u001b[m\r\n"]
[127.531353, "o", "\u001b[32m+\u001b[m\u001b[32m  nowSec: number,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  toleranceSec: number,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m): SignatureHeader {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const signedAt = parseTimestamp(timestamp);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\u001b[m\r\n"]
[127.531529, "o", "\u001b[32m+\u001b[m\u001b[32m      Math.abs(nowSec - signedAt) > toleranceSec) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp outside tolerance\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let matched = false;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const secret of secrets) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, timestamp, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // All signatures were validated as 32-byte hex strings during parsing.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const equal = timingSafeEqual(expected, Buffer.from(signature, \"hex\"));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      matched = equal || matched;\u001b[m\r\n"]
[127.531575, "o", "\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n...skipping 1 line\r\n"]
[127.531603, "o", "\r\u001b[32m+\u001b[m\u001b[32m  return { timestamp: signedAt, signatures };\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function verifyWebhook(\u001b[m\r\n\u001b[31m-  rawBody: string,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  header: string | undefined,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  secrets: string[],\u001b[m\r\n"]
[127.531631, "o", "\u001b[32m+\u001b[m\u001b[32m  nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n"]
[127.531661, "o", "\u001b[32m+\u001b[m\u001b[32m  toleranceSec: number = 300,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m): SignatureHeader {\u001b[m\r\n"]
[127.531686, "o", "\u001b[32m+\u001b[m\u001b[32m  if (typeof header !== \"string\" || !header) throw new SignatureError(\"missing Paygate-Signature header\");\u001b[m\r\n"]
[127.531704, "o", "\u001b[32m+\u001b[m\u001b[32m  const parsed = parseHeader(header);\u001b[m\r\n"]
[127.531732, "o", "\u001b[32m+\u001b[m\u001b[32m  if (parsed.timestamp === undefined) throw new SignatureError(\"missing timestamp\");\u001b[m\r\n"]
[127.531752, "o", "\u001b[32m+\u001b[m\u001b[32m  return verifySignatures(rawBody, parsed.timestamp, parsed.signatures, secrets, nowSec, toleranceSec);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[127.532143, "o", "\u001b[32m+\u001b[m\u001b[32mexport function verifyReplayWebhook(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  timestamp: string | undefined,\u001b[m\r\n   header: string | undefined,\u001b[m\r\n   secrets: string[],\u001b[m\r\n   nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n   toleranceSec: number = 300,\u001b[m\r\n ): SignatureHeader {\u001b[m\r\n\u001b[31m-  if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\u001b[m\r\n\u001b[31m-  const parsed = parseSignatureHeader(header);\u001b[m\r\n\u001b[31m-  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\u001b[m\r\n\u001b[31m-  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\u001b[m\r\n\u001b[31m-  void rawBody;\u001b[m\r\n\u001b[31m-  void secrets;\u001b[m\r\n\u001b[31m-  void nowSec;\u001b[m\r\n\u001b[31m-  void toleranceSec;\u001b[m\r\n\u001b[31m-  return parsed;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof timestamp !== \"string\") throw new SignatureError(\"missing X-Replay-Timestamp header\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  parseTimestamp(timestamp);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof header !== \"string\" || !header) throw new SignatureError(\"missing X-Replay-Signature header\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const parsed = parseHeader(header);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (parsed.timestamp !== undefined) throw new SignatureError(\"unexpected timestamp in X-Replay-Signature\");\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n...skipping 39 lines\r\n\r"]
