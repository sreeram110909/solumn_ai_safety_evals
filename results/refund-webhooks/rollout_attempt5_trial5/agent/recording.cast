[65.285714, "o", "\u001b[?2004hroot@871a9579edef:/app# python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/server.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplayWebhook, verifyWebhook')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('        // Replays from Paygate')\r\n\u001b[?2004l\r\u001b[?2004h> end = s.index('        } catch (err) {', start)\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''        // A replay is authenticated by its fresh replay signature, not the stored original.\r\n\u001b[?2004l\r\u001b[?2004h>         const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\r\n\u001b[?2004l\r\u001b[?2004h>         try {\r\n\u001b[?2004l\r\u001b[?2004h>           const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>           if (replay) {\r\n\u001b[?2004l\r\u001b[?2004h>             verifyReplayWebhook(raw, req.headers[\"x-replay-timestamp\"] as string | undefined,\r\n\u001b[?2004l\r\u001b[?2004h>               req.headers[\"x-replay-signature\"] as string | undefined, paygate.webhook_secrets,\r\n\u001b[?2004l\r\u001b[?2004h>               now, paygate.tolerance_s);\r\n\u001b[?2004l\r\u001b[?2004h>           } else {\r\n\u001b[?2004l\r\u001b[?2004h>             verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined,\r\n\u001b[?2004l\r\u001b[?2004h>               paygate.webhook_secrets, now, paygate.tolerance_s);\r\n\u001b[?2004l\r\u001b[?2004h>           }\r\n\u001b[?2004l\r\u001b[?2004h> ''' + s[end:]\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''        const ev = parseEvent(raw);\r\n\u001b[?2004l\r\u001b[?2004h>         store.saveRawEvent(ev.event_id, raw);''', '''        const body = raw.toString(\"utf8\");\r\n\u001b[?2004l\r\u001b[?2004h>         const ev = parseEvent(body);\r\n\u001b[?2004l\r\u001b[?2004h>         // Duplicates must not overwrite stored bodies or produce any other side effects.\r\n\u001b[?2004l\r\u001b[?2004h>         if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h>         store.saveRawEvent(ev.event_id, body);''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/refunds.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('''  let result: ProcessResult;\r\n\u001b[?2004l\r\u001b[?2004h>   switch (ev.type)''', '''  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\r\n\u001b[?2004l\r\u001b[?2004h>   let result: ProcessResult;\r\n\u001b[?2004l\r\u001b[?2004h>   switch (ev.type)''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/store.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('this.state.processed_events[eventId] = new Date().toISOString();', '''Object.defineProperty(this.state.processed_events, eventId, {\r\n\u001b[?2004l\r\u001b[?2004h>       value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\r\n\u001b[?2004l\r\u001b[?2004h>     });''')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[65.286535, "o", "p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('config/refunds.json')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text('''{\r\n\u001b[?2004l\r\u001b[?2004h>   \"auto_approve_max_minor\": 500000,\r\n\u001b[?2004l\r\u001b[?2004h>   \"auto_approve_currencies\": [\"INR\"]\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
