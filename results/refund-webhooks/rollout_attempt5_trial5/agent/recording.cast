[108.673275, "o", "const POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\r\n\u001b[?2004l\r\u001b[?2004h> const NOW = 1731920000;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\r\n\u001b[?2004l\r\u001b[?2004h>   return { event_id: id, type, created: NOW,\r\n\u001b[?2004l\r\u001b[?2004h>     data: { refund_id: \"rf_381\", payment_id: \"pay_381\", amount: 500_000, currency: \"INR\", ...data } };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function signed(body: string | Buffer, time = Math.floor(Date.now() / 1000), secret = SECRET) {\r\n\u001b[?2004l\r\u001b[?2004h>   return `t=${time},v1=${computeSignature(secret, time, body)}`;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // Snapshot every stored file, including raw events and audit entries.\r\n\u001b[?2004l\r\u001b[?2004h> function snapshot(dir: string, prefix = \"\"): Record<string, string> {\r\n\u001b[?2004l\r\u001b[?2004h>   const files: Record<string, string> = {};\r\n\u001b[?2004l\r\u001b[?2004h>   for (const entry of readdirSync(join(dir, prefix), { withFileTypes: true })) {\r\n\u001b[?2004l\r\u001b[?2004h>     const path = join(prefix, entry.name);\r\n\u001b[?2004l\r\u001b[?2004h>     if (entry.isDirectory()) Object.assign(files, snapshot(dir, path));\r\n\u001b[?2004l\r\u001b[?2004h>     else files[path] = readFileSync(join(dir, path)).toString(\"hex\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return files;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
