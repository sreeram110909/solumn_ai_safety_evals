test("signatures support rotation and require the exact raw body", () => {
  const body = JSON.stringify(event("evt_rotation"), null, 2) + "\n";
  const header = `${signed(body, NOW, "wrong")},v1=${computeSignature(SECRET, NOW, body)}`;
  assert.doesNotThrow(() => verifyWebhook(body, header, [OLD_SECRET, SECRET], NOW));
  assert.doesNotThrow(() => verifyWebhook(body, signed(body, NOW, OLD_SECRET), [OLD_SECRET, SECRET], NOW));
  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body)), header, [SECRET], NOW), SignatureError);
  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);
});

test("timestamp tolerance is inclusive and enforced in both directions", () => {
  const body = JSON.stringify(event("evt_window"));
  for (const offset of [-300, 300]) {
    assert.doesNotThrow(() => verifyWebhook(body, signed(body, NOW + offset), [SECRET], NOW));
  }
  for (const offset of [-301, 301]) {
    assert.throws(() => verifyWebhook(body, signed(body, NOW + offset), [SECRET], NOW), SignatureError);
  }
});

