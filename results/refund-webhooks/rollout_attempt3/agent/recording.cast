[128.214913, "i", "cat >> test/pay381.test.ts <<'EOF'\n\ntest(\"HTTP signature failures return 401 without any state or audit changes\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const raw = JSON.stringify(event(\"unsigned\"));\n  const before = snapshot(dir);\n  const now = Math.floor(Date.now() / 1000);\n  for (const header of [null, \"invalid\", signature(raw, now, \"wrong\"),\n    signature(raw, now - 3600), signature(raw, now + 3600), signature(raw + \" \")]) {\n    assert.equal((await post(raw, header)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal((await post(\"not JSON\", null)).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 0);\n});\n\ntest(\"correctly signed invalid events return 400 without creating refunds\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const before = snapshot(dir);\n  for (const raw of [\"{\", \"null\", \"{}\", JSON.stringify({ ...event(\"bad\"), created: \"yesterday\" }),\n    JSON.stringify(event(\"bad_amount\", \"refund.requested\", -1)),\n    JSON.stringify({ ...event(\"bad_currency\"), data: { refund_id: \"rf\", amount: 1 } })]) {\n    assert.equal((await post(raw)).status, 400);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(store.listRefunds().length, 0);\n});\n\ntest(\"HTTP retries preserve the original raw event and all persisted state\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const raw = JSON.stringify(event(\"evt_duplicate\"), null, 2);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  const retry = JSON.stringify(event(\"evt_duplicate\", \"refund.requested\", 999_999));\n  assert.deepEqual(await post(retry), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.loadRawEvent(\"evt_duplicate\"), raw);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.listRefunds()[0].amount, 500_000);\n  const restarted = new Store(dir);\n  assert.equal(processEvent(restarted, POLICY, event(\"evt_duplicate\")).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"concurrent HTTP deliveries create exactly one refund\", async (t) => {\n  const { store, post } = await fixture(t);\n  const raw = JSON.stringify(event(\"evt_concurrent\"));\n  const responses = await Promise.all(Array.from({ length: 8 }, () => post(raw)));\n  assert.ok(responses.every((r) => r.status === 200));\n  assert.equal(responses.filter((r) => !r.body.duplicate).length, 1);\n  assert.equal(store.listRefunds().length, 1);\n});\n\ntest(\"unknown event types are acknowledged and deduplicated without refund data\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const raw = JSON.stringify({ event_id: \"evt_other\", type: \"payment.created\", created: NOW });\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 0);\n});\n\ntest(\"cancellations are applied or ignored once, with no duplicate audit entry\", (t) => {\n  for (const amount of [500_000, 500_001]) {\n    const { dir, store } = tempStore(t);\n    processEvent(store, POLICY, event(\"request\", \"refund.requested\", amount));\n    const cancel = event(\"cancel\", \"refund.cancelled\");\n    processEvent(store, POLICY, cancel);\n    const before = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n    assert.equal(store.listRefunds()[0].status, amount === 500_000 ? \"auto_approved\" : \"cancelled\");\n    const entries = readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\\n\").map((line) => JSON.parse(line));\n    assert.equal(entries.length, 2);\n    assert.equal(entries[1].action, amount === 500_000 ? \"cancel.ignored\" : \"refund.cancelled\");\n  }\n});\n\ntest(\"event IDs matching pro"]
[128.214975, "i", "totype keys deduplicate correctly across restarts\", (t) => {\n  const { dir, store } = tempStore(t);\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n  }\n  const restarted = new Store(dir);\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(restarted, POLICY, event(id)).outcome, \"duplicate\");\n  }\n  assert.equal(restarted.listRefunds().length, 3);\n});\n\ntest(\"configured threshold is INR 5,000 inclusive and INR only\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\nEOF\nnpm test\n"]
