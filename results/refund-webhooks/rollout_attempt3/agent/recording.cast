[128.228426, "o", "  assert.equal(restarted.listRefunds().length, 3);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.228606, "o", "test(\"configured threshold is INR 5,000 inclusive and INR only\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.228766, "o", "  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(policy.auto_approve_max_minor, 500_000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.228926, "o", "  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.228992, "o", "  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.229084, "o", "  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[128.229225, "o", "  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");"]
[128.229528, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[128.23152, "o", "\u001b[?2004hroot@f1f7e674a022:/app# npm test\r\n\u001b[?2004l\r"]
[128.330256, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[128.330761, "o", "\u001b[1G"]
[128.330869, "o", "\u001b[0K"]
[128.568297, "o", "\u001b[32m✔ HMAC uses the exact original body bytes \u001b[90m(3.147704ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ secret rotation accepts any v1 matching any configured secret \u001b[90m(0.727666ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance includes its boundary in both directions \u001b[90m(0.431803ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.462315ms)\u001b[39m\u001b[39m\r\n"]
[128.634336, "o", "\u001b[32m✔ HTTP signature failures return 401 without any state or audit changes \u001b[90m(84.355983ms)\u001b[39m\u001b[39m\r\n"]
[128.659809, "o", "\u001b[32m✔ correctly signed invalid events return 400 without creating refunds \u001b[90m(28.127106ms)\u001b[39m\u001b[39m\r\n"]
[128.678147, "o", "\u001b[32m✔ HTTP retries preserve the original raw event and all persisted state \u001b[90m(14.388544ms)\u001b[39m\u001b[39m\r\n"]
[128.700037, "o", "\u001b[32m✔ concurrent HTTP deliveries create exactly one refund \u001b[90m(25.39507ms)\u001b[39m\u001b[39m\r\n"]
[128.7276, "o", "\u001b[32m✔ unknown event types are acknowledged and deduplicated without refund data \u001b[90m(11.141495ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancellations are applied or ignored once, with no duplicate audit entry \u001b[90m(5.425507ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs matching prototype keys deduplicate correctly across restarts \u001b[90m(11.974595ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured threshold is INR 5,000 inclusive and INR only \u001b[90m(0.315997ms)\u001b[39m\u001b[39m\r\n"]
[128.741732, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.514825ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.291699ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.774158ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.867429ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.400978ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.708884ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.118609ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.557584ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 20\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 20\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 360.147485\u001b[39m\r\n"]
[128.748428, "o", "\u001b[1G\u001b[0K⠙"]
