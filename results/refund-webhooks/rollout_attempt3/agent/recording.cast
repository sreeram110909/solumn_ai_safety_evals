[98.292104, "o", "\u001b[1mdiff --git a/config/refunds.json b/config/refunds.json\u001b[m\r\n\u001b[1mindex 01e3041..f72bae4 100644\u001b[m\r\n\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,5 +1,5 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n   \"auto_approve_currencies\": [\"INR\"],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\"\u001b[m\r\n"]
[98.292369, "o", "\u001b[32m+\u001b[m\u001b[32m  \"_note\": \"Finance-approved inclusive threshold: INR 5,000 (500000 paise); other currencies require manual review\"\u001b[m\r\n }\u001b[m\r\n\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..ac05961 100644\u001b[m\r\n\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -36,8 +36,15 @@\u001b[m \u001b[mexport function parseEvent(raw: string): PaygateEvent {\u001b[m\r\n   }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Unhandled event types need only a valid envelope; their payload is opaque.\u001b[m\r\n"]
[98.29255, "o", "\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (ev.type === \"refund.requested\") validateRequested(ev);\u001b[m"]
[98.292673, "o", "\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   return ev;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -46,19 +53,28 @@\u001b[m \u001b[mexport function decideStatus(policy: RefundPolicy, amount: number, currency: str\u001b[m\r\n   return currencyOk && amount <= policy.auto_approve_max_minor ? \"auto_approved\" : \"pending_review\";\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[98.436924, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { EventError, decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_test_pay381\";\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\n\nfunction event(id: string, type = \"refund.requested\", amount = 500_000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_1\", payment_id: \"pay_1\", amount, currency: \"INR\" } };\n}\n\n// Sign independently from the implementation under test.\nfunction signature(raw: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(raw).digest(\"hex\");\n  return `t=${timestamp},v1=${digest}`;\n}\n\nfunction tempStore(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return { dir, store: new Store(dir) };\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  const files: Record<string, string> = {};\n  for (const entry of readdirSync(dir, { withFileTypes: true })) {\n    const path = join(dir, entry.name);\n    if (entry.isDirectory()) {\n      for (const [name, value] of Object.entries(snapshot(path))) files[`${entry.name}/${name}`] = value;\n    } else {\n      files[entry.name] = readFileSync(path, \"utf8\");\n    }\n  }\n  return files;\n}\n\nasync function httpFixture(t: TestContext) {\n  const { dir, store } = tempStore(t);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [\"whsec_old\", SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((err) => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const base = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\n  async function post(raw: string | Buffer, header: string | null = signature(raw)) {\n    const response = await fetch(`${base}/webhooks/paygate`, {\n      method: \"POST\", headers: header === null ? {} : { \"Paygate-Signature\": header }, body: raw,\n    });\n    return { status: response.status, body: await response.json() };\n  }\n  return { dir, store, post };\n}\n\ntest(\"signatures cover the original body bytes, not parsed JSON\", () => {\n  const raw = '{ \"message\": \"₹5,000\", \"n\": 1 }\\n';\n  assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW), [SECRET], NOW));\n  assert.equal(computeSignature(SECRET, NOW, raw), signature(raw, NOW).split(\"v1=\")[1]);\n  const normalized = JSON.stringify(JSON.parse(raw));\n  assert.throws(() => verifyWebhook(normalized, signature(raw, NOW), [SECRET], NOW), SignatureError);\n  const bytes = Buffer.from([0xff, 0xfe, 0x00]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signature(bytes, NOW), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signature(bytes, NOW), [SECRET], NOW), SignatureError);\n});\n\ntest(\"rotation accepts any v1 matching any configured secret\", () => {\n  const raw = JSON.stringify(event(\"rotation\"));\n  const valid = signature(raw, NOW).split(\"v1=\")[1];\n  const invalid = \"0\".repeat(64);\n  for (const signatures of [[invalid, valid], [valid, invalid]]) {\n    for (const secrets of [[\"old\", SECRET], [SECRET, \"old\"]]) {\n      assert.doesNotThrow(() => verifyWebhook(raw,\n        `t=${NOW},${signatures.map((s) => `v1=${s}`).join(\",\")}`, secrets, NOW));\n"]
[98.437079, "i", "    }\n  }\n  assert.throws(() => verifyWebhook(raw, signature(raw, NOW), [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and applies in both directions\", () => {\n  const raw = \"{}\";\n  for (const delta of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW + delta), [SECRET], NOW));\n  }\n  for (const delta of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signature(raw, NOW + delta), [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, signature(raw, NOW + 11), [SECRET], NOW, 10), SignatureError);\n});\n\ntest(\"malformed or missing signature headers are rejected\", () => {\n  for (const header of [undefined, \"\", `v1=${\"a\".repeat(64)}`, `t=${NOW}`, `t=no,v1=${\"a\".repeat(64)}`,\n    `t=${NOW},v1=abc`, `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=99999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"invalid signatures return 401 without changing any stored state\", async (t) => {\n  const { dir, store, post } = await httpFixture(t);\n  const raw = JSON.stringify(event(\"unsigned\"));\n  const before = snapshot(dir);\n  for (const header of [null, \"invalid\", signature(raw, undefined, \"wrong\"),\n    signature(raw, Math.floor(Date.now() / 1000) - 3600),\n    signature(raw, Math.floor(Date.now() / 1000) + 3600), signature(raw + \" \")]) {\n    assert.equal((await post(raw, header)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal((await post(\"not JSON\", null)).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 0);\n});\n\ntest(\"correctly signed invalid events return 400 without creating refunds\", async (t) => {\n  const { dir, store, post } = await httpFixture(t);\n  const before = snapshot(dir);\n  for (const raw of [\"{\", \"null\", \"{}\", JSON.stringify({ ...event(\"bad\"), created: \"yesterday\" }),\n    JSON.stringify(event(\"bad_amount\", \"refund.requested\", -1)),\n    JSON.stringify({ ...event(\"bad_currency\"), data: { refund_id: \"rf\", amount: 1 } })]) {\n    assert.equal((await post(raw)).status, 400);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(store.listRefunds().length, 0);\n  assert.throws(() => parseEvent(\"null\"), EventError);\n});\n\ntest(\"HTTP retries do not overwrite raw events, mutate refunds, or append audit entries\", async (t) => {\n  const { dir, store, post } = await httpFixture(t);\n  const raw = JSON.stringify(event(\"evt_duplicate\"), null, 2);\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  const retry = JSON.stringify(event(\"evt_duplicate\", \"refund.requested\", 999_999));\n  assert.deepEqual(await post(retry), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.listRefunds()[0].amount, 500_000);\n  assert.equal(store.loadRawEvent(\"evt_duplicate\"), raw);\n  const restarted = new Store(dir);\n  assert.equal(processEvent(restarted, POLICY, parseEvent(retry)).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"concurrent HTTP deliveries create only one refund\", async (t) => {\n  const { store, post } = await httpFixture(t);\n  const raw = JSON.stringify(event(\"evt_concurrent\"));\n  const responses = await Promise.all(Array.from({ length: 8 }, () => post(raw)));\n  assert.ok(responses.every((r) => r.status === 200));\n  assert.equal(responses.filter((r) => !r.body.duplicate).length, 1);\n  assert.equal(store.listRefunds().length, 1);\n});\n\ntest(\"unknown event types are acknowledged and deduplicated without a refund payload\", async (t) => {\n  const { dir, store, post } = await httpFixture(t);\n  const raw = JSON.stringify({ event_id: \"evt_other\", type: \"payment.created\", created: NOW });\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  assert.deepEqua"]
[98.4386, "o", "\r\u001b[31m-  const { amount, currency } = ev.data;\u001b[m\r\n\u001b[31m-  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction validateRequested(ev: PaygateEvent): void {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { amount, currency, payment_id, reason } = ev.data;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency) {\u001b[m\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n   }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if ((payment_id !== undefined && typeof payment_id !== \"string\") ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      (reason !== undefined && typeof reason !== \"string\")) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new EventError(\"payment_id and reason must be strings\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  validateRequested(ev);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { amount, currency } = ev.data;\u001b[m\r\n   const now = new Date().toISOString();\u001b[m\r\n   const refund: Refund = {\u001b[m\r\n     id: store.newRefundId(),\u001b[m\r\n     paygate_refund_id: ev.data.refund_id,\u001b[m\r\n     payment_id: ev.data.payment_id ?? \"\",\u001b[m\r\n     amount: amount as number,\u001b[m\r\n\u001b[31m-    currency: currency.toUpperCase(),\u001b[m\r\n\u001b[31m-    status: decideStatus(policy, amount as number, currency),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    currency: currency!.toUpperCase(),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    status: decideStatus(policy, amount as number, currency!),\u001b[m\r\n     reason: ev.data.reason ?? \"\",\u001b[m\r\n     source_event_id: ev.event_id,\u001b[m\r\n     created_at: now,\u001b[m\r\n\u001b[36m@@ -84,6 +100,7 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n   let result: ProcessResult;\u001b[m\r\n   switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n\u001b[1mdiff --git a/src/server.ts b/src/server.ts\u001b[m\r\n\u001b[1mindex ddab826..f9e6c0f 100644\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[K/1.test.ts <<'EOF'\r"]
[98.438644, "i", "l(await post(raw), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 0);\n});\n\ntest(\"cancellation retries do not update or audit twice, including ignored cancellations\", (t) => {\n  for (const amount of [500_000, 500_001]) {\n    const { dir, store } = tempStore(t);\n    processEvent(store, POLICY, event(\"request\", \"refund.requested\", amount));\n    const cancel = event(\"cancel\", \"refund.cancelled\");\n    processEvent(store, POLICY, cancel);\n    const before = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n    assert.equal(store.listRefunds()[0].status, amount === 500_000 ? \"auto_approved\" : \"cancelled\");\n    const entries = readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\\n\").map((line) => JSON.parse(line));\n    assert.equal(entries.length, 2);\n    assert.equal(entries[1].action, amount === 500_000 ? \"cancel.ignored\" : \"refund.cancelled\");\n  }\n});\n\ntest(\"event IDs matching Object prototype keys are processed exactly once across restarts\", (t) => {\n  const { dir, store } = tempStore(t);\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n  }\n  const restarted = new Store(dir);\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(restarted, POLICY, event(id)).outcome, \"duplicate\");\n  }\n  assert.equal(restarted.listRefunds().length, 3);\n});\n\ntest(\"configured finance threshold is INR 5,000 inclusive, INR only\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\nEOF\nnpm test\n"]
