[128.066099, "o", "  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h>   t.after(() => new Promise<void>((resolve, reject) => {\r\n\u001b[?2004l\r\u001b[?2004h>     server.close((err) => err ? reject(err) : resolve());\r\n\u001b[?2004l\r\u001b[?2004h>     server.closeAllConnections();\r\n\u001b[?2004l\r\u001b[?2004h>   }));\r\n\u001b[?2004l\r\u001b[?2004h>   const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\r\n\u001b[?2004l\r\u001b[?2004h>   async function post(raw: string, header: string | null = signature(raw)) {\r\n\u001b[?2004l\r\u001b[?2004h>     const response = await fetch(url, { method: \"POST\", body: raw,\r\n\u001b[?2004l\r\u001b[?2004h>       headers: header === null ? {} : { \"Paygate-Signature\": header } });\r\n\u001b[?2004l\r\u001b[?2004h>     return { status: response.status, body: await response.json() };\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return { dir, store, post };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HMAC uses the exact original body bytes\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = '{ \"message\": \"₹5,000\", \"n\": 1 }\\n';\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW), [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(computeSignature(SECRET, NOW, raw), signature(raw, NOW).split(\"v1=\")[1]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
