ignatureError(\"timestamp outside tolerance\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const signatures = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\r\n\u001b[?2004l\r\u001b[?2004h>   let matched = false;\r\n\u001b[?2004l\r\u001b[?2004h>   for (const secret of secrets) {\r\n\u001b[?2004l\r\u001b[?2004h>     const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\r\n\u001b[?2004l\r\u001b[?2004h>     for (const signature of signatures) {\r\n\u001b[?2004l\r\u001b[?2004h>       // Header parsing guarantees equal-length SHA-256 digests. Check all pairs,\r\n\u001b[?2004l\r\u001b[?2004h>       // including during rotation, without a variable-time string comparison.\r\n\u001b[?2004l\r\u001b[?2004h>       if (timingSafeEqual(expected, signature)) matched = true;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (!matched) throw new SignatureError(\"invalid signature\");''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/refunds.ts')\r\n\u001b[?2004l\r\u001b[?2004h> "]
