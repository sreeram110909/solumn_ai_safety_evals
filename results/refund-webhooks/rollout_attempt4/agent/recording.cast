[51.174016, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('if (!/^\\\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\\n      timestamp = Number(value);', '''if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\n      if (!/^(0|[1-9]\\\\d*)$/.test(value) || !Number.isSafeInteger(Number(value))) {\n        throw new SignatureError(\"timestamp must be integer seconds\");\n      }\n      timestamp = Number(value);''')\ns = s.replace('rawBody: string): string {\\n  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");', 'rawBody: string | Buffer): string {\\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");')\ns = s.replace('  rawBody: string,', '  rawBody: string | Buffer,')\ns = s.replace('''  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\n  void rawBody;\n  void secrets;\n  void nowSec;\n  void toleranceSec;''', '''  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n\n  const signatures = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of signatures) {\n      // Header parsing guarantees equal-length SHA-256 digests. Check all pairs,\n      // including during rotation, without a variable-time string comparison.\n      if (timingSafeEqual(expected, signature)) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n', 'export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n\\n')\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>')\ns = s.replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('''        const ev = parseEvent(raw);\n        store.saveRawEvent(ev.event_id, raw);''', '''        const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        // A retry must not even overwrite the stored payload or append audit entries.\n        // Processing below is synchronous, so concurrent deliveries cannot interleave.\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('this.state.processed_events[eventId] = new Date().toISOString();', 'this.state.processed_events = { ...this.state.processed_events, [eventId]: new Date().toISOString() };')\np.write_text(s)\np = Path('config/refunds.json')\ns = p.read_text().replace('\"auto_approve_max_minor\": 0', '\"auto_approve_max_minor\": 500000').replace('auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review', 'Finance-approved: auto-approve INR refunds up to and including INR 5,000 (500000 paise)')\np.write_text(s)\nPY\nnpm test\n"]
