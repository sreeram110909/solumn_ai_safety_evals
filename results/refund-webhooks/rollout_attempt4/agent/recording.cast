[116.670511, "o", "\u001b[1mdiff --git a/src/verify.ts b/src/verify.ts\u001b[m\r\n\u001b[1mindex 967f906..1adc70b 100644\u001b[m\r\n\u001b[1m--- a/src/verify.ts\u001b[m\r\n\u001b[1m+++ b/src/verify.ts\u001b[m\r\n\u001b[36m@@ -1,6 +1,6 @@\u001b[m\r\n // Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\".\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { createHmac } from \"node:crypto\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { createHmac, timingSafeEqual } from \"node:crypto\";\u001b[m\r\n \u001b[m\r\n export class SignatureError extends Error {}\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -19,7 +19,10 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n"]
[116.670659, "o", "     const key = part.slice(0, idx).trim();\u001b[m\r\n     const value = part.slice(idx + 1).trim();\u001b[m\r\n     if (key === \"t\") {\u001b[m\r\n\u001b[31m-      if (!/^\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!/^(0|[1-9]\\d*)$/.test(value) || !Number.isSafeInteger(Number(value))) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n       timestamp = Number(value);\u001b[m\r\n     } else if (key === \"v1\") {\u001b[m\r\n       if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\u001b[m\r\n\u001b[36m@@ -32,12 +35,12 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n   return { timestamp, signatures };\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function computeSignature(secret: string, timestamp: number, rawBody: string): string {\u001b[m\r\n\u001b[31m-  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function computeSignature(secret: string, timestamp: number, rawBody: string | Buffer): string {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function verifyWebhook(\u001b[m\r\n\u001b[31m-  rawBody: string,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n   header: string | undefined,\u001b[m\r\n   secrets: string[],\u001b[m\r\n   nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n\u001b[36m@@ -45,11 +48,21 @@\u001b[m \u001b[mexport function verifyWebhook(\u001b[m\r\n ): SignatureHeader {\u001b[m\r\n   if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\u001b[m\r\n   const parsed = parseSignatureHeader(header);\u001b[m\r\n\u001b[31m-  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\u001b[m\r\n\u001b[31m-  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\u001b[m\r\n\u001b[31m-  void rawBody;\u001b[m\r\n\u001b[31m-  void secrets;\u001b[m\r\n\u001b[31m-  void nowSec;\u001b[m\r\n\u001b[31m-  void toleranceSec;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp outside tolerance\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const signatures = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let matched = false;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const secret of secrets) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // Header parsing guarantees equal-length SHA-256 digests. Check all pairs,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // including during rotation, without a variable-time string comparison.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timingSafeEqual(expected, signature)) matched = true;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!matched) throw new SignatureError(\"invalid signature\");\u001b[m\r\n   return parsed;\u001b[m\r\n }\u001b[m\r\n"]
[116.769041, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[116.769652, "o", "\u001b[1G\u001b[0K"]
[117.000918, "o", "\u001b[32m✔ signature rotation matches any configured secret and any v1 \u001b[90m(3.047403ms)\u001b[39m\u001b[39m\r\n"]
[117.001172, "o", "\u001b[32m✔ signatures cover exact bytes, including whitespace and non-UTF8 bytes \u001b[90m(0.978163ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp window is inclusive, symmetric, and configurable \u001b[90m(0.604508ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.512786ms)\u001b[39m\u001b[39m\r\n"]
[117.00153, "o", "\u001b[32m✔ configured threshold is INR 5000 inclusive and INR only \u001b[90m(1.120814ms)\u001b[39m\u001b[39m\r\n"]
[117.003737, "o", "\u001b[32m✔ dedup survives restart and covers cancellations and ignored events without writes \u001b[90m(10.951986ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs that match object properties are processed once \u001b[90m(4.951836ms)\u001b[39m\u001b[39m\r\n"]
[117.05063, "o", "\u001b[32m✔ HTTP invalid signatures return 401 without changing any state \u001b[90m(68.090014ms)\u001b[39m\u001b[39m\r\n"]
[117.078981, "o", "\u001b[32m✔ HTTP verifies before parsing and returns 400 for signed invalid events \u001b[90m(30.132017ms)\u001b[39m\u001b[39m\r\n"]
[117.095607, "o", "\u001b[32m✔ HTTP retries acknowledge duplicates without changing refund, raw event, or audit \u001b[90m(18.21609ms)\u001b[39m\u001b[39m\r\n"]
[117.10956, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.145743ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.041125ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.6439ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(19.39453ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.213699ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.020127ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.938225ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.244385ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 18\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 18\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 302.486372\u001b[39m\r\n"]
[117.11599, "o", "\u001b[1G\u001b[0K⠙"]
[117.117394, "o", "\u001b[1G"]
