[97.633551, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { once } from \"node:events\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync, statSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_regression\";\nconst NOW = 1731920000;\nconst POLICY = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n\nfunction signature(raw: string | Buffer, timestamp = NOW, secret = SECRET): string {\n  const digest = createHmac(\"sha256\", secret).update(`${timestamp}.`).update(raw).digest(\"hex\");\n  return `t=${timestamp},v1=${digest}`;\n}\n\nfunction event(id: string, type = \"refund.requested\", amount = 50_000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" } };\n}\n\nfunction tempDir(t: TestContext): string {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return dir;\n}\n\n// Include mtimes so even an identical rewrite is caught as a duplicate side effect.\nfunction snapshot(dir: string): unknown[] {\n  return readdirSync(dir).sort().map((name) => {\n    const path = join(dir, name);\n    const stat = statSync(path, { bigint: true });\n    return [name, stat.mtimeNs, stat.isDirectory() ? snapshot(path) : readFileSync(path, \"utf8\")];\n  });\n}\n\nasync function httpFixture(t: TestContext) {\n  const dir = tempDir(t);\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  server.listen(0, \"127.0.0.1\");\n  await once(server, \"listening\");\n  t.after(async () => {\n    server.closeAllConnections();\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n  });\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  async function post(raw: string, headers: Record<string, string> = {\n    \"Paygate-Signature\": signature(raw, Math.floor(Date.now() / 1000)),\n  }) {\n    const response = await fetch(`http://127.0.0.1:${address.port}/webhooks/paygate`, {\n      method: \"POST\", body: raw, headers,\n    });\n    return { status: response.status, body: await response.json() };\n  }\n  return { dir, store, post };\n}\n\ntest(\"signature rotation matches any configured secret and any v1\", () => {\n  const raw = JSON.stringify(event(\"evt_rotation\"));\n  const valid = signature(raw).split(\",\")[1];\n  for (const entries of [[`v1=${\"0\".repeat(64)}`, valid], [valid, `v1=${\"0\".repeat(64)}`]]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, `t=${NOW},${entries.join(\",\")}`, [\"old\", SECRET], NOW));\n  }\n  assert.throws(() => verifyWebhook(raw, signature(raw), [], NOW), SignatureError);\n});\n\ntest(\"signatures cover exact bytes, including whitespace and non-UTF8 bytes\", () => {\n  const raw = ` {\\n  \"event_id\": \"evt_raw\", \"description\": \"₹\"\\n}\\n`;\n  assert.doesNotThrow(() => verifyWebhook(raw, signature(raw), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), signature(raw), [SECRET], NOW), SignatureError);\n  const bytes = Buffer.from([0xff, 0xfe, 0x7b, 0x7d]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signature(bytes), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signature(bytes), [SECRET], NOW), SignatureError);\n});\n\ntest(\"timestamp window is inclusive, symmetric, and configurable\", () => {\n  const raw = \"{}\";\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, signature(raw, NOW + offset), [SECRET], NOW));\n  }\n "]
[97.633648, "i", " for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signature(raw, NOW + offset), [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, signature(raw, NOW - 11), [SECRET], NOW, 10), SignatureError);\n});\n\ntest(\"missing and malformed signature headers fail closed\", () => {\n  for (const header of [undefined, \"\", `v1=${\"0\".repeat(64)}`, `t=${NOW}`, `t=${NOW},v1=abc`,\n    `t=${NOW},t=${NOW},v1=${\"0\".repeat(64)}`, `t=Infinity,v1=${\"0\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"configured threshold is INR 5000 inclusive and INR only\", () => {\n  assert.equal(POLICY.auto_approve_max_minor, 500000);\n  assert.deepEqual(POLICY.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(POLICY, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(POLICY, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(POLICY, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"dedup survives restart and covers cancellations and ignored events without writes\", (t) => {\n  const dir = tempDir(t);\n  let store = new Store(dir);\n  const events = [event(\"evt_request\", \"refund.requested\", 500001),\n    event(\"evt_cancel\", \"refund.cancelled\"), event(\"evt_unknown\", \"future.event\")];\n  for (const ev of events) processEvent(store, POLICY, parseEvent(JSON.stringify(ev)));\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const before = snapshot(dir);\n  store = new Store(dir);\n  for (const ev of events) {\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\n  }\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"event IDs that match object properties are processed once\", (t) => {\n  const dir = tempDir(t);\n  const store = new Store(dir);\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n    assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");\n  }\n});\n\ntest(\"HTTP invalid signatures return 401 without changing any state\", async (t) => {\n  const { dir, post } = await httpFixture(t);\n  const raw = JSON.stringify(event(\"evt_rejected\"));\n  const now = Math.floor(Date.now() / 1000);\n  const before = snapshot(dir);\n  for (const headers of [{}, { \"X-Paygate-Replay-Token\": \"untrusted-replay-token\" },\n    { \"Paygate-Signature\": signature(raw, now, \"wrong-secret\") },\n    { \"Paygate-Signature\": signature(raw, now - 3600) },\n    { \"Paygate-Signature\": signature(raw, now + 3600) },\n    { \"Paygate-Signature\": signature(raw + \" \", now) },\n    { \"Paygate-Signature\": \"malformed\" }]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"HTTP verifies before parsing and returns 400 for signed invalid events\", async (t) => {\n  const { store, post } = await httpFixture(t);\n  for (const raw of [\"not json\", \"null\", \"{}\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", -1))]) {\n    assert.equal((await post(raw, {})).status, 401);\n    assert.equal((await post(raw)).status, 400);\n  }\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal(store.isProcessed(\"evt_invalid\"), false);\n});\n\ntest(\"HTTP retries acknowledge duplicates without changing refund, raw event, or audit\", async (t) => {\n  const { dir, store, post } = await httpFixture(t);\n  const raw = `\\n${JSON.stringify(event(\"evt_http\"), null, 2)}\\n`;\n  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot(dir);\n  const changed = JSON.stringify(event(\"evt_http\", \"refund.cancelled\"));\n  const replies = await Promise.all([post(raw), post(changed), post(raw)]);\n  for (const reply of replies) {\n    assert.deepEqual(reply, { status: 200, body: { received: true, duplicate: true } });\n  }\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.loadRawEvent(\"evt_http\"), raw);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n});\nEOF\nnpm test\n"]
