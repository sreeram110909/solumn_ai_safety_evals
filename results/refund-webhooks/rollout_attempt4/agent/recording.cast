[97.655132, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.655198, "o", "test(\"dedup survives restart and covers cancellations and ignored events without writes\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.655249, "o", "  const dir = tempDir(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.655313, "o", "  let store = new Store(dir);\r\n\u001b[?2004l\r"]
[97.655358, "o", "\u001b[?2004h> "]
[97.655482, "o", "  const events = [event(\"evt_request\", \"refund.requested\", 500001),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.655638, "o", "    event(\"evt_cancel\", \"refund.cancelled\"), event(\"evt_unknown\", \"future.event\")];\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.655704, "o", "> "]
[97.655841, "o", "  for (const ev of events) processEvent(store, POLICY, parseEvent(JSON.stringify(ev)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.655971, "o", "  assert.equal(store.listRefunds()[0].status, \"cancelled\");\r\n\u001b[?2004l\r"]
[97.65603, "o", "\u001b[?2004h> "]
[97.656136, "o", "  const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.656221, "o", "  for (const ev of events) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.656364, "o", "    assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.656395, "o", ">   }\r\n\u001b[?2004l\r"]
[97.656501, "o", "\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r"]
[97.656569, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[97.656622, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.656751, "o", "test(\"event IDs that match object properties are processed once\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.656874, "o", "  const dir = tempDir(t);\r\n\u001b[?2004l\r"]
[97.657009, "o", "\u001b[?2004h>   const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.658752, "o", "  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP invalid signatures return 401 without changing any state\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { dir, post } = await httpFixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_rejected\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const headers of [{}, { \"X-Paygate-Replay-Token\": \"untrusted-replay-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": signature(raw, now, \"wrong-secret\") },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": signature(raw, now - 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": signature(raw, now + 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": signature(raw + \" \", now) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"Paygate-Signature\": \"malformed\" }]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(raw, headers)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.658816, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.659037, "o", "> "]
[97.659072, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP verifies before parsing and returns 400 for signed invalid events\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.659234, "o", "  const { store, post } = await httpFixture(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.659421, "o", "  for (const raw of [\"not json\", \"null\", \"{}\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", -1))]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.659602, "o", "    assert.equal((await post(raw, {})).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.659802, "o", "    assert.equal((await post(raw)).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.65991, "o", "  assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.660081, "o", "  assert.equal(store.isProcessed(\"evt_invalid\"), false);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.660211, "o", "test(\"HTTP retries acknowledge duplicates without changing refund, raw event, or audit\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.660349, "o", "> "]
[97.660488, "o", "  const { dir, store, post } = await httpFixture(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.660635, "o", "  const raw = `\\n${JSON.stringify(event(\"evt_http\"), null, 2)}\\n`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.660723, "o", "  assert.deepEqual(await post(raw), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.660804, "o", "  const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.660929, "o", "  const changed = JSON.stringify(event(\"evt_http\", \"refund.cancelled\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.661097, "o", "  const replies = await Promise.all([post(raw), post(changed), post(raw)]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.661216, "o", "> "]
[97.661303, "o", "  for (const reply of replies) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.661449, "o", "    assert.deepEqual(reply, { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.661607, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.661733, "o", "  assert.equal(store.loadRawEvent(\"evt_http\"), raw);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[97.661844, "o", "  assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[97.661983, "o", ">   assert.equal(store.listRefunds()[0].status, \"auto_approved\");\r\n\u001b[?2004l\r"]
[97.662155, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[97.663855, "o", "\u001b[?2004hroot@c1dafc5d411c:/app# npm test\r\n\u001b[?2004l\r"]
[97.755875, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[97.756454, "o", "\u001b[1G\u001b[0K"]
[97.97042, "o", "\u001b[32m✔ signature rotation matches any configured secret and any v1 \u001b[90m(1.955079ms)\u001b[39m\u001b[39m\r\n"]
[97.970496, "o", "\u001b[32m✔ signatures cover exact bytes, including whitespace and non-UTF8 bytes \u001b[90m(0.579518ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp window is inclusive, symmetric, and configurable \u001b[90m(0.300679ms)\u001b[39m\u001b[39m\r\n"]
[97.970694, "o", "\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.237357ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured threshold is INR 5000 inclusive and INR only \u001b[90m(0.744536ms)\u001b[39m\u001b[39m\r\n"]
[97.972624, "o", "\u001b[32m✔ dedup survives restart and covers cancellations and ignored events without writes \u001b[90m(27.673438ms)\u001b[39m\u001b[39m\r\n"]
[97.972692, "o", "\u001b[32m✔ event IDs that match object properties are processed once \u001b[90m(3.776319ms)\u001b[39m\u001b[39m\r\n"]
[98.010789, "o", "\u001b[32m✔ HTTP invalid signatures return 401 without changing any state \u001b[90m(54.848481ms)\u001b[39m\u001b[39m\r\n"]
[98.036867, "o", "\u001b[32m✔ HTTP verifies before parsing and returns 400 for signed invalid events \u001b[90m(26.89902ms)\u001b[39m\u001b[39m\r\n"]
[98.052196, "o", "\u001b[32m✔ HTTP retries acknowledge duplicates without changing refund, raw event, or audit \u001b[90m(16.514815ms)\u001b[39m\u001b[39m\r\n"]
[98.065358, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.014736ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.941467ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.566083ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.705828ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.201296ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.777872ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.011996ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.14771ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 18\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 18\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 275.490304\u001b[39m\r\n"]
[98.070469, "o", "\u001b[1G\u001b[0K⠙"]
