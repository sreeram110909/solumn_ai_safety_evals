test("signature rotation accepts any signature with any configured secret", () => {
  const raw = JSON.stringify(event("evt_rotation"));
  for (const key of [SECRET, OLD_SECRET]) {
    for (const signatures of [
      `v1=${"0".repeat(64)},${signed(raw, NOW, key).split(",")[1]}`,
      `${signed(raw, NOW, key).split(",")[1]},v1=${"0".repeat(64)}`,
    ]) {
      assert.doesNotThrow(() => verifyWebhook(raw, `t=${NOW},${signatures}`, [OLD_SECRET, SECRET], NOW));
    }
  }
  assert.throws(() => verifyWebhook(raw, signed(raw, NOW), [], NOW), SignatureError);
});

