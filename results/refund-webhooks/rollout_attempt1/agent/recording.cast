: SignatureHeader {\u001b[m\r\n   if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\u001b[m\r\n\u001b[31m-  const parsed = parseSignatureHeader(header);\u001b[m\r\n\u001b[31m-  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\u001b[m\r\n\u001b[31m-  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\u001b[m\r\n\u001b[31m-  void rawBody;\u001b[m\r\n\u001b[31m-  void secrets;\u001b[m\r\n\u001b[31m-  void nowSec;\u001b[m\r\n\u001b[31m-  void toleranceSec;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { timestampText, ...parsed } = parseHeader(header);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp outside tolerance\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Retain the exact timestamp text as well as the original body bytes for the HMAC.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const signatures = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let matched = false;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const secret of secrets) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // Do not short-circuit comparisons when a rotating key matches.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const matches = timingSafeEqual(expected, signature);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      matched = matches || matched;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u0