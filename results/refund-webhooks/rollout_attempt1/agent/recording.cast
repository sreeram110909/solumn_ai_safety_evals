));\n  }\n  for (const delta of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signed(raw, NOW + delta), [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, signed(raw, NOW + 11), [SECRET], NOW, 10), SignatureError);\n  assert.doesNotThrow(() => verifyWebhook(raw, signed(raw, `0${NOW}`), [SECRET], NOW));\n});\n\ntest(\"malformed and missing signature headers are rejected\", () => {\n  for (const header of [undefined, \"\", `v1=${\"a\".repeat(64)}`, `t=${NOW}`, `t=NaN,v1=${\"a\".repeat(64)}`,\n    `t=${NOW},v1=abc`, `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=99999999999999999999999999,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"configured refund policy follows Dana's inclusive INR threshold\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"deduplication persists across restart, including object-property event IDs\", (t) => {\n  const { dir, store } = fixture(t);\n  for (const id of [\"evt_persisted\", \"constructor\", \"__proto__\"]) {\n    const ev = parseEvent(JSON.stringify(event(id)));\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(new Store(dir).listRefunds().length, 3);\n});\n\ntest(\"cancellations, ignored cancellations and unknown events are deduplicated without audit changes\", (t) => {\n  const { dir, store } = fixture(t);\n  processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_request\", \"refund.requested\", { amount: 900000 }))));\n  for (const ev of [\n    event(\"evt_cancel\", \"refund.cancelled\"),\n    event(\"evt_cancel_"]
