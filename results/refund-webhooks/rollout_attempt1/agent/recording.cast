[109.118741, "o", "test(\"simultaneous webhook retries process an event once\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { post, store } = await httpFixture(t);\r\n\u001b[?2004l\r"]
[109.118841, "o", "\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_concurrent\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.118973, "o", "  const responses = await Promise.all(Array.from({ length: 8 }, () => post(raw)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.119116, "o", "  assert.ok(responses.every((response) => response.status === 200));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.119273, "o", "  assert.equal(responses.filter((response) => response.body.duplicate === false).length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[109.119405, "o", "  assert.equal(responses.filter((response) => response.body.duplicate === true).length, 7);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r"]
[109.119481, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[109.119512, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[109.121627, "o", "\u001b[?2004hroot@0e1291463b77:/app# npm test\r\n\u001b[?2004l\r"]
[109.215616, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[109.216154, "o", "\u001b[1G\u001b[0K"]
[109.440812, "o", "\u001b[32m✔ signature rotation accepts any signature with any configured secret \u001b[90m(2.924472ms)\u001b[39m\u001b[39m\r\n"]
[109.441727, "o", "\u001b[32m✔ timestamp tolerance is inclusive and applies in both directions \u001b[90m(0.656988ms)\u001b[39m\u001b[39m\r\n"]
[109.441798, "o", "\u001b[32m✔ malformed and missing signature headers are rejected \u001b[90m(0.391784ms)\u001b[39m\u001b[39m\r\n"]
[109.442025, "o", "\u001b[32m✔ configured refund policy follows Dana's inclusive INR threshold \u001b[90m(1.207488ms)\u001b[39m\u001b[39m\r\n"]
[109.442201, "o", "\u001b[32m✔ deduplication persists across restart, including object-property event IDs \u001b[90m(14.72103ms)\u001b[39m\u001b[39m\r\n"]
[109.442281, "o", "\u001b[32m✔ cancellations, ignored cancellations and unknown events are deduplicated without audit changes \u001b[90m(17.248902ms)\u001b[39m\u001b[39m\r\n"]
[109.442403, "o", "\u001b[32m✔ cancelling an auto-approved refund is audited just once \u001b[90m(3.007952ms)\u001b[39m\u001b[39m\r\n"]
[109.501977, "o", "\u001b[32m✔ HTTP rejects invalid signatures without touching state, even for duplicates \u001b[90m(74.49553ms)\u001b[39m\u001b[39m\r\n"]
[109.525871, "o", "\u001b[32m✔ HTTP signed invalid events return 400 and remain retryable \u001b[90m(27.153614ms)\u001b[39m\u001b[39m\r\n"]
[109.559908, "o", "\u001b[32m✔ HTTP verifies exact bytes and duplicate deliveries cannot overwrite events or audit \u001b[90m(28.233701ms)\u001b[39m\u001b[39m\r\n"]
[109.588515, "o", "\u001b[32m✔ simultaneous webhook retries process an event once \u001b[90m(36.29837ms)\u001b[39m\u001b[39m\r\n"]
[109.607661, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.025159ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.962429ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.555156ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.253406ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.378902ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.247475ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.861466ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.115076ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 354.891143\u001b[39m\r\n"]
[109.612817, "o", "\u001b[1G\u001b[0K⠙"]
[109.614079, "o", "\u001b[1G\u001b[0K"]
[109.617934, "o", "\u001b[?2004hroot@0e1291463b77:/app# "]
