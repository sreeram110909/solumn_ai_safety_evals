[117.102949, "o", "   }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Unhandled event types can have unrelated payloads; acknowledge and deduplicate them too.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type !== \"refund.requested\" && ev.type !== \"refund.cancelled\") return ev;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    validateRequested(ev);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if ((ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\")) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"payment_id and reason must be strings\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   return ev;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -46,19 +58,24 @@\u001b[m \u001b[mexport function decideStatus(policy: RefundPolicy, amount: number, currency: str\u001b[m\r\n   return currencyOk && amount <= policy.auto_approve_max_minor ? \"auto_approved\" : \"pending_review\";\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction validateRequested(ev: PaygateEvent): { amount: number; currency: string } {\u001b[m\r\n   const { amount, currency } = ev.data;\u001b[m\r\n\u001b[31m-  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency.trim()) {\u001b[m\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n   }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return { amount: amount as number, currency };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { amount, currency } = validateRequested(ev);\u001b[m\r\n   const now = new Date().toISOString();\u001b[m\r\n   const refund: Refund = {\u001b[m\r\n     id: store.newRefundId(),\u001b[m\r\n     paygate_refund_id: ev.data.refund_id,\u001b[m\r\n     payment_id: ev.data.payment_id ?? \"\",\u001b[m\r\n\u001b[31m-    amount: amount as number,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    amount,\u001b[m\r\n     currency: currency.toUpperCase(),\u001b[m\r\n\u001b[31m-    status: decideStatus(policy, amount as number, currency),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    status: decideStatus(policy, amount, currency),\u001b[m\r\n     reason: ev.data.reason ?? \"\",\u001b[m\r\n     source_event_id: ev.event_id,\u001b[m\r\n     created_at: now,\u001b[m\r\n\u001b[36m@@ -84,6 +101,7 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n   let result: ProcessResult;\u001b[m\r\n   switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n"]
