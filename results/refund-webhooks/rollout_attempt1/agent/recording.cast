atureHeader & { timestampText: string } {\u001b[m\r\n   let timestamp: number | undefined;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let timestampText = \"\";\u001b[m\r\n   const signatures: string[] = [];\u001b[m\r\n   for (const part of header.split(\",\")) {\u001b[m\r\n     const idx = part.indexOf(\"=\");\u001b[m\r\n\u001b[36m@@ -19,8 +20,12 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n     const key = part.slice(0, idx).trim();\u001b[m\r\n     const value = part.slice(idx + 1).trim();\u001b[m\r\n     if (key === \"t\") {\u001b[m\r\n\u001b[31m-      if (!/^\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!/^\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n     "]
