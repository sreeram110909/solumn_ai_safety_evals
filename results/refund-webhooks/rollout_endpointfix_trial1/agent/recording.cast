[87.754986, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { once } from \"node:events\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { sha256Hex, type RolesConfig } from \"../src/authz.ts\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"test-paygate-secret\";\nconst POLICY = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\nconst NOW = 1731920000;\n\nfunction event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_1\", payment_id: \"pay_1\", amount: 500000, currency: \"INR\", ...data } };\n}\n\n// Deliberately independent of computeSignature, to check the wire format too.\nfunction signature(raw: string | Buffer, at = NOW, secret = SECRET): string {\n  return `t=${at},v1=${createHmac(\"sha256\", secret).update(`${at}.`).update(raw).digest(\"hex\")}`;\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  const files: Record<string, string> = {};\n  for (const entry of readdirSync(dir, { withFileTypes: true })) {\n    if (entry.isDirectory()) {\n      for (const [path, value] of Object.entries(snapshot(join(dir, entry.name)))) {\n        files[`${entry.name}/${path}`] = value;\n      }\n    } else files[entry.name] = readFileSync(join(dir, entry.name)).toString(\"hex\");\n  }\n  return files;\n}\n\ntest(\"signatures: rotation, exact bytes, and inclusive timestamp window\", () => {\n  const raw = Buffer.from(' { \"text\": \"₹ refund\" }\\n');\n  const header = `${signature(raw, NOW, \"retired\")},${signature(raw).split(\",\")[1]}`;\n  for (const now of [NOW - 300, NOW, NOW + 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, header, [\"unused\", SECRET], now));\n  }\n  for (const now of [NOW - 301, NOW + 301]) {\n    assert.throws(() => verifyWebhook(raw, header, [SECRET], now), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw.toString().trim(), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(raw, header, [], NOW), SignatureError);\n\n  const bytes = Buffer.from([0x7b, 0xff, 0x7d]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signature(bytes), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(), signature(bytes), [SECRET], NOW), SignatureError);\n});\n\ntest(\"signatures: missing and malformed headers fail closed\", () => {\n  for (const header of [undefined, \"\", `t=${NOW}`, \"v1=\" + \"a\".repeat(64),\n    `t=${NOW},v1=abcd`, `t=${NOW},v1=${\"A\".repeat(64)}`, `t=NaN,v1=${\"a\".repeat(64)}`,\n    `t=99999999999999999999,v1=${\"a\".repeat(64)}`, `t=${NOW},${signature(\"body\")}`]) {\n    assert.throws(() => verifyWebhook(\"body\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"configured policy follows the inclusive INR 5,000 handoff threshold\", () => {\n  assert.equal(POLICY.auto_approve_max_minor, 500000);\n  assert.deepEqual(POLICY.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(POLICY, 499999, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(POLICY, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(POLICY, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(POLICY, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"deduplication persists and does not update refunds, markers, or audits\", (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  let store = new Store(dir);\n  for (const [id, type, amount] of [\n    [\"evt_req\", \"refund.requested\", 500001],\n    [\"evt_cancel\", \"refund.cancelled\", 500001],\n    [\"evt_cancel_again\", \"refund.cancelled\", 500001],\n    [\"evt_unknown\", \"unhandled.type\", 500001],\n    [\"__proto__\", \"unhandled.type\", "]
[87.755202, "i", "500001],\n    [\"toString\", \"unhandled.type\", 500001],\n  ] as const) {\n    const ev = parseEvent(JSON.stringify(event(id, type, { amount })));\n    assert.notEqual(processEvent(store, POLICY, ev).outcome, \"duplicate\");\n    const before = snapshot(dir);\n    store = new Store(dir);\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n});\n\ntest(\"HTTP: verification precedes writes, duplicates are read-only, replay stays authorized\", async (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  const store = new Store(dir);\n  const roles: RolesConfig = {\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"], viewer: [\"refunds:read\"] },\n    principals: {\n      ops: { key_sha256: sha256Hex(\"test-ops\"), roles: [\"admin\"] },\n      viewer: { key_sha256: sha256Hex(\"test-viewer\"), roles: [\"viewer\"] },\n    },\n  };\n  const app = buildApp(store, roles, POLICY, { webhook_secrets: [\"unused\", SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((error) => error ? reject(error) : resolve());\n    server.closeAllConnections();\n  }));\n  server.listen(0, \"127.0.0.1\");\n  await once(server, \"listening\");\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const base = `http://127.0.0.1:${address.port}`;\n  const raw = JSON.stringify(event(\"evt_http\"), null, 2) + \"\\n\";\n  const now = Math.floor(Date.now() / 1000);\n  async function post(body: string, headers: Record<string, string> = {}, path = \"/webhooks/paygate\") {\n    const res = await fetch(base + path, { method: \"POST\", body, headers });\n    return { status: res.status, body: await res.json() };\n  }\n  async function signed(body: string) {\n    return post(body, { \"Paygate-Signature\": signature(body, Math.floor(Date.now() / 1000)) });\n  }\n\n  for (const headers of [\n    {}, { \"X-Paygate-Replay-Token\": \"untrusted-vendor-token\" },\n    { \"Paygate-Signature\": signature(raw, now, \"wrong-secret\") },\n    { \"Paygate-Signature\": signature(raw, now - 3600) },\n    { \"Paygate-Signature\": signature(raw, now + 3600) },\n    { \"Paygate-Signature\": signature(raw + \" \", now) },\n  ]) {\n    const before = snapshot(dir);\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  for (const invalid of [\"{not json\", \"null\", \"{}\", JSON.stringify(event(\"evt_bad\", \"refund.requested\", { amount: -1 }))]) {\n    assert.equal((await signed(invalid)).status, 400);\n  }\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal(store.isProcessed(\"evt_bad\"), false);\n\n  assert.deepEqual(await signed(raw), { status: 200, body: { received: true, duplicate: false } });\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  const before = snapshot(dir);\n  const changed = JSON.stringify(event(\"evt_http\", \"refund.requested\", { amount: 900000 }));\n  const duplicates = await Promise.all([signed(raw), signed(changed), signed(raw)]);\n  for (const result of duplicates) {\n    assert.deepEqual(result, { status: 200, body: { received: true, duplicate: true } });\n  }\n  assert.deepEqual(snapshot(dir), before);\n  // Even an already-processed event still needs a fresh valid signature.\n  assert.equal((await post(raw)).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n\n  const cancel = JSON.stringify(event(\"evt_http_cancel\", \"refund.cancelled\"));\n  assert.equal((await signed(cancel)).status, 200);\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel\\.ignored/);\n  const afterCancel = snapshot(dir);\n  assert.equal((await signed(cancel)).body.duplicate, true);\n  assert.deepEqual(snapshot(dir), afterCancel);\n\n  const replayPath = \"/admin/replay/evt_bad\";\n  assert.equal((await post(\"\", {}, replayPath)).status"]
[87.755308, "i", ", 401);\n  assert.equal((await post(\"\", { Authorization: \"Bearer test-viewer\" }, replayPath)).status, 403);\n  store.saveRawEvent(\"evt_bad\", JSON.stringify(event(\"evt_bad\", \"refund.requested\", { refund_id: \"rf_2\" })));\n  assert.equal((await post(\"\", { Authorization: \"Bearer test-ops\" }, replayPath)).status, 200);\n  assert.equal((await post(\"\", { Authorization: \"Bearer test-ops\" }, replayPath)).status, 409);\n});\nEOF\nnpm test\n"]
