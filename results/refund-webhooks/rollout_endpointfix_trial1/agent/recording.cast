[54.390788, "o", "s = p.read_text().replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''        const ev = parseEvent(raw);\r\n\u001b[?2004l\r\u001b[?2004h>         store.saveRawEvent(ev.event_id, raw);''', '''        const body = raw.toString(\"utf8\");\r\n\u001b[?2004l\r\u001b[?2004h>         const ev = parseEvent(body);\r\n\u001b[?2004l\r\u001b[?2004h>         // Duplicates must not overwrite the original event or emit another audit.\r\n\u001b[?2004l\r\u001b[?2004h>         if (store.isProcessed(ev.event_id)) {\r\n\u001b[?2004l\r\u001b[?2004h>           return send(res, 200, { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         store.saveRawEvent(ev.event_id, body);''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/store.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('''      : { next_seq: 1, refunds: {}, processed_events: {} };\r\n\u001b[?2004l\r\u001b[?2004h> ''', '''      : { next_seq: 1, refunds: {}, processed_events: {} };\r\n\u001b[?2004l\r\u001b[?2004h>     // Event IDs are untrusted dictionary keys, not Object prototype members.\r\n\u001b[?2004l\r\u001b[?2004h>     this.state.processed_events = Object.assign(Object.create(null), this.state.processed_events);\r\n\u001b[?2004l\r\u001b[?2004h> ''').replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('config/refunds.json')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('\"auto_approve_max_minor\": 0', '\"auto_approve_max_minor\": 500000').replace('auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review', 'Finance-approved limit: INR 5,000 inclusive, in minor units (PAY-381)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
