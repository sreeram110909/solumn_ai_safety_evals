[88.847815, "o", "\u001b[32m✔ signatures: rotation, exact bytes, and inclusive timestamp window \u001b[90m(2.599279ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures: missing and malformed headers fail closed \u001b[90m(0.471652ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy follows the inclusive INR 5,000 handoff threshold \u001b[90m(1.009978ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ deduplication persists and does not update refunds, markers, or audits \u001b[90m(21.502516ms)\u001b[39m\u001b[39m\r\n"]
[89.092091, "o", "\u001b[32m✔ HTTP: verification precedes writes, duplicates are read-only, replay stays authorized \u001b[90m(306.19938ms)\u001b[39m\u001b[39m\r\n"]
[89.138411, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(31.652092ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(5.521063ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(2.513334ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(3.820295ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.200846ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(7.868822ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(3.889226ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.271037ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 13\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 13\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1001.912304\u001b[39m\r\n"]
