[87.774846, "o", "    assert.doesNotThrow(() => verifyWebhook(raw, header, [\"unused\", SECRET], now));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.775149, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.775392, "o", "> "]
[87.775846, "o", "  for (const now of [NOW - 301, NOW + 301]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.776464, "o", "    assert.throws(() => verifyWebhook(raw, header, [SECRET], now), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.77656, "o", "> "]
[87.776675, "o", "  }\r\n\u001b[?2004l\r"]
[87.776802, "o", "\u001b[?2004h> "]
[87.777812, "o", "  assert.throws(() => verifyWebhook(raw.toString().trim(), header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.77824, "o", "> "]
[87.778442, "o", "  assert.throws(() => verifyWebhook(raw, header, [], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.779784, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.780073, "o", "  const bytes = Buffer.from([0x7b, 0xff, 0x7d]);\r\n\u001b[?2004l\r"]
[87.780178, "o", "\u001b[?2004h> "]
[87.780543, "o", "  assert.doesNotThrow(() => verifyWebhook(bytes, signature(bytes), [SECRET], NOW));\r\n"]
[87.780625, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.781166, "o", "  assert.throws(() => verifyWebhook(bytes.toString(), signature(bytes), [SECRET], NOW), SignatureError);\r\n"]
[87.781322, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.781367, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.781479, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.781574, "o", "> "]
[87.781984, "o", "test(\"signatures: missing and malformed headers fail closed\", () => {\r\n"]
[87.782077, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.782149, "o", "> "]
[87.782525, "o", "  for (const header of [undefined, \"\", `t=${NOW}`, \"v1=\" + \"a\".repeat(64),\r\n"]
[87.782633, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.783043, "o", "    `t=${NOW},v1=abcd`, `t=${NOW},v1=${\"A\".repeat(64)}`, `t=NaN,v1=${\"a\".repeat(64)}`,\r\n"]
[87.783138, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.783552, "o", "    `t=99999999999999999999,v1=${\"a\".repeat(64)}`, `t=${NOW},${signature(\"body\")}`]) {\r\n"]
[87.783732, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.784299, "o", "    assert.throws(() => verifyWebhook(\"body\", header, [SECRET], NOW), SignatureError);\r\n"]
[87.784389, "o", "\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.787797, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.78844, "o", "test(\"configured policy follows the inclusive INR 5,000 handoff threshold\", () => {\r\n"]
[87.788589, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.788906, "o", "  assert.equal(POLICY.auto_approve_max_minor, 500000);\r\n"]
[87.789113, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.789365, "o", "  assert.deepEqual(POLICY.auto_approve_currencies, [\"INR\"]);"]
[87.789452, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.789786, "o", "  assert.equal(decideStatus(POLICY, 499999, \"INR\"), \"auto_approved\");\r\n"]
[87.789895, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.790024, "o", "> "]
[87.790331, "o", "  assert.equal(decideStatus(POLICY, 500000, \"INR\"), \"auto_approved\");\r\n"]
[87.790445, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.790765, "o", "  assert.equal(decideStatus(POLICY, 500001, \"INR\"), \"pending_review\");"]
[87.790844, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.790975, "o", "> "]
[87.791294, "o", "  assert.equal(decideStatus(POLICY, 1, \"USD\"), \"pending_review\");\r\n"]
[87.791411, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.791608, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.791733, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.792151, "o", "test(\"deduplication persists and does not update refunds, markers, or audits\", (t) => {\r\n"]
[87.792297, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.792548, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));"]
[87.79262, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.792733, "o", "> "]
[87.793077, "o", "  t.after(() => rmSync(dir, { recursive: true, force: true }));\r\n"]
[87.793197, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.7934, "o", "  let store = new Store(dir);\r\n"]
[87.793506, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.79369, "o", "  for (const [id, type, amount] of ["]
[87.793771, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.794055, "o", "    [\"evt_req\", \"refund.requested\", 500001],\r\n"]
[87.794141, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.794395, "o", "    [\"evt_cancel\", \"refund.cancelled\", 500001],\r\n"]
[87.794502, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.794747, "o", "    [\"evt_cancel_again\", \"refund.cancelled\", 500001],"]
[87.794833, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.79512, "o", "    [\"evt_unknown\", \"unhandled.type\", 500001],\r\n"]
[87.795215, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.79561, "o", "    [\"__proto__\", \"unhandled.type\", 500001],\r\n"]
[87.795776, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.795883, "o", "    [\"toString\", \"unhandled.type\", 500001],"]
[87.796006, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.796126, "o", "> "]
[87.796254, "o", "  ] as const) {\r\n"]
[87.796335, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.796667, "o", "    const ev = parseEvent(JSON.stringify(event(id, type, { amount })));\r\n"]
[87.796753, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.797151, "o", "    assert.notEqual(processEvent(store, POLICY, ev).outcome, \"duplicate\");\r\n"]
[87.79725, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.797466, "o", "    const before = snapshot(dir);\r\n"]
[87.797578, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.797635, "o", "> "]
[87.79784, "o", "    store = new Store(dir);\r\n"]
[87.798001, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.7985, "o", "    assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\r\n\u001b[?2004l\r"]
[87.798687, "o", "\u001b[?2004h> "]
[87.799323, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.799712, "o", ">   }"]
[87.800174, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.80057, "o", "  assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.800741, "o", "> "]
[87.801309, "o", "  assert.equal(store.listRefunds()[0].status, \"cancelled\");\r\n"]
[87.801685, "o", "\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[87.801998, "o", "\u001b[?2004h> "]
[87.802568, "o", "test(\"HTTP: verification precedes writes, duplicates are read-only, replay stays authorized\", async (t) => {"]
[87.802761, "o", "\r\n\u001b[?2004l\r"]
[87.802881, "o", "\u001b[?2004h"]
[87.803003, "o", "> "]
[87.803523, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.803847, "o", "> "]
[87.804178, "o", "  t.after(() => rmSync(dir, { recursive: true, force: true }));\r\n"]
[87.80434, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.80454, "o", ">   const store = new Store(dir);"]
[87.804713, "o", "\r\n\u001b[?2004l\r"]
[87.804891, "o", "\u001b[?2004h"]
[87.80501, "o", "> "]
[87.805262, "o", "  const roles: RolesConfig = {\r\n\u001b[?2004l\r"]
[87.805479, "o", "\u001b[?2004h"]
[87.805505, "o", "> "]
[87.805923, "o", "    roles: { admin: [\"refunds:read\", \"refunds:replay\"], viewer: [\"refunds:read\"] },"]
[87.806136, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.806271, "o", ">     principals: {"]
[87.806614, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.806889, "o", "      ops: { key_sha256: sha256Hex(\"test-ops\"), roles: [\"admin\"] },"]
[87.807083, "o", "\r\n\u001b[?2004l\r"]
[87.807367, "o", "\u001b[?2004h"]
[87.807407, "o", ">       viewer: { key_sha256: sha256Hex(\"test-viewer\"), roles: [\"viewer\"] },"]
[87.807637, "o", "\r\n"]
[87.80777, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.807841, "o", "    },"]
[87.807998, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.808073, "o", ">   };\r\n\u001b[?2004l\r"]
[87.808287, "o", "\u001b[?2004h> "]
[87.808308, "o", "  const app = buildApp(store, roles, POLICY, { webhook_secrets: [\"unused\", SECRET], tolerance_s: 300 });"]
[87.808476, "o", "\r\n"]
[87.80865, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.808716, "o", ">   const server = createServer((req, res) => void app(req, res));"]
[87.808976, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.809002, "o", "  t.after(() => new Promise<void>((resolve, reject) => {"]
[87.809173, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.809287, "o", ">     server.close((error) => error ? reject(error) : resolve());"]
[87.809383, "o", "\r\n"]
[87.809488, "o", "\u001b[?2004l\r"]
[87.809558, "o", "\u001b[?2004h> "]
[87.80962, "o", "    server.closeAllConnections();"]
[87.809763, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.809843, "o", ">   }));"]
[87.809971, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.810152, "o", "  server.listen(0, \"127.0.0.1\");"]
[87.810185, "o", "\r\n"]
[87.810317, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.810432, "o", "  await once(server, \"listening\");"]
[87.810576, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.810676, "o", "> "]
[87.810774, "o", "  const address = server.address();"]
[87.810921, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.811104, "o", "> "]
[87.811244, "o", "  assert.ok(address && typeof address !== \"string\");"]
[87.811288, "o", "\r\n\u001b[?2004l\r"]
[87.811372, "o", "\u001b[?2004h"]
[87.811509, "o", "> "]
[87.811614, "o", "  const base = `http://127.0.0.1:${address.port}`;"]
[87.81251, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.812541, "o", ">   const raw = JSON.stringify(event(\"evt_http\"), null, 2) + \"\\n\";"]
[87.812761, "o", "\r\n"]
[87.812997, "o", "\u001b[?2004l\r"]
[87.813025, "o", "\u001b[?2004h>   const now = Math.floor(Date.now() / 1000);"]
[87.813236, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.813522, "o", ">   async function post(body: string, headers: Record<string, string> = {}, path = \"/webhooks/paygate\") {"]
[87.813863, "o", "\r\n"]
[87.814131, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.814301, "o", ">     const res = await fetch(base + path, { method: \"POST\", body, headers });"]
[87.814526, "o", "\r\n"]
[87.814678, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.8147, "o", ">     return { status: res.status, body: await res.json() };"]
[87.815332, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.815368, "o", ">   async function signed(body: string) {"]
[87.815713, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.815979, "o", "    return post(body, { \"Paygate-Signature\": signature(body, Math.floor(Date.now() / 1000)) });"]
[87.81612, "o", "\r\n"]
[87.816239, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.816329, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.816459, "o", "> \r\n\u001b[?2004l\r"]
[87.816489, "o", "\u001b[?2004h>   for (const headers of ["]
[87.816726, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.816752, "o", ">     {}, { \"X-Paygate-Replay-Token\": \"untrusted-vendor-token\" },"]
[87.816956, "o", "\r\n\u001b[?2004l\r"]
[87.817091, "o", "\u001b[?2004h>     { \"Paygate-Signature\": signature(raw, now, \"wrong-secret\") },"]
[87.817242, "o", "\r\n"]
[87.817299, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.817436, "o", "> "]
[87.817487, "o", "    { \"Paygate-Signature\": signature(raw, now - 3600) },"]
[87.817633, "o", "\r\n\u001b[?2004l\r"]
[87.817763, "o", "\u001b[?2004h>     { \"Paygate-Signature\": signature(raw, now + 3600) },"]
[87.817877, "o", "\r\n"]
[87.818111, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.818136, "o", ">     { \"Paygate-Signature\": signature(raw + \" \", now) },"]
[87.818307, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.818427, "o", ">   ]) {"]
[87.818539, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.818594, "o", ">     const before = snapshot(dir);"]
[87.818706, "o", "\r\n"]
[87.818841, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.818892, "o", "    assert.equal((await post(raw, headers)).status, 401);"]
[87.819089, "o", "\r\n"]
[87.819184, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.819253, "o", "    assert.deepEqual(snapshot(dir), before);"]
[87.819389, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.819734, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h>   for (const invalid of [\"{not json\", \"null\", \"{}\", JSON.stringify(event(\"evt_bad\", \"refund.requested\", { amount: -1 }))]) {"]
[87.819883, "o", "\r\n"]
[87.82, "o", "\u001b[?2004l\r"]
[87.820122, "o", "\u001b[?2004h"]
[87.820264, "o", ">     assert.equal((await signed(invalid)).status, 400);"]
[87.820394, "o", "\r\n"]
[87.820499, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.820605, "o", ">   }\r\n\u001b[?2004l\r"]
[87.820735, "o", "\u001b[?2004h> "]
[87.820804, "o", "  assert.equal(store.listRefunds().length, 0);"]
[87.820965, "o", "\r\n\u001b[?2004l\r"]
[87.821163, "o", "\u001b[?2004h"]
[87.821185, "o", ">   assert.equal(store.isProcessed(\"evt_bad\"), false);"]
[87.821296, "o", "\r\n"]
[87.821353, "o", "\u001b[?2004l\r"]
[87.821474, "o", "\u001b[?2004h"]
[87.821687, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[87.821705, "o", ">   assert.deepEqual(await signed(raw), { status: 200, body: { received: true, duplicate: false } });"]
[87.821835, "o", "\r\n"]
[87.821956, "o", "\u001b[?2004l\r"]
[87.822031, "o", "\u001b[?2004h"]
[87.822172, "o", "> "]
[87.822294, "o", "  assert.equal(store.listRefunds()[0].status, \"auto_approved\");"]
[87.822434, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.822528, "o", ">   const before = snapshot(dir);"]
[87.822785, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.822808, "o", ">   const changed = JSON.stringify(event(\"evt_http\", \"refund.requested\", { amount: 900000 }));"]
[87.822919, "o", "\r\n"]
[87.823049, "o", "\u001b[?2004l\r"]
[87.823263, "o", "\u001b[?2004h"]
[87.823283, "o", ">   const duplicates = await Promise.all([signed(raw), signed(changed), signed(raw)]);"]
[87.823393, "o", "\r\n"]
[87.823603, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.823676, "o", "  for (const result of duplicates) {"]
[87.823921, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.82401, "o", "    assert.deepEqual(result, { status: 200, body: { received: true, duplicate: true } });"]
[87.824217, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.824386, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[87.824407, "o", ">   assert.deepEqual(snapshot(dir), before);"]
[87.824687, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.824708, "o", "  // Even an already-processed event still needs a fresh valid signature."]
[87.824904, "o", "\r\n"]
[87.825008, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[87.825214, "o", "  assert.equal((await post(raw)).status, 401);"]
[87.825388, "o", "\r\n\u001b[?2004l\r"]
[87.825527, "o", "\u001b[?2004h"]
[87.825552, "o", ">   assert.deepEqual(snapshot(dir), before);"]
[87.82573, "o", "\r\n\u001b[?2004l\r"]
[87.825987, "o", "\u001b[?2004h> "]
[87.826016, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   const cancel = JSON.stringify(event(\"evt_http_cancel\", \"refund.cancelled\"));"]
[87.826139, "o", "\r\n"]
[87.82634, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.826359, "o", ">   assert.equal((await signed(cancel)).status, 200);"]
[87.826491, "o", "\r\n"]
[87.826656, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds()[0].status, \"auto_approved\");"]
[87.826744, "o", "\r\n"]
[87.826858, "o", "\u001b[?2004l\r\u001b[?2004h"]
[87.827049, "o", ">   assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel\\.ignored/);"]
[87.827186, "o", "\r\n"]
[87.82728, "o", "\u001b[?2004l\r"]
[87.827407, "o", "\u001b[?2004h> "]
