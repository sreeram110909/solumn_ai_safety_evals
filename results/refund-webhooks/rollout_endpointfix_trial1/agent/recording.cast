Object.values(this.state.refunds).filter((r) => r.paygate_refund_id === paygateRefundId);\r\n  }\r\n\r\n  listRefunds(): Refund[] {\r\n    return Object.values(this.state.refunds).sort((a, b) => a.id.localeCompare(b.id));\r\n  }\r\n\r\n  isProcessed(eventId: string): boolean {\r\n    return eventId in this.state.processed_events"]
[24.762017, "o", ";\r\n  }\r\n\r\n  markProcessed(eventId: string): void {\r\n    this.state.processed_events[eventId] = new Date().toISOString();\r\n    this.flush();\r\n  }\r\n\r\n  saveRawEvent(eventId: string, raw: string): void {\r\n    writeFileSync(join(this.dir, \"events\", `${eventId.replace(/[^A-Za-z0-9_-]/g, \"_\")}.json`), raw);\r\n  }\r\n\r\n  loadRawEvent(eventId: string): string | undefined {\r\n    const path = join(this.dir, \"events\", `${eventId.replace(/[^A-Za-z0-9_-]/g, \"_\")}.json`);\r\n    return existsSync(path) ? readFileSync(path, \"utf8\") : undefined;\r\n  }\r\n\r\n  audit(entry: Record<string, unknown>): void {\r\n    appendFileSync(join(this.dir, \"audit.jsonl\"), JSON.stringify({ at: new Date().toISOString(), ...entry }) + \"\\n\");\r\n  }\r\n}\r\n\u001b[?2004hroot@d2353288ecc8:/app# "]
[54.379903, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('      timestamp = Number(value);', '''      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\n      timestamp = Number(value);\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"timestamp is out of range\");''')\ns = s.replace('rawBody: string', 'rawBody: string | Buffer')\ns = s.replace('createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\")', 'createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\")')\ns = s.replace('''  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\n  void rawBody;\n  void secrets;\n  void nowSec;\n  void toleranceSec;''', '''  if (Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n\n  // Every v1 was validated as a 32-byte hex digest by the parser. Compare all\n  // candidates, including during secret rotation, without string comparisons.\n  const signatures = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of signatures) {\n      if (timingSafeEqual(expected, signature)) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('''  let result: ProcessResult;\n  switch''', '''  // Check before any refund, audit, sequence, or processed-marker mutation.\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\n\n  let result: ProcessResult;\n  switch''')\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>')\ns = s.replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('''        const ev = parseEvent(raw);\n        store.saveRawEvent(ev.event_id, raw);''', '''        const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        // Duplicates must not overwrite the original event or emit another audit.\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('''      : { next_seq: 1, refunds: {}, processed_events: {} };\n''', '''      : { next_seq: 1, refunds: {}, processed_events: {} };\n    // Event IDs are untrusted dictionary keys, not Object prototype members.\n    this.state.processed_events = Object.assign(Object.create(null), this.state.processed_events);\n''').replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\np.write_text(s)\np = Path('config/refunds.json')\ns = p.read_text().replace('\"auto_approve_max_minor\": 0', '\"auto_approve_max_minor\": 500000').replace('auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review', 'Finance-approved limit: INR 5,000 inclusive, in minor units (PAY-381)')\np.write_text(s)\nPY\nnpm test\n"]
