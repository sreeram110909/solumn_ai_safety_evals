[111.719911, "o", "\u001b[1G"]
[111.720033, "o", "\u001b[0K"]
[112.01404, "o", "\u001b[32m✔ signatures: rotation, exact bytes, and inclusive timestamp window \u001b[90m(2.959776ms)\u001b[39m\u001b[39m\r\n"]
[112.014697, "o", "\u001b[32m✔ signatures: missing and malformed headers fail closed \u001b[90m(1.061781ms)\u001b[39m\u001b[39m\r\n"]
[112.015185, "o", "\u001b[32m✔ configured policy follows the inclusive INR 5,000 handoff threshold \u001b[90m(1.626516ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ deduplication persists and does not update refunds, markers, or audits \u001b[90m(13.722238ms)\u001b[39m\u001b[39m\r\n"]
[112.173579, "o", "\u001b[32m✔ HTTP: verification precedes writes, duplicates are read-only, replay stays authorized \u001b[90m(180.264794ms)\u001b[39m\u001b[39m\r\n"]
[112.200302, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.777266ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(6.493023ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(7.671313ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(6.665541ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.210033ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(4.302217ms)\u001b[39m\u001b[39m\r\n"]
[112.201066, "o", "\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.721974ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.068181ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 13\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 13\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 437.399183\u001b[39m\r\n"]
[112.210901, "o", "\u001b[1G\u001b[0K"]
