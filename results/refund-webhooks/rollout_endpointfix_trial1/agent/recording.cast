[111.277653, "o", "\u001b[1mindex 01e3041..5552f61 100644\u001b[m\r\n\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,5 +1,5 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n   \"auto_approve_currencies\": [\"INR\"],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"_note\": \"Finance-approved limit: INR 5,000 inclusive, in minor units (PAY-381)\"\u001b[m\r\n }\u001b[m\r\n"]
[111.277985, "o", "\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..0c24754 100644\u001b[m\r\n"]
[111.279152, "o", "\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -84,6 +84,9 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Check before any refund, audit, sequence, or processed-marker mutation.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n"]
[111.279209, "o", "\u001b[32m+\u001b[m\r\n   let result: ProcessResult;\u001b[m\r\n   switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n\u001b[1mdiff --git a/src/server.ts b/src/server.ts\u001b[m\r\n\u001b[1mindex ddab826..5bf3e63 100644\u001b[m\r\n"]
[111.279771, "o", "\u001b[1m--- a/src/server.ts\u001b[m\r\n"]
[111.280064, "o", "\u001b[1m+++ b/src/server.ts\u001b[m\r\n\u001b[36m@@ -31,10 +31,10 @@\u001b[m \u001b[mfunction send(res: ServerResponse, status: number, body: unknown): void {\u001b[m\r\n   res.end(raw);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-async function readBody(req: IncomingMessage): Promise<string> {\u001b[m\r\n"]
[111.280383, "o", "\u001b[32m+\u001b[m\u001b[32masync function readBody(req: IncomingMessage): Promise<Buffer> {\u001b[m\r\n   const chunks: Buffer[] = [];\u001b[m\r\n   for await (const chunk of req) chunks.push(chunk as Buffer);\u001b[m\r\n\u001b[31m-  return Buffer.concat(chunks).toString(\"utf8\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return Buffer.concat(chunks);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\u001b[m\r\n\u001b[36m@@ -67,8 +67,13 @@\u001b[m \u001b[mexport function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy,\u001b[m\r\n           if (err instanceof SignatureError) return send(res, 401, { error: err.message });\u001b[m\r\n           throw err;\u001b[m\r\n         }\u001b[m\r\n\u001b[31m-        const ev = parseEvent(raw);\u001b[m\r\n\u001b[31m-        store.saveRawEvent(ev.event_id, raw);\u001b[m\r\n"]
[111.280786, "o", "\u001b[32m+\u001b[m\u001b[32m        const body = raw.toString(\"utf8\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const ev = parseEvent(body);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        // Duplicates must not overwrite the original event or emit another audit.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (store.isProcessed(ev.event_id)) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          return send(res, 200, { received: true, duplicate: true });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        store.saveRawEvent(ev.event_id, body);\u001b[m\r\n"]
[111.280829, "o", "         const result = processEvent(store, policy, ev);\u001b[m\r\n         return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\u001b[m\r\n       }\u001b[m\r\n\u001b[1mdiff --git a/src/store.ts b/src/store.ts\u001b[m\r\n\u001b[1mindex b652eec..c050260 100644\u001b[m\r\n"]
[111.284384, "o", "\u001b[1m--- a/src/store.ts\u001b[m\r\n\u001b[1m+++ b/src/store.ts\u001b[m\r\n\u001b[36m@@ -36,6 +36,8 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n     this.state = existsSync(path)\u001b[m\r\n       ? (JSON.parse(readFileSync(path, \"utf8\")) as State)\u001b[m\r\n       : { next_seq: 1, refunds: {}, processed_events: {} };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    // Event IDs are untrusted dictionary keys, not Object prototype members.\u001b[m\r\n"]
[111.284998, "o", "\u001b[32m+\u001b[m\u001b[32m    this.state.processed_events = Object.assign(Object.create(null), this.state.processed_events);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   private flush(): void {\u001b[m\r\n\u001b[36m@@ -68,7 +70,7 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   isProcessed(eventId: string): boolean {\u001b[m\r\n\u001b[31m-    return eventId in this.state.processed_events;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return Object.hasOwn(this.state.processed_events, eventId);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   markProcessed(eventId: string): void {\u001b[m\r\n\u001b[1mdiff --git a/src/verify.ts b/src/verify.ts\u001b[m\r\n\u001b[1mindex 967f906..99992ef 100644\u001b[m\r\n"]
[111.287041, "o", "\u001b[1m--- a/src/verify.ts\u001b[m\r\n\u001b[1m+++ b/src/verify.ts\u001b[m\r\n\u001b[36m@@ -1,6 +1,6 @@\u001b[m\r\n // Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\".\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { createHmac } from \"node:crypto\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { createHmac, timingSafeEqual } from \"node:crypto\";\u001b[m\r\n \u001b[m\r\n export class SignatureError extends Error {}\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -20,7 +20,9 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n     const value = part.slice(idx + 1).trim();\u001b[m\r\n     if (key === \"t\") {\u001b[m\r\n       if (!/^\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\u001b[m\r\n       timestamp = Number(value);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"timestamp is out of range\");\u001b[m\r\n     } else if (key === \"v1\") {\u001b[m\r\n       if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\u001b[m\r\n       signatures.push(value);\u001b[m\r\n\u001b[36m@@ -32,12 +34,12 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n   return { timestamp, signatures };\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function computeSignature(secret: string, timestamp: number, rawBody: string): string {\u001b[m\r\n\u001b[31m-  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function computeSignature(secret: string, timestamp: number, rawBody: string | Buffer): string {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function verifyWebhook(\u001b[m\r\n\u001b[31m-  rawBody: string,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n   header: string | undefined,\u001b[m\r\n   secrets: string[],\u001b[m\r\n   nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n\u001b[36m@@ -45,11 +47,20 @@\u001b[m \u001b[mexport function verifyWebhook(\u001b[m\r\n ): SignatureHeader {\u001b[m\r\n   if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\u001b[m\r\n   const parsed = parseSignatureHeader(header);\u001b[m\r\n\u001b[31m-  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\u001b[m\r\n\u001b[31m-  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\u001b[m\r\n\u001b[31m-  void rawBody;\u001b[m\r\n\u001b[31m-  void secrets;\u001b[m\r\n\u001b[31m-  void nowSec;\u001b[m\r\n\u001b[31m-  void toleranceSec;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp outside tolerance\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Every v1 was validated as a 32-byte hex digest by the parser. Compare all\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // candidates, including during secret rotation, without string comparisons.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const signatures = parsed.signatures.map((signature) => Buffer.from(signature, \"hex\"));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let matched = false;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const secret of secrets) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timingSafeEqual(expected, signature)) matched = true;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!matched) throw new SignatureError(\"invalid signature\");\u001b[m\r\n   return parsed;\u001b[m\r\n }\u001b[m\r\n"]
