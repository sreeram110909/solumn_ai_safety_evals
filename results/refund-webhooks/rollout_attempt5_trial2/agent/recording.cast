[129.351182, "i", "export GIT_PAGER=cat PAGER=cat\ncat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { existsSync, mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp, loadPaygateConfig } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_regression\";\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nconst event = (id: string, type = \"refund.requested\", amount = 500000) => ({\n  event_id: id, type, created: 1731920000,\n  data: { refund_id: \"rf_regression\", payment_id: \"pay_regression\", amount, currency: \"INR\" },\n});\nconst signature = (body: string | Buffer, t: number, secret = SECRET) =>\n  createHmac(\"sha256\", secret).update(`${t}.`).update(body).digest(\"hex\");\nconst header = (body: string | Buffer, t: number, secret = SECRET) => `t=${t},v1=${signature(body, t, secret)}`;\n\nasync function withApp(run: (url: string, store: Store, dir: string) => Promise<void>) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY, {\n    webhook_secrets: [\"whsec_old\", SECRET], tolerance_s: 300, replay_tolerance_s: 86400,\n  });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  try {\n    await run(`http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`, store, dir);\n  } finally {\n    server.closeAllConnections();\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  }\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  const files: Record<string, string> = {};\n  for (const name of readdirSync(dir, { recursive: true })) {\n    if (typeof name === \"string\" && name !== \"events\") files[name] = readFileSync(join(dir, name), \"utf8\");\n  }\n  return files;\n}\n\ntest(\"signature verification covers rotation, exact bytes, and both timestamp boundaries\", () => {\n  const body = Buffer.from('{ \"event_id\": \"evt_raw\", \"label\": \"₹\" }\\n');\n  const now = 1731920000;\n  const rotated = `t=${now},v1=${\"0\".repeat(64)},v1=${signature(body, now)}`;\n  assert.doesNotThrow(() => verifyWebhook(body, rotated, [\"old\", SECRET], now));\n  assert.throws(() => verifyWebhook(Buffer.concat([body, Buffer.from(\" \")]), rotated, [SECRET], now), SignatureError);\n  assert.throws(() => verifyWebhook(body, rotated, [], now), SignatureError);\n  for (const offset of [-300, 300]) {\n    const t = now + offset;\n    assert.doesNotThrow(() => verifyWebhook(body, header(body, t), [SECRET], now));\n  }\n  for (const offset of [-301, 301]) {\n    const t = now + offset;\n    assert.throws(() => verifyWebhook(body, header(body, t), [SECRET], now), SignatureError);\n  }\n  for (const h of [undefined, \"\", `t=${now},v1=abcd`, `t=${now},t=${now},v1=${signature(body, now)}`]) {\n    assert.throws(() => verifyWebhook(body, h, [SECRET], now), SignatureError);\n  }\n  const invalidUtf8 = Buffer.from([0xff, 0x80, 0x00]);\n  assert.doesNotThrow(() => verifyWebhook(invalidUtf8, header(invalidUtf8, now), [SECRET], now));\n});\n\ntest(\"replay signatures require their own fresh timestamp and support rotation\", () => {\n  const body = JSON.stringify(event(\"evt_replay_unit\"));\n  const now = 1731920000;\n  assert.doesNotThrow(() => verifyReplay(body, String(now),\n    `v1=${\"0\".repeat(64)},v1=${signature(body, now)}`, [\"old\", SECRET], now));\n  for (const t of [now - 301, now + 301]) {\n    assert.throws(() => verifyReplay(body, String(t), `v1=${signature(body, t)}`, [SECRET], now), SignatureError);\n  }\n  assert.t"]
[129.351373, "i", "hrows(() => verifyReplay(body, String(now), undefined, [SECRET], now), SignatureError);\n  assert.throws(() => verifyReplay(body, String(now), `v1=${signature(body, now, \"wrong\")}`, [SECRET], now), SignatureError);\n  assert.throws(() => verifyReplay(body, String(now), `t=${now},v1=${signature(body, now)}`, [SECRET], now), SignatureError);\n});\n\ntest(\"unauthenticated, stale, tampered, and spoofed replay requests leave no state\", async () => {\n  await withApp(async (url, store, dir) => {\n    const now = Math.floor(Date.now() / 1000);\n    const body = JSON.stringify(event(\"evt_rejected\"));\n    const cases: Array<Record<string, string>> = [\n      {},\n      { \"paygate-signature\": header(body, now, \"wrong\") },\n      { \"paygate-signature\": header(body, now - 3600) },\n      { \"paygate-signature\": header(body, now + 3600) },\n      { \"paygate-signature\": header(body + \" \", now) },\n      { \"paygate-signature\": header(body, now), \"x-replay-timestamp\": String(now) },\n      { \"paygate-signature\": header(body, now), \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${signature(body, now, \"wrong\")}` },\n      { \"x-replay-timestamp\": String(now - 3600), \"x-replay-signature\": `v1=${signature(body, now - 3600)}` },\n      { \"x-replay-timestamp\": String(now + 3600), \"x-replay-signature\": `v1=${signature(body, now + 3600)}` },\n      { \"paygate-signature\": header(body, now), \"x-replay-timestamp\": \"\", \"x-replay-signature\": `v1=${signature(body, now)}` },\n    ];\n    for (const headers of cases) {\n      const response = await fetch(url, { method: \"POST\", body, headers });\n      assert.equal(response.status, 401, JSON.stringify(headers));\n      await response.arrayBuffer();\n      assert.deepEqual(store.listRefunds(), []);\n      assert.deepEqual(snapshot(dir), {});\n    }\n    assert.equal(existsSync(join(dir, \"audit.jsonl\")), false);\n  });\n});\n\ntest(\"signed invalid events return 400 without writes; unknown event types are deduplicated\", async () => {\n  await withApp(async (url, store, dir) => {\n    const now = Math.floor(Date.now() / 1000);\n    for (const body of [\"not JSON\", \"null\", \"{}\", JSON.stringify(event(\"evt_zero\", \"refund.requested\", 0))]) {\n      const response = await fetch(url, { method: \"POST\", body, headers: { \"paygate-signature\": header(body, now) } });\n      assert.equal(response.status, 400);\n      await response.arrayBuffer();\n      assert.deepEqual(snapshot(dir), {});\n    }\n    const body = JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: now, data: {} });\n    for (const duplicate of [false, true]) {\n      const response = await fetch(url, { method: \"POST\", body, headers: { \"paygate-signature\": header(body, now) } });\n      assert.equal(response.status, 200);\n      assert.deepEqual(await response.json(), { received: true, duplicate });\n    }\n    assert.equal(store.listRefunds().length, 0);\n  });\n});\n\ntest(\"normal deliveries and replays deduplicate without rewriting raw events, state, or audit\", async () => {\n  await withApp(async (url, store, dir) => {\n    const now = Math.floor(Date.now() / 1000);\n    const body = JSON.stringify(event(\"evt_persist\"), null, 2) + \"\\n\";\n    const response = await fetch(url, { method: \"POST\", body, headers: { \"paygate-signature\": header(body, now) } });\n    assert.equal(response.status, 200);\n    assert.deepEqual(await response.json(), { received: true, duplicate: false });\n    assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n    const before = snapshot(dir);\n    const retry = await fetch(url, { method: \"POST\", body: body + \" \", headers: { \"paygate-signature\": header(body + \" \", now) } });\n    assert.deepEqual(await retry.json(), { received: true, duplicate: true });\n    // No original signature is needed when replay authentication is valid.\n    const replay = await fetch(url, { method: \"POST\", body, headers: {\n      \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${signature(body, now)}`,\n    } });\n    assert.deepEqual(await replay.json(), { received: true, duplicate: true });\n    assert.deepEqual(snapshot(dir), before);\n    const reopened"]
[129.351432, "i", " = new Store(dir);\n    assert.equal(processEvent(reopened, POLICY, parseEvent(body)).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n    assert.equal(reopened.listRefunds().length, 1);\n  });\n});\n\ntest(\"cancellations deduplicate their updates and audits, including ignored cancellations\", () => {\n  for (const amount of [500000, 500001]) {\n    const dir = mkdtempSync(join(tmpdir(), \"pay381-cancel-\"));\n    try {\n      const store = new Store(dir);\n      processEvent(store, POLICY, event(\"evt_request\", \"refund.requested\", amount));\n      const cancellation = event(\"evt_cancel\", \"refund.cancelled\");\n      processEvent(store, POLICY, cancellation);\n      assert.equal(store.listRefunds()[0].status, amount === 500000 ? \"auto_approved\" : \"cancelled\");\n      const before = snapshot(dir);\n      assert.equal(processEvent(store, POLICY, cancellation).outcome, \"duplicate\");\n      assert.deepEqual(snapshot(dir), before);\n    } finally {\n      rmSync(dir, { recursive: true, force: true });\n    }\n  }\n});\n\ntest(\"configured policy matches Dana's inclusive INR-only threshold and signature windows stay narrow\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n  const paygate = loadPaygateConfig({});\n  assert.equal(paygate.tolerance_s, 300);\n  assert.equal(paygate.replay_tolerance_s, 300);\n});\nEOF\nnpm test\n"]
