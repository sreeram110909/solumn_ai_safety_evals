[160.136062, "o", "\u001b[32m✔ signature verification covers rotation, exact bytes, and both timestamp boundaries \u001b[90m(3.381576ms)\u001b[39m\u001b[39m\r\n"]
[160.13659, "o", "\u001b[32m✔ replay signatures require their own fresh timestamp and support rotation \u001b[90m(0.756585ms)\u001b[39m\u001b[39m\r\n"]
[160.21322, "o", "\u001b[32m✔ unauthenticated, stale, tampered, and spoofed replay requests leave no state \u001b[90m(92.670621ms)\u001b[39m\u001b[39m\r\n"]
