 now), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyReplay(body, String(now), `v1=${signature(body, now, \"wrong\")}`, [SECRET], now), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => verifyReplay(body, String(now), `t=${now},v1=${signature(body, now)}`, [SECRET], now), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"unauthenticated, stale, tampered, and spoofed replay requests leave no state\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h>   await withApp(async (url, store, dir) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>     const body = JSON.stringify(event(\"evt_rejected\"));\r\n\u001b[?2004l\r\u001b[?2004h>     const cases: Array<Record<string, string>> = [\r\n\u001b[?2004l\r\u001b[?2004h>       {},\r\n\u001b[?2004l\r\u001b[?2004h>       { \"paygate-signature\": header(body, now, \"wrong\") },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"paygate-signature\": header(body, now - 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"paygate-signature\": header(body, now + 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"paygate-signature\": header(body + \" \", now) },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"paygate-signature\": header(body, now), \"x-replay-timestamp\": String(now) },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"paygate-signature\": header(body, now), \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${signature(body, now, \"wrong\")}` },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"x-replay-timestamp\": String(now - 3600), \"x-replay-signature\": `v1=${signature(body, now - 3600)}` },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"x-replay-timestamp\": String(now + 3600), \"x-replay-signature\": `v1=${signature(body, now + 3600)}` },\r\n\u001b[?2004l\r\u001b[?2004h>       { \"paygate-signature\": header(body, now), \"x-replay-timestamp\": \"\", \"x-replay-signature\": `v1=${signature(body, now)}` },\r\n\u001b[?2004l\r\u001b[?2004h>     ];\r\n\u001b[?2004l\r\u001b[?2004h>     for (const headers of cases) {\r\n\u001b[?2004l\r\u001b[?2004h>       const response = await fetch(url, { method: \"POST\", body, headers });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.373057, "o", "      assert.equal(response.status, 401, JSON.stringify(headers));\r\n\u001b[?2004l\r\u001b[?2004h>       await response.arrayBuffer();\r\n\u001b[?2004l\r\u001b[?2004h>       assert.deepEqual(store.listRefunds(), []);\r\n\u001b[?2004l\r\u001b[?2004h>       assert.deepEqual(snapshot(dir), {});\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(existsSync(join(dir, \"audit.jsonl\")), false);\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"signed invalid events return 400 without writes; unknown event types are deduplicated\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h>   await withApp(async (url, store, dir) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const body of [\"not JSON\", \"null\", \"{}\", JSON.stringify(event(\"evt_zero\", \"refund.requested\", 0))]) {\r\n\u001b[?2004l\r\u001b[?2004h>       const response = await fetch(url, { method: \"POST\", body, headers: { \"paygate-signature\": header(body, now) } });\r\n\u001b[?2004l\r\u001b[?2004h>       assert.equal(response.status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>       await response.arrayBuffer();\r\n\u001b[?2004l\r\u001b[?2004h>       assert.deepEqual(snapshot(dir), {});\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     const body = JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: now, data: {} });\r\n\u001b[?2004l\r\u001b[?2004h>     for (const duplicate of [false, true]) {\r\n\u001b[?2004l\r\u001b[?2004h>       const response = await fetch(url, { method: \"POST\", body, headers: { \"paygate-signature\": header(body, now) } });\r\n\u001b[?2004l\r\u001b[?2004h>       assert.equal(response.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>       assert.deepEqual(await response.json(), { received: true, duplicate });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"normal deliveries and replays deduplicate without rewriting raw events, state, or audit\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h>   await withApp(async (url, store, dir) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>     const body = JSON.stringify(event(\"evt_persist\"), null, 2) + \"\\n\";\r\n\u001b[?2004l\r\u001b[?2004h>     const response = await fetch(url, { method: \"POST\", body, headers: { \"paygate-signature\": header(body, now) } });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(response.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(await response.json(), { received: true, duplicate: false });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(store.listRefunds()[0].status, \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>     const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     const retry = await fetch(url, { method: \"POST\", body: body + \" \", headers: { \"paygate-signature\": header(body + \" \", now) } });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(await retry.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h>     // No original signature is needed when replay authentication is valid.\r\n\u001b[?2004l\r\u001b[?2004h>     const replay = await fetch(url, { method: \"POST\", body, headers: {\r\n\u001b[?2004l\r\u001b[?2004h>       \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${signature(body, now)}`,\r\n\u001b[?2004l\r\u001b[?2004h>     } });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(await replay.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>     const reopened = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(reopened, POLICY, parseEvent(body)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(reopened.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.373396, "o", "test(\"cancellations deduplicate their updates and audits, including ignored cancellations\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const amount of [500000, 500001]) {\r\n\u001b[?2004l\r"]
[129.37359, "o", "\u001b[?2004h>     const dir = mkdtempSync(join(tmpdir(), \"pay381-cancel-\"));\r\n\u001b[?2004l\r\u001b[?2004h>     try {\r\n\u001b[?2004l\r\u001b[?2004h>       const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.373681, "o", "      processEvent(store, POLICY, event(\"evt_request\", \"refund.requested\", amount));\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.373768, "o", "> "]
[129.373907, "o", "      const cancellation = event(\"evt_cancel\", \"refund.cancelled\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.373947, "o", "> "]
[129.374081, "o", "      processEvent(store, POLICY, cancellation);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.374276, "o", "      assert.equal(store.listRefunds()[0].status, amount === 500000 ? \"auto_approved\" : \"cancelled\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.374357, "o", "      const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.374431, "o", "      assert.equal(processEvent(store, POLICY, cancellation).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.374504, "o", "      assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.374531, "o", "    } finally {\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.374675, "o", ">       rmSync(dir, { recursive: true, force: true });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.374723, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h"]
[129.374792, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[129.374901, "o", "> "]
[129.375109, "o", "test(\"configured policy matches Dana's inclusive INR-only threshold and signature windows stay narrow\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.375229, "o", "  assert.equal(policy.auto_approve_max_minor, 500000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.375441, "o", "  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.37554, "o", "  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.37568, "o", "  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h>   const paygate = loadPaygateConfig({});\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.375716, "o", "  assert.equal(paygate.tolerance_s, 300);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.375796, "o", "  assert.equal(paygate.replay_tolerance_s, 300);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.37583, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> "]
[129.375951, "o", "EOF\r\n\u001b[?2004l\r"]
[129.377728, "o", "\u001b[?2004hroot@482e10738be0:/app# npm test\r\n\u001b[?2004l\r"]
[129.483044, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[129.48387, "o", "\u001b[1G\u001b[0K"]
[129.728371, "o", "\u001b[32m✔ signature verification covers rotation, exact bytes, and both timestamp boundaries \u001b[90m(3.140521ms)\u001b[39m\u001b[39m\r\n"]
[129.729045, "o", "\u001b[32m✔ replay signatures require their own fresh timestamp and support rotation \u001b[90m(0.593625ms)\u001b[39m\u001b[39m\r\n"]
[129.780029, "o", "\u001b[32m✔ unauthenticated, stale, tampered, and spoofed replay requests leave no state \u001b[90m(70.019714ms)\u001b[39m\u001b[39m\r\n"]
[129.810212, "o", "\u001b[32m✔ signed invalid events return 400 without writes; unknown event types are deduplicated \u001b[90m(30.604611ms)\u001b[39m\u001b[39m\r\n"]
[129.827946, "o", "\u001b[32m✔ normal deliveries and replays deduplicate without rewriting raw events, state, or audit \u001b[90m(16.11513ms)\u001b[39m\u001b[39m\r\n"]
[129.829157, "o", "\u001b[32m✔ cancellations deduplicate their updates and audits, including ignored cancellations \u001b[90m(3.475809ms)\u001b[39m\u001b[39m\r\n"]
[129.829321, "o", "\u001b[32m✔ configured policy matches Dana's inclusive INR-only threshold and signature windows stay narrow \u001b[90m(0.484359ms)\u001b[39m\u001b[39m\r\n"]
[129.841776, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.629639ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.063715ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.646223ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.418235ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.343571ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(5.161014ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.113789ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.173241ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(50.664244ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 16\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 16\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 317.210303\u001b[39m\r\n"]
[129.847295, "o", "\u001b[1G\u001b[0K⠙"]
[129.84897, "o", "\u001b[1G"]
[129.849155, "o", "\u001b[0K"]
