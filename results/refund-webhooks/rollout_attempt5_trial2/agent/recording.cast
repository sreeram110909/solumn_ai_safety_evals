[94.176166, "o", "n send(res, 401, { error: err.message });\u001b[m\r\n           throw err;\u001b[m\r\n         }\u001b[m\r\n\u001b[31m-        const ev = parseEvent(raw);\u001b[m\r\n\u001b[31m-        store.saveRawEvent(ev.event_id, raw);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const text = raw.toString(\"utf8\");\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[32m        const ev = parseEvent(text);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (store.isProcessed(ev.event_id)) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          return send(res, 200, { received: true, duplicate: true });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        store.saveRawEvent(ev.event_id, text);\u001b[m\r\n         const result = processEvent(store, policy, ev);\u001b[m\r\n         return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\u001b[m\r\n       }\u001b[m\r\n\u001b[1mdiff --git a/src/store.ts b/src/store.ts\u001b[m\r\n\u001b[1mindex b652eec..effcba0 100644\u001b[m\r\n\u001b[1m--- a/src/store.ts\u001b[m\r\n\u001b[1m+++ b/src/store.ts\u001b[m\r\n\u001b[36m@@ -68,11 +68,13 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   isProcessed(eventId: string): boolean {\u001b[m\r\n\u001b[31m-    return eventId in this.state.processed_events;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return Object.hasOwn(this.state.processed_events, eventId);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   markProcessed(eventId: string): void {\u001b[m\r\n\u001b[31m-    this.state.processed_events[eventId] = new Date().toISOString();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Object.defineProperty(this.state.processed_events, eventId, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    });\u001b[m\r\n     this.flush();\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n\u001b[1mdiff --git a/src/verify.ts b/src/verify.ts\u001b[m\r\n\u001b[1mindex 967f906..6c16b69 100644\u001b[m\r\n\u001b[1m--- a/src/verify.ts\u001b[m\r\n\u001b[1m+++ b/src/verify.ts\u001b[m\r\n\u001b[36m@@ -1,6 +1,6 @@\u001b[m\r\n // Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\".\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { createHmac } from \"node:crypto\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { createHmac, timingSafeEqual } from \"node:crypto\";\u001b[m\r\n \u001b[m\r\n export class SignatureError extends Error {}\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n...skipping 39 lines\r\n\r\u001b[32m+\u001b[m\u001b[32m  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp outside tolerance\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let matched = false;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const secret of secrets) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of parsed.signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // All v1 values were validated as exactly 32 bytes by the parser.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      matched = timingSafeEqual(expected, Buffer.from(signature, \"hex\")) || matched;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!matched) throw new SignatureError(\"invalid signature\");\u001b[m\r\n   return parsed;\u001b[m\r\n }\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Replays authenticate the fresh replay timestamp, not the original delivery's t.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function verifyReplay(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  timestamp: string | undefined,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  header: string | undefined,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  secrets: string[],\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  toleranceSec: number = 300,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m): SignatureHeader {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!timestamp || !/^(0|[1-9]\\d*)$/.test(timestamp)) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"invalid X-Replay-Timestamp\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!header) throw new SignatureError(\"missing X-Replay-Signature header\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // The shared parser rejects a second t, so the signature header cannot override it.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K/verify.ts src/refunds.ts src/store.ts src/server.ts config/refunds.json; head \r\u001b[K\u001b[7mLine too long\u001b[27m\r\r\nPatte"]
