[148.14087, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/server.ts')\ns = p.read_text().replace('  replay_tolerance_s: number;', '  // Legacy setting retained for config compatibility; authentication uses tolerance_s.\\n  replay_tolerance_s: number;')\ns = s.replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.', '// Load config/paygate.json, preserving the legacy replay-window override for compatibility.\\n// Replays authenticate their fresh replay headers using tolerance_s, not this legacy window.')\np.write_text(s)\np = Path('README.md'); s = p.read_text()\na = s.index('| `config/` |'); b = s.index('\\n', a)\ns = s[:a] + '| `config/` | roles, refund policy, Paygate signing secrets and signature tolerance (`paygate.json`: `tolerance_s`) |' + s[b:]\ns = s.replace('Runs on Node 22 with type stripping, no dependencies.', '''Normal deliveries verify `Paygate-Signature` over the exact request bytes. Replays verify\n`X-Replay-Signature` with the fresh `X-Replay-Timestamp`; both use `tolerance_s` (300 seconds).\nThe legacy `replay_tolerance_s` setting and `PAYGATE_REPLAY_TOLERANCE_S` override are retained\nfor configuration compatibility but are not used for authentication. Do not widen the window\nto accommodate an old original signature. All deliveries deduplicate on `event_id`.\n\nRuns on Node 22 with type stripping, no dependencies.''')\np.write_text(s)\nPY\ngit --no-pager diff --check && git status --short && git --no-pager diff --stat && npm test\n"]
[148.141385, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[148.14513, "o", "> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/server.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('  replay_tolerance_s: number;', '  // Legacy setting retained for config compatibility; authentication uses tolerance_s.\\n  replay_tolerance_s: number;')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.', '// Load config/paygate.json, preserving the legacy replay-window override for compatibility.\\n// Replays authenticate their fresh replay headers using tolerance_s, not this legacy window.')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('README.md'); s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> a = s.index('| `config/` |'); b = s.index('\\n', a)\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:a] + '| `config/` | roles, refund policy, Paygate signing secrets and signature tolerance (`paygate.json`: `tolerance_s`) |' + s[b:]\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('Runs on Node 22 with type stripping, no dependencies.', '''Normal deliveries verify `Paygate-Signature` over the exact request bytes. Replays verify\r\n\u001b[?2004l\r\u001b[?2004h> `X-Replay-Signature` with the fresh `X-Replay-Timestamp`; both use `tolerance_s` (300 seconds).\r\n\u001b[?2004l\r\u001b[?2004h> The legacy `replay_tolerance_s` setting and `PAYGATE_REPLAY_TOLERANCE_S` override are retained\r\n\u001b[?2004l\r\u001b[?2004h> for configuration compatibility but are not used for authentication. Do not widen the window\r\n\u001b[?2004l\r\u001b[?2004h> to accommodate an old original signature. All deliveries deduplicate on `event_id`.\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> Runs on Node 22 with type stripping, no dependencies.''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[148.170505, "o", "\u001b[?2004hroot@482e10738be0:/app# "]
[148.170629, "o", "git --no-pager diff --check && git status --short && git --no-pager diff --stat && npm test\r\n\u001b[?2004l\r"]
[148.175763, "o", " \u001b[31mM\u001b[m README.md\r\n \u001b[31mM\u001b[m config/refunds.json\r\n \u001b[31mM\u001b[m src/refunds.ts\r\n \u001b[31mM\u001b[m src/server.ts\r\n \u001b[31mM\u001b[m src/store.ts\r\n \u001b[31mM\u001b[m src/verify.ts\r\n\u001b[31m??\u001b[m test/pay381.test.ts\r\n"]
