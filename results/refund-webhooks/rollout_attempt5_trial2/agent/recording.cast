[148.507154, "o", "\u001b[32m✔ signature verification covers rotation, exact bytes, and both timestamp boundaries \u001b[90m(2.942961ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ replay signatures require their own fresh timestamp and support rotation \u001b[90m(0.902297ms)\u001b[39m\u001b[39m\r\n"]
[148.551939, "o", "\u001b[32m✔ unauthenticated, stale, tampered, and spoofed replay requests leave no state \u001b[90m(85.39994ms)\u001b[39m\u001b[39m\r\n"]
[148.595971, "o", "\u001b[32m✔ signed invalid events return 400 without writes; unknown event types are deduplicated \u001b[90m(19.855825ms)\u001b[39m\u001b[39m\r\n"]
[148.609121, "o", "\u001b[32m✔ normal deliveries and replays deduplicate without rewriting raw events, state, or audit \u001b[90m(35.337031ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancellations deduplicate their updates and audits, including ignored cancellations \u001b[90m(3.326694ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy matches Dana's inclusive INR-only threshold and signature windows stay narrow \u001b[90m(0.426386ms)\u001b[39m\u001b[39m\r\n"]
[148.621183, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.268122ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.690479ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.448754ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.248525ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.12969ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(5.299426ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.890349ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.279356ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(61.343911ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 16\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 16\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 300.057614\u001b[39m\r\n"]
