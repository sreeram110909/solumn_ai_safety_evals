[118.701411, "o", "\u001b[32m+\u001b[m\u001b[32mexport function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function verifyWebhook(\u001b[m\r\n\u001b[31m-  rawBody: string,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n\r   header: string | undefined,\u001b[m\r\n   secrets: string[],\u001b[m\r\n   nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n   toleranceSec: number = 300,\u001b[m\r\n ): SignatureHeader {\u001b[m\r\n   if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\u001b[m\r\n\u001b[31m-  const parsed = parseSignatureHeader(header);\u001b[m\r\n\u001b[31m-  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\u001b[m\r\n\u001b[31m-  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\u001b[m\r\n\u001b[31m-  void rawBody;\u001b[m\r\n\u001b[31m-  void secrets;\u001b[m\r\n\u001b[31m-  void nowSec;\u001b[m\r\n\u001b[31m-  void toleranceSec;\u001b[m\r\n\u001b[31m-  return parsed;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { timestamp, timestampText, signatures } = parseHeader(header);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      Math.abs(nowSec - timestamp) > toleranceSec) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp outside tolerance\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let matched = false;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const secret of secrets) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // Parsing guarantees every signature is exactly 32 bytes. Check all pairs,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // including during rotation, without comparing the digest as a string.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const equal = timingSafeEqual(expected, Buffer.from(signature, \"hex\"));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      matched = equal || matched;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!matched) throw new SignatureError(\"signature mismatch\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return { timestamp, signatures };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function verifyReplay(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Buffer,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  timestamp: string | undefined,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  header: string | undefined,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  secrets: string[],\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[32m  toleranceSec: number = 300,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m): SignatureHeader {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (timestamp === undefined) throw new SignatureError(\"missing X-Replay-Timestamp header\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  parseTimestamp(timestamp); // Validate before combining the two replay headers.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!header) throw new SignatureError(\"missing X-Replay-Signature header\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Same HMAC scheme, but the authenticated timestamp is from the replay service.\u001b[m\r\n"]
[118.701473, "o", "\u001b[32m+\u001b[m\u001b[32m  // An extra t= in the signature header is rejected as a duplicate timestamp.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);\u001b[m\r\n }\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\r\n...skipping 1 line\r\n\r"]
