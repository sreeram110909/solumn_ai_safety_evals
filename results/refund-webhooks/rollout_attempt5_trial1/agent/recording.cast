[110.566052, "i", "== 200));\n  assert.equal(results.filter((res) => !res.body.duplicate).length, 1);\n  assert.equal(store.listRefunds().length, 1);\n});\n\ntest(\"ignored events and cancellation audits are deduplicated too\", async (t) => {\n  const { post, store, snapshot } = await fixture(t);\n  const deliver = (body: string) => post(body, { \"paygate-signature\": signature(body) });\n  const unknown = JSON.stringify({ event_id: \"unknown_type\", type: \"other.type\", created: NOW });\n  assert.equal((await deliver(unknown)).status, 200);\n  const afterUnknown = snapshot();\n  assert.equal((await deliver(unknown)).body.duplicate, true);\n  assert.deepEqual(snapshot(), afterUnknown);\n  const create = JSON.stringify(event(\"create\"));\n  await deliver(create);\n  const cancel = JSON.stringify(event(\"cancel\", \"refund.cancelled\"));\n  await deliver(cancel);\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  const afterCancel = snapshot();\n  assert.ok(afterCancel.some(([name, content]) => name === \"audit.jsonl\" && content.includes(\"cancel.ignored\")));\n  assert.equal((await deliver(cancel)).body.duplicate, true);\n  assert.deepEqual(snapshot(), afterCancel);\n});\n\ntest(\"configured finance threshold is inclusive INR 5000, with other currencies in review\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 499999, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\nEOF\nnpm test\n"]
