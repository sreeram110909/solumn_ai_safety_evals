[118.699246, "o", "     case \"refund.requested\":\u001b[m\r\n\u001b[1mdiff --git a/src/server.ts b/src/server.ts\u001b[m\r\n\u001b[1mindex a77617c..1fc7656 100644\u001b[m\r\n\u001b[1m--- a/src/server.ts\u001b[m\r\n\u001b[1m+++ b/src/server.ts\u001b[m\r\n\u001b[36m@@ -12,25 +12,24 @@\u001b[m \u001b[mimport { fileURLToPath, pathToFileURL } from \"node:url\";\u001b[m\r\n import { authenticate, can, loadRoles, type Permission, type RolesConfig } from \"./authz.ts\";\u001b[m\r\n import { EventError, parseEvent, processEvent, type RefundPolicy } from \"./refunds.ts\";\u001b[m\r\n import { Store } from \"./store.ts\";\u001b[m\r\n\u001b[31m-import { SignatureError, verifyWebhook } from \"./verify.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { SignatureError, verifyReplay, verifyWebhook } from \"./verify.ts\";\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n...skipping 1 line\r\n\r const CONFIG_DIR = process.env.CONFIG_DIR ?? fileURLToPath(new URL(\"../config/\", import.meta.url));\u001b[m\r\n \u001b[m\r\n export interface PaygateConfig {\u001b[m\r\n   webhook_secrets: string[];\u001b[m\r\n   tolerance_s: number;\u001b[m\r\n\u001b[31m-  replay_tolerance_s: number;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Legacy setting; replay authentication uses tolerance_s, just like live deliveries.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  replay_tolerance_s?: number;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n function readJson<T>(name: string): T {\u001b[m\r\n   return JSON.parse(readFileSync(`${CONFIG_DIR}/${name}`, \"utf8\")) as T;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.\u001b[m\r\n\u001b[31m-export function loadPaygateConfig(env: NodeJS.ProcessEnv = process.env): PaygateConfig {\u001b[m\r\n\u001b[31m-  const cfg = readJson<PaygateConfig>(\"paygate.json\");\u001b[m\r\n\u001b[31m-  if (env.PAYGATE_REPLAY_TOLERANCE_S) cfg.replay_tolerance_s = Number(env.PAYGATE_REPLAY_TOLERANCE_S);\u