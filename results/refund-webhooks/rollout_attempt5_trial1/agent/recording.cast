[71.403356, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(0.963184ms)\u001b[39m\u001b[39m\r\n"]
[71.403748, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.721489ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.399523ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.319461ms)\u001b[39m\u001b[39m\r\n"]
[71.403985, "o", "\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.132467ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.628406ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.687884ms)\u001b[39m\u001b[39m\r\n"]
[71.404286, "o", "\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.197032ms)\u001b[39m\u001b[39m\r\n"]
[71.422205, "o", "\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(34.752032ms)\u001b[39m\u001b[39m\r\n"]
[71.43442, "o", "\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 160.81118\u001b[39m\r\n"]
