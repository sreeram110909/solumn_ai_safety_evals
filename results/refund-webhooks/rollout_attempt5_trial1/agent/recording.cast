[110.555515, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"test_current_secret\";\nconst OLD_SECRET = \"test_previous_secret\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\n\nfunction event(id: string, type = \"refund.requested\", amount = 500000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" } };\n}\n\nfunction signature(body: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\n}\n\ntest(\"signature rotation checks every supplied signature against every configured secret\", () => {\n  const body = JSON.stringify(event(\"rotation\"));\n  for (const secret of [SECRET, OLD_SECRET]) {\n    for (const entries of [\n      `${\"0\".repeat(64)},v1=${computeSignature(secret, NOW, body)}`,\n      `${computeSignature(secret, NOW, body)},v1=${\"0\".repeat(64)}`,\n    ]) {\n      assert.doesNotThrow(() => verifyWebhook(body, `t=${NOW},v1=${entries}`, [SECRET, OLD_SECRET], NOW));\n    }\n  }\n  assert.throws(() => verifyWebhook(body, signature(body, NOW), [], NOW), SignatureError);\n});\n\ntest(\"signature timestamps enforce the inclusive window in both directions\", () => {\n  const body = \"{}\";\n  for (const delta of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(body, signature(body, NOW + delta), [SECRET], NOW));\n  }\n  for (const delta of [-301, 301]) {\n    assert.throws(() => verifyWebhook(body, signature(body, NOW + delta), [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"verification authenticates exact bytes, not reserialized JSON or replacement characters\", () => {\n  const raw = ' { \"note\": \"₹\", \"ok\": true }\\n';\n  const header = signature(raw, NOW);\n  assert.doesNotThrow(() => verifyWebhook(Buffer.from(raw), header, [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), header, [SECRET], NOW), SignatureError);\n  const invalidUtf8 = Buffer.from([0xff]);\n  assert.throws(() => verifyWebhook(invalidUtf8, signature(invalidUtf8.toString(\"utf8\"), NOW), [SECRET], NOW), SignatureError);\n});\n\ntest(\"missing and malformed signature headers fail closed\", () => {\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`,\n    `t=${NOW},v1=abc`, `t=${NOW},v1=${\"A\".repeat(64)}`,\n    `t=${NOW},t=${NOW},v1=${\"a\".repeat(64)}`,\n    `t=9007199254740992,v1=${\"a\".repeat(64)}`, `t=NaN,v1=${\"a\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"replay signatures use the replay timestamp and support rotation\", () => {\n  const body = \"{}\";\n  const header = `v1=${\"0\".repeat(64)},v1=${computeSignature(OLD_SECRET, NOW, body)}`;\n  assert.doesNotThrow(() => verifyReplay(body, String(NOW), header, [SECRET, OLD_SECRET], NOW));\n  for (const timestamp of [undefined, \"\", `${NOW},t=${NOW}`, String(NOW - 301), String(NOW + 301)]) {\n    assert.throws(() => verifyReplay(body, timestamp, header, [SECRET, OLD_SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyReplay(body, String(NOW), undefined, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyReplay(body, String(NOW), `t=${NOW},${header}`, [SECRET], NOW), SignatureError);\n});\n\nasync function fixture(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECR"]
[110.555951, "i", "ET, OLD_SECRET], tolerance_s: 300, replay_tolerance_s: 86400 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(async () => {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  });\n  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\n  const post = async (body: string, headers: Record<string, string> = {}) => {\n    const res = await fetch(url, { method: \"POST\", headers, body });\n    return { status: res.status, body: await res.json() };\n  };\n  const snapshot = () => readdirSync(dir, { recursive: true }).map(String).sort()\n    .filter((name) => name !== \"events\")\n    .map((name) => [name, readFileSync(join(dir, name), \"utf8\")]);\n  return { dir, store, post, snapshot };\n}\n\ntest(\"unauthenticated live and replay requests cannot change any state\", async (t) => {\n  const { post, snapshot } = await fixture(t);\n  const body = JSON.stringify(event(\"unauthenticated\"));\n  const now = Math.floor(Date.now() / 1000);\n  const original = signature(body, now - 7200);\n  const good = signature(body, now);\n  const goodReplay = `v1=${computeSignature(SECRET, now, body)}`;\n  const before = snapshot();\n  const headers: Record<string, string>[] = [\n    {},\n    { \"paygate-signature\": signature(body, now, \"wrong_secret\") },\n    { \"paygate-signature\": original },\n    { \"paygate-signature\": signature(body, now + 7200) },\n    // A caller-controlled replay timestamp cannot relax the live signature window.\n    { \"paygate-signature\": original, \"x-replay-timestamp\": String(now) },\n    { \"paygate-signature\": good, \"x-replay-timestamp\": String(now) },\n    { \"paygate-signature\": good, \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${\"0\".repeat(64)}` },\n    { \"x-replay-timestamp\": String(now - 7200), \"x-replay-signature\": original.split(\",\")[1] },\n    { \"x-replay-timestamp\": String(now + 7200), \"x-replay-signature\": `v1=${computeSignature(SECRET, now + 7200, body)}` },\n    { \"x-replay-timestamp\": \"bad\", \"x-replay-signature\": goodReplay },\n  ];\n  for (const h of headers) {\n    assert.equal((await post(body, h)).status, 401);\n    assert.deepEqual(snapshot(), before);\n  }\n  assert.equal((await post(body + \" \", { \"paygate-signature\": good })).status, 401);\n  assert.deepEqual(snapshot(), before);\n});\n\ntest(\"signed invalid events return 400 without mutating state\", async (t) => {\n  const { post, snapshot } = await fixture(t);\n  const before = snapshot();\n  for (const body of [\"{\", \"null\", \"{}\", JSON.stringify({ event_id: \"incomplete\" }),\n    JSON.stringify(event(\"bad_amount\", \"refund.requested\", -1)),\n    JSON.stringify({ ...event(\"bad_created\"), created: \"not-a-timestamp\" }),\n    JSON.stringify({ ...event(\"bad_currency\"), data: { refund_id: \"rf\", amount: 1, currency: 42 } })]) {\n    assert.equal((await post(body, { \"paygate-signature\": signature(body) })).status, 400);\n    assert.deepEqual(snapshot(), before);\n  }\n});\n\ntest(\"live and replay deliveries deduplicate without raw-event, state, or audit writes\", async (t) => {\n  const { dir, store, post, snapshot } = await fixture(t);\n  const body = ' \\n' + JSON.stringify(event(\"dedup\")) + '\\n';\n  assert.deepEqual(await post(body, { \"paygate-signature\": signature(body) }),\n    { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot();\n  const altered = JSON.stringify(event(\"dedup\", \"refund.requested\", 999999));\n  assert.deepEqual(await post(altered, { \"paygate-signature\": signature(altered) }),\n    { status: 200, body: { received: true, duplicate: true } });\n  const now = Math.floor(Date.now() / 1000);\n  for (const original of [undefined, \"invalid original signature\"] as const) {\n    const headers: Record<string, string> = { \"x-replay-timestamp\": String(now),\n      \"x-replay-signature\": `v1=${computeSignature(OLD_SECRET, now, body)}` };\n    if (original) headers[\"paygate-signature\"] = original;\n    assert.deepEqual(await p"]
[110.556015, "i", "ost(body, headers),\n      { status: 200, body: { received: true, duplicate: true } });\n  }\n  assert.deepEqual(snapshot(), before);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.loadRawEvent(\"dedup\"), body);\n  const restarted = new Store(dir);\n  assert.equal(processEvent(restarted, POLICY, parseEvent(body)).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(), before);\n});\n\ntest(\"a replay authenticates independently of the original signature and is processed once\", async (t) => {\n  const { post, store, snapshot } = await fixture(t);\n  const body = JSON.stringify(event(\"replay_first\"));\n  const now = Math.floor(Date.now() / 1000);\n  const headers = { \"paygate-signature\": \"not used for replay authentication\",\n    \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}` };\n  assert.deepEqual(await post(body, headers), { status: 200, body: { received: true, duplicate: false } });\n  const before = snapshot();\n  assert.deepEqual(await post(body, headers), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(), before);\n  assert.equal(store.listRefunds().length, 1);\n});\n\ntest(\"simultaneous retries create one refund\", async (t) => {\n  const { post, store } = await fixture(t);\n  const body = JSON.stringify(event(\"concurrent\"));\n  const headers = { \"paygate-signature\": signature(body) };\n  const results = await Promise.all(Array.from({ length: 8 }, () => post(body, headers)));\n  assert.ok(results.every((res) => res.status ="]
