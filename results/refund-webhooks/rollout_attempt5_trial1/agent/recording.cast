[71.07035, "i", "cat > src/verify.ts <<'EOF'\n// Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\" and \"Replays\".\n\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\n\nexport class SignatureError extends Error {}\n\nexport interface SignatureHeader {\n  timestamp: number;\n  signatures: string[];\n}\n\nfunction parseTimestamp(value: string): number {\n  if (!/^\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\n    throw new SignatureError(\"timestamp must be integer seconds\");\n  }\n  return Number(value);\n}\n\nfunction parseHeader(header: string): SignatureHeader & { timestampText: string } {\n  let timestampText: string | undefined;\n  const signatures: string[] = [];\n  for (const part of header.split(\",\")) {\n    const idx = part.indexOf(\"=\");\n    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);\n    const key = part.slice(0, idx).trim();\n    const value = part.slice(idx + 1).trim();\n    if (key === \"t\") {\n      if (timestampText !== undefined) throw new SignatureError(\"multiple timestamps\");\n      parseTimestamp(value);\n      timestampText = value;\n    } else if (key === \"v1\") {\n      if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\n      signatures.push(value);\n    }\n    // Ignore unknown signature schemes to allow future versions.\n  }\n  if (timestampText === undefined) throw new SignatureError(\"missing timestamp\");\n  if (signatures.length === 0) throw new SignatureError(\"no v1 signature\");\n  return { timestamp: Number(timestampText), timestampText, signatures };\n}\n\n// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\nexport function parseSignatureHeader(header: string): SignatureHeader {\n  const { timestamp, signatures } = parseHeader(header);\n  return { timestamp, signatures };\n}\n\nexport function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\n}\n\nexport function verifyWebhook(\n  rawBody: string | Buffer,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\n  const { timestamp, timestampText, signatures } = parseHeader(header);\n  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\n    for (const signature of signatures) {\n      // Parsing guarantees every signature is exactly 32 bytes. Check all pairs,\n      // including during rotation, without comparing the digest as a string.\n      const equal = timingSafeEqual(expected, Buffer.from(signature, \"hex\"));\n      matched = equal || matched;\n    }\n  }\n  if (!matched) throw new SignatureError(\"signature mismatch\");\n  return { timestamp, signatures };\n}\n\nexport function verifyReplay(\n  rawBody: string | Buffer,\n  timestamp: string | undefined,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (timestamp === undefined) throw new SignatureError(\"missing X-Replay-Timestamp header\");\n  parseTimestamp(timestamp); // Validate before combining the two replay headers.\n  if (!header) throw new SignatureError(\"missing X-Replay-Signature header\");\n  // Same HMAC scheme, but the authenticated timestamp is from the replay service.\n  // An extra t= in the signature header is rejected as a duplicate timestamp.\n  return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('src/server.ts')\ns = p.read_text().replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplay,"]
[71.070464, "i", " verifyWebhook')\ns = s.replace('  replay_tolerance_s: number;', '  // Legacy setting; replay authentication uses tolerance_s, just like live deliveries.\\n  replay_tolerance_s?: number;')\ns = s.replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.\\nexport function loadPaygateConfig(env: NodeJS.ProcessEnv = process.env): PaygateConfig {\\n  const cfg = readJson<PaygateConfig>(\"paygate.json\");\\n  if (env.PAYGATE_REPLAY_TOLERANCE_S) cfg.replay_tolerance_s = Number(env.PAYGATE_REPLAY_TOLERANCE_S);\\n  return cfg;\\n}', '// Both delivery paths use tolerance_s; old replay-window overrides are not used.\\nexport function loadPaygateConfig(): PaygateConfig {\\n  return readJson<PaygateConfig>(\"paygate.json\");\\n}')\ns = s.replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>')\ns = s.replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\nstart = s.index('        // Replays from Paygate')\nend = s.index('        } catch (err) {', start)\ns = s[:start] + '''        const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\n        try {\n          const now = Math.floor(Date.now() / 1000);\n          if (replay) {\n            verifyReplay(raw, req.headers[\"x-replay-timestamp\"] as string,\n              req.headers[\"x-replay-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          } else {\n            verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          }\n''' + s[end:]\ns = s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '        const body = raw.toString(\"utf8\");\\n        const ev = parseEvent(body);\\n        if (!store.isProcessed(ev.event_id)) store.saveRawEvent(ev.event_id, body);')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('  if (typeof ev.type !== \"string\")', '  if (typeof ev.type !== \"string\" || !ev.type)')\ns = s.replace('  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n    if (ev.type === \"refund.requested\") validateRequested(ev);\n  }''')\ns = s.replace('function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  const { amount, currency } = ev.data;\\n  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\\n  }', '''function validateRequested(ev: PaygateEvent): void {\n  const { amount, currency, payment_id, reason } = ev.data;\n  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency.trim()) {\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n  }\n  if ((payment_id !== undefined && typeof payment_id !== \"string\") ||\n      (reason !== undefined && typeof reason !== \"string\")) {\n    throw new EventError(\"payment_id and reason must be strings\");\n  }\n}\n\nfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  validateRequested(ev);\n  const { amount, currency } = ev.data;''')\ns = s.replace('export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n', 'export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.proc"]
