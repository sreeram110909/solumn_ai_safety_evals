[71.081917, "o", "> "]
[71.082021, "o", "  const { timestamp, timestampText, signatures } = parseHeader(header);\r\n\u001b[?2004l\r\u001b[?2004h>   if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\r\n\u001b[?2004l\r\u001b[?2004h>       Math.abs(nowSec - timestamp) > toleranceSec) {"]
