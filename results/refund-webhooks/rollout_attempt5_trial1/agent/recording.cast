[122.670628, "o", "\u001b[1G"]
[122.670731, "o", "\u001b[0K"]
[122.997617, "o", "\u001b[32m✔ signature rotation checks every supplied signature against every configured secret \u001b[90m(3.314071ms)\u001b[39m\u001b[39m\r\n"]
[122.997997, "o", "\u001b[32m✔ signature timestamps enforce the inclusive window in both directions \u001b[90m(0.649738ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ verification authenticates exact bytes, not reserialized JSON or replacement characters \u001b[90m(0.552067ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.426895ms)\u001b[39m\u001b[39m\r\n"]
[122.999133, "o", "\u001b[32m✔ replay signatures use the replay timestamp and support rotation \u001b[90m(0.75007ms)\u001b[39m\u001b[39m\r\n"]
[123.068113, "o", "\u001b[32m✔ unauthenticated live and replay requests cannot change any state \u001b[90m(100.703097ms)\u001b[39m\u001b[39m\r\n"]
[123.099978, "o", "\u001b[32m✔ signed invalid events return 400 without mutating state \u001b[90m(33.218101ms)\u001b[39m\u001b[39m\r\n"]
[123.122953, "o", "\u001b[32m✔ live and replay deliveries deduplicate without raw-event, state, or audit writes \u001b[90m(23.679624ms)\u001b[39m\u001b[39m\r\n"]
[123.136592, "o", "\u001b[32m✔ a replay authenticates independently of the original signature and is processed once \u001b[90m(10.770761ms)\u001b[39m\u001b[39m\r\n"]
[123.157243, "o", "\u001b[32m✔ simultaneous retries create one refund \u001b[90m(23.152199ms)\u001b[39m\u001b[39m\r\n"]
[123.177959, "o", "\u001b[32m✔ ignored events and cancellation audits are deduplicated too \u001b[90m(21.103718ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured finance threshold is inclusive INR 5000, with other currencies in review \u001b[90m(0.48063ms)\u001b[39m\u001b[39m\r\n"]
[123.195932, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.326128ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.021064ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.564866ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.331165ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.173075ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.170835ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.085307ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.503542ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(45.190686ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 21\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 21\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 481.476831\u001b[39m\r\n"]
