[110.581328, "o", "    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.581464, "o", "> "]
[110.581574, "o", "    rmSync(dir, { recursive: true, force: true });\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.582061, "o", "  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.582639, "o", "  const post = async (body: string, headers: Record<string, string> = {}) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.582724, "o", "> "]
[110.583172, "o", "    const res = await fetch(url, { method: \"POST\", headers, body });\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.583196, "o", "> "]
[110.583412, "o", "    return { status: res.status, body: await res.json() };\r\n\u001b[?2004l\r"]
[110.583443, "o", "\u001b[?2004h> "]
[110.583529, "o", "  };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.584424, "o", "  const snapshot = () => readdirSync(dir, { recursive: true }).map(String).sort()\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.584493, "o", "> "]
[110.584677, "o", "    .filter((name) => name !== \"events\")\r\n\u001b[?2004l\r"]
[110.584868, "o", "\u001b[?2004h> "]
[110.585309, "o", "    .map((name) => [name, readFileSync(join(dir, name), \"utf8\")]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.58539, "o", "> "]
[110.585644, "o", "  return { dir, store, post, snapshot };\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.585802, "o", "> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.586626, "o", "test(\"unauthenticated live and replay requests cannot change any state\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.587125, "o", "  const { post, snapshot } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.58752, "o", "  const body = JSON.stringify(event(\"unauthenticated\"));\r\n\u001b[?2004l\r"]
[110.587574, "o", "\u001b[?2004h> "]
[110.588071, "o", "  const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r"]
[110.588127, "o", "\u001b[?2004h> "]
[110.588363, "o", "  const original = signature(body, now - 7200);\r\n\u001b[?2004l\r\u001b[?2004h>   const good = signature(body, now);\r\n\u001b[?2004l\r"]
[110.588472, "o", "\u001b[?2004h> "]
[110.588815, "o", "  const goodReplay = `v1=${computeSignature(SECRET, now, body)}`;\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.589005, "o", "  const headers: Record<string, string>[] = [\r\n\u001b[?2004l\r\u001b[?2004h>     {},\r\n\u001b[?2004l\r"]
[110.589131, "o", "\u001b[?2004h> "]
[110.589579, "o", "    { \"paygate-signature\": signature(body, now, \"wrong_secret\") },\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.589648, "o", "> "]
[110.58997, "o", "    { \"paygate-signature\": original },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590202, "o", "    { \"paygate-signature\": signature(body, now + 7200) },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.590508, "o", "    // A caller-controlled replay timestamp cannot relax the live signature window.\r\n"]
[110.590543, "o", "\u001b[?2004l\r\u001b[?2004h"]
[110.590675, "o", "> "]
[110.590848, "o", "    { \"paygate-signature\": original, \"x-replay-timestamp\": String(now) },\r\n\u001b[?2004l\r"]
[110.590929, "o", "\u001b[?2004h> "]
[110.591095, "o", "    { \"paygate-signature\": good, \"x-replay-timestamp\": String(now) },\r\n\u001b[?2004l\rt "]
[110.591183, "o", "\u001b[?2004h> "]
[110.591986, "o", "    { \"paygate-signature\": good, \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${\"0\".repeat(64)}` },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.592254, "o", "    { \"x-replay-timestamp\": String(now - 7200), \"x-replay-signature\": original.split(\",\")[1] },\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.59237, "o", "> "]
[110.592901, "o", "    { \"x-replay-timestamp\": String(now + 7200), \"x-replay-signature\": `v1=${computeSignature(SECRET, now + 7200, body)}` },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.593259, "o", "    { \"x-replay-timestamp\": \"bad\", \"x-replay-signature\": goodReplay },\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.593352, "o", "> "]
[110.59352, "o", "  for (const h of headers) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.5936, "o", "    assert.equal((await post(body, h)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.593698, "o", "    assert.deepEqual(snapshot(), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[110.593724, "o", "\u001b[?2004h> "]
[110.594385, "o", "  assert.equal((await post(body + \" \", { \"paygate-signature\": good })).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.594549, "o", "  assert.deepEqual(snapshot(), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[110.594598, "o", "> "]
[110.594765, "o", "test(\"signed invalid events return 400 without mutating state\", async (t) => {\r\n\u001b[?2004l\rcontent\u001b[?2004h> "]
[110.595253, "o", "  const { post, snapshot } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot();\r\n\u001b[?2004l\r\u001b[?2004h>   for (const body of [\"{\", \"null\", \"{}\", JSON.stringify({ event_id: \"incomplete\" }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.595487, "o", "    JSON.stringify(event(\"bad_amount\", \"refund.requested\", -1)),\r\n\u001b[?2004l\r 5000, with other currencies in \u001b[?2004h> "]
[110.595657, "o", "    JSON.stringify({ ...event(\"bad_created\"), created: \"not-a-timestamp\" }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.595893, "o", "    JSON.stringify({ ...event(\"bad_currency\"), data: { refund_id: \"rf\", amount: 1, currency: 42 } })]) {\r\n\u001b[?2004l\rr\u001b[?2004h> "]
[110.596185, "o", "    assert.equal((await post(body, { \"paygate-signature\": signature(body) })).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.596479, "o", "    assert.deepEqual(snapshot(), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.596519, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\ri\u001b[?2004h> "]
[110.59689, "o", "test(\"live and replay deliveries deduplicate without raw-event, state, or audit writes\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.597124, "o", "  const { dir, store, post, snapshot } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.597227, "o", "  const body = ' \\n' + JSON.stringify(event(\"dedup\")) + '\\n';\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.597255, "o", "> "]
[110.597338, "o", "  assert.deepEqual(await post(body, { \"paygate-signature\": signature(body) }),\r\n\u001b[?2004l\r"]
[110.59738, "o", "\u001b[?2004h> "]
[110.597472, "o", "    { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.597509, "o", "  const before = snapshot();\r\n\u001b[?2004l\r"]
[110.597544, "o", "\u001b[?2004h> "]
[110.598114, "o", "  const altered = JSON.stringify(event(\"dedup\", \"refund.requested\", 999999));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await post(altered, { \"paygate-signature\": signature(altered) }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.598251, "o", "    { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r"]
[110.5983, "o", "\u001b[?2004h> "]
[110.598381, "o", "  for (const original of [undefined, \"invalid original signature\"] as const) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.598508, "o", "    const headers: Record<string, string> = { \"x-replay-timestamp\": String(now),\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.598593, "o", "> "]
[110.598663, "o", "      \"x-replay-signature\": `v1=${computeSignature(OLD_SECRET, now, body)}` };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.598806, "o", "    if (original) headers[\"paygate-signature\"] = original;\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(await post(body, headers),\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.598835, "o", "> "]
[110.598945, "o", "      { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.599012, "o", "  assert.deepEqual(snapshot(), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.5991, "o", "  assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.599287, "o", "  assert.equal(store.loadRawEvent(\"dedup\"), body);\r\n\u001b[?2004l\r\u001b[?2004h>   const restarted = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.599671, "o", "  assert.equal(processEvent(restarted, POLICY, parseEvent(body)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.599813, "o", "test(\"a replay authenticates independently of the original signature and is processed once\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { post, store, snapshot } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.599927, "o", "  const body = JSON.stringify(event(\"replay_first\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.600094, "o", "  const headers = { \"paygate-signature\": \"not used for replay authentication\",\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.600272, "o", "    \"x-replay-timestamp\": String(now), \"x-replay-signature\": `v1=${computeSignature(SECRET, now, body)}` };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.600477, "o", "  assert.deepEqual(await post(body, headers), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.600517, "o", "  const before = snapshot();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.600611, "o", "  assert.deepEqual(await post(body, headers), { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.600652, "o", "  assert.deepEqual(snapshot(), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.600798, "o", "  assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r"]
[110.600845, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.601029, "o", "test(\"simultaneous retries create one refund\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.601261, "o", "  const { post, store } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const body = JSON.stringify(event(\"concurrent\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.601439, "o", "  const headers = { \"paygate-signature\": signature(body) };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.601579, "o", "  const results = await Promise.all(Array.from({ length: 8 }, () => post(body, headers)));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(results.every((res) => res.status === 200));\r\n\u001b[?2004l\r"]
[110.60162, "o", "\u001b[?2004h>   assert.equal(results.filter((res) => !res.body.duplicate).length, 1);\r\n\u001b[?2004l\r"]
[110.601686, "o", "\u001b[?2004h> "]
[110.601737, "o", "  assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n"]
[110.601771, "o", "\u001b[?2004l\r"]
[110.601801, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.601921, "o", "test(\"ignored events and cancellation audits are deduplicated too\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.601981, "o", "> "]
[110.602039, "o", "  const { post, store, snapshot } = await fixture(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.60217, "o", "  const deliver = (body: string) => post(body, { \"paygate-signature\": signature(body) });\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.602193, "o", "> "]
[110.60237, "o", "  const unknown = JSON.stringify({ event_id: \"unknown_type\", type: \"other.type\", created: NOW });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.602456, "o", "  assert.equal((await deliver(unknown)).status, 200);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.602501, "o", "  const afterUnknown = snapshot();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.602759, "o", "  assert.equal((await deliver(unknown)).body.duplicate, true);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(), afterUnknown);\r\n\u001b[?2004l\r\u001b[?2004h>   const create = JSON.stringify(event(\"create\"));\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.602929, "o", "> "]
[110.603024, "o", "  await deliver(create);\r\n\u001b[?2004l\r\u001b[?2004h>   const cancel = JSON.stringify(event(\"cancel\", \"refund.cancelled\"));\r\n\u001b[?2004l\r\u001b[?2004h>   await deliver(cancel);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.603179, "o", "  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   const afterCancel = snapshot();\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.603355, "o", "  assert.ok(afterCancel.some(([name, content]) => name === \"audit.jsonl\" && content.includes(\"cancel.ignored\")));\r\n\u001b[?2004l\r\u001b[?2004h"]
[110.603397, "o", "> "]
[110.603525, "o", "  assert.equal((await deliver(cancel)).body.duplicate, true);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(), afterCancel);\r\n\u001b[?2004l\r"]
[110.603556, "o", "\u001b[?2004h> "]
[110.603573, "o", "});\r\n\u001b[?2004l\r"]
[110.60371, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.60378, "o", "test(\"configured finance threshold is inclusive INR 5000, with other currencies in review\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.603969, "o", "  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.6041, "o", "  assert.equal(policy.auto_approve_max_minor, 500000);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.604265, "o", "  assert.equal(decideStatus(policy, 499999, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.604335, "o", "  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r"]
[110.604371, "o", "\u001b[?2004h> "]
[110.604526, "o", "  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.604659, "o", "  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[110.604768, "o", "EOF\r\n\u001b[?2004l\r"]
[110.606709, "o", "\u001b[?2004hroot@fcd69533f920:/app# npm test\r\n\u001b[?2004l\r"]
[110.737551, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[110.738318, "o", "\u001b[1G\u001b[0K"]
[111.022377, "o", "\u001b[32m✔ signature rotation checks every supplied signature against every configured secret \u001b[90m(3.673236ms)\u001b[39m\u001b[39m\r\n"]
[111.022668, "o", "\u001b[32m✔ signature timestamps enforce the inclusive window in both directions \u001b[90m(0.886398ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ verification authenticates exact bytes, not reserialized JSON or replacement characters \u001b[90m(0.714244ms)\u001b[39m\u001b[39m\r\n"]
[111.022739, "o", "\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.589764ms)\u001b[39m\u001b[39m\r\n"]
[111.022973, "o", "\u001b[32m✔ replay signatures use the replay timestamp and support rotation \u001b[90m(0.96571ms)\u001b[39m\u001b[39m\r\n"]
[111.101223, "o", "\u001b[32m✔ unauthenticated live and replay requests cannot change any state \u001b[90m(97.124582ms)\u001b[39m\u001b[39m\r\n"]
[111.147868, "o", "\u001b[32m✔ signed invalid events return 400 without mutating state \u001b[90m(49.93792ms)\u001b[39m\u001b[39m\r\n"]
[111.172415, "o", "\u001b[32m✔ live and replay deliveries deduplicate without raw-event, state, or audit writes \u001b[90m(25.515124ms)\u001b[39m\u001b[39m\r\n"]
[111.188483, "o", "\u001b[32m✔ a replay authenticates independently of the original signature and is processed once \u001b[90m(11.472352ms)\u001b[39m\u001b[39m\r\n"]
[111.213905, "o", "\u001b[32m✔ simultaneous retries create one refund \u001b[90m(30.098693ms)\u001b[39m\u001b[39m\r\n"]
[111.2354, "o", "\u001b[32m✔ ignored events and cancellation audits are deduplicated too \u001b[90m(22.077987ms)\u001b[39m\u001b[39m\r\n"]
[111.236685, "o", "\u001b[32m✔ configured finance threshold is inclusive INR 5000, with other currencies in review \u001b[90m(0.609425ms)\u001b[39m\u001b[39m\r\n"]
[111.252021, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.514753ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.110667ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.748699ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.458936ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.388032ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.828865ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.915076ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.455189ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(79.110717ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 21\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 21\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 471.862749\u001b[39m\r\n"]
