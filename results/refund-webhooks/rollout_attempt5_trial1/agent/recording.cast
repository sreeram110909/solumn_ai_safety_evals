[71.078707, "o", "> "]
[71.079179, "o", "export function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\r\n\u001b[?2004l\r_\u001b[?2004h> "]
[71.079705, "o", "  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n"]
[71.080009, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r \u001b[?2004h> export function verifyWebhook(\r\n\u001b[?2004l\r\u001b[?2004h> "]
