[?2004l// Paygate webhook signature handling. See docs/SPEC.md, "Signatures" and "Replays".

import { createHmac, timingSafeEqual } from "node:crypto";

export class SignatureError extends Error {}

export interface SignatureHeader {
  timestamp: number;
  signatures: string[];
}

function parseTimestamp(value: string): number {
  if (!/^\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {
    throw new SignatureError("timestamp must be integer seconds");
  }
  return Number(value);
}

function parseHeader(header: string): SignatureHeader & { timestampText: string } {
  let timestampText: string | undefined;
  const signatures: string[] = [];
  for (const part of header.split(",")) {
    const idx = part.indexOf("=");
    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);
    const key = part.slice(0, idx).trim();
    const value = part.slice(idx + 1).trim();
    if (key === "t") {
      if (timestampText !== undefined) throw new SignatureError("multiple timestamps");
      parseTimestamp(value);
      timestampText = value;
    } else if (key === "v1") {
      if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError("v1 signature must be 64 hex chars");
      signatures.push(value);
    }
    // Ignore unknown signature schemes to allow future versions.
  }
  if (timestampText === undefined) throw new SignatureError("missing timestamp");
  if (signatures.length === 0) throw new SignatureError("no v1 signature");
  return { timestamp: Number(timestampText), timestampText, signatures };
}

// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...
export function parseSignatureHeader(header: string): SignatureHeader {
  const { timestamp, signatures } = parseHeader(header);
  return { timestamp, signatures };
}

export function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {
  return createHmac("sha256", secret).update(`${timestamp}.`, "utf8").update(rawBody).digest("hex");
}

export function verifyWebhook(
  rawBody: string | Buffer,
  header: string | undefined,
  secrets: string[],
  nowSec: number = Math.floor(Date.now() / 1000),
  toleranceSec: number = 300,
): SignatureHeader {
  if (!header) throw new SignatureError("missing Paygate-Signature header");
  const { timestamp, timestampText, signatures } = parseHeader(header);
  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||
      Math.abs(nowSec - timestamp) > toleranceSec) {
    throw new SignatureError("timestamp outside tolerance");
  }
  let matched = false;
  for (const secret of secrets) {
    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), "hex");
    for (const signature of signatures) {
      // Parsing guarantees every signature is exactly 32 bytes. Check all pairs,
      // including during rotation, without comparing the digest as a string.
      const equal = timingSafeEqual(expected, Buffer.from(signature, "hex"));
      matched = equal || matched;
    }
  }
  if (!matched) throw new SignatureError("signature mismatch");
  return { timestamp, signatures };
}

export function verifyReplay(
  rawBody: string | Buffer,
  timestamp: string | undefined,
  header: string | undefined,
  secrets: string[],
  nowSec: number = Math.floor(Date.now() / 1000),
  toleranceSec: number = 300,
): SignatureHeader {
  if (timestamp === undefined) throw new SignatureError("missing X-Replay-Timestamp header");
  parseTimestamp(timestamp); // Validate before combining the two replay headers.
  if (!header) throw new SignatureError("missing X-Replay-Signature header");
  // Same HMAC scheme, but the authenticated timestamp is from the replay service.
  // An extra t= in the signature header is rejected as a duplicate timestamp.
  return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);
}
