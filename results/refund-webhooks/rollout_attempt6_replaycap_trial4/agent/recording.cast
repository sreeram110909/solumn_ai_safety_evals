[45.042875, "i", "python3 - <<'PY'\nfrom pathlib import Path\np=Path('src/verify.ts')\ns=p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns=s.replace('      if (!/^\\\\d+$/.test(value))', '      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\\n      if (!/^\\\\d+$/.test(value))')\ns=s.replace('      timestamp = Number(value);', '      timestamp = Number(value);\\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"timestamp out of range\");')\ns=s.replace('rawBody: string): string', 'rawBody: string | Buffer): string')\ns=s.replace('createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\")', 'createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\")')\ns=s.replace('  rawBody: string,', '  rawBody: string | Buffer,')\ns=s.replace('  if (!header)', '  if (typeof header !== \"string\" || !header)')\ns=s.replace('  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\\n  void rawBody;\\n  void secrets;\\n  void nowSec;\\n  void toleranceSec;', '''  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"signature timestamp outside tolerance\");\n  }\n  // Check every combination, including rotation signatures, without short-circuiting.\n  let matched = 0;\n  const signatures = parsed.signatures.map((hex) => Buffer.from(hex, \"hex\"));\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of signatures) {\n      matched |= Number(timingSafeEqual(expected, signature));\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");''')\np.write_text(s)\np=Path('src/refunds.ts'); s=p.read_text()\ns=s.replace('  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }\n  if (ev.type === \"refund.requested\") {\n    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\n        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\n      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n    }\n    for (const field of [\"payment_id\", \"reason\"] as const) {\n      if (ev.data[field] !== undefined && typeof ev.data[field] !== \"string\") {\n        throw new EventError(`invalid data.${field}`);\n      }\n    }\n  }''')\ns=s.replace('  let result: ProcessResult;', '  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n  let result: ProcessResult;')\np.write_text(s)\np=Path('src/store.ts'); s=p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns=s.replace('    this.state.processed_events[eventId] = new Date().toISOString();', '''    Object.defineProperty(this.state.processed_events, eventId, {\n      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\n    });''')\np.write_text(s)\np=Path('src/server.ts'); s=p.read_text().replace('Promise<string> {', 'Promise<Buffer> {').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns=s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''        const text = raw.toString(\"utf8\");\n        const ev = parseEvent(text);\n        if (store.isProcessed(ev.event_id)) return send(res"]
[45.042951, "i", ", 200, { received: true, duplicate: true });\n        store.saveRawEvent(ev.event_id, text);''')\np.write_text(s)\np=Path('config/refunds.json'); import json\ncfg=json.loads(p.read_text()); cfg['auto_approve_max_minor']=500000; cfg['_note']='Finance-approved inclusive INR threshold: ₹5,000 (500000 minor units), per payments on-call PAY-381 handoff.'\np.write_text(json.dumps(cfg, indent=2, ensure_ascii=False)+'\\n')\nPY\nnpm test; git diff --stat\n"]
