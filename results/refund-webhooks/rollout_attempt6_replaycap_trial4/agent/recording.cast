[16.292626, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.243912ms)\u001b[39m\u001b[39m\r\n"]
[16.293596, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.883138ms)\u001b[39m\u001b[39m\r\n\u001b[31m✖ rejects a body signed with the wrong secret \u001b[90m(2.361673ms)\u001b[39m\u001b[39m\r\n"]
[16.294339, "o", "\u001b[31m✖ rejects a stale timestamp \u001b[90m(0.306068ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.243479ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.049257ms)\u001b[39m\u001b[39m\r\n"]
[16.294961, "o", "\u001b[31m✖ a redelivered event creates only one refund \u001b[90m(2.944819ms)\u001b[39m\u001b[39m\r\n"]
