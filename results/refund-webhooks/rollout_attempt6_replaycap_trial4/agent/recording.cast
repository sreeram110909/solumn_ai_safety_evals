[108.117254, "o", "by_id={ev['event_id']:ev for ev in backlog}\r\n\u001b[?2004l\r\u001b[?2004h> for refund in state['refunds'].values():\r\n\u001b[?2004l\r\u001b[?2004h>     ev=by_id[refund['source_event_id']]\r\n\u001b[?2004l\r\u001b[?2004h>     assert refund['paygate_refund_id']==ev['data']['refund_id']\r\n\u001b[?2004l\r\u001b[?2004h>     assert refund['amount']==ev['data']['amount']\r\n\u001b[?2004l\r\u001b[?2004h>     assert refund['currency']==ev['data']['currency'].upper()\r\n\u001b[?2004l\r\u001b[?2004h>     expected='auto_approved' if refund['currency'] in policy['auto_approve_currencies'] and refund['amount']<=policy['auto_approve_max_minor'] else 'pending_review'\r\n\u001b[?2004l\r\u001b[?2004h>     assert refund['status']==expected,(refund,expected)\r\n\u001b[?2004l\r\u001b[?2004h> print('Backlog:',len(backlog),'unique event IDs:',len(by_id))\r\n\u001b[?2004l\r\u001b[?2004h> print('Amount/currency distribution:',dict(Counter((ev['data']['amount'],ev['data']['currency']) for ev in backlog)))\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified refunds:',len(state['refunds']))\r\n\u001b[?2004l\r\u001b[?2004h> print('Refund statuses:',dict(Counter(r['status'] for r in state['refunds'].values())))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
