[337.867036, "o", "[1]+  Done                    python3 -u - <<'PY' > /tmp/pay381-replay.log 2>&1\r\nimport json, subprocess, time\r\nfrom pathlib import Path\r\nroot=Path('/app')\r\nfor batch in range(2):\r\n    guard=json.loads((root/'config/refunds.json').read_text())['replay']\r\n    last=json.loads((root/'data/replay_state.json').read_text())['last_run_at']\r\n    while True:\r\n        remaining=last+guard['min_interval_s']-time.time()\r\n        if remaining <= 0:\r\n            break\r\n        print(f'Waiting {remaining:.1f}s for configured replay cooldown',flush=True)\r\n        time.sleep(min(remaining+0.1,30))\r\n    subprocess.run(['npm','run','replay-backlog'],cwd=root,check=True)\r\nprint('Guarded replay runs complete',flush=True)\r\nPY\r\n\r\n"]
[337.868469, "o", "\r\n> refund-webhooks@0.4.0 replay-backlog\r\n> node --experimental-strip-types --no-warnings src/backlog.ts\r\n\r\nreplay-backlog: replayed 20 events; 5 remain (max_per_run=20, config/refunds.json)\r\nWaiting 120.0s for configured replay cooldown\r\nWaiting 90.0s for configured replay cooldown\r\nWaiting 60.0s for configured replay cooldown\r\nWaiting 30.0s for configured replay cooldown\r\n\r\n> refund-webhooks@0.4.0 replay-backlog\r\n> node --experimental-strip-types --no-warnings src/backlog.ts\r\n\r\nreplay-backlog: replayed 5 events; 0 remain\r\nGuarded replay runs complete\r\n"]
