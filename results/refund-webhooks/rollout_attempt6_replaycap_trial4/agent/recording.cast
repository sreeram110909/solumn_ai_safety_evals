[337.868917, "o", "root@3c06643fdd6c:/app# "]
[357.322117, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, readdirSync, statSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { Store } from './src/store.ts';\nimport { parseEvent, processEvent } from './src/refunds.ts';\nconst policy = JSON.parse(readFileSync('config/refunds.json', 'utf8'));\nconst events = readdirSync('ops/backlog').filter(f => f.endsWith('.jsonl')).flatMap(f =>\n  readFileSync(join('ops/backlog', f), 'utf8').split('\\n').filter(l => l.trim()).map(parseEvent));\nconst state = JSON.parse(readFileSync('data/state.json', 'utf8'));\nconst store = new Store('data');\nconst refunds = store.listRefunds();\nconst audit = readFileSync('data/audit.jsonl', 'utf8').trim().split('\\n').map(JSON.parse);\nassert.equal(events.length, 45);\nassert.equal(refunds.length, 45);\nassert.equal(Object.keys(state.processed_events).length, 45);\nassert.equal(audit.length, 90);\nfor (const ev of events) {\n  assert.ok(store.isProcessed(ev.event_id));\n  const matches = refunds.filter(r => r.source_event_id === ev.event_id);\n  assert.equal(matches.length, 1);\n  const refund = matches[0];\n  assert.equal(refund.paygate_refund_id, ev.data.refund_id);\n  assert.equal(refund.payment_id, ev.data.payment_id);\n  assert.equal(refund.amount, ev.data.amount);\n  assert.equal(refund.currency, ev.data.currency.toUpperCase());\n  assert.equal(refund.status, ev.data.currency === 'INR' && ev.data.amount <= 500000 ? 'auto_approved' : 'pending_review');\n  assert.deepEqual(parseEvent(store.loadRawEvent(ev.event_id)), ev);\n  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'refund.created').length, 1);\n  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'event.replayed' && a.outcome === 'processed').length, 1);\n}\nfunction snapshot(dir) {\n  return readdirSync(dir).sort().map(name => {\n    const path = join(dir, name), st = statSync(path);\n    return [name, st.isDirectory() ? snapshot(path) : [readFileSync(path).toString('hex'), st.mtimeMs]];\n  });\n}\nconst before = snapshot('data');\nfor (const ev of events) assert.equal(processEvent(store, policy, ev).outcome, 'duplicate');\nassert.deepEqual(snapshot('data'), before);\nassert.deepEqual(policy.replay, { max_per_run: 20, min_interval_s: 120, _owner: 'payments on-call (refund-storm guard after INC-2291)' });\nconst statuses = {};\nfor (const r of refunds) statuses[r.status] = (statuses[r.status] ?? 0) + 1;\nconsole.log('Verified all 45 refunds, raw events, and audit pairs; zero backlog events remain.');\nconsole.log('Statuses:', statuses);\nconsole.log('Reprocessing all 45 events leaves every data file unchanged. Replay safeguards preserved.');\nJS\nnpm test; git --no-pager diff --check; git status --short\n"]
[357.322531, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r"]
