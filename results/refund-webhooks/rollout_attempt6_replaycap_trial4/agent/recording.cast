[357.446813, "o", "\u001b[?2004hroot@3c06643fdd6c:/app# npm test; git --no-pager diff --check; git status --short\r\n\u001b[?2004l\r"]
[357.542756, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[357.543249, "o", "\u001b[1G\u001b[0K"]
[357.768833, "o", "\u001b[32m✔ HMAC uses the original bytes and supports all rotation combinations \u001b[90m(2.394243ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive in both directions \u001b[90m(0.514456ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.424464ms)\u001b[39m\u001b[39m\r\n"]
[357.770654, "o", "\u001b[32m✔ configured policy honors the inclusive INR-only finance threshold \u001b[90m(1.077966ms)\u001b[39m\u001b[39m\r\n"]
[357.770758, "o", "\u001b[32m✔ invalid events fail validation; unhandled types need no refund data \u001b[90m(0.801861ms)\u001b[39m\u001b[39m\r\n"]
[357.771102, "o", "\u001b[32m✔ dedup persists across restart and never changes refunds, raw events, or audits \u001b[90m(16.879359ms)\u001b[39m\u001b[39m\r\n"]
[357.771143, "o", "\u001b[32m✔ cancellations and ignored events are idempotent, including ignored auto-approved cancellations \u001b[90m(5.13267ms)\u001b[39m\u001b[39m\r\n"]
[357.873917, "o", "\u001b[32m✔ HTTP: signature failures never mutate state, signed invalid events are 400, duplicates are read-only \u001b[90m(125.014204ms)\u001b[39m\u001b[39m\r\n"]
[357.888057, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.040028ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.904654ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.648468ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.368885ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.181978ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.404631ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.639804ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(0.963087ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 16\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 16\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 308.223403\u001b[39m\r\n"]
[357.893082, "o", "\u001b[1G\u001b[0K⠙"]
[357.894957, "o", "\u001b[1G\u001b[0K"]
