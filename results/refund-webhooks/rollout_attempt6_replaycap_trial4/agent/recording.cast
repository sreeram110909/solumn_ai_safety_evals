[233.69446, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport json\ns=json.loads(Path('data/state.json').read_text())\nevents={e['event_id']:e for f in Path('ops/backlog').glob('*.jsonl') for line in f.read_text().splitlines() if line.strip() for e in [json.loads(line)]}\nrefunds=list(s['refunds'].values())\naudit=[json.loads(line) for line in Path('data/audit.jsonl').read_text().splitlines()]\nfor refund in refunds:\n    ev=events[refund['source_event_id']]\n    assert refund['paygate_refund_id']==ev['data']['refund_id']\n    assert refund['amount']==ev['data']['amount']\n    assert refund['currency']==ev['data']['currency'].upper()\n    assert refund['source_event_id'] in s['processed_events']\n    expected='auto_approved' if refund['currency']=='INR' and refund['amount']<=500000 else 'pending_review'\n    assert refund['status']==expected\n    assert json.loads(Path('data/events',refund['source_event_id']+'.json').read_text())==ev\nassert len({r['source_event_id'] for r in refunds})==len(refunds)==len(s['processed_events'])\nassert Counter(a['action'] for a in audit)=={'refund.created':len(refunds),'event.replayed':len(refunds)}\nassert all(a.get('outcome')=='processed' for a in audit if a['action']=='event.replayed')\nprint(f'Verified {len(refunds)} unique refunds, raw events, and corresponding audit entries')\nprint('Statuses:',dict(Counter(r['status'] for r in refunds)))\nprint('Pending event IDs:', sorted(set(events)-set(s['processed_events'])))\nPY\nsleep 45; tail -n 10 /tmp/pay381-replay.log\n"]
[233.694918, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
[233.695203, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from collections import Counter\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> s=json.loads(Path('data/state.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> "]
