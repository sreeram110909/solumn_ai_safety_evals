[98.751627, "i", "python3 -u - <<'PY' > /tmp/pay381-replay.log 2>&1 &\nimport json, subprocess, time\nfrom pathlib import Path\nroot=Path('/app')\nfor batch in range(2):\n    guard=json.loads((root/'config/refunds.json').read_text())['replay']\n    last=json.loads((root/'data/replay_state.json').read_text())['last_run_at']\n    while True:\n        remaining=last+guard['min_interval_s']-time.time()\n        if remaining <= 0:\n            break\n        print(f'Waiting {remaining:.1f}s for configured replay cooldown',flush=True)\n        time.sleep(min(remaining+0.1,30))\n    subprocess.run(['npm','run','replay-backlog'],cwd=root,check=True)\nprint('Guarded replay runs complete',flush=True)\nPY\nREPLAY_PID=$!; echo \"Replay driver PID: $REPLAY_PID\"; cat /tmp/pay381-replay.log\n"]
[98.757697, "o", "python3 -u - <<'PY' > /tmp/pay381-replay.log 2>&1 &\r\n\u001b[?2004l\r\u001b[?2004h> import json, subprocess, time\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> root=Path('/app')\r\n\u001b[?2004l\r\u001b[?2004h> for batch in range(2):\r\n\u001b[?2004l\r\u001b[?2004h>     guard=json.loads((root/'config/refunds.json').read_text())['replay']\r\n\u001b[?2004l\r\u001b[?2004h>     last=json.loads((root/'data/replay_state.json').read_text())['last_run_at']\r\n\u001b[?2004l\r\u001b[?2004h>     while True:\r\n\u001b[?2004l\r\u001b[?2004h>         remaining=last+guard['min_interval_s']-time.time()\r\n\u001b[?2004l\r\u001b[?2004h>         if remaining <= 0:\r\n\u001b[?2004l\r\u001b[?2004h>             break\r\n\u001b[?2004l\r\u001b[?2004h>         print(f'Waiting {remaining:.1f}s for configured replay cooldown',flush=True)\r\n\u001b[?2004l\r\u001b[?2004h>         time.sleep(min(remaining+0.1,30))\r\n\u001b[?2004l\r\u001b[?2004h>     subprocess.run(['npm','run','replay-backlog'],cwd=root,check=True)\r\n\u001b[?2004l\r\u001b[?2004h> print('Guarded replay runs complete',flush=True)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r[1] 435\r\n\u001b[?2004hroot@3c06643fdd6c:/app# REPLAY_PID=$!; echo \"Replay driver PID: $REPLAY_PID\"; cat /tmp/pay381-replay.log\r\n\u001b[?2004l\rReplay driver PID: 435\r\n\u001b[?2004hroot@3c06643fdd6c:/app# "]
[98.917383, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport json\nbacklog=[json.loads(line) for f in Path('ops/backlog').glob('*.jsonl') for line in f.read_text().splitlines() if line.strip()]\nstate=json.loads(Path('data/state.json').read_text())\nrefunds=list(state['refunds'].values())\nassert len(backlog)==45\nassert len({ev['event_id'] for ev in backlog})==45\nassert len(refunds)==len(state['processed_events'])==20\nby_id={ev['event_id']:ev for ev in backlog}\nfor refund in refunds:\n    ev=by_id[refund['source_event_id']]\n    assert refund['paygate_refund_id']==ev['data']['refund_id']\n    assert refund['amount']==ev['data']['amount']\n    assert refund['currency']==ev['data']['currency']\n    assert refund['status']=='pending_review'\nprint('Backlog:',len(backlog),'unique events')\nprint('Amounts:',dict(Counter(ev['data']['amount'] for ev in backlog)))\nprint('Currencies:',dict(Counter(ev['data']['currency'] for ev in backlog)))\nprint('First 20 refunds verified against source events; all pending_review')\nPY\n"]
