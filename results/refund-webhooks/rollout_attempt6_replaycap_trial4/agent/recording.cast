[165.90043, "o", "\u001b[32m✔ HMAC uses the original bytes and supports all rotation combinations \u001b[90m(2.196699ms)\u001b[39m\u001b[39m\r\n"]
[165.900696, "o", "\u001b[32m✔ timestamp tolerance is inclusive in both directions \u001b[90m(0.512601ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.337847ms)\u001b[39m\u001b[39m\r\n"]
[165.901446, "o", "\u001b[32m✔ configured policy honors the inclusive INR-only finance threshold \u001b[90m(0.800965ms)\u001b[39m\u001b[39m\r\n"]
[165.902786, "o", "\u001b[32m✔ invalid events fail validation; unhandled types need no refund data \u001b[90m(0.538416ms)\u001b[39m\u001b[39m\r\n"]
[165.90298, "o", "\u001b[32m✔ dedup persists across restart and never changes refunds, raw events, or audits \u001b[90m(15.197322ms)\u001b[39m\u001b[39m\r\n"]
[165.903285, "o", "\u001b[32m✔ cancellations and ignored events are idempotent, including ignored auto-approved cancellations \u001b[90m(28.045855ms)\u001b[39m\u001b[39m\r\n"]
[166.01913, "o", "\u001b[32m✔ HTTP: signature failures never mutate state, signed invalid events are 400, duplicates are read-only \u001b[90m(140.443901ms)\u001b[39m\u001b[39m\r\n"]
[166.032736, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.050634ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.762912ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(1.853635ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.740645ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.18413ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.276507ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.612759ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.027721ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 16\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 16\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 331.527744\u001b[39m\r\n"]
