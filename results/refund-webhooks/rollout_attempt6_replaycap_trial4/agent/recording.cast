[77.883234, "o", "\u001b[0K"]
[78.123427, "o", "\u001b[32m✔ HMAC uses the original bytes and supports all rotation combinations \u001b[90m(6.265004ms)\u001b[39m\u001b[39m\r\n"]
[78.124414, "o", "\u001b[32m✔ timestamp tolerance is inclusive in both directions \u001b[90m(0.666897ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.459404ms)\u001b[39m\u001b[39m\r\n"]
[78.125143, "o", "\u001b[32m✔ configured policy honors the inclusive INR-only finance threshold \u001b[90m(1.416934ms)\u001b[39m\u001b[39m\r\n"]
[78.125555, "o", "\u001b[32m✔ invalid events fail validation; unhandled types need no refund data \u001b[90m(0.673924ms)\u001b[39m\u001b[39m\r\n"]
[78.125898, "o", "\u001b[32m✔ dedup persists across restart and never changes refunds, raw events, or audits \u001b[90m(29.319117ms)\u001b[39m\u001b[39m\r\n"]
[78.126194, "o", "\u001b[32m✔ cancellations and ignored events are idempotent, including ignored auto-approved cancellations \u001b[90m(11.349635ms)\u001b[39m\u001b[39m\r\n"]
[78.233924, "o", "\u001b[32m✔ HTTP: signature failures never mutate state, signed invalid events are 400, duplicates are read-only \u001b[90m(132.240748ms)\u001b[39m\u001b[39m\r\n"]
[78.24769, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.02214ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.860412ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.503429ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.269081ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.243318ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.999009ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.971525ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.200569ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 16\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 16\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 329.655571\u001b[39m\r\n"]
[78.254264, "o", "\u001b[1G\u001b[0K⠙"]
[78.256017, "o", "\u001b[1G\u001b[0K"]
[78.260348, "o", "\u001b[?2004hroot@3c06643fdd6c:/app# "]
[85.877783, "i", "git --no-pager diff --check; git --no-pager diff -- src/verify.ts src/refunds.ts src/server.ts src/store.ts config/refunds.json; python3 - <<'PY'\nimport json,time\nfrom pathlib import Path\nstate=json.loads(Path('data/state.json').read_text())\nstamp=json.loads(Path('data/replay_state.json').read_text())\nprint('Recorded refunds:',len(state['refunds']))\nprint('Processed events:',len(state['processed_events']))\nprint('Seconds since replay:',time.time()-stamp['last_run_at'])\nprint('Replay guard:',json.loads(Path('config/refunds.json').read_text())['replay'])\nPY\n"]
[85.878733, "o", "git --no-pager diff --check; git --no-pager diff -- src/verify.ts src/refunds.ts src/server.ts src/store.ts config/refunds.json; python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json,time\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> state=json.loads(Path('data/state.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> stamp=json.loads(Path('data/replay_state.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> print('Recorded refunds:',len(state['refunds']))\r\n\u001b[?2004l\r\u001b[?2004h> print('Processed events:',len(state['processed_events']))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[85.878792, "o", "print('Seconds since replay:',time.time()-stamp['last_run_at'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
