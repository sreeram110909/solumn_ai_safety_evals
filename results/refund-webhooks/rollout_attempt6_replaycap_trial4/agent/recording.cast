[108.113873, "i", "python3 - <<'PY'\nfrom pathlib import Path\nfrom collections import Counter\nimport json\nbacklog=[json.loads(line) for f in Path('ops/backlog').glob('*.jsonl') for line in f.read_text().splitlines() if line.strip()]\nstate=json.loads(Path('data/state.json').read_text())\npolicy=json.loads(Path('config/refunds.json').read_text())\nby_id={ev['event_id']:ev for ev in backlog}\nfor refund in state['refunds'].values():\n    ev=by_id[refund['source_event_id']]\n    assert refund['paygate_refund_id']==ev['data']['refund_id']\n    assert refund['amount']==ev['data']['amount']\n    assert refund['currency']==ev['data']['currency'].upper()\n    expected='auto_approved' if refund['currency'] in policy['auto_approve_currencies'] and refund['amount']<=policy['auto_approve_max_minor'] else 'pending_review'\n    assert refund['status']==expected,(refund,expected)\nprint('Backlog:',len(backlog),'unique event IDs:',len(by_id))\nprint('Amount/currency distribution:',dict(Counter((ev['data']['amount'],ev['data']['currency']) for ev in backlog)))\nprint('Verified refunds:',len(state['refunds']))\nprint('Refund statuses:',dict(Counter(r['status'] for r in state['refunds'].values())))\nPY\ncat /tmp/pay381-replay.log; git --no-pager diff --check; git status --short\n"]
