[77.750591, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readdirSync, readFileSync, rmSync, statSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { buildApp } from \"../src/server.ts\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_regression\";\nconst NOW = 1763542800;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nfunction event(id: string, type = \"refund.requested\", amount = 500000) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_regression\", payment_id: \"pay_regression\", amount, currency: \"INR\" } };\n}\nfunction signed(raw: string | Buffer, at = NOW, secret = SECRET) {\n  return `t=${at},v1=${computeSignature(secret, at, raw)}`;\n}\nfunction snapshot(dir: string): unknown[] {\n  return readdirSync(dir).sort().map((name) => {\n    const path = join(dir, name);\n    const stat = statSync(path);\n    return [name, stat.isDirectory() ? snapshot(path) : [readFileSync(path).toString(\"hex\"), stat.mtimeMs]];\n  });\n}\n\ntest(\"HMAC uses the original bytes and supports all rotation combinations\", () => {\n  const raw = Buffer.from('{ \"message\": \"₹5,000\", \"space\": true }\\n');\n  const expected = createHmac(\"sha256\", SECRET).update(`${NOW}.`).update(raw).digest(\"hex\");\n  assert.equal(computeSignature(SECRET, NOW, raw), expected);\n  const header = `t=${NOW},v1=${\"0\".repeat(64)},v1=${expected}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, header, [\"old-secret\", SECRET], NOW));\n  assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET, \"next-secret\"], NOW));\n  assert.throws(() => verifyWebhook(raw.toString().trim(), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(raw, header, [], NOW), SignatureError);\n  const bytes = Buffer.from([0xff, 0x00, 0x80]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signed(bytes), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signed(bytes), [SECRET], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive in both directions\", () => {\n  const raw = JSON.stringify(event(\"evt_clock\"));\n  for (const offset of [-300, 0, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, signed(raw, NOW + offset), [SECRET], NOW));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signed(raw, NOW + offset), [SECRET], NOW), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(raw, signed(raw, NOW + 11), [SECRET], NOW, 10), SignatureError);\n});\n\ntest(\"missing and malformed signature headers fail closed\", () => {\n  const raw = JSON.stringify(event(\"evt_headers\"));\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), `t=${NOW}`, `t=${NOW},v1=nope`,\n    `t=${NOW},v1=${\"A\".repeat(64)}`, `t=${NOW},t=${NOW},v1=${\"0\".repeat(64)}`,\n    `t=999999999999999999999999,v1=${\"0\".repeat(64)}`]) {\n    assert.throws(() => verifyWebhook(raw, header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"configured policy honors the inclusive INR-only finance threshold\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"invalid events fail validation; unhandled types need no refund data\", () => {\n  for (const raw of [\"{\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(\"evt\"), created: \"bad\" }),\n    JSON.stringify(event(\"evt\", \"refund.requested\", 0)),\n    JSON.stringify({ ...event(\"evt\"), data"]
[77.752293, "i", ": { refund_id: \"rf\", amount: 1, currency: \"\" } })]) {\n    assert.throws(() => parseEvent(raw), EventError);\n  }\n  assert.equal(parseEvent(JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW })).type,\n    \"payment.updated\");\n});\n\ntest(\"dedup persists across restart and never changes refunds, raw events, or audits\", (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  const store = new Store(dir);\n  for (const id of [\"evt_persist\", \"constructor\", \"__proto__\"]) {\n    const ev = event(id);\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(new Store(dir), POLICY, { ...ev, data: { ...ev.data, amount: 1 } }).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(new Store(dir).listRefunds().length, 3);\n});\n\ntest(\"cancellations and ignored events are idempotent, including ignored auto-approved cancellations\", (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-cancel-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  const store = new Store(dir);\n  processEvent(store, POLICY, event(\"evt_request\", \"refund.requested\", 500001));\n  const cancel = event(\"evt_cancel\", \"refund.cancelled\");\n  processEvent(store, POLICY, cancel);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  let before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  const auto = event(\"evt_auto\");\n  auto.data.refund_id = \"rf_auto\";\n  processEvent(store, POLICY, auto);\n  const ignore = { ...event(\"evt_ignore\", \"refund.cancelled\"), data: { ...auto.data } };\n  assert.equal(processEvent(store, POLICY, ignore).outcome, \"ignored\");\n  before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, ignore).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  const unknown = parseEvent(JSON.stringify({ event_id: \"evt_unhandled\", type: \"payment.updated\", created: NOW }));\n  assert.equal(processEvent(store, POLICY, unknown).outcome, \"ignored\");\n  before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, unknown).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"HTTP: signature failures never mutate state, signed invalid events are 400, duplicates are read-only\", async (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [\"previous\", SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  t.after(async () => {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const base = `http://127.0.0.1:${address.port}`;\n  const post = (raw: string, headers: Record<string, string> = {}) =>\n    fetch(`${base}/webhooks/paygate`, { method: \"POST\", headers, body: raw });\n  const now = Math.floor(Date.now() / 1000);\n  const raw = JSON.stringify(event(\"evt_http\"));\n  const initial = snapshot(dir);\n  for (const headers of [{}, { \"paygate-signature\": signed(raw, now, \"wrong\") },\n    { \"paygate-signature\": signed(raw, now - 3600) }, { \"paygate-signature\": signed(raw, now + 3600) },\n    { \"x-paygate-replay-token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), initial);\n  }\n  assert.equal((await post(\"{\", { \"paygate-signature\": signed(\"{\", now, \"wrong\") })).status, 401);\n  for (const invalid of [\"{\", \"null\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", -1))]) {\n    assert.equal((await post(invalid, { \"paygate-signature\": signed(invalid, now)"]
[77.752629, "i", " })).status, 400);\n    assert.deepEqual(snapshot(dir), initial);\n  }\n  const first = await post(raw, { \"paygate-signature\": signed(raw, now) });\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  const before = snapshot(dir);\n  const differentRaw = `  ${JSON.stringify(event(\"evt_http\", \"refund.requested\", 1))}\\n`;\n  const results = await Promise.all(Array.from({ length: 8 }, () =>\n    post(differentRaw, { \"paygate-signature\": signed(differentRaw, now) })));\n  for (const result of results) {\n    assert.equal(result.status, 200);\n    assert.deepEqual(await result.json(), { received: true, duplicate: true });\n  }\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(store.loadRawEvent(\"evt_http\"), raw);\n  assert.equal((await post(raw)).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal((await fetch(`${base}/admin/replay/evt_http`, { method: \"POST\" })).status, 401);\n  const unknown = JSON.stringify({ event_id: \"evt_http_unknown\", type: \"payment.updated\", created: now });\n  for (const duplicate of [false, true]) {\n    const response = await post(unknown, { \"paygate-signature\": signed(unknown, now) });\n    assert.equal(response.status, 200);\n    assert.deepEqual(await response.json(), { received: true, duplicate });\n  }\n});\nEOF\nnpm test\n"]
