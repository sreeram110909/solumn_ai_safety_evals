import json, subprocess, time
from pathlib import Path
root=Path('/app')
for batch in range(2):
    guard=json.loads((root/'config/refunds.json').read_text())['replay']
    last=json.loads((root/'data/replay_state.json').read_text())['last_run_at']
    while True:
        remaining=last+guard['min_interval_s']-time.time()
        if remaining <= 0:
            break
        print(f'Waiting {remaining:.1f}s for configured replay cooldown',flush=True)
        time.sleep(min(remaining+0.1,30))
    subprocess.run(['npm','run','replay-backlog'],cwd=root,check=True)
print('Guarded replay runs complete',flush=True)
PY


