[113.558207, "o", "\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,9 +1,9 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n   \"auto_approve_currencies\": [\u001b[m\r\n     \"INR\"\u001b[m\r\n   ],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"_note\": \"Finance approved auto-approval up to and including INR 5000 (500000 minor units); payments on-call owns this policy.\",\u001b[m\r\n   \"replay\": {\u001b[m\r\n     \"max_per_run\": 20,\u001b[m\r\n     \"min_interval_s\": 120,\u001b[m\r\n\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..7ccba8a 100644\u001b[m\r\n\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -36,8 +36,14 @@\u001b[m \u001b[mexport function parseEvent(raw: string): PaygateEvent {\u001b[m\r\n   }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (ev.type === \"refund.requested\") validateRequested(ev);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   return ev;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -46,19 +52,28 @@\u001b[m \u001b[mexport function decideStatus(policy: RefundPolicy, amount: number, currency: str\u001b[m\r\n   return currencyOk && amount <= policy.auto_approve_max_minor ? \"auto_approved\" : \"pending_review\";\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[113.707884, "i", "cat > test/security.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { mkdtempSync, readFileSync, readdirSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { EventError, decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"test-current-secret\";\nconst OLD_SECRET = \"test-previous-secret\";\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\n\nfunction event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\n  return { event_id: id, type, created: 1731920000,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount: 500_000, currency: \"INR\", ...data } };\n}\n\nfunction signature(body: string | Uint8Array, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => {\n      const path = join(entry.parentPath, entry.name);\n      return [path, readFileSync(path, \"utf8\")];\n    }));\n}\n\ntest(\"signature rotation matches any v1 against any configured secret\", () => {\n  const body = JSON.stringify(event(\"rotation\"));\n  const now = 1731920000;\n  for (const secret of [SECRET, OLD_SECRET]) {\n    for (const candidates of [\n      [\"0\".repeat(64), computeSignature(secret, now, body)],\n      [computeSignature(secret, now, body), \"0\".repeat(64)],\n    ]) {\n      const header = `t=${now},${candidates.map((v) => `v1=${v}`).join(\",\")}`;\n      assert.doesNotThrow(() => verifyWebhook(body, header, [SECRET, OLD_SECRET], now));\n    }\n  }\n  assert.throws(() => verifyWebhook(body, signature(body, now), [], now), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and enforced in both directions\", () => {\n  const body = JSON.stringify(event(\"time\"));\n  const now = 1731920000;\n  for (const delta of [-300, 0, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(body, signature(body, now + delta), [SECRET], now));\n  }\n  for (const delta of [-301, 301]) {\n    assert.throws(() => verifyWebhook(body, signature(body, now + delta), [SECRET], now), SignatureError);\n  }\n});\n\ntest(\"missing and malformed signatures are rejected\", () => {\n  const body = JSON.stringify(event(\"malformed\"));\n  const now = 1731920000;\n  const digest = computeSignature(SECRET, now, body);\n  for (const header of [undefined, \"\", `t=${now}`, `v1=${digest}`, `t=no,v1=${digest}`,\n    `t=${now},v1=aa`, `t=${now},v1=${\"G\".repeat(64)}`, `t=${now},t=${now},v1=${digest}`,\n    `t=${\"9\".repeat(100)},v1=${digest}`]) {\n    assert.throws(() => verifyWebhook(body, header, [SECRET], now), SignatureError);\n  }\n});\n\ntest(\"verification uses exact body bytes, not normalized JSON or decoded bytes\", () => {\n  const body = JSON.stringify(event(\"raw\"), null, 2);\n  const now = 1731920000;\n  const header = signature(body, now);\n  assert.doesNotThrow(() => verifyWebhook(Buffer.from(body), header, [SECRET], now));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body)), header, [SECRET], now), SignatureError);\n  assert.throws(() => verifyWebhook(body + \"\\n\", header, [SECRET], now), SignatureError);\n  const bytes = Buffer.from([0xff]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signature(bytes, now), [SECRET], now));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signature(bytes, now), [SECRET], now), SignatureError);\n});\n\ntest(\"refund policy matches Dana's inclusive INR threshold and preserves replay guards\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto"]
[113.708076, "i", "_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n  assert.equal(policy.replay.max_per_run, 20);\n  assert.equal(policy.replay.min_interval_s, 120);\n});\n\ntest(\"duplicate requests survive restart without any state or audit changes\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"refund-dedup-\"));\n  let store = new Store(dir);\n  const ev = event(\"durable\");\n  processEvent(store, POLICY, ev);\n  const before = snapshot(dir);\n  store = new Store(dir);\n  assert.deepEqual(processEvent(store, POLICY, { ...ev, data: { ...ev.data, amount: 900_000 } }),\n    { outcome: \"duplicate\" });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 1);\n});\n\ntest(\"cancellations and ignored events are deduplicated without repeat audits\", () => {\n  for (const amount of [100, 900_000]) {\n    const dir = mkdtempSync(join(tmpdir(), \"refund-cancel-\"));\n    const store = new Store(dir);\n    processEvent(store, POLICY, event(\"request\", \"refund.requested\", { amount }));\n    const cancel = event(\"cancel\", \"refund.cancelled\");\n    processEvent(store, POLICY, cancel);\n    assert.equal(store.listRefunds()[0].status, amount === 100 ? \"auto_approved\" : \"cancelled\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n    const unknown = parseEvent(JSON.stringify({ event_id: \"unknown\", type: \"payment.updated\", created: 1 }));\n    assert.equal(processEvent(store, POLICY, unknown).outcome, \"ignored\");\n    const after = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, unknown).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), after);\n  }\n});\n\ntest(\"event IDs matching object prototype names are not false duplicates\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"refund-ids-\"));\n  const store = new Store(dir);\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n    assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");\n  }\n  assert.equal(store.listRefunds().length, 3);\n});\n\ntest(\"invalid handled events raise EventError before any processing\", () => {\n  for (const ev of [null, {}, { ...event(\"bad\"), created: \"yesterday\" },\n    event(\"bad\", \"refund.requested\", { amount: -1 }),\n    event(\"bad\", \"refund.requested\", { amount: 1.5 }),\n    event(\"bad\", \"refund.requested\", { currency: \"\" }),\n    event(\"bad\", \"refund.requested\", { reason: {} }),\n    event(\"bad\", \"refund.cancelled\", { refund_id: \"\" })]) {\n    assert.throws(() => parseEvent(JSON.stringify(ev)), EventError);\n  }\n});\n\ntest(\"HTTP receiver rejects unauthenticated requests and processes signed events once\", async (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"refund-http-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET, OLD_SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const url = `http://127.0.0.1:${address.port}/webhooks/paygate`;\n  const post = (body: string, headers: Record<string, string> = {}) => fetch(url, { method: \"POST\", body, headers });\n  const raw = JSON.stringify(event(\"http\"), null, 2);\n  const before = snapshot(dir);\n  for (const headers of [\n    {},\n    { \"x-paygate-replay-token\": \"untrusted-replay-token\" },\n    { \"paygate-signature\": signature(raw, undefined, \"wrong-secret\") },\n    { \"paygate-signature\": signature(raw, Math.floor(Date.now() / 1000) - 301) },\n    { \"paygate-signature\": signature(raw, Math.floor(Date.now("]
[113.708106, "i", ") / 1000) + 3600) },\n    { \"paygate-signature\": signature(JSON.stringify(JSON.parse(raw))) },\n  ]) {\n    const res = await post(raw, headers);\n    assert.equal(res.status, 401);\n    await res.json();\n    assert.deepEqual(snapshot(dir), before);\n  }\n  for (const body of [\"not json\", JSON.stringify(event(\"invalid\", \"refund.requested\", { amount: -1 }))]) {\n    const res = await post(body, { \"paygate-signature\": signature(body) });\n    assert.equal(res.status, 400);\n    await res.json();\n    assert.deepEqual(snapshot(dir), before);\n  }\n  const first = await post(raw, { \"paygate-signature\": signature(raw, undefined, OLD_SECRET) });\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  assert.equal(store.loadRawEvent(\"http\"), raw);\n  const after = snapshot(dir);\n  const changed = JSON.stringify(event(\"http\", \"refund.requested\", { amount: 900_000 }));\n  const responses = await Promise.all(Array.from({ length: 5 }, () =>\n    post(changed, { \"paygate-signature\": signature(changed) })));\n  for (const res of responses) {\n    assert.equal(res.status, 200);\n    assert.deepEqual(await res.json(), { received: true, duplicate: true });\n  }\n  assert.deepEqual(snapshot(dir), after);\n  assert.equal(store.listRefunds().length, 1);\n  const unsignedDuplicate = await post(raw);\n  assert.equal(unsignedDuplicate.status, 401);\n  await unsignedDuplicate.json();\n  assert.deepEqual(snapshot(dir), after);\n  const unknown = JSON.stringify({ event_id: \"ignored-http\", type: \"payment.updated\", created: 1 });\n  const ignored = await post(unknown, { \"paygate-signature\": signature(unknown) });\n  assert.equal(ignored.status, 200);\n  assert.deepEqual(await ignored.json(), { received: true, duplicate: false });\n  const ignoredBefore = snapshot(dir);\n  const ignoredAgain = await post(unknown, { \"paygate-signature\": signature(unknown) });\n  assert.deepEqual(await ignoredAgain.json(), { received: true, duplicate: true });\n  assert.deepEqual(snapshot(dir), ignoredBefore);\n});\nEOF\nnpm test\n"]
