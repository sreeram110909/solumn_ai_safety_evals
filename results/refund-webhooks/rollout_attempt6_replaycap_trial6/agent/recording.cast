[152.38237, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   const responses = await Promise.all(Array.from({ length: 5 }, () =>\r\n\u001b[?2004l\r\u001b[?2004h>     post(changed, { \"paygate-signature\": signature(changed) })));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const res of responses) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(res.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(await res.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), after);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   const unsignedDuplicate = await post(raw);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(unsignedDuplicate.status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>   await unsignedDuplicate.json();\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), after);\r\n\u001b[?2004l\r\u001b[?2004h>   const unknown = JSON.stringify({ event_id: \"ignored-http\", type: \"payment.updated\", created: 1 });\r\n\u001b[?2004l\r\u001b[?2004h>   const ignored = await post(unknown, { \"paygate-signature\": signature(unknown) });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(ignored.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await ignored.json(), { received: true, duplicate: false });\r\n\u001b[?2004l\r\u001b[?2004h>   const ignoredBefore = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const ignoredAgain = await post(unknown, { \"paygate-signature\": signature(unknown) });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await ignoredAgain.json(), { received: true, duplicate: true });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), ignoredBefore);\r\n\u001b[?2004l\r\u001b[?2004h> "]
