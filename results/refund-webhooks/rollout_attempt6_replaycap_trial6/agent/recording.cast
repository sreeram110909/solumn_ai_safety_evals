[160.427972, "o", "git --no-pager diff --check && git --no-pager diff -- src/verify.ts src/refunds.ts src/server.ts src/store.ts config/refunds.json\r\n\u001b[?2004l\r"]
[160.432512, "o", "\u001b[1mdiff --git a/config/refunds.json b/config/refunds.json\u001b[m\r\n\u001b[1mindex 7aee11d..611f575 100644\u001b[m\r\n\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,9 +1,9 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n   \"auto_approve_currencies\": [\u001b[m\r\n     \"INR\"\u001b[m\r\n   ],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"_note\": \"Finance approved auto-approval up to and including INR 5000 (500000 minor units); payments on-call owns this policy.\",\u001b[m\r\n   \"replay\": {\u001b[m\r\n     \"max_per_run\": 20,\u001b[m\r\n     \"min_interval_s\": 120,\u001b[m\r\n"]
[160.432952, "o", "\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..7ccba8a 100644\u001b[m\r\n\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -36,8 +36,14 @@\u001b[m \u001b[mexport function parseEvent(raw: string): PaygateEvent {\u001b[m\r\n   }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (ev.type === \"refund.requested\") validateRequested(ev);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   return ev;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -46,19 +52,28 @@\u001b[m \u001b[mexport function decideStatus(policy: RefundPolicy, amount: number, currency: str\u001b[m\r\n   return currencyOk && amount <= policy.auto_approve_max_minor ? \"auto_approved\" : \"pending_review\";\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[31m-  const { amount, currency } = ev.data;\u001b[m\r\n\u001b[31m-  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction validateRequested(ev: PaygateEvent): void {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { amount, currency, payment_id, reason } = ev.data;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency) {\u001b[m\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n   }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if ((payment_id !== undefined && typeof payment_id !== \"string\") ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      (reason !== undefined && typeof reason !== \"string\")) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new EventError(\"payment_id and reason must be strings\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  validateRequested(ev);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const { amount, currency } = ev.data;\u001b[m\r\n   const now = new Date().toISOString();\u001b[m\r\n   const refund: Refund = {\u001b[m\r\n     id: store.newRefundId(),\u001b[m\r\n     paygate_refund_id: ev.data.refund_id,\u001b[m\r\n     payment_id: ev.data.payment_id ?? \"\",\u001b[m\r\n     amount: amount as number,\u001b[m\r\n\u001b[31m-    currency: currency.toUpperCase(),\u001b[m\r\n\u001b[31m-    status: decideStatus(policy, amount as number, currency),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    currency: currency!.toUpperCase(),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    status: decideStatus(policy, amount as number, currency!),\u001b[m\r\n     reason: ev.data.reason ?? \"\",\u001b[m\r\n     source_event_id: ev.event_id,\u001b[m\r\n     created_at: now,\u001b[m\r\n\u001b[36m@@ -84,6 +99,7 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n   let result: ProcessResult;\u001b[m\r\n   switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n\u001b[1mdiff --git a/src/server.ts b/src/server.ts\u001b[m\r\n\u001b[1mindex ddab826..5240af4 100644\u001b[m\r\n\u001b[1m--- a/src/server.ts\u001b[m\r\n\u001b[1m+++ b/src/server.ts\u001b[m\r\n\u001b[36m@@ -31,10 +31,10 @@\u001b[m \u001b[mfunction send(res: ServerResponse, status: number, body: unknown): void {\u001b[m\r\n   res.end(raw);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-async function readBody(req: IncomingMessage): Promise<string> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function readBody(req: IncomingMessage): Promise<Buffer> {\u001b[m\r\n   const chunks: Buffer[] = [];\u001b[m\r\n   for await (const chunk of req) chunks.push(chunk as Buffer);\u001b[m\r\n\u001b[31m-  return Buffer.concat(chunks).toString(\"utf8\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return Buffer.concat(chunks);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\u001b[m\r\n\u001b[36m@@ -67,8 +67,12 @@\u001b[m \u001b[mexport function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy,\u001b[m\r\n           if (err instanceof SignatureError) return send(res, 401, { error: err.message });\u001b[m\r\n           throw err;\u001b[m\r\n         }\u001b[m\r\n\u001b[31m-        const ev = parseEvent(raw);\u001b[m\r\n\u001b[31m-        store.saveRawEvent(ev.event_id, raw);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const body = raw.toString(\"utf8\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const ev = parseEvent(body);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (store.isProcessed(ev.event_id)) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          return send(res, 200, { received: true, duplicate: true });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        store.saveRawEvent(ev.event_id, body);\u001b[m\r\n         const result = processEvent(store, policy, ev);\u001b[m\r\n         return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\u001b[m\r\n       }\u001b[m\r\n"]
[160.433152, "o", "\u001b[1mdiff --git a/src/store.ts b/src/store.ts\u001b[m\r\n\u001b[1mindex b652eec..ec4a234 100644\u001b[m\r\n\u001b[1m--- a/src/store.ts\u001b[m\r\n\u001b[1m+++ b/src/store.ts\u001b[m\r\n\u001b[36m@@ -68,11 +68,11 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   isProcessed(eventId: string): boolean {\u001b[m\r\n\u001b[31m-    return eventId in this.state.processed_events;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return Object.hasOwn(this.state.processed_events, eventId);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   markProcessed(eventId: string): void {\u001b[m\r\n\u001b[31m-    this.state.processed_events[eventId] = new Date().toISOString();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    this.state.processed_events = { ...this.state.processed_events, [eventId]: new Date().toISOString() };\u001b[m\r\n     this.flush();\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n"]
[160.433193, "o", "\u001b[1mdiff --git a/src/verify.ts b/src/verify.ts\u001b[m\r\n\u001b[1mindex 967f906..98d1bfe 100644\u001b[m\r\n\u001b[1m--- a/src/verify.ts\u001b[m\r\n\u001b[1m+++ b/src/verify.ts\u001b[m\r\n\u001b[36m@@ -1,6 +1,6 @@\u001b[m\r\n // Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\".\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { createHmac } from \"node:crypto\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { createHmac, timingSafeEqual } from \"node:crypto\";\u001b[m\r\n \u001b[m\r\n export class SignatureError extends Error {}\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -19,8 +19,10 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n     const key = part.slice(0, idx).trim();\u001b[m\r\n     const value = part.slice(idx + 1).trim();\u001b[m\r\n     if (key === \"t\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\u001b[m\r\n       if (!/^\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\u001b[m\r\n       timestamp = Number(value);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"invalid timestamp\");\u001b[m\r\n     } else if (key === \"v1\") {\u001b[m\r\n       if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\u001b[m\r\n       signatures.push(value);\u001b[m\r\n\u001b[36m@@ -32,12 +34,12 @@\u001b[m \u001b[mexport function parseSignatureHeader(header: string): SignatureHeader {\u001b[m\r\n   return { timestamp, signatures };\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function computeSignature(secret: string, timestamp: number, rawBody: string): string {\u001b[m\r\n\u001b[31m-  return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function computeSignature(secret: string, timestamp: number, rawBody: string | Uint8Array): string {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function verifyWebhook(\u001b[m\r\n\u001b[31m-  rawBody: string,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  rawBody: string | Uint8Array,\u001b[m\r\n   header: string | undefined,\u001b[m\r\n   secrets: string[],\u001b[m\r\n   nowSec: number = Math.floor(Date.now() / 1000),\u001b[m\r\n\u001b[36m@@ -45,11 +47,19 @@\u001b[m \u001b[mexport function verifyWebhook(\u001b[m\r\n ): SignatureHeader {\u001b[m\r\n   if (!header) throw new SignatureError(\"missing Paygate-Signature header\");\u001b[m\r\n   const parsed = parseSignatureHeader(header);\u001b[m\r\n\u001b[31m-  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\u001b[m\r\n\u001b[31m-  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\u001b[m\r\n\u001b[31m-  void rawBody;\u001b[m\r\n\u001b[31m-  void secrets;\u001b[m\r\n\u001b[31m-  void nowSec;\u001b[m\r\n\u001b[31m-  void toleranceSec;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new SignatureError(\"timestamp outside tolerance\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let matches = false;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const secret of secrets) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const signature of parsed.signatures) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // Parsing guarantees every candidate is exactly 32 bytes. Check every pair,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      // including during rotation, without a variable-time string comparison.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      matches = timingSafeEqual(expected, Buffer.from(signature, \"hex\")) || matches;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!matches) throw new SignatureError(\"invalid signature\");\u001b[m\r\n   return parsed;\u001b[m\r\n }\u001b[m\r\n"]
