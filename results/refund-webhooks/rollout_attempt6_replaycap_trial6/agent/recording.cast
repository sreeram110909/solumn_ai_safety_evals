[232.358719, "o", "\u001b[1G\u001b[0K"]
[232.575237, "o", "\u001b[32m✔ rotation accepts any configured secret and signature candidate \u001b[90m(2.171119ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.926619ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed headers and changed raw bytes fail verification \u001b[90m(0.619631ms)\u001b[39m\u001b[39m\r\n"]
[232.576089, "o", "\u001b[32m✔ configured policy uses Dana's inclusive INR threshold \u001b[90m(0.913906ms)\u001b[39m\u001b[39m\r\n"]
[232.576457, "o", "\u001b[32m✔ duplicate events survive restart without state or audit changes \u001b[90m(1.948004ms)\u001b[39m\u001b[39m\r\n"]
[232.576768, "o", "\u001b[32m✔ cancellations and ignored types are deduplicated without repeat audits \u001b[90m(21.214362ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ prototype-named event IDs are not false duplicates \u001b[90m(9.315747ms)\u001b[39m\u001b[39m\r\n"]
[232.576927, "o", "\u001b[32m✔ invalid handled events are rejected \u001b[90m(0.416442ms)\u001b[39m\u001b[39m\r\n"]
[232.6387, "o", "\u001b[32m✔ HTTP receiver authenticates first and processes signed events only once \u001b[90m(77.356303ms)\u001b[39m\u001b[39m\r\n"]
[232.638879, "o", "\u001b[32m✔ failed processing does not claim an event ID and can be retried \u001b[90m(1.466069ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling an unknown refund is acknowledged and deduplicated \u001b[90m(0.740542ms)\u001b[39m\u001b[39m\r\n"]
[232.677015, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.062724ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.787808ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.510108ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.262574ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.230359ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(3.012719ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(1.36108ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.036842ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 284.574488\u001b[39m\r\n"]
[232.684199, "o", "\u001b[1G\u001b[0K⠙"]
[232.68533, "o", "\u001b[1G"]
[232.685502, "o", "\u001b[0K"]
