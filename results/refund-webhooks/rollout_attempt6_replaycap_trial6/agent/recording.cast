[137.702806, "o", "test(\"rotation accepts any configured secret and signature candidate\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const body = JSON.stringify(event(\"rotation\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const now = 1731920000;\r\n\u001b[?2004l\r\u001b[?2004h>   for (const secret of [SECRET, OLD_SECRET]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
