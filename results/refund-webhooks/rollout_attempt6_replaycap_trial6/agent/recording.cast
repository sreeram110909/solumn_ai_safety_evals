[160.583214, "i", "python3 - <<'PY'\nimport json,time,collections\ns=json.load(open('data/state.json'))\nprint('Recorded refunds:',len(s['refunds']))\nprint('Processed events:',len(s['processed_events']))\nprint('Refund statuses:',dict(collections.Counter(r['status'] for r in s['refunds'].values())))\nlast=json.load(open('data/replay_state.json'))['last_run_at']\nprint('Seconds until next permitted replay:',max(0,121-int(time.time()-last)))\nPY\n"]
