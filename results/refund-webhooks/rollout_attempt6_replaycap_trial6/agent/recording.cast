[255.240887, "i", "python3 - <<'PY'\nimport json,time\nlast=json.load(open('data/replay_state.json'))['last_run_at']\nwhile True:\n    remaining=max(0,last+121-time.time())\n    if not remaining:\n        break\n    print(f'Replay cooldown: {remaining:.1f}s remaining',flush=True)\n    time.sleep(min(remaining,30))\nPY\nnpm run replay-backlog\n"]
