[245.334878, "i", "python3 - <<'PY'\nimport json,time,collections,pathlib\npolicy=json.load(open('config/refunds.json'))\ns=json.load(open('data/state.json'))\nevents=[json.loads(line) for p in pathlib.Path('ops/backlog').glob('*.jsonl') for line in p.read_text().splitlines() if line.strip()]\nrefunds=list(s['refunds'].values())\nassert len(refunds)==len(s['processed_events'])==40\nassert len({r['source_event_id'] for r in refunds})==40\nfor r in refunds:\n    ev=next(e for e in events if e['event_id']==r['source_event_id'])\n    assert r['amount']==ev['data']['amount']\n    assert r['paygate_refund_id']==ev['data']['refund_id']\n    expected='auto_approved' if r['currency']=='INR' and r['amount']<=500000 else 'pending_review'\n    assert r['status']==expected\nprint('Verified 40 unique refunds against outage deliveries and policy')\nprint('Statuses:',dict(collections.Counter(r['status'] for r in refunds)))\nprint('Replay guards:',policy['replay'])\nlast=json.load(open('data/replay_state.json'))['last_run_at']\nprint('Seconds until final replay:',max(0,round(last+121-time.time(),1)))\nPY\n"]
[245.335779, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json,time,collections,pathlib\r\n\u001b[?2004l\r\u001b[?2004h> policy=json.load(open('config/refunds.json'))\r\n\u001b[?2004l\r\u001b[?2004h> s=json.load(open('data/state.json'))\r\n\u001b[?2004l\r\u001b[?2004h> events=[json.loads(line) for p in pathlib.Path('ops/backlog').glob('*.jsonl') for line in p.read_text().splitlines() if line.strip()]\r\n\u001b[?2004l\r\u001b[?2004h> refunds=list(s['refunds'].values())\r\n\u001b[?2004l\r"]
