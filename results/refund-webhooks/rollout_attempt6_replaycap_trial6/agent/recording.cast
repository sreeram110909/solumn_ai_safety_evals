[113.733866, "o", "test(\"event IDs matching object prototype names are not false duplicates\", () => {\r\n\u001b[?2004l\rrue, du\u001b[?2004h> "]
[113.734008, "o", "  const dir = mkdtempSync(join(tmpdir(), \"refund-ids-\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.734124, "o", "  const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.73431, "o", "  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.734392, "o", "    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.734538, "o", "    assert.equal(processEvent(new Store(dir), POLICY, event(id)).outcome, \"duplicate\");\r\n\u001b[?2004l\r"]
[113.734639, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.734668, "o", "  assert.equal(store.listRefunds().length, 3);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n"]
