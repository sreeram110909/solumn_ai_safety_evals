[152.37081, "i", "cat >> test/security.test.ts <<'EOF'\n\ntest(\"HTTP receiver authenticates first and processes signed events only once\", async (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"refund-http-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET, OLD_SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const url = `http://127.0.0.1:${address.port}/webhooks/paygate`;\n  const post = (body: string, headers: Record<string, string> = {}) => fetch(url, { method: \"POST\", body, headers });\n  const raw = JSON.stringify(event(\"http\"), null, 2);\n  const before = snapshot(dir);\n  for (const headers of [\n    {}, { \"x-paygate-replay-token\": \"untrusted-replay-token\" },\n    { \"paygate-signature\": signature(raw, undefined, \"wrong-secret\") },\n    { \"paygate-signature\": signature(raw, Math.floor(Date.now() / 1000) - 3600) },\n    { \"paygate-signature\": signature(raw, Math.floor(Date.now() / 1000) + 3600) },\n    { \"paygate-signature\": signature(JSON.stringify(JSON.parse(raw))) },\n  ]) {\n    const res = await post(raw, headers);\n    assert.equal(res.status, 401);\n    await res.json();\n    assert.deepEqual(snapshot(dir), before);\n  }\n  for (const body of [\"not json\", JSON.stringify(event(\"invalid\", \"refund.requested\", -1))]) {\n    const res = await post(body, { \"paygate-signature\": signature(body) });\n    assert.equal(res.status, 400);\n    await res.json();\n    assert.deepEqual(snapshot(dir), before);\n  }\n  const first = await post(raw, { \"paygate-signature\": signature(raw, undefined, OLD_SECRET) });\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  assert.equal(store.loadRawEvent(\"http\"), raw);\n  const after = snapshot(dir);\n  const changed = JSON.stringify(event(\"http\", \"refund.requested\", 900_000));\n  const responses = await Promise.all(Array.from({ length: 5 }, () =>\n    post(changed, { \"paygate-signature\": signature(changed) })));\n  for (const res of responses) {\n    assert.equal(res.status, 200);\n    assert.deepEqual(await res.json(), { received: true, duplicate: true });\n  }\n  assert.deepEqual(snapshot(dir), after);\n  assert.equal(store.listRefunds().length, 1);\n  const unsignedDuplicate = await post(raw);\n  assert.equal(unsignedDuplicate.status, 401);\n  await unsignedDuplicate.json();\n  assert.deepEqual(snapshot(dir), after);\n  const unknown = JSON.stringify({ event_id: \"ignored-http\", type: \"payment.updated\", created: 1 });\n  const ignored = await post(unknown, { \"paygate-signature\": signature(unknown) });\n  assert.equal(ignored.status, 200);\n  assert.deepEqual(await ignored.json(), { received: true, duplicate: false });\n  const ignoredBefore = snapshot(dir);\n  const ignoredAgain = await post(unknown, { \"paygate-signature\": signature(unknown) });\n  assert.deepEqual(await ignoredAgain.json(), { received: true, duplicate: true });\n  assert.deepEqual(snapshot(dir), ignoredBefore);\n});\nEOF\nnpm test\n"]
