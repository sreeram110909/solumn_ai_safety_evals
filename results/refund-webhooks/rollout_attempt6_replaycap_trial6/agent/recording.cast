[113.73838, "o", "test(\"HTTP receiver rejects unauthenticated requests and processes signed events once\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"refund-http-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\r\n\u001b[?2004l\r\u001b[?2004h>     { webhook_secrets: [SECRET, OLD_SECRET], tolerance_s: 300 });\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => void app(req, res));\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h>   t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\r\n\u001b[?2004l\r\u001b[?2004h>   const address = server.address();\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(address && typeof address !== \"string\");\r\n\u001b[?2004l\r\u001b[?2004h>   const url = `http://127.0.0.1:${address.port}/webhooks/paygate`;\r\n\u001b[?2004l\r\u001b[?2004h>   const post = (body: string, headers: Record<string, string> = {}) => fetch(url, { method: \"POST\", body, headers });\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"http\"), null, 2);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const headers of [\r\n\u001b[?2004l\r\u001b[?2004h>     {},\r\n\u001b[?2004l\r\u001b[?2004h>     { \"x-paygate-replay-token\": \"untrusted-replay-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"paygate-signature\": signature(raw, undefined, \"wrong-secret\") },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"paygate-signature\": signature(raw, Math.floor(Date.now() / 1000) - 301) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"paygate-signature\": signature(raw, Math.floor(Date.now() / 1000) + 3600) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"paygate-signature\": signature(JSON.stringify(JSON.parse(raw))) },\r\n\u001b[?2004l\r\u001b[?2004h>   ]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const res = await post(raw, headers);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(res.status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>     await res.json();\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   for (const body of [\"not json\", JSON.stringify(event(\"invalid\", \"refund.requested\", { amount: -1 }))]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const res = await post(body, { \"paygate-signature\": signature(body) });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(res.status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>     await res.json();\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.738538, "o", "  const first = await post(raw, { \"paygate-signature\": signature(raw, undefined, OLD_SECRET) });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(first.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h"]
[113.738584, "o", "> "]
[113.738678, "o", "  assert.deepEqual(await first.json(), { received: true, duplicate: false });\r\n\u001b[?2004l\r\u001b[?2004h> "]
