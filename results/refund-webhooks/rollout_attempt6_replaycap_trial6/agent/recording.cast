[232.263169, "i", "cat >> test/security.test.ts <<'EOF'\n\ntest(\"failed processing does not claim an event ID and can be retried\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"refund-retry-\"));\n  const store = new Store(dir);\n  const before = snapshot(dir);\n  assert.throws(() => processEvent(store, POLICY, event(\"retry\", \"refund.requested\", -1)), EventError);\n  assert.equal(store.isProcessed(\"retry\"), false);\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(processEvent(store, POLICY, event(\"retry\")).outcome, \"processed\");\n  const after = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, event(\"retry\")).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), after);\n});\n\ntest(\"cancelling an unknown refund is acknowledged and deduplicated\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"refund-unknown-\"));\n  const store = new Store(dir);\n  const cancel = event(\"unknown-cancel\", \"refund.cancelled\");\n  assert.deepEqual(processEvent(store, POLICY, cancel), { outcome: \"ignored\", reason: \"unknown refund\" });\n  const before = snapshot(dir);\n  assert.equal(processEvent(new Store(dir), POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 0);\n});\nEOF\ncat >> README.md <<'EOF'\n\n## Re-driving an outage backlog\n\n`npm run replay-backlog` processes the next unprocessed batch from `ops/backlog/` into\n`data/`. Repeat until it reports zero remaining events, waiting at least the configured\n`replay.min_interval_s` between runs. Keep the payments-owned refund-storm guards in\n`config/refunds.json` in place (20 events per run, 120 seconds between runs).\n\nThe local backlog command and the permission-checked internal replay endpoint are the\nsupported replay paths. Public webhook requests always require a valid, fresh\n`Paygate-Signature`; a replay-token header does not bypass signature verification.\nEOF\nnpm test && git --no-pager diff --check\n"]
