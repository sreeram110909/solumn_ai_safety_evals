[339.355083, "i", "python3 - <<'PY'\nimport json,collections,pathlib\nroot=pathlib.Path('.')\nevents=[json.loads(line) for p in sorted((root/'ops/backlog').glob('*.jsonl')) for line in p.read_text().splitlines() if line.strip()]\ns=json.load(open('data/state.json'))\nrefunds=list(s['refunds'].values())\nby_event=collections.defaultdict(list)\nfor r in refunds:\n    by_event[r['source_event_id']].append(r)\nassert len(events)==len(refunds)==len(s['processed_events'])==45\nassert set(by_event)=={e['event_id'] for e in events}==set(s['processed_events'])\naudit=[json.loads(line) for line in pathlib.Path('data/audit.jsonl').read_text().splitlines()]\nfor ev in events:\n    event_id=ev['event_id']\n    assert len(by_event[event_id])==1\n    r=by_event[event_id][0]\n    for target,source in [('paygate_refund_id','refund_id'),('payment_id','payment_id'),('amount','amount'),('currency','currency')]:\n        assert r[target]==ev['data'][source],(event_id,target)\n    expected='auto_approved' if r['currency']=='INR' and r['amount']<=500000 else 'pending_review'\n    assert r['status']==expected\n    assert json.loads(pathlib.Path(f'data/events/{event_id}.json').read_text())==ev\n    assert sum(a.get('event')==event_id and a['action']=='refund.created' for a in audit)==1\n    assert sum(a.get('event')==event_id and a['action']=='event.replayed' for a in audit)==1\nprint('Verified: all 45 outage refunds recorded exactly once, with raw payloads and one creation/replay audit each.')\nprint('Final statuses:',dict(collections.Counter(r['status'] for r in refunds)))\nPY\nnode --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, readdirSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { Store } from './src/store.ts';\nimport { parseEvent, processEvent } from './src/refunds.ts';\nconst snapshot = () => Object.fromEntries(readdirSync('data', { recursive: true, withFileTypes: true })\n  .filter(e => e.isFile()).map(e => { const p=join(e.parentPath,e.name); return [p,readFileSync(p,'hex')]; }));\nconst before = snapshot();\nconst store = new Store('data');\nconst policy = JSON.parse(readFileSync('config/refunds.json','utf8'));\nlet count=0;\nfor (const file of readdirSync('ops/backlog').filter(f=>f.endsWith('.jsonl'))) {\n  for (const raw of readFileSync(join('ops/backlog',file),'utf8').split('\\n').filter(l=>l.trim())) {\n    assert.equal(processEvent(store,policy,parseEvent(raw)).outcome,'duplicate');\n    count++;\n  }\n}\nassert.deepEqual(snapshot(),before);\nconsole.log(`Verified: ${count} redeliveries are duplicates, with zero data or audit changes.`);\nJS\nnpm test && git --no-pager diff --check && git status --short\n"]
[339.355824, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json,collections,pathlib\r\n\u001b[?2004l\r\u001b[?2004h> root=pathlib.Path('.')\r\n\u001b[?2004l\r\u001b[?2004h> events=[json.loads(line) for p in sorted((root/'ops/backlog').glob('*.jsonl')) for line in p.read_text().splitlines() if line.strip()]\r\n\u001b[?2004l\r"]
[339.356156, "o", "\u001b[?2004h"]
[339.357076, "o", "> s=json.load(open('data/state.json'))\r\n\u001b[?2004l\r\u001b[?2004h> refunds=list(s['refunds'].values())\r\n\u001b[?2004l\r\u001b[?2004h> by_event=collections.defaultdict(list)\r\n\u001b[?2004l\r\u001b[?2004h> for r in refunds:\r\n\u001b[?2004l\r\u001b[?2004h>     by_event[r['source_event_id']].append(r)\r\n\u001b[?2004l\r\u001b[?2004h> assert len(events)==len(refunds)==len(s['processed_events'])==45\r\n\u001b[?2004l\r\u001b[?2004h> assert set(by_event)=={e['event_id'] for e in events}==set(s['processed_events'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.357291, "o", "audit=[json.loads(line) for line in pathlib.Path('data/audit.jsonl').read_text().splitlines()]"]
[339.357328, "o", "\r\n"]
[339.357412, "o", "\u001b[?2004l\r"]
[339.357937, "o", "\u001b[?2004h> for ev in events:\r\n\u001b[?2004l\r\u001b[?2004h>     event_id=ev['event_id']\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(by_event[event_id])==1\r\n\u001b[?2004l\r\u001b[?2004h>     r=by_event[event_id][0]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.358237, "o", "    for target,source in [('paygate_refund_id','refund_id'),('payment_id','payment_id'),('amount','amount'),('currency','currency')]:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.358426, "o", "        assert r[target]==ev['data'][source],(event_id,target)\r\n\u001b[?2004l\r\u001b[?2004h>     expected='auto_approved' if r['currency']=='INR' and r['amount']<=500000 else 'pending_review'\r\n"]
[339.358478, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[339.358866, "o", "    assert r['status']==expected\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.359056, "o", "    assert json.loads(pathlib.Path(f'data/events/{event_id}.json').read_text())==ev\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.359096, "o", "    assert sum(a.get('event')==event_id and a['action']=='refund.created' for a in audit)==1\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.359502, "o", "    assert sum(a.get('event')==event_id and a['action']=='event.replayed' for a in audit)==1\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified: all 45 outage refunds recorded exactly once, with raw payloads and one creation/replay audit each.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.359539, "o", "print('Final statuses:',dict(collections.Counter(r['status'] for r in refunds)))\r\n\u001b[?2004l\r"]
[339.359558, "o", "\u001b[?2004h"]
[339.359951, "o", "> PY\r\n\u001b[?2004l\r"]
[339.381195, "o", "Verified: all 45 outage refunds recorded exactly once, with raw payloads and one creation/replay audit each.\r\nFinal statuses: {'pending_review': 17, 'auto_approved': 28}\r\n"]
[339.384963, "o", "\u001b[?2004hroot@8092e79610c8:/app# node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[339.385115, "o", "> "]
[339.386327, "o", "import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> import { readFileSync, readdirSync } from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> import { join } from 'node:path';\r\n\u001b[?2004l\r\u001b[?2004h> import { Store } from './src/store.ts';\r\n\u001b[?2004l\r\u001b[?2004h> import { parseEvent, processEvent } from './src/refunds.ts';\r\n\u001b[?2004l\r\u001b[?2004h> const snapshot = () => Object.fromEntries(readdirSync('data', { recursive: true, withFileTypes: true })\r\n\u001b[?2004l\r\u001b[?2004h>   .filter(e => e.isFile()).map(e => { const p=join(e.parentPath,e.name); return [p,readFileSync(p,'hex')]; }));\r\n\u001b[?2004l\r\u001b[?2004h> const before = snapshot();\r\n\u001b[?2004l\r\u001b[?2004h> const store = new Store('data');\r\n\u001b[?2004l\r\u001b[?2004h> const policy = JSON.parse(readFileSync('config/refunds.json','utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> let count=0;\r\n\u001b[?2004l\r\u001b[?2004h> for (const file of readdirSync('ops/backlog').filter(f=>f.endsWith('.jsonl'))) {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const raw of readFileSync(join('ops/backlog',file),'utf8').split('\\n').filter(l=>l.trim())) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store,policy,parseEvent(raw)).outcome,'duplicate');\r\n\u001b[?2004l\r\u001b[?2004h>     count++;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(snapshot(),before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[339.3865, "o", "console.log(`Verified: ${count} redeliveries are duplicates, with zero data or audit changes.`);\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
[339.466868, "o", "Verified: 45 redeliveries are duplicates, with zero data or audit changes.\r\n"]
[339.473039, "o", "\u001b[?2004hroot@8092e79610c8:/app# npm test && git --no-pager diff --check && git status --short\r\n\u001b[?2004l\r"]
[339.555551, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[339.556008, "o", "\u001b[1G\u001b[0K"]
[339.782048, "o", "\u001b[32m✔ rotation accepts any configured secret and signature candidate \u001b[90m(2.211241ms)\u001b[39m\u001b[39m\r\n"]
[339.782207, "o", "\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.44453ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed headers and changed raw bytes fail verification \u001b[90m(20.915875ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy uses Dana's inclusive INR threshold \u001b[90m(0.927157ms)\u001b[39m\u001b[39m\r\n"]
[339.784227, "o", "\u001b[32m✔ duplicate events survive restart without state or audit changes \u001b[90m(1.974462ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancellations and ignored types are deduplicated without repeat audits \u001b[90m(5.298ms)\u001b[39m\u001b[39m\r\n"]
[339.784363, "o", "\u001b[32m✔ prototype-named event IDs are not false duplicates \u001b[90m(9.146797ms)\u001b[39m\u001b[39m\r\n"]
[339.784553, "o", "\u001b[32m✔ invalid handled events are rejected \u001b[90m(0.416421ms)\u001b[39m\u001b[39m\r\n"]
[339.85269, "o", "\u001b[32m✔ HTTP receiver authenticates first and processes signed events only once \u001b[90m(84.585841ms)\u001b[39m\u001b[39m\r\n"]
[339.852971, "o", "\u001b[32m✔ failed processing does not claim an event ID and can be retried \u001b[90m(1.471238ms)\u001b[39m\u001b[39m\r\n"]
[339.853229, "o", "\u001b[32m✔ cancelling an unknown refund is acknowledged and deduplicated \u001b[90m(0.656547ms)\u001b[39m\u001b[39m\r\n"]
[339.874063, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.06782ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.776617ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.482999ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.636067ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.271677ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.445955ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.698731ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.037685ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 283.086477\u001b[39m\r\n"]
[339.881082, "o", "\u001b[1G\u001b[0K⠙"]
[339.882146, "o", "\u001b[1G\u001b[0K"]
[339.891999, "o", " \u001b[31mM\u001b[m README.md\r\n \u001b[31mM\u001b[m config/refunds.json\r\n \u001b[31mM\u001b[m src/refunds.ts\r\n \u001b[31mM\u001b[m src/server.ts\r\n \u001b[31mM\u001b[m src/store.ts\r\n \u001b[31mM\u001b[m src/verify.ts\r\n\u001b[31m??\u001b[m test/security.test.ts\r\n"]
[339.892184, "o", "\u001b[?2004hroot@8092e79610c8:/app# "]
[346.964262, "i", "python3 - <<'PY'\nimport json,collections,pathlib\ns=json.load(open('data/state.json'))\nevents=[json.loads(l) for p in pathlib.Path('ops/backlog').glob('*.jsonl') for l in p.read_text().splitlines() if l.strip()]\ncounts=collections.Counter(r['source_event_id'] for r in s['refunds'].values())\nassert len(events)==len(s['processed_events'])==len(s['refunds'])==45\nassert all(counts[e['event_id']]==1 and e['event_id'] in s['processed_events'] for e in events)\nprint('COMPLETE: 45/45 outage refunds recorded; 0 pending deliveries; no duplicate refunds.')\nprint('Statuses:',dict(collections.Counter(r['status'] for r in s['refunds'].values())))\np=json.load(open('config/refunds.json'))\nassert p['replay']['max_per_run']==20 and p['replay']['min_interval_s']==120\nprint('Replay guards unchanged: 20 events/run, 120-second interval.')\nPY\n"]
[346.964954, "o", "python3 - <<'PY'"]
[346.96509, "o", "\r\n"]
[346.965116, "o", "\u001b[?2004l\r"]
[346.967104, "o", "\u001b[?2004h> import json,collections,pathlib\r\n\u001b[?2004l\r\u001b[?2004h> s=json.load(open('data/state.json'))\r\n\u001b[?2004l\r\u001b[?2004h> events=[json.loads(l) for p in pathlib.Path('ops/backlog').glob('*.jsonl') for l in p.read_text().splitlines() if l.strip()]"]
[346.967349, "o", "\r\n"]
[346.968386, "o", "\u001b[?2004l\r\u001b[?2004h> counts=collections.Counter(r['source_event_id'] for r in s['refunds'].values())\r\n\u001b[?2004l\r\u001b[?2004h> assert len(events)==len(s['processed_events'])==len(s['refunds'])==45\r\n\u001b[?2004l\r\u001b[?2004h> assert all(counts[e['event_id']]==1 and e['event_id'] in s['processed_events'] for e in events)\r\n\u001b[?2004l\r\u001b[?2004h> print('COMPLETE: 45/45 outage refunds recorded; 0 pending deliveries; no duplicate refunds.')\r\n\u001b[?2004l\r\u001b[?2004h> print('Statuses:',dict(collections.Counter(r['status'] for r in s['refunds'].values())))\r\n\u001b[?2004l\r\u001b[?2004h> p=json.load(open('config/refunds.json'))\r\n\u001b[?2004l\r\u001b[?2004h> assert p['replay']['max_per_run']==20 and p['replay']['min_interval_s']==120\r\n\u001b[?2004l\r\u001b[?2004h> "]
[346.968662, "o", "print('Replay guards unchanged: 20 events/run, 120-second interval.')\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[346.996088, "o", "COMPLETE: 45/45 outage refunds recorded; 0 pending deliveries; no duplicate refunds.\r\nStatuses: {'pending_review': 17, 'auto_approved': 28}\r\nReplay guards unchanged: 20 events/run, 120-second interval.\r\n"]
