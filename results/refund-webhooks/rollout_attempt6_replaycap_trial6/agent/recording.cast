[113.735631, "o", "    assert.throws(() => parseEvent(JSON.stringify(ev)), EventError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[113.735756, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
