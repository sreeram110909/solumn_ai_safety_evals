[152.384414, "o", "\u001b[?2004hroot@8092e79610c8:/app# npm test\r\n\u001b[?2004l\r"]
[152.478404, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[152.478877, "o", "\u001b[1G\u001b[0K"]
[152.688255, "o", "\u001b[32m✔ rotation accepts any configured secret and signature candidate \u001b[90m(2.073216ms)\u001b[39m\u001b[39m\r\n"]
[152.689388, "o", "\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.370801ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed headers and changed raw bytes fail verification \u001b[90m(0.506804ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy uses Dana's inclusive INR threshold \u001b[90m(0.827806ms)\u001b[39m\u001b[39m\r\n"]
[152.689517, "o", "\u001b[32m✔ duplicate events survive restart without state or audit changes \u001b[90m(1.708605ms)\u001b[39m\u001b[39m"]
[152.689602, "o", "\r\n"]
[152.690002, "o", "\u001b[32m✔ cancellations and ignored types are deduplicated without repeat audits \u001b[90m(4.157334ms)\u001b[39m\u001b[39m\r\n"]
[152.690252, "o", "\u001b[32m✔ prototype-named event IDs are not false duplicates \u001b[90m(7.434628ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ invalid handled events are rejected \u001b[90m(0.376679ms)\u001b[39m\u001b[39m\r\n"]
[152.746785, "o", "\u001b[32m✔ HTTP receiver authenticates first and processes signed events only once \u001b[90m(70.382029ms)\u001b[39m\u001b[39m\r\n"]
[152.771369, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.092255ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.808792ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.490018ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.32833ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(1.133341ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.631165ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.701497ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.463267ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 17\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 17\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 258.068458\u001b[39m\r\n"]
[152.776809, "o", "\u001b[1G\u001b[0K⠙"]
