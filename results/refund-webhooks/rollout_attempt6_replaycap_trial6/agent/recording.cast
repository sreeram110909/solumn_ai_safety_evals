0) },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"paygate-signature\": signature(JSON.stringify(JSON.parse(raw))) },\r\n\u001b[?2004l\r\u001b[?2004h>   ]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const res = await post(raw, headers);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(res.status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
