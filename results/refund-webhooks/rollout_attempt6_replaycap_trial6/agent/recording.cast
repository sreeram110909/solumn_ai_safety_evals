[113.73496, "o", "  for (const ev of [null, {}, { ...event(\"bad\"), created: \"yesterday\" },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.735025, "o", "    event(\"bad\", \"refund.requested\", { amount: -1 }),\r\n\u001b[?2004l\r"]
[113.735141, "o", "\u001b[?2004h> "]
[113.735178, "o", "    event(\"bad\", \"refund.requested\", { amount: 1.5 }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.73531, "o", "    event(\"bad\", \"refund.requested\", { currency: \"\" }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[113.735387, "o", "    event(\"bad\", \"refund.requested\", { reason: {} }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
