[244.414681, "o", "\u001b[1G\u001b[0K"]
[244.615036, "o", "\u001b[32m✔ rotation accepts any configured secret and signature candidate \u001b[90m(2.249809ms)\u001b[39m\u001b[39m\r\n"]
[244.615705, "o", "\u001b[32m✔ timestamp tolerance is inclusive and enforced in both directions \u001b[90m(0.489036ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed headers and changed raw bytes fail verification \u001b[90m(0.546027ms)\u001b[39m\u001b[39m\r\n"]
[244.616555, "o", "\u001b[32m✔ configured policy uses Dana's inclusive INR threshold \u001b[90m(0.820276ms)\u001b[39m\u001b[39m\r\n"]
[244.616813, "o", "\u001b[32m✔ duplicate events survive restart without state or audit changes \u001b[90m(2.099009ms)\u001b[39m\u001b[39m\r\n"]
[244.618738, "o", "\u001b[32m✔ cancellations and ignored types are deduplicated without repeat audits \u001b[90m(4.823888ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ prototype-named event IDs are not false duplicates \u001b[90m(8.406945ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ invalid handled events are rejected \u001b[90m(0.380884ms)\u001b[39m\u001b[39m\r\n"]
[244.687334, "o", "\u001b[32m✔ HTTP receiver authenticates first and processes signed events only once \u001b[90m(85.936642ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ failed processing does not claim an event ID and can be retried \u001b[90m(1.323073ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling an unknown refund is acknowledged and deduplicated \u001b[90m(0.557088ms)\u001b[39m\u001b[39m\r\n"]
[244.698693, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.064606ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.805473ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.474274ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.29029ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.269968ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.565855ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.810645ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(0.949164ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 250.614963\u001b[39m\r\n"]
