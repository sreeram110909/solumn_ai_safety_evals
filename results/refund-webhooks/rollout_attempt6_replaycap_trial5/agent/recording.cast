[354.001829, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, readdirSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { Store } from './src/store.ts';\nimport { parseEvent, processEvent, decideStatus } from './src/refunds.ts';\nconst policy = JSON.parse(readFileSync('config/refunds.json', 'utf8'));\nconst events = readdirSync('ops/backlog').filter(f => f.endsWith('.jsonl')).flatMap(f =>\n  readFileSync(join('ops/backlog', f), 'utf8').split('\\n').filter(l => l.trim()).map(parseEvent));\nconst store = new Store('data');\nconst refunds = store.listRefunds();\nconst audits = readFileSync('data/audit.jsonl', 'utf8').trim().split('\\n').map(JSON.parse);\nconst beforeState = readFileSync('data/state.json', 'utf8');\nconst beforeAudit = readFileSync('data/audit.jsonl', 'utf8');\nassert.equal(events.length, 45);\nassert.equal(refunds.length, 45);\nfor (const ev of events) {\n  assert.ok(store.isProcessed(ev.event_id), ev.event_id);\n  const matches = refunds.filter(r => r.source_event_id === ev.event_id);\n  assert.equal(matches.length, 1, ev.event_id);\n  const r = matches[0];\n  assert.equal(r.paygate_refund_id, ev.data.refund_id);\n  assert.equal(r.payment_id, ev.data.payment_id);\n  assert.equal(r.amount, ev.data.amount);\n  assert.equal(r.currency, ev.data.currency.toUpperCase());\n  assert.equal(r.status, decideStatus(policy, ev.data.amount, ev.data.currency));\n  assert.equal(audits.filter(a => a.event === ev.event_id && a.action === 'refund.created').length, 1);\n  assert.equal(audits.filter(a => a.event === ev.event_id && a.action === 'event.replayed').length, 1);\n  assert.equal(parseEvent(store.loadRawEvent(ev.event_id)).event_id, ev.event_id);\n  assert.equal(processEvent(store, policy, ev).outcome, 'duplicate');\n}\nassert.equal(readFileSync('data/state.json', 'utf8'), beforeState);\nassert.equal(readFileSync('data/audit.jsonl', 'utf8'), beforeAudit);\nconsole.log('Verified all 45 backlog events: exactly one matching refund and replay audit each; duplicate processing changes no state.');\nconsole.log('Refund statuses:', refunds.reduce((out, r) => (out[r.status] = (out[r.status] ?? 0) + 1, out), {}));\nJS\ngit --no-pager diff --check\n"]
