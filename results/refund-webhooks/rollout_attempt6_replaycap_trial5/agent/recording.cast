[89.674363, "o", " src/refunds.ts      | 65 \u001b[32m+++++++++++++++++++++++++++++++++++++++++++++\u001b[m\u001b[31m--------------------\u001b[m\r\n src/server.ts       |  9 \u001b[32m+++++\u001b[m\u001b[31m----\u001b[m\r\n src/store.ts        | 33 \u001b[32m+++++++++++++++++++++++++++++++\u001b[m\u001b[31m--\u001b[m\r\n src/verify.ts       | 33 \u001b[32m+++++++++++++++++++++\u001b[m\u001b[31m------------\u001b[m\r\n 5 files changed, 104 insertions(+), 40 deletions(-)\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\u0007\u0007\r\r\u001b[K\r\n...skipping 1 line\r\n\r"]
[89.677616, "o", "\u001b[1mdiff --git a/config/refunds.json b/config/refunds.json\u001b[m\r\n\u001b[1mindex 7aee11d..d780f2e 100644\u001b[m\r\n"]
[89.678675, "o", "\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,9 +1,9 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n   \"auto_approve_currencies\": [\u001b[m\r\n     \"INR\"\u001b[m\r\n   ],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"_note\": \"Finance-approved: auto-approve up to and including INR 5,000 (500000 paise); other currencies require review\",\u001b[m\r\n   \"replay\": {\u001b[m\r\n     \"max_per_run\": 20,\u001b[m\r\n     \"min_interval_s\": 120,\u001b[m\r\n\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..8822712 100644\u001b[m\r\n\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -34,10 +34,26 @@\u001b[m \u001b[mexport function parseEvent(raw: string): PaygateEvent {\u001b[m\r\n   } catch {\u001b[m\r\n     throw new EventError(\"body is not valid JSON\");\u001b[m\r\n   }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (body === null || typeof body !== \"object\" || Array.isArray(body)) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new EventError(\"body must be an event object\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n\u001b[31m-  if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\