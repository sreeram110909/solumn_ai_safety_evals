[41.181664, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('if (!/^\\\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\\n      timestamp = Number(value);', 'if (timestamp !== undefined || !/^\\\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\\n        throw new SignatureError(\"expected one safe integer timestamp\");\\n      }\\n      timestamp = Number(value);')\ns = s.replace('rawBody: string', 'rawBody: string | Buffer')\ns = s.replace('return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");', 'return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");')\ns = s.replace('if (!header) throw', 'if (typeof header !== \"string\" || !header) throw')\ns = s.replace('  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\\n  void rawBody;\\n  void secrets;\\n  void nowSec;\\n  void toleranceSec;', '''  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of parsed.signatures) {\n      // Parsing enforces SHA-256's fixed size. Evaluate every pair during rotation.\n      if (timingSafeEqual(expected, Buffer.from(signature, \"hex\"))) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");''')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('  private state: State;', '  private state: State;\\n  private pendingAudit: Record<string, unknown>[] | undefined;')\ns = s.replace('  private flush(): void {\\n', '  private flush(): void {\\n    if (this.pendingAudit) return;\\n')\ns = s.replace('  newRefundId(): string {', '''  // Commit refund mutations and the processed marker in one atomic state rewrite.\n  transaction<T>(work: () => T): T {\n    if (this.pendingAudit) throw new Error(\"nested store transaction\");\n    const before = structuredClone(this.state);\n    this.pendingAudit = [];\n    let result: T;\n    let entries: Record<string, unknown>[];\n    try {\n      result = work();\n      entries = this.pendingAudit;\n      this.pendingAudit = undefined;\n      this.flush();\n    } catch (err) {\n      this.state = before;\n      this.pendingAudit = undefined;\n      throw err;\n    }\n    for (const entry of entries) this.audit(entry);\n    return result;\n  }\n\n  newRefundId(): string {''')\ns = s.replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('this.state.processed_events[eventId] = new Date().toISOString();', 'Object.defineProperty(this.state.processed_events, eventId, {\\n      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\\n    });')\ns = s.replace('  audit(entry: Record<string, unknown>): void {\\n', '  audit(entry: Record<string, unknown>): void {\\n    if (this.pendingAudit) {\\n      this.pendingAudit.push(entry);\\n      return;\\n    }\\n')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text()\nstart = s.index('  let result: ProcessResult;\\n', s.index('export function processEvent'))\nbody = s[start:].rstrip()\nbody = body.rsplit('\\n}', 1)[0]\ns = s[:start] + '  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n  return store.transaction(() => {\\n' + '\\n'.join('  ' + line for line in body.splitlines()) + '\\n  });\\n}\\n'\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('Promise<string> {', 'Promise<Buffer> {').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.even"]
[41.181807, "i", "t_id, raw);', 'const ev = parseEvent(raw.toString(\"utf8\"));\\n        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\\n        store.saveRawEvent(ev.event_id, raw.toString(\"utf8\"));')\np.write_text(s)\np = Path('config/refunds.json')\ns = p.read_text().replace('\"auto_approve_max_minor\": 0,', '\"auto_approve_max_minor\": 500000,').replace('auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review', 'Finance-approved: auto-approve up to and including INR 5,000 (500000 paise); other currencies require review')\np.write_text(s)\nPY\nnpm test\n"]
