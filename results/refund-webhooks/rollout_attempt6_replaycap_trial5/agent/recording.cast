rror) return send(res, 401, { error: err.message });\u001b[m\r\n           throw err;\u001b[m\r\n         }\u001b[m\r\n\u001b[31m-        const ev = parseEvent(raw);\u001b[m\r\n\u001b[31m-        store.saveRawEvent(ev.event_id, raw);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const ev = parseEvent(raw.toString(\"utf8\"));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (store.isProcessed(ev.event_id)) return send(res, 200, { received: true, duplicate: true });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        store.saveRawEvent(ev.event_id, raw.toString(\"utf8\"));\u001b[m\r\n         const result = processEvent(store, policy, ev);\u001b[m\r\n         return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\u001b[m\r\n       }\u001b[m\r\n\u001b[1mdiff --git a/src/store.ts b/src/store.ts\u001b[m\r\n\u001b[1mindex b652eec..a9e940c 100644\u001b[m\r\n\u001b[1m--- a/src/store.ts\u001b[m\r\n\u001b[1m+++ b/src/store.ts\u001b[m\r\n\u001b[36m@@ -28,6 +28,7 @@\u001b[m \u001b[minterface State {\u001b[m\r\n export class Store {\u001b[m\r\n   private readonly dir: string;\u001b[m\r\n   private state: State;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  private pendingAudit: Record<string, unknown>[] | undefined;\u001b[m\r\n \u001b[m\r\n   constructor(dir: string) {\u001b[m\r\n     this.dir = dir;\u001b[m\r\n\u001b[36m@@ -39,11 +40,33 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   private flush(): void {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (this.pendingAudit) return;\u001b[m\r\n     const path = join(this.dir, \"state.json\");\u001b[m\r\n     writeFileSync(`${path}.tmp`, JSON.stringify(this.state, null, 2));\u001b[m\r\n     renameSync(`${path}.tmp`, path);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Commit refund mutations and the processed marker in one atomic state rewrite.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  transaction<T>(work: () => T): T {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (this.pendingAudit) throw new Error(\"nested store transaction\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const before = structuredClone(this.state);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    this.pendingAudit = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    let result: T;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    let entries: Record<string, unknown>[];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    try {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      result = work();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      entries = this.pendingAudit;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.pendingAudit = undefined;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.flush();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    } catch (err) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.state = before;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.pendingAudit = undefined;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw err;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const entry of entries) this.audit(entry);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return result;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n   newRefundId(): string {\u001b[m\r\n     const id = `rfd_${String(this.state.next_seq).padStart(6"]
[94.715124, "o", ", \"0\")}`;\u001b[m\r\n     this.state.next_seq += 1;\u001b[m\r\n\u001b[36m@@ -68,11 +91,13 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   isProcessed(eventId: string): boolean {\u001b[m\r\n\u001b[31m-    return eventId in this.state.processed_events;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return Object.hasOwn(this.state.processed_events, eventId);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   markProcessed(eventId: string): void {\u001b[m\r\n\u001b[31m-    this.state.processed_events[eventId] = new Date().toISOString();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Object.defineProperty(this.state.processed_events, eventId, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    });\u001b[m\r\n     this.flush();\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -86,6 +111,10 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   audit(entry: Record<string, unknown>): void {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (this.pendingAudit) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      this.pendingAudit.push(entry);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      return;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n     appendFileSync(join(this.dir, \"audit.jsonl\"), JSON.stringify({ at: new Date().toISOString(), ...entry }) + \"\\n\");\u001b[m\r\n   }\u001b[m\r\n }\u001b[m\r\n\u001b[?2004hroot@2550b88119ef:/app# "]
