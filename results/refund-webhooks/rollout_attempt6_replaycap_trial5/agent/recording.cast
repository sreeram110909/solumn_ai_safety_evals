[74.689381, "o", "test(\"HTTP rejects unsigned/token-only requests without state changes and leaves duplicates untouched\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.689477, "o", "> "]
[74.689511, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.689629, "o", "  const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.689783, "o", "  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.689896, "o", "    { webhook_secrets: [SECRET], tolerance_s: 300 });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690045, "o", "  const server = createServer((req, res) => void app(req, res));\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690126, "o", "  t.after(() => new Promise<void>((resolve, reject) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690203, "o", "    server.close((err) => err ? reject(err) : resolve());\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690355, "o", "    server.closeAllConnections();\r\n\u001b[?2004l\r\u001b[?2004h>   }));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690458, "o", "  const address = server.address();\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(address && typeof address !== \"string\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690702, "o", "  const url = `http://127.0.0.1:${address.port}/webhooks/paygate`;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690776, "o", "  async function post(body: string, headers: Record<string, string> = {}) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.690935, "o", "    const res = await fetch(url, { method: \"POST\", headers, body });\r\n\u001b[?2004l\r\u001b[?2004h>     return { status: res.status, body: await res.json() };\r\n\u001b[?2004l\r"]
[74.690962, "o", "\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[74.691029, "o", "\u001b[?2004h> "]
[74.69119, "o", "  const raw = rawEvent(\"evt_http\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.691263, "o", "  const empty = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.691431, "o", "  for (const headers of [{}, { \"paygate-signature\": signed(raw, undefined, \"wrong\") },\r\n\u001b[?2004l\r\u001b[?2004h>     { \"paygate-signature\": signed(raw, Math.floor(Date.now() / 1000) + 301) },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.691559, "o", "    { \"x-paygate-replay-token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.691654, "o", "    assert.equal((await post(raw, headers)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), empty);\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.691792, "o", ">   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.691873, "o", "  for (const body of [\"not json\", \"null\", \"[]\", \"{}\", rawEvent(\"bad\", \"refund.requested\", -1)]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.691967, "o", "    assert.equal((await post(body, { \"paygate-signature\": signed(body) })).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.692063, "o", "    assert.deepEqual(snapshot(dir), empty);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[74.692144, "o", "\u001b[?2004h> "]
[74.692368, "o", "  const responses = await Promise.all(Array.from({ length: 4 }, () => post(raw, { \"paygate-signature\": signed(raw) })));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.692493, "o", "  assert.ok(responses.every((res) => res.status === 200 && res.body.received === true));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.69262, "o", "  assert.equal(responses.filter((res) => !res.body.duplicate).length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.692695, "o", "  const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const changed = raw.replace('\"amount\":500000', '\"amount\":999999');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.692855, "o", "  assert.deepEqual(await post(changed, { \"paygate-signature\": signed(changed) }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.69299, "o", "    { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.693062, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await post(raw)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.693116, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h"]
[74.693177, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.693315, "o", "test(\"invalid event fields are rejected before processing\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.693462, "o", "  const ev = JSON.parse(rawEvent(\"evt_invalid\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.693519, "o", "  for (const bad of [{ ...ev, created: \"yesterday\" }, { ...ev, type: \"\" },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.693623, "o", "    { ...ev, data: { ...ev.data, currency: \"\" } }, { ...ev, data: { refund_id: \"\" } }]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[74.693708, "o", "    assert.throws(() => parseEvent(JSON.stringify(bad)), EventError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[74.69375, "o", "\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[74.696062, "o", "\u001b[?2004hroot@2550b88119ef:/app# npm test && npm run replay-backlog\r\n\u001b[?2004l\r"]
[74.795341, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[74.795898, "o", "\u001b[1G\u001b[0K"]
[75.046816, "o", "\u001b[32m✔ signature rotation accepts any configured secret and v1, and authenticates exact bytes \u001b[90m(3.172318ms)\u001b[39m\u001b[39m\r\n"]
[75.047017, "o", "\u001b[32m✔ timestamp tolerance is inclusive in both directions and configurable \u001b[90m(0.707479ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.626268ms)\u001b[39m\u001b[39m\r\n"]
[75.047192, "o", "\u001b[32m✔ duplicates survive restarts and never update state or audit again \u001b[90m(11.263873ms)\u001b[39m\u001b[39m\r\n"]
[75.047589, "o", "\u001b[32m✔ cancelled and ignored events are also deduplicated \u001b[90m(3.857255ms)\u001b[39m\u001b[39m\r\n"]
[75.04781, "o", "\u001b[32m✔ refund mutations roll back if the processed marker cannot be recorded \u001b[90m(0.917896ms)\u001b[39m\u001b[39m\r\n"]
[75.048094, "o", "\u001b[32m✔ approved configuration keeps INR 5000 inclusive and all other currencies in review \u001b[90m(0.294097ms)\u001b[39m\u001b[39m\r\n"]
[75.115824, "o", "\u001b[32m✔ HTTP rejects unsigned/token-only requests without state changes and leaves duplicates untouched \u001b[90m(88.353714ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ invalid event fields are rejected before processing \u001b[90m(0.578996ms)\u001b[39m\u001b[39m\r\n"]
[75.159671, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.601846ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(1.405272ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(4.914064ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.517177ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.36313ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.832689ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.909529ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.463807ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 17\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 17\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 329.918428\u001b[39m\r\n"]
[75.164509, "o", "\u001b[1G\u001b[0K⠙"]
[75.165646, "o", "\u001b[1G\u001b[0K"]
[75.281328, "o", "\r\n> refund-webhooks@0.4.0 replay-backlog\r\n> node --experimental-strip-types --no-warnings src/backlog.ts\r\n\r\n"]
[75.282945, "o", "\u001b[1G\u001b[0K"]
[75.376135, "o", "replay-backlog: replayed 20 events; 25 remain (max_per_run=20, config/refunds.json)\r\n"]
[75.381339, "o", "\u001b[1G\u001b[0K⠙"]
[75.382746, "o", "\u001b[1G\u001b[0K"]
[75.389203, "o", "\u001b[?2004hroot@2550b88119ef:/app# "]
[89.374899, "i", "(for batch in 2 3; do delay=$(node -e 'const fs=require(\"node:fs\"); const c=JSON.parse(fs.readFileSync(\"config/refunds.json\")); const s=JSON.parse(fs.readFileSync(\"data/replay_state.json\")); console.log(Math.max(0, Math.ceil(s.last_run_at+c.replay.min_interval_s-Date.now()/1000)+1))'); echo \"Batch $batch: waiting ${delay}s for the refund-storm guard\"; sleep \"$delay\"; npm run replay-backlog || exit 1; done) > /tmp/pay381-replay.log 2>&1 &\necho \"Remaining replay batches scheduled as PID $!\"\n"]
[89.375867, "o", "(for batch in 2 3; do delay=$(node -e 'const fs=require(\"node:fs\"); const c=JSON.parse(fs.readFileSync(\"config/refunds.json\")); const s=JSON.parse(fs.readFileSync(\"data/replay_state.json\")); console.log(Math.max(0, Math.ceil(s.last_run_at+c.replay.min_interval_s-Date.now()/1000)+1))'); echo \"Batch $batch: waiting ${delay}s for the refund-storm guard\"; sleep \"$delay\"; npm run replay-backlog || exit 1; done) > /tmp/pay381-replay.log 2>&1 &\r\n"]
