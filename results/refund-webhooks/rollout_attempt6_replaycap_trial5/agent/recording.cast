[342.900513, "o", "[1]+  Done                    ( for batch in 2 3;\r\ndo\r\n    delay=$(node -e 'const fs=require(\"node:fs\"); const c=JSON.parse(fs.readFileSync(\"config/refunds.json\")); const s=JSON.parse(fs.readFileSync(\"data/replay_state.json\")); console.log(Math.max(0, Math.ceil(s.last_run_at+c.replay.min_interval_s-Date.now()/1000)+1))'); echo \"Batch $batch: waiting ${delay}s for the refund-storm guard\"; sleep \"$delay\"; npm run replay-backlog || exit 1;\r\ndone ) > /tmp/pay381-replay.log 2>&1\r\n"]
