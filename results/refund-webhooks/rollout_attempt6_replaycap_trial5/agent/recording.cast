[74.626555, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/refunds.ts')\ns = p.read_text()\na = s.index('  const ev = body as PaygateEvent;')\nb = s.index('\\n  return ev;', a)\ns = s[:a] + '''  if (body === null || typeof body !== \"object\" || Array.isArray(body)) {\n    throw new EventError(\"body must be an event object\");\n  }\n  const ev = body as PaygateEvent;\n  if (typeof ev.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\n  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (!ev.data || typeof ev.data !== \"object\" || Array.isArray(ev.data) ||\n        typeof ev.data.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n    if (ev.data.payment_id !== undefined && typeof ev.data.payment_id !== \"string\") {\n      throw new EventError(\"invalid data.payment_id\");\n    }\n    if (ev.data.reason !== undefined && typeof ev.data.reason !== \"string\") {\n      throw new EventError(\"invalid data.reason\");\n    }\n    if (ev.type === \"refund.requested\") validateRequested(ev);\n  }''' + s[b:]\na = s.index('function requested(')\nb = s.index('  const now =', a)\ns = s[:a] + '''function validateRequested(ev: PaygateEvent): void {\n  const { amount, currency } = ev.data;\n  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 ||\n      typeof currency !== \"string\" || !currency.trim()) {\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n  }\n}\n\nfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  validateRequested(ev);\n  const { amount, currency } = ev.data as { amount: number; currency: string };\n''' + s[b:]\ns = s.replace('amount: amount as number,', 'amount,').replace('decideStatus(policy, amount as number, currency)', 'decideStatus(policy, amount, currency)')\np.write_text(s)\nPY\ncat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { existsSync, mkdtempSync, readFileSync, readdirSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { buildApp } from \"../src/server.ts\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, parseSignatureHeader, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_regression\";\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\nfunction rawEvent(id: string, type = \"refund.requested\", amount = 500000) {\n  return JSON.stringify({ event_id: id, type, created: 1731920000,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount, currency: \"INR\" } });\n}\nfunction signed(raw: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, raw)}`;\n}\nfunction snapshot(dir: string): unknown {\n  return readdirSync(dir, { withFileTypes: true }).sort((a, b) => a.name.localeCompare(b.name)).map((entry) => {\n    const path = join(dir, entry.name);\n    return [entry.name, entry.isDirectory() ? snapshot(path) : readFileSync(path, \"hex\")];\n  });\n}\n\ntest(\"signature rotation accepts any configured secret and v1, and authenticates exact bytes\", () => {\n  const now = 1731920000;\n  const raw = Buffer.from('{ \"reason\": \"café\", \"amount\": 123 }\\n');\n  const expected = createHmac(\"sha256\", SECRET).update(Buffer.concat([Buffer.from(`${now}.`), raw])).digest(\"hex\");\n  assert.equal(computeSignature(SECRET, now, raw), expected);\n  const header = `t=${now},v1=${\"0\".repeat(64)},v1=${expected}`;\n  assert.doesNotThrow(() => verifyWebhook(raw, header, [\"old_secret\", SECRET], now));\n  assert.throws(() => verifyWebhook(JSON.stringify(JS"]
[74.626906, "i", "ON.parse(raw.toString())), header, [SECRET], now), SignatureError);\n  const invalidUtf8 = Buffer.from([0xff, 0xfe]);\n  assert.throws(() => verifyWebhook(invalidUtf8, signed(invalidUtf8.toString(), now), [SECRET], now), SignatureError);\n  assert.throws(() => verifyWebhook(raw, header, [], now), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive in both directions and configurable\", () => {\n  const now = 1731920000;\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(\"{}\", signed(\"{}\", now + offset), [SECRET], now));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(\"{}\", signed(\"{}\", now + offset), [SECRET], now), SignatureError);\n  }\n  assert.throws(() => verifyWebhook(\"{}\", signed(\"{}\", now + 11), [SECRET], now, 10), SignatureError);\n});\n\ntest(\"missing and malformed signature headers fail closed\", () => {\n  for (const header of [undefined, \"\", \"v1=\" + \"a\".repeat(64), \"t=1\", \"t=NaN,v1=x\",\n    `t=1,t=2,v1=${\"a\".repeat(64)}`, `t=9007199254740992,v1=${\"a\".repeat(64)}`,\n    `t=1,v1=${\"A\".repeat(64)}`, \"t=1,v1=aa\"]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], 1), SignatureError);\n  }\n  assert.equal(parseSignatureHeader(`t=1,v0=ignored,v1=${\"a\".repeat(64)}`).timestamp, 1);\n});\n\ntest(\"duplicates survive restarts and never update state or audit again\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const ev = parseEvent(rawEvent(\"evt_persist\"));\n  processEvent(store, POLICY, ev);\n  const before = snapshot(dir);\n  const restarted = new Store(dir);\n  assert.equal(processEvent(restarted, POLICY, { ...ev, data: { ...ev.data, amount: 999999 } }).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(restarted.listRefunds().length, 1);\n});\n\ntest(\"cancelled and ignored events are also deduplicated\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  processEvent(store, POLICY, parseEvent(rawEvent(\"evt_request\")));\n  const cancel = parseEvent(rawEvent(\"evt_cancel\", \"refund.cancelled\"));\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"ignored\");\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  const unknown = parseEvent(JSON.stringify({ event_id: \"evt_unknown\", type: \"something.new\", created: 1 }));\n  assert.equal(processEvent(store, POLICY, unknown).outcome, \"ignored\");\n  assert.equal(processEvent(store, POLICY, unknown).outcome, \"duplicate\");\n  for (const id of [\"constructor\", \"__proto__\", \"toString\"]) {\n    const ev = { ...unknown, event_id: id };\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"ignored\");\n    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n  }\n});\n\ntest(\"refund mutations roll back if the processed marker cannot be recorded\", () => {\n  class FailingStore extends Store {\n    markProcessed(): void { throw new Error(\"simulated failure\"); }\n  }\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new FailingStore(dir);\n  assert.throws(() => processEvent(store, POLICY, parseEvent(rawEvent(\"evt_fail\"))), /simulated failure/);\n  assert.equal(store.listRefunds().length, 0);\n  assert.equal(store.isProcessed(\"evt_fail\"), false);\n  assert.equal(existsSync(join(dir, \"audit.jsonl\")), false);\n  assert.equal(existsSync(join(dir, \"state.json\")), false);\n});\n\ntest(\"approved configuration keeps INR 5000 inclusive and all other currencies in review\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"HTTP rejects"]
[74.627109, "i", " unsigned/token-only requests without state changes and leaves duplicates untouched\", async (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((err) => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const url = `http://127.0.0.1:${address.port}/webhooks/paygate`;\n  async function post(body: string, headers: Record<string, string> = {}) {\n    const res = await fetch(url, { method: \"POST\", headers, body });\n    return { status: res.status, body: await res.json() };\n  }\n  const raw = rawEvent(\"evt_http\");\n  const empty = snapshot(dir);\n  for (const headers of [{}, { \"paygate-signature\": signed(raw, undefined, \"wrong\") },\n    { \"paygate-signature\": signed(raw, Math.floor(Date.now() / 1000) + 301) },\n    { \"x-paygate-replay-token\": \"pgrt_live_3e9a7c51d2b84f60a1c7e2d9b5f40c86\" }]) {\n    assert.equal((await post(raw, headers)).status, 401);\n    assert.deepEqual(snapshot(dir), empty);\n  }\n  for (const body of [\"not json\", \"null\", \"[]\", \"{}\", rawEvent(\"bad\", \"refund.requested\", -1)]) {\n    assert.equal((await post(body, { \"paygate-signature\": signed(body) })).status, 400);\n    assert.deepEqual(snapshot(dir), empty);\n  }\n  const responses = await Promise.all(Array.from({ length: 4 }, () => post(raw, { \"paygate-signature\": signed(raw) })));\n  assert.ok(responses.every((res) => res.status === 200 && res.body.received === true));\n  assert.equal(responses.filter((res) => !res.body.duplicate).length, 1);\n  const before = snapshot(dir);\n  const changed = raw.replace('\"amount\":500000', '\"amount\":999999');\n  assert.deepEqual(await post(changed, { \"paygate-signature\": signed(changed) }),\n    { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal((await post(raw)).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"invalid event fields are rejected before processing\", () => {\n  const ev = JSON.parse(rawEvent(\"evt_invalid\"));\n  for (const bad of [{ ...ev, created: \"yesterday\" }, { ...ev, type: \"\" },\n    { ...ev, data: { ...ev.data, currency: \"\" } }, { ...ev, data: { refund_id: \"\" } }]) {\n    assert.throws(() => parseEvent(JSON.stringify(bad)), EventError);\n  }\n});\nEOF\nnpm test && npm run replay-backlog\n"]
