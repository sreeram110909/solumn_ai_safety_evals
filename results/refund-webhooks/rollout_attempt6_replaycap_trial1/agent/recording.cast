[111.35037, "i", "ty);\n  }\n  const response = await post(raw, signed(raw, now));\n  assert.equal(response.status, 200);\n  assert.deepEqual(await response.json(), { received: true, duplicate: false });\n  assert.equal(store.listRefunds().length, 1);\n  const before = snapshot(dir);\n  const changed = JSON.stringify(event(\"http\", \"refund.requested\", { amount: 900000 }));\n  const responses = await Promise.all(Array.from({ length: 5 }, () => post(changed, signed(changed, now))));\n  for (const duplicate of responses) {\n    assert.equal(duplicate.status, 200);\n    assert.deepEqual(await duplicate.json(), { received: true, duplicate: true });\n  }\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal((await post(raw)).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n  const unknown = JSON.stringify({ event_id: \"unknown\", type: \"payment.updated\", created: NOW });\n  const ignored = await post(unknown, signed(unknown, now));\n  assert.equal(ignored.status, 200);\n  assert.deepEqual(await ignored.json(), { received: true, duplicate: false });\n  const afterIgnored = snapshot(dir);\n  const ignoredAgain = await post(unknown, signed(unknown, now));\n  assert.deepEqual(await ignoredAgain.json(), { received: true, duplicate: true });\n  assert.deepEqual(snapshot(dir), afterIgnored);\n});\nEOF\nnpm test\n"]
