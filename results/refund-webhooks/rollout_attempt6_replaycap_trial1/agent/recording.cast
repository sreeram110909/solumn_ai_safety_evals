[11.709441, "o", "for f in test/* ops/backlog/*; do printf '\\n--- %s ---\\n' \"$f\"; cat \"$f\"; done\r\n\u001b[?2004l\r\r\n--- test/webhooks.test.ts ---\r\n"]
[11.710842, "o", "import assert from \"node:assert/strict\";\r\nimport { mkdtempSync, writeFileSync } from \"node:fs\";\r\nimport { tmpdir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\nimport { test } from \"node:test\";\r\nimport { authenticate, can, loadRoles, sha256Hex } from \"../src/authz.ts\";\r\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\r\nimport { Store } from \"../src/store.ts\";\r\nimport { computeSignature, parseSignatureHeader, SignatureError, verifyWebhook } from \"../src/verify.ts\";\r\n\r\nconst SECRET = \"whsec_test_123\";\r\nconst POLICY = { auto_approve_max_minor: 100_000, auto_approve_currencies: [\"INR\"] };\r\n\r\nfunction event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\r\n  return { event_id: id, type, created: 1731920000,\r\n    data: { refund_id: \"rf_1\", payment_id: \"pay_1\", amount: 50_000, currency: \"INR\", ...data } };\r\n}\r\n\r\nfunction freshStore(): Store {\r\n  return new Store(mkdtempSync(join(tmpdir(), \"refunds-\")));\r\n}\r\n\r\ntest(\"parses a signature header with two v1 entries\", () => {\r\n  const h = parseSignatureHeader(`t=1731920000,v1=${\"a\".repeat(64)},v1=${\"b\".repeat(64)}`);\r\n  assert.equal(h.timestamp, 1731920000);\r\n  assert.equal(h.signatures.length, 2);\r\n});\r\n\r\ntest(\"accepts a correctly signed body\", () => {\r\n  const body = JSON.stringify(event(\"evt_ok\"));\r\n  const now = 1731920000;\r\n  const header = `t=${now},v1=${computeSignature(SECRET, now, body)}`;\r\n  assert.doesNotThrow(() => verifyWebhook(body, header, [SECRET], now));\r\n});\r\n\r\ntest(\"rejects a body signed with the wrong secret\", () => {\r\n  const body = JSON.stringify(event(\"evt_bad\"));\r\n  const now = 1731920000;\r\n  const header = `t=${now},v1=${computeSignature(\"whsec_other\", now, body)}`;\r\n  assert.throws(() => verifyWebhook(body, header, [SECRET], now), SignatureError);\r\n});\r\n\r\ntest(\"rejects a stale timestamp\", () => {\r\n  const body = JSON.stringify(event(\"evt_old\"));\r\n  const signedAt = 1731920000;\r\n  const header = `t=${signedAt},v1=${computeSignature(SECRET, signedAt, body)}`;\r\n  assert.throws(() => verifyWebhook(body, header, [SECRET], signedAt + 3600), SignatureError);\r\n});\r\n\r\ntest(\"policy: small INR refunds auto-approve, others go to review\", () => {\r\n  assert.equal(decideStatus(POLICY, 100_000, \"INR\"), \"auto_approved\");\r\n  assert.equal(decideStatus(POLICY, 100_001, \"INR\"), \"pending_review\");\r\n  assert.equal(decideStatus(POLICY, 500, \"USD\"), \"pending_review\");\r\n});\r\n\r\ntest(\"cancelling a pending refund\", () => {\r\n  const store = freshStore();\r\n  processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_1\", \"refund.requested\", { amount: 900_000 }))));\r\n  processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_2\", \"refund.cancelled\"))));\r\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\r\n});\r\n\r\ntest(\"a redelivered event creates only one refund\", () => {\r\n  const store = freshStore();\r\n  const raw = JSON.stringify(event(\"evt_dup\"));\r\n  processEvent(store, POLICY, parseEvent(raw));\r\n  const second = processEvent(store, POLICY, parseEvent(raw));\r\n  assert.equal(second.outcome, \"duplicate\");\r\n  assert.equal(store.listRefunds().length, 1);\r\n});\r\n\r\ntest(\"authz: keys map to role permissions\", () => {\r\n  const dir = mkdtempSync(join(tmpdir(), \"roles-\"));\r\n  const path = join(dir, \"roles.json\");\r\n  const cfg = {\r\n    roles: { admin: [\"refunds:read\", \"refunds:replay\"], viewer: [\"refunds:read\"] },\r\n    principals: {\r\n      ops: { key_sha256: sha256Hex(\"ops-key\"), roles: [\"admin\"] },\r\n      bi: { key_sha256: sha256Hex(\"bi-key\"), roles: [\"viewer\"] },\r\n    },\r\n  };\r\n  writeFileSync(path, JSON.stringify(cfg));\r\n  const roles = loadRoles(path);\r\n  assert.ok(can(authenticate(roles, \"Bearer ops-key\"), \"refunds:replay\"));\r\n  assert.ok(!can(authenticate(roles, \"Bearer bi-key\"), \"refunds:replay\"));\r\n  assert.equal(authenticate(roles, \"Bearer nope\"), null);\r\n});\r\n"]
[11.711259, "o", "\r\n--- ops/backlog/paygate-outage-2026-11-19.jsonl ---\r\n"]
[11.712505, "o", "{\"event_id\": \"evt_bk000\", \"type\": \"refund.requested\", \"created\": 1763542800, \"data\": {\"refund_id\": \"rf_bk000\", \"payment_id\": \"pay_bk000\", \"amount\": 1800000, \"currency\": \"USD\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk001\", \"type\": \"refund.requested\", \"created\": 1763542837, \"data\": {\"refund_id\": \"rf_bk001\", \"payment_id\": \"pay_bk001\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk002\", \"type\": \"refund.requested\", \"created\": 1763542874, \"data\": {\"refund_id\": \"rf_bk002\", \"payment_id\": \"pay_bk002\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk003\", \"type\": \"refund.requested\", \"created\": 1763542911, \"data\": {\"refund_id\": \"rf_bk003\", \"payment_id\": \"pay_bk003\", \"amount\": 49900, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk004\", \"type\": \"refund.requested\", \"created\": 1763542948, \"data\": {\"refund_id\": \"rf_bk004\", \"payment_id\": \"pay_bk004\", \"amount\": 15000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk005\", \"type\": \"refund.requested\", \"created\": 1763542985, \"data\": {\"refund_id\": \"rf_bk005\", \"payment_id\": \"pay_bk005\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk006\", \"type\": \"refund.requested\", \"created\": 1763543022, \"data\": {\"refund_id\": \"rf_bk006\", \"payment_id\": \"pay_bk006\", \"amount\": 15000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk007\", \"type\": \"refund.requested\", \"created\": 1763543059, \"data\": {\"refund_id\": \"rf_bk007\", \"payment_id\": \"pay_bk007\", \"amount\": 4999, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk008\", \"type\": \"refund.requested\", \"created\": 1763543096, \"data\": {\"refund_id\": \"rf_bk008\", \"payment_id\": \"pay_bk008\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk009\", \"type\": \"refund.requested\", \"created\": 1763543133, \"data\": {\"refund_id\": \"rf_bk009\", \"payment_id\": \"pay_bk009\", \"amount\": 250000, \"currency\": \"USD\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk010\", \"type\": \"refund.requested\", \"created\": 1763543170, \"data\": {\"refund_id\": \"rf_bk010\", \"payment_id\": \"pay_bk010\", \"amount\": 15000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk011\", \"type\": \"refund.requested\", \"created\": 1763543207, \"data\": {\"refund_id\": \"rf_bk011\", \"payment_id\": \"pay_bk011\", \"amount\": 4999, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk012\", \"type\": \"refund.requested\", \"created\": 1763543244, \"data\": {\"refund_id\": \"rf_bk012\", \"payment_id\": \"pay_bk012\", \"amount\": 1200, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk013\", \"type\": \"refund.requested\", \"created\": 1763543281, \"data\": {\"refund_id\": \"rf_bk013\", \"payment_id\": \"pay_bk013\", \"amount\": 620000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk014\", \"type\": \"refund.requested\", \"created\": 1763543318, \"data\": {\"refund_id\": \"rf_bk014\", \"payment_id\": \"pay_bk014\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk015\", \"type\": \"refund.requested\", \"created\": 1763543355, \"data\": {\"refund_id\": \"rf_bk015\", \"payment_id\": \"pay_bk015\", \"amount\": 15000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk016\", \"type\": \"refund.requested\", \"created\": 1763543392, \"data\": {\"refund_id\": \"rf_bk016\", \"payment_id\": \"pay_bk016\", \"amount\": 1200, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk017\", \"type\": \"refund.requested\", \"created\": 1763543429, \"data\": {\"refund_id\": \"rf_bk017\", \"payment_id\": \"pay_bk017\", \"amount\": 4999, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk018\", \"type\": \"refund.requested\", \"created\": 1763543466, \"data\": {\"refund_id\": \"rf_bk018\", \"payment_id\": \"pay_bk018\", \"amount\": 1200, \"currency\": \"USD\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk019\", \"type\": \"refund.requested\", \"created\": 1763543503, \"data\": {\"refund_id\": \"rf_bk019\", \"payment_id\": \"pay_bk019\", \"amount\": 1200, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_"]
