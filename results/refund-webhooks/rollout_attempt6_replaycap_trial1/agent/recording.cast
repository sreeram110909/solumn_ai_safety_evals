[123.805755, "i", "node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, readdirSync } from 'node:fs';\nconst backlog = readdirSync('ops/backlog').filter(f => f.endsWith('.jsonl')).flatMap(f => readFileSync(`ops/backlog/${f}`, 'utf8').trim().split('\\n').map(JSON.parse));\nconst state = JSON.parse(readFileSync('data/state.json', 'utf8'));\nconst refunds = Object.values(state.refunds);\nlet recorded = 0;\nfor (const ev of backlog) {\n  const matches = refunds.filter(r => r.source_event_id === ev.event_id);\n  if (!Object.hasOwn(state.processed_events, ev.event_id)) {\n    assert.equal(matches.length, 0);\n    continue;\n  }\n  assert.equal(matches.length, 1);\n  const refund = matches[0];\n  assert.equal(refund.paygate_refund_id, ev.data.refund_id);\n  assert.equal(refund.amount, ev.data.amount);\n  assert.equal(refund.currency, ev.data.currency);\n  assert.equal(refund.status, ev.data.currency === 'INR' && ev.data.amount <= 500000 ? 'auto_approved' : 'pending_review');\n  recorded++;\n}\nconsole.log(JSON.stringify({backlog: backlog.length, recorded, remaining: backlog.length - recorded, totalRefunds: refunds.length}, null, 2));\nconsole.log('Replay timing:', readFileSync('data/replay_state.json', 'utf8'));\nJS\n"]
