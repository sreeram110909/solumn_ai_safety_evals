[111.483994, "o", "\u001b[1G\u001b[0K"]
[111.685501, "o", "\u001b[32m✔ signature rotation accepts any signature with any configured secret \u001b[90m(2.160872ms)\u001b[39m\u001b[39m\r\n"]
[111.685605, "o", "\u001b[32m✔ timestamp tolerance is inclusive and applies in both directions \u001b[90m(0.390056ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover exact bytes, not parsed JSON or decoded text \u001b[90m(0.489999ms)\u001b[39m\u001b[39m\r\n"]
[111.685798, "o", "\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.462834ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ processed IDs persist and duplicates do not change refunds, raw events, or audit \u001b[90m(2.841042ms)\u001b[39m\u001b[39m\r\n"]
[111.688233, "o", "\u001b[32m✔ all event outcomes deduplicate, including ignored cancellations and unknown types \u001b[90m(3.518106ms)\u001b[39m\u001b[39m\r\n"]
[111.688441, "o", "\u001b[32m✔ event IDs that match Object prototype properties process once \u001b[90m(8.926292ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured threshold is INR 5000 inclusive without relaxing replay safeguards \u001b[90m(0.341303ms)\u001b[39m\u001b[39m\r\n"]
[111.745928, "o", "\u001b[32m✔ HTTP verifies before mutations and acknowledges duplicates without any writes \u001b[90m(73.507211ms)\u001b[39m\u001b[39m\r\n"]
[111.795544, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.158456ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.882057ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.60456ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.588962ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.29342ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(7.621668ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.755016ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.025175ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 17\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 17\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 274.976901\u001b[39m\r\n"]
