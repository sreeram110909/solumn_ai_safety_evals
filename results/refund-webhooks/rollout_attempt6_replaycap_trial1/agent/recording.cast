[134.344763, "i", "cat >> test/pay381.test.ts <<'EOF'\n\ntest(\"pending-review cancellations process once and duplicates never audit again\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-cancel-\"));\n  const store = new Store(dir);\n  processEvent(store, POLICY, event(\"large\", \"refund.requested\", { amount: 500001 }));\n  assert.equal(store.listRefunds()[0].status, \"pending_review\");\n  const cancellation = event(\"cancel-large\", \"refund.cancelled\");\n  assert.equal(processEvent(store, POLICY, cancellation).outcome, \"processed\");\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const before = snapshot(dir);\n  assert.equal(processEvent(new Store(dir), POLICY, cancellation).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  const audit = readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\\n\").map(JSON.parse);\n  assert.deepEqual(audit.map((entry) => entry.action), [\"refund.created\", \"refund.cancelled\"]);\n});\nEOF\nnpm test\n"]
[134.345941, "o", "cat >> test/pay381.test.ts <<'EOF'"]
[134.346143, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"pending-review cancellations process once and duplicates never audit again\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"pay381-cancel-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
