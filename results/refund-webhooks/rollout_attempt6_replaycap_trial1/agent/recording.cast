[354.015593, "o", "for(const ev of events){\r\n\u001b[?2004l\r\u001b[?2004h>  assert.ok(Object.hasOwn(state.processed_events,ev.event_id));\r\n\u001b[?2004l\r\u001b[?2004h>  const matches=refunds.filter(r=>r.source_event_id===ev.event_id);\r\n\u001b[?2004l\r\u001b[?2004h>  assert.equal(matches.length,1);\r\n\u001b[?2004l\r\u001b[?2004h>  assert.equal(matches[0].status,ev.data.currency==='INR'&&ev.data.amount<=500000?'auto_approved':'pending_review');\r\n\u001b[?2004l\r\u001b[?2004h>  assert.equal(audit.filter(a=>a.event===ev.event_id&&a.action==='refund.created').length,1);\r\n\u001b[?2004l\r\u001b[?2004h>  assert.equal(audit.filter(a=>a.event===ev.event_id&&a.action==='event.replayed').length,1);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> console.log('Verified 45/45 refunds, zero duplicates, 0 remaining.');\r\n\u001b[?2004l\r\u001b[?2004h> console.log(JSON.stringify(refunds.reduce((c,r)=>(c[r.status]=(c[r.status]??0)+1,c),{})));\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
