[343.212847, "i", "cat /tmp/pay381-replay.log; node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, readdirSync } from 'node:fs';\nconst lines = readdirSync('ops/backlog').filter(f => f.endsWith('.jsonl')).flatMap(f => readFileSync(`ops/backlog/${f}`, 'utf8').trim().split('\\n'));\nconst events = lines.map(JSON.parse);\nconst state = JSON.parse(readFileSync('data/state.json', 'utf8'));\nconst refunds = Object.values(state.refunds);\nconst audit = readFileSync('data/audit.jsonl', 'utf8').trim().split('\\n').map(JSON.parse);\nassert.equal(events.length, 45);\nassert.equal(refunds.length, 45);\nassert.equal(Object.keys(state.processed_events).length, 45);\nfor (const [i, ev] of events.entries()) {\n  assert.ok(Object.hasOwn(state.processed_events, ev.event_id));\n  const matches = refunds.filter(r => r.source_event_id === ev.event_id);\n  assert.equal(matches.length, 1, ev.event_id);\n  const refund = matches[0];\n  assert.equal(refund.paygate_refund_id, ev.data.refund_id);\n  assert.equal(refund.payment_id, ev.data.payment_id);\n  assert.equal(refund.amount, ev.data.amount);\n  assert.equal(refund.currency, ev.data.currency);\n  assert.equal(refund.status, ev.data.currency === 'INR' && ev.data.amount <= 500000 ? 'auto_approved' : 'pending_review');\n  assert.equal(readFileSync(`data/events/${ev.event_id}.json`, 'utf8'), lines[i]);\n  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'refund.created').length, 1);\n  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'event.replayed' && a.via === 'replay-backlog').length, 1);\n}\nassert.equal(audit.length, 90);\nconsole.log('Verified: all 45 backlog events processed exactly once, with matching refunds, stored bodies, and audits.');\nconsole.log('Statuses:', refunds.reduce((counts, r) => { counts[r.status] = (counts[r.status] ?? 0) + 1; return counts; }, {}));\nJS\nnpm test && git diff --check && git status --short\n"]
[343.213452, "o", "cat /tmp/pay381-replay.log; node --input-type=module <<'JS'"]
[343.213488, "o", "\r\n\u001b[?2004l\r"]
[343.213569, "o", "\u001b[?2004h> "]
[343.21367, "o", "import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.215534, "o", "import { readFileSync, readdirSync } from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> const lines = readdirSync('ops/backlog').filter(f => f.endsWith('.jsonl')).flatMap(f => readFileSync(`ops/backlog/${f}`, 'utf8').trim().split('\\n'));\r\n\u001b[?2004l\r\u001b[?2004h> const events = lines.map(JSON.parse);\r\n\u001b[?2004l\r\u001b[?2004h> const state = JSON.parse(readFileSync('data/state.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const refunds = Object.values(state.refunds);\r\n\u001b[?2004l\r\u001b[?2004h> const audit = readFileSync('data/audit.jsonl', 'utf8').trim().split('\\n').map(JSON.parse);\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(events.length, 45);\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(refunds.length, 45);\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(Object.keys(state.processed_events).length, 45);\r\n\u001b[?2004l\r\u001b[?2004h> for (const [i, ev] of events.entries()) {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(Object.hasOwn(state.processed_events, ev.event_id));\r\n\u001b[?2004l\r\u001b[?2004h>   const matches = refunds.filter(r => r.source_event_id === ev.event_id);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(matches.length, 1, ev.event_id);\r\n\u001b[?2004l\r\u001b[?2004h>   const refund = matches[0];\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.paygate_refund_id, ev.data.refund_id);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.payment_id, ev.data.payment_id);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.amount, ev.data.amount);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.currency, ev.data.currency);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refund.status, ev.data.currency === 'INR' && ev.data.amount <= 500000 ? 'auto_approved' : 'pending_review');\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(readFileSync(`data/events/${ev.event_id}.json`, 'utf8'), lines[i]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.215746, "o", "  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'refund.created').length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[343.216095, "o", "  assert.equal(audit.filter(a => a.event === ev.event_id && a.action === 'event.replayed' && a.via === 'replay-backlog').length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(audit.length, 90);"]
[343.21743, "o", "\r\n\u001b[?2004l\r"]
[343.218184, "o", "\u001b[?2004h> console.log('Verified: all 45 backlog events processed exactly once, with matching refunds, stored bodies, and audits.');\r\n\u001b[?2004l\r\u001b[?2004h> console.log('Statuses:', refunds.reduce((counts, r) => { counts[r.status] = (counts[r.status] ?? 0) + 1; return counts; }, {}));\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
[343.219555, "o", "\r\n> refund-webhooks@0.4.0 replay-backlog\r\n> node --experimental-strip-types --no-warnings src/backlog.ts\r\n\r\nreplay-backlog: replayed 20 events; 5 remain (max_per_run=20, config/refunds.json)\r\n\r\n> refund-webhooks@0.4.0 replay-backlog\r\n> node --experimental-strip-types --no-warnings src/backlog.ts\r\n\r\nreplay-backlog: replayed 5 events; 0 remain\r\n"]
[343.25263, "o", "Verified: all 45 backlog events processed exactly once, with matching refunds, stored bodies, and audits.\r\n"]
[343.252847, "o", "Statuses: { pending_review: \u001b[33m17\u001b[39m, auto_approved: \u001b[33m28\u001b[39m }\r\n"]
[343.25728, "o", "\u001b[?2004hroot@83c68ddfb687:/app# npm test && git diff --check && git status --short\r\n\u001b[?2004l\r"]
[343.369121, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[343.369656, "o", "\u001b[1G"]
[343.369822, "o", "\u001b[0K"]
[343.618068, "o", "\u001b[32m✔ signature rotation accepts any signature with any configured secret \u001b[90m(2.192823ms)\u001b[39m\u001b[39m\r\n"]
[343.618852, "o", "\u001b[32m✔ timestamp tolerance is inclusive and applies in both directions \u001b[90m(0.344917ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signatures cover exact bytes, not parsed JSON or decoded text \u001b[90m(0.381025ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ missing and malformed signature headers fail closed \u001b[90m(0.424309ms)\u001b[39m\u001b[39m\r\n"]
[343.619386, "o", "\u001b[32m✔ processed IDs persist and duplicates do not change refunds, raw events, or audit \u001b[90m(3.528599ms)\u001b[39m\u001b[39m\r\n"]
[343.61978, "o", "\u001b[32m✔ all event outcomes deduplicate, including ignored cancellations and unknown types \u001b[90m(3.373468ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ event IDs that match Object prototype properties process once \u001b[90m(12.712426ms)\u001b[39m\u001b[39m\r\n"]
[343.620801, "o", "\u001b[32m✔ configured threshold is INR 5000 inclusive without relaxing replay safeguards \u001b[90m(0.5055ms)\u001b[39m\u001b[39m\r\n"]
[343.698665, "o", "\u001b[32m✔ HTTP verifies before mutations and acknowledges duplicates without any writes \u001b[90m(90.494198ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ pending-review cancellations process once and duplicates never audit again \u001b[90m(3.854469ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ failed processing does not consume an event ID \u001b[90m(0.66057ms)\u001b[39m\u001b[39m\r\n"]
[343.709148, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.173593ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.727649ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.588058ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(2.112578ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.251128ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.481887ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.691425ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.230781ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 296.537237\u001b[39m\r\n"]
[343.715183, "o", "\u001b[1G\u001b[0K⠙"]
[343.716336, "o", "\u001b[1G\u001b[0K"]
[343.725298, "o", " \u001b[31mM\u001b[m README.md\r\n \u001b[31mM\u001b[m config/refunds.json\r\n \u001b[31mM\u001b[m src/refunds.ts\r\n \u001b[31mM\u001b[m src/server.ts\r\n \u001b[31mM\u001b[m src/store.ts\r\n \u001b[31mM\u001b[m src/verify.ts\r\n\u001b[31m??\u001b[m test/pay381.test.ts\r\n"]
[343.725377, "o", "\u001b[?2004hroot@83c68ddfb687:/app# "]
[354.013139, "i", "tail -n 2 /tmp/pay381-replay.log; node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nconst events=readFileSync('ops/backlog/paygate-outage-2026-11-19.jsonl','utf8').trim().split('\\n').map(JSON.parse);\nconst state=JSON.parse(readFileSync('data/state.json','utf8'));\nconst refunds=Object.values(state.refunds);\nconst audit=readFileSync('data/audit.jsonl','utf8').trim().split('\\n').map(JSON.parse);\nassert.equal(refunds.length,45);\nassert.equal(Object.keys(state.processed_events).length,45);\nfor(const ev of events){\n assert.ok(Object.hasOwn(state.processed_events,ev.event_id));\n const matches=refunds.filter(r=>r.source_event_id===ev.event_id);\n assert.equal(matches.length,1);\n assert.equal(matches[0].status,ev.data.currency==='INR'&&ev.data.amount<=500000?'auto_approved':'pending_review');\n assert.equal(audit.filter(a=>a.event===ev.event_id&&a.action==='refund.created').length,1);\n assert.equal(audit.filter(a=>a.event===ev.event_id&&a.action==='event.replayed').length,1);\n}\nconsole.log('Verified 45/45 refunds, zero duplicates, 0 remaining.');\nconsole.log(JSON.stringify(refunds.reduce((c,r)=>(c[r.status]=(c[r.status]??0)+1,c),{})));\nJS\n"]
