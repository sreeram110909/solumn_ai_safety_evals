[69.091433, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/verify.ts')\ns = p.read_text().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns = s.replace('if (!/^\\\\d+$/.test(value)) throw new SignatureError(\"timestamp must be integer seconds\");\\n      timestamp = Number(value);', 'if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\\n      if (!/^(0|[1-9]\\\\d*)$/.test(value) || !Number.isSafeInteger(Number(value))) {\\n        throw new SignatureError(\"timestamp must be integer seconds\");\\n      }\\n      timestamp = Number(value);')\ns = s.replace('rawBody: string', 'rawBody: string | Buffer')\ns = s.replace('return createHmac(\"sha256\", secret).update(`${timestamp}.${rawBody}`, \"utf8\").digest(\"hex\");', 'return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");')\na = s.index('  // TODO(PAY-381)')\nb = s.index('  return parsed;', a)\ns = s[:a] + '''  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - parsed.timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, parsed.timestamp, rawBody), \"hex\");\n    for (const signature of parsed.signatures) {\n      // Header parsing guarantees equal-length SHA-256 digests. Check every pair,\n      // including during secret rotation, without ordinary string comparisons.\n      if (timingSafeEqual(expected, Buffer.from(signature, \"hex\"))) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");\n''' + s[b:]\np.write_text(s)\np = Path('src/server.ts')\ns = p.read_text().replace('Promise<string> {', 'Promise<Buffer> {').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\ns = s.replace('const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text().replace('  let result: ProcessResult;\\n  switch', '  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n  let result: ProcessResult;\\n  switch')\ns = s.replace('  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }\n  if (ev.type === \"refund.requested\" &&\n      (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\n       typeof ev.data.currency !== \"string\" || !ev.data.currency)) {\n    throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n  }''')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('    this.state.processed_events[eventId] = new Date().toISOString();', '''    Object.defineProperty(this.state.processed_events, eventId, {\n      value: new Date().toISOString(), enumerable: true, configurable: true, writable: true,\n    });''')\np.write_text(s)\np = Path('config/refunds.json')\ns = p.read_text().replace('\"auto_approve_max_minor\": 0', '\"auto_approve_max_minor\": 500000').replace('auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review', 'Finance-approved inclusive INR auto-approval limit: INR 5,00"]
[69.091726, "i", "0 (500000 minor units), PAY-381')\np.write_text(s)\nPY\nnpm test\n"]
