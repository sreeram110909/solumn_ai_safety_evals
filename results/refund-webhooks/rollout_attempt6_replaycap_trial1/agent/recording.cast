[111.348492, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { mkdtempSync, readFileSync, readdirSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test } from \"node:test\";\nimport { decideStatus, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_pay381_test\";\nconst NOW = 1731920000;\nconst POLICY = { auto_approve_max_minor: 500000, auto_approve_currencies: [\"INR\"] };\n\nfunction event(id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount: 500000, currency: \"INR\", ...data } };\n}\n\nfunction signed(raw: string | Buffer, at = NOW, secret = SECRET): string {\n  // Build signatures independently of the implementation under test.\n  const digest = createHmac(\"sha256\", secret).update(`${at}.`).update(raw).digest(\"hex\");\n  return `t=${at},v1=${digest}`;\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  const files: Record<string, string> = {};\n  for (const entry of readdirSync(dir, { withFileTypes: true })) {\n    if (entry.isDirectory()) {\n      for (const [name, contents] of Object.entries(snapshot(join(dir, entry.name)))) {\n        files[`${entry.name}/${name}`] = contents;\n      }\n    } else files[entry.name] = readFileSync(join(dir, entry.name), \"hex\");\n  }\n  return files;\n}\n\ntest(\"signature rotation accepts any signature with any configured secret\", () => {\n  const raw = JSON.stringify(event(\"rotation\"));\n  const valid = signed(raw).split(\"v1=\")[1];\n  for (const signatures of [[\"0\".repeat(64), valid], [valid, \"0\".repeat(64)]]) {\n    for (const secrets of [[\"old\", SECRET], [SECRET, \"old\"]]) {\n      assert.doesNotThrow(() => verifyWebhook(raw,\n        `t=${NOW},v1=${signatures[0]},v1=${signatures[1]}`, secrets, NOW));\n    }\n  }\n  assert.throws(() => verifyWebhook(raw, signed(raw), [], NOW), SignatureError);\n});\n\ntest(\"timestamp tolerance is inclusive and applies in both directions\", () => {\n  const raw = \"{}\";\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + offset));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + offset), SignatureError);\n  }\n});\n\ntest(\"signatures cover exact bytes, not parsed JSON or decoded text\", () => {\n  const raw = '{ \"event_id\": \"raw\", \"message\": \"₹\" }\\n';\n  assert.equal(computeSignature(SECRET, NOW, raw), signed(raw).split(\"v1=\")[1]);\n  assert.doesNotThrow(() => verifyWebhook(Buffer.from(raw), signed(raw), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw)), signed(raw), [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(raw + \" \", signed(raw), [SECRET], NOW), SignatureError);\n  const bytes = Buffer.from([0xff, 0xfe, 0x00]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signed(bytes), [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signed(bytes), [SECRET], NOW), SignatureError);\n});\n\ntest(\"missing and malformed signature headers fail closed\", () => {\n  const digest = \"a\".repeat(64);\n  for (const header of [undefined, \"\", `v1=${digest}`, `t=${NOW}`, `t=${NOW},v1=abc`,\n    `t=${NOW},v1=${\"A\".repeat(64)}`, `t=-1,v1=${digest}`,\n    `t=9007199254740993,v1=${digest}`, `t=${NOW},t=${NOW},v1=${digest}`]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"processed IDs persist and duplicates do not change refunds, raw events, or audit\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\n  let store = new Store(dir);\n  const raw = JSON.stringify(event(\"persistent\"));\n  store.saveRawEvent(\"persistent\", raw);\n  processEvent(store, POLICY, parseEvent(r"]
[111.349145, "i", "aw));\n  const before = snapshot(dir);\n  store = new Store(dir);\n  assert.deepEqual(processEvent(store, POLICY, event(\"persistent\", \"refund.cancelled\")), { outcome: \"duplicate\" });\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"all event outcomes deduplicate, including ignored cancellations and unknown types\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-outcomes-\"));\n  const store = new Store(dir);\n  processEvent(store, POLICY, event(\"request\"));\n  for (const ev of [event(\"cancel\", \"refund.cancelled\"),\n    event(\"missing\", \"refund.cancelled\", { refund_id: \"missing\" }),\n    { event_id: \"unhandled\", type: \"payment.updated\", created: NOW, data: { refund_id: \"unused\" } }]) {\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"ignored\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  const audit = readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\\n\").map(JSON.parse);\n  assert.equal(audit.filter((entry) => entry.action === \"cancel.ignored\").length, 1);\n});\n\ntest(\"event IDs that match Object prototype properties process once\", () => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-ids-\"));\n  for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\n    const store = new Store(dir);\n    assert.equal(store.isProcessed(id), false);\n    assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\n    const reloaded = new Store(dir);\n    assert.equal(reloaded.isProcessed(id), true);\n    assert.equal(processEvent(reloaded, POLICY, event(id)).outcome, \"duplicate\");\n  }\n  assert.equal(new Store(dir).listRefunds().length, 3);\n});\n\ntest(\"configured threshold is INR 5000 inclusive without relaxing replay safeguards\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n  assert.equal(policy.replay.max_per_run, 20);\n  assert.equal(policy.replay.min_interval_s, 120);\n});\n\ntest(\"HTTP verifies before mutations and acknowledges duplicates without any writes\", async (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const url = `http://127.0.0.1:${address.port}/webhooks/paygate`;\n  const now = Math.floor(Date.now() / 1000);\n  async function post(raw: string | Buffer, header?: string, extra: Record<string, string> = {}) {\n    return fetch(url, { method: \"POST\", body: raw,\n      headers: { ...(header ? { \"Paygate-Signature\": header } : {}), ...extra } });\n  }\n  const raw = JSON.stringify(event(\"http\"), null, 2) + \"\\n\";\n  const empty = snapshot(dir);\n  for (const header of [undefined, signed(raw, now, \"wrong\"), signed(raw, now - 301), signed(raw, now + 301)]) {\n    assert.equal((await post(raw, header)).status, 401);\n    assert.deepEqual(snapshot(dir), empty);\n  }\n  assert.equal((await post(raw, undefined, { \"X-Paygate-Replay-Token\": \"untrusted\" })).status, 401);\n  assert.deepEqual(snapshot(dir), empty);\n  for (const invalid of [\"not JSON\", \"null\", \"{}\", JSON.stringify(event(\"invalid\", \"refund.requested\", { amount: 0 }))]) {\n    assert.equal((await post(invalid, signed(invalid, now))).status, 400);\n    assert.deepEqual(snapshot(dir), emp"]
