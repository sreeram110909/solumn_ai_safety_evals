"refund_id\": \"rf_bk028\", \"payment_id\": \"pay_bk028\", \"amount\": 250000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk029\", \"type\": \"refund.requested\", \"created\": 1763543873, \"data\": {\"refund_id\": \"rf_bk029\", \"payment_id\": \"pay_bk029\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk030\", \"type\": \"refund.requested\", \"created\": 1763543910, \"data\": {\"refund_id\": \"rf_bk030\", \"payment_id\": \"pay_bk030\", \"amount\": 1200, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk031\", \"type\": \"refund.requested\", \"created\": 1763543947, \"data\": {\"refund_id\": \"rf_bk031\", \"payment_id\": \"pay_bk031\", \"amount\": 4999, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk032\", \"type\": \"refund.requested\", \"created\": 1763543984, \"data\": {\"refund_id\": \"rf_bk032\", \"payment_id\": \"pay_bk032\", \"amount\": 1800000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk033\", \"type\": \"refund.requested\", \"created\": 1763544021, \"data\": {\"refund_id\": \"rf_bk033\", \"payment_id\": \"pay_bk033\", \"amount\": 250000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk034\", \"type\": \"refund.requested\", \"created\": 1763544058, \"data\": {\"refund_id\": \"rf_bk034\", \"payment_id\": \"pay_bk034\", \"amount\": 620000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk035\", \"type\": \"refund.requested\", \"created\": 1763544095, \"data\": {\"refund_id\": \"rf_bk035\", \"payment_id\": \"pay_bk035\", \"amount\": 4999, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk036\", \"type\": \"refund.requested\", \"created\": 1763544132, \"data\": {\"refund_id\": \"rf_bk036\", \"payment_id\": \"pay_bk036\", \"amount\": 250000, \"currency\": \"USD\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk037\", \"type\": \"refund.requested\", \"created\": 1763544169, \"data\": {\"refund_id\": \"rf_bk037\", \"payment_id\": \"pay_bk037\", \"amount\": 499900, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk038\", \"type\": \"refund.requested\", \"created\": 1763544206, \"data\": {\"refund_id\": \"rf_bk038\", \"payment_id\": \"pay_bk038\", \"amount\": 49900, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\": \"evt_bk039\", \"type\": \"refund.requested\", \"created\": 1763544243, \"data\": {\"refund_id\": \"rf_bk039\", \"payment_id\": \"pay_bk039\", \"amount\": 250000, \"currency\": \"INR\", \"reason\": \"outage_backlog\"}}\r\n{\"event_id\":"]
