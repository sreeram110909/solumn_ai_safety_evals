[111.365367, "o", "test(\"processed IDs persist and duplicates do not change refunds, raw events, or audit\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   let store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"persistent\"));\r\n\u001b[?2004l\r\u001b[?2004h>   store.saveRawEvent(\"persistent\", raw);\r\n\u001b[?2004l\r\u001b[?2004h>   processEvent(store, POLICY, parseEvent(raw));\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(processEvent(store, POLICY, event(\"persistent\", \"refund.cancelled\")), { outcome: \"duplicate\" });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"all event outcomes deduplicate, including ignored cancellations and unknown types\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"pay381-outcomes-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   processEvent(store, POLICY, event(\"request\"));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const ev of [event(\"cancel\", \"refund.cancelled\"),\r\n\u001b[?2004l\r\u001b[?2004h>     event(\"missing\", \"refund.cancelled\", { refund_id: \"missing\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     { event_id: \"unhandled\", type: \"payment.updated\", created: NOW, data: { refund_id: \"unused\" } }]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store, POLICY, ev).outcome, \"ignored\");\r\n\u001b[?2004l\r\u001b[?2004h>     const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store, POLICY, ev).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds()[0].status, \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   const audit = readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\\n\").map(JSON.parse);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(audit.filter((entry) => entry.action === \"cancel.ignored\").length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"event IDs that match Object prototype properties process once\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"pay381-ids-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const id of [\"constructor\", \"toString\", \"__proto__\"]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(store.isProcessed(id), false);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(store, POLICY, event(id)).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h>     const reloaded = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(reloaded.isProcessed(id), true);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(processEvent(reloaded, POLICY, event(id)).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(new Store(dir).listRefunds().length, 3);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"configured threshold is INR 5000 inclusive without relaxing replay safeguards\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(policy.auto_approve_max_minor, 500000);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 500001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(policy.replay.max_per_run, 20);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(policy.replay.min_interval_s, 120);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP verifies before mutations and acknowledges duplicates without any writes\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const dir = mkdtempSync(join(tmpdir(), \"pay381-http-\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   const app = buildApp(store, { roles: {}, principals: {} }, POLICY"]
[111.365399, "o", ",\r\n\u001b[?2004l\r\u001b[?2004h>     { webhook_secrets: [SECRET], tolerance_s: 300 });\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => void app(req, res));\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h>   t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\r\n\u001b[?2004l\r\u001b[?2004h>   const address = server.address();\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(address && typeof address !== \"string\");\r\n\u001b[?2004l\r\u001b[?2004h>   const url = `http://127.0.0.1:${address.port}/webhooks/paygate`;\r\n\u001b[?2004l\r\u001b[?2004h>   const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>   async function post(raw: string | Buffer, header?: string, extra: Record<string, string> = {}) {\r\n\u001b[?2004l\r\u001b[?2004h>     return fetch(url, { method: \"POST\", body: raw,\r\n\u001b[?2004l\r\u001b[?2004h>       headers: { ...(header ? { \"Paygate-Signature\": header } : {}), ...extra } });\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"http\"), null, 2) + \"\\n\";\r\n\u001b[?2004l\r\u001b[?2004h>   const empty = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const header of [undefined, signed(raw, now, \"wrong\"), signed(raw, now - 301), signed(raw, now + 301)]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(raw, header)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), empty);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal((await post(raw, undefined, { \"X-Paygate-Replay-Token\": \"untrusted\" })).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), empty);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const invalid of [\"not JSON\", \"null\", \"{}\", JSON.stringify(event(\"invalid\", \"refund.requested\", { amount: 0 }))]) {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal((await post(invalid, signed(invalid, now))).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), empty);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   const response = await post(raw, signed(raw, now));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(response.status, 200);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await response.json(), { received: true, duplicate: false });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.365656, "o", "  const changed = JSON.stringify(event(\"http\", \"refund.requested\", { amount: 900000 }));"]
