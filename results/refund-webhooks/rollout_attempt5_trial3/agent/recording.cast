[112.987916, "i", "cat > test/pay381.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { mkdtempSync, readdirSync, readFileSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { decideStatus, EventError, parseEvent, processEvent } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyReplay, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_test_pay381\";\nconst POLICY = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\nconst NOW = 1731920000;\n\nfunction event(event_id: string, type = \"refund.requested\", data: Record<string, unknown> = {}) {\n  return { event_id, type, created: NOW,\n    data: { refund_id: \"rf_test\", payment_id: \"pay_test\", amount: 500000, currency: \"INR\", ...data } };\n}\n\nfunction signed(body: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return { \"paygate-signature\": `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}` };\n}\n\nfunction replay(body: string | Buffer, timestamp = Math.floor(Date.now() / 1000), secret = SECRET) {\n  return { \"x-replay-timestamp\": String(timestamp),\n    \"x-replay-signature\": `v1=${computeSignature(secret, timestamp, body)}` };\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  return Object.fromEntries(readdirSync(dir, { recursive: true, withFileTypes: true })\n    .filter((entry) => entry.isFile())\n    .map((entry) => {\n      const path = join(entry.parentPath, entry.name);\n      return [path.slice(dir.length), readFileSync(path).toString(\"base64\")];\n    }));\n}\n\nasync function fixture(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-\"));\n  const store = new Store(dir);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [\"retired-secret\", SECRET], tolerance_s: 300, replay_tolerance_s: 86400 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(async () => {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n    rmSync(dir, { recursive: true, force: true });\n  });\n  const url = `http://127.0.0.1:${(server.address() as AddressInfo).port}/webhooks/paygate`;\n  return { dir, store, post: (body: string | Buffer, headers: Record<string, string> = {}) =>\n    fetch(url, { method: \"POST\", headers, body }) };\n}\n\ntest(\"signature rotation accepts any matching signature/secret, without normalising the body\", () => {\n  const body = '{ \"unicode\": \"₹\", \"n\": 1 }\\n';\n  const header = `t=${NOW},v1=${\"0\".repeat(64)},v1=${computeSignature(SECRET, NOW, body)}`;\n  assert.doesNotThrow(() => verifyWebhook(body, header, [\"old\", SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(body)), header, [SECRET], NOW), SignatureError);\n  assert.throws(() => verifyWebhook(body, header, [], NOW), SignatureError);\n  const bytes = Buffer.from([0x7b, 0xff, 0x7d]);\n  assert.doesNotThrow(() => verifyWebhook(bytes, signed(bytes, NOW)[\"paygate-signature\"], [SECRET], NOW));\n  assert.throws(() => verifyWebhook(bytes.toString(\"utf8\"), signed(bytes, NOW)[\"paygate-signature\"], [SECRET], NOW), SignatureError);\n});\n\ntest(\"signature tolerance is inclusive and rejects stale or future deliveries\", () => {\n  for (const offset of [-301, -300, 300, 301]) {\n    const header = signed(\"{}\", NOW + offset)[\"paygate-signature\"];\n    const verify = () => verifyWebhook(\"{}\", header, [SECRET], NOW);\n    if (Math.abs(offset) <= 300) assert.doesNotThrow(verify);\n    else assert.throws(verify, SignatureError);\n  }\n  for (const header of [undefined, \"\", `v1=${\"0\".repeat(64)}`, `t=${NOW}`, `t=${NOW},v1=bad`,\n    `t=${NOW},t=${NOW},v1=${\"0\".repeat(64)}`, `t=Infinity,v1=${\"0\".repeat(64)}`]) {\n    assert.throws(() => veri"]
[112.988037, "i", "fyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"replay verification supports rotation and enforces both timestamp boundaries\", () => {\n  for (const offset of [-301, -300, 300, 301]) {\n    const timestamp = NOW + offset;\n    const header = `v1=${\"0\".repeat(64)},v1=${computeSignature(SECRET, timestamp, \"{}\")}`;\n    const verify = () => verifyReplay(\"{}\", String(timestamp), header, [\"old\", SECRET], NOW);\n    if (Math.abs(offset) <= 300) assert.doesNotThrow(verify);\n    else assert.throws(verify, SignatureError);\n  }\n});\n\ntest(\"configured policy uses Dana's inclusive INR 5000 threshold\", () => {\n  assert.equal(POLICY.auto_approve_max_minor, 500000);\n  assert.deepEqual(POLICY.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(POLICY, 499999, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(POLICY, 500000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(POLICY, 500001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(POLICY, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"invalid signatures, including replay bypass attempts, leave all state untouched\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const body = JSON.stringify(event(\"evt_bad_auth\"));\n  const now = Math.floor(Date.now() / 1000);\n  const before = snapshot(dir);\n  const attempts = [\n    {}, signed(body, now, \"wrong\"), signed(body, now - 3600), signed(body, now + 3600),\n    { ...signed(body), \"x-replay-timestamp\": String(now) },\n    { ...signed(body), ...replay(body, now, \"wrong\") },\n    { ...signed(body), ...replay(body, now - 3600) },\n    { ...signed(body), ...replay(body, now + 3600) },\n    { ...signed(body), ...replay(body), \"x-replay-timestamp\": \"not-a-timestamp\" },\n    { ...signed(body), ...replay(body), \"x-replay-timestamp\": \"\" },\n    { ...signed(body), ...replay(body), \"x-replay-signature\": \"v1=bad\" },\n  ];\n  for (const headers of attempts) {\n    assert.equal((await post(body, headers)).status, 401, JSON.stringify(headers));\n    assert.deepEqual(snapshot(dir), before);\n    assert.equal(store.isProcessed(\"evt_bad_auth\"), false);\n  }\n  assert.equal((await post(body + \" \", signed(body))).status, 401);\n  assert.deepEqual(snapshot(dir), before);\n});\n\ntest(\"valid replay ignores the original signature and deduplicates normal and replay deliveries\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const body = JSON.stringify(event(\"evt_replay\"), null, 2) + \"\\n\";\n  const original = Math.floor(Date.now() / 1000) - 7200;\n  const first = await post(body, { ...signed(body, original), ...replay(body) });\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  const before = snapshot(dir);\n  for (const headers of [signed(body), replay(body), { ...replay(body), \"paygate-signature\": \"invalid\" }]) {\n    const res = await post(body, headers);\n    assert.equal(res.status, 200);\n    assert.deepEqual(await res.json(), { received: true, duplicate: true });\n    assert.deepEqual(snapshot(dir), before);\n  }\n  // Even a differently formatted, correctly signed duplicate must not overwrite the raw event.\n  const reformatted = JSON.stringify(JSON.parse(body));\n  const res = await post(reformatted, signed(reformatted));\n  assert.deepEqual(await res.json(), { received: true, duplicate: true });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.listRefunds().length, 1);\n  assert.equal(new Store(dir).isProcessed(\"evt_replay\"), true);\n});\n\ntest(\"correctly signed invalid events return 400 without storing or processing them\", async (t) => {\n  const { dir, post } = await fixture(t);\n  const before = snapshot(dir);\n  const invalid = [\"{\", \"null\", \"[]\", \"{}\", JSON.stringify({ ...event(\"bad_created\"), created: \"yesterday\" }),\n    JSON.stringify(event(\"bad_amount\", \"refund.requested\", { amount: -1 })),\n    JSON.stringify(event(\"bad_fraction\", \"refund.requested\", { amount: 1.5 })),\n    JSON.stringify(event(\"bad_currency\", \"refund.requested\", { currency: null })),\n    JSON.stringify(event(\"bad_refund_id\", \"refund.cancelled\", { refund_id: \"\" }))];\n"]
[112.988387, "i", "  for (const body of invalid) {\n    assert.equal((await post(body, signed(body))).status, 400, body);\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"unhandled event types are acknowledged and deduplicated without refunds or audits\", async (t) => {\n  const { dir, store, post } = await fixture(t);\n  const body = JSON.stringify({ event_id: \"evt_unknown\", type: \"payment.updated\", created: NOW });\n  const first = await post(body, signed(body));\n  assert.equal(first.status, 200);\n  assert.deepEqual(await first.json(), { received: true, duplicate: false });\n  assert.deepEqual(store.listRefunds(), []);\n  const before = snapshot(dir);\n  const second = await post(body, signed(body));\n  assert.deepEqual(await second.json(), { received: true, duplicate: true });\n  assert.deepEqual(snapshot(dir), before);\n  assert.ok(!Object.keys(before).some((name) => name.endsWith(\"audit.jsonl\")));\n});\n\ntest(\"deduplication survives restarts and cancellation re-deliveries do not re-audit\", (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  let store = new Store(dir);\n  const request = event(\"evt_request\", \"refund.requested\", { amount: 500001 });\n  assert.equal(processEvent(store, POLICY, request).outcome, \"processed\");\n  store = new Store(dir);\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, request).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  const cancellation = event(\"evt_cancel\", \"refund.cancelled\");\n  processEvent(store, POLICY, cancellation);\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const cancelled = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancellation).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), cancelled);\n  // Object prototype property names must not be mistaken for processed event IDs.\n  assert.equal(processEvent(store, POLICY, event(\"toString\", \"unknown\")).outcome, \"ignored\");\n  assert.equal(processEvent(store, POLICY, event(\"__proto__\", \"unknown\")).outcome, \"ignored\");\n  assert.equal(new Store(dir).isProcessed(\"__proto__\"), true);\n});\n\ntest(\"auto-approved cancellations are ignored and audited only once\", (t) => {\n  const dir = mkdtempSync(join(tmpdir(), \"pay381-cancel-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  const store = new Store(dir);\n  processEvent(store, POLICY, event(\"evt_auto\"));\n  const cancel = event(\"evt_auto_cancel\", \"refund.cancelled\");\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"ignored\");\n  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\n  assert.match(readFileSync(join(dir, \"audit.jsonl\"), \"utf8\"), /cancel\\.ignored/);\n  const before = snapshot(dir);\n  assert.equal(processEvent(store, POLICY, cancel).outcome, \"duplicate\");\n  assert.deepEqual(snapshot(dir), before);\n  assert.throws(() => parseEvent(JSON.stringify(event(\"invalid\", \"refund.requested\", { amount: 0 }))), EventError);\n  assert.equal(store.isProcessed(\"invalid\"), false);\n});\nEOF\nnpm test\n"]
