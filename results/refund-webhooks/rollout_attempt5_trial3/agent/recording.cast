[144.743365, "o", "  const cancelled = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.743455, "o", "  assert.equal(processEvent(store, POLICY, cancellation).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h"]
