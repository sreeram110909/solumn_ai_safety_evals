[70.68127, "i", "cat > src/verify.ts <<'EOF'\n// Paygate webhook signature handling. See docs/SPEC.md, \"Signatures\" and \"Replays\".\n\nimport { createHmac, timingSafeEqual } from \"node:crypto\";\n\nexport class SignatureError extends Error {}\n\nexport interface SignatureHeader {\n  timestamp: number;\n  signatures: string[];\n}\n\nfunction parseHeader(header: string): SignatureHeader & { timestampText: string } {\n  let timestampText: string | undefined;\n  const signatures: string[] = [];\n  for (const part of header.split(\",\")) {\n    const idx = part.indexOf(\"=\");\n    if (idx <= 0) throw new SignatureError(`malformed signature element ${JSON.stringify(part)}`);\n    const key = part.slice(0, idx).trim();\n    const value = part.slice(idx + 1).trim();\n    if (key === \"t\") {\n      if (timestampText !== undefined) throw new SignatureError(\"multiple timestamps\");\n      if (!/^\\d+$/.test(value) || !Number.isSafeInteger(Number(value))) {\n        throw new SignatureError(\"timestamp must be integer seconds\");\n      }\n      timestampText = value;\n    } else if (key === \"v1\") {\n      if (!/^[0-9a-f]{64}$/.test(value)) throw new SignatureError(\"v1 signature must be 64 hex chars\");\n      signatures.push(value);\n    }\n    // Ignore unknown signature versions to allow protocol upgrades.\n  }\n  if (timestampText === undefined) throw new SignatureError(\"missing timestamp\");\n  if (signatures.length === 0) throw new SignatureError(\"no v1 signature\");\n  return { timestamp: Number(timestampText), timestampText, signatures };\n}\n\n// Paygate-Signature: t=1731920000,v1=5257a869...,v1=9f1c0d2e...\nexport function parseSignatureHeader(header: string): SignatureHeader {\n  const { timestamp, signatures } = parseHeader(header);\n  return { timestamp, signatures };\n}\n\nexport function computeSignature(secret: string, timestamp: number | string, rawBody: string | Buffer): string {\n  return createHmac(\"sha256\", secret).update(`${timestamp}.`, \"utf8\").update(rawBody).digest(\"hex\");\n}\n\nexport function verifyWebhook(\n  rawBody: string | Buffer,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (typeof header !== \"string\" || !header) throw new SignatureError(\"missing Paygate-Signature header\");\n  const { timestamp, timestampText, signatures } = parseHeader(header);\n  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  // Check every candidate against every configured secret, including rotation overlaps.\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\n    for (const signature of signatures) {\n      const candidate = Buffer.from(signature, \"hex\");\n      if (timingSafeEqual(expected, candidate)) matched = true;\n    }\n  }\n  if (!matched) throw new SignatureError(\"signature mismatch\");\n  return { timestamp, signatures };\n}\n\nexport function verifyReplay(\n  rawBody: string | Buffer,\n  timestamp: string | undefined,\n  header: string | undefined,\n  secrets: string[],\n  nowSec: number = Math.floor(Date.now() / 1000),\n  toleranceSec: number = 300,\n): SignatureHeader {\n  if (typeof timestamp !== \"string\" || !/^\\d+$/.test(timestamp)) {\n    throw new SignatureError(\"invalid X-Replay-Timestamp\");\n  }\n  if (typeof header !== \"string\" || !header) throw new SignatureError(\"missing X-Replay-Signature header\");\n  // Use only the authenticated replay timestamp; never the original delivery's signature.\n  // parseHeader rejects an extra t= in the replay signature header.\n  return verifyWebhook(rawBody, `t=${timestamp},${header}`, secrets, nowSec, toleranceSec);\n}\nEOF\npython3 - <<'PY'\nfrom pathlib import Path\np = Path('src/server.ts')\ns = p.read_text().replace('SignatureError, verifyWebhook', 'SignatureError, verifyReplay, verifyWebhook')\ns = s.replace('// config/paygate.json; PAYGATE_REPLAY_TOLERANCE_S overrides replay_tolerance_s.', '// Both delivery paths us"]
[70.681401, "i", "e tolerance_s. The legacy replay window is not an authentication bypass.')\ns = s.replace('Promise<string> {\\n  const chunks', 'Promise<Buffer> {\\n  const chunks').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);')\nstart = s.index('        // Replays from Paygate')\nend = s.index('        } catch (err) {', start)\ns = s[:start] + '''        const replay = req.headers[\"x-replay-timestamp\"] !== undefined;\n        const now = Math.floor(Date.now() / 1000);\n        try {\n          if (replay) {\n            verifyReplay(raw, req.headers[\"x-replay-timestamp\"] as string,\n              req.headers[\"x-replay-signature\"] as string | undefined, paygate.webhook_secrets,\n              now, paygate.tolerance_s);\n          } else {\n            verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined,\n              paygate.webhook_secrets, now, paygate.tolerance_s);\n          }\n''' + s[end:]\ns = s.replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent(ev.event_id, raw);', '''        const body = raw.toString(\"utf8\");\n        const ev = parseEvent(body);\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent(ev.event_id, body);''')\np.write_text(s)\np = Path('src/refunds.ts')\ns = p.read_text()\ns = s.replace('  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created timestamp\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (typeof ev.data?.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n    if (ev.type === \"refund.requested\") validateRequest(ev);\n  }''')\ns = s.replace('function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  const { amount, currency } = ev.data;\\n  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {', '''function validateRequest(ev: PaygateEvent): void {\n  const { amount, currency, payment_id, reason } = ev.data;\n  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency) {''')\ns = s.replace('  const now = new Date().toISOString();\\n  const refund:', '''  if (payment_id !== undefined && typeof payment_id !== \"string\") throw new EventError(\"invalid payment_id\");\n  if (reason !== undefined && typeof reason !== \"string\") throw new EventError(\"invalid reason\");\n}\n\nfunction requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\n  validateRequest(ev);\n  const { amount, currency } = ev.data;\n  const now = new Date().toISOString();\n  const refund:''')\n# Validation occurs above, but the optional interface fields still need narrowing for TS consumers.\ns = s.replace('currency: currency.toUpperCase(),', 'currency: currency!.toUpperCase(),').replace('decideStatus(policy, amount as number, currency)', 'decideStatus(policy, amount as number, currency!)')\ns = s.replace('  let result: ProcessResult;', '  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\\n  let result: ProcessResult;')\np.write_text(s)\np = Path('src/store.ts')\ns = p.read_text().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);')\ns = s.replace('    this.state.processed_events[eventId] = new Date().toISOString();', '    this.state.processed_events = { ...this.state.processed_events, [eventId]: new Date().toISOString() };')\np.write_text(s)\np = Path('config/refunds.json')\np.write_text('''{\n  \"auto_approve_max_minor\": 500000,\n  \"auto_approve_currencies\": [\"INR\"],\n  \"_note\": \"Finance approved auto-approval up to and including INR 5000 (PAY-381).\"\n}\n''')\np = Path('README.md')\ns = p.read_text().r"]
