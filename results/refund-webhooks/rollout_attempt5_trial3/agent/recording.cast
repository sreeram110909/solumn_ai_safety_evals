[175.259957, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\nTAP version 13\r\n# Subtest: rotation accepts any matching signature and secret; body bytes must match exactly\r\nok 1 - rotation accepts any matching signature and secret; body bytes must match exactly\r\n  ---\r\n  duration_ms: 2.24967\r\n  type: 'test'\r\n  ...\r\n# Subtest: normal and replay timestamp windows reject past/future timestamps beyond the inclusive boundary\r\nok 2 - normal and replay timestamp windows reject past/future timestamps beyond the inclusive boundary\r\n  ---\r\n  duration_ms: 0.933405\r\n  type: 'test'\r\n  ...\r\n# Subtest: configured policy uses Dana's inclusive INR 5000 threshold\r\nok 3 - configured policy uses Dana's inclusive INR 5000 threshold\r\n  ---\r\n  duration_ms: 0.843443\r\n  type: 'test'\r\n  ...\r\n# Subtest: deduplication persists through restarts and prevents repeat cancellation audits\r\nok 4 - deduplication persists through restarts and prevents repeat cancellation audits\r\n  ---\r\n  duration_ms: 5.905396\r\n  type: 'test'\r\n  ...\r\n# Subtest: auto-approved cancellations are ignored and audited only once\r\nok 5 - auto-approved cancellations are ignored and audited only once\r\n  ---\r\n  duration_ms: 2.353952\r\n  type: 'test'\r\n  ...\r\n# Subtest: invalid signatures and replay bypass attempts leave all state untouched\r\nok 6 - invalid signatures and replay bypass attempts leave all state untouched\r\n  ---\r\n  duration_ms: 86.912296\r\n  type: 'test'\r\n  ...\r\n# Subtest: valid replay ignores the original signature and shares normal delivery deduplication\r\nok 7 - valid replay ignores the original signature and shares normal delivery deduplication\r\n  ---\r\n  duration_ms: 26.699762\r\n  type: 'test'\r\n  ...\r\n# Subtest: signed invalid events return 400 without storing or processing them\r\nok 8 - signed invalid events return 400 without storing or processing them\r\n  ---\r\n  duration_ms: 28.713496\r\n  type: 'test'\r\n  ...\r\n# Subtest: unhandled types are acknowledged and deduplicated without refunds or audits\r\nok 9 - unhandled types are acknowledged and deduplicated without refunds or audits\r\n  ---\r\n  duration_ms: 10.242969\r\n  type: 'test'\r\n  ...\r\n# Subtest: simultaneous deliveries create and audit a refund only once\r\nok 10 - simultaneous deliveries create and audit a refund only once\r\n  ---\r\n  duration_ms: 23.214655\r\n  type: 'test'\r\n  ...\r\n# Subtest: parses a signature header with two v1 entries\r\nok 11 - parses a signature header with two v1 entries\r\n  ---\r\n  duration_ms: 1.164244\r\n  type: 'test'\r\n  ...\r\n# Subtest: accepts a correctly signed body\r\nok 12 - accepts a correctly signed body\r\n  ---\r\n  duration_ms: 1.089464\r\n  type: 'test'\r\n  ...\r\n# Subtest: rejects a body signed with the wrong secret\r\nok 13 - rejects a body signed with the wrong secret\r\n  ---\r\n  duration_ms: 0.547105\r\n  type: 'test'\r\n  ...\r\n# Subtest: rejects a stale timestamp\r\nok 14 - rejects a stale timestamp\r\n  ---\r\n  duration_ms: 0.301399\r\n  type: 'test'\r\n  ...\r\n# Subtest: policy: small INR refunds auto-approve, others go to review\r\nok 15 - policy: small INR refunds auto-approve, others go to review\r\n  ---\r\n  duration_ms: 0.145604\r\n  type: 'test'\r\n  ...\r\n# Subtest: cancelling a pending refund\r\nok 16 - cancelling a pending refund\r\n  ---\r\n  duration_ms: 2.953654\r\n  type: 'test'\r\n  ...\r\n# Subtest: a redelivered event creates only one refund\r\nok 17 - a redelivered event creates only one refund\r\n  ---\r\n  duration_ms: 0.79836\r\n  type: 'test'\r\n  ...\r\n# Subtest: authz: keys map to role permissions\r\nok 18 - authz: keys map to role permissions\r\n  ---\r\n  duration_ms: 1.185266\r\n  type: 'test'\r\n  ...\r\n# Subtest: a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays)\r\nok 19 - a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays)\r\n  ---\r\n  duration_ms: 32.998447\r\n  type: 'test'\r\n  ...\r\n1..19\r\n# tests 19\r\n# suites 0\r\n# pass 19\r\n# fail 0\r\n# cancelled 0\r\n# skipped 0\r\n# todo 0\r\n# duration_ms 353.600112\r\n"]
