[144.744179, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"auto-approved cancellations are ignored and audited only once\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
