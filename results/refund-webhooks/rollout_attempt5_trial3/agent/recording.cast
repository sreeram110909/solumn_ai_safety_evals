[162.997195, "o", "\u001b[1G"]
[162.997312, "o", "\u001b[0K"]
[163.247327, "o", "\u001b[32m✔ rotation accepts any matching signature and secret; body bytes must match exactly \u001b[90m(1.890637ms)\u001b[39m\u001b[39m\r\n"]
[163.247718, "o", "\u001b[32m✔ normal and replay timestamp windows reject past/future timestamps beyond the inclusive boundary \u001b[90m(0.954113ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ configured policy uses Dana's inclusive INR 5000 threshold \u001b[90m(0.84113ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ deduplication persists through restarts and prevents repeat cancellation audits \u001b[90m(41.070271ms)\u001b[39m\u001b[39m\r\n"]
[163.248538, "o", "\u001b[32m✔ auto-approved cancellations are ignored and audited only once \u001b[90m(3.540797ms)\u001b[39m\u001b[39m\r\n"]
[163.29872, "o", "\u001b[32m✔ invalid signatures and replay bypass attempts leave all state untouched \u001b[90m(64.046982ms)\u001b[39m\u001b[39m\r\n"]
[163.327513, "o", "\u001b[32m✔ valid replay ignores the original signature and shares normal delivery deduplication \u001b[90m(30.328516ms)\u001b[39m\u001b[39m\r\n"]
[163.345899, "o", "\u001b[32m✔ signed invalid events return 400 without storing or processing them \u001b[90m(19.638919ms)\u001b[39m\u001b[39m\r\n"]
[163.356232, "o", "\u001b[32m✔ unhandled types are acknowledged and deduplicated without refunds or audits \u001b[90m(8.593111ms)\u001b[39m\u001b[39m\r\n"]
[163.370393, "o", "\u001b[32m✔ simultaneous deliveries create and audit a refund only once \u001b[90m(17.383614ms)\u001b[39m\u001b[39m\r\n"]
[163.382869, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(0.972179ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.83322ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.441352ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.293553ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.13433ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.522533ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.657707ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.041694ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a Paygate replay of an older delivery is accepted once (docs/SPEC.md, Replays) \u001b[90m(32.811563ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 346.201696\u001b[39m\r\n"]
