[144.742134, "o", "test(\"deduplication persists through restarts and prevents repeat cancellation audits\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.74217, "o", "  const dir = mkdtempSync(join(tmpdir(), \"pay381-store-\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.742324, "o", "  t.after(() => rmSync(dir, { recursive: true, force: true }));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.742353, "o", "  let store = new Store(dir);\r\n\u001b[?2004l\r"]
[144.742385, "o", "\u001b[?2004h> "]
[144.742514, "o", "  const request = event(\"evt_request\", \"refund.requested\", { amount: 500001 });\r\n\u001b[?2004l\r\u001b[?2004h"]
[144.742695, "o", "> "]
[144.742791, "o", "  assert.equal(processEvent(store, POLICY, request).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h>   store = new Store(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.742822, "o", "  const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.74294, "o", "  assert.equal(processEvent(store, POLICY, request).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[144.743039, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
