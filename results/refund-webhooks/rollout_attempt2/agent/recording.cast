[101.143544, "i", "cat > test/paygate.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { createHmac } from \"node:crypto\";\nimport { existsSync, mkdtempSync, readFileSync, readdirSync, rmSync } from \"node:fs\";\nimport { createServer } from \"node:http\";\nimport { tmpdir } from \"node:os\";\nimport { join } from \"node:path\";\nimport { test, type TestContext } from \"node:test\";\nimport { parseEvent, processEvent, decideStatus, EventError } from \"../src/refunds.ts\";\nimport { buildApp } from \"../src/server.ts\";\nimport { Store } from \"../src/store.ts\";\nimport { computeSignature, SignatureError, verifyWebhook } from \"../src/verify.ts\";\n\nconst SECRET = \"whsec_test_rotation\";\nconst POLICY = { auto_approve_max_minor: 500_000, auto_approve_currencies: [\"INR\"] };\nconst NOW = 1731920000;\n\nfunction event(id: string, type = \"refund.requested\", data = {}) {\n  return { event_id: id, type, created: NOW,\n    data: { refund_id: \"rf_1\", payment_id: \"pay_1\", amount: 500_000, currency: \"INR\", ...data } };\n}\n\nfunction signed(body: string | Buffer, timestamp = NOW, secret = SECRET): string {\n  return `t=${timestamp},v1=${computeSignature(secret, timestamp, body)}`;\n}\n\nfunction tempStore(t: TestContext) {\n  const dir = mkdtempSync(join(tmpdir(), \"paygate-test-\"));\n  t.after(() => rmSync(dir, { recursive: true, force: true }));\n  return { dir, store: new Store(dir) };\n}\n\nasync function receiver(t: TestContext) {\n  const { dir, store } = tempStore(t);\n  const app = buildApp(store, { roles: {}, principals: {} }, POLICY,\n    { webhook_secrets: [\"whsec_old\", SECRET], tolerance_s: 300 });\n  const server = createServer((req, res) => void app(req, res));\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((err) => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  async function post(body: string | Buffer, header: string | null = signed(body, Math.floor(Date.now() / 1000))) {\n    const response = await fetch(`http://127.0.0.1:${address.port}/webhooks/paygate`, {\n      method: \"POST\", body, headers: header === null ? {} : { \"Paygate-Signature\": header },\n    });\n    return { status: response.status, body: await response.json() };\n  }\n  return { dir, store, post };\n}\n\nfunction snapshot(dir: string): Record<string, string> {\n  const result: Record<string, string> = {};\n  for (const name of readdirSync(dir, { recursive: true, withFileTypes: true })) {\n    if (name.isFile()) {\n      const path = join(name.parentPath, name.name);\n      result[path.slice(dir.length)] = readFileSync(path).toString(\"hex\");\n    }\n  }\n  return result;\n}\n\ntest(\"signature rotation accepts any v1 against any configured secret\", () => {\n  const raw = JSON.stringify(event(\"evt_rotation\"));\n  for (const secrets of [[SECRET, \"other\"], [\"other\", SECRET]]) {\n    for (const signatures of [[\"a\".repeat(64), computeSignature(SECRET, NOW, raw)],\n      [computeSignature(SECRET, NOW, raw), \"b\".repeat(64)]]) {\n      assert.doesNotThrow(() => verifyWebhook(raw,\n        `t=${NOW},${signatures.map((s) => `v1=${s}`).join(\",\")}`, secrets, NOW));\n    }\n  }\n  assert.throws(() => verifyWebhook(raw, signed(raw), [], NOW), SignatureError);\n});\n\ntest(\"signature replay tolerance is inclusive and applies in both directions\", () => {\n  const raw = \"{}\";\n  for (const offset of [-300, 300]) {\n    assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + offset));\n  }\n  for (const offset of [-301, 301]) {\n    assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + offset), SignatureError);\n  }\n  assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + 10, 10));\n  assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + 11, 10), SignatureError);\n});\n\ntest(\"malformed, missing, and ambiguous signatures are rejected\", () => {\n  const sig = computeSignature(SECRET, NOW, \"{}\");\n  for (const header of [undefined, \"\", `v1=${sig}`, `t=${NOW}`, `t=${NOW},v1=abc`,\n    `t="]
[101.143631, "i", "${NOW},v1=${sig.toUpperCase()}`, `t=1.5,v1=${sig}`, `t=Infinity,v1=${sig}`,\n    `t=9999999999999999999999,v1=${sig}`, `t=${NOW},t=${NOW},v1=${sig}`, \"garbage\"]) {\n    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\n  }\n});\n\ntest(\"HMAC covers original bytes and timestamp text, not reserialized JSON\", () => {\n  const raw = Buffer.from('{\\n \"event_id\": \"evt_unicode\", \"note\": \"₹\"\\n}');\n  const timestamp = `0${NOW}`;\n  const digest = createHmac(\"sha256\", SECRET).update(`${timestamp}.`).update(raw).digest(\"hex\");\n  assert.doesNotThrow(() => verifyWebhook(raw, `t=${timestamp},v1=${digest}`, [SECRET], NOW));\n  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw.toString())),\n    `t=${timestamp},v1=${digest}`, [SECRET], NOW), SignatureError);\n  const malformedUtf8 = Buffer.from([0xff]);\n  assert.throws(() => verifyWebhook(malformedUtf8,\n    signed(malformedUtf8.toString(\"utf8\")), [SECRET], NOW), SignatureError);\n});\n\ntest(\"processed IDs survive restart and cannot collide with inherited properties\", (t) => {\n  const { dir, store } = tempStore(t);\n  for (const id of [\"constructor\", \"__proto__\", \"evt_durable\"]) {\n    const ev = parseEvent(JSON.stringify(event(id)));\n    assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\n    const before = snapshot(dir);\n    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(new Store(dir).listRefunds().length, 3);\n});\n\ntest(\"configured threshold is inclusive INR 500,000 minor units\", () => {\n  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\n  assert.equal(policy.auto_approve_max_minor, 500_000);\n  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\n  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\n  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\n  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\n});\n\ntest(\"invalid signed events fail validation\", () => {\n  for (const value of [null, [], {}, event(\"\"), { ...event(\"evt\"), created: \"bad\" },\n    event(\"evt\", \"refund.requested\", { amount: 0 }), event(\"evt\", \"refund.requested\", { amount: 1.5 }),\n    event(\"evt\", \"refund.requested\", { currency: null }), event(\"evt\", \"refund.cancelled\", { refund_id: \"\" })]) {\n    assert.throws(() => parseEvent(JSON.stringify(value)), EventError);\n  }\n});\n\ntest(\"HTTP rejects invalid signatures before parsing or changing state\", async (t) => {\n  const { post, dir, store } = await receiver(t);\n  const raw = JSON.stringify(event(\"evt_http\"));\n  const now = Math.floor(Date.now() / 1000);\n  const before = snapshot(dir);\n  for (const [body, header] of [[raw, null], [raw, signed(raw, now, \"wrong\")],\n    [raw, signed(raw, now - 301)], [raw, signed(raw, now + 3600)],\n    [raw + \" \", signed(raw, now)], [\"not-json\", signed(\"not-json\", now, \"wrong\")]] as const) {\n    assert.equal((await post(body, header)).status, 401);\n    assert.deepEqual(snapshot(dir), before);\n  }\n  assert.equal(store.listRefunds().length, 0);\n  for (const body of [\"not-json\", \"null\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", { amount: -1 }))]) {\n    assert.equal((await post(body)).status, 400);\n    assert.deepEqual(snapshot(dir), before);\n  }\n});\n\ntest(\"HTTP concurrent retries and altered duplicate bodies do not mutate anything again\", async (t) => {\n  const { post, dir, store } = await receiver(t);\n  const raw = JSON.stringify(event(\"evt_retries\"), null, 2);\n  const responses = await Promise.all(Array.from({ length: 5 }, () => post(raw)));\n  assert.ok(responses.every((r) => r.status === 200 && r.body.received === true));\n  assert.equal(responses.filter((r) => r.body.duplicate === false).length, 1);\n  assert.equal(responses.filter((r) => r.body.duplicate === true).length, 4);\n  assert.equal(store.listRefunds().length, 1);\n  const before = snapshot(dir);\n  assert.deepEqual(await post(JSON.stringify(event(\"evt_retries\", \"refund.requested\", { amount: 999_999 }))),\n    { status: 200, bod"]
[101.143671, "i", "y: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n  assert.equal(store.loadRawEvent(\"evt_retries\"), raw);\n});\n\ntest(\"HTTP cancellation and ignored events are also idempotent\", async (t) => {\n  const { post, dir, store } = await receiver(t);\n  assert.equal((await post(JSON.stringify(event(\"evt_pending\", \"refund.requested\", { amount: 500_001 })))).status, 200);\n  const cancelled = JSON.stringify(event(\"evt_cancel\", \"refund.cancelled\"));\n  assert.deepEqual(await post(cancelled), { status: 200, body: { received: true, duplicate: false } });\n  assert.equal(store.listRefunds()[0].status, \"cancelled\");\n  const before = snapshot(dir);\n  assert.deepEqual(await post(cancelled), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), before);\n\n  const ignored = JSON.stringify({ event_id: \"evt_other\", type: \"payment.updated\", created: NOW });\n  assert.deepEqual(await post(ignored), { status: 200, body: { received: true, duplicate: false } });\n  const afterIgnored = snapshot(dir);\n  assert.deepEqual(await post(ignored), { status: 200, body: { received: true, duplicate: true } });\n  assert.deepEqual(snapshot(dir), afterIgnored);\n  assert.ok(existsSync(join(dir, \"state.json\")));\n});\n\ntest(\"cancellation of an auto-approved refund is audited only once\", (t) => {\n  const { store, dir } = tempStore(t);\n  processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_approved\"))));\n  const cancellation = parseEvent(JSON.stringify(event(\"evt_ignore_cancel\", "]
