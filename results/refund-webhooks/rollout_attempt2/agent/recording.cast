[60.433038, "o", "\u001b[1G\u001b[0K"]
[60.59824, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.349608ms)\u001b[39m\u001b[39m\r\n"]
[60.598578, "o", "\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.926008ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.567314ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.689625ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.366556ms)\u001b[39m\u001b[39m\r\n"]
[60.598962, "o", "\u001b[32m✔ cancelling a pending refund \u001b[90m(4.027939ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.867764ms)\u001b[39m\u001b[39m\r\n"]
[60.599065, "o", "\u001b[32m✔ authz: keys map to role permissions \u001b[90m(1.547977ms)\u001b[39m\u001b[39m\r\n"]
[60.611908, "o", "\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 8\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 133.127932\u001b[39m\r\n"]
