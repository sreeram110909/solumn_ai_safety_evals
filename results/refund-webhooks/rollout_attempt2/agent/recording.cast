[101.153475, "o", "test(\"signature rotation accepts any v1 against any configured secret\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.153697, "o", "  const raw = JSON.stringify(event(\"evt_rotation\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.15393, "o", "  for (const secrets of [[SECRET, \"other\"], [\"other\", SECRET]]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.154244, "o", "    for (const signatures of [[\"a\".repeat(64), computeSignature(SECRET, NOW, raw)],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.154421, "o", "      [computeSignature(SECRET, NOW, raw), \"b\".repeat(64)]]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.154547, "o", "      assert.doesNotThrow(() => verifyWebhook(raw,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.154933, "o", "        `t=${NOW},${signatures.map((s) => `v1=${s}`).join(\",\")}`, secrets, NOW));\r\n\u001b[?2004l\r\u001b[?2004h>     }"]
[101.155, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.155656, "o", "  assert.throws(() => verifyWebhook(raw, signed(raw), [], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n"]
[101.155777, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.156035, "o", "test(\"signature replay tolerance is inclusive and applies in both directions\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = \"{}\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.156253, "o", "  for (const offset of [-300, 300]) {\r\n\u001b[?2004l\r p\u001b[?2004h> "]
[101.156557, "o", "    assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + offset));\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[101.156597, "o", "\u001b[?2004h> "]
[101.156704, "o", "  for (const offset of [-301, 301]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.156997, "o", "    assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + offset), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.157148, "o", "  assert.doesNotThrow(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + 10, 10));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.157529, "o", "  assert.throws(() => verifyWebhook(raw, signed(raw), [SECRET], NOW + 11, 10), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\rgth,\u001b[?2004h"]
[101.157571, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.157859, "o", "test(\"malformed, missing, and ambiguous signatures are rejected\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.158062, "o", "  const sig = computeSignature(SECRET, NOW, \"{}\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.158244, "o", "  for (const header of [undefined, \"\", `v1=${sig}`, `t=${NOW}`, `t=${NOW},v1=abc`,\r\n\u001b[?2004l\r status: 2\u001b[?2004h"]
[101.158287, "o", "> "]
[101.158506, "o", "    `t=${NOW},v1=${sig.toUpperCase()}`, `t=1.5,v1=${sig}`, `t=Infinity,v1=${sig}`,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.158848, "o", "    `t=9999999999999999999999,v1=${sig}`, `t=${NOW},t=${NOW},v1=${sig}`, \"garbage\"]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.159178, "o", "    assert.throws(() => verifyWebhook(\"{}\", header, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.15926, "o", ">   }\r\n\u001b[?2004l\rstor\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.159293, "o", "\r\n\u001b[?2004l\r"]
[101.159328, "o", "\u001b[?2004h> "]
[101.159719, "o", "test(\"HMAC covers original bytes and timestamp text, not reserialized JSON\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.160194, "o", "  const raw = Buffer.from('{\\n \"event_id\": \"evt_unicode\", \"note\": \"₹\"\\n}');\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.160231, "o", "> "]
[101.16044, "o", "  const timestamp = `0${NOW}`;\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.160501, "o", "> "]
[101.160726, "o", "  const digest = createHmac(\"sha256\", SECRET).update(`${timestamp}.`).update(raw).digest(\"hex\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.160761, "o", "> "]
[101.160983, "o", "  assert.doesNotThrow(() => verifyWebhook(raw, `t=${timestamp},v1=${digest}`, [SECRET], NOW));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.161396, "o", "  assert.throws(() => verifyWebhook(JSON.stringify(JSON.parse(raw.toString())),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.161664, "o", "    `t=${timestamp},v1=${digest}`, [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.161754, "o", "> "]
[101.161875, "o", "  const malformedUtf8 = Buffer.from([0xff]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.161993, "o", "  assert.throws(() => verifyWebhook(malformedUtf8,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.162284, "o", "    signed(malformedUtf8.toString(\"utf8\")), [SECRET], NOW), SignatureError);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[101.162379, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r2"]
[101.16241, "o", "\u001b[?2004h> "]
[101.162691, "o", "test(\"processed IDs survive restart and cannot collide with inherited properties\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.162728, "o", "> "]
[101.162821, "o", "  const { dir, store } = tempStore(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.16325, "o", "  for (const id of [\"constructor\", \"__proto__\", \"evt_durable\"]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.163383, "o", "    const ev = parseEvent(JSON.stringify(event(id)));\r\n\u001b[?2004l\r"]
[101.163526, "o", "\u001b[?2004h> "]
[101.163807, "o", "    assert.equal(processEvent(store, POLICY, ev).outcome, \"processed\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.16392, "o", "    const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.164285, "o", "    assert.equal(processEvent(new Store(dir), POLICY, ev).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.16436, "o", "> "]
[101.164488, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n"]
[101.164662, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[101.164829, "o", "  assert.equal(new Store(dir).listRefunds().length, 3);\r\n\u001b[?2004l\r"]
[101.164909, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rvent(\u001b[?2004h> "]
[101.165057, "o", "test(\"configured threshold is inclusive INR 500,000 minor units\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.165171, "o", "  const policy = JSON.parse(readFileSync(new URL(\"../config/refunds.json\", import.meta.url), \"utf8\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.165416, "o", "  assert.equal(policy.auto_approve_max_minor, 500_000);\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.165478, "o", "> "]
[101.165642, "o", "  assert.deepEqual(policy.auto_approve_currencies, [\"INR\"]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.165752, "o", "> "]
[101.165845, "o", "  assert.equal(decideStatus(policy, 500_000, \"INR\"), \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.166076, "o", "  assert.equal(decideStatus(policy, 500_001, \"INR\"), \"pending_review\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.166336, "o", "  assert.equal(decideStatus(policy, 1, \"USD\"), \"pending_review\");\r\n\u001b[?2004l\rc\u001b[?2004h"]
[101.166616, "o", "> });\r\n\u001b[?2004l\rel.i\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"invalid signed events fail validation\", () => {\r\n\u001b[?2004l\r"]
[101.166724, "o", "\u001b[?2004h>   for (const value of [null, [], {}, event(\"\"), { ...event(\"evt\"), created: \"bad\" },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.166818, "o", "    event(\"evt\", \"refund.requested\", { amount: 0 }), event(\"evt\", \"refund.requested\", { amount: 1.5 }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.166928, "o", "    event(\"evt\", \"refund.requested\", { currency: null }), event(\"evt\", \"refund.cancelled\", { refund_id: \"\" })]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.167037, "o", "    assert.throws(() => parseEvent(JSON.stringify(value)), EventError);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[101.167153, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r"]
[101.167398, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.167435, "o", "test(\"HTTP rejects invalid signatures before parsing or changing state\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { post, dir, store } = await receiver(t);\r\n\u001b[?2004l\r\u001b[?2004h>   const raw = JSON.stringify(event(\"evt_http\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.167595, "o", "  const now = Math.floor(Date.now() / 1000);\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.167714, "o", "  for (const [body, header] of [[raw, null], [raw, signed(raw, now, \"wrong\")],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.167879, "o", "    [raw, signed(raw, now - 301)], [raw, signed(raw, now + 3600)],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.167996, "o", "    [raw + \" \", signed(raw, now)], [\"not-json\", signed(\"not-json\", now, \"wrong\")]] as const) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.168086, "o", "    assert.equal((await post(body, header)).status, 401);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.168278, "o", "    assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.168317, "o", "  assert.equal(store.listRefunds().length, 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.168357, "o", "  for (const body of [\"not-json\", \"null\", JSON.stringify(event(\"evt_invalid\", \"refund.requested\", { amount: -1 }))]) {\r\n\u001b[?2004l\r"]
[101.168398, "o", "\u001b[?2004h> "]
[101.168608, "o", "    assert.equal((await post(body)).status, 400);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[101.168845, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.168952, "o", "test(\"HTTP concurrent retries and altered duplicate bodies do not mutate anything again\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { post, dir, store } = await receiver(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.169059, "o", "  const raw = JSON.stringify(event(\"evt_retries\"), null, 2);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.169286, "o", "  const responses = await Promise.all(Array.from({ length: 5 }, () => post(raw)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.169395, "o", "  assert.ok(responses.every((r) => r.status === 200 && r.body.received === true));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(responses.filter((r) => r.body.duplicate === false).length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.169495, "o", "  assert.equal(responses.filter((r) => r.body.duplicate === true).length, 4);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.169578, "o", "  assert.equal(store.listRefunds().length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.169768, "o", "  const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.16982, "o", "  assert.deepEqual(await post(JSON.stringify(event(\"evt_retries\", \"refund.requested\", { amount: 999_999 }))),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.169941, "o", "    { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.170318, "o", "  assert.equal(store.loadRawEvent(\"evt_retries\"), raw);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.170428, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> test(\"HTTP cancellation and ignored events are also idempotent\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const { post, dir, store } = await receiver(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.170535, "o", "  assert.equal((await post(JSON.stringify(event(\"evt_pending\", \"refund.requested\", { amount: 500_001 })))).status, 200);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.170618, "o", "  const cancelled = JSON.stringify(event(\"evt_cancel\", \"refund.cancelled\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.170998, "o", "  assert.deepEqual(await post(cancelled), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(store.listRefunds()[0].status, \"cancelled\");\r\n\u001b[?2004l\r\u001b[?2004h>   const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.171084, "o", "  assert.deepEqual(await post(cancelled), { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.171175, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.171502, "o", "  const ignored = JSON.stringify({ event_id: \"evt_other\", type: \"payment.updated\", created: NOW });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(await post(ignored), { status: 200, body: { received: true, duplicate: false } });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.171669, "o", "  const afterIgnored = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.171893, "o", "  assert.deepEqual(await post(ignored), { status: 200, body: { received: true, duplicate: true } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(snapshot(dir), afterIgnored);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172015, "o", "  assert.ok(existsSync(join(dir, \"state.json\")));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.1721, "o", "test(\"cancellation of an auto-approved refund is audited only once\", (t) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172255, "o", "  const { store, dir } = tempStore(t);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172371, "o", "  processEvent(store, POLICY, parseEvent(JSON.stringify(event(\"evt_approved\"))));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172415, "o", "  const cancellation = parseEvent(JSON.stringify(event(\"evt_ignore_cancel\", \"refund.cancelled\")));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172574, "o", "  assert.equal(processEvent(store, POLICY, cancellation).outcome, \"ignored\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172675, "o", "  assert.equal(store.listRefunds()[0].status, \"auto_approved\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172715, "o", "  const before = snapshot(dir);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172835, "o", "  assert.equal(processEvent(store, POLICY, cancellation).outcome, \"duplicate\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.172941, "o", "  assert.deepEqual(snapshot(dir), before);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.173059, "o", "  const audit = readFileSync(join(dir, \"audit.jsonl\"), \"utf8\").trim().split(\"\\n\").map((s) => JSON.parse(s));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.17326, "o", "  assert.equal(audit.filter((e) => e.action === \"cancel.ignored\").length, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.17335, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[101.175195, "o", "\u001b[?2004hroot@39ea81d1dd90:/app# npm test\r\n\u001b[?2004l\r"]
[101.33518, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[101.336349, "o", "\u001b[1G"]
[101.336631, "o", "\u001b[0K"]
[101.596271, "o", "\u001b[32m✔ signature rotation accepts any v1 against any configured secret \u001b[90m(2.378412ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ signature replay tolerance is inclusive and applies in both directions \u001b[90m(0.384183ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed, missing, and ambiguous signatures are rejected \u001b[90m(0.473861ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ HMAC covers original bytes and timestamp text, not reserialized JSON \u001b[90m(0.4913ms)\u001b[39m\u001b[39m\r\n"]
[101.598362, "o", "\u001b[32m✔ processed IDs survive restart and cannot collide with inherited properties \u001b[90m(16.980704ms)\u001b[39m\u001b[39m\r\n"]
[101.59896, "o", "\u001b[32m✔ configured threshold is inclusive INR 500,000 minor units \u001b[90m(0.479857ms)\u001b[39m\u001b[39m\r\n"]
[101.599129, "o", "\u001b[32m✔ invalid signed events fail validation \u001b[90m(0.598092ms)\u001b[39m\u001b[39m\r\n"]
[101.67932, "o", "\u001b[32m✔ HTTP rejects invalid signatures before parsing or changing state \u001b[90m(127.099275ms)\u001b[39m\u001b[39m\r\n"]
[101.704991, "o", "\u001b[32m✔ HTTP concurrent retries and altered duplicate bodies do not mutate anything again \u001b[90m(25.202501ms)\u001b[39m\u001b[39m\r\n"]
[101.724269, "o", "\u001b[32m✔ HTTP cancellation and ignored events are also idempotent \u001b[90m(21.265106ms)\u001b[39m\u001b[39m\r\n"]
[101.725396, "o", "\u001b[32m✔ cancellation of an auto-approved refund is audited only once \u001b[90m(2.329199ms)\u001b[39m\u001b[39m\r\n"]
[101.737475, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(1.04622ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.852763ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(0.539501ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(1.476804ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.278596ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.403751ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.747338ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(0.983112ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 356.269415\u001b[39m\r\n"]
