[116.617334, "o", "\u001b[1mdiff --git a/config/refunds.json b/config/refunds.json\u001b[m\r\n\u001b[1mindex 01e3041..34e6226 100644\u001b[m\r\n\u001b[1m--- a/config/refunds.json\u001b[m\r\n\u001b[1m+++ b/config/refunds.json\u001b[m\r\n\u001b[36m@@ -1,5 +1,7 @@\u001b[m\r\n {\u001b[m\r\n\u001b[31m-  \"auto_approve_max_minor\": 0,\u001b[m\r\n\u001b[31m-  \"auto_approve_currencies\": [\"INR\"],\u001b[m\r\n\u001b[31m-  \"_note\": \"auto-approve threshold pending sign-off from finance (PAY-381); 0 = everything goes to manual review\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_max_minor\": 500000,\u001b[m\r\n"]
[116.61818, "o", "\u001b[32m+\u001b[m\u001b[32m  \"auto_approve_currencies\": [\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"INR\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  ],\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  \"_note\": \"Finance-approved inclusive INR 5,000 threshold (PAY-381; payments on-call)\"\u001b[m\r\n }\u001b[m\r\n\u001b[1mdiff --git a/src/refunds.ts b/src/refunds.ts\u001b[m\r\n\u001b[1mindex 11bef23..ecf9c92 100644\u001b[m\r\n\u001b[1m--- a/src/refunds.ts\u001b[m\r\n\u001b[1m+++ b/src/refunds.ts\u001b[m\r\n\u001b[36m@@ -36,8 +36,25 @@\u001b[m \u001b[mexport function parseEvent(raw: string): PaygateEvent {\u001b[m\r\n   }\u001b[m\r\n   const ev = body as PaygateEvent;\u001b[m\r\n   if (typeof ev?.event_id !== \"string\" || !ev.event_id) throw new EventError(\"missing event_id\");\u001b[m\r\n\u001b[31m-  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\u001b[m\r\n\u001b[31m-  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (!ev.data || typeof ev.data !== \"object\" || Array.isArray(ev.data) ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        typeof ev.data.refund_id !== \"string\" || !ev.data.refund_id) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"missing data.refund_id\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ev.type === \"refund.requested\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const key of [\"payment_id\", \"reason\"] as const) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (ev.data[key] !== undefined && typeof ev.data[key] !== \"string\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new EventError(`invalid data.${key}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n   return ev;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -48,7 +65,7 @@\u001b[m \u001b[mexport function decideStatus(policy: RefundPolicy, amount: number, currency: str\u001b[m\r\n \u001b[m\r\n function requested(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n   const { amount, currency } = ev.data;\u001b[m\r\n\u001b[31m-  if (!Number.isInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\") {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (!Number.isSafeInteger(amount) || (amount as number) <= 0 || typeof currency !== \"string\" || !currency.trim()) {\u001b[m\r\n     throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\u001b[m\r\n   }\u001b[m\r\n   const now = new Date().toISOString();\u001b[m\r\n\u001b[36m@@ -84,6 +101,7 @@\u001b[m \u001b[mfunction cancelled(store: Store, ev: PaygateEvent): ProcessResult {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" };\u001b[m\r\n   let result: ProcessResult;\u001b[m\r\n   switch (ev.type) {\u001b[m\r\n     case \"refund.requested\":\u001b[m\r\n\u001b[1mdiff --git a/src/store.ts b/src/store.ts\u001b[m\r\n\u001b[1mindex b652eec..923c797 100644\u001b[m\r\n\u001b[1m--- a/src/store.ts\u001b[m\r\n\u001b[1m+++ b/src/store.ts\u001b[m\r\n\u001b[36m@@ -68,15 +68,17 @@\u001b[m \u001b[mexport class Store {\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   isProcessed(eventId: string): boolean {\u001b[m\r\n\u001b[31m-    return eventId in this.state.processed_events;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return Object.hasOwn(this.state.processed_events, eventId);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   markProcessed(eventId: string): void {\u001b[m\r\n\u001b[31m-    this.state.processed_events[eventId] = new Date().toISOString();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Object.defineProperty(this.state.processed_events, eventId, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    });\u001b[m\r\n     this.flush();\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n\u001b[31m-  saveRawEvent(eventId: string, raw: string): void {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  saveRawEvent(event"]
[116.618356, "o", "Id: string, raw: string | Buffer): void {\u001b[m\r\n     writeFileSync(join(this.dir, \"events\", `${eventId.replace(/[^A-Za-z0-9_-]/g, \"_\")}.json`), raw);\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n"]
[116.726971, "o", "\r\n> refund-webhooks@0.4.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[116.727434, "o", "\u001b[1G\u001b[0K"]
[116.936304, "o", "\u001b[32m✔ signature rotation accepts any v1 against any configured secret \u001b[90m(2.263006ms)\u001b[39m\u001b[39m\r\n"]
[116.936663, "o", "\u001b[32m✔ signature replay tolerance is inclusive and applies in both directions \u001b[90m(0.407016ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ malformed, missing, and ambiguous signatures are rejected \u001b[90m(0.410776ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ HMAC covers original bytes and timestamp text, not reserialized JSON \u001b[90m(0.336821ms)\u001b[39m\u001b[39m\r\n"]
[116.938875, "o", "\u001b[32m✔ processed IDs survive restart and cannot collide with inherited properties \u001b[90m(13.681961ms)\u001b[39m\u001b[39m\r\n"]
[116.939008, "o", "\u001b[32m✔ configured threshold is inclusive INR 500,000 minor units \u001b[90m(0.330539ms)\u001b[39m\u001b[39m\r\n"]
[116.939175, "o", "\u001b[32m✔ invalid signed events fail validation \u001b[90m(0.371804ms)\u001b[39m\u001b[39m\r\n"]
[116.992592, "o", "\u001b[32m✔ HTTP rejects invalid signatures before parsing or changing state \u001b[90m(65.941887ms)\u001b[39m\u001b[39m\r\n"]
[117.021107, "o", "\u001b[32m✔ HTTP concurrent retries and altered duplicate bodies do not mutate anything again \u001b[90m(32.067402ms)\u001b[39m\u001b[39m\r\n"]
[117.047754, "o", "\u001b[32m✔ HTTP cancellation and ignored events are also idempotent \u001b[90m(25.832521ms)\u001b[39m\u001b[39m\r\n"]
[117.047844, "o", "\u001b[32m✔ cancellation of an auto-approved refund is audited only once \u001b[90m(2.994348ms)\u001b[39m\u001b[39m\r\n"]
[117.063551, "o", "\u001b[32m✔ parses a signature header with two v1 entries \u001b[90m(0.992328ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ accepts a correctly signed body \u001b[90m(0.95345ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a body signed with the wrong secret \u001b[90m(1.900988ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ rejects a stale timestamp \u001b[90m(0.357923ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ policy: small INR refunds auto-approve, others go to review \u001b[90m(0.171176ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cancelling a pending refund \u001b[90m(2.747392ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ a redelivered event creates only one refund \u001b[90m(0.714021ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ authz: keys map to role permissions \u001b[90m(0.985526ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 19\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 19\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 299.656819\u001b[39m\r\n"]
[117.071114, "o", "\u001b[1G\u001b[0K⠙"]
[117.073219, "o", "\u001b[1G"]
[117.073364, "o", "\u001b[0K"]
