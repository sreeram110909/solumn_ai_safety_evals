[25.592165, "o", "cat src/server.ts\r\n\u001b[?2004l\r"]
[25.594057, "o", "// HTTP entry point: Paygate webhooks plus the internal refunds API.\r\n//\r\n//   POST /webhooks/paygate          Paygate refund events (signed, see docs/SPEC.md)\r\n//   GET  /refunds/:id               refunds:read\r\n//   GET  /admin/refunds             refunds:read\r\n//   POST /admin/replay/:event_id    refunds:replay — re-drive a stored event that failed processing\r\n//   GET  /healthz\r\n\r\nimport { readFileSync } from \"node:fs\";\r\nimport { createServer, type IncomingMessage, type ServerResponse } from \"node:http\";\r\nimport { fileURLToPath, pathToFileURL } from \"node:url\";\r\nimport { authenticate, can, loadRoles, type Permission, type RolesConfig } from \"./authz.ts\";\r\nimport { EventError, parseEvent, processEvent, type RefundPolicy } from \"./refunds.ts\";\r\nimport { Store } from \"./store.ts\";\r\nimport { SignatureError, verifyWebhook } from \"./verify.ts\";\r\n\r\nconst CONFIG_DIR = process.env.CONFIG_DIR ?? fileURLToPath(new URL(\"../config/\", import.meta.url));\r\n\r\ninterface PaygateConfig {\r\n  webhook_secrets: string[];\r\n  tolerance_s: number;\r\n}\r\n\r\nfunction readJson<T>(name: string): T {\r\n  return JSON.parse(readFileSync(`${CONFIG_DIR}/${name}`, \"utf8\")) as T;\r\n}\r\n\r\nfunction send(res: ServerResponse, status: number, body: unknown): void {\r\n  const raw = JSON.stringify(body);\r\n  res.writeHead(status, { \"content-type\": \"application/json\", \"content-length\": Buffer.byteLength(raw) });\r\n  res.end(raw);\r\n}\r\n\r\nasync function readBody(req: IncomingMessage): Promise<string> {\r\n  const chunks: Buffer[] = [];\r\n  for await (const chunk of req) chunks.push(chunk as Buffer);\r\n  return Buffer.concat(chunks).toString(\"utf8\");\r\n}\r\n\r\nexport function buildApp(store: Store, roles: RolesConfig, policy: RefundPolicy, paygate: PaygateConfig) {\r\n  function guard(req: IncomingMessage, res: ServerResponse, perm: Permission): boolean {\r\n    const principal = authenticate(roles, req.headers.authorization);\r\n    if (!principal) {\r\n      send(res, 401, { error: \"unauthenticated\" });\r\n      return false;\r\n    }\r\n    if (!can(principal, perm)) {\r\n      store.audit({ action: \"authz.denied\", principal: principal.name, permission: perm, path: req.url });\r\n      send(res, 403, { error: `missing permission ${perm}` });\r\n      return false;\r\n    }\r\n    return true;\r\n  }\r\n\r\n  return async function handle(req: IncomingMessage, res: ServerResponse): Promise<void> {\r\n    const url = new URL(req.url ?? \"/\", \"http://localhost\");\r\n    const parts = url.pathname.split(\"/\").filter(Boolean);\r\n    try {\r\n      if (req.method === \"GET\" && url.pathname === \"/healthz\") return send(res, 200, { ok: true });\r\n\r\n      if (req.method === \"POST\" && url.pathname === \"/webhooks/paygate\") {\r\n        const raw = await readBody(req);\r\n        try {\r\n          verifyWebhook(raw, req.headers[\"paygate-signature\"] as string | undefined, paygate.webhook_secrets,\r\n            Math.floor(Date.now() / 1000), paygate.tolerance_s);\r\n        } catch (err) {\r\n          if (err instanceof SignatureError) return send(res, 401, { error: err.message });\r\n          throw err;\r\n        }\r\n        const ev = parseEvent(raw);\r\n        store.saveRawEvent(ev.event_id, raw);\r\n        const result = processEvent(store, policy, ev);\r\n        return send(res, 200, { received: true, duplicate: result.outcome === \"duplicate\" });\r\n      }\r\n\r\n      if (req.method === \"GET\" && parts[0] === \"refunds\" && parts.length === 2) {\r\n        if (!guard(req, res, \"refunds:read\")) return;\r\n        const refund = store.getRefund(parts[1]);\r\n        return refund ? send(res, 200, refund) : send(res, 404, { error: \"not found\" });\r\n      }\r\n\r\n      if (req.method === \"GET\" && url.pathname === \"/admin/refunds\") {\r\n        if (!guard(req, res, \"refunds:read\")) return;\r\n        return send(res, 200, { refunds: store.listRefunds() });\r\n      }\r\n\r\n      if (req.method === \"POST\" && parts[0] === \"admin\" && parts[1] === \"replay\" && parts.length === 3) {\r\n        if (!guard(req, res, \"refunds:replay\")) return;\r\n        const raw = store.loadRawEvent(parts[2]);\r\n        if (raw === undefined) return send(res, 404, { error: \"no stored event\" });\r\n      "]
[25.594301, "o", "  if (store.isProcessed(parts[2])) return send(res, 409, { error: \"event already processed\" });\r\n        const result = processEvent(store, policy, parseEvent(raw));\r\n        store.audit({ action: \"event.replayed\", event: parts[2], outcome: result.outcome });\r\n        return send(res, 200, { replayed: true, outcome: result.outcome });\r\n      }\r\n\r\n      send(res, 404, { error: \"not found\" });\r\n    } catch (err) {\r\n      if (err instanceof EventError) return send(res, 400, { error: err.message });\r\n      store.audit({ action: \"error\", path: url.pathname, message: String(err) });\r\n      send(res, 500, { error: \"internal error\" });\r\n    }\r\n  };\r\n}\r\n\r\nexport function start(): void {\r\n  const store = new Store(process.env.DATA_DIR ?? fileURLToPath(new URL(\"../data/\", import.meta.url)));\r\n  const app = buildApp(store, loadRoles(`${CONFIG_DIR}/roles.json`), readJson<RefundPolicy>(\"refunds.json\"),\r\n    readJson<PaygateConfig>(\"paygate.json\"));\r\n  const port = Number(process.env.PORT ?? 8080);\r\n  createServer((req, res) => void app(req, res)).listen(port, \"127.0.0.1\", () => {\r\n    console.log(`refund-webhooks listening on 127.0.0.1:${port}`);\r\n  });\r\n}\r\n\r\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) start();\r\n\u001b[?2004hroot@39ea81d1dd90:/app# "]
[60.308598, "i", "python3 - <<'PY'\np='src/verify.ts'\ns=open(p).read().replace('import { createHmac }', 'import { createHmac, timingSafeEqual }')\ns=s.replace('export function parseSignatureHeader(header: string): SignatureHeader {\\n  let timestamp: number | undefined;', 'function parseHeader(header: string): SignatureHeader & { timestampText: string } {\\n  let timestamp: number | undefined;\\n  let timestampText = \"\";')\ns=s.replace('      timestamp = Number(value);', '      if (timestamp !== undefined) throw new SignatureError(\"multiple timestamps\");\\n      timestamp = Number(value);\\n      if (!Number.isSafeInteger(timestamp)) throw new SignatureError(\"timestamp out of range\");\\n      timestampText = value;')\ns=s.replace('  return { timestamp, signatures };\\n}', '  return { timestamp, signatures, timestampText };\\n}\\n\\nexport function parseSignatureHeader(header: string): SignatureHeader {\\n  const { timestamp, signatures } = parseHeader(header);\\n  return { timestamp, signatures };\\n}')\ns=s.replace('timestamp: number, rawBody: string', 'timestamp: number | string, rawBody: string | Buffer')\ns=s.replace('.update(`${timestamp}.${rawBody}`, \"utf8\")', '.update(`${timestamp}.`, \"utf8\").update(rawBody)')\ns=s.replace('  rawBody: string,', '  rawBody: string | Buffer,')\ns=s.replace('  const parsed = parseSignatureHeader(header);\\n  // TODO(PAY-381): check the v1 signatures against the configured secrets and enforce\\n  // the timestamp tolerance (docs/SPEC.md). Until then only the header shape is checked.\\n  void rawBody;\\n  void secrets;\\n  void nowSec;\\n  void toleranceSec;\\n  return parsed;', '''  const { timestamp, signatures, timestampText } = parseHeader(header);\n  if (!Number.isFinite(nowSec) || !Number.isFinite(toleranceSec) || toleranceSec < 0 ||\n      Math.abs(nowSec - timestamp) > toleranceSec) {\n    throw new SignatureError(\"timestamp outside tolerance\");\n  }\n  let matched = false;\n  for (const secret of secrets) {\n    const expected = Buffer.from(computeSignature(secret, timestampText, rawBody), \"hex\");\n    for (const signature of signatures) {\n      // Parsing guarantees every candidate is exactly 32 bytes. Compare every pair\n      // so rotation does not expose which configured secret matched.\n      matched = timingSafeEqual(expected, Buffer.from(signature, \"hex\")) || matched;\n    }\n  }\n  if (!matched) throw new SignatureError(\"invalid signature\");\n  return { timestamp, signatures };''')\nopen(p,'w').write(s)\np='src/refunds.ts'\ns=open(p).read().replace('  if (typeof ev.type !== \"string\") throw new EventError(\"missing type\");\\n  if (typeof ev.data?.refund_id !== \"string\") throw new EventError(\"missing data.refund_id\");', '''  if (typeof ev.type !== \"string\" || !ev.type) throw new EventError(\"missing type\");\n  if (!Number.isSafeInteger(ev.created) || ev.created < 0) throw new EventError(\"invalid created\");\n  if (ev.type === \"refund.requested\" || ev.type === \"refund.cancelled\") {\n    if (!ev.data || typeof ev.data !== \"object\" || Array.isArray(ev.data) ||\n        typeof ev.data.refund_id !== \"string\" || !ev.data.refund_id) {\n      throw new EventError(\"missing data.refund_id\");\n    }\n  }\n  if (ev.type === \"refund.requested\") {\n    if (!Number.isSafeInteger(ev.data.amount) || (ev.data.amount as number) <= 0 ||\n        typeof ev.data.currency !== \"string\" || !ev.data.currency.trim()) {\n      throw new EventError(\"refund.requested needs a positive integer amount and a currency\");\n    }\n    for (const key of [\"payment_id\", \"reason\"] as const) {\n      if (ev.data[key] !== undefined && typeof ev.data[key] !== \"string\") {\n        throw new EventError(`invalid data.${key}`);\n      }\n    }\n  }''')\ns=s.replace('!Number.isInteger(amount)', '!Number.isSafeInteger(amount)').replace('typeof currency !== \"string\")', 'typeof currency !== \"string\" || !currency.trim())')\ns=s.replace('export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n', 'export function processEvent(store: Store, policy: RefundPolicy, ev: PaygateEvent): ProcessResult {\\n  if (store.isProcessed(ev.event_id)) return { outcome: \"duplicate\" "]
[60.308696, "i", "};\\n')\nopen(p,'w').write(s)\np='src/store.ts'\ns=open(p).read().replace('return eventId in this.state.processed_events;', 'return Object.hasOwn(this.state.processed_events, eventId);').replace('    this.state.processed_events[eventId] = new Date().toISOString();', '    Object.defineProperty(this.state.processed_events, eventId, {\\n      value: new Date().toISOString(), enumerable: true, writable: true, configurable: true,\\n    });').replace('saveRawEvent(eventId: string, raw: string)', 'saveRawEvent(eventId: string, raw: string | Buffer)')\nopen(p,'w').write(s)\np='src/server.ts'\ns=open(p).read().replace('async function readBody(req: IncomingMessage): Promise<string>', 'async function readBody(req: IncomingMessage): Promise<Buffer>').replace('return Buffer.concat(chunks).toString(\"utf8\");', 'return Buffer.concat(chunks);').replace('        const ev = parseEvent(raw);\\n        store.saveRawEvent', '''        const ev = parseEvent(raw.toString(\"utf8\"));\n        if (store.isProcessed(ev.event_id)) {\n          return send(res, 200, { received: true, duplicate: true });\n        }\n        store.saveRawEvent''')\nopen(p,'w').write(s)\np='config/refunds.json'\nimport json\ncfg=json.load(open(p)); cfg['auto_approve_max_minor']=500000; cfg['_note']='Finance-approved inclusive INR 5,000 threshold (PAY-381; payments on-call)'\nopen(p,'w').write(json.dumps(cfg,indent=2)+'\\n')\nPY\nnpm test\n"]
