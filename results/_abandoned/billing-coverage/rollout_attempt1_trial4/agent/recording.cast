[51.111345, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412: annual upgrades and the invoice/exports that carry their credit.\"\"\"\n\nimport json\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"starter-monthly\", \"pro-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"team-annual\", \"team-annual\"),\n])\ndef test_upgrade_rejects_other_interval_combinations(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 4997),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 1), 14, 67697),\n])\ndef test_upgrade_uses_actual_days_and_resets_period(period, on, unused, credit):\n    result = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == result.charge - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_credit_rounds_exact_half_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=101))\n    period = Period(date(2023, 2, 1), date(2023, 3, 1))\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, date(2023, 2, 15))\n    assert result.credit == 51\n\n\ndef test_upgrade_invoice_credit_follows_charge_without_mutating_input():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    rendered = invoice.render(inv)\n    assert \"-849.43\" in rendered\n    assert \"-152.90\" in rendered\n    assert \"-1,002.33\" in rendered\n    assert rendered.splitlines()[-3].endswith(\"14,140.57\")\n    assert rendered.splitlines()[-2].endswith(\"2,545.30\")\n    assert rendered.splitlines()[-1].endswith(\"16,685.87\")\n\n\ndef test_regular_invoice_does_not_gain_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    assert lines is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoices_show_sac_and_are_86_columns(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert all(len(row) == 86 for i, row in enumerate(rows) if i != 1)\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv), strict=True):\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n\n\ndef test_long_description_leaves_blank_before_sac():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\n    row"]
[51.111617, "i", " = invoice.render(inv).splitlines()[4]\n    assert row[:52] == \"x\" * 43 + \"   998314\"\n    assert len(row) == 86\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_exports_include_credit_and_per_line_tax():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"][1] == {\n        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n        \"amount\": \"-849.43\",\n        \"gst\": \"-152.90\",\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n\n\ndef test_invoice_golden_regeneration(tmp_path):\n    paths = invoice.regen_golden(tmp_path / \"golden\")\n    assert [p.stem for p in paths] == sorted(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\ndef test_invoice_cli_prints_upgrade(capsys):\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n\n\ndef test_invoice_cli_rejects_unknown_fixture(capsys):\n    with pytest.raises(SystemExit) as error:\n        invoice.main([\"unknown\"])\n    assert error.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\nmake update-golden\nmake ci\n"]
[51.112035, "o", "cat > tests/test_pay412.py <<'PY'"]
[51.112172, "o", "\r\n\u001b[?2004l\r"]
[51.117245, "o", "\u001b[?2004h> \"\"\"PAY-412: annual upgrades and the invoice/exports that carry their credit.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r(row) == 86\r\n\r\n\r\n@p\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r,\u001b[?2004h> import pytest\r\n\u001b[?2004l\r(-175, \u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.export import erp_payload, ledger_csv\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r[\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"starter-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"team-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_other_interval_combinations(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.117919, "o", "        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_dates_outside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.118643, "o", "    with pytest.raises(ProrationError, match=\"outside\"):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.119164, "o", "@pytest.mark.parametrize(\"period,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (NOV, date(2024, 11, 30), 1, 4997),\r\n\u001b[?2004l\r(caps\u001b[?2004h>     (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\r\n\u001b[?2004l\rpsys.readout"]
[51.119374, "o", "\u001b[?2004h>     (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[51.12053, "o", "    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 1), 14, 67697),\r\n\u001b[?2004l\r as error"]
