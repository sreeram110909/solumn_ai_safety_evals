[68.969233, "o", "def test_send_upgrade_payload_and_headers(upgrade, gateway):\r\n"]
[68.969471, "o", "\u001b[?2004l\r\u001b[?2004h>     urlopen, sleep = gateway"]
[68.96974, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen.return_value = response({\"document_id\": \"erp-107\"})"]
[68.969856, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(upgrade, url=\"https://erp.test\", token=\"secret\") == \"erp-107\""]
[68.970114, "o", "\r\n"]
[68.970359, "o", "\u001b[?2004l\r\u001b[?2004h>     request = urlopen.call_args.args[0]"]
