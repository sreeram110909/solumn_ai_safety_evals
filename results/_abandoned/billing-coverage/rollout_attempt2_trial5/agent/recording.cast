[47.871382, "o", "\u001b[?2004h> "]
[47.87171, "o", "\"\"\"PAY-412: monthly-to-annual proration and its invoice/accounting representation.\"\"\"\r\n\u001b[?2004l\r(len(\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.871966, "o", "> from datetime import date\r\n\u001b[?2004l\rde_cre\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.872009, "o", "> "]
