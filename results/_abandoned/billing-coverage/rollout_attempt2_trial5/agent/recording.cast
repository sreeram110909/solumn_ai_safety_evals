[47.87355, "o", "    (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\"\u001b[?2004h> "]
[47.87367, "o", "    (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.873789, "o", "    (\"team-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.873934, "o", "])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.874851, "o", "def test_only_monthly_to_annual_is_allowed(old, new):\r\n\u001b[?2004l\r\u001b[?2004h"]
