[79.920933, "o", "\u001b[32m+\u001b[m\u001b[32m        out.append(f\"{line.description[:43]:<44}{SAC_CODE:>8}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n"]
