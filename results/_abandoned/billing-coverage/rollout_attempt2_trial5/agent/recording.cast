[47.870616, "i", "cat > tests/test_annual_upgrade.py <<'PY'\n\"\"\"PAY-412: monthly-to-annual proration and its invoice/accounting representation.\"\"\"\n\nimport json\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period\nfrom billing.plans import CATALOGUE, get_plan\nfrom billing.proration import ProrationError, describe, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"team-annual\", \"team-annual\"),\n])\ndef test_only_monthly_to_annual_is_allowed(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_date_must_be_inside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 16), 16, 77368),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 74950),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 15), 15, 77534),\n    (date(2024, 10, 20), date(2024, 11, 20), date(2024, 11, 14), 6, 29013),\n])\ndef test_credit_uses_actual_days_and_preserves_result_metadata(start, end, on, unused, credit):\n    period = Period(start, end)\n    r = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert r.old_plan == get_plan(\"pro-monthly\")\n    assert r.new_plan == get_plan(\"team-annual\")\n    assert r.period == period and r.on == on\n    assert r.unused_days == unused\n    assert (r.credit, r.charge, r.net) == (credit, 4999000, 4999000 - credit)\n    assert r.new_period == Period(on, date(on.year + 1, on.month, on.day))\n\n\ndef test_upgrade_credit_rounds_exact_half_paisa_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=149901))\n    r = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert r.credit == 74951\n\n\ndef test_upgrade_on_leap_day_and_across_plan_tiers():\n    period = Period(date(2024, 2, 1), date(2024, 3, 1))\n    r = prorate_to_annual(\"team-monthly\", \"pro-annual\", period, date(2024, 2, 29))\n    assert r.unused_days == 1 and r.credit == 17238\n    assert r.charge == 1499000\n    assert r.new_period == Period(date(2024, 2, 29), date(2025, 2, 28))\n    assert describe(r) == (\n        \"Team (monthly) -> Pro (annual) on 2024-02-29: \"\n        \"credit 17238, charge 1499000, net 1481762\"\n    )\n\n\ndef test_invoice_credit_is_after_charge_and_does_not_mutate_input():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    plain = replace(inv, proration=None)\n    assert invoice.invoice_lines(plain) == original\n    assert invoice.invoice_lines(plain) is not plain.lines\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoices_have_sac_and_86_character_columns(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == rows[-4] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv), strict=True):\n        gst = line_gst(amount)\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        asse"]
[47.87067, "i", "rt row[64:75] == f\"{invoice.money(gst):>11}\"\n        assert row[75:] == f\"{invoice.money(amount + gst):>11}\"\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_upgrade_exports_include_credit_and_per_line_gst():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"] == [\n        {\"description\": inv.lines[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\n    ]\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17}\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n    rendered = invoice.render(inv).splitlines()\n    assert rendered[-3].endswith(\"14,140.57\")\n    assert rendered[-2].endswith(\"2,545.30\")\n    assert rendered[-1].endswith(\"16,685.87\")\n\n\n@pytest.mark.parametrize(\"amount,gst\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_line_gst_rounds_half_paisa_away_from_zero(amount, gst):\n    assert line_gst(amount) == gst\nPY\nmake update-golden\nmake ci\n"]
