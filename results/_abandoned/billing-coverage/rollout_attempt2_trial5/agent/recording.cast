[47.872629, "o", "\u001b[?2004h"]
[47.872645, "o", "> "]
[47.872899, "o", "NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.872976, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\r\n\u001b[?2004h"]
[47.872993, "o", "> "]
