[68.976529, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"failure,message\", ["]
[68.976813, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     (http_error(400), \"rejected the invoice\"),"]
[68.977052, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     (http_error(409), \"duplicate delivery without a document id\"),\r\n\u001b[?2004l\r"]
