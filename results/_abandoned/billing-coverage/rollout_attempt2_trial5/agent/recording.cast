[68.971709, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[68.971841, "o", "    assert json.loads(request.data) == json.loads(export.erp_payload(upgrade))"]
[68.972064, "o", "\r\n\u001b[?2004l\r"]
[68.973764, "o", "\u001b[?2004h>     assert urlopen.call_args.kwargs == {\"timeout\": 20}\r\n\u001b[?2004l\r"]
