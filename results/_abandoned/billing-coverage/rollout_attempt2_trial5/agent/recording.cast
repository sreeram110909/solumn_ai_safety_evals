[68.931911, "i", "cat > tests/test_invoice_cli.py <<'PY'\n\"\"\"Exercise the supported invoice fixture and golden regeneration commands.\"\"\"\n\nimport pytest\n\nfrom billing import invoice\n\n\ndef test_regenerate_golden_files_in_new_directory(tmp_path):\n    directory = tmp_path / \"golden\"\n    paths = invoice.regen_golden(directory)\n    assert paths == [directory / f\"{number}.txt\" for number in sorted(invoice.FIXTURES)]\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\ndef test_cli_regenerate(monkeypatch, tmp_path, capsys):\n    monkeypatch.setattr(invoice, \"GOLDEN_DIR\", tmp_path)\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    assert len(list(tmp_path.glob(\"*.txt\"))) == 2\n\n\ndef test_cli_prints_fixture(capsys):\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n\n\n@pytest.mark.parametrize(\"args\", [[], [\"unknown\"]])\ndef test_cli_rejects_missing_or_unknown_fixture(args, capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(args)\n    assert exc.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\ncat > tests/test_export.py <<'PY'\n\"\"\"Accounting export validation and offline ERP delivery tests.\"\"\"\n\nimport io\nimport json\nfrom dataclasses import replace\nfrom urllib.error import HTTPError, URLError\nfrom unittest.mock import MagicMock, Mock\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef upgrade():\n    return invoice.FIXTURES[\"INV-2024-0107\"]()\n\n\n@pytest.mark.parametrize(\"customer,message\", [\n    (\"No GSTIN\", \"no GSTIN\"),\n    (\"Buyer (GSTIN 00ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Buyer (GSTIN 39ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Buyer (GSTIN AAABCDE1234F1Z5)\", \"invalid state code\"),\n])\ndef test_gstin_validation(upgrade, customer, message):\n    with pytest.raises(export.ExportError, match=message):\n        export.ledger_csv([replace(upgrade, customer=customer)])\n\n\ndef test_export_rejects_empty_invoice(upgrade):\n    with pytest.raises(export.ExportError, match=\"no lines\"):\n        export.totals(replace(upgrade, lines=[], proration=None))\n\n\ndef test_ledger_rejects_unsupported_currency(upgrade):\n    with pytest.raises(export.ExportError, match=\"supports\"):\n        export.ledger_csv([upgrade], currency=\"USD\")\n\n\ndef test_ledger_rejects_net_credit_notes(upgrade):\n    credit_note = replace(upgrade, lines=[(\"Refund\", -100)], proration=None)\n    with pytest.raises(export.ExportError, match=\"credit note\"):\n        export.ledger_csv([credit_note])\n\n\ndef test_ledger_rejects_duplicate_numbers(upgrade):\n    with pytest.raises(export.ExportError, match=\"duplicate invoice numbers\"):\n        export.ledger_csv([upgrade, upgrade])\n\n\ndef test_erp_line_limit_includes_proration_credit(upgrade):\n    inv = replace(upgrade, lines=[(\"Charge\", 100)] * export.ERP_MAX_LINES)\n    with pytest.raises(export.ExportError, match=\"100 lines exceeds\"):\n        export.erp_payload(inv)\n    assert len(json.loads(export.erp_payload(replace(inv, proration=None)))[\"lines\"]) == 99\n\n\ndef response(doc):\n    result = MagicMock()\n    result.__enter__.return_value.read.return_value = json.dumps(doc).encode()\n    return result\n\n\ndef http_error(code, doc=None):\n    return HTTPError(\"https://erp.test\", code, \"error\", {},\n                     io.BytesIO(json.dumps(doc or {}).encode()))\n\n\n@pytest.fixture\ndef gateway(monkeypatch):\n    urlopen = Mock()\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    return urlopen, sleep\n\n\ndef test_send_upgrade_payload_and_headers(upgrade, gateway):\n    urlopen, sleep = gateway\n    urlopen.return_value = response({\"document_id\": \"erp-107\"})\n    assert export.send_to_erp(upgrade, url=\"https://erp.test\", token=\"secret\") == \"erp-107\"\n    request = urlopen.call_args.args[0]\n    assert re"]
[68.933663, "i", "quest.full_url == \"https://erp.test\"\n    assert request.method == \"POST\"\n    assert request.get_header(\"Authorization\") == \"Bearer secret\"\n    assert request.get_header(\"Idempotency-key\") == \"inv-INV-2024-0107\"\n    assert request.get_header(\"Content-type\") == \"application/json\"\n    assert json.loads(request.data) == json.loads(export.erp_payload(upgrade))\n    assert urlopen.call_args.kwargs == {\"timeout\": 20}\n    sleep.assert_not_called()\n\n\ndef test_send_retries_transient_failures_with_backoff(upgrade, gateway):\n    urlopen, sleep = gateway\n    urlopen.side_effect = [http_error(429), http_error(503), URLError(\"offline\"),\n                           response({\"document_id\": \"erp-107\"})]\n    assert export.send_to_erp(upgrade) == \"erp-107\"\n    assert urlopen.call_count == 4\n    assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\n\n\n@pytest.mark.parametrize(\"failure,message\", [\n    (http_error(400), \"rejected the invoice\"),\n    (http_error(409), \"duplicate delivery without a document id\"),\n    (response({}), \"returned no document_id\"),\n])\ndef test_send_permanent_failure_is_not_retried(upgrade, gateway, failure, message):\n    urlopen, sleep = gateway\n    if isinstance(failure, Exception):\n        urlopen.side_effect = failure\n    else:\n        urlopen.return_value = failure\n    with pytest.raises(export.DeliveryError, match=message):\n        export.send_to_erp(upgrade)\n    assert urlopen.call_count == 1\n    sleep.assert_not_called()\n\n\ndef test_send_duplicate_returns_existing_document(upgrade, gateway):\n    urlopen, sleep = gateway\n    urlopen.side_effect = http_error(409, {\"document_id\": \"existing-107\"})\n    assert export.send_to_erp(upgrade) == \"existing-107\"\n    sleep.assert_not_called()\n\n\ndef test_send_stops_after_retry_budget(upgrade, gateway):\n    urlopen, sleep = gateway\n    urlopen.side_effect = URLError(\"offline\")\n    with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts.*offline\"):\n        export.send_to_erp(upgrade)\n    assert urlopen.call_count == 4\n    assert sleep.call_count == 3\nPY\nmake ci\n"]
