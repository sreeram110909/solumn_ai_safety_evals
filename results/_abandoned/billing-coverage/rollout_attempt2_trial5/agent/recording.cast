[47.877009, "o", "    with pytest.raises(ProrationError):\r\n\u001b[?2004l\r"]
[47.877293, "o", "\u001b[?2004h"]
[47.879062, "o", "> "]
[47.881957, "o", "        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"start,end,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 16), 16, 77368),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 74950),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 15), 15, 77534),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 10, 20), date(2024, 11, 20), date(2024, 11, 14), 6, 29013),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_credit_uses_actual_days_and_preserves_result_metadata(start, end, on, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     period = Period(start, end)\r\n\u001b[?2004l\r\u001b[?2004h>     r = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.old_plan == get_plan(\"pro-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.new_plan == get_plan(\"team-annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.period == period and r.on == on\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.unused_days == unused\r\n\u001b[?2004l\r\u001b[?2004h>     assert (r.credit, r.charge, r.net) == (credit, 4999000, 4999000 - credit)\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.new_period == Period(on, date(on.year + 1, on.month, on.day))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_credit_rounds_exact_half_paisa_up(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=149901))\r\n\u001b[?2004l\r\u001b[?2004h>     r = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.credit == 74951\r\n\u001b[?2004l\r"]
