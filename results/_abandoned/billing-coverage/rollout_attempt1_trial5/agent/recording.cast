[53.573075, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         proration = invoice.proration\r\n\u001b[?2004l\r\u001b[?2004h>         description = (f\"Proration credit: {proration.old_plan.name}, \"\r\n\u001b[?2004l\r\u001b[?2004h>                        f\"{proration.unused_days}/{proration.period.days} days\")\r\n\u001b[?2004l\r\u001b[?2004h>         lines.append((description, -proration.credit))\r\n\u001b[?2004l\r\u001b[?2004h>     return lines''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('f\"{\\'Description\\':<46}{\\'Amount\\':>12}', 'f\"{\\'Description\\':<44}{\\'SAC\\':>8}{\\'Amount\\':>12}')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(\"'Subtotal':<46\", \"'Subtotal':<52\").replace(\"'GST @ 18%':<46\", \"'GST @ 18%':<52\").replace(\"'Total due (INR)':<46\", \"'Total due (INR)':<52\")\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
