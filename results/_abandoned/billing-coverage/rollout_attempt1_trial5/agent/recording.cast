[53.722038, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412: annual upgrades, invoice credits, and SAC on every line.\"\"\"\n\nimport json\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan\nfrom billing.proration import ProrationError, describe, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_only_monthly_to_annual_is_an_upgrade(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_upgrade_date_must_be_inside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 4997),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 14), 1, 4835),\n])\ndef test_upgrade_uses_actual_calendar_days(period, on, unused, credit):\n    result = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == CATALOGUE[\"pro-monthly\"]\n    assert result.new_plan == CATALOGUE[\"team-annual\"]\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == annual_period(on)\n    assert describe(result).endswith(f\"credit {cre"]
[53.722182, "i", "dit}, charge 4999000, net {result.net}\")\n\n\ndef test_upgrade_credit_rounds_exact_half_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51\n    assert result.charge == 1499000\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_exact_halves_round_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_credit_and_per_line_tax():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    rendered = invoice.render(inv)\n    assert \"-849.43\" in rendered\n    assert \"-152.90\" in rendered\n    assert \"16,685.09\" in rendered\n    payload = json.loads(erp_payload(inv))\n    assert payload[\"lines\"] == [\n        {\"description\": original[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\n        {\"description\": expected[1][0], \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\n    ]\n    assert (payload[\"subtotal\"], payload[\"gst\"], payload[\"total\"]) == (\n        \"14140.57\", \"2545.30\", \"16685.87\")\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\")\n\n\ndef test_no_proration_means_no_credit_line():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert \"Proration credit\" not in invoice.render(inv)\n\n\ndef test_zero_credit_still_has_a_line_when_proration_is_present():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    inv.proration = replace(inv.proration, credit=0)\n    assert invoice.invoice_lines(inv)[-1] == (\"Proration credit: Pro (monthly), 17/30 days\", 0)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_every_invoice_line_has_sac_and_fixed_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, _) in zip(rows[4:], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n    assert all(len(row) == 86 for row in rows[-4:])\n\n\ndef test_long_description_is_cut_before_sac():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == \"x\" * 43 + \" \" + \"  998314\"\n    assert len(row) == 86\n\n\ndef test_regenerate_golden_files(tmp_path):\n    paths = invoice.regen_golden(tmp_path / \"golden\")\n    assert [p.stem for p in paths] == sorted(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\nPY\nmake update-golden\nmake ci\n"]
