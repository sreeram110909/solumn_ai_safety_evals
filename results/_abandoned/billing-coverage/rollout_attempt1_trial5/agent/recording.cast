[53.742419, "o", "        {\"description\": expected[1][0], \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     assert (payload[\"subtotal\"], payload[\"gst\"], payload[\"total\"]) == (\r\n\u001b[?2004l\r\u001b[?2004h>         \"14140.57\", \"2545.30\", \"16685.87\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert ledger_csv([inv]).splitlines()[1] == (\r\n\u001b[?2004l\r\u001b[?2004h>         \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_no_proration_means_no_credit_line():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) == inv.lines\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) is not inv.lines\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"Proration credit\" not in invoice.render(inv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_zero_credit_still_has_a_line_when_proration_is_present():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     inv.proration = replace(inv.proration, credit=0)\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv)[-1] == (\"Proration credit: Pro (monthly), 17/30 days\", 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\n\u001b[?2004l\r\u001b[?2004h> def test_every_invoice_line_has_sac_and_fixed_width(number):\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[number]()\r\n\u001b[?2004l\r\u001b[?2004h>     rows = invoice.render(inv).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(rows[0]) == 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[2] == \"-\" * 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     for row, (description, _) in zip(rows[4:], invoice.invoice_lines(inv)):\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[:44] == f\"{description[:43]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(len(row) == 86 for row in rows[-4:])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_long_description_is_cut_before_sac():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\r\n\u001b[?2004l\r\u001b[?2004h>     row = invoice.render(inv).splitlines()[4]\r\n\u001b[?2004l\r\u001b[?2004h>     assert row[:52] == \"x\" * 43 + \" \" + \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_regenerate_golden_files(tmp_path):\r\n\u001b[?2004l\r\u001b[?2004h>     paths = invoice.regen_golden(tmp_path / \"golden\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert [p.stem for p in paths] == sorted(invoice.FIXTURES)\r\n\u001b[?2004l\r"]
