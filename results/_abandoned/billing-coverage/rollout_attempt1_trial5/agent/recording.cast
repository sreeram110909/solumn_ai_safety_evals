[72.800475, "o", "\u001b[32m+\u001b[m\u001b[32m    return ProrationResult(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        old_plan=old,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_plan=new,\u001b[m\r\n"]
[72.800626, "o", "\u001b[32m+\u001b[m\u001b[32m        on=on,\u001b[m\r\n"]
[72.800681, "o", "\u001b[32m+\u001b[m\u001b[32m        period=period,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused_days=unused,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        credit=prorate_amount(old.price, unused, period.days),\u001b[m\r\n"]
[72.800769, "o", "\u001b[32m+\u001b[m\u001b[32m        charge=new.price,\u001b[m\r\n"]
