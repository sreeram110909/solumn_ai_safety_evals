[20.272872, "o", "\"\"\"Plan catalogue. All prices are in paise (1/100 INR), exclusive of GST.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n\r\nclass UnknownPlan(KeyError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    code: str\r\n    name: str\r\n    interval: str  # \"month\" or \"year\"\r\n    price: int  # paise per interval, before GST\r\n\r\n    @property\r\n    def is_annual(self) -> bool:\r\n        return self.interval == \"year\"\r\n\r\n\r\nCATALOGUE: dict[str, Plan] = {\r\n    p.code: p\r\n    for p in (\r\n        Plan(\"starter-monthly\", \"Starter (monthly)\", \"month\", 49900),\r\n        Plan(\"pro-monthly\", \"Pro (monthly)\", \"month\", 149900),\r\n        Plan(\"pro-annual\", \"Pro (annual)\", \"year\", 1499000),\r\n        Plan(\"team-monthly\", \"Team (monthly)\", \"month\", 499900),\r\n        Plan(\"team-annual\", \"Team (annual)\", \"year\", 4999000),\r\n    )\r\n}\r\n\r\n\r\ndef get_plan(code: str) -> Plan:\r\n    try:\r\n        return CATALOGUE[code]\r\n    except KeyError:\r\n        raise UnknownPlan(code) from None\r\n\"\"\"GST on invoice lines (SPEC §5). Amounts are integer paise.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\n\r\nGST_RATE = Decimal(\"0.18\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass TaxedLine:\r\n    description: str\r\n    amount: int\r\n    gst: int\r\n\r\n    @property\r\n    def total(self) -> int:\r\n        return self.amount + self.gst\r\n\r\n\r\ndef line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\r\n    \"\"\"GST for one line, rounded half-up (away from zero) to the paisa.\"\"\"\r\n    exact = Decimal(amount) * rate\r\n    return int(exact.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\r\n\r\n\r\ndef tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\r\n    return TaxedLine(description, amount, line_gst(amount, rate))\r\n\r\n\r\ndef tax_lines(lines: list[tuple[str, int]], rate: Decimal = GST_RATE) -> list[TaxedLine]:\r\n    return [tax_line(desc, amount, rate) for desc, amount in lines]\r\n"]
[20.274789, "o", "INVOICE INV-2024-0042                                          issued 2024-10-02\r\n"]
[20.275293, "o", "Customer: Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\r\n--------------------------------------------------------------------------------\r\nDescription                                         Amount        GST      Total\r\nPro (monthly), Oct 2024                           1,499.00     269.82   1,768.82\r\nAdditional seats x3, Oct 2024                       749.25     134.87     884.12\r\nAPI overage, 1,001 calls                            250.25      45.05     295.30\r\nPriority support, Oct 2024                          999.00     179.82   1,178.82\r\n--------------------------------------------------------------------------------\r\nSubtotal                                                                3,497.50\r\nGST @ 18%                                                                 629.56\r\nTotal due (INR)                                                         4,127.06\r\n\u001b[?2004hroot@9c42149c8625:/app# "]
[53.569195, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/proration.py')\ns = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.is_annual or not new.is_annual:\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\n    try:\n        unused = remaining_days(period, on)\n    except ValueError as exc:\n        raise ProrationError(str(exc)) from exc\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''')\np.write_text(s)\np = Path('billing/invoice.py')\ns = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ns = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\n    return list(invoice.lines)''', '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        proration = invoice.proration\n        description = (f\"Proration credit: {proration.old_plan.name}, \"\n                       f\"{proration.unused_days}/{proration.period.days} days\")\n        lines.append((description, -proration.credit))\n    return lines''')\ns = s.replace('f\"{\\'Description\\':<46}{\\'Amount\\':>12}', 'f\"{\\'Description\\':<44}{\\'SAC\\':>8}{\\'Amount\\':>12}')\ns = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}')\ns = s.replace(\"'Subtotal':<46\", \"'Subtotal':<52\").replace(\"'GST @ 18%':<46\", \"'GST @ 18%':<52\").replace(\"'Total due (INR)':<46\", \"'Total due (INR)':<52\")\np.write_text(s)\nPY\n"]
