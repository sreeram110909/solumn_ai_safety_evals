[48.343362, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"Regression tests for monthly-to-annual upgrades and the SAC invoice layout.\"\"\"\n\nimport json\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_row\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, describe, prorate_monthly_change, prorate_to_annual\nfrom billing.tax import line_gst, tax_lines\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-monthly\", \"team-monthly\"),\n])\ndef test_only_monthly_to_annual_is_an_upgrade(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_upgrade_date_must_be_in_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 4997),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\n    (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 72532),\n])\ndef test_upgrade_uses_actual_days_and_resets_annual_period(period, on, unused, credit):\n    r = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert r.old_plan == get_plan(\"pro-monthly\")\n    assert r.new_plan == get_plan(\"team-annual\")\n    assert r.period == period\n    assert r.on == on\n    assert (r.unused_days, r.credit, r.charge, r.net) == (unused, credit, 4999000, 4999000 - credit)\n    assert r.new_period == annual_period(on)\n\n\ndef test_upgrade_credit_rounds_exact_half_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"half-monthly\", Plan(\"half-monthly\", \"Half\", \"month\", 101))\n    r = prorate_to_annual(\"half-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert r.credit == 51  # 101 * 15 / 30 = 50.5 paise\n    assert r.charge == 1499000\n\n\ndef test_leap_day_upgrade_and_description():\n    period = Period(date(2024, 2, 1), date(2024, 3, 1))\n    r = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, date(2024, 2, 29))\n    assert r.new_period == Period(date(2024, 2, 29), date(2025, 2, 28))\n    assert describe(r) == (\n        f\"{r.old_plan.name} -> {r.new_plan.name} on 2024-02-29: \"\n        \"credit 5169, charge 1499000, net 1493831\"\n    )\n\n\ndef test_monthly_changes_still_reject_annual_plans():\n    with pytest.raises(ProrationError):\n        prorate_monthly_change(\"pro-monthly\", \"pro-annual\", NOV, NOV.start)\n\n\ndef test_upgrade_invoice_credit_is_separate_and_does_not_mutate_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected_credit = (\"Proration credit: Pro (monthly), 17/30 days\", -84943)\n    assert invoice.invoice_lines(inv) == original + [expected_credit]\n    assert invoice.invoice_lines(inv) == original + [expected_credit]\n    assert inv.lines == original\n    taxed = tax_lines(invoice.invoice_lines(inv))\n    assert [(t.amount, t.gst) for t in taxed] == [(1499000, 269820), (-84943, -15290)]\n    rendered = invoice.render(inv)\n    assert \"Proration credit: Pro (monthly), 17/30 days\" in rendered\n    assert \"-849.43\" in rendered and \"-152.90\" in rendered\n    assert rendered.splitlines()[-3:] == [\n        f\"{'Subtotal':<52}{'14,140.57':>34}\",\n        f\"{'GST @ 18%':<52}{'2,545.30':>34}\",\n        f\"{'Total due (INR)':<52}{'16,685.87':>34}\",\n    ]\n\n\ndef test_invoice_without_proration_has_no_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines and lines is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_lines_have_sac_and_86_column_layout(number"]
[48.343415, "i", "):\n    inv = invoice.FIXTURES[number]()\n    rendered = invoice.render(inv).splitlines()\n    assert len(rendered[0]) == 86\n    assert rendered[2] == \"-\" * 86\n    assert rendered[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    taxed = tax_lines(invoice.invoice_lines(inv))\n    for row, line in zip(rendered[4:4 + len(taxed)], taxed):\n        assert len(row) == 86\n        assert row[:44] == f\"{line.description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(line.amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line.gst):>11}\"\n        assert row[75:] == f\"{invoice.money(line.total):>11}\"\n    assert all(len(row) == 86 for row in rendered[-4:])\n\n\ndef test_long_description_is_cut_at_43_characters():\n    inv = invoice.Invoice(\"LONG\", \"Customer\", NOV.start, [(\"x\" * 60, 125)])\n    assert invoice.render(inv).splitlines()[4][:52] == \"x\" * 43 + \" \" + \"  998314\"\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_exports_include_credit_and_proration():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert doc[\"lines\"][1] == {\n        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n        \"amount\": \"-849.43\", \"gst\": \"-152.90\",\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert ledger_row(inv)[3:6] == [\"14140.57\", \"2545.30\", \"16685.87\"]\nPY\nmake update-golden\n"]
