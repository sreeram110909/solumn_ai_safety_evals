[72.922144, "o", "import io\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import urllib.error\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import export, invoice\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.fixture\r\n\u001b[?2004l\r\u001b[?2004h> def inv():\r\n\u001b[?2004l\r\u001b[?2004h>     return invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"customer,match\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"No GSTIN\", \"no GSTIN\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Buyer (GSTIN 00ABCDE1234F1Z5)\", \"invalid state code\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Buyer (GSTIN 39ABCDE1234F1Z5)\", \"invalid state code\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"Buyer (GSTIN AAABCDE1234F1Z5)\", \"invalid state code\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_export_requires_valid_gstin(inv, customer, match):\r\n\u001b[?2004l\r\u001b[?2004h>     inv.customer = customer\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=match):\r\n\u001b[?2004l\r\u001b[?2004h>         export.gstin_of(inv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_export_rejects_invalid_invoices(inv):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"supports\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.ledger_row(inv, \"USD\")\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"duplicate invoice numbers\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.ledger_csv([inv, inv])\r\n\u001b[?2004l\r\u001b[?2004h>     inv.proration = None\r\n\u001b[?2004l\r\u001b[?2004h>     inv.lines = []\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"no lines\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.totals(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     inv.lines = [(\"Credit\", -100)]\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"credit note\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.ledger_row(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     inv.lines = [(\"Service\", 100)] * 100\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"ERP limit\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.erp_payload(inv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rd)\r\n    with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts.*offline\"):\r\n        export.send_to_erp(inv)\r\n    assert len(attempts) == export.MAX_ATTEMPTS\r\n    assert sleeps == [1, 4, 15]\r\nPY\r\nmake ci\r\n"]
[72.922696, "o", "\u001b[?2004h> "]
[72.923114, "o", "def test_ledger_sorts_by_date_then_number(inv):"]
[72.923245, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.923669, "o", "    earlier = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.924342, "o", "    rows = export.ledger_csv([inv, earlier]).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.925497, "o", "    assert rows[1].startswith(earlier.number + \",\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[2].startswith(inv.number + \",\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_retries_transient_errors(inv, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     attempts = []\r\n\u001b[?2004l\r\u001b[?2004h>     sleeps = []\r\n\u001b[?2004l\r\u001b[?2004h>     responses = iter([\r\n\u001b[?2004l\r\u001b[?2004h>         urllib.error.HTTPError(\"https://example.test\", 429, \"rate limit\", {}, None),\r\n\u001b[?2004l\r\u001b[?2004h>         urllib.error.HTTPError(\"https://example.test\", 503, \"unavailable\", {}, None),\r\n\u001b[?2004l\r\u001b[?2004h>         urllib.error.URLError(\"offline\"),\r\n\u001b[?2004l\r\u001b[?2004h>         io.BytesIO(b'{\"document_id\": \"ERP-107\"}'),\r\n\u001b[?2004l\r\u001b[?2004h>     ])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def urlopen(request, timeout):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.92566, "o", "        attempts.append(request)"]
