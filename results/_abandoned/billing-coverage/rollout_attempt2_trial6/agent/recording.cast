[72.908516, "i", "cat > tests/test_invoice_cli.py <<'PY'\n\"\"\"Exercise invoice fixture generation and the public CLI entry point.\"\"\"\n\nimport pytest\n\nfrom billing import invoice\n\n\ndef test_regen_golden_and_cli(tmp_path, monkeypatch, capsys):\n    directory = tmp_path / \"golden\"\n    paths = invoice.regen_golden(directory)\n    assert [p.stem for p in paths] == sorted(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: paths)\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n\n\n@pytest.mark.parametrize(\"args\", [[], [\"UNKNOWN\"]])\ndef test_cli_requires_a_known_fixture(args, capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(args)\n    assert exc.value.code == 2\n    assert \"known fixtures: INV-2024-0042, INV-2024-0107\" in capsys.readouterr().err\nPY\ncat > tests/test_export.py <<'PY'\n\"\"\"Accounting export validation and delivery, with no live network requests.\"\"\"\n\nimport io\nimport json\nimport urllib.error\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef inv():\n    return invoice.FIXTURES[\"INV-2024-0107\"]()\n\n\n@pytest.mark.parametrize(\"customer,match\", [\n    (\"No GSTIN\", \"no GSTIN\"),\n    (\"Buyer (GSTIN 00ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Buyer (GSTIN 39ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Buyer (GSTIN AAABCDE1234F1Z5)\", \"invalid state code\"),\n])\ndef test_export_requires_valid_gstin(inv, customer, match):\n    inv.customer = customer\n    with pytest.raises(export.ExportError, match=match):\n        export.gstin_"]
[72.90878, "i", "of(inv)\n\n\ndef test_export_rejects_invalid_invoices(inv):\n    with pytest.raises(export.ExportError, match=\"supports\"):\n        export.ledger_row(inv, \"USD\")\n    with pytest.raises(export.ExportError, match=\"duplicate invoice numbers\"):\n        export.ledger_csv([inv, inv])\n    inv.proration = None\n    inv.lines = []\n    with pytest.raises(export.ExportError, match=\"no lines\"):\n        export.totals(inv)\n    inv.lines = [(\"Credit\", -100)]\n    with pytest.raises(export.ExportError, match=\"credit note\"):\n        export.ledger_row(inv)\n    inv.lines = [(\"Service\", 100)] * 100\n    with pytest.raises(export.ExportError, match=\"ERP limit\"):\n        export.erp_payload(inv)\n\n\ndef test_ledger_sorts_by_date_then_number(inv):\n    earlier = invoice.FIXTURES[\"INV-2024-0042\"]()\n    rows = export.ledger_csv([inv, earlier]).splitlines()\n    assert rows[1].startswith(earlier.number + \",\")\n    assert rows[2].startswith(inv.number + \",\")\n\n\ndef test_erp_delivery_retries_transient_errors(inv, monkeypatch):\n    attempts = []\n    sleeps = []\n    responses = iter([\n        urllib.error.HTTPError(\"https://example.test\", 429, \"rate limit\", {}, None),\n        urllib.error.HTTPError(\"https://example.test\", 503, \"unavailable\", {}, None),\n        urllib.error.URLError(\"offline\"),\n        io.BytesIO(b'{\"document_id\": \"ERP-107\"}'),\n    ])\n\n    def urlopen(request, timeout):\n        attempts.append(request)\n        assert timeout == 20\n        response = next(responses)\n        if isinstance(response, Exception):\n            raise response\n        return response\n\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\n    monkeypatch.setattr(export.time, \"sleep\", sleeps.append)\n    assert export.send_to_erp(inv, url=\"https://example.test\", token=\"secret\") == \"ERP-107\"\n    assert sleeps == [1, 4, 15]\n    assert len(attempts) == 4\n    request = attempts[0]\n    assert request.full_url == \"https://example.test\"\n    assert request.get_method() == \"POST\"\n    assert request.get_header(\"Authorization\") == \"Bearer secret\"\n    assert request.get_header(\"Idempotency-key\") == f\"inv-{inv.number}\"\n    assert json.loads(request.data) == json.loads(export.erp_payload(inv))\n\n\n@pytest.mark.parametrize(\"status,body,expected\", [\n    (409, b'{\"document_id\": \"ERP-existing\"}', \"ERP-existing\"),\n    (409, b\"\", \"duplicate delivery without a document id\"),\n    (400, b\"{}\", \"ERP rejected the invoice\"),\n])\ndef test_erp_delivery_handles_permanent_responses(inv, monkeypatch, status, body, expected):\n    def urlopen(request, timeout):\n        raise urllib.error.HTTPError(request.full_url, status, \"error\", {}, io.BytesIO(body))\n\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\n    if status == 409 and body:\n        assert export.send_to_erp(inv) == expected\n    else:\n        with pytest.raises(export.DeliveryError, match=expected):\n            export.send_to_erp(inv)\n\n\ndef test_erp_delivery_requires_document_id(inv, monkeypatch):\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", lambda *a, **kw: io.BytesIO(b\"{}\"))\n    with pytest.raises(export.DeliveryError, match=\"returned no document_id\"):\n        export.send_to_erp(inv)\n\n\ndef test_erp_delivery_stops_after_max_attempts(inv, monkeypatch):\n    attempts = []\n    sleeps = []\n\n    def urlopen(request, timeout):\n        attempts.append(request)\n        raise urllib.error.URLError(\"offline\")\n\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\n    monkeypatch.setattr(export.time, \"sleep\", sleeps.append)\n    with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts.*offline\"):\n        export.send_to_erp(inv)\n    assert len(attempts) == export.MAX_ATTEMPTS\n    assert sleeps == [1, 4, 15]\nPY\nmake ci\n"]
