[72.926026, "o", "> "]
[72.926153, "o", "        assert timeout == 20\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.926272, "o", "        response = next(responses)"]
[72.926389, "o", "\r\n\u001b[?2004l\r"]
[72.927418, "o", "\u001b[?2004h>         if isinstance(response, Exception):\r\n\u001b[?2004l\r\u001b[?2004h>             raise response\r\n\u001b[?2004l\r\u001b[?2004h>         return response\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.time, \"sleep\", sleeps.append)\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(inv, url=\"https://example.test\", token=\"secret\") == \"ERP-107\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert sleeps == [1, 4, 15]\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(attempts) == 4\r\n\u001b[?2004l\r\u001b[?2004h>     request = attempts[0]\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.full_url == \"https://example.test\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.get_method() == \"POST\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.get_header(\"Authorization\") == \"Bearer secret\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.927777, "o", "    assert request.get_header(\"Idempotency-key\") == f\"inv-{inv.number}\""]
[72.929976, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert json.loads(request.data) == json.loads(export.erp_payload(inv))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"status,body,expected\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (409, b'{\"document_id\": \"ERP-existing\"}', \"ERP-existing\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (409, b\"\", \"duplicate delivery without a document id\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (400, b\"{}\", \"ERP rejected the invoice\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_handles_permanent_responses(inv, monkeypatch, status, body, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     def urlopen(request, timeout):\r\n\u001b[?2004l\r\u001b[?2004h>         raise urllib.error.HTTPError(request.full_url, status, \"error\", {}, io.BytesIO(body))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\r\n\u001b[?2004l\r\u001b[?2004h>     if status == 409 and body:\r\n\u001b[?2004l\r\u001b[?2004h>         assert export.send_to_erp(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         with pytest.raises(export.DeliveryError, match=expected):\r\n\u001b[?2004l\r\u001b[?2004h>             export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_requires_document_id(inv, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.urllib.request, \"urlopen\", lambda *a, **kw: io.BytesIO(b\"{}\"))\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=\"returned no document_id\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_stops_after_max_attempts(inv, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     attempts = []\r\n\u001b[?2004l\r\u001b[?2004h>     sleeps = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def urlopen(request, timeout):\r\n\u001b[?2004l\r\u001b[?2004h>         attempts.append(request)\r\n\u001b[?2004l\r\u001b[?2004h>         raise urllib.error.URLError(\"offline\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.time, \"sleep\", sleeps.append)\r\n\u001b[?2004l\r\u001b[?2004h> "]
