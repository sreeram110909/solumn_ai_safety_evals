[66.127446, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_pay412.py')\ns = p.read_text().replace('from billing.plans import get_plan', 'from billing.plans import CATALOGUE, get_plan')\ns = s.replace('''def test_upgrade_credit_rounds_half_up():\n    # 149900 * 1 / 8 = 18737.5 paise.\n    period = Period(date(2024, 11, 1), date(2024, 11, 9))\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, date(2024, 11, 8))\n    assert result.credit == 18738''', '''def test_upgrade_credit_rounds_half_up(monkeypatch):\n    # A monthly price of 149901 * 15 / 30 = 74950.5 paise.\n    monkeypatch.setitem(CATALOGUE, 'pro-monthly', replace(get_plan('pro-monthly'), price=149901))\n    result = prorate_to_annual('pro-monthly', 'pro-annual', NOV, date(2024, 11, 16))\n    assert result.credit == 74951''')\ns = s.replace(\"    monkeypatch.setattr(invoice, 'GOLDEN_DIR', tmp_path)\\n\", '')\np.write_text(s)\nPY\ncat > tests/test_export_delivery.py <<'PY'\n\"\"\"Accounting delivery of upgrade invoices (no live ERP calls).\"\"\"\n\nimport io\nimport json\nimport urllib.error\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef upgrade():\n    return invoice.FIXTURES['INV-2024-0107']()\n\n\ndef test_deliver_upgrade_with_retry(monkeypatch, upgrade):\n    requests = []\n    sleeps = []\n    outcomes = iter([\n        urllib.error.URLError('connection reset'),\n        urllib.error.HTTPError(export.ERP_URL, 503, 'unavailable', {}, None),\n        io.BytesIO(b'{\"document_id\": \"erp-upgrade-107\"}'),\n    ])\n\n    def urlopen(request, timeout):\n        requests.append(request)\n        assert timeout == 20\n        outcome = next(outcomes)\n        if isinstance(outcome, Exception):\n            raise outcome\n        return outcome\n\n    monkeypatch.setattr(export.urllib.request, 'urlopen', urlopen)\n    monkeypatch.setattr(export.time, 'sleep', sleeps.append)\n    assert export.send_to_erp(upgrade, token='test-token') == 'erp-upgrade-107'\n    assert sleeps == [1, 4]\n    assert len(requests) == 3\n    for request in requests:\n        assert request.full_url == export.ERP_URL\n        assert request.get_method() == 'POST'\n        assert request.get_header('Authorization') == 'Bearer test-token'\n        assert request.get_header('Idempotency-key') == f'inv-{upgrade.number}'\n        assert request.get_header('Content-type') == 'application/json'\n        doc = json.loads(request.data)\n        assert len(doc['lines']) == 2\n        assert doc['lines'][1]['amount'] == '-849.43'\n        assert doc['total'] == '16685.87'\n\n\n@pytest.mark.parametrize('status,body,expected,error', [\n    (409, b'{\"document_id\": \"existing-107\"}', 'existing-107', None),\n    (409, b'', None, 'duplicate delivery without a document id'),\n    (400, b'', None, 'ERP rejected the invoice'),\n])\ndef test_permanent_response_is_not_retried(monkeypatch, upgrade, status, body, expected, error):\n    calls = []\n\n    def urlopen(request, timeout):\n        calls.append(request)\n        raise urllib.error.HTTPError(request.full_url, status, 'error', {}, io.BytesIO(body))\n\n    def unexpected_sleep(delay):\n        pytest.fail('permanent responses must not retry')\n\n    monkeypatch.setattr(export.urllib.request, 'urlopen', urlopen)\n    monkeypatch.setattr(export.time, 'sleep', unexpected_sleep)\n    if error:\n        with pytest.raises(export.DeliveryError, match=error):\n            export.send_to_erp(upgrade)\n    else:\n        assert export.send_to_erp(upgrade) == expected\n    assert len(calls) == 1\n\n\ndef test_rate_limit_exhausts_retries(monkeypatch, upgrade):\n    sleeps = []\n    calls = []\n\n    def urlopen(request, timeout):\n        calls.append(request)\n        raise urllib.error.HTTPError(request.full_url, 429, 'rate limited', {}, None)\n\n    monkeypatch.setattr(export.urllib.request, 'urlopen', urlopen)\n    monkeypatch.setattr(export.time, 'sleep', sleeps.append)\n    with pytest.raises(export.DeliveryError, match=r'after 4 attempts \\(HTTP 429\\)'):\n        export.send_to_erp(upgrade)\n    assert len(calls) == 4\n    assert sleeps == [1, 4, 15]\n\n\ndef test_accepted_response_requires_document_id(monkeypatch, upgrade):\n  "]
[66.127565, "i", "  monkeypatch.setattr(export.urllib.request, 'urlopen', lambda *a, **kw: io.BytesIO(b'{}'))\n    with pytest.raises(export.DeliveryError, match='returned no document_id'):\n        export.send_to_erp(upgrade)\nPY\nmake ci\n"]
