[42.732858, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412 proration, invoice layout, and accounting integration regressions.\"\"\"\n\nimport json\nfrom dataclasses import replace\nfrom datetime import date, timedelta\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period\nfrom billing.plans import get_plan\nfrom billing.proration import (\n    ProrationError,\n    describe,\n    prorate_amount,\n    prorate_monthly_change,\n    prorate_to_annual,\n)\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize('old,new', [\n    ('pro-annual', 'pro-monthly'),\n    ('pro-annual', 'team-annual'),\n    ('pro-monthly', 'team-monthly'),\n])\ndef test_reject_non_upgrades(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, NOV.start)\n\n\n@pytest.mark.parametrize('on', [NOV.start - timedelta(days=1), NOV.end, NOV.end + timedelta(days=1)])\ndef test_reject_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match='outside'):\n        prorate_to_annual('pro-monthly', 'pro-annual', NOV, on)\n\n\n@pytest.mark.parametrize('start,end,on,unused,credit,annual_end', [\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169, date(2025, 2, 28)),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 28), 1, 5354, date(2024, 2, 28)),\n    (date(2024, 10, 15), date(2024, 11, 15), date(2024, 11, 14), 1, 4835, date(2025, 11, 14)),\n    (date(2024, 12, 1), date(2025, 1, 1), date(2024, 12, 1), 31, 149900, date(2025, 12, 1)),\n])\ndef test_calendar_days_and_full_annual_charge(start, end, on, unused, credit, annual_end):\n    period = Period(start, end)\n    result = prorate_to_annual('pro-monthly', 'team-annual', period, on)\n    assert result.old_plan == get_plan('pro-monthly')\n    assert result.new_plan == get_plan('team-annual')\n    assert (result.on, result.period, result.unused_days) == (on, period, unused)\n    assert (result.credit, result.charge, result.net) == (credit, 4999000, 4999000 - credit)\n    assert result.new_period == Period(on, annual_end)\n    assert f'credit {credit}, charge 4999000' in describe(result)\n\n\ndef test_upgrade_credit_rounds_half_up():\n    # 149900 * 1 / 8 = 18737.5 paise.\n    period = Period(date(2024, 11, 1), date(2024, 11, 9))\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, date(2024, 11, 8))\n    assert result.credit == 18738\n    assert prorate_amount(1, 1, 2) == 1\n\n\n@pytest.mark.parametrize('amount,expected', [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\n@pytest.mark.parametrize('old,new', [('pro-annual', 'pro-monthly'), ('pro-monthly', 'pro-annual')])\ndef test_monthly_change_still_rejects_annual_plans(old, new):\n    with pytest.raises(ProrationError):\n        prorate_monthly_change(old, new, NOV, NOV.start)\n\n\ndef test_upgrade_lines_credit_and_exports():\n    inv = invoice.FIXTURES['INV-2024-0107']()\n    original = list(inv.lines)\n    expected = original + [('Proration credit: Pro (monthly), 17/30 days', -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected  # no duplicate credits on repeat calls\n    assert inv.lines == original\n    doc = json.loads(erp_payload(inv))\n    assert doc['lines'] == [\n        {'description': original[0][0], 'amount': '14990.00', 'gst': '2698.20'},\n        {'description': expected[1][0], 'amount': '-849.43', 'gst': '-152.90'},\n    ]\n    assert (doc['subtotal'], doc['gst'], doc['total']) == ('14140.57', '2545.30', '16685.87')\n    assert doc['proration'] == {'old_plan': 'pro-monthly', 'new_plan': 'pro-annual', 'unused_days': 17}\n    assert ledger_csv([inv]).splitlines()[1].endswith(',14140.57,2545.30,16685.87,INR')\n\n\n@pytest.mark.parametrize('number', sorted(invoice.FIXTURES))\ndef test_sac_and_fixed_width_columns(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert all(len(row) == 86 for i, row in enumerate(ro"]
[42.733235, "i", "ws) if i != 1)\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:], invoice.invoice_lines(inv)):\n        assert row[:44] == f'{description[:43]:<44}'\n        assert row[44:52] == '  998314'\n        assert row[52:64].strip() == invoice.money(amount)\n        assert row[64:75].strip() == invoice.money(line_gst(amount))\n        assert row[75:86].strip() == invoice.money(amount + line_gst(amount))\n\n\ndef test_ordinary_invoice_has_no_credit_and_lines_are_copied():\n    inv = invoice.FIXTURES['INV-2024-0042']()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    lines.clear()\n    assert inv.lines\n    assert 'Proration credit:' not in invoice.render(inv)\n\n\ndef test_description_is_truncated_with_blank_separator():\n    inv = replace(invoice.FIXTURES['INV-2024-0042'](), lines=[('x' * 60, 125)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == 'x' * 43 + ' ' + '  998314'\n    assert row[64:75].strip() == '0.23'\n\n\ndef test_invoice_cli_and_golden_regeneration(tmp_path, monkeypatch, capsys):\n    monkeypatch.setattr(invoice, 'GOLDEN_DIR', tmp_path)\n    # regen_golden accepts an explicit directory so tests never rewrite tracked fixtures.\n    paths = invoice.regen_golden(tmp_path)\n    assert len(paths) == len(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n    monkeypatch.setattr(invoice, 'regen_golden', lambda: paths)\n    assert invoice.main(['--regen-golden']) == 0\n    assert capsys.readouterr().out == 'wrote 2 golden files\\n'\n    assert invoice.main(['INV-2024-0107']) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES['INV-2024-0107']())\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(['unknown'])\n    assert exc.value.code == 2\nPY\nmake ci\n"]
