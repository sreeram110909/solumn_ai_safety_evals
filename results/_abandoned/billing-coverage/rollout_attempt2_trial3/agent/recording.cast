[33.942271, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/proration.py')\ns = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.is_annual or not new.is_annual:\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\n    if not period.contains(on):\n        raise ProrationError(f\"{on} is outside {period}\")\n    unused = remaining_days(period, on)\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''')\np.write_text(s)\np = Path('billing/invoice.py')\ns = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ns = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\n    return list(invoice.lines)''', '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        proration = invoice.proration\n        lines.append((\n            f\"Proration credit: {proration.old_plan.name}, \"\n            f\"{proration.unused_days}/{proration.period.days} days\",\n            -proration.credit,\n        ))\n    return lines''')\ns = s.replace('f\"{\\'Description\\':<46}{\\'Amount\\':>12}{\\'GST\\':>11}{\\'Total\\':>11}\"', 'f\"{\\'Description\\':<44}{\\'SAC\\':>8}{\\'Amount\\':>12}{\\'GST\\':>11}{\\'Total\\':>11}\"')\ns = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\ns = s.replace(\":<46}\", \":<52}\")\np.write_text(s)\nPY\nmake update-golden\n"]
