[7.328278, "o", "\"\"\"Mid-cycle plan changes (SPEC §2 monthly changes, §3 upgrades to annual).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\n\r\nfrom billing.periods import Period, annual_period, remaining_days\r\nfrom billing.plans import Plan, get_plan\r\n\r\n\r\nclass ProrationError(ValueError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass ProrationResult:\r\n    old_plan: Plan\r\n    new_plan: Plan\r\n    on: date\r\n    period: Period  # the old plan's current billing period\r\n    unused_days: int\r\n    credit: int  # paise credited for the unused part of the old plan (>= 0)\r\n    charge: int  # paise charged for the new plan\r\n    new_period: Period\r\n\r\n    @property\r\n    def net(self) -> int:\r\n        return self.charge - self.credit\r\n\r\n\r\ndef prorate_amount(price: int, days: int, period_days: int) -> int:\r\n    \"\"\"``price * days / period_days`` rounded half-up to the paisa.\"\"\"\r\n    exact = Decimal(price) * days / period_days\r\n    return int(exact.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\r\n\r\n\r\ndef prorate_monthly_change(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\r\n    \"\"\"Switch between two monthly plans inside the current period (SPEC §2).\r\n\r\n    The customer is credited for the unused days of the old plan and charged for\r\n    the same days of the new plan; the billing period does not move.\r\n    \"\"\"\r\n    old, new = get_plan(old_code), get_plan(new_code)\r\n    if old.is_annual or new.is_annual:\r\n        raise ProrationError(\"monthly changes only; use prorate_to_annual for annual upgrades\")\r\n    unused = remaining_days(period, on)\r\n    return ProrationResult(\r\n        old_plan=old,\r\n        new_plan=new,\r\n        on=on,\r\n        period=period,\r\n        unused_days=unused,\r\n        credit=prorate_amount(old.price, unused, period.days),\r\n        charge=prorate_amount(new.price, unused, period.days),\r\n        new_period=period,\r\n    )\r\n\r\n\r\ndef prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\r\n    \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\r\n    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\r\n\r\n\r\ndef describe(result: ProrationResult) -> str:\r\n    return (\r\n        f\"{result.old_plan.name} -> {result.new_plan.name} on {result.on.isoformat()}: \"\r\n        f\"credit {result.credit}, charge {result.charge}, net {result.net}\"\r\n    )\r\n\r\n\r\n__all__ = [\r\n    \"ProrationError\",\r\n    \"ProrationResult\",\r\n    \"describe\",\r\n    \"prorate_amount\",\r\n    \"prorate_monthly_change\",\r\n    \"prorate_to_annual\",\r\n]\r\n\u001b[?2004hroot@d6db03e6a3ab:/app# "]
[10.909462, "i", "cat billing/invoice.py billing/periods.py billing/plans.py billing/tax.py billing/export.py\n"]
[10.910224, "o", "cat billing/invoice.py billing/periods.py billing/plans.py billing/tax.py billing/export.py\r\n"]
[10.911828, "o", "\u001b[?2004l\r\"\"\"Plain-text invoice rendering, plus the golden fixtures used by the test-suite.\r\n\r\n    python -m billing.invoice --regen-golden   # rewrite every tests/golden/<number>.txt\r\n    python -m billing.invoice <number>         # print one fixture\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nfrom billing.periods import Period\r\nfrom billing.proration import ProrationResult, prorate_to_annual\r\nfrom billing.tax import tax_lines\r\n\r\nGOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\r\nWIDTH = 80\r\n\r\n\r\n@dataclass\r\nclass Invoice:\r\n    number: str\r\n    customer: str\r\n    issued: date\r\n    lines: list[tuple[str, int]] = field(default_factory=list)\r\n    proration: ProrationResult | None = None\r\n\r\n\r\ndef money(paise: int) -> str:\r\n    sign = \"-\" if paise < 0 else \"\"\r\n    rupees, p = divmod(abs(paise), 100)\r\n    return f\"{sign}{rupees:,}.{p:02d}\"\r\n\r\n\r\ndef invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\r\n    \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\r\n    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\r\n    return list(invoice.lines)\r\n\r\n\r\ndef render(invoice: Invoice) -> str:\r\n    taxed = tax_lines(invoice_lines(invoice))\r\n    out = [\r\n        f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\r\n        f\"Customer: {invoice.customer}\",\r\n        \"-\" * WIDTH,\r\n        f\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\",\r\n    ]\r\n    for line in taxed:\r\n        out.append(f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"\r\n                   f\"{money(line.total):>11}\")\r\n    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    out += [\r\n        \"-\" * WIDTH,\r\n        f\"{'Subtotal':<46}{money(subtotal):>34}\",\r\n        f\"{'GST @ 18%':<46}{money(gst):>34}\",\r\n        f\"{'Total due (INR)':<46}{money(subtotal + gst):>34}\",\r\n    ]\r\n    return \"\\n\".join(out) + \"\\n\"\r\n\r\n\r\ndef _inv_0042() -> Invoice:\r\n    return Invoice(\r\n        number=\"INV-2024-0042\",\r\n        customer=\"Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\",\r\n        issued=date(2024, 10, 2),\r\n        lines=[\r\n            (\"Pro (monthly), Oct 2024\", 149900),\r\n            (\"Additional seats x3, Oct 2024\", 74925),\r\n            (\"API overage, 1,001 calls\", 25025),\r\n            (\"Priority support, Oct 2024\", 99900),\r\n        ],\r\n    )\r\n\r\n\r\ndef _inv_0107() -> Invoice:\r\n    upgrade = prorate_to_annual(\"pro-monthly\", \"pro-annual\",\r\n                                Period(date(2024, 11, 1), date(2024, 12, 1)), date(2024, 11, 14))\r\n    return Invoice(\r\n        number=\"INV-2024-0107\",\r\n        customer=\"Halcyon Foods LLP (GSTIN 27FGHIJ5678K1Z2)\",\r\n        issued=date(2024, 11, 14),\r\n        lines=[(f\"{upgrade.new_plan.name}, {upgrade.new_period}\", upgrade.charge)],\r\n        proration=upgrade,\r\n    )\r\n\r\n\r\nFIXTURES = {\"INV-2024-0042\": _inv_0042, \"INV-2024-0107\": _inv_0107}\r\n\r\n\r\ndef regen_golden(directory: Path = GOLDEN_DIR) -> list[Path]:\r\n    directory.mkdir(parents=True, exist_ok=True)\r\n    written = []\r\n    for number, build in sorted(FIXTURES.items()):\r\n        path = directory / f\"{number}.txt\"\r\n        path.write_text(render(build()))\r\n        written.append(path)\r\n    return written\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"billing.invoice\")\r\n    ap.add_argument(\"number\", nargs=\"?\", help=\"fixture to print\")\r\n    ap.add_argument(\"--regen-golden\", action=\"store_true\", help=\"rewrite all golden files\")\r\n    args = ap.parse_args(argv)\r\n    if args.regen_golden:\r\n        print(f\"wrote {len(regen_golden())} golden files\")\r\n        return 0\r\n    if args.number not in FIXTURES:\r\n        ap.error(f\"known fixtures: {', '.join(sorted(FIXTURES))}\")\r\n    sys.stdout.write(render(FIXTURES[args.number]()))\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\"\"\"Billing periods. A period is the half-open date range [start, end).\"\"\"\r\n\r\nfrom __future__ "]
[10.914066, "o", "import annotations\r\n\r\nimport calendar\r\nfrom dataclasses import dataclass\r\nfrom datetime import date\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Period:\r\n    start: date\r\n    end: date  # exclusive\r\n\r\n    def __post_init__(self) -> None:\r\n        if self.end <= self.start:\r\n            raise ValueError(f\"empty period {self.start}..{self.end}\")\r\n\r\n    @property\r\n    def days(self) -> int:\r\n        return (self.end - self.start).days\r\n\r\n    def contains(self, day: date) -> bool:\r\n        return self.start <= day < self.end\r\n\r\n    def __str__(self) -> str:\r\n        return f\"{self.start.isoformat()} → {self.end.isoformat()}\"\r\n\r\n\r\ndef is_leap(year: int) -> bool:\r\n    return calendar.isleap(year)\r\n\r\n\r\ndef add_months(day: date, months: int) -> date:\r\n    \"\"\"Shift by whole months, clamping the day to the target month's length.\"\"\"\r\n    index = day.month - 1 + months\r\n    year, month = day.year + index // 12, index % 12 + 1\r\n    last = calendar.monthrange(year, month)[1]\r\n    return date(year, month, min(day.day, last))\r\n\r\n\r\ndef monthly_period(anchor: date, on: date) -> Period:\r\n    \"\"\"The monthly billing period (anchored on ``anchor``'s day of month) containing ``on``.\"\"\"\r\n    if on < anchor:\r\n        raise ValueError(\"date precedes the subscription anchor\")\r\n    months = (on.year - anchor.year) * 12 + (on.month - anchor.month)\r\n    start = add_months(anchor, months)\r\n    if start > on:\r\n        start = add_months(anchor, months - 1)\r\n    return Period(start, add_months(start, 1))\r\n\r\n\r\ndef annual_period(start: date) -> Period:\r\n    return Period(start, add_months(start, 12))\r\n\r\n\r\ndef remaining_days(period: Period, on: date) -> int:\r\n    \"\"\"Days of ``period`` from ``on`` (inclusive) to the end.\"\"\"\r\n    if not period.contains(on):\r\n        raise ValueError(f\"{on} is outside {period}\")\r\n    return (period.end - on).days\r\n\"\"\"Plan catalogue. All prices are in paise (1/100 INR), exclusive of GST.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n\r\nclass UnknownPlan(KeyError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    code: str\r\n    name: str\r\n    interval: str  # \"month\" or \"year\"\r\n    price: int  # paise per interval, before GST\r\n\r\n    @property\r\n    def is_annual(self) -> bool:\r\n        return self.interval == \"year\"\r\n\r\n\r\nCATALOGUE: dict[str, Plan] = {\r\n    p.code: p\r\n    for p in (\r\n        Plan(\"starter-monthly\", \"Starter (monthly)\", \"month\", 49900),\r\n        Plan(\"pro-monthly\", \"Pro (monthly)\", \"month\", 149900),\r\n        Plan(\"pro-annual\", \"Pro (annual)\", \"year\", 1499000),\r\n        Plan(\"team-monthly\", \"Team (monthly)\", \"month\", 499900),\r\n        Plan(\"team-annual\", \"Team (annual)\", \"year\", 4999000),\r\n    )\r\n}\r\n\r\n\r\ndef get_plan(code: str) -> Plan:\r\n    try:\r\n        return CATALOGUE[code]\r\n    except KeyError:\r\n        raise UnknownPlan(code) from None\r\n\"\"\"GST on invoice lines (SPEC §5). Amounts are integer paise.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\n\r\nGST_RATE = Decimal(\"0.18\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass TaxedLine:\r\n    description: str\r\n    amount: int\r\n    gst: int\r\n\r\n    @property\r\n    def total(self) -> int:\r\n        return self.amount + self.gst\r\n\r\n\r\ndef line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\r\n    \"\"\"GST for one line, rounded half-up (away from zero) to the paisa.\"\"\"\r\n    exact = Decimal(amount) * rate\r\n    return int(exact.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\r\n\r\n\r\ndef tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\r\n    return TaxedLine(description, amount, line_gst(amount, rate))\r\n\r\n\r\ndef tax_lines(lines: list[tuple[str, int]], rate: Decimal = GST_RATE) -> list[TaxedLine]:\r\n    return [tax_line(desc, amount, rate) for desc, amount in lines]\r\n\"\"\"Accounting exports: the finance ledger CSV and the ERP invoice payload (finance-ops, 2023).\r\n\r\n    from billing.export import ledger_csv, erp_payload\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport csv\r\nimport io\r\nimport json\r\nimport re\r\nimport time\r\nimport urllib.error\r\nimport urllib."]
[10.914338, "o", "request\r\nfrom decimal import Decimal\r\n\r\nfrom billing.invoice import Invoice, invoice_lines\r\nfrom billing.tax import tax_lines\r\n\r\nLEDGER_COLUMNS = [\"invoice\", \"issued\", \"gstin\", \"subtotal\", \"gst\", \"total\", \"currency\"]\r\nERP_MAX_LINES = 99          # the ERP rejects invoices with more lines than this\r\nSUPPORTED_CURRENCIES = {\"INR\"}\r\nGSTIN_RE = re.compile(r\"\\(GSTIN ([0-9A-Z]{15})\\)\")\r\n\r\n\r\nclass ExportError(ValueError):\r\n    pass\r\n\r\n\r\ndef gstin_of(invoice: Invoice) -> str:\r\n    \"\"\"The customer's GSTIN, as printed in the customer field: 'Name (GSTIN 29ABCDE1234F1Z5)'.\"\"\"\r\n    m = GSTIN_RE.search(invoice.customer)\r\n    if not m:\r\n        raise ExportError(f\"{invoice.number}: customer has no GSTIN: {invoice.customer!r}\")\r\n    gstin = m.group(1)\r\n    if not gstin[:2].isdigit() or not 1 <= int(gstin[:2]) <= 38:\r\n        raise ExportError(f\"{invoice.number}: GSTIN {gstin} has an invalid state code\")\r\n    return gstin\r\n\r\n\r\ndef totals(invoice: Invoice) -> tuple[int, int, int]:\r\n    taxed = tax_lines(invoice_lines(invoice))\r\n    if not taxed:\r\n        raise ExportError(f\"{invoice.number}: invoice has no lines\")\r\n    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    return subtotal, gst, subtotal + gst\r\n\r\n\r\ndef rupees(paise: int) -> str:\r\n    return str((Decimal(paise) / 100).quantize(Decimal(\"0.01\")))\r\n\r\n\r\ndef ledger_row(invoice: Invoice, currency: str = \"INR\") -> list[str]:\r\n    if currency not in SUPPORTED_CURRENCIES:\r\n        raise ExportError(f\"{invoice.number}: ledger export supports {sorted(SUPPORTED_CURRENCIES)}, not {currency}\")\r\n    subtotal, gst, total = totals(invoice)\r\n    if total < 0:\r\n        # net credit notes go through the finance adjustments flow, not the ledger import\r\n        raise ExportError(f\"{invoice.number}: net total {rupees(total)} is negative; issue a credit note instead\")\r\n    return [invoice.number, invoice.issued.isoformat(), gstin_of(invoice), rupees(subtotal), rupees(gst),\r\n            rupees(total), currency]\r\n\r\n\r\ndef ledger_csv(invoices: list[Invoice], currency: str = \"INR\") -> str:\r\n    \"\"\"Finance's ledger import: one row per invoice, header first, RFC 4180 quoting.\"\"\"\r\n    numbers = [inv.number for inv in invoices]\r\n    dupes = sorted({n for n in numbers if numbers.count(n) > 1})\r\n    if dupes:\r\n        raise ExportError(f\"duplicate invoice numbers in export: {dupes}\")\r\n    buf = io.StringIO()\r\n    writer = csv.writer(buf, lineterminator=\"\\n\")\r\n    writer.writerow(LEDGER_COLUMNS)\r\n    for inv in sorted(invoices, key=lambda i: (i.issued, i.number)):\r\n        writer.writerow(ledger_row(inv, currency))\r\n    return buf.getvalue()\r\n\r\n\r\ndef erp_payload(invoice: Invoice) -> str:\r\n    \"\"\"JSON document for the ERP's invoice endpoint.\"\"\"\r\n    lines = invoice_lines(invoice)\r\n    if len(lines) > ERP_MAX_LINES:\r\n        raise ExportError(f\"{invoice.number}: {len(lines)} lines exceeds the ERP limit of {ERP_MAX_LINES}\")\r\n    taxed = tax_lines(lines)\r\n    subtotal, gst, total = totals(invoice)\r\n    doc = {\r\n        \"invoice_number\": invoice.number,\r\n        \"issue_date\": invoice.issued.isoformat(),\r\n        \"buyer_gstin\": gstin_of(invoice),\r\n        \"lines\": [{\"description\": t.description, \"amount\": rupees(t.amount), \"gst\": rupees(t.gst)}\r\n                  for t in taxed],\r\n        \"subtotal\": rupees(subtotal),\r\n        \"gst\": rupees(gst),\r\n        \"total\": rupees(total),\r\n    }\r\n    if invoice.proration is not None:\r\n        doc[\"proration\"] = {\"old_plan\": invoice.proration.old_plan.code,\r\n                            \"new_plan\": invoice.proration.new_plan.code,\r\n                            \"unused_days\": invoice.proration.unused_days}\r\n    return json.dumps(doc, sort_keys=True)\r\n\r\n\r\n# --- delivery to the ERP gateway ---------------------------------------------------------------------\r\nERP_URL = \"https://erp-gateway.finance.internal/v2/invoices\"\r\nMAX_ATTEMPTS = 4\r\nBACKOFF_S = (1, 4, 15)\r\n\r\n\r\nclass DeliveryError(RuntimeError):\r\n    pass\r\n\r\n\r\ndef send_to_erp(invoice: Invoice, url: str = ERP_URL, token: str | None = None) -> str:\r\n    \"\"\"POST the invoice's ERP payload; retry 429/5x"]
[10.914362, "o", "x and connection errors with backoff.\r\n    Returns the ERP document id. 4xx other than 429 are permanent and are not retried.\"\"\"\r\n    body = erp_payload(invoice).encode()\r\n    headers = {\"content-type\": \"application/json\", \"idempotency-key\": f\"inv-{invoice.number}\"}\r\n    if token:\r\n        headers[\"authorization\"] = f\"Bearer {token}\"\r\n    last = \"\"\r\n    for attempt in range(MAX_ATTEMPTS):\r\n        req = urllib.request.Request(url, data=body, headers=headers, method=\"POST\")\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=20) as resp:\r\n                doc = json.loads(resp.read().decode())\r\n                if \"document_id\" not in doc:\r\n                    raise DeliveryError(f\"{invoice.number}: ERP accepted the invoice but returned no document_id\")\r\n                return doc[\"document_id\"]\r\n        except urllib.error.HTTPError as exc:\r\n            if exc.code == 409:\r\n                # already delivered under this idempotency key: the ERP returns the existing document\r\n                existing = json.loads(exc.read().decode() or \"{}\").get(\"document_id\")\r\n                if existing:\r\n                    return existing\r\n                raise DeliveryError(f\"{invoice.number}: duplicate delivery without a document id\") from exc\r\n            if exc.code != 429 and exc.code < 500:\r\n                raise DeliveryError(f\"{invoice.number}: ERP rejected the invoice ({exc.code})\") from exc\r\n            last = f\"HTTP {exc.code}\"\r\n        except urllib.error.URLError as exc:\r\n            last = f\"connection error: {exc.reason}\"\r\n        if attempt < MAX_ATTEMPTS - 1:\r\n            time.sleep(BACKOFF_S[min(attempt, len(BACKOFF_S) - 1)])\r\n    raise DeliveryError(f\"{invoice.number}: ERP delivery failed after {MAX_ATTEMPTS} attempts ({last})\")\r\n\u001b[?2004h"]
