[102.266826, "i", "cat > tests/test_annual_upgrade.py <<'PY'\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"starter-monthly\", \"pro-monthly\"),\n])\ndef test_only_monthly_to_annual_is_allowed(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 31), 1, 1610),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 1721),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 28), 1, 1782),\n    (date(2024, 1, 31), date(2024, 2, 29), date(2024, 2, 14), 15, 25810),\n])\ndef test_upgrade_uses_actual_days_and_can_change_plan_tier(start, end, on, unused, credit):\n    period = Period(start, end)\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert (result.unused_days, result.credit) == (unused, credit)\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_credit_rounds_exact_half_paisa_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"tiny-monthly\", Plan(\"tiny-monthly\", \"Tiny\", \"month\", 1))\n    period = Period(date(2023, 2, 1), date(2023, 3, 1))\n    result = prorate_to_annual(\"tiny-monthly\", \"pro-annual\", period, date(2023, 2, 15))\n    assert result.unused_days == 14\n    assert result.credit == 1\n\n\ndef test_upgrade_invoice_credit_is_appended_once_without_mutation():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    inv.proration = None\n    assert invoice.invoice_lines(inv) == original\n\n\n@pytest.mark.parametrize(\"credit\", [0, 25])\ndef test_proration_credit_is_taxed_per_line_even_when_zero(credit):\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    inv.proration = replace(inv.proration, credit=credit, charge=50)\n    inv.lines = [(\"Annual charge\", 50)]\n    rows = invoice.render(inv).splitlines()\n    assert rows[5][52:64].strip() == invoice.money(-credit)\n    assert rows[5][64:75].strip() == invoice.money(-line_gst(credit))\n    assert rows[-2][52:].strip() == invoice.money(9 - line_gst(credit))\n    assert rows[-1][52:].strip() == invoice.money(59 - credit - line_gst(credit))\n    assert len(invoice.invoice_lines(inv)) == 2\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_sac_column_and_invoice_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert all(len(row) == 86 for i, row in enumerate(rows) if i != 1)\n    assert rows[3][44:52] == \"     SAC\"\n    for row in rows[4:-4]:\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n    assert rows[-4] == \"-\" * 86\n\n\ndef test_description_truncation_leaves_a_blank_before_sac():\n    inv = invoice.Invoice(\"LONG\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == \"x\" * 43 + \" \"\n    assert row[44:52] ="]
[102.269053, "i", "= \"  998314\"\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (-125, -23), (25, 5), (-25, -5)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_credit_flows_through_accounting_exports():\n    import json\n\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"][1] == {\n        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n        \"amount\": \"-849.43\", \"gst\": \"-152.90\",\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert ledger_csv([inv]).splitlines()[1].endswith(\",14140.57,2545.30,16685.87,INR\")\n\n\ndef test_golden_regeneration_and_invoice_cli(tmp_path, monkeypatch, capsys):\n    regenerate = invoice.regen_golden\n    paths = regenerate(tmp_path)\n    assert {path.stem for path in paths} == set(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n    with pytest.raises(SystemExit) as exc:\n        invoice.main([\"unknown\"])\n    assert exc.value.code == 2\n    assert \"known fixtures\" in capsys.readouterr().err\nPY\n"]
