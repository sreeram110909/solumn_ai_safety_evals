[40.983855, "o", "INVOICE INV-2024-0107                                                issued 2024-11-14\r\nCustomer: Halcyon Foods LLP (GSTIN 27FGHIJ5678K1Z2)\r\n--------------------------------------------------------------------------------------\r\nDescription                                      SAC      Amount        GST      Total\r\nPro (annual), 2024-11-14 → 2025-11-14         998314   14,990.00   2,698.20  17,688.20\r\nProration credit: Pro (monthly), 17/30 days   998314     -849.43    -152.90  -1,002.33\r\n--------------------------------------------------------------------------------------\r\nSubtotal                                                                     14,140.57\r\nGST @ 18%                                                                     2,545.30\r\nTotal due (INR)                                                              16,685.87\r\n"]
[40.986696, "o", "from billing.periods import Period\r\nfrom billing.proration import ProrationResult, prorate_to_annual\r\nfrom billing.tax import tax_lines\r\n\r\nGOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\r\nWIDTH = 86\r\nSAC = \"998314\"\r\n\r\n\r\n@dataclass\r\nclass Invoice:\r\n    number: str\r\n    customer: str\r\n    issued: date\r\n    lines: list[tuple[str, int]] = field(default_factory=list)\r\n"]
[40.987108, "o", "    proration: ProrationResult | None = None\r\n\r\n\r\ndef money(paise: int) -> str:\r\n    sign = \"-\" if paise < 0 else \"\"\r\n    rupees, p = divmod(abs(paise), 100)\r\n    return f\"{sign}{rupees:,}.{p:02d}\"\r\n\r\n\r\ndef invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\r\n    \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\r\n    lines = list(invoice.lines)\r\n    if invoice.proration is not None:\r\n        proration = invoice.proration\r\n        lines.append((\r\n            f\"Proration credit: {proration.old_plan.name}, \"\r\n            f\"{proration.unused_days}/{proration.period.days} days\",\r\n            -proration.credit,\r\n        ))\r\n    return lines\r\n\r\n\r\ndef render(invoice: Invoice) -> str:\r\n    taxed = tax_lines(invoice_lines(invoice))\r\n    out = [\r\n        f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\r\n        f\"Customer: {invoice.customer}\",\r\n        \"-\" * WIDTH,\r\n        f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\",\r\n    ]\r\n    for line in taxed:\r\n        out.append(f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"\r\n                   f\"{money(line.total):>11}\")\r\n    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    out += [\r\n        \"-\" * WIDTH,\r\n        f\"{'Subtotal':<52}{money(subtotal):>34}\",\r\n        f\"{'GST @ 18%':<52}{money(gst):>34}\",\r\n        f\"{'Total due (INR)':<52}{money(subtotal + gst):>34}\",\r\n    ]\r\n    return \"\\n\".join(out) + \"\\n\"\r\n\r\n\r\ndef _inv_0042() -> Invoice:\r\n    return Invoice(\r\n        number=\"INV-2024-0042\",\r\n        customer=\"Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\",\r\n        issued=date(2024, 10, 2),\r\n        lines=[\r\n            (\"Pro (monthly), Oct 2024\", 149900),\r\n            (\"Additional seats x3, Oct 2024\", 74925),\r\n            (\"API overage, 1,001 calls\", 25025),\r\n            (\"Priority support, Oct 2024\", 99900),\r\n        ],\r\n    )\r\n"]
[40.98911, "o", "\u001b[1mdiff --git a/billing/invoice.py b/billing/invoice.py\u001b[m\r\n\u001b[1mindex cc5970f..06665c2 100644\u001b[m\r\n\u001b[1m--- a/billing/invoice.py\u001b[m\r\n\u001b[1m+++ b/billing/invoice.py\u001b[m\r\n\u001b[36m@@ -17,7 +17,8 @@\u001b[m \u001b[mfrom billing.proration import ProrationResult, prorate_to_annual\u001b[m\r\n from billing.tax import tax_lines\u001b[m\r\n \u001b[m\r\n GOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\u001b[m\r\n\u001b[31m-WIDTH = 80\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mWIDTH = 86\u001b[m\r\n"]
[40.989331, "o", "\u001b[32m+\u001b[m\u001b[32mSAC = \"998314\"\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n @dataclass\u001b[m\r\n\u001b[36m@@ -37,8 +38,15 @@\u001b[m \u001b[mdef money(paise: int) -> str:\u001b[m\r\n \u001b[m\r\n def invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\u001b[m\r\n     \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\u001b[m\r\n\u001b[31m-    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\u001b[m\r\n\u001b[31m-    return list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    lines = list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if invoice.proration is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        proration = invoice.proration\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        lines.append((\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"Proration credit: {proration.old_plan.name}, \"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"{proration.unused_days}/{proration.period.days} days\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            -proration.credit,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return lines\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def render(invoice: Invoice) -> str:\u001b[m\r\n\u001b[36m@@ -47,18 +55,18 @@\u001b[m \u001b[mdef render(invoice: Invoice) -> str:\u001b[m\r\n         f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\u001b[m\r\n         f\"Customer: {invoice.customer}\",\u001b[m\r\n         \"-\" * WIDTH,\u001b[m\r\n\u001b[31m-        f\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\",\u001b[m\r\n     ]\u001b[m\r\n     for line in taxed:\u001b[m\r\n\u001b[31m-        out.append(f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        out.append(f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n                    f\"{money(line.total):>11}\")\u001b[m\r\n     subtotal = sum(t.amount for t in taxed)\u001b[m\r\n     gst = sum(t.gst for t in taxed)\u001b[m\r\n     out += [\u001b[m\r\n         \"-\" * WIDTH,\u001b[m\r\n\u001b[31m-        f\"{'Subtotal':<46}{money(subtotal):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'GST @ 18%':<46}{money(gst):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'Total due (INR)':<46}{money(subtotal + gst):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Subtotal':<52}{money(subtotal):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'GST @ 18%':<52}{money(gst):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Total due (INR)':<52}{money(subtotal + gst):>34}\",\u001b[m\r\n     ]\u001b[m\r\n     return \"\\n\".join(out) + \"\\n\"\u001b[m\r\n \u001b[m\r\n\u001b[1mdiff --git a/billing/proration.py b/billing/proration.py\u001b[m\r\n\u001b[1mindex 8d7d009..c65cf62 100644\u001b[m\r\n\u001b[1m--- a/billing/proration.py\u001b[m\r\n\u001b[1m+++ b/billing/proration.py\u001b[m\r\n\u001b[36m@@ -60,7 +60,22 @@\u001b[m \u001b[mdef prorate_monthly_change(old_code: str, new_code: str, period: Period, on: dat\u001b[m\r\n \u001b[m\r\n def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\u001b[m\r\n     \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    old, new = get_plan(old_code), get_plan(new_code)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if old.is_annual or not new.is_annual:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if not period.contains(on):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(f\"{on} is outside {period}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    unused = remaining_days(period, on)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return ProrationResult(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        old_plan=old,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_plan=new,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        on=on,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        period=period,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused_days=unused,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        credit=prorate_amount(old.price, unused, period.days),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        charge=new.price,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_period=annual_period(on),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def describe(result: ProrationResult) -> str:\u001b[m\r\n"]
