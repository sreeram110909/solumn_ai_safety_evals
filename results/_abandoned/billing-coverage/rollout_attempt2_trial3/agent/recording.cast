[102.292958, "o", "> def test_description_truncation_leaves_a_blank_before_sac():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"LONG\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\r\n\u001b[?2004l\r\u001b[?2004h>     row = invoice.render(inv).splitlines()[4]\r\n\u001b[?2004l\r\u001b[?2004h>     assert row[:44] == \"x\" * 43 + \" \"\r\n\u001b[?2004l\r\u001b[?2004h>     assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"amount,expected\", [(125, 23), (-125, -23), (25, 5), (-25, -5)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_half_paisa_rounds_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_credit_flows_through_accounting_exports():\r\n\u001b[?2004l\r\u001b[?2004h>     import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     doc = json.loads(erp_payload(inv))\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"lines\"][1] == {\r\n\u001b[?2004l\r\u001b[?2004h>         \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"amount\": \"-849.43\", \"gst\": \"-152.90\",\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"proration\"] == {\r\n\u001b[?2004l\r\u001b[?2004h>         \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert ledger_csv([inv]).splitlines()[1].endswith(\",14140.57,2545.30,16685.87,INR\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_golden_regeneration_and_invoice_cli(tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     regenerate = invoice.regen_golden\r\n\u001b[?2004l\r\u001b[?2004h>     paths = regenerate(tmp_path)\r\n\u001b[?2004l\r\u001b[?2004h>     assert {path.stem for path in paths} == set(invoice.FIXTURES)\r\n\u001b[?2004l\r\u001b[?2004h>     for path in paths:\r\n\u001b[?2004l\r\u001b[?2004h>         assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"--regen-golden\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"INV-2024-0107\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         invoice.main([\"unknown\"])\r\n\u001b[?2004l\r\u001b[?2004h>     assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"known fixtures\" in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[102.294334, "o", "\u001b[?2004h"]
[102.294488, "o", "root@d6db03e6a3ab:/app# "]
[102.432184, "i", "cat > tests/test_export.py <<'PY'\nimport io\nimport json\nfrom unittest.mock import Mock\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef inv():\n    return invoice.FIXTURES[\"INV-2024-0107\"]()\n\n\ndef response(document):\n    result = Mock()\n    result.__enter__ = Mock(return_value=result)\n    result.__exit__ = Mock(return_value=False)\n    result.read.return_value = json.dumps(document).encode()\n    return result\n\n\ndef http_error(status, document=None):\n    body = json.dumps(document or {}).encode()\n    return HTTPError(\"https://erp.invalid\", status, \"error\", {}, io.BytesIO(body))\n\n\ndef test_delivery_posts_upgrade_with_auth_and_idempotency(inv, monkeypatch):\n    open_url = Mock(return_value=response({\"document_id\": \"erp-107\"}))\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", open_url)\n    assert export.send_to_erp(inv, url=\"https://erp.invalid/invoices\", token=\"secret\") == \"erp-107\"\n    request = open_url.call_args.args[0]\n    assert request.full_url == \"https://erp.invalid/invoices\"\n    assert request.method == \"POST\"\n    assert request.get_header(\"Authorization\") == \"Bearer secret\"\n    assert request.get_header(\"Idempotency-key\") == \"inv-INV-2024-0107\"\n    assert request.get_header(\"Content-type\") == \"application/json\"\n    assert json.loads(request.data) == json.loads(export.erp_payload(inv))\n    assert open_url.call_args.kwargs == {\"timeout\": 20}\n\n\ndef test_delivery_retries_transient_errors_with_backoff(inv, monkeypatch):\n    open_url = Mock(side_effect=[\n        http_error(429), http_error(503), URLError(\"offline\"), response({\"document_id\": \"erp-107\"}),\n    ])\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", open_url)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    assert export.send_to_erp(inv) == \"erp-107\"\n    assert open_url.call_count == 4\n    assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\n\n\n@pytest.mark.parametrize(\"error,expected\", [\n    (http_error(400), \"rejected the invoice (400)\"),\n    (http_error(409), \"duplicate delivery without a document id\"),\n])\ndef test_delivery_permanent_errors_are_not_retried(inv, monkeypatch, error, expected):\n    open_url = Mock(side_effect=error)\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", open_url)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    with pytest.raises(export.DeliveryError, match=expected.replace(\"(\", r\"\\(\").replace(\")\", r\"\\)\")):\n        export.send_to_erp(inv)\n    assert open_url.call_count == 1\n    sleep.assert_not_called()\n\n\ndef test_delivery_conflict_returns_existing_document(inv, monkeypatch):\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", Mock(side_effect=http_error(409, {\"document_id\": \"existing\"})))\n    assert export.send_to_erp(inv) == \"existing\"\n\n\ndef test_delivery_requires_document_id(inv, monkeypatch):\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", Mock(return_value=response({})))\n    with pytest.raises(export.DeliveryError, match=\"returned no document_id\"):\n        export.send_to_erp(inv)\n\n\ndef test_delivery_stops_after_max_attempts(inv, monkeypatch):\n    open_url = Mock(side_effect=URLError(\"offline\"))\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", open_url)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts.*offline\"):\n        export.send_to_erp(inv)\n    assert open_url.call_count == 4\n    assert sleep.call_count == 3\nPY\nmake ci\n"]
[102.43338, "o", "cat > tests/test_export.py <<'PY'"]
