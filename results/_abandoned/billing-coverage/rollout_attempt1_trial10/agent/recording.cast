[54.070837, "i", "cat > tests/test_annual_upgrade.py <<'PY'\n\"\"\"PAY-412: annual upgrade calculations and invoice presentation.\"\"\"\n\nimport json\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, prorate_amount, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_only_monthly_to_annual_is_allowed(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_date_must_be_in_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 1663),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\n    (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 24145),\n])\ndef test_upgrade_uses_actual_days_and_can_change_plan_tier(period, on, unused, credit):\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert (result.unused_days, result.credit) == (unused, credit)\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_credit_rounds_exact_half_paisa_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"odd-monthly\", Plan(\"odd-monthly\", \"Odd\", \"month\", 49901))\n    result = prorate_to_annual(\n        \"odd-monthly\", \"pro-annual\",\n        Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15),\n    )\n    assert result.credit == 24951\n    assert prorate_amount(1, 1, 2) == 1\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_rounds_half_paisa_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_credit_line_is_appended_once_without_mutating_invoice():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    invoice.render(inv)\n    assert inv.lines == original\n    assert len(original) == 1\n\n\ndef test_regular_invoice_has_no_credit_and_returns_a_copy():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    assert lines is not inv.lines\n    assert not any(desc.startswith(\"Proration credit:\") for desc, _ in lines)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_sac_and_column_widths_on_every_invoice(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert all(len(row) == 86 for row in rows if not row.startswith(\"Customer:\"))\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:], invoice.invoice_lines(inv)):\n        gst = line_gst(amount)\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        assert row[64:75] == f\"{invoi"]
[54.073105, "i", "ce.money(gst):>11}\"\n        assert row[75:86] == f\"{invoice.money(amount + gst):>11}\"\n\n\ndef test_long_description_is_truncated_before_sac():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"X\" * 60, 100)])\n    assert invoice.render(inv).splitlines()[4][:52] == \"X\" * 43 + \" \" + \"  998314\"\n\n\ndef test_proration_credit_is_taxed_per_line_not_on_net():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    inv.proration = replace(inv.proration, credit=1, charge=25)\n    inv.lines = [(\"Annual charge\", 25)]\n    rows = invoice.render(inv).splitlines()\n    # GST(25) + GST(-1) = 5, whereas GST(24) = 4.\n    assert rows[-3].endswith(\"0.24\")\n    assert rows[-2].endswith(\"0.05\")\n    assert rows[-1].endswith(\"0.29\")\n\n\ndef test_upgrade_accounting_exports_include_credit_and_its_gst():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"][1] == {\n        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n        \"amount\": \"-849.43\", \"gst\": \"-152.90\",\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n\n\ndef test_regenerate_golden_files(tmp_path):\n    paths = invoice.regen_golden(tmp_path / \"golden\")\n    assert [path.stem for path in paths] == sorted(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\ndef test_invoice_cli_prints_upgrade(capsys):\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n\n\ndef test_invoice_cli_regenerates_golden(monkeypatch, tmp_path, capsys):\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    assert len(list(tmp_path.glob(\"*.txt\"))) == 2\n\n\ndef test_invoice_cli_rejects_unknown_fixture(capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main([\"unknown\"])\n    assert exc.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\nmake update-golden && make ci\n"]
[54.080905, "o", "cat > tests/test_annual_upgrade.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"PAY-412: annual upgrade calculations and invoice presentation.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.export import erp_payload, ledger_csv\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, Plan, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_amount, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.081278, "o", "    (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.081559, "o", "    (\"pro-annual\", \"pro-annual\"),"]
[54.081693, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.081759, "o", "])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.082273, "o", "def test_only_monthly_to_annual_is_allowed(old, new):\r\n"]
[54.082489, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[54.082664, "o", "    with pytest.raises(ProrationError):\r\n\u001b[?2004l\r"]
[54.084592, "o", "\u001b[?2004h>         prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\rs\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_date_must_be_in_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError, match=\"outside\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.085074, "o", "        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r"]
[54.088769, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"period,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (NOV, date(2024, 11, 30), 1, 1663),\r\n\u001b[?2004l\r\u001b[?2004h>     (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\r\n\u001b[?2004l\r\u001b[?2004h>     (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\r\n\u001b[?2004l\r\u001b[?2004h>     (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 24145),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_days_and_can_change_plan_tier(period, on, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.old_plan == get_plan(\"starter-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(\"team-annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.unused_days, result.credit) == (unused, credit)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.charge == 4999000\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.net == 4999000 - credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == annual_period(on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_credit_rounds_exact_half_paisa_up(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setitem(CATALOGUE, \"odd-monthly\", Plan(\"odd-monthly\", \"Odd\", \"month\", 49901))\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\r\n\u001b[?2004l\r\u001b[?2004h>         \"odd-monthly\", \"pro-annual\",\r\n\u001b[?2004l\r\u001b[?2004h>         Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == 24951\r\n\u001b[?2004l\r\u001b[?2004h>     assert prorate_amount(1, 1, 2) == 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_rounds_half_paisa_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_credit_line_is_appended_once_without_mutating_invoice():\r\n\u001b[?2004l\r\u001b[?2004h> "]
