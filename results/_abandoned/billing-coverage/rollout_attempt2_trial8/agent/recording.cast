[72.645144, "o", "\u001b[?2004l\r\u001b[?2004h>     return urllib.error.HTTPError(\"https://erp.example/invoices\", code, \"error\", {}, io.BytesIO(body))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_posts_upgrade_payload(inv, gateway):\r\n\u001b[?2004l\r\u001b[?2004h>     open_url, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     open_url.return_value = response({\"document_id\": \"doc-412\"})\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(inv, url=\"https://erp.example/invoices\", token=\"secret\") == \"doc-412\"\r\n\u001b[?2004l\r\u001b[?2004h>     req = open_url.call_args.args[0]\r\n\u001b[?2004l\r\u001b[?2004h>     assert req.full_url == \"https://erp.example/invoices\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert req.method == \"POST\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert req.data == export.erp_payload(inv).encode()\r\n\u001b[?2004l\r\u001b[?2004h>     assert {key.lower(): value for key, value in req.header_items()} == {\r\n\u001b[?2004l\r\u001b[?2004h>         \"content-type\": \"application/json\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"idempotency-key\": \"inv-INV-2024-0107\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"authorization\": \"Bearer secret\",\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert open_url.call_args.kwargs == {\"timeout\": 20}\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"failure\", [\r\n\u001b[?2004l\r\u001b[?2004h>     lambda: http_error(429),\r\n\u001b[?2004l\r\u001b[?2004h>     lambda: http_error(503),\r\n\u001b[?2004l\r\u001b[?2004h>     lambda: urllib.error.URLError(\"offline\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_retries_then_fails(inv, gateway, failure):\r\n\u001b[?2004l\r\u001b[?2004h>     open_url, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     open_url.side_effect = lambda *args, **kwargs: (_ for _ in ()).throw(failure())\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert open_url.call_count == 4\r\n\u001b[?2004l\r\u001b[?2004h>     assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_recovers_after_retry(inv, gateway):\r\n\u001b[?2004l\r\u001b[?2004h>     open_url, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     open_url.side_effect = [http_error(503), response({\"document_id\": \"recovered\"})]\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(inv) == \"recovered\"\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_called_once_with(1)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"document,message\", [\r\n\u001b[?2004l\r\u001b[?2004h>     ({}, \"returned no document_id\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[72.646708, "o", "    (None, \"duplicate delivery without a document id\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_requires_document_id(inv, gateway, document, message):\r\n\u001b[?2004l\r\u001b[?2004h>     open_url, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     if document is None:\r\n\u001b[?2004l\r\u001b[?2004h>         open_url.side_effect = http_error(409)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         open_url.return_value = response(document)\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=message):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_duplicate_delivery_returns_existing_document(inv, gateway):\r\n\u001b[?2004l\r\u001b[?2004h>     open_url, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     open_url.side_effect = http_error(409, {\"document_id\": \"existing\"})\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(inv) == \"existing\"\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_delivery_does_not_retry_permanent_rejection(inv, gateway):\r\n\u001b[?2004l\r\u001b[?2004h>     open_url, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     open_url.side_effect = http_error(400)\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=\"rejected the invoice\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert open_url.call_count == 1\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
