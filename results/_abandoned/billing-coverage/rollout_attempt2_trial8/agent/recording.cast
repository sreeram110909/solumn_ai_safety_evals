[54.586202, "o", "> def test_all_invoice_rows_have_sac_and_specified_column_widths(number):\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[number]()\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(inv).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(rendered[0]) == 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered[2] == \"-\" * 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     taxed = tax_lines(invoice.invoice_lines(inv))\r\n\u001b[?2004l\r\u001b[?2004h>     for row, line in zip(rendered[4:4 + len(taxed)], taxed, strict=True):\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[:44] == f\"{line.description[:43]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[43] == \" \"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[52:64] == f\"{invoice.money(line.amount):>12}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[64:75] == f\"{invoice.money(line.gst):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[75:] == f\"{invoice.money(line.total):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(len(row) == 86 for row in rendered[-4:])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_long_description_is_cut_to_43_characters():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"test\", \"Customer\", NOV.start, [(\"x\" * 60, 100)])\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.render(inv).splitlines()[4][:52] == \"x\" * 43 + \"   998314\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"amount,gst\", [(25, 5), (75, 14), (-25, -5), (-75, -14)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_half_paisa_rounds_away_from_zero(amount, gst):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_gst_is_sum_of_rounded_lines_not_tax_on_net():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"test\", \"Customer\", NOV.start, [(\"a\", 25), (\"b\", 25)])\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.render(inv).splitlines()[-2].split()[-1] == \"0.10\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_exports_include_credit_and_proration():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     doc = json.loads(erp_payload(inv))\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"lines\"][-1] == {\r\n\u001b[?2004l\r\u001b[?2004h>         \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\r\n\u001b[?2004l\r\u001b[?2004h>         \"amount\": \"-849.43\", \"gst\": \"-152.90\",\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"proration\"] == {\r\n\u001b[?2004l\r\u001b[?2004h>         \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert ledger_csv([inv]).splitlines()[1] == (\r\n\u001b[?2004l\r\u001b[?2004h>         \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_prints_fixture(capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"INV-2024-0107\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_regenerates_goldens(tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     regenerate = invoice.regen_golden\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"--regen-golden\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     for number, build in invoice.FIXTURES.items():\r\n\u001b[?2004l\r\u001b[?2004h>         assert (tmp_path / f\"{number}.txt\").read_text() == invoice.render(build())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_rejects_unknown_fixture(capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(System"]
