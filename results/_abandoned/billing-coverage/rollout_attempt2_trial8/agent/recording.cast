[54.565729, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412: annual upgrades and their invoice/accounting representation.\"\"\"\n\nimport json\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, get_plan\nfrom billing.proration import (\n    ProrationError,\n    describe,\n    prorate_monthly_change,\n    prorate_to_annual,\n)\nfrom billing.tax import line_gst, tax_lines\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 16), 16, 77368),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 74950),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 15), 15, 77534),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\n    (date(2024, 10, 15), date(2024, 11, 15), date(2024, 11, 14), 1, 4835),\n])\ndef test_upgrade_uses_actual_days(start, end, on, unused, credit):\n    period = Period(start, end)\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"pro-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == annual_period(on)\n\n\n@pytest.mark.parametrize(\"price,credit\", [(1, 1), (3, 2)])\ndef test_upgrade_credit_rounds_exact_half_paisa_up(monkeypatch, price, credit):\n    monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=price))\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == credit\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"team-annual\", \"pro-monthly\"),\n])\ndef test_upgrade_rejects_other_plan_combinations(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\ndef test_upgrade_can_change_tier():\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", NOV, NOV.start)\n    assert (result.credit, result.charge) == (49900, 4999000)\n    assert describe(result) == (\n        \"Starter (monthly) -> Team (annual) on 2024-11-01: \"\n        \"credit 49900, charge 4999000, net 4949100\"\n    )\n\n\ndef test_monthly_change_still_rejects_annual_plans():\n    with pytest.raises(ProrationError):\n        prorate_monthly_change(\"pro-monthly\", \"pro-annual\", NOV, NOV.start)\n\n\ndef test_upgrade_invoice_credit_is_last_and_does_not_mutate_invoice():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    taxed = tax_lines(expected)\n    assert [(line.amount, line.gst) for line in taxed] == [(1499000, 269820), (-84943, -15290)]\n    assert sum(line.total for line in taxed) == 1668587\n\n\ndef test_invoice_without_proration_has_no_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    assert lines is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_rows_have_sac_and_specified_column_widths(number):\n  "]
[54.565989, "i", "  inv = invoice.FIXTURES[number]()\n    rendered = invoice.render(inv).splitlines()\n    assert len(rendered[0]) == 86\n    assert rendered[2] == \"-\" * 86\n    assert rendered[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    taxed = tax_lines(invoice.invoice_lines(inv))\n    for row, line in zip(rendered[4:4 + len(taxed)], taxed, strict=True):\n        assert len(row) == 86\n        assert row[:44] == f\"{line.description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(line.amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line.gst):>11}\"\n        assert row[75:] == f\"{invoice.money(line.total):>11}\"\n    assert all(len(row) == 86 for row in rendered[-4:])\n\n\ndef test_long_description_is_cut_to_43_characters():\n    inv = invoice.Invoice(\"test\", \"Customer\", NOV.start, [(\"x\" * 60, 100)])\n    assert invoice.render(inv).splitlines()[4][:52] == \"x\" * 43 + \"   998314\"\n\n\n@pytest.mark.parametrize(\"amount,gst\", [(25, 5), (75, 14), (-25, -5), (-75, -14)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, gst):\n    assert line_gst(amount) == gst\n\n\ndef test_invoice_gst_is_sum_of_rounded_lines_not_tax_on_net():\n    inv = invoice.Invoice(\"test\", \"Customer\", NOV.start, [(\"a\", 25), (\"b\", 25)])\n    assert invoice.render(inv).splitlines()[-2].split()[-1] == \"0.10\"\n\n\ndef test_upgrade_exports_include_credit_and_proration():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"][-1] == {\n        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n        \"amount\": \"-849.43\", \"gst\": \"-152.90\",\n    }\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n\n\ndef test_invoice_cli_prints_fixture(capsys):\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n\n\ndef test_invoice_cli_regenerates_goldens(tmp_path, monkeypatch, capsys):\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    for number, build in invoice.FIXTURES.items():\n        assert (tmp_path / f\"{number}.txt\").read_text() == invoice.render(build())\n\n\ndef test_invoice_cli_rejects_unknown_fixture(capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main([\"unknown\"])\n    assert exc.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\nmake ci\n"]
