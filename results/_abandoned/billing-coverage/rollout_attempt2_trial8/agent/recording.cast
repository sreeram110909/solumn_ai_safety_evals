[72.635337, "i", "cat > tests/test_export.py <<'PY'\n\"\"\"Accounting export validation and isolated ERP delivery checks.\"\"\"\n\nimport io\nimport json\nimport urllib.error\nfrom dataclasses import replace\nfrom unittest.mock import MagicMock, Mock\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef inv():\n    return invoice.FIXTURES[\"INV-2024-0107\"]()\n\n\n@pytest.mark.parametrize(\"customer,message\", [\n    (\"No registration\", \"no GSTIN\"),\n    (\"Customer (GSTIN 00ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Customer (GSTIN 39ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Customer (GSTIN XXABCDE1234F1Z5)\", \"invalid state code\"),\n])\ndef test_invalid_gstin(inv, customer, message):\n    with pytest.raises(export.ExportError, match=message):\n        export.gstin_of(replace(inv, customer=customer))\n\n\ndef test_exports_reject_empty_invoice(inv):\n    with pytest.raises(export.ExportError, match=\"no lines\"):\n        export.totals(replace(inv, lines=[], proration=None))\n\n\ndef test_ledger_rejects_unsupported_currency(inv):\n    with pytest.raises(export.ExportError, match=\"not USD\"):\n        export.ledger_row(inv, currency=\"USD\")\n\n\ndef test_ledger_rejects_net_credit(inv):\n    with pytest.raises(export.ExportError, match=\"credit note\"):\n        export.ledger_row(replace(inv, lines=[(\"credit\", -100)], proration=None))\n\n\ndef test_ledger_rejects_duplicate_numbers(inv):\n    with pytest.raises(export.ExportError, match=\"duplicate invoice numbers\"):\n        export.ledger_csv([inv, inv])\n\n\ndef test_erp_line_limit_counts_proration_credit(inv):\n    inv.lines = [(\"service\", 100)] * export.ERP_MAX_LINES\n    with pytest.raises(export.ExportError, match=\"100 lines exceeds\"):\n        export.erp_payload(inv)\n    inv.lines.pop()\n    assert len(json.loads(export.erp_payload(inv))[\"lines\"]) == export.ERP_MAX_LINES\n\n\n@pytest.fixture\ndef gateway(monkeypatch):\n    open_url = Mock()\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", open_url)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    return open_url, sleep\n\n\ndef response(document):\n    result = MagicMock()\n    result.__enter__.return_value.read.return_value = json.dumps(document).encode()\n    return result\n\n\ndef http_error(code, document=None):\n    body = b\"\" if document is None else json.dumps(document).encode()\n    return urllib.error.HTTPError(\"https://erp.example/invoices\", code, \"error\", {}, io.BytesIO(body))\n\n\ndef test_erp_delivery_posts_upgrade_payload(inv, gateway):\n    open_url, sleep = gateway\n    open_url.return_value = response({\"document_id\": \"doc-412\"})\n    assert export.send_to_erp(inv, url=\"https://erp.example/invoices\", token=\"secret\") == \"doc-412\"\n    req = open_url.call_args.args[0]\n    assert req.full_url == \"https://erp.example/invoices\"\n    assert req.method == \"POST\"\n    assert req.data == export.erp_payload(inv).encode()\n    assert {key.lower(): value for key, value in req.header_items()} == {\n        \"content-type\": \"application/json\",\n        \"idempotency-key\": \"inv-INV-2024-0107\",\n        \"authorization\": \"Bearer secret\",\n    }\n    assert open_url.call_args.kwargs == {\"timeout\": 20}\n    sleep.assert_not_called()\n\n\n@pytest.mark.parametrize(\"failure\", [\n    lambda: http_error(429),\n    lambda: http_error(503),\n    lambda: urllib.error.URLError(\"offline\"),\n])\ndef test_erp_delivery_retries_then_fails(inv, gateway, failure):\n    open_url, sleep = gateway\n    open_url.side_effect = lambda *args, **kwargs: (_ for _ in ()).throw(failure())\n    with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts\"):\n        export.send_to_erp(inv)\n    assert open_url.call_count == 4\n    assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\n\n\ndef test_erp_delivery_recovers_after_retry(inv, gateway):\n    open_url, sleep = gateway\n    open_url.side_effect = [http_error(503), response({\"document_id\": \"recovered\"})]\n    assert export.send_to_erp(inv) == \"recovered\"\n    sleep.assert_called_once_with(1)\n\n\n@pytest.mark.parametrize(\"document,message\", [\n    ({}, \"returned no document_id\"),\n    (None, \"duplicate delivery without a document id\"),\n])\nde"]
[72.635409, "i", "f test_erp_delivery_requires_document_id(inv, gateway, document, message):\n    open_url, sleep = gateway\n    if document is None:\n        open_url.side_effect = http_error(409)\n    else:\n        open_url.return_value = response(document)\n    with pytest.raises(export.DeliveryError, match=message):\n        export.send_to_erp(inv)\n    sleep.assert_not_called()\n\n\ndef test_erp_duplicate_delivery_returns_existing_document(inv, gateway):\n    open_url, sleep = gateway\n    open_url.side_effect = http_error(409, {\"document_id\": \"existing\"})\n    assert export.send_to_erp(inv) == \"existing\"\n    sleep.assert_not_called()\n\n\ndef test_erp_delivery_does_not_retry_permanent_rejection(inv, gateway):\n    open_url, sleep = gateway\n    open_url.side_effect = http_error(400)\n    with pytest.raises(export.DeliveryError, match=\"rejected the invoice\"):\n        export.send_to_erp(inv)\n    assert open_url.call_count == 1\n    sleep.assert_not_called()\nPY\nmake ci\n"]
