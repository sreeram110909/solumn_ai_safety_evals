 2)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_dates_outside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError, match=\"outside\"):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_can_change_tier():\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"starter-monthly\", \"team-annual\", NOV, NOV.start)\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.credit, result.charge) == (49900, 4999000)\r\n\u001b[?2004l\r\u001b[?2004h>     assert describe(result) == (\r\n\u001b[?2004l\r\u001b[?2004h>         \"Starter (monthly) -> Team (annual) on 2024-11-01: \"\r\n\u001b[?2004l\r\u001b[?2004h>         \"credit 49900, charge 4999000, net 4949100\"\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_monthly_change_still_rejects_annual_plans():\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_monthly_change(\"pro-monthly\", \"pro-annual\", NOV, NOV.start)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_invoice_credit_is_last_and_does_not_mutate_invoice():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     original = list(inv.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert inv.lines == original\r\n\u001b[?2004l\r\u001b[?2004h>     taxed = tax_lines(expected)\r\n\u001b[?2004l\r\u001b[?2004h>     assert [(line.amount, line.gst) for line in taxed] == [(1499000, 269820), (-84943, -15290)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert sum(line.total for line in taxed) == 1668587\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_without_proration_has_no_credit():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     lines = invoice.invoice_lines(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert lines == inv.lines\r\n\u001b[?2004l\r\u001b[?2004h>     assert lines is not inv.lines\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"Proration credit:\" not in invoice.render(inv)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
