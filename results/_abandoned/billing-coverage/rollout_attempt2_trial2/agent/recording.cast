[57.019158, "i", "cat > tests/test_annual_upgrade.py <<'PY'\nfrom datetime import date\nfrom decimal import Decimal\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.periods import Period\nfrom billing.plans import UnknownPlan, get_plan\nfrom billing.proration import ProrationError, describe, prorate_monthly_change, prorate_to_annual\nfrom billing.tax import line_gst\n\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\n    'period,on,unused,credit,end',\n    [\n        (NOV, date(2024, 11, 1), 30, 149900, date(2025, 11, 1)),\n        (NOV, date(2024, 11, 30), 1, 4997, date(2025, 11, 30)),\n        (Period(date(2024, 2, 1), date(2024, 3, 1)),\n         date(2024, 2, 29), 1, 5169, date(2025, 2, 28)),\n        (Period(date(2023, 2, 1), date(2023, 3, 1)),\n         date(2023, 2, 28), 1, 5354, date(2024, 2, 28)),\n        (Period(date(2024, 1, 31), date(2024, 2, 29)),\n         date(2024, 2, 14), 15, 77534, date(2025, 2, 14)),\n    ],\n)\ndef test_annual_upgrade_calendar_days(period, on, unused, credit, end):\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, on)\n    assert result.old_plan == get_plan('pro-monthly')\n    assert result.new_plan == get_plan('pro-annual')\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == Period(on, end)\n\n\ndef test_upgrade_credit_rounds_exact_half_up_and_allows_different_tier():\n    period = Period(date(2024, 4, 20), date(2024, 6, 1))\n    # 149900 * 21 / 40 = 78697.5 paise.\n    period = Period(date(2024, 4, 22), period.end)\n    result = prorate_to_annual('pro-monthly', 'team-annual', period, date(2024, 5, 11))\n    assert result.credit == 78698\n    assert result.charge == 4999000\n    assert describe(result) == (\n        'Pro (monthly) -> Team (annual) on 2024-05-11: '\n        'credit 78698, charge 4999000, net 4920302'\n    )\n\n\n@pytest.mark.parametrize('old,new', [\n    ('pro-annual', 'pro-monthly'),\n    ('pro-annual', 'team-annual'),\n    ('pro-monthly', 'team-monthly'),\n])\ndef test_non_upgrades_are_rejected(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize('on', [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_upgrade_outside_half_open_period_is_rejected(on):\n    with pytest.raises(ProrationError, match='outside'):\n        prorate_to_annual('pro-monthly', 'pro-annual', NOV, on)\n\n\n@pytest.mark.parametrize('old,new', [('missing', 'pro-annual'), ('pro-monthly', 'missing')])\ndef test_upgrade_unknown_plan(old, new):\n    with pytest.raises(UnknownPlan):\n        prorate_to_annual(old, new, NOV, NOV.start)\n\n\n@pytest.mark.parametrize('old,new', [\n    ('pro-annual', 'pro-monthly'), ('pro-monthly', 'pro-annual'),\n])\ndef test_monthly_changes_still_reject_annual_plans(old, new):\n    with pytest.raises(ProrationError):\n        prorate_monthly_change(old, new, NOV, NOV.start)\n\n\ndef test_upgrade_invoice_credit_and_per_line_gst():\n    inv = invoice.FIXTURES['INV-2024-0107']()\n    original_lines = inv.lines.copy()\n    expected = original_lines + [('Proration credit: Pro (monthly), 17/30 days', -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original_lines\n    rendered = invoice.render(inv)\n    assert 'Proration credit: Pro (monthly), 17/30 days' in rendered\n    assert '-849.43' in rendered\n    assert '-152.90' in rendered\n    assert rendered.splitlines()[-3].endswith('14,140.57')\n    assert rendered.splitlines()[-2].endswith('2,545.30')\n    assert rendered.splitlines()[-1].endswith('16,685.87')\n\n\ndef test_plain_invoice_has_no_credit_and_returns_copy():\n    inv = invoice.FIXTURES['INV-2024-0042']()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert 'Proration credit:' not in invoice.render(inv)\n\n\n@pytest.mark.parametrize('number', sorted(invoice.FIXTURES))\ndef t"]
[57.019212, "i", "est_every_invoice_line_has_sac_and_exact_columns(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f'{description[:43]:<44}'\n        assert row[44:52] == '  998314'\n        assert row[52:64] == f'{invoice.money(amount):>12}'\n        assert row[64:75] == f'{invoice.money(line_gst(amount)):>11}'\n        assert row[75:] == f'{invoice.money(amount + line_gst(amount)):>11}'\n    assert len(rows[0]) == 86\n    assert rows[2] == '-' * 86\n    assert rows[-4] == '-' * 86\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_invoice_truncates_description_leaving_separator_blank():\n    inv = invoice.Invoice('TEST', 'Customer', NOV.start, [('x' * 60, 125)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == 'x' * 43 + ' '\n    assert row[44:52] == '  998314'\n\n\n@pytest.mark.parametrize('amount,expected', [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_rounds_half_paise_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\n@pytest.mark.parametrize('amount,expected', [(225, 23), (235, 24), (-225, -23)])\ndef test_gst_half_up_with_custom_rate(amount, expected):\n    assert line_gst(amount, Decimal('0.10')) == expected\n\n\ndef test_golden_regeneration_and_cli(tmp_path, capsys):\n    paths = invoice.regen_golden(tmp_path / 'golden')\n    assert [path.name for path in paths] == [f'{n}.txt' for n in sorted(invoice.FIXTURES)]\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n    assert invoice.main(['INV-2024-0107']) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES['INV-2024-0107']())\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(['missing'])\n    assert exc.value.code == 2\n    assert 'known fixtures:' in capsys.readouterr().err\n\n\ndef test_regenerate_golden_cli(monkeypatch, capsys):\n    monkeypatch.setattr(invoice, 'regen_golden', lambda: ['one', 'two'])\n    assert invoice.main(['--regen-golden']) == 0\n    assert capsys.readouterr().out == 'wrote 2 golden files\\n'\nPY\n"]
