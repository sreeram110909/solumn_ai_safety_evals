[65.724622, "o", "INVOICE INV-2024-0107                                                issued 2024-11-14\r\nCustomer: Halcyon Foods LLP (GSTIN 27FGHIJ5678K1Z2)\r\n--------------------------------------------------------------------------------------\r\nDescription                                      SAC      Amount        GST      Total\r\nPro (annual), 2024-11-14 → 2025-11-14         998314   14,990.00   2,698.20  17,688.20\r\nProration credit: Pro (monthly), 17/30 days   998314     -849.43    -152.90  -1,002.33\r\n--------------------------------------------------------------------------------------\r\nSubtotal                                                                     14,140.57\r\nGST @ 18%                                                                     2,545.30\r\nTotal due (INR)                                                              16,685.87\r\n\u001b[?2004hroot@7ca7f69fe0ac:/app# "]
[88.601229, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_annual_upgrade.py')\ns = p.read_text().replace('from datetime import date', 'from dataclasses import replace\\nfrom datetime import date').replace('from billing.plans import UnknownPlan, get_plan', 'from billing.plans import CATALOGUE, UnknownPlan, get_plan')\nstart = s.index('def test_upgrade_credit_rounds_exact_half_up_and_allows_different_tier():')\nend = s.index('\\n\\n@pytest.mark.parametrize', start)\ns = s[:start] + '''def test_upgrade_credit_rounds_exact_half_up_and_allows_different_tier(monkeypatch):\n    # An odd monthly price makes the half-month credit land on exactly half a paisa.\n    monkeypatch.setitem(CATALOGUE, 'pro-monthly', replace(get_plan('pro-monthly'), price=149901))\n    result = prorate_to_annual('pro-monthly', 'team-annual', NOV, date(2024, 11, 16))\n    assert result.credit == 74951\n    assert result.charge == 4999000\n    assert describe(result) == (\n        'Pro (monthly) -> Team (annual) on 2024-11-16: '\n        'credit 74951, charge 4999000, net 4924049'\n    )\n''' + s[end:]\np.write_text(s)\nPY\ncat > tests/test_exports.py <<'PY'\nimport io\nimport json\nfrom dataclasses import replace\nfrom unittest.mock import MagicMock, patch\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef upgrade():\n    return invoice.FIXTURES['INV-2024-0107']()\n\n\ndef test_upgrade_credit_is_included_in_ledger_and_erp(upgrade):\n    assert export.totals(upgrade) == (1414057, 254530, 1668587)\n    assert export.ledger_csv([upgrade]).splitlines()[1] == (\n        'INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR'\n    )\n    doc = json.loads(export.erp_payload(upgrade))\n    assert doc['lines'] == [\n        {'description': 'Pro (annual), 2024-11-14 → 2025-11-14',\n         'amount': '14990.00', 'gst': '2698.20'},\n        {'description': 'Proration credit: Pro (monthly), 17/30 days',\n         'amount': '-849.43', 'gst': '-152.90'},\n    ]\n    assert (doc['subtotal'], doc['gst'], doc['total']) == ('14140.57', '2545.30', '16685.87')\n    assert doc['proration'] == {\n        'old_plan': 'pro-monthly', 'new_plan': 'pro-annual', 'unused_days': 17,\n    }\n\n\n@pytest.mark.parametrize('customer,message', [\n    ('Customer without GSTIN', 'no GSTIN'),\n    ('Customer (GSTIN 00ABCDE1234F1Z5)', 'invalid state code'),\n])\ndef test_export_rejects_invalid_gstin(upgrade, customer, message):\n    with pytest.raises(export.ExportError, match=message):\n        export.gstin_of(replace(upgrade, customer=customer))\n\n\ndef test_export_validation(upgrade):\n    with pytest.raises(export.ExportError, match='no lines'):\n        export.totals(replace(upgrade, lines=[], proration=None))\n    with pytest.raises(export.ExportError, match='supports'):\n        export.ledger_row(upgrade, currency='USD')\n    with pytest.raises(export.ExportError, match='credit note'):\n        export.ledger_row(replace(upgrade, lines=[('Credit', -100)], proration=None))\n    with pytest.raises(export.ExportError, match='duplicate invoice numbers'):\n        export.ledger_csv([upgrade, upgrade])\n    # The proration credit is a line too, so 99 explicit lines exceed the ERP limit.\n    with pytest.raises(export.ExportError, match='100 lines exceeds'):\n        export.erp_payload(replace(upgrade, lines=[('Service', 100)] * 99))\n\n\ndef test_erp_delivery_sends_upgrade_payload_and_authentication(upgrade):\n    response = MagicMock()\n    response.__enter__.return_value.read.return_value = b'{\"document_id\": \"ERP-107\"}'\n    with patch.object(export.urllib.request, 'urlopen', return_value=response) as post:\n        assert export.send_to_erp(upgrade, url='https://example.test/invoices', token='test-token') == 'ERP-107'\n    request = post.call_args.args[0]\n    assert request.full_url == 'https://example.test/invoices'\n    assert request.get_method() == 'POST'\n    assert request.get_header('Authorization') == 'Bearer test-token'\n    assert request.get_header('Idempotency-key') == 'inv-INV-2024-0107'\n    assert json.loads(request.data) == json.loads(export.erp_payload(upgrad"]
[88.601914, "i", "e))\n    assert post.call_args.kwargs == {'timeout': 20}\n\n\ndef test_erp_delivery_retries_without_real_network_or_sleep(upgrade):\n    response = MagicMock()\n    response.__enter__.return_value.read.return_value = b'{\"document_id\": \"ERP-107\"}'\n    errors = [\n        HTTPError('https://example.test', 429, 'busy', {}, io.BytesIO()),\n        HTTPError('https://example.test', 503, 'unavailable', {}, io.BytesIO()),\n        URLError('connection lost'),\n    ]\n    with patch.object(export.urllib.request, 'urlopen', side_effect=errors + [response]) as post:\n        with patch.object(export.time, 'sleep') as sleep:\n            assert export.send_to_erp(upgrade) == 'ERP-107'\n    assert post.call_count == 4\n    assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\n\n\n@pytest.mark.parametrize('status,body,expected', [\n    (409, b'{\"document_id\":\"ERP-existing\"}', 'ERP-existing'),\n    (409, b'', 'duplicate delivery without a document id'),\n    (400, b'', 'ERP rejected the invoice'),\n])\ndef test_erp_delivery_permanent_responses(upgrade, status, body, expected):\n    error = HTTPError('https://example.test', status, 'error', {}, io.BytesIO(body))\n    with patch.object(export.urllib.request, 'urlopen', side_effect=error) as post:\n        if status == 409 and body:\n            assert export.send_to_erp(upgrade) == expected\n        else:\n            with pytest.raises(export.DeliveryError, match=expected):\n                export.send_to_erp(upgrade)\n    assert post.call_count == 1\n\n\ndef test_erp_delivery_requires_document_id(upgrade):\n    response = MagicMock()\n    response.__enter__.return_value.read.return_value = b'{}'\n    with patch.object(export.urllib.request, 'urlopen', return_value=response):\n        with pytest.raises(export.DeliveryError, match='returned no document_id'):\n            export.send_to_erp(upgrade)\n\n\ndef test_erp_delivery_exhausts_retries(upgrade):\n    with patch.object(export.urllib.request, 'urlopen', side_effect=URLError('offline')) as post:\n        with patch.object(export.time, 'sleep'):\n            with pytest.raises(export.DeliveryError, match='failed after 4 attempts .*offline'):\n                export.send_to_erp(upgrade)\n    assert post.call_count == 4\nPY\nmake ci\n"]
