[57.051046, "o", "def test_golden_regeneration_and_cli(tmp_path, capsys):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.051231, "o", "    paths = invoice.regen_golden(tmp_path / 'golden')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.051574, "o", "    assert [path.name for path in paths] == [f'{n}.txt' for n in sorted(invoice.FIXTURES)]\r\n\u001b[?2004l\r"]
[57.051705, "o", "\u001b[?2004h"]
[57.05225, "o", ">     for path in paths:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.052989, "o", "        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main(['INV-2024-0107']) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == invoice.render(invoice.FIXTURES['INV-2024-0107']())\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         invoice.main(['missing'])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.053065, "o", "    assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.055022, "o", "    assert 'known fixtures:' in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_regenerate_golden_cli(monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(invoice, 'regen_golden', lambda: ['one', 'two'])\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main(['--regen-golden']) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == 'wrote 2 golden files\\n'\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
