[18.865458, "o", "\r\n\u001b[?2004l\r"]
[18.867429, "o", "        writer.writerow(ledger_row(inv, currency))\r\n    return buf.getvalue()\r\n\r\n\r\ndef erp_payload(invoice: Invoice) -> str:\r\n    \"\"\"JSON document for the ERP's invoice endpoint.\"\"\"\r\n    lines = invoice_lines(invoice)\r\n    if len(lines) > ERP_MAX_LINES:\r\n        raise ExportError(f\"{invoice.number}: {len(lines)} lines exceeds the ERP limit of {ERP_MAX_LINES}\")\r\n    taxed = tax_lines(lines)\r\n    subtotal, gst, total = totals(invoice)\r\n    doc = {\r\n        \"invoice_number\": invoice.number,\r\n        \"issue_date\": invoice.issued.isoformat(),\r\n        \"buyer_gstin\": gstin_of(invoice),\r\n        \"lines\": [{\"description\": t.description, \"amount\": rupees(t.amount), \"gst\": rupees(t.gst)}\r\n                  for t in taxed],\r\n        \"subtotal\": rupees(subtotal),\r\n        \"gst\": rupees(gst),\r\n        \"total\": rupees(total),\r\n    }\r\n    if invoice.proration is not None:\r\n        doc[\"proration\"] = {\"old_plan\": invoice.proration.old_plan.code,\r\n                            \"new_plan\": invoice.proration.new_plan.code,\r\n                            \"unused_days\": invoice.proration.unused_days}\r\n    return json.dumps(doc, sort_keys=True)\r\n\r\n\r\n# --- delivery to the ERP gateway ---------------------------------------------------------------------\r\nERP_URL = \"https://erp-gateway.finance.internal/v2/invoices\"\r\nMAX_ATTEMPTS = 4\r\nBACKOFF_S = (1, 4, 15)\r\n\r\n\r\nclass DeliveryError(RuntimeError):\r\n    pass\r\n\r\n\r\ndef send_to_erp(invoice: Invoice, url: str = ERP_URL, token: str | None = None) -> str:\r\n    \"\"\"POST the invoice's ERP payload; retry 429/5xx and connection errors with backoff.\r\n    Returns the ERP document id. 4xx other than 429 are permanent and are not retried.\"\"\"\r\n    body = erp_payload(invoice).encode()\r\n    headers = {\"content-type\": \"application/json\", \"idempotency-key\": f\"inv-{invoice.number}\"}\r\n    if token:\r\n        headers[\"authorization\"] = f\"Bearer {token}\"\r\n    last = \"\"\r\n    for attempt in range(MAX_ATTEMPTS):\r\n        req = urllib.request.Request(url, data=body, headers=headers, method=\"POST\")\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=20) as resp:\r\n                doc = json.loads(resp.read().decode())\r\n                if \"document_id\" not in doc:\r\n                    raise DeliveryError(f\"{invoice.number}: ERP accepted the invoice but returned no document_id\")\r\n                return doc[\"document_id\"]\r\n        except urllib.error.HTTPError as exc:\r\n            if exc.code == 409:\r\n                # already delivered under this idempotency key: the ERP returns the existing document\r\n                existing = json.loads(exc.read().decode() or \"{}\").get(\"document_id\")\r\n                if existing:\r\n                    return existing\r\n                raise DeliveryError(f\"{invoice.number}: duplicate delivery without a document id\") from exc\r\n            if exc.code != 429 and exc.code < 500:\r\n                raise DeliveryError(f\"{invoice.number}: ERP rejected the invoice ({exc.code})\") from exc\r\n            last = f\"HTTP {exc.code}\"\r\n        except urllib.error.URLError as exc:\r\n            last = f\"connection error: {exc.reason}\"\r\n        if attempt < MAX_ATTEMPTS - 1:\r\n            time.sleep(BACKOFF_S[min(attempt, len(BACKOFF_S) - 1)])\r\n    raise DeliveryError(f\"{invoice.number}: ERP delivery failed after {MAX_ATTEMPTS} attempts ({last})\")\r\n"]
[18.868512, "o", "\"\"\"Plan catalogue. All prices are in paise (1/100 INR), exclusive of GST.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n\r\nclass UnknownPlan(KeyError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    code: str\r\n    name: str\r\n    interval: str  # \"month\" or \"year\"\r\n    price: int  # paise per interval, before GST\r\n\r\n    @property\r\n    def is_annual(self) -> bool:\r\n        return self.interval == \"year\"\r\n\r\n\r\nCATALOGUE: dict[str, Plan] = {\r\n    p.code: p\r\n    for p in (\r\n        Plan(\"starter-monthly\", \"Starter (monthly)\", \"month\", 49900),\r\n        Plan(\"pro-monthly\", \"Pro (monthly)\", \"month\", 149900),\r\n        Plan(\"pro-annual\", \"Pro (annual)\", \"year\", 1499000),\r\n        Plan(\"team-monthly\", \"Team (monthly)\", \"month\", 499900),\r\n        Plan(\"team-annual\", \"Team (annual)\", \"year\", 4999000),\r\n    )\r\n}\r\n\r\n\r\ndef get_plan(code: str) -> Plan:\r\n    try:\r\n        return CATALOGUE[code]\r\n    except KeyError:\r\n        raise UnknownPlan(code) from None\r\n"]
[18.869852, "o", "INVOICE INV-2024-0042                                          issued 2024-10-02\r\nCustomer: Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\r\n--------------------------------------------------------------------------------\r\nDescription                                         Amount        GST      Total\r\nPro (monthly), Oct 2024                           1,499.00     269.82   1,768.82\r\nAdditional seats x3, Oct 2024                       749.25     134.87     884.12\r\n"]
[18.870099, "o", "API overage, 1,001 calls                            250.25      45.05     295.30\r\nPriority support, Oct 2024                          999.00     179.82   1,178.82\r\n--------------------------------------------------------------------------------\r\nSubtotal                                                                3,497.50\r\nGST @ 18%                                                                 629.56\r\nTotal due (INR)                                                         4,127.06\r\n\u001b[?2004h"]
