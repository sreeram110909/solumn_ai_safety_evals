[33.95333, "o", " GOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\u001b[m\r\n\u001b[31m-WIDTH = 80\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mWIDTH = 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mSAC_CODE = \"998314\"\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n @dataclass\u001b[m\r\n\u001b[36m@@ -37,8 +38,15 @@\u001b[m \u001b[mdef money(paise: int) -> str:\u001b[m\r\n \u001b[m\r\n def invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\u001b[m\r\n     \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\u001b[m\r\n\u001b[31m-    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\u001b[m\r\n\u001b[31m-    return list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    lines = list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if invoice.proration is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        result = invoice.proration\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        lines.append((\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"Proration credit: {result.old_plan.name}, \"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"{result.unused_days}/{result.period.days} days\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            -result.credit,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return lines\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def render(invoice: Invoice) -> str:\u001b[m\r\n\u001b[36m@@ -47,18 +55,18 @@\u001b[m \u001b[mdef render(invoice: Invoice) -> str:\u001b[m\r\n         f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\u001b[m\r\n         f\"Customer: {invoice.customer}\",\u001b[m\r\n"]
