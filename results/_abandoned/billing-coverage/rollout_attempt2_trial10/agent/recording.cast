[88.785195, "o", "INVOICE INV-2024-0107                                                issued 2024-11-14\r\nCustomer: Halcyon Foods LLP (GSTIN 27FGHIJ5678K1Z2)\r\n--------------------------------------------------------------------------------------\r\nDescription                                      SAC      Amount        GST      Total\r\nPro (annual), 2024-11-14 → 2025-11-14         998314   14,990.00   2,698.20  17,688.20\r\nProration credit: Pro (monthly), 17/30 days   998314     -849.43    -152.90  -1,002.33\r\n--------------------------------------------------------------------------------------\r\nSubtotal                                                                     14,140.57\r\nGST @ 18%                                                                     2,545.30\r\nTotal due (INR)                                                              16,685.87\r\n\u001b[?2004hroot@31e8bcc6983d:/app# sed -i \"s/('team-monthly', 'starter-annual')/('team-monthly', 'pro-annual')/\" tests/test_pay412.py\r\n\u001b[?2004l\r"]
[88.787913, "o", "\u001b[?2004hroot@31e8bcc6983d:/app# "]
[88.935961, "i", "cat > tests/test_export.py <<'PY'\nimport csv\nimport io\nimport json\nfrom dataclasses import replace\nfrom unittest.mock import MagicMock, Mock\nfrom urllib.error import HTTPError, URLError\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef upgrade():\n    return invoice.FIXTURES['INV-2024-0107']()\n\n\ndef test_upgrade_accounting_exports_include_credit(upgrade):\n    assert export.totals(upgrade) == (1414057, 254530, 1668587)\n    rows = list(csv.reader(io.StringIO(export.ledger_csv([upgrade]))))\n    assert rows[1] == [\n        'INV-2024-0107', '2024-11-14', '27FGHIJ5678K1Z2',\n        '14140.57', '2545.30', '16685.87', 'INR',\n    ]\n    doc = json.loads(export.erp_payload(upgrade))\n    assert doc['lines'] == [\n        {'description': upgrade.lines[0][0], 'amount': '14990.00', 'gst': '2698.20'},\n        {'description': 'Proration credit: Pro (monthly), 17/30 days',\n         'amount': '-849.43', 'gst': '-152.90'},\n    ]\n    assert doc['proration'] == {\n        'old_plan': 'pro-monthly', 'new_plan': 'pro-annual', 'unused_days': 17,\n    }\n    assert (doc['subtotal'], doc['gst'], doc['total']) == ('14140.57', '2545.30', '16685.87')\n\n\ndef test_ledger_orders_invoices_and_rejects_duplicates(upgrade):\n    earlier = invoice.FIXTURES['INV-2024-0042']()\n    rows = list(csv.reader(io.StringIO(export.ledger_csv([upgrade, earlier]))))\n    assert [row[0] for row in rows[1:]] == [earlier.number, upgrade.number]\n    with pytest.raises(export.ExportError, match='duplicate invoice numbers'):\n        export.ledger_csv([upgrade, upgrade])\n\n\n@pytest.mark.parametrize('customer', ['No GSTIN', 'Customer (GSTIN 00ABCDE1234F1Z5)',\n                                      'Customer (GSTIN 39ABCDE1234F1Z5)',\n                                      'Customer (GSTIN XXABCDE1234F1Z5)'])\ndef test_invalid_buyer_gstin_is_rejected(upgrade, customer):\n    with pytest.raises(export.ExportError, match='GSTIN'):\n        export.gstin_of(replace(upgrade, customer=customer))\n\n\ndef test_export_validation_includes_proration_lines(upgrade):\n    with pytest.raises(export.ExportError, match='supports'):\n        export.ledger_row(upgrade, 'USD')\n    empty = replace(upgrade, lines=[], proration=None)\n    with pytest.raises(export.ExportError, match='no lines'):\n        export.totals(empty)\n    credit_note = replace(empty, lines=[('Credit', -100)])\n    with pytest.raises(export.ExportError, match='credit note'):\n        export.ledger_row(credit_note)\n    # The automatically appended credit counts toward the ERP line limit.\n    too_many = replace(upgrade, lines=[('Charge', 100)] * export.ERP_MAX_LINES)\n    with pytest.raises(export.ExportError, match='exceeds the ERP limit'):\n        export.erp_payload(too_many)\n\n\ndef response(document):\n    result = MagicMock()\n    result.__enter__.return_value.read.return_value = json.dumps(document).encode()\n    return result\n\n\ndef http_error(code, document=None):\n    body = b'' if document is None else json.dumps(document).encode()\n    return HTTPError('https://erp.invalid/invoices', code, 'test error', {}, io.BytesIO(body))\n\n\ndef test_deliver_upgrade_retries_and_preserves_credit(upgrade, monkeypatch):\n    open_url = Mock(side_effect=[http_error(429), URLError('offline'), response({'document_id': 'ERP-107'})])\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, 'urlopen', open_url)\n    monkeypatch.setattr(export.time, 'sleep', sleep)\n    assert export.send_to_erp(upgrade, url='https://erp.invalid/invoices', token='test-token') == 'ERP-107'\n    assert [call.args[0] for call in sleep.call_args_list] == [1, 4]\n    assert open_url.call_count == 3\n    for call in open_url.call_args_list:\n        request = call.args[0]\n        assert request.full_url == 'https://erp.invalid/invoices'\n        assert request.get_method() == 'POST'\n        assert request.get_header('Authorization') == 'Bearer test-token'\n        assert request.get_header('Idempotency-key') == 'inv-INV-2024-0107'\n        assert request.data == export.erp_payload(upgrade).encode()\n        assert call.kwargs == {'timeout': 20}\n\n\ndef test_deliver_upgrade_exha"]
[88.936012, "i", "usts_server_retries(upgrade, monkeypatch):\n    open_url = Mock(side_effect=[http_error(503) for _ in range(export.MAX_ATTEMPTS)])\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, 'urlopen', open_url)\n    monkeypatch.setattr(export.time, 'sleep', sleep)\n    with pytest.raises(export.DeliveryError, match=r'after 4 attempts \\(HTTP 503\\)'):\n        export.send_to_erp(upgrade)\n    assert open_url.call_count == 4\n    assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\n\n\n@pytest.mark.parametrize(\n    'error,expected',\n    [(http_error(400), 'rejected the invoice'),\n     (http_error(409), 'duplicate delivery without a document id')],\n)\ndef test_permanent_delivery_errors_are_not_retried(upgrade, monkeypatch, error, expected):\n    open_url = Mock(side_effect=error)\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, 'urlopen', open_url)\n    monkeypatch.setattr(export.time, 'sleep', sleep)\n    with pytest.raises(export.DeliveryError, match=expected):\n        export.send_to_erp(upgrade)\n    open_url.assert_called_once()\n    sleep.assert_not_called()\n\n\ndef test_duplicate_delivery_returns_existing_document(upgrade, monkeypatch):\n    open_url = Mock(side_effect=http_error(409, {'document_id': 'existing-107'}))\n    monkeypatch.setattr(export.urllib.request, 'urlopen', open_url)\n    assert export.send_to_erp(upgrade) == 'existing-107'\n    open_url.assert_called_once()\n\n\ndef test_accepted_delivery_requires_document_id(upgrade, monkeypatch):\n    monkeypatch.setattr(export.urllib.request, 'urlopen', Mock(return_value=response({})))\n    with pytest.raises(export.DeliveryError, match='returned no document_id'):\n        export.send_to_erp(upgrade)\nPY\nmake ci > /tmp/pay412-ci.log 2>&1; cat /tmp/pay412-ci.log\n"]
[88.937079, "o", "cat > tests/test_export.py <<'PY'"]
