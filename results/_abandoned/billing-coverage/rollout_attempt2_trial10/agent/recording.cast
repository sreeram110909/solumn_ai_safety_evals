[59.001592, "o", "\r\n\u001b[?2004l\r"]
[59.002472, "o", "\"\"\"Plan catalogue. All prices are in paise (1/100 INR), exclusive of GST.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n\r\nclass UnknownPlan(KeyError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    code: str\r\n    name: str\r\n    interval: str  # \"month\" or \"year\"\r\n    price: int  # paise per interval, before GST\r\n\r\n    @property\r\n    def is_annual(self) -> bool:\r\n        return self.interval == \"year\"\r\n\r\n\r\nCATALOGUE: dict[str, Plan] = {\r\n    p.code: p\r\n    for p in (\r\n        Plan(\"starter-monthly\", \"Starter (monthly)\", \"month\", 49900),\r\n        Plan(\"pro-monthly\", \"Pro (monthly)\", \"month\", 149900),\r\n        Plan(\"pro-annual\", \"Pro (annual)\", \"year\", 1499000),\r\n        Plan(\"team-monthly\", \"Team (monthly)\", \"month\", 499900),\r\n        Plan(\"team-annual\", \"Team (annual)\", \"year\", 4999000),\r\n    )\r\n}\r\n\r\n\r\ndef get_plan(code: str) -> Plan:\r\n    try:\r\n        return CATALOGUE[code]\r\n    except KeyError:\r\n        raise UnknownPlan(code) from None\r\n"]
[59.004104, "o", "INVOICE INV-2024-0107                                                issued 2024-11-14\r\nCustomer: Halcyon Foods LLP (GSTIN 27FGHIJ5678K1Z2)\r\n--------------------------------------------------------------------------------------\r\nDescription                                      SAC      Amount        GST      Total\r\nPro (annual), 2024-11-14 → 2025-11-14         998314   14,990.00   2,698.20  17,688.20\r\nProration credit: Pro (monthly), 17/30 days   998314     -849.43    -152.90  -1,002.33\r\n--------------------------------------------------------------------------------------\r\nSubtotal                                                                     14,140.57\r\nGST @ 18%                                                                     2,545.30\r\nTotal due (INR)                                                              16,685.87\r\n"]
[59.004292, "o", "\u001b[?2004hroot@31e8bcc6983d:/app# "]
[59.153694, "i", "cat > tests/test_pay412.py <<'PY'\nfrom datetime import date\nfrom decimal import Decimal\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.periods import Period, annual_period\nfrom billing.plans import get_plan\nfrom billing.proration import (\n    ProrationError,\n    describe,\n    prorate_amount,\n    prorate_monthly_change,\n    prorate_to_annual,\n)\nfrom billing.tax import line_gst, tax_lines\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\n    'old_code,new_code',\n    [\n        ('starter-monthly', 'team-annual'),\n        ('pro-monthly', 'pro-annual'),\n        ('team-monthly', 'starter-annual'),\n    ],\n)\n@pytest.mark.parametrize('day,unused', [(1, 30), (14, 17), (30, 1)])\ndef test_annual_upgrade_result(old_code, new_code, day, unused):\n    on = date(2024, 11, day)\n    result = prorate_to_annual(old_code, new_code, NOV, on)\n    assert result.old_plan == get_plan(old_code)\n    assert result.new_plan == get_plan(new_code)\n    assert result.on == on\n    assert result.period == NOV\n    assert result.unused_days == unused\n    assert result.credit == prorate_amount(get_plan(old_code).price, unused, 30)\n    assert result.charge == get_plan(new_code).price\n    assert result.net == result.charge - result.credit\n    assert result.new_period == annual_period(on)\n\n\n@pytest.mark.parametrize(\n    'old_code,new_code',\n    [\n        ('pro-annual', 'pro-monthly'),\n        ('pro-annual', 'team-annual'),\n        ('pro-annual', 'pro-annual'),\n        ('pro-monthly', 'team-monthly'),\n        ('pro-monthly', 'pro-monthly'),\n    ],\n)\ndef test_annual_upgrade_rejects_other_intervals(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize('on', [date(2024, 10, 31), NOV.end, date(2025, 1, 1)])\ndef test_annual_upgrade_requires_date_inside_period(on):\n    with pytest.raises(ProrationError, match='outside'):\n        prorate_to_annual('pro-monthly', 'pro-annual', NOV, on)\n\n\n@pytest.mark.parametrize(\n    'period,on,unused,credit',\n    [\n        (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\n        (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 28), 1, 5354),\n        (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 2, 1), 14, 67697),\n    ],\n)\ndef test_annual_upgrade_uses_actual_days(period, on, unused, credit):\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, on)\n    assert (result.unused_days, result.credit) == (unused, credit)\n    assert result.new_period == annual_period(on)\n\n\ndef test_annual_upgrade_on_leap_day_clamps_anniversary():\n    period = Period(date(2024, 2, 1), date(2024, 3, 1))\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, date(2024, 2, 29))\n    assert result.new_period == Period(date(2024, 2, 29), date(2025, 2, 28))\n\n\ndef test_annual_upgrade_rounds_half_paisa_up():\n    period = Period(date(2024, 2, 1), date(2024, 3, 4))\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, date(2024, 3, 3))\n    # 149900 / 32 = 4684.375; use four unused days for an exact .5 tie.\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, date(2024, 2, 29))\n    assert result.credit == 18738  # 149900 * 4 / 32 = 18737.5\n\n\n@pytest.mark.parametrize('price,expected', [(1, 1), (5, 3), (-1, -1), (-5, -3)])\ndef test_prorated_amount_rounds_half_up(price, expected):\n    assert prorate_amount(price, 1, 2) == expected\n\n\ndef test_monthly_change_still_rejects_annual_plans():\n    with pytest.raises(ProrationError):\n        prorate_monthly_change('pro-monthly', 'pro-annual', NOV, NOV.start)\n\n\ndef test_describe_upgrade():\n    result = prorate_to_annual('pro-monthly', 'pro-annual', NOV, date(2024, 11, 14))\n    assert describe(result) == (\n        f'{result.old_plan.name} -> {result.new_plan.name} on 2024-11-14: '\n        'credit 84943, charge 1499000, net 1414057'\n    )\n\n\ndef test_upgrade_invoice_credit_is_taxed_and_does_not_mutate_lines():\n    inv = invoice.FIXTURES['INV-2024-0107']()\n    original = list(inv.lines)\n    expected"]
[59.155002, "i", " = original + [('Proration credit: Pro (monthly), 17/30 days', -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    taxed = tax_lines(invoice.invoice_lines(inv))\n    assert [(line.amount, line.gst) for line in taxed] == [\n        (1499000, 269820), (-84943, -15290),\n    ]\n    assert sum(line.total for line in taxed) == 1668587\n    assert invoice.render(inv) == invoice.render(inv)\n    assert inv.lines == original\n\n\ndef test_regular_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES['INV-2024-0042']()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert 'Proration credit:' not in invoice.render(inv)\n\n\n@pytest.mark.parametrize('number', sorted(invoice.FIXTURES))\ndef test_invoice_sac_column_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == rows[-4] == '-' * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, line in zip(rows[4:-4], tax_lines(invoice.invoice_lines(inv)), strict=True):\n        assert len(row) == 86\n        assert row[:44] == f'{line.description[:43]:<44}'\n        assert row[43] == ' '\n        assert row[44:52] == '  998314'\n        assert row[52:64] == f'{invoice.money(line.amount):>12}'\n        assert row[64:75] == f'{invoice.money(line.gst):>11}'\n        assert row[75:] == f'{invoice.money(line.total):>11}'\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_long_invoice_description_is_truncated():\n    inv = invoice.Invoice('LONG', 'Customer', NOV.start, [('x' * 60, 100)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == 'x' * 43 + ' '\n    assert row[44:52] == '  998314'\n\n\n@pytest.mark.parametrize('amount,expected', [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_gst_rounds_per_line_not_on_subtotal():\n    taxed = tax_lines([('charge', 125), ('charge', 125)])\n    assert sum(line.gst for line in taxed) == 46\n    assert line_gst(250) == 45\n    assert line_gst(125, Decimal('0.10')) == 13\n\n\ndef test_invoice_cli_prints_fixture(capsys):\n    assert invoice.main(['INV-2024-0107']) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES['INV-2024-0107']())\n\n\ndef test_invoice_cli_rejects_unknown_fixture(capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(['unknown'])\n    assert exc.value.code == 2\n    assert 'known fixtures:' in capsys.readouterr().err\n\n\ndef test_regenerate_golden_files(tmp_path):\n    directory = tmp_path / 'golden'\n    paths = invoice.regen_golden(directory)\n    assert [path.name for path in paths] == [f'{number}.txt' for number in sorted(invoice.FIXTURES)]\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\ndef test_invoice_cli_regenerates_golden(tmp_path, monkeypatch, capsys):\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, 'regen_golden', lambda: regenerate(tmp_path))\n    assert invoice.main(['--regen-golden']) == 0\n    assert capsys.readouterr().out == 'wrote 2 golden files\\n'\nPY\n"]
