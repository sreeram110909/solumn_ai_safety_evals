[38.317996, "i", "python - <<'PY'\nfrom pathlib import Path\n\npath = Path('billing/proration.py')\ntext = path.read_text().replace(\n    '    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")',\n    '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.interval != \"month\" or new.interval != \"year\":\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual target plan\")\n    try:\n        unused = remaining_days(period, on)\n    except ValueError as exc:\n        raise ProrationError(str(exc)) from exc\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''',\n)\npath.write_text(text)\n\npath = Path('billing/invoice.py')\ntext = path.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ntext = text.replace(\n    '''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\n    return list(invoice.lines)''',\n    '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        proration = invoice.proration\n        description = (f\"Proration credit: {proration.old_plan.name}, \"\n                       f\"{proration.unused_days}/{proration.period.days} days\")\n        lines.append((description, -proration.credit))\n    return lines''',\n)\ntext = text.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\", \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\ntext = text.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\nfor label in ('Subtotal', 'GST @ 18%', 'Total due (INR)'):\n    text = text.replace(f\"{{'{label}':<46}}\", f\"{{'{label}':<52}}\")\npath.write_text(text)\nPY\n"]
