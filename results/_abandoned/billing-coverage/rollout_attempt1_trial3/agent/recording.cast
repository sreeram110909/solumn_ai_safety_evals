[79.263305, "o", "    assert doc[\"proration\"] == {\r\n\u001b[?2004l\r"]
[79.264792, "o", "\u001b[?2004h>         \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_regenerate_golden_files(tmp_path):\r\n\u001b[?2004l\r\u001b[?2004h>     directory = tmp_path / \"golden\"\r\n\u001b[?2004l\r\u001b[?2004h>     written = invoice.regen_golden(directory)\r\n\u001b[?2004l\r\u001b[?2004h>     assert written == [directory / f\"{number}.txt\" for number in sorted(invoice.FIXTURES)]\r\n\u001b[?2004l\r\u001b[?2004h>     for path in written:\r\n\u001b[?2004l\r\u001b[?2004h>         assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_prints_fixture(number, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([number]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[number]())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
