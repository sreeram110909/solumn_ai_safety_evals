[79.245718, "i", "cat > tests/test_annual_upgrade.py <<'PY'\nfrom dataclasses import replace\nfrom datetime import date\nimport json\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_only_monthly_to_annual_is_an_upgrade(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"start,end,on,days,unused,credit\", [\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 28), 28, 1, 5354),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 29, 1, 5169),\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 30, 1, 4997),\n    (date(2024, 12, 15), date(2025, 1, 15), date(2025, 1, 1), 31, 14, 67697),\n])\ndef test_upgrade_uses_actual_days_and_resets_period(start, end, on, days, unused, credit):\n    period = Period(start, end)\n    result = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.on == on\n    assert result.period == period\n    assert result.period.days == days\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == annual_period(on)\n    if on == date(2024, 2, 29):\n        assert result.new_period.end == date(2025, 2, 28)\n\n\ndef test_upgrade_rounds_exact_half_paisa_up(monkeypatch):\n    plan = replace(get_plan(\"pro-monthly\"), price=101)\n    monkeypatch.setitem(CATALOGUE, plan.code, plan)\n    period = Period(date(2023, 2, 1), date(2023, 3, 1))\n    result = prorate_to_annual(plan.code, \"pro-annual\", period, date(2023, 2, 15))\n    assert result.unused_days == 14\n    assert result.credit == 51  # 101 * 14 / 28 = 50.5 paise\n    assert result.charge == 1499000\n    assert result.net == 1498949\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_credit_and_charge_gst_round_half_up(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_credit_follows_charge_without_mutating_invoice():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.render(inv) == invoice.render(inv)\n    assert inv.lines == original\n\n\ndef test_non_prorated_invoice_has_no_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_sac_layout_on_every_invoice_line(number):\n    inv = invoice.FIXTURES[number]()\n    # Exercise truncation as well as the reserved blank at description column 44.\n    inv.lines.append((\"x\" * 60, 125))\n    rows = invoice.render(inv).splitlines()\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    lines = invoice.invoice_lines(inv)\n    for row, (description, amount) in zip(rows[4:4 + len(lines)], lines):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n    "]
[79.245787, "i", "    assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        gst = line_gst(amount)\n        assert row[64:75] == f\"{invoice.money(gst):>11}\"\n        assert row[75:86] == f\"{invoice.money(amount + gst):>11}\"\n    assert all(len(row) == 86 for row in rows[-4:])\n\n\ndef test_upgrade_credit_is_included_in_accounting_exports():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"] == [\n        {\"description\": \"Pro (annual), 2024-11-14 → 2025-11-14\", \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\n    ]\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n\n\ndef test_regenerate_golden_files(tmp_path):\n    directory = tmp_path / \"golden\"\n    written = invoice.regen_golden(directory)\n    assert written == [directory / f\"{number}.txt\" for number in sorted(invoice.FIXTURES)]\n    for path in written:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_cli_prints_fixture(number, capsys):\n    assert invoice.main([number]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[number]())\nPY\nmake ci\n"]
[79.246513, "o", "cat > tests/test_annual_upgrade.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.250856, "o", "from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h> "]
[79.253769, "o", "from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.export import erp_payload, ledger_csv\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_only_monthly_to_annual_is_an_upgrade(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_dates_outside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError, match=\"outside\"):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"start,end,on,days,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 28), 28, 1, 5354),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 29, 1, 5169),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 30, 1, 4997),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 12, 15), date(2025, 1, 15), date(2025, 1, 1), 31, 14, 67697),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_days_and_resets_period(start, end, on, days, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     period = Period(start, end)\r\n\u001b[?2004l\rrow[52:64] == f\"{invoice.money(amount):>12}\"\r\n        gst = line_gst(amount)\r\n        assert row[64:75] == f\"{invoice.money(gst):>11}\"\r\n        assert row[75:86] == f\"{invoice.money(amount + gst):>11}\"\r\n    assert all(len(row) == 86 for row in rows[-4:])\r\n\r\n\r\ndef test_upgrade_credit_is_included_in_accounting_exports():\r\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n    assert ledger_csv([inv]).splitlines()[1] == (\r\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\r\n    )\r\n    doc = json.loads(erp_payload(inv))\r\n    assert doc[\"lines\"] == [\r\n        {\"description\": \"Pro (annual), 2024-11-14 → 2025-11-14\", \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\r\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\r\n    ]\r\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\r\n    assert doc[\"proration\"] == {\r\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\r\n    }\r\n\r\n\r\ndef test_regenerate_golden_files(tmp_path):\r\n    directory = tmp_path / \"golden\"\r\n    written = invoice.regen_golden(directory)\r\n    assert written == [directory / f\"{number}.txt\" for number in sorted(invoice.FIXTURES)]\r\n    for path in written:\r\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\r\n\r\n\r\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\ndef test_invoice_cli_prints_fixture(number, capsys):\r\n    assert invoice.main([number]) == 0\r\n    assert capsys.readout"]
