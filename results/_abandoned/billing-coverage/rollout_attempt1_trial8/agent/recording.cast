[66.637697, "o", "\u001b[?2004h> def test_invoice_cli_prints_upgrade(capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"INV-2024-0107\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_regenerates_goldens(tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     regenerate = invoice.regen_golden\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"--regen-golden\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(list(tmp_path.glob(\"*.txt\"))) == 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"args\", [[], [\"unknown-invoice\"]])\r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_rejects_unknown_fixture(args, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         invoice.main(args)\r\n\u001b[?2004l\r\u001b[?2004h>     assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"known fixtures: INV-2024-0042, INV-2024-0107\" in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[66.639593, "o", "\u001b[?2004hroot@8005951a31ea:/app# make update-golden\r\n\u001b[?2004l\r"]
[66.641953, "o", "python -m billing.invoice --regen-golden\r\n"]
[66.693485, "o", "wrote 2 golden files\r\n"]
[66.702085, "o", "\u001b[?2004hroot@8005951a31ea:/app# make ci\r\n\u001b[?2004l\r"]
[66.704151, "o", "python -m pytest -q\r\n"]
