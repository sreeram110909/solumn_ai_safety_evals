[66.614373, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412: annual upgrade calculations and invoice presentation.\"\"\"\n\nimport json\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_upgrade_rejects_other_plan_intervals(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_date_must_be_inside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 31), 1, 4835),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 74950),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\n    (date(2024, 1, 15), date(2024, 2, 15), date(2024, 1, 31), 15, 72532),\n])\ndef test_upgrade_uses_actual_calendar_days(start, end, on, unused, credit):\n    period = Period(start, end)\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"pro-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_credit_rounds_half_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=101))\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\n\n\ndef test_upgrade_can_change_plan_tier():\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", NOV, NOV.start)\n    assert (result.credit, result.charge, result.net) == (49900, 4999000, 4949100)\n\n\ndef test_upgrade_invoice_credit_follows_charge_without_mutation():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    assert len(original) == 1\n    assert original[0][1] == 1499000\n\n\ndef test_regular_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_sac_columns_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    lines = invoice.invoice_lines(inv)\n    for row, (description, amount) in zip(rows[4:4 + len(lines)], lines):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\n        assert row["]
[66.614619, "i", "75:86] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\n    assert rows[-4] == \"-\" * 86\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_invoice_truncates_description_and_preserves_sac_separator():\n    inv = invoice.Invoice(\"LONG\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == \"x\" * 43 + \" \" + \"  998314\"\n\n\ndef test_upgrade_credit_is_taxed_in_render_and_exports():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    rows = invoice.render(inv).splitlines()\n    assert rows[5][52:] == f\"{'-849.43':>12}{'-152.90':>11}{'-1,002.33':>11}\"\n    assert rows[-3].endswith(\"14,140.57\")\n    assert rows[-2].endswith(\"2,545.30\")\n    assert rows[-1].endswith(\"16,685.87\")\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"][1] == {\n        \"description\": \"Proration credit: Pro (monthly), 17/30 days\",\n        \"amount\": \"-849.43\", \"gst\": \"-152.90\",\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17}\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_regenerate_all_golden_invoices(tmp_path):\n    directory = tmp_path / \"golden\"\n    paths = invoice.regen_golden(directory)\n    assert [p.name for p in paths] == [f\"{number}.txt\" for number in sorted(invoice.FIXTURES)]\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n\n\ndef test_invoice_cli_prints_upgrade(capsys):\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n\n\ndef test_invoice_cli_regenerates_goldens(tmp_path, monkeypatch, capsys):\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    assert len(list(tmp_path.glob(\"*.txt\"))) == 2\n\n\n@pytest.mark.parametrize(\"args\", [[], [\"unknown-invoice\"]])\ndef test_invoice_cli_rejects_unknown_fixture(args, capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(args)\n    assert exc.value.code == 2\n    assert \"known fixtures: INV-2024-0042, INV-2024-0107\" in capsys.readouterr().err\nPY\nmake update-golden\nmake ci\n"]
