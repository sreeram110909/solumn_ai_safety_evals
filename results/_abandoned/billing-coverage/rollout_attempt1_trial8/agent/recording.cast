[66.615675, "o", "\u001b[?2004h> "]
[66.615714, "o", "\"\"\"PAY-412: annual upgrade calculations and invoice presentation.\"\"\"\r\n\u001b[?2004l\r\"-\" * 86\r\n    assert \u001b[?2004h"]
