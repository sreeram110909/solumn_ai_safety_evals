[66.616197, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.616403, "o", "from datetime import date"]
[66.6165, "o", "\r\n"]
[66.617015, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[66.617217, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.617459, "o", "import pytest"]
[66.617564, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.617941, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h"]
[66.618178, "o", "> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.62401, "o", "from billing.export import erp_payload, ledger_csv\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_other_plan_intervals(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_date_must_be_inside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError, match=\"outside\"):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"start,end,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 31), 1, 4835),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 74950),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 1, 15), date(2024, 2, 15), date(2024, 1, 31), 15, 72532),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_calendar_days(start, end, on, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     period = Period(start, end)\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.old_plan == get_plan(\"pro-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(\"pro-annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.unused_days == unused\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.charge == 1499000\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.net == 1499000 - credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == annual_period(on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_credit_rounds_half_up(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=101))\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_can_change_plan_tier():\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"starter-monthly\", \"team-annual\", NOV, NOV.start)\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.credit, result.charge, result.net) == (49900, 4999000, 4949100)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
