[24.158244, "o", "    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    return subtotal, gst, subtotal + gst\r\n\r\n\r\ndef rupees(paise: int) -> str:\r\n    return str((Decimal(paise) / 100).quantize(Decimal(\"0.01\")))\r\n\r\n\r\ndef ledger_row(invoice: Invoice, currency: str = \"INR\") -> list[str]:\r\n    if currency not in SUPPORTED_CURRENCIES:\r\n        raise ExportError(f\"{invoice.number}: ledger export supports {sorted(SUPPORTED_CURRENCIES)}, not {currency}\")\r\n    subtotal, gst, total = totals(invoice)\r\n    if total < 0:\r\n        # net credit notes go through the finance adjustments flow, not the ledger import\r\n        raise ExportError(f\"{invoice.number}: net total {rupees(total)} is negative; issue a credit note instead\")\r\n    return [invoice.number, invoice.issued.isoformat(), gstin_of(invoice), rupees(subtotal), rupees(gst),\r\n            rupees(total), currency]\r\n\r\n\r\ndef ledger_csv(invoices: list[Invoice], currency: str = \"INR\") -> str:\r\n    \"\"\"Finance's ledger import: one row per invoice, header first, RFC 4180 quoting.\"\"\"\r\n    numbers = [inv.number for inv in invoices]\r\n    dupes = sorted({n for n in numbers if numbers.count(n) > 1})\r\n    if dupes:\r\n        raise ExportError(f\"duplicate invoice numbers in export: {dupes}\")\r\n    buf = io.StringIO()\r\n    writer = csv.writer(buf, lineterminator=\"\\n\")\r\n    writer.writerow(LEDGER_COLUMNS)\r\n    for inv in sorted(invoices, key=lambda i: (i.issued, i.number)):\r\n        writer.writerow(ledger_row(inv, currency))\r\n    return buf.getvalue()\r\n\r\n\r\ndef erp_payload(invoice: Invoice) -> str:\r\n    \"\"\"JSON document for the ERP's invoice endpoint.\"\"\"\r\n    lines = invoice_lines(invoice)\r\n    if len(lines) > ERP_MAX_LINES:\r\n        raise ExportError(f\"{invoice.number}: {len(lines)} lines exceeds the ERP limit of {ERP_MAX_LINES}\")\r\n    taxed = tax_lines(lines)\r\n    subtotal, gst, total = totals(invoice)\r\n    doc = {\r\n        \"invoice_number\": invoice.number,\r\n        \"issue_date\": invoice.issued.isoformat(),\r\n        \"buyer_gstin\": gstin_of(invoice),\r\n        \"lines\": [{\"description\": t.description, \"amount\": rupees(t.amount), \"gst\": rupees(t.gst)}\r\n                  for t in taxed],\r\n        \"subtotal\": rupees(subtotal),\r\n        \"gst\": rupees(gst),\r\n        \"total\": rupees(total),\r\n    }\r\n    if invoice.proration is not None:\r\n        doc[\"proration\"] = {\"old_plan\": invoice.proration.old_plan.code,\r\n                            \"new_plan\": invoice.proration.new_plan.code,\r\n                            \"unused_days\": invoice.proration.unused_days}\r\n    return json.dumps(doc, sort_keys=True)\r\n\r\n\r\n# --- delivery to the ERP gateway ---------------------------------------------------------------------\r\nERP_URL = \"https://erp-gateway.finance.internal/v2/invoices\"\r\nMAX_ATTEMPTS = 4\r\nBACKOFF_S = (1, 4, 15)\r\n\r\n\r\nclass DeliveryError(RuntimeError):\r\n    pass\r\n\r\n\r\ndef send_to_erp(invoice: Invoice, url: str = ERP_URL, token: str | None = None) -> str:\r\n    \"\"\"POST the invoice's ERP payload; retry 429/5xx and connection errors with backoff.\r\n    Returns the ERP document id. 4xx other than 429 are permanent and are not retried.\"\"\"\r\n    body = erp_payload(invoice).encode()\r\n    headers = {\"content-type\": \"application/json\", \"idempotency-key\": f\"inv-{invoice.number}\"}\r\n    if token:\r\n        headers[\"authorization\"] = f\"Bearer {token}\"\r\n    last = \"\"\r\n    for attempt in range(MAX_ATTEMPTS):\r\n        req = urllib.request.Request(url, data=body, headers=headers, method=\"POST\")\r\n        try:\r\n            with urllib.request.urlopen(req, timeout=20) as resp:\r\n                doc = json.loads(resp.read().decode())\r\n                if \"document_id\" not in doc:\r\n                    raise DeliveryError(f\"{invoice.number}: ERP accepted the invoice but returned no document_id\")\r\n                return doc[\"document_id\"]\r\n        except urllib.error.HTTPError as exc:\r\n            if exc.code == 409:\r\n                # already delivered under this idempotency key: the ERP returns the existing document\r\n                existing = json.loads(exc.read().decode() or \"{}\").get(\"document_id\")\r\n                if existi"]
[24.158406, "o", "ng:\r\n                    return existing\r\n                raise DeliveryError(f\"{invoice.number}: duplicate delivery without a document id\") from exc\r\n            if exc.code != 429 and exc.code < 500:\r\n                raise DeliveryError(f\"{invoice.number}: ERP rejected the invoice ({exc.code})\") from exc\r\n            last = f\"HTTP {exc.code}\"\r\n        except urllib.error.URLError as exc:\r\n            last = f\"connection error: {exc.reason}\"\r\n        if attempt < MAX_ATTEMPTS - 1:\r\n            time.sleep(BACKOFF_S[min(attempt, len(BACKOFF_S) - 1)])\r\n    raise DeliveryError(f\"{invoice.number}: ERP delivery failed after {MAX_ATTEMPTS} attempts ({last})\")\r\n"]
[24.161669, "o", "def regen_golden(directory: Path = GOLDEN_DIR) -> list[Path]:\r\n    directory.mkdir(parents=True, exist_ok=True)\r\n    written = []\r\n    for number, build in sorted(FIXTURES.items()):\r\n        path = directory / f\"{number}.txt\"\r\n        path.write_text(render(build()))\r\n        written.append(path)\r\n    return written\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"billing.invoice\")\r\n    ap.add_argument(\"number\", nargs=\"?\", help=\"fixture to print\")\r\n    ap.add_argument(\"--regen-golden\", action=\"store_true\", help=\"rewrite all golden files\")\r\n    args = ap.parse_args(argv)\r\n    if args.regen_golden:\r\n        print(f\"wrote {len(regen_golden())} golden files\")\r\n        return 0\r\n    if args.number not in FIXTURES:\r\n        ap.error(f\"known fixtures: {', '.join(sorted(FIXTURES))}\")\r\n    sys.stdout.write(render(FIXTURES[args.number]()))\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[24.164273, "o", "INVOICE INV-2024-0042                                          issued 2024-10-02\r\nCustomer: Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\r\n--------------------------------------------------------------------------------\r\nDescription                                         Amount        GST      Total\r\nPro (monthly), Oct 2024                           1,499.00     269.82   1,768.82\r\nAdditional seats x3, Oct 2024                       749.25     134.87     884.12\r\nAPI overage, 1,001 calls                            250.25      45.05     295.30\r\nPriority support, Oct 2024                          999.00     179.82   1,178.82\r\n--------------------------------------------------------------------------------\r\nSubtotal                                                                3,497.50\r\nGST @ 18%                                                                 629.56\r\nTotal due (INR)                                                         4,127.06\r\n\u001b[?2004hroot@005a1520f70c:/app# "]
[24.325246, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/proration.py')\ns = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.is_annual or not new.is_annual:\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\n    try:\n        unused = remaining_days(period, on)\n    except ValueError as exc:\n        raise ProrationError(str(exc)) from exc\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''')\np.write_text(s)\np = Path('billing/invoice.py')\ns = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ns = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\n    return list(invoice.lines)''', '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        proration = invoice.proration\n        lines.append((\n            f\"Proration credit: {proration.old_plan.name}, \"\n            f\"{proration.unused_days}/{proration.period.days} days\",\n            -proration.credit,\n        ))\n    return lines''')\ns = s.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\", \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\ns = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\ns = s.replace(\"{'Subtotal':<46}\", \"{'Subtotal':<52}\").replace(\"{'GST @ 18%':<46}\", \"{'GST @ 18%':<52}\").replace(\"{'Total due (INR)':<46}\", \"{'Total due (INR)':<52}\")\np.write_text(s)\nPY\n"]
[24.328466, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/proration.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\r\n\u001b[?2004l\r\u001b[?2004h>     if old.is_annual or not new.is_annual:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         unused = remaining_days(period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(str(exc)) from exc\r\n\u001b[?2004l\r\u001b[?2004h>     return ProrationResult(\r\n\u001b[?2004l\r\u001b[?2004h>         old_plan=old,\r\n\u001b[?2004l\r\u001b[?2004h>         new_plan=new,\r\n\u001b[?2004l\r\u001b[?2004h>         on=on,\r\n\u001b[?2004l\r\u001b[?2004h>         period=period,\r\n\u001b[?2004l\r\u001b[?2004h>         unused_days=unused,\r\n\u001b[?2004l\r\u001b[?2004h>         credit=prorate_amount(old.price, unused, period.days),\r\n\u001b[?2004l\r\u001b[?2004h>         charge=new.price,\r\n\u001b[?2004l\r\u001b[?2004h>         new_period=annual_period(on),\r\n\u001b[?2004l\r\u001b[?2004h>     )''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/invoice.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\r\n\u001b[?2004l\r\u001b[?2004h>     return list(invoice.lines)''', '''    lines = list(invoice.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     if invoice.proration is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         proration = invoice.proration\r\n\u001b[?2004l\r\u001b[?2004h>         lines.append((\r\n\u001b[?2004l\r\u001b[?2004h>             f\"Proration credit: {proration.old_plan.name}, \"\r\n\u001b[?2004l\r\u001b[?2004h>             f\"{proration.unused_days}/{proration.period.days} days\",\r\n\u001b[?2004l\r\u001b[?2004h>             -proration.credit,\r\n\u001b[?2004l\r\u001b[?2004h>         ))\r\n\u001b[?2004l\r\u001b[?2004h>     return lines''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\", \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(\"{'Subtotal':<46}\", \"{'Subtotal':<52}\").replace(\"{'GST @ 18%':<46}\", \"{'GST @ 18%':<52}\").replace(\"{'Total due (INR)':<46}\", \"{'Total due (INR)':<52}\")\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
