[55.622283, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"Annual-upgrade calculations and invoice regressions (SPEC §3).\"\"\"\n\nimport json\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv, totals\nfrom billing.periods import Period\nfrom billing.plans import UnknownPlan, get_plan\nfrom billing.proration import (\n    ProrationError,\n    describe,\n    prorate_amount,\n    prorate_monthly_change,\n    prorate_to_annual,\n)\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"pro-annual\", \"pro-monthly\"),\n])\ndef test_upgrade_requires_monthly_to_annual(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"old,new\", [(\"unknown\", \"pro-annual\"), (\"pro-monthly\", \"unknown\")])\ndef test_upgrade_preserves_unknown_plan_errors(old, new):\n    with pytest.raises(UnknownPlan):\n        prorate_to_annual(old, new, NOV, NOV.start)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit,annual_end\", [\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 1663, date(2025, 11, 30)),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 24950, date(2024, 2, 15)),\n    (date(2024, 1, 31), date(2024, 2, 29), date(2024, 2, 14), 15, 25810, date(2025, 2, 14)),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 1721, date(2025, 2, 28)),\n    (date(2024, 12, 1), date(2025, 1, 1), date(2024, 12, 17), 15, 24145, date(2025, 12, 17)),\n])\ndef test_upgrade_uses_actual_days_and_allows_different_plan_tiers(start, end, on, unused, credit, annual_end):\n    period = Period(start, end)\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert (result.unused_days, result.credit) == (unused, credit)\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == Period(on, annual_end)\n\n\n@pytest.mark.parametrize(\"price,days,period_days,expected\", [(1, 1, 2, 1), (5, 1, 2, 3), (1, 1, 3, 0)])\ndef test_proration_rounds_half_up(price, days, period_days, expected):\n    assert prorate_amount(price, days, period_days) == expected\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_monthly_change_still_keeps_period_and_rejects_annual_plans():\n    result = prorate_monthly_change(\"starter-monthly\", \"pro-monthly\", NOV, NOV.start)\n    assert result.new_period == NOV\n    assert describe(result) == (\n        \"Starter (monthly) -> Pro (monthly) on 2024-11-01: \"\n        \"credit 49900, charge 149900, net 100000\"\n    )\n    with pytest.raises(ProrationError):\n        prorate_monthly_change(\"pro-monthly\", \"pro-annual\", NOV, NOV.start)\n\n\ndef test_upgrade_credit_follows_charge_without_mutating_invoice():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.render(inv) == invoice.render(inv)\n    assert inv.lines == original\n    assert totals(inv) == (1414057, 254530, 1668587)\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"][-1] == {\n        \"description\": expected[-1][0], \"amount\": \"-849.43\", \"gst\": \"-152.90\","]
[55.625354, "i", "\n    }\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert ledger_csv([inv]).splitlines()[1].endswith(\",14140.57,2545.30,16685.87,INR\")\n\n\ndef test_plain_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_sac_and_column_widths_on_every_invoice(number):\n    inv = invoice.FIXTURES[number]()\n    rendered = invoice.render(inv).splitlines()\n    assert len(rendered[0]) == 86\n    assert rendered[2] == \"-\" * 86\n    assert rendered[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    lines = invoice.invoice_lines(inv)\n    for row, (description, amount) in zip(rendered[4:4 + len(lines)], lines):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\n        assert row[75:] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\n    assert all(len(row) == 86 for row in rendered[4 + len(lines):])\n\n\ndef test_long_descriptions_leave_blank_before_sac_column():\n    inv = invoice.Invoice(\"long\", \"Customer\", NOV.start, [(\"x\" * 60, 100)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == \"x\" * 43 + \" \" + \"  998314\"\n\n\ndef test_golden_regeneration_and_invoice_cli(tmp_path, monkeypatch, capsys):\n    monkeypatch.setattr(invoice, \"GOLDEN_DIR\", tmp_path)\n    paths = invoice.regen_golden(tmp_path)\n    assert {p.stem for p in paths} == set(invoice.FIXTURES)\n    for path in paths:\n        assert path.read_text() == invoice.render(invoice.FIXTURES[path.stem]())\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: paths)\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    assert invoice.main([\"INV-2024-0107\"]) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES[\"INV-2024-0107\"]())\n    with pytest.raises(SystemExit) as exc:\n        invoice.main([\"unknown\"])\n    assert exc.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\nmake update-golden; make ci\n"]
[55.632329, "o", "cat > tests/test_pay412.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Annual-upgrade calculations and invoice regressions (SPEC §3).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.export import erp_payload, ledger_csv, totals\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import UnknownPlan, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import (\r\n\u001b[?2004l\r\u001b[?2004h>     ProrationError,\r\n\u001b[?2004l\r\u001b[?2004h>     describe,\r\n\u001b[?2004l\r\u001b[?2004h>     prorate_amount,\r\n\u001b[?2004l\r\u001b[?2004h>     prorate_monthly_change,\r\n\u001b[?2004l\r\u001b[?2004h>     prorate_to_annual,\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_requires_monthly_to_annual(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_dates_outside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError, match=\"outside\"):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [(\"unknown\", \"pro-annual\"), (\"pro-monthly\", \"unknown\")])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_preserves_unknown_plan_errors(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(UnknownPlan):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old, new, NOV, NOV.start)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"start,end,on,unused,credit,annual_end\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 1663, date(2025, 11, 30)),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 24950, date(2024, 2, 15)),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 1, 31), date(2024, 2, 29), date(2024, 2, 14), 15, 25810, date(2025, 2, 14)),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 1721, date(2025, 2, 28)),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 12, 1), date(2025, 1, 1), date(2024, 12, 17), 15, 24145, date(2025, 12, 17)),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_days_and_allows_different_plan_tiers(start, end, on, unused, credit, annual_end):\r\n\u001b[?2004l\r\u001b[?2004h>     period = Period(start, end)\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.old_plan == get_plan(\"starter-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(\"team-annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h"]
