[73.016394, "i", "cat > tests/test_export.py <<'PY'\n\"\"\"Accounting validation and delivery of prorated invoices.\"\"\"\n\nimport io\nimport json\nimport urllib.error\nfrom dataclasses import replace\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.mark.parametrize(\"changes,operation,message\", [\n    ({\"customer\": \"Missing tax identity\"}, export.gstin_of, \"no GSTIN\"),\n    ({\"customer\": \"Customer (GSTIN 99ABCDE1234F1Z5)\"}, export.gstin_of, \"invalid state code\"),\n    ({\"lines\": []}, export.totals, \"no lines\"),\n    ({}, lambda inv: export.ledger_row(inv, \"USD\"), \"supports\"),\n    ({\"lines\": [(\"Credit\", -100)]}, export.ledger_row, \"credit note\"),\n    ({}, lambda inv: export.ledger_csv([inv, inv]), \"duplicate invoice numbers\"),\n    ({\"lines\": [(\"Service\", 100)] * 100}, export.erp_payload, \"exceeds the ERP limit\"),\n])\ndef test_export_validation(changes, operation, message):\n    inv = replace(invoice.FIXTURES[\"INV-2024-0042\"](), **changes)\n    with pytest.raises(export.ExportError, match=message):\n        operation(inv)\n\n\ndef test_upgrade_delivery_sends_credit_and_idempotency_headers(monkeypatch):\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    requests = []\n\n    def urlopen(request, timeout):\n        requests.append(request)\n        assert timeout == 20\n        return io.BytesIO(b'{\"document_id\": \"erp-upgrade-107\"}')\n\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\n    assert export.send_to_erp(inv, url=\"https://example.test/invoices\", token=\"test-token\") == \"erp-upgrade-107\"\n    request, = requests\n    assert request.full_url == \"https://example.test/invoices\"\n    assert request.get_method() == \"POST\"\n    headers = {key.lower(): value for key, value in request.header_items()}\n    assert headers == {\n        \"content-type\": \"application/json\",\n        \"idempotency-key\": \"inv-INV-2024-0107\",\n        \"authorization\": \"Bearer test-token\",\n    }\n    doc = json.loads(request.data)\n    assert doc == json.loads(export.erp_payload(inv))\n    assert doc[\"lines\"][-1][\"amount\"] == \"-849.43\"\n    assert doc[\"total\"] == \"16685.87\"\n\n\n@pytest.mark.parametrize(\"error\", [\n    urllib.error.HTTPError(\"https://example.test\", 429, \"Rate limited\", {}, None),\n    urllib.error.HTTPError(\"https://example.test\", 503, \"Unavailable\", {}, None),\n    urllib.error.URLError(\"Connection reset\"),\n])\ndef test_upgrade_delivery_retries_transient_errors(monkeypatch, error):\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    requests, sleeps = [], []\n\n    def urlopen(request, timeout):\n        requests.append(request)\n        if len(requests) == 1:\n            raise error\n        return io.BytesIO(b'{\"document_id\": \"retried-upgrade\"}')\n\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\n    monkeypatch.setattr(export.time, \"sleep\", sleeps.append)\n    assert export.send_to_erp(inv) == \"retried-upgrade\"\n    assert len(requests) == 2\n    assert requests[0].data == requests[1].data\n    assert sleeps == [1]\nPY\npython - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_pay412.py')\ns = p.read_text().replace('    monkeypatch.setattr(invoice, \"GOLDEN_DIR\", tmp_path)\\n', '')\np.write_text(s)\nPY\nmake ci\n"]
