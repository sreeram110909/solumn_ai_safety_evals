[78.689755, "i", "sed -i 's/14, 67781/14, 67697/' tests/test_pay412.py\ncat > tests/test_invoice_cli.py <<'PY'\n\"\"\"Exercise invoice fixture generation and the public command-line entry point.\"\"\"\n\nimport pytest\n\nfrom billing import invoice\n\n\ndef test_regenerate_golden_and_cli(tmp_path, monkeypatch, capsys):\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    assert sorted(p.stem for p in tmp_path.iterdir()) == sorted(invoice.FIXTURES)\n    for number, build in invoice.FIXTURES.items():\n        expected = invoice.render(build())\n        assert (tmp_path / f\"{number}.txt\").read_text() == expected\n        assert invoice.main([number]) == 0\n        assert capsys.readouterr().out == expected\n\n\n@pytest.mark.parametrize(\"args\", [[], [\"unknown\"]])\ndef test_cli_rejects_unknown_invoice(args, capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(args)\n    assert exc.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\ncat > tests/test_export.py <<'PY'\n\"\"\"Accounting export validation and delivery, without network access or sleeps.\"\"\"\n\nimport io\nimport json\nimport urllib.error\nfrom unittest.mock import MagicMock, Mock\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef upgrade():\n    return invoice.FIXTURES[\"INV-2024-0107\"]()\n\n\ndef test_export_validation(upgrade):\n    with pytest.raises(export.ExportError, match=\"supports\"):\n        export.ledger_row(upgrade, currency=\"USD\")\n    with pytest.raises(export.ExportError, match=\"duplicate invoice\"):\n        export.ledger_csv([upgrade, upgrade])\n    upgrade.customer = \"Missing GSTIN\"\n    with pytest.raises(export.ExportError, match=\"no GSTIN\"):\n        export.gstin_of(upgrade)\n    upgrade.customer = \"Invalid (GSTIN 99FGHIJ5678K1Z2)\"\n    with pytest.raises(export.ExportError, match=\"invalid state code\"):\n        export.gstin_of(upgrade)\n    upgrade.proration = None\n    upgrade.lines = []\n    with pytest.raises(export.ExportError, match=\"no lines\"):\n        export.totals(upgrade)\n    upgrade.lines = [(\"credit\", -100)]\n    with pytest.raises(export.ExportError, match=\"credit note\"):\n        export.ledger_row(upgrade)\n    upgrade.lines = [(\"charge\", 100)] * (export.ERP_MAX_LINES + 1)\n    with pytest.raises(export.ExportError, match=\"ERP limit\"):\n        export.erp_payload(upgrade)\n\n\ndef response(document):\n    result = MagicMock()\n    result.__enter__.return_value.read.return_value = json.dumps(document).encode()\n    return result\n\n\ndef http_error(code, document=None):\n    return urllib.error.HTTPError(\n        \"https://erp.example/invoices\", code, \"error\", {},\n        io.BytesIO(json.dumps(document or {}).encode()),\n    )\n\n\ndef test_send_upgrade_to_erp(upgrade, monkeypatch):\n    opener = Mock(return_value=response({\"document_id\": \"erp-107\"}))\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", opener)\n    assert export.send_to_erp(upgrade, url=\"https://erp.example/invoices\", token=\"secret\") == \"erp-107\"\n    request = opener.call_args.args[0]\n    assert request.full_url == \"https://erp.example/invoices\"\n    assert request.get_method() == \"POST\"\n    assert request.get_header(\"Authorization\") == \"Bearer secret\"\n    assert request.get_header(\"Idempotency-key\") == \"inv-INV-2024-0107\"\n    assert json.loads(request.data)[\"lines\"][1][\"amount\"] == \"-849.43\"\n    assert opener.call_args.kwargs == {\"timeout\": 20}\n\n\n@pytest.mark.parametrize(\"error\", [http_error(429), http_error(503), urllib.error.URLError(\"offline\")])\ndef test_delivery_retries_transient_errors(upgrade, monkeypatch, error):\n    opener = Mock(side_effect=[error, response({\"document_id\": \"retried\"})])\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", opener)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    assert export.send_to_erp(upgrade) == \"retried\"\n    assert opener.call_count == 2\n    sleep.assert_called_once_with(export.BACKOFF_S[0])\n\n\ndef test_delivery_exhausts_retries(upgra"]
[78.689835, "i", "de, monkeypatch):\n    opener = Mock(side_effect=urllib.error.URLError(\"offline\"))\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", opener)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts\"):\n        export.send_to_erp(upgrade)\n    assert opener.call_count == export.MAX_ATTEMPTS\n    assert [call.args[0] for call in sleep.call_args_list] == list(export.BACKOFF_S)\n\n\n@pytest.mark.parametrize(\"result,message\", [\n    (http_error(400), \"rejected\"),\n    (http_error(409), \"duplicate delivery\"),\n    (response({}), \"no document_id\"),\n])\ndef test_delivery_does_not_retry_permanent_failures(upgrade, monkeypatch, result, message):\n    opener = Mock(side_effect=result) if isinstance(result, Exception) else Mock(return_value=result)\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", opener)\n    with pytest.raises(export.DeliveryError, match=message):\n        export.send_to_erp(upgrade)\n    assert opener.call_count == 1\n\n\ndef test_delivery_returns_existing_document_on_conflict(upgrade, monkeypatch):\n    opener = Mock(side_effect=http_error(409, {\"document_id\": \"existing\"}))\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", opener)\n    assert export.send_to_erp(upgrade) == \"existing\"\n    assert opener.call_count == 1\nPY\nmake ci > /tmp/pay412-ci.log 2>&1; tail -45 /tmp/pay412-ci.log\n"]
