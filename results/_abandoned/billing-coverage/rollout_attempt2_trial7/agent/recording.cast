[51.870215, "o", "\u001b[?2004hroot@a9a41fb76362:/app# "]
[51.981231, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"Monthly-to-annual upgrades and their invoice/accounting representation.\"\"\"\n\nimport json\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv, totals\nfrom billing.periods import Period, annual_period\nfrom billing.plans import get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n])\ndef test_upgrade_rejects_other_interval_combinations(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 16), 16, 77368),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 22), 7, 37475),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\n    # 149900 * 1 / 8 = 18737.5 paise: an exact tie rounds up.\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 1), 29, 149900),\n    (date(2024, 10, 15), date(2024, 11, 15), date(2024, 11, 1), 14, 67781),\n])\ndef test_upgrade_uses_actual_days_and_preserves_result_fields(start, end, on, unused, credit):\n    period = Period(start, end)\n    r = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert r.old_plan == get_plan(\"pro-monthly\")\n    assert r.new_plan == get_plan(\"team-annual\")\n    assert r.period == period and r.on == on\n    assert (r.unused_days, r.credit, r.charge, r.net) == (\n        unused, credit, 4999000, 4999000 - credit,\n    )\n    assert r.new_period == annual_period(on)\n\n\ndef test_upgrade_rounds_exact_half_paisa_up():\n    # February has 28 days; 49900 * 7 / 28 = 12475 (and 49900 / 8 = 6237.5).\n    period = Period(date(2024, 2, 1), date(2024, 3, 1))\n    from billing.plans import CATALOGUE, Plan\n    from unittest.mock import patch\n\n    with patch.dict(CATALOGUE, {\"tie-monthly\": Plan(\"tie-monthly\", \"Tie\", \"month\", 29)}):\n        r = prorate_to_annual(\"tie-monthly\", \"pro-annual\", period, date(2024, 2, 15))\n    assert r.unused_days == 15\n    assert r.credit == 15\n\n\ndef test_upgrade_invoice_credit_order_and_no_mutation():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    assert totals(inv) == (1414057, 254530, 1668587)\n    rendered = invoice.render(inv)\n    assert \"-849.43\" in rendered and \"-152.90\" in rendered\n\n\ndef test_regular_invoice_has_no_credit_and_returns_independent_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines and lines is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoices_have_sac_and_86_character_table(number):\n    inv = invoice.FIXTURES[number]()\n    rendered = invoice.render(inv).splitlines()\n    header = rendered[3]\n    assert header == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rendered[4:], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line_gst(am"]
[51.981323, "i", "ount)):>11}\"\n        assert row[75:] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\n    assert all(len(row) == 86 for row in rendered[2:])\n    assert len(rendered[0]) == 86\n\n\ndef test_description_is_cut_to_43_characters_with_blank_column():\n    inv = invoice.Invoice(\"LONG\", \"Buyer\", date(2024, 11, 14), [(\"X\" * 60, 125)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == \"X\" * 43 + \" \" + \"  998314\"\n\n\n@pytest.mark.parametrize(\"amount,gst\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_rounds_half_paisa_away_from_zero(amount, gst):\n    assert line_gst(amount) == gst\n\n\ndef test_upgrade_exports_include_credit_and_per_line_tax():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"lines\"] == [\n        {\"description\": inv.lines[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\n    ]\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert doc[\"proration\"] == {\"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17}\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\nPY\n"]
[51.98209, "o", "cat > tests/test_pay412.py <<'PY'"]
