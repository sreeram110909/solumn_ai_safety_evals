e_credit_and_per_line_tax():\r\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n    doc = json.loads(erp_payload(inv))\r\n    assert doc[\"lines\"] == [\r\n        {\"description\": inv.lines[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\r\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\r\n    ]\r\n    a"]
[51.994159, "o", "\u001b[?2004h>     with pytest.raises(ProrationError, match=\"outside\"):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"start,end,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 16), 16, 77368),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 22), 7, 37475),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\r\n\u001b[?2004l\r\u001b[?2004h>     # 149900 * 1 / 8 = 18737.5 paise: an exact tie rounds up.\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 1), 29, 149900),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 10, 15), date(2024, 11, 15), date(2024, 11, 1), 14, 67781),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_days_and_preserves_result_fields(start, end, on, unused, credit):\r\n\u001b[?2004l\r\", \"16685.87\")\r\n    assert doc[\"proration\"] == {\"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17}\r\n    assert ledger_csv([inv]).splitlines()[1] == (\r\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\r\n    )\r\nPY\r\n"]
