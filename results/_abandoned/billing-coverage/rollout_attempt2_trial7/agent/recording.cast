[91.03028, "o", "\u001b[31m-INVOICE INV-2024-0042                                          issued 2024-10-02\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mINVOICE INV-2024-0042                                                issued 2024-10-02\u001b[m\r\n Customer: Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\u001b[m\r\n\u001b[31m---------------------------------------------------------------------------------\u001b[m\r\n"]
[91.030308, "o", "\u001b[31m-Description                                         Amount        GST      Total\u001b[m\r\n\u001b[31m-Pro (monthly), Oct 2024                           1,499.00     269.82   1,768.82\u001b[m\r\n\u001b[31m-Additional seats x3, Oct 2024                       749.25     134.87     884.12\u001b[m\r\n"]
[91.030421, "o", "\u001b[31m-API overage, 1,001 calls                            250.25      45.05     295.30\u001b[m\r\n\u001b[31m-Priority support, Oct 2024                          999.00     179.82   1,178.82\u001b[m\r\n\u001b[31m---------------------------------------------------------------------------------\u001b[m\r\n\u001b[31m-Subtotal                                                                3,497.50\u001b[m\r\n\u001b[31m-GST @ 18%                                                                 629.56\u001b[m\r\n\u001b[31m-Total due (INR)                                                         4,127.06\u001b[m\r\n"]
[91.030444, "o", "\u001b[32m+\u001b[m\u001b[32m--------------------------------------------------------------------------------------\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mDescription                                      SAC      Amount        GST      Total\u001b[m\r\n"]
[91.0305, "o", "\u001b[32m+\u001b[m\u001b[32mPro (monthly), Oct 2024                       998314    1,499.00     269.82   1,768.82\u001b[m\r\n"]
[91.030565, "o", "\u001b[32m+\u001b[m\u001b[32mAdditional seats x3, Oct 2024                 998314      749.25     134.87     884.12\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mAPI overage, 1,001 calls                      998314      250.25      45.05     295.30\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mPriority support, Oct 2024                    998314      999.00     179.82   1,178.82\u001b[m\r\n"]
[91.030626, "o", "\u001b[32m+\u001b[m\u001b[32m--------------------------------------------------------------------------------------\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mSubtotal                                                                      3,497.50\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mGST @ 18%                                                                       629.56\u001b[m\r\n"]
[91.030654, "o", "\u001b[32m+\u001b[m\u001b[32mTotal due (INR)                                                               4,127.06\u001b[m\r\n"]
[91.03362, "o", "\"\"\"Monthly-to-annual upgrades and their invoice/accounting representation.\"\"\"\r\n\r\nimport json\r\nfrom datetime import date\r\n\r\nimport pytest\r\n"]
[91.033654, "o", "\r\nfrom billing import invoice\r\nfrom billing.export import erp_payload, ledger_csv, totals\r\nfrom billing.periods import Period, annual_period\r\nfrom billing.plans import get_plan\r\nfrom billing.proration import ProrationError, prorate_to_annual\r\nfrom billing.tax import line_gst\r\n"]
[91.033794, "o", "\r\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\r\n\r\n"]
[91.033814, "o", "@pytest.mark.parametrize(\"old,new\", [\r\n    (\"pro-annual\", \"pro-monthly\"),\r\n"]
[91.033865, "o", "    (\"pro-annual\", \"team-annual\"),\r\n    (\"pro-monthly\", \"team-monthly\"),\r\n"]
[91.033937, "o", "    (\"pro-monthly\", \"pro-monthly\"),\r\n])\r\ndef test_upgrade_rejects_other_interval_combinations(old, new):\r\n    with pytest.raises(ProrationError):\r\n"]
[91.033955, "o", "        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\r\n\r\n"]
[91.034015, "o", "@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\r\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\r\n    with pytest.raises(ProrationError, match=\"outside\"):\r\n"]
[91.034042, "o", "        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\r\n\r\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\r\n"]
[91.034107, "o", "    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997),\r\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 16), 16, 77368),\r\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 22), 7, 37475),\r\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\r\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 1), 29, 149900),\r\n"]
[91.034169, "o", "    (date(2024, 10, 15), date(2024, 11, 15), date(2024, 11, 1), 14, 67697),\r\n])\r\ndef test_upgrade_uses_actual_days_and_preserves_result_fields(start, end, on, unused, credit):\r\n    period = Period(start, end)\r\n"]
[91.034186, "o", "    r = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\r\n"]
[91.034242, "o", "    assert r.old_plan == get_plan(\"pro-monthly\")\r\n    assert r.new_plan == get_plan(\"team-annual\")\r\n"]
[91.034324, "o", "    assert r.period == period and r.on == on\r\n"]
[91.034391, "o", "    assert (r.unused_days, r.credit, r.charge, r.net) == (\r\n        unused, credit, 4999000, 4999000 - credit,\r\n"]
[91.034447, "o", "    )\r\n    assert r.new_period == annual_period(on)\r\n\r\n\r\ndef test_upgrade_rounds_exact_half_paisa_up(monkeypatch):\r\n"]
[91.03447, "o", "    from billing.plans import CATALOGUE, Plan\r\n\r\n"]
[91.034495, "o", "    monkeypatch.setitem(CATALOGUE, \"tie-monthly\", Plan(\"tie-monthly\", \"Tie\", \"month\", 1))\r\n"]
[91.034549, "o", "    r = prorate_to_annual(\"tie-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\r\n    assert r.unused_days == 15\r\n    assert r.credit == 1  # 1 * 15 / 30 = 0.5 paise, rounded up\r\n\r\n"]
[91.034567, "o", "\r\n"]
[91.034599, "o", "def test_upgrade_invoice_credit_order_and_no_mutation():\r\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n    original = list(inv.lines)\r\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n"]
[91.034674, "o", "    assert invoice.invoice_lines(inv) == expected\r\n    assert invoice.invoice_lines(inv) == expected\r\n    assert inv.lines == original\r\n    assert totals(inv) == (1414057, 254530, 1668587)\r\n    rendered = invoice.render(inv)\r\n"]
[91.034742, "o", "    assert \"-849.43\" in rendered and \"-152.90\" in rendered\r\n\r\n\r\ndef test_regular_invoice_has_no_credit_and_returns_independent_lines():\r\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n"]
[91.034768, "o", "    lines = invoice.invoice_lines(inv)\r\n    assert lines == inv.lines and lines is not inv.lines\r\n"]
[91.034804, "o", "    assert \"Proration credit:\" not in invoice.render(inv)\r\n\r\n\r\n"]
[91.034823, "o", "@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\ndef test_all_invoices_have_sac_and_86_character_table(number):\r\n    inv = invoice.FIXTURES[number]()\r\n"]
[91.034874, "o", "    rendered = invoice.render(inv).splitlines()\r\n"]
[91.034936, "o", "    header = rendered[3]\r\n    assert header == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n    for row, (description, amount) in zip(rendered[4:], invoice.invoice_lines(inv)):\r\n        assert len(row) == 86\r\n        assert row[:44] == f\"{description[:43]:<44}\"\r\n"]
[91.034957, "o", "        assert row[44:52] == \"  998314\"\r\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\r\n"]
[91.034981, "o", "        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\r\n        assert row[75:] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\r\n"]
[91.035009, "o", "    assert all(len(row) == 86 for row in rendered[2:])\r\n"]
[91.035083, "o", "    assert len(rendered[0]) == 86\r\n"]
[91.0351, "o", "\r\n\r\n"]
[91.036999, "o", "def test_description_is_cut_to_43_characters_with_blank_column():\r\n    inv = invoice.Invoice(\"LONG\", \"Buyer\", date(2024, 11, 14), [(\"X\" * 60, 125)])\r\n    row = invoice.render(inv).splitlines()[4]\r\n    assert row[:52] == \"X\" * 43 + \" \" + \"  998314\"\r\n\r\n\r\n@pytest.mark.parametrize(\"amount,gst\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\r\ndef test_gst_rounds_half_paisa_away_from_zero(amount, gst):\r\n    assert line_gst(amount) == gst\r\n\r\n\r\ndef test_upgrade_exports_include_credit_and_per_line_tax():\r\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n    doc = json.loads(erp_payload(inv))\r\n    assert doc[\"lines\"] == [\r\n        {\"description\": inv.lines[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\r\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\r\n    ]\r\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\r\n    assert doc[\"proration\"] == {\"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17}\r\n    assert ledger_csv([inv]).splitlines()[1] == (\r\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\r\n    )\r\n\u001b[?2004hroot@a9a41fb76362:/app# "]
