[78.697328, "o", "\"\"\"Exercise invoice fixture generation and the public command-line entry point.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_regenerate_golden_and_cli(tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     regenerate = invoice.regen_golden\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(invoice, \"regen_golden\", lambda: regenerate(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"--regen-golden\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert sorted(p.stem for p in tmp_path.iterdir()) == sorted(invoice.FIXTURES)\r\n\u001b[?2004l\r\u001b[?2004h>     for number, build in invoice.FIXTURES.items():\r\n\u001b[?2004l\r\u001b[?2004h>         expected = invoice.render(build())\r\n\u001b[?2004l\r\u001b[?2004h>         assert (tmp_path / f\"{number}.txt\").read_text() == expected\r\n\u001b[?2004l\r\u001b[?2004h>         assert invoice.main([number]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>         assert capsys.readouterr().out == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"args\", [[], [\"unknown\"]])\r\n\u001b[?2004l\r\u001b[?2004h> def test_cli_rejects_unknown_invoice(args, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         invoice.main(args)\r\n\u001b[?2004l\r\u001b[?2004h>     assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"known fixtures:\" in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r()\r\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", opener)\r\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\r\n    with pytest.raises(export.DeliveryError, match=\"failed after 4 attempts\"):\r\n        export.send_to_erp(upgrade)\r\n    assert opener.call_count == export.MAX_ATTEMPTS\r\n    assert [call.args[0] for call in sleep.call_args_list] == list(export.BACKOFF_S)\r\n\r\n\r\n@pytest.mark.parametrize(\"result,message\", [\r\n    (http_error(400), \"rejected\"),\r\n    (http_error(409), \"duplicate delivery\"),\r\n    (response({}), \"no document_id\"),\r\n])\r\ndef test_delivery_does_not_retry_permanent_failures(upgrade, monkeypatch, result, message):\r\n    opener = Mock(side_effect=result) if isinstance(result, Exception) else Mock(return_value=result)\r\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", opener)\r\n    with pytest.raises(export.DeliveryError, match=message):\r\n        export.send_to_erp(upgrade)\r\n    assert opener.call_count == 1\r\n\r\n\r\ndef test_delivery_returns_existing_document_on_conflict(upgrade, monkeypatch):\r\n    opene"]
