[81.7174, "o", "    with pytest.raises(export.ExportError, match=\"no lines\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.totals(replace(inv, lines=[], proration=None))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_ledger_rejects_unsupported_currency(inv):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"supports.*INR\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.ledger_csv([inv], currency=\"USD\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_ledger_rejects_net_credit_notes(inv):\r\n\u001b[?2004l\r\u001b[?2004h>     credit_note = replace(inv, lines=[(\"Refund\", -100)], proration=None)\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"issue a credit note\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.ledger_csv([credit_note])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_ledger_rejects_duplicate_numbers(inv):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"duplicate invoice numbers\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.ledger_csv([inv, inv])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_ledger_sorts_invoices(inv):\r\n\u001b[?2004l\r\u001b[?2004h>     earlier = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     same_day = replace(inv, number=\"INV-2024-0106\")\r\n\u001b[?2004l\r\u001b[?2004h>     rows = export.ledger_csv([inv, same_day, earlier]).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert [row.split(\",\")[0] for row in rows[1:]] == [earlier.number, same_day.number, inv.number]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_erp_line_limit_counts_proration_credit(inv):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.ExportError, match=\"100 lines exceeds.*99\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.erp_payload(replace(inv, lines=[(\"Service\", 100)] * 99))\r\n\u001b[?2004l\r\u001b[?2004h>     doc = json.loads(export.erp_payload(replace(inv, lines=[(\"Service\", 100)] * 98)))\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(doc[\"lines\"]) == 99\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @contextmanager\r\n\u001b[?2004l\r\u001b[?2004h> def response(document):\r\n\u001b[?2004l\r\u001b[?2004h>     yield io.BytesIO(json.dumps(document).encode())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def http_error(code, document=None):\r\n\u001b[?2004l\r\u001b[?2004h>     return urllib.error.HTTPError(\r\n\u001b[?2004l\r\u001b[?2004h>         \"https://erp.example/invoices\", code, \"error\", {},\r\n\u001b[?2004l\r\u001b[?2004h>         io.BytesIO(json.dumps(document).encode() if document is not None else b\"\"),\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.fixture\r\n\u001b[?2004l\r\u001b[?2004h> def gateway(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen = Mock()\r\n\u001b[?2004l\r\u001b[?2004h>     sleep = Mock()\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(export.time, \"sleep\", sleep)\r\n\u001b[?2004l\r\u001b[?2004h>     return urlopen, sleep\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_delivery_sends_upgrade_payload_with_auth_and_idempotency(inv, gateway):"]
