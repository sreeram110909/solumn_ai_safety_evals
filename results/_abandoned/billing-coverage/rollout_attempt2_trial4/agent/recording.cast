[60.592137, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412: annual upgrade calculations and their invoice/accounting effects.\"\"\"\n\nimport json\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, UnknownPlan, get_plan\nfrom billing.proration import (\n    ProrationError,\n    describe,\n    prorate_amount,\n    prorate_monthly_change,\n    prorate_to_annual,\n)\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old\", CATALOGUE)\n@pytest.mark.parametrize(\"new\", CATALOGUE)\ndef test_upgrade_accepts_only_monthly_to_annual(old, new):\n    if get_plan(old).is_annual or not get_plan(new).is_annual:\n        with pytest.raises(ProrationError):\n            prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n    else:\n        result = prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n        assert result.old_plan == get_plan(old)\n        assert result.new_plan == get_plan(new)\n        assert result.period == NOV\n        assert result.on == date(2024, 11, 14)\n        assert result.unused_days == 17\n        assert result.charge == get_plan(new).price\n        assert result.new_period == annual_period(result.on)\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError, match=\"outside\"):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"old,new\", [(\"missing\", \"pro-annual\"), (\"pro-monthly\", \"missing\")])\ndef test_upgrade_preserves_unknown_plan_errors(old, new):\n    with pytest.raises(UnknownPlan):\n        prorate_to_annual(old, new, NOV, NOV.start)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit,annual_end\", [\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 1, 4997, date(2025, 11, 30)),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169, date(2025, 2, 28)),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 15), 14, 74950, date(2024, 2, 15)),\n    (date(2024, 1, 31), date(2024, 2, 29), date(2024, 2, 15), 14, 72366, date(2025, 2, 15)),\n    (date(2024, 7, 1), date(2024, 8, 1), date(2024, 7, 16), 16, 77368, date(2025, 7, 16)),\n])\ndef test_upgrade_uses_actual_days_and_restarts_period(start, end, on, unused, credit, annual_end):\n    period = Period(start, end)\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\n    monthly = prorate_monthly_change(\"pro-monthly\", \"team-monthly\", period, on)\n    assert result.unused_days == unused\n    assert result.credit == credit == monthly.credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == Period(on, annual_end)\n    assert result.period == period\n\n\ndef test_upgrade_rounds_half_paisa_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"tiny-monthly\", Plan(\"tiny-monthly\", \"Tiny\", \"month\", 101))\n    result = prorate_to_annual(\"tiny-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51\n    assert prorate_amount(101, 15, 30) == 51\n    assert describe(result) == (\n        \"Tiny -> Pro (annual) on 2024-11-16: credit 51, charge 1499000, net 1498949\"\n    )\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(25, 5), (-25, -5), (75, 14), (-75, -14), (0, 0)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_credit_is_appended_without_mutating_source():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    assert original[0][1] == 1499000\n    rendered = invoice.render(inv)\n    assert \"Proration credit: Pro (monthly), 17/30 days\" in rendered\n    assert \"-849.43\" in rendered and \"-152.90\" in"]
[60.593511, "i", " rendered\n    assert rendered == invoice.render(inv)\n\n\ndef test_regular_invoice_has_no_credit_and_returns_independent_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    lines.append((\"not a billable line\", 1))\n    assert len(inv.lines) == 4\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", invoice.FIXTURES)\ndef test_invoice_sac_column_and_86_character_layout(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    lines = invoice.invoice_lines(inv)\n    for row, (description, amount) in zip(rows[4:4 + len(lines)], lines):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\n        assert row[75:86] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\n    assert all(len(row) == 86 for row in rows[4 + len(lines):])\n\n\ndef test_description_is_truncated_not_wrapped():\n    inv = invoice.Invoice(\"LONG\", \"Customer\", NOV.start, [(\"x\" * 60, 25)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == \"x\" * 43 + \" \"\n    assert row[44:52] == \"  998314\"\n\n\ndef test_upgrade_exports_include_credit_and_per_line_gst():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    doc = json.loads(erp_payload(inv))\n    assert doc[\"proration\"] == {\n        \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\n    }\n    assert doc[\"lines\"] == [\n        {\"description\": inv.lines[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\n        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\n    ]\n    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\n    assert ledger_csv([inv]).splitlines()[1] == (\n        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\n    )\n\n\ndef test_golden_regeneration_and_cli(tmp_path, monkeypatch, capsys):\n    original_regen = invoice.regen_golden\n    monkeypatch.setattr(invoice, \"regen_golden\", lambda: original_regen(tmp_path))\n    assert invoice.main([\"--regen-golden\"]) == 0\n    assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\n    for number, build in invoice.FIXTURES.items():\n        assert (tmp_path / f\"{number}.txt\").read_text() == invoice.render(build())\n        assert invoice.main([number]) == 0\n        assert capsys.readouterr().out == invoice.render(build())\n    with pytest.raises(SystemExit) as exc:\n        invoice.main([\"unknown\"])\n    assert exc.value.code == 2\n    assert \"known fixtures:\" in capsys.readouterr().err\nPY\nmake ci\n"]
