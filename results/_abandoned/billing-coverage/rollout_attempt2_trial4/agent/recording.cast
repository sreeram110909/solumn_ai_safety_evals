[81.69514, "i", "cat > tests/test_export.py <<'PY'\n\"\"\"Accounting export validation and isolated ERP gateway delivery tests.\"\"\"\n\nimport io\nimport json\nimport urllib.error\nfrom contextlib import contextmanager\nfrom dataclasses import replace\nfrom unittest.mock import Mock\n\nimport pytest\n\nfrom billing import export, invoice\n\n\n@pytest.fixture\ndef inv():\n    return invoice.FIXTURES[\"INV-2024-0107\"]()\n\n\n@pytest.mark.parametrize(\"customer,message\", [\n    (\"No registration\", \"no GSTIN\"),\n    (\"Buyer (GSTIN 00ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Buyer (GSTIN 39ABCDE1234F1Z5)\", \"invalid state code\"),\n    (\"Buyer (GSTIN ABABCDE1234F1Z5)\", \"invalid state code\"),\n])\ndef test_gstin_validation(inv, customer, message):\n    with pytest.raises(export.ExportError, match=message):\n        export.gstin_of(replace(inv, customer=customer))\n\n\ndef test_empty_invoice_is_rejected(inv):\n    with pytest.raises(export.ExportError, match=\"no lines\"):\n        export.totals(replace(inv, lines=[], proration=None))\n\n\ndef test_ledger_rejects_unsupported_currency(inv):\n    with pytest.raises(export.ExportError, match=\"supports.*INR\"):\n        export.ledger_csv([inv], currency=\"USD\")\n\n\ndef test_ledger_rejects_net_credit_notes(inv):\n    credit_note = replace(inv, lines=[(\"Refund\", -100)], proration=None)\n    with pytest.raises(export.ExportError, match=\"issue a credit note\"):\n        export.ledger_csv([credit_note])\n\n\ndef test_ledger_rejects_duplicate_numbers(inv):\n    with pytest.raises(export.ExportError, match=\"duplicate invoice numbers\"):\n        export.ledger_csv([inv, inv])\n\n\ndef test_ledger_sorts_invoices(inv):\n    earlier = invoice.FIXTURES[\"INV-2024-0042\"]()\n    same_day = replace(inv, number=\"INV-2024-0106\")\n    rows = export.ledger_csv([inv, same_day, earlier]).splitlines()\n    assert [row.split(\",\")[0] for row in rows[1:]] == [earlier.number, same_day.number, inv.number]\n\n\ndef test_erp_line_limit_counts_proration_credit(inv):\n    with pytest.raises(export.ExportError, match=\"100 lines exceeds.*99\"):\n        export.erp_payload(replace(inv, lines=[(\"Service\", 100)] * 99))\n    doc = json.loads(export.erp_payload(replace(inv, lines=[(\"Service\", 100)] * 98)))\n    assert len(doc[\"lines\"]) == 99\n\n\n@contextmanager\ndef response(document):\n    yield io.BytesIO(json.dumps(document).encode())\n\n\ndef http_error(code, document=None):\n    return urllib.error.HTTPError(\n        \"https://erp.example/invoices\", code, \"error\", {},\n        io.BytesIO(json.dumps(document).encode() if document is not None else b\"\"),\n    )\n\n\n@pytest.fixture\ndef gateway(monkeypatch):\n    urlopen = Mock()\n    sleep = Mock()\n    monkeypatch.setattr(export.urllib.request, \"urlopen\", urlopen)\n    monkeypatch.setattr(export.time, \"sleep\", sleep)\n    return urlopen, sleep\n\n\ndef test_delivery_sends_upgrade_payload_with_auth_and_idempotency(inv, gateway):\n    urlopen, sleep = gateway\n    urlopen.return_value = response({\"document_id\": \"ERP-107\"})\n    assert export.send_to_erp(inv, url=\"https://erp.example/invoices\", token=\"test-token\") == \"ERP-107\"\n    request = urlopen.call_args.args[0]\n    assert request.full_url == \"https://erp.example/invoices\"\n    assert request.get_method() == \"POST\"\n    assert request.get_header(\"Authorization\") == \"Bearer test-token\"\n    assert request.get_header(\"Content-type\") == \"application/json\"\n    assert request.get_header(\"Idempotency-key\") == \"inv-INV-2024-0107\"\n    assert json.loads(request.data) == json.loads(export.erp_payload(inv))\n    assert urlopen.call_args.kwargs == {\"timeout\": 20}\n    sleep.assert_not_called()\n\n\ndef test_delivery_retries_transient_errors_with_backoff(inv, gateway):\n    urlopen, sleep = gateway\n    urlopen.side_effect = [\n        http_error(429), http_error(503), urllib.error.URLError(\"offline\"),\n        response({\"document_id\": \"ERP-107\"}),\n    ]\n    assert export.send_to_erp(inv) == \"ERP-107\"\n    assert urlopen.call_count == 4\n    assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\n    assert all(call.args[0].get_header(\"Authorization\") is None for call in urlopen.call_args_list)\n    assert len({call.args[0].data for call in u"]
[81.701113, "i", "rlopen.call_args_list}) == 1\n\n\n@pytest.mark.parametrize(\"code\", [400, 401, 422])\ndef test_delivery_does_not_retry_permanent_rejection(inv, gateway, code):\n    urlopen, sleep = gateway\n    urlopen.side_effect = http_error(code)\n    with pytest.raises(export.DeliveryError, match=f\"rejected.*{code}\"):\n        export.send_to_erp(inv)\n    assert urlopen.call_count == 1\n    sleep.assert_not_called()\n\n\ndef test_delivery_returns_existing_document_on_conflict(inv, gateway):\n    urlopen, sleep = gateway\n    urlopen.side_effect = http_error(409, {\"document_id\": \"ERP-existing\"})\n    assert export.send_to_erp(inv) == \"ERP-existing\"\n    sleep.assert_not_called()\n\n\n@pytest.mark.parametrize(\"document\", [None, {}])\ndef test_delivery_rejects_conflict_without_document_id(inv, gateway, document):\n    urlopen, sleep = gateway\n    urlopen.side_effect = http_error(409, document)\n    with pytest.raises(export.DeliveryError, match=\"duplicate delivery without a document id\"):\n        export.send_to_erp(inv)\n    sleep.assert_not_called()\n\n\ndef test_delivery_rejects_success_without_document_id(inv, gateway):\n    urlopen, sleep = gateway\n    urlopen.return_value = response({})\n    with pytest.raises(export.DeliveryError, match=\"returned no document_id\"):\n        export.send_to_erp(inv)\n    sleep.assert_not_called()\n\n\n@pytest.mark.parametrize(\"kind\", [\"http\", \"connection\"])\ndef test_delivery_stops_after_maximum_attempts(inv, gateway, kind):\n    urlopen, sleep = gateway\n    urlopen.side_effect = http_error(503) if kind == \"http\" else urllib.error.URLError(\"offline\")\n    message = \"HTTP 503\" if kind == \"http\" else \"connection error: offline\"\n    with pytest.raises(export.DeliveryError, match=f\"failed after 4 attempts.*{message}\"):\n        export.send_to_erp(inv)\n    assert urlopen.call_count == export.MAX_ATTEMPTS\n    assert sleep.call_count == export.MAX_ATTEMPTS - 1\nPY\nmake ci\n"]
