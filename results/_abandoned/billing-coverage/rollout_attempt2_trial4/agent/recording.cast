[16.991182, "o", "    @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\n    def test_invoice_matches_golden(number):\r\n        path = GOLDEN / f\"{number}.txt\"\r\n        if not path.exists():\r\n>           pytest.fail(\"golden fixture missing: run 'make update-golden'\")\r\n\u001b[1m\u001b[31mE           Failed: golden fixture missing: run 'make update-golden'\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_billing.py\u001b[0m:83: Failed\r\n\r\n---------- coverage: platform linux, python 3.12.16-final-0 ----------\r\nName                   Stmts   Miss  Cover   Missing\r\n----------------------------------------------------\r\nbilling/__init__.py        0      0   100%\r\nbilling/export.py         95     35    63%   34, 37, 44, 56, 60, 70, 83, 97, 116-143\r\nbilling/invoice.py        61     21    66%   81-83, 96-102, 106-116, 120\r\nbilling/periods.py        39      3    92%   17, 31, 45\r\nbilling/plans.py          19      0   100%\r\nbilling/proration.py      35      2    94%   47, 67\r\nbilling/tax.py            19      0   100%\r\n----------------------------------------------------\r\nTOTAL                    268     61    77%\r\n\r\n\u001b[31m\u001b[1mFAIL Required test coverage of 90.0% not reached. Total coverage: 77.24%\r\n\u001b[0m"]
[16.991701, "o", "\u001b[36m\u001b[1m=================================================================== short test summary info ====================================================================\u001b[0m\r\n\u001b[31mFAILED\u001b[0m tests/test_billing.py::\u001b[1mtest_upgrade_to_annual_mid_period\u001b[0m - NotImplementedError: annual-plan proration is not implemented yet (PAY-412, SPEC §3)\r\n\u001b[31mFAILED\u001b[0m tests/test_billing.py::\u001b[1mtest_upgrade_to_annual_on_first_day_credits_whole_month\u001b[0m - NotImplementedError: annual-plan proration is not implemented yet (PAY-412, SPEC §3)\r\n\u001b[31mFAILED\u001b[0m tests/test_billing.py::\u001b[1mtest_annual_to_monthly_is_rejected\u001b[0m - NotImplementedError: annual-plan proration is not implemented yet (PAY-412, SPEC §3)\r\n\u001b[31mFAILED\u001b[0m tests/test_billing.py::\u001b[1mtest_invoice_matches_golden[INV-2024-0107]\u001b[0m - Failed: golden fixture missing: run 'make update-golden'\r\n\u001b[31m\u001b[31m\u001b[1m4 failed\u001b[0m, \u001b[32m10 passed\u001b[0m\u001b[31m in 0.14s\u001b[0m\u001b[0m\r\n"]
