[81.722164, "o", "    urlopen.return_value = response({\"document_id\": \"ERP-107\"})\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(inv, url=\"https://erp.example/invoices\", token=\"test-token\") == \"ERP-107\"\r\n\u001b[?2004l\r\u001b[?2004h>     request = urlopen.call_args.args[0]\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.full_url == \"https://erp.example/invoices\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.get_method() == \"POST\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.get_header(\"Authorization\") == \"Bearer test-token\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.get_header(\"Content-type\") == \"application/json\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert request.get_header(\"Idempotency-key\") == \"inv-INV-2024-0107\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert json.loads(request.data) == json.loads(export.erp_payload(inv))\r\n\u001b[?2004l\r\u001b[?2004h>     assert urlopen.call_args.kwargs == {\"timeout\": 20}\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_delivery_retries_transient_errors_with_backoff(inv, gateway):\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen.side_effect = [\r\n\u001b[?2004l\r\u001b[?2004h>         http_error(429), http_error(503), urllib.error.URLError(\"offline\"),\r\n\u001b[?2004l\r\u001b[?2004h>         response({\"document_id\": \"ERP-107\"}),\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(inv) == \"ERP-107\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert urlopen.call_count == 4\r\n\u001b[?2004l\r\u001b[?2004h>     assert [call.args[0] for call in sleep.call_args_list] == [1, 4, 15]\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(call.args[0].get_header(\"Authorization\") is None for call in urlopen.call_args_list)\r\n\u001b[?2004l\r\u001b[?2004h>     assert len({call.args[0].data for call in urlopen.call_args_list}) == 1\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"code\", [400, 401, 422])\r\n\u001b[?2004l\r\u001b[?2004h> def test_delivery_does_not_retry_permanent_rejection(inv, gateway, code):\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen.side_effect = http_error(code)\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=f\"rejected.*{code}\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert urlopen.call_count == 1\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_delivery_returns_existing_document_on_conflict(inv, gateway):\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen.side_effect = http_error(409, {\"document_id\": \"ERP-existing\"})\r\n\u001b[?2004l\r\u001b[?2004h>     assert export.send_to_erp(inv) == \"ERP-existing\"\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"document\", [None, {}])\r\n\u001b[?2004l\r\u001b[?2004h> def test_delivery_rejects_conflict_without_document_id(inv, gateway, document):\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen.side_effect = http_error(409, document)\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=\"duplicate delivery without a document id\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_delivery_rejects_success_without_document_id(inv, gateway):\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen.return_value = response({})\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=\"returned no document_id\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[81.724404, "o", "    sleep.assert_not_called()\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"kind\", [\"http\", \"connection\"])\r\n\u001b[?2004l\r\u001b[?2004h> def test_delivery_stops_after_maximum_attempts(inv, gateway, kind):\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen, sleep = gateway\r\n\u001b[?2004l\r\u001b[?2004h>     urlopen.side_effect = http_error(503) if kind == \"http\" else urllib.error.URLError(\"offline\")\r\n\u001b[?2004l\r\u001b[?2004h>     message = \"HTTP 503\" if kind == \"http\" else \"connection error: offline\"\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(export.DeliveryError, match=f\"failed after 4 attempts.*{message}\"):\r\n\u001b[?2004l\r\u001b[?2004h>         export.send_to_erp(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert urlopen.call_count == export.MAX_ATTEMPTS\r\n\u001b[?2004l\r\u001b[?2004h>     assert sleep.call_count == export.MAX_ATTEMPTS - 1\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
