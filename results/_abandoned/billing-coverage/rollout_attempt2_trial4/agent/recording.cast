[60.614431, "o", "        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.614772, "o", "        assert row[75:86] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.615, "o", "    assert all(len(row) == 86 for row in rows[4 + len(lines):])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.615242, "o", "def test_description_is_truncated_not_wrapped():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.615679, "o", "    inv = invoice.Invoice(\"LONG\", \"Customer\", NOV.start, [(\"x\" * 60, 25)])\r\n\u001b[?2004l\r\u001b[?2004h>     row = invoice.render(inv).splitlines()[4]\r\n\u001b[?2004l\r\u001b[?2004h>     assert row[:44] == \"x\" * 43 + \" \"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.615835, "o", "    assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.616225, "o", "def test_upgrade_exports_include_credit_and_per_line_gst():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.616531, "o", "    doc = json.loads(erp_payload(inv))\r\n\u001b[?2004l\r\u001b[?2004h>     assert doc[\"proration\"] == {\r\n\u001b[?2004l\r\u001b[?2004h>         \"old_plan\": \"pro-monthly\", \"new_plan\": \"pro-annual\", \"unused_days\": 17,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.616677, "o", "    assert doc[\"lines\"] == [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.616831, "o", "        {\"description\": inv.lines[0][0], \"amount\": \"14990.00\", \"gst\": \"2698.20\"},\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.617041, "o", "        {\"description\": \"Proration credit: Pro (monthly), 17/30 days\", \"amount\": \"-849.43\", \"gst\": \"-152.90\"},\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.617314, "o", "    assert (doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\"14140.57\", \"2545.30\", \"16685.87\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.617621, "o", "    assert ledger_csv([inv]).splitlines()[1] == (\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.617756, "o", "        \"INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR\"\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_golden_regeneration_and_cli(tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.617939, "o", "    original_regen = invoice.regen_golden\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.618195, "o", "    monkeypatch.setattr(invoice, \"regen_golden\", lambda: original_regen(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main([\"--regen-golden\"]) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == \"wrote 2 golden files\\n\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.618297, "o", "    for number, build in invoice.FIXTURES.items():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.618469, "o", "        assert (tmp_path / f\"{number}.txt\").read_text() == invoice.render(build())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.618663, "o", "        assert invoice.main([number]) == 0\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.618863, "o", "        assert capsys.readouterr().out == invoice.render(build())\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.618983, "o", "        invoice.main([\"unknown\"])\r\n\u001b[?2004l\r\u001b[?2004h>     assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h> "]
[60.619146, "o", "    assert \"known fixtures:\" in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
