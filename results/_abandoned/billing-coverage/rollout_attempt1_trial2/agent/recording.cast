[57.540703, "o", "        'old_plan': 'pro-monthly', 'new_plan': 'pro-annual', 'unused_days': 17,\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.540797, "o", "    assert ledger_csv([inv]).splitlines()[1] == (\r\n\u001b[?2004l\r"]
[57.54093, "o", "\u001b[?2004h> "]
[57.541004, "o", "        'INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.54114, "o", "    )\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_regenerated_goldens_match_checked_in_files(tmp_path):"]
[57.541281, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.541448, "o", "    written = invoice.regen_golden(tmp_path / 'golden')\r\n\u001b[?2004l\r\u001b[?2004h"]
[57.541486, "o", "> "]
[57.541766, "o", "    assert {path.stem for path in written} == set(invoice.FIXTURES)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[57.541866, "o", "    for path in written:\r\n\u001b[?2004l\r"]
[57.542015, "o", "\u001b[?2004h> "]
[57.542188, "o", "        assert path.read_text() == (invoice.GOLDEN_DIR / path.name).read_text()\r\n\u001b[?2004l\r"]
[57.542332, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[57.542418, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[57.544342, "o", "\u001b[?2004h> def test_invoice_cli_prints_upgrade(capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main(['INV-2024-0107']) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == invoice.render(invoice.FIXTURES['INV-2024-0107']())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_regenerates_goldens(tmp_path, monkeypatch, capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     regenerate = invoice.regen_golden\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(invoice, 'regen_golden', lambda: regenerate(tmp_path))\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.main(['--regen-golden']) == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert capsys.readouterr().out == 'wrote 2 golden files\\n'\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(list(tmp_path.glob('*.txt'))) == 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_cli_rejects_unknown_fixture(capsys):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(SystemExit) as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         invoice.main(['missing'])\r\n\u001b[?2004l\r\u001b[?2004h>     assert exc.value.code == 2\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'known fixtures:' in capsys.readouterr().err\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[57.54596, "o", "\u001b[?2004hroot@9c0a2df7495d:/app# make ci\r\n\u001b[?2004l\r"]
