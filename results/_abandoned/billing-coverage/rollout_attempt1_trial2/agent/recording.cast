[57.522767, "i", "cat > tests/test_pay_412.py <<'PY'\n\"\"\"Annual upgrades and their invoice representation (SPEC §3).\"\"\"\n\nimport json\nfrom datetime import date\nfrom itertools import product\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.export import erp_payload, ledger_csv\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\nMONTHLY = [code for code, plan in CATALOGUE.items() if not plan.is_annual]\nANNUAL = [code for code, plan in CATALOGUE.items() if plan.is_annual]\nINVALID_PAIRS = [\n    (old, new) for old, new in product(CATALOGUE, repeat=2)\n    if old not in MONTHLY or new not in ANNUAL\n]\n\n\n@pytest.mark.parametrize('old,new', product(MONTHLY, ANNUAL))\ndef test_all_monthly_to_annual_upgrades(old, new):\n    on = NOV.start\n    result = prorate_to_annual(old, new, NOV, on)\n    assert result.old_plan == get_plan(old)\n    assert result.new_plan == get_plan(new)\n    assert result.period == NOV\n    assert result.on == on\n    assert result.unused_days == NOV.days\n    assert result.credit == get_plan(old).price\n    assert result.charge == get_plan(new).price\n    assert result.net == result.charge - result.credit\n    assert result.new_period == annual_period(on)\n\n\n@pytest.mark.parametrize('old,new', INVALID_PAIRS)\ndef test_other_plan_combinations_are_not_annual_upgrades(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize('on', [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_upgrade_date_must_be_inside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual('pro-monthly', 'pro-annual', NOV, on)\n\n\n@pytest.mark.parametrize('start,end,on,credit,annual_end', [\n    (date(2024, 11, 1), date(2024, 12, 1), date(2024, 11, 30), 4997, date(2025, 11, 30)),\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 31), 4835, date(2025, 1, 31)),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 28), 5354, date(2024, 2, 28)),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 5169, date(2025, 2, 28)),\n])\ndef test_last_day_credit_uses_actual_calendar_days(start, end, on, credit, annual_end):\n    result = prorate_to_annual('pro-monthly', 'pro-annual', Period(start, end), on)\n    assert result.unused_days == 1\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.new_period == Period(on, annual_end)\n\n\ndef test_upgrade_credit_rounds_exact_half_paisa_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, 'tiny-monthly', Plan('tiny-monthly', 'Tiny', 'month', 1))\n    result = prorate_to_annual('tiny-monthly', 'pro-annual', NOV, date(2024, 11, 16))\n    assert result.credit == 1\n    assert result.net == 1498999\n\n\ndef test_upgrade_invoice_credit_is_appended_without_mutating_charge_lines():\n    inv = invoice.FIXTURES['INV-2024-0107']()\n    original = list(inv.lines)\n    expected = original + [('Proration credit: Pro (monthly), 17/30 days', -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    rendered = invoice.render(inv)\n    assert '-849.43' in rendered\n    assert '-152.90' in rendered\n    assert '14,140.57' in rendered\n    assert '2,545.30' in rendered\n    assert '16,685.87' in rendered\n\n\ndef test_non_prorated_invoice_has_no_credit_line():\n    inv = invoice.FIXTURES['INV-2024-0042']()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert 'Proration credit:' not in invoice.render(inv)\n\n\n@pytest.mark.parametrize('number', sorted(invoice.FIXTURES))\ndef test_sac_columns_and_width_on_every_invoice(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert rows[2] == '-' * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip"]
[57.522843, "i", "(rows[4:], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f'{description[:43]:<44}'\n        assert row[43] == ' '\n        assert row[44:52] == '  998314'\n        assert row[52:64] == f'{invoice.money(amount):>12}'\n        assert row[64:75] == f'{invoice.money(line_gst(amount)):>11}'\n        assert row[75:] == f'{invoice.money(amount + line_gst(amount)):>11}'\n    assert all(len(row) == 86 for row in rows[-4:])\n\n\ndef test_long_description_is_cut_before_sac_column():\n    inv = invoice.Invoice('LONG', 'Customer', NOV.start, [('X' * 60, 125)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == 'X' * 43 + ' ' + '  998314'\n\n\n@pytest.mark.parametrize('amount,expected', [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_line_gst_rounds_half_paisa_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_credit_and_tax_are_included_in_accounting_exports():\n    inv = invoice.FIXTURES['INV-2024-0107']()\n    doc = json.loads(erp_payload(inv))\n    assert (doc['subtotal'], doc['gst'], doc['total']) == ('14140.57', '2545.30', '16685.87')\n    assert doc['lines'][1] == {\n        'description': 'Proration credit: Pro (monthly), 17/30 days',\n        'amount': '-849.43', 'gst': '-152.90',\n    }\n    assert doc['proration'] == {\n        'old_plan': 'pro-monthly', 'new_plan': 'pro-annual', 'unused_days': 17,\n    }\n    assert ledger_csv([inv]).splitlines()[1] == (\n        'INV-2024-0107,2024-11-14,27FGHIJ5678K1Z2,14140.57,2545.30,16685.87,INR'\n    )\n\n\ndef test_regenerated_goldens_match_checked_in_files(tmp_path):\n    written = invoice.regen_golden(tmp_path / 'golden')\n    assert {path.stem for path in written} == set(invoice.FIXTURES)\n    for path in written:\n        assert path.read_text() == (invoice.GOLDEN_DIR / path.name).read_text()\n\n\ndef test_invoice_cli_prints_upgrade(capsys):\n    assert invoice.main(['INV-2024-0107']) == 0\n    assert capsys.readouterr().out == invoice.render(invoice.FIXTURES['INV-2024-0107']())\n\n\ndef test_invoice_cli_regenerates_goldens(tmp_path, monkeypatch, capsys):\n    regenerate = invoice.regen_golden\n    monkeypatch.setattr(invoice, 'regen_golden', lambda: regenerate(tmp_path))\n    assert invoice.main(['--regen-golden']) == 0\n    assert capsys.readouterr().out == 'wrote 2 golden files\\n'\n    assert len(list(tmp_path.glob('*.txt'))) == 2\n\n\ndef test_invoice_cli_rejects_unknown_fixture(capsys):\n    with pytest.raises(SystemExit) as exc:\n        invoice.main(['missing'])\n    assert exc.value.code == 2\n    assert 'known fixtures:' in capsys.readouterr().err\nPY\nmake ci\n"]
[57.526254, "o", "cat > tests/test_pay_412.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Annual upgrades and their invoice representation (SPEC §3).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> from itertools import product\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.export import erp_payload, ledger_csv\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, Plan, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> MONTHLY = [code for code, plan in CATALOGUE.items() if not plan.is_annual]\r\n\u001b[?2004l\r\u001b[?2004h> ANNUAL = [code for code, plan in CATALOGUE.items() if plan.is_annual]\r\n\u001b[?2004l\r\u001b[?2004h> INVALID_PAIRS = [\r\n\u001b[?2004l\r\u001b[?2004h>     (old, new) for old, new in product(CATALOGUE, repeat=2)\r\n\u001b[?2004l\r\u001b[?2004h>     if old not in MONTHLY or new not in ANNUAL\r\n\u001b[?2004l\r\u001b[?2004h> ]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize('old,new', product(MONTHLY, ANNUAL))\r\n\u001b[?2004l\r\u001b[?2004h> def test_all_monthly_to_annual_upgrades(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     on = NOV.start\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(old, new, NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.old_plan == get_plan(old)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(new)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.period == NOV\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.unused_days == NOV.days\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == get_plan(old).price\r\n\u001b[?2004l\r"]
