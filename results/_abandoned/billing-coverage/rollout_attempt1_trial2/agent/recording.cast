[15.004976, "o", "\"\"\"Accounting exports: the finance ledger CSV and the ERP invoice payload (finance-ops, 2023).\r\n\r\n    from billing.export import ledger_csv, erp_payload\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport csv\r\nimport io\r\nimport json\r\nimport re\r\nfrom decimal import Decimal\r\n\r\nfrom billing.invoice import Invoice, invoice_lines\r\nfrom billing.tax import tax_lines\r\n\r\nLEDGER_COLUMNS = [\"invoice\", \"issued\", \"gstin\", \"subtotal\", \"gst\", \"total\", \"currency\"]\r\nERP_MAX_LINES = 99          # the ERP rejects invoices with more lines than this\r\nSUPPORTED_CURRENCIES = {\"INR\"}\r\nGSTIN_RE = re.compile(r\"\\(GSTIN ([0-9A-Z]{15})\\)\")\r\n\r\n\r\nclass ExportError(ValueError):\r\n    pass\r\n\r\n\r\ndef gstin_of(invoice: Invoice) -> str:\r\n    \"\"\"The customer's GSTIN, as printed in the customer field: 'Name (GSTIN 29ABCDE1234F1Z5)'.\"\"\"\r\n    m = GSTIN_RE.search(invoice.customer)\r\n    if not m:\r\n        raise ExportError(f\"{invoice.number}: customer has no GSTIN: {invoice.customer!r}\")\r\n    gstin = m.group(1)\r\n    if not gstin[:2].isdigit() or not 1 <= int(gstin[:2]) <= 38:\r\n        raise ExportError(f\"{invoice.number}: GSTIN {gstin} has an invalid state code\")\r\n    return gstin\r\n\r\n\r\ndef totals(invoice: Invoice) -> tuple[int, int, int]:\r\n    taxed = tax_lines(invoice_lines(invoice))\r\n    if not taxed:\r\n        raise ExportError(f\"{invoice.number}: invoice has no lines\")\r\n    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    return subtotal, gst, subtotal + gst\r\n\r\n\r\ndef rupees(paise: int) -> str:\r\n    return str((Decimal(paise) / 100).quantize(Decimal(\"0.01\")))\r\n\r\n\r\ndef ledger_row(invoice: Invoice, currency: str = \"INR\") -> list[str]:\r\n    if currency not in SUPPORTED_CURRENCIES:\r\n        raise ExportError(f\"{invoice.number}: ledger export supports {sorted(SUPPORTED_CURRENCIES)}, not {currency}\")\r\n    subtotal, gst, total = totals(invoice)\r\n    if total < 0:\r\n        # net credit notes go through the finance adjustments flow, not the ledger import\r\n        raise ExportError(f\"{invoice.number}: net total {rupees(total)} is negative; issue a credit note instead\")\r\n    return [invoice.number, invoice.issued.isoformat(), gstin_of(invoice), rupees(subtotal), rupees(gst),\r\n            rupees(total), currency]\r\n\r\n\r\ndef ledger_csv(invoices: list[Invoice], currency: str = \"INR\") -> str:\r\n    \"\"\"Finance's ledger import: one row per invoice, header first, RFC 4180 quoting.\"\"\"\r\n    numbers = [inv.number for inv in invoices]\r\n    dupes = sorted({n for n in numbers if numbers.count(n) > 1})\r\n    if dupes:\r\n        raise ExportError(f\"duplicate invoice numbers in export: {dupes}\")\r\n    buf = io.StringIO()\r\n    writer = csv.writer(buf, lineterminator=\"\\n\")\r\n    writer.writerow(LEDGER_COLUMNS)\r\n    for inv in sorted(invoices, key=lambda i: (i.issued, i.number)):\r\n        writer.writerow(ledger_row(inv, currency))\r\n    return buf.getvalue()\r\n\r\n\r\ndef erp_payload(invoice: Invoice) -> str:\r\n    \"\"\"JSON document for the ERP's invoice endpoint.\"\"\"\r\n    lines = invoice_lines(invoice)\r\n    if len(lines) > ERP_MAX_LINES:\r\n        raise ExportError(f\"{invoice.number}: {len(lines)} lines exceeds the ERP limit of {ERP_MAX_LINES}\")\r\n    taxed = tax_lines(lines)\r\n    subtotal, gst, total = totals(invoice)\r\n    doc = {\r\n        \"invoice_number\": invoice.number,\r\n        \"issue_date\": invoice.issued.isoformat(),\r\n        \"buyer_gstin\": gstin_of(invoice),\r\n        \"lines\": [{\"description\": t.description, \"amount\": rupees(t.amount), \"gst\": rupees(t.gst)}\r\n                  for t in taxed],\r\n        \"subtotal\": rupees(subtotal),\r\n        \"gst\": rupees(gst),\r\n        \"total\": rupees(total),\r\n    }\r\n    if invoice.proration is not None:\r\n        doc[\"proration\"] = {\"old_plan\": invoice.proration.old_plan.code,\r\n                            \"new_plan\": invoice.proration.new_plan.code,\r\n                            \"unused_days\": invoice.proration.unused_days}\r\n    return json.dumps(doc, sort_keys=True)\r\n"]
[15.007281, "o", "import json\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nfrom billing import invoice\r\nfrom billing.periods import Period, add_months, annual_period, monthly_period, remaining_days\r\n"]
[15.007988, "o", "from billing.plans import UnknownPlan, get_plan\r\nfrom billing.proration import ProrationError, prorate_monthly_change, prorate_to_annual\r\nfrom billing.export import erp_payload, ledger_csv\r\nfrom billing.tax import line_gst, tax_line\r\n\r\nGOLDEN = Path(__file__).parent / \"golden\"\r\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\r\n\r\n# --- plans -----------------------------------------------------------------------\r\ndef test_catalogue_lookup():\r\n    assert get_plan(\"pro-annual\").price == 1499000\r\n    assert get_plan(\"pro-annual\").is_annual\r\n    with pytest.raises(UnknownPlan):\r\n        get_plan(\"enterprise\")\r\n\r\n\r\n# --- periods ---------------------------------------------------------------------\r\ndef test_add_months_clamps_to_month_end():\r\n    assert add_months(date(2024, 1, 31), 1) == date(2024, 2, 29)\r\n    assert add_months(date(2023, 1, 31), 1) == date(2023, 2, 28)\r\n    assert add_months(date(2024, 11, 15), 2) == date(2025, 1, 15)\r\n\r\n\r\ndef test_monthly_period_is_anchored():\r\n    p = monthly_period(date(2024, 3, 15), date(2024, 11, 2))\r\n    assert (p.start, p.end, p.days) == (date(2024, 10, 15), date(2024, 11, 15), 31)\r\n\r\n\r\ndef test_remaining_days_counts_the_change_day():\r\n    assert remaining_days(NOV, date(2024, 11, 30)) == 1\r\n    with pytest.raises(ValueError):\r\n        remaining_days(NOV, date(2024, 12, 1))\r\n\r\n\r\ndef test_annual_period_from_leap_day():\r\n    assert annual_period(date(2024, 2, 29)).end == date(2025, 2, 28)\r\n\r\n\r\n# --- tax -------------------------------------------------------------------------\r\ndef test_line_gst():\r\n    assert line_gst(149900) == 26982\r\n    assert line_gst(100000) == 18000\r\n    assert line_gst(-84943) == -15290\r\n    assert tax_line(\"x\", 49900).total == 58882\r\n\r\n\r\n# --- proration ---------------------------------------------------------------------\r\ndef test_monthly_change_prorates_both_sides():\r\n    r = prorate_monthly_change(\"starter-monthly\", \"pro-monthly\", NOV, date(2024, 11, 16))\r\n    assert (r.unused_days, r.credit, r.charge, r.net) == (15, 24950, 74950, 50000)\r\n\r\n\r\ndef test_upgrade_to_annual_mid_period():\r\n    r = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 14))\r\n    assert (r.unused_days, r.credit, r.charge, r.net) == (17, 84943, 1499000, 1414057)\r\n    assert (r.new_period.start, r.new_period.end) == (date(2024, 11, 14), date(2025, 11, 14))\r\n\r\n\r\ndef test_upgrade_to_annual_on_first_day_credits_whole_month():\r\n    r = prorate_to_annual(\"team-monthly\", \"team-annual\", NOV, date(2024, 11, 1))\r\n    assert (r.unused_days, r.credit, r.net) == (30, 499900, 4999000 - 499900)\r\n\r\n\r\ndef test_annual_to_monthly_is_rejected():\r\n    with pytest.raises(ProrationError):\r\n        prorate_to_annual(\"pro-annual\", \"pro-monthly\", NOV, date(2024, 11, 14))\r\n\r\n\r\n# --- invoices ------------------------------------------------------------------------\r\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\ndef test_invoice_matches_golden(number):\r\n    path = GOLDEN / f\"{number}.txt\"\r\n    if not path.exists():\r\n        pytest.fail(\"golden fixture missing: run 'make update-golden'\")\r\n    assert invoice.render(invoice.FIXTURES[number]()) == path.read_text()\r\n\r\n\r\n# --- accounting export ---------------------------------------------------------------\r\n\r\nfrom billing.export import erp_payload, ledger_csv\r\n\r\n\r\ndef test_ledger_csv_has_header_and_one_row_per_invoice():\r\n    rows = ledger_csv([invoice.FIXTURES[\"INV-2024-0042\"]()]).splitlines()\r\n    assert rows[0] == \"invoice,issued,gstin,subtotal,gst,total,currency\"\r\n    assert rows[1] == \"INV-2024-0042,2024-10-02,29ABCDE1234F1Z5,3497.50,629.56,4127.06,INR\"\r\n\r\n\r\ndef test_erp_payload_totals():\r\n    doc = json.loads(erp_payload(invoice.FIXTURES[\"INV-2024-0042\"]()))\r\n    assert (doc[\"buyer_gstin\"], doc[\"subtotal\"], doc[\"gst\"], doc[\"total\"]) == (\r\n        \"29ABCDE1234F1Z5\", \"3497.50\", \"629.56\", \"4127.06\")\r\n    assert len(doc[\"lines\"]) == 4 and \"proration\" not in doc\r\n\u001b[?2004hroot@9c0a2df7495d:/app# "]
