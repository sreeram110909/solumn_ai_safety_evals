[66.103264, "o", "\u001b[1mdiff --git a/billing/invoice.py b/billing/invoice.py\u001b[m\r\n\u001b[1mindex cc5970f..06665c2 100644\u001b[m\r\n\u001b[1m--- a/billing/invoice.py\u001b[m\r\n\u001b[1m+++ b/billing/invoice.py\u001b[m"]
[66.105152, "o", "\r\n\u001b[36m@@ -17,7 +17,8 @@\u001b[m \u001b[mfrom billing.proration import ProrationResult, prorate_to_annual\u001b[m\r\n from billing.tax import tax_lines\u001b[m\r\n \u001b[m\r\n GOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\u001b[m\r\n\u001b[31m-WIDTH = 80\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mWIDTH = 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mSAC = \"998314\"\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n @dataclass\u001b[m\r\n\u001b[36m@@ -37,8 +38,15 @@\u001b[m \u001b[mdef money(paise: int) -> str:\u001b[m\r\n \u001b[m\r\n def invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\u001b[m\r\n     \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\u001b[m\r\n\u001b[31m-    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\u001b[m\r\n\u001b[31m-    return list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    lines = list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if invoice.proration is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        proration = invoice.proration\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        lines.append((\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"Proration credit: {proration.old_plan.name}, \"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"{proration.unused_days}/{proration.period.days} days\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            -proration.credit,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return lines\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def render(invoice: Invoice) -> str:\u001b[m\r\n\u001b[36m@@ -47,18 +55,18 @@\u001b[m \u001b[mdef render(invoice: Invoice) -> str:\u001b[m\r\n         f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\u001b[m\r\n         f\"Customer: {invoice.customer}\",\u001b[m\r\n         \"-\" * WIDTH,\u001b[m\r\n\u001b[31m-        f\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\",\u001b[m\r\n     ]\u001b[m\r\n     for line in taxed:\u001b[m\r\n\u001b[31m-        out.append(f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        out.append(f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n                    f\"{money(line.total):>11}\")\u001b[m\r\n     subtotal = sum(t.amount for t in taxed)\u001b[m\r\n     gst = sum(t.gst for t in taxed)\u001b[m\r\n     out += [\u001b[m\r\n         \"-\" * WIDTH,\u001b[m\r\n\u001b[31m-        f\"{'Subtotal':<46}{money(subtotal):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'GST @ 18%':<46}{money(gst):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'Total due (INR)':<46}{money(subtotal + gst):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Subtotal':<52}{money(subtotal):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'GST @ 18%':<52}{money(gst):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Total due (INR)':<52}{money(subtotal + gst):>34}\",\u001b[m\r\n     ]\u001b[m\r\n     return \"\\n\".join(out) + \"\\n\"\u001b[m\r\n \u001b[m\r\n\u001b[1mdiff --git a/billing/proration.py b/billing/proration.py\u001b[m\r\n\u001b[1mindex 8d7d009..7812e9d 100644\u001b[m\r\n\u001b[1m--- a/billing/proration.py\u001b[m\r\n\u001b[1m+++ b/billing/proration.py\u001b[m\r\n\u001b[36m@@ -60,7 +60,23 @@\u001b[m \u001b[mdef prorate_monthly_change(old_code: str, new_code: str, period: Period, on: dat\u001b[m\r\n \u001b[m\r\n def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\u001b[m\r\n     \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    old, new = get_plan(old_code), get_plan(new_code)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if old.is_annual or not new.is_annual:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    try:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused = remaining_days(period, on)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    except ValueError as exc:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(str(exc)) from exc\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return ProrationResult(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        old_plan=old,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_plan=new,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        on=on,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        period=period,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused_days=unused,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        credit=prorate_amount(old.price, unused, period.days),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        charge=new.price,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_period=annual_period(on),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def describe(result: ProrationResult) -> str:\u001b[m\r\n\u001b[1mdiff --git a"]
