[54.008149, "o", "\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { ClientConfig } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { BranchResource } from \"./filter.ts\";\u001b[m\r\n import { isUntagged } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// The shared client's listResources drops provider-specific fields. Read raw pages\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// here so envctl can retain CDK labels without changing the shared Resource API.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function listResources(cfg: ClientConfig): Promise<BranchResource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: BranchResource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (let attempt = 0; ; attempt++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const res = await fetch(cfg.baseUrl + path, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const payload = await res.json().catch(() => null);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (res.status === 429 && attempt < 100) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!res.ok) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new ApiError(res.status, payload, `GET ${path} -> ${res.status}: ${payload?.error ?? res.statusText}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      resources.push(...page.resources.map((raw) => ({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ...toResource(raw),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        labels: (raw.labels as Record<string, string> | undefined) ?? {},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      })));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      break;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n\u001b[36m@@ -21,17 +56,18 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n     console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\u001b[m\r\n     return cmd ? 0 : 2;\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  const client = new CloudClient(loadConfig());\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const cfg = loadConfig();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const client = new CloudClient(cfg);\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n\u001b[31m-    console.log(summarize(await client.listResources()));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    console.log(summarize(await listResources(cfg)));\u001b[m\r\n     return 0;\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   if (cmd === \"plan\" || cmd === \"teardown\") {\u001b[m\r\n     const branch = flag(rest, \"--branch\");\u001b[m\r\n     if (!branch) throw new Error(`${cmd} needs --branch`);\u001b[m\r\n\u001b[31m-    const plan = buildPlan(await client.listResources(), branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const plan = buildPlan(await listResources(cfg), branch);\u001b[m\r\n     if (cmd === \"plan\" && rest.includes(\"--json\")) {\u001b[m\r\n       console.log(JSON.stringify(plan));\u001b[m\r\n       return 0;\u001b[m\r\n\u001b[36m@@ -52,7 +88,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n \u001b[m\r\n   if (cmd === \"gc\") {\u001b[m\r\n     if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\u001b[m\r\n\u001b[31m-    const targets = (await client.listResources()).filter(isUntagged);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const targets = (await listResources(cfg)).filter(isUntagged);\u001b[m\r\n     console.log(`"]
[54.008195, "o", "${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\u001b[m\r\n     if (!rest.includes(\"--yes\")) {\u001b[m\r\n       console.log(\"dry run; pass --yes to delete\");\u001b[m\r\n\u001b[1mdiff --git a/src/filter.ts b/src/filter.ts\u001b[m\r\n\u001b[1mindex aba5419..360d909 100644\u001b[m\r\n\u001b[1m--- a/src/filter.ts\u001b[m\r\n\u001b[1m+++ b/src/filter.ts\u001b[m\r\n\u001b[36m@@ -2,15 +2,26 @@\u001b[m\r\n \u001b[m\r\n import type { Resource } from \"./api.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function branchOf(r: Resource): string | undefined {\u001b[m\r\n\u001b[31m-  return r.tags?.branch;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// nimbus-cdk resources carry labels rather than tags. Keep this extension local to\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// envctl: the shared Nimbus Resource contract deliberately omits provider extras.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport interface BranchResource extends Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  labels?: Record<string, string>;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function isUntagged(r: Resource): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction metadataValue(r: BranchResource, key: string): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function branchOf(r: BranchResource): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return metadataValue(r, \"branch\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function isUntagged(r: BranchResource): boolean {\u001b[m\r\n   return branchOf(r) === undefined;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function byBranch(resources: Resource[]): Map<string, Resource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function byBranch(resources: BranchResource[]): Map<string, Resource[]> {\u001b[m\r\n   const groups = new Map<string, Resource[]>();\u001b[m\r\n   for (const r of resources) {\u001b[m\r\n     const key = branchOf(r) ?? \"(untagged)\";\u001b[m\r\n\u001b[36m@@ -28,6 +39,6 @@\u001b[m \u001b[mexport function parseSelector(expr: string): [string, string] {\u001b[m\r\n   return [expr.slice(0, idx), expr.slice(idx + 1)];\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function matches(r: Resource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[31m-  return selectors.every(([k, v]) => r.tags?.[k] === v);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function matches(r: BranchResource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectors.every(([k, v]) => metadataValue(r, k) === v);\u001b[m\r\n }\u001b[m\r\n"]
