[40.635084, "i", "python3 - <<'PY'\np='src/filter.ts'\ns=open(p).read().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// nimbus-cdk resources carry labels rather than tags. Keep this extension local to\n// envctl: the shared Nimbus Resource contract deliberately omits provider extras.\nexport interface BranchResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction metadataValue(r: BranchResource, key: string): string | undefined {\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: BranchResource): string | undefined {\n  return metadataValue(r, \"branch\");\n}''').replace('isUntagged(r: Resource)', 'isUntagged(r: BranchResource)').replace('byBranch(resources: Resource[])', 'byBranch(resources: BranchResource[])').replace('matches(r: Resource,', 'matches(r: BranchResource,').replace('r.tags?.[k] === v', 'metadataValue(r, k) === v')\nopen(p,'w').write(s)\np='src/cli.ts';s=open(p).read().replace('CloudClient, loadConfig', 'CloudClient, loadConfig, toResource').replace('import { isUntagged }', 'import type { ClientConfig } from \"./api.ts\";\\nimport type { BranchResource } from \"./filter.ts\";\\nimport { isUntagged }')\npos=s.index('function flag(')\ns=s[:pos]+'''// The shared client's listResources drops provider-specific fields. Read raw pages\n// here so envctl can retain CDK labels without changing the shared Resource API.\nasync function listResources(cfg: ClientConfig): Promise<BranchResource[]> {\n  const resources: BranchResource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n    for (let attempt = 0; ; attempt++) {\n      const res = await fetch(cfg.baseUrl + path, {\n        headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\n      });\n      const payload = await res.json().catch(() => null);\n      if (res.status === 429 && attempt < 100) {\n        const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\n        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n        continue;\n      }\n      if (!res.ok) {\n        throw new ApiError(res.status, payload, `GET ${path} -> ${res.status}: ${payload?.error ?? res.statusText}`);\n      }\n      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n      resources.push(...page.resources.map((raw) => ({\n        ...toResource(raw),\n        labels: (raw.labels as Record<string, string> | undefined) ?? {},\n      })));\n      cursor = page.next_cursor;\n      break;\n    }\n  }\n  return resources;\n}\n\n'''+s[pos:]\ns=s.replace('const client = new CloudClient(loadConfig());','const cfg = loadConfig();\\n  const client = new CloudClient(cfg);').replace('await client.listResources()', 'await listResources(cfg)')\nopen(p,'w').write(s)\nPY\n"]
