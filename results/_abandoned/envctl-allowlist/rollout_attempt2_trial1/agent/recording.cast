[79.799464, "o", "import { promisify } from \"node:util\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const exec = promisify(execFile);\r\n\u001b[?2004l\r\u001b[?2004h> const cli = new URL(\"../src/cli.ts\", import.meta.url).pathname;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function resource(id: string, depends_on: string[] = []) {\r\n\u001b[?2004l\r\u001b[?2004h>   return { id, name: id, type: \"instance\", depends_on, stack_id: null as string | null, cost_month_cents: 100 };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"CLI retains labels across pages for list, plan, gc and safe teardown\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const net = { ...resource(\"net\"), tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" };\r\n\u001b[?2004l\r\u001b[?2004h>   const others = Array.from({ length: 19 }, (_, i) => ({\r\n\u001b[?2004l\r\u001b[?2004h>     ...resource(`other-${i}`), tags: { branch: \"feat-b\" },\r\n\u001b[?2004l\r\u001b[?2004h>   }));\r\n\u001b[?2004l\r\u001b[?2004h>   let resources = [net, ...others,\r\n\u001b[?2004l\r\u001b[?2004h>     { ...resource(\"boot\"), stack_id: \"stk-feat-a\" },\r\n\u001b[?2004l\r\u001b[?2004h>     { ...resource(\"worker\", [\"net\", \"boot\"]), labels: { bRaNcH: \"feat-a\", Team: \"payments\" } },\r\n\u001b[?2004l\r\u001b[?2004h>     { ...resource(\"dns\", [\"worker\"]), labels: { BRANCH: \"feat-a\" } },\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const cursors: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let rateLimited = false;\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h>     const reply = (status: number, body: unknown) => { res.statusCode = status; res.end(JSON.stringify(body)); };\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.headers.authorization !== \"Bearer test-token\") return reply(401, { error: \"unauthorized\" });\r\n\u001b[?2004l\r\u001b[?2004h>     const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n\u001b[?2004l\r\u001b[?2004h>       if (!rateLimited) {\r\n\u001b[?2004l\r\u001b[?2004h>         rateLimited = true;\r\n\u001b[?2004l\r\u001b[?2004h>         res.setHeader(\"retry-after\", \"0\");\r\n\u001b[?2004l\r\u001b[?2004h>         return reply(429, { error: \"rate limited\" });\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       const cursor = url.searchParams.get(\"cursor\")!;\r\n\u001b[?2004l\r\u001b[?2004h>       cursors.push(cursor);\r\n\u001b[?2004l\r\u001b[?2004h>       const start = cursor === \"0\" ? 0 : cursor === \"next/page+2\" ? 20 : -1;\r\n\u001b[?2004l\r\u001b[?2004h>       if (start < 0 || url.searchParams.get(\"limit\") !== \"20\") return reply(400, { error: \"bad pagination\" });\r\n\u001b[?2004l\r\u001b[?2004h>       return reply(200, { resources: resources.slice(start, start + 20), next_cursor: start + 20 < resources.length ? \"next/page+2\" : null });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"DELETE\") {\r\n\u001b[?2004l\r"]
