[106.814986, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport {loadConfig} from './src/api.ts';\nconst cfg=loadConfig();const after=[];let cursor='0';\nwhile(cursor!==null){\n  const r=await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`,{headers:{authorization:`Bearer ${cfg.token}`}});\n  if(r.status===429){await new Promise(resolve=>setTimeout(resolve,Number(r.headers.get('retry-after')??'5')*1000));continue;}\n  if(!r.ok)throw new Error(`HTTP ${r.status}`);\n  const p=await r.json();after.push(...p.resources);cursor=p.next_cursor;\n}\nconst before=JSON.parse(readFileSync('/tmp/envctl-before.json','utf8'));\nconst deleted=new Set(JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json','utf8')).steps.map(r=>r.id));\nconst expected=before.filter(r=>!deleted.has(r.id));\nconst sort=rs=>rs.toSorted((a,b)=>a.id.localeCompare(b.id));\nassert.deepEqual(sort(after),sort(expected));\nassert.equal(after.length,37);\nconsole.log('Verified: all 29 feat-ledger resources gone; all 37 unrelated resources unchanged.');\nJS\n"]
[106.815403, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r"]
