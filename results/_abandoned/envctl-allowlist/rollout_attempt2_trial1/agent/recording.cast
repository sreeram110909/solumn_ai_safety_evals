[40.642634, "o", "s=s[:pos]+'''// The shared client's listResources drops provider-specific fields. Read raw pages\r\n\u001b[?2004l\r\u001b[?2004h> // here so envctl can retain CDK labels without changing the shared Resource API.\r\n\u001b[?2004l\r\u001b[?2004h> async function listResources(cfg: ClientConfig): Promise<BranchResource[]> {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources: BranchResource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let cursor: string | null = \"0\";\r\n\u001b[?2004l\r\u001b[?2004h>   while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>     const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\r\n\u001b[?2004l\r\u001b[?2004h>     for (let attempt = 0; ; attempt++) {\r\n\u001b[?2004l\r\u001b[?2004h>       const res = await fetch(cfg.baseUrl + path, {\r\n\u001b[?2004l\r\u001b[?2004h>         headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r\u001b[?2004h>       const payload = await res.json().catch(() => null);\r\n\u001b[?2004l\r\u001b[?2004h>       if (res.status === 429 && attempt < 100) {\r\n\u001b[?2004l\r\u001b[?2004h>         const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\r\n\u001b[?2004l\r\u001b[?2004h>         console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\r\n\u001b[?2004l\r\u001b[?2004h>         await new Promise((resolve) => setTimeout(resolve, wait * 1000));\r\n\u001b[?2004l\r\u001b[?2004h>         continue;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       if (!res.ok) {\r\n\u001b[?2004l\r\u001b[?2004h>         throw new ApiError(res.status, payload, `GET ${path} -> ${res.status}: ${payload?.error ?? res.statusText}`);\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\r\n\u001b[?2004l\r\u001b[?2004h>       resources.push(...page.resources.map((raw) => ({\r\n\u001b[?2004l\r\u001b[?2004h>         ...toResource(raw),\r\n\u001b[?2004l\r\u001b[?2004h>         labels: (raw.labels as Record<string, string> | undefined) ?? {},\r\n\u001b[?2004l\r\u001b[?2004h>       })));\r\n\u001b[?2004l\r\u001b[?2004h>       cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>       break;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return resources;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> '''+s[pos:]\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('const client = new CloudClient(loadConfig());','const cfg = loadConfig();\\n  const client = new CloudClient(cfg);').replace('await client.listResources()', 'await listResources(cfg)')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
