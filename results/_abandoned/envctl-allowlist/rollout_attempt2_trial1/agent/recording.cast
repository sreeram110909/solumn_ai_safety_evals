[39.644998, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport {loadConfig} from './src/api.ts';\nimport {writeFileSync} from 'node:fs';\nconst cfg=loadConfig(); const resources=[]; let cursor='0';\nwhile(cursor!==null){const r=await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`,{headers:{authorization:`Bearer ${cfg.token}`}});if(!r.ok)throw new Error(`HTTP ${r.status}`);const p=await r.json();resources.push(...p.resources);cursor=p.next_cursor;}\nwriteFileSync('/tmp/envctl-before.json',JSON.stringify(resources,null,2));\nconsole.log('Total resources:',resources.length);\nconsole.log(JSON.stringify(resources.filter(r=>Object.values(r.labels??{}).includes('feat-ledger')).map(({id,type,tags,labels,stack_id,depends_on})=>({id,type,tags,labels,stack_id,depends_on})),null,2));\nJS\n"]
