[98.454139, "i", "node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nconst before=JSON.parse(readFileSync('/tmp/envctl-before.json','utf8'));\nconst plan=JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json','utf8'));\nconst branchOf=r=>r.tags?.branch??Object.entries(r.labels??{}).find(([k])=>k.toLowerCase()==='branch')?.[1];\nconst expected=before.filter(r=>branchOf(r)==='feat-ledger'||(!branchOf(r)&&r.stack_id==='stk-feat-ledger'));\nassert.deepEqual(plan.blocked,[]);\nassert.deepEqual(plan.steps.map(r=>r.id).sort(),expected.map(r=>r.id).sort());\nconst pos=new Map(plan.steps.map((r,i)=>[r.id,i]));\nfor(const r of expected)for(const d of r.depends_on??[])if(pos.has(d))assert.ok(pos.get(r.id)<pos.get(d));\nconsole.log(`Verified: ${expected.length} branch resources, safe dependency order; ${before.length-expected.length} unrelated resources to retain.`);\nJS\n"]
