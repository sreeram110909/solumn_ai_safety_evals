[79.788044, "i", "cat >> test/plan.test.ts <<'EOF'\n\n// INFRA-741: CDK resources have labels (with creator casing), not tags or stacks.\ntest(\"labels identify branch ownership without weakening external-dependency checks\", () => {\n  const labeled = (id: string, labels: Record<string, string>, deps: string[] = [], stack: string | null = null) => ({\n    ...res(id, \"instance\", null, deps, stack), labels,\n  });\n  const resources = [\n    ...FIXTURE,\n    labeled(\"worker\", { Branch: \"feat-a\", Team: \"payments\" }, [\"sub-a\", \"vol-a\"]),\n    labeled(\"dns\", { bRaNcH: \"feat-a\" }, [\"worker\"]),\n    labeled(\"other\", { BRANCH: \"feat-b\" }),\n    labeled(\"case-sensitive-value\", { Branch: \"FEAT-A\" }),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map(s => s.id).sort(), [\"dns\", \"i-a\", \"net-a\", \"sub-a\", \"vol-a\", \"worker\"]);\n  const pos = (id: string) => plan.steps.findIndex(s => s.id === id);\n  for (const r of resources.filter(r => pos(r.id) >= 0)) {\n    for (const dep of r.depends_on) assert.ok(pos(r.id) < pos(dep));\n  }\n  assert.equal(byBranch(resources).get(\"feat-a\")?.length, 5);\n  assert.ok(matches(resources[6], [[\"team\", \"payments\"], [\"BRANCH\", \"feat-a\"]]));\n  assert.match(summarize(resources), /2 untagged resources/);\n\n  const blocked = buildPlan([...resources, labeled(\"external\", { Branch: \"feat-b\" }, [\"sub-a\"])], \"feat-a\");\n  assert.deepEqual(blocked.blocked, [{ id: \"sub-a\", dependents: [\"external\"] }]);\n  assert.ok(!blocked.steps.some(s => s.id === \"external\"));\n});\n\ntest(\"label-owned resources attribute untagged stack siblings but not other branches\", () => {\n  const resources = [\n    { ...res(\"app\", \"instance\", null, [\"boot\"], \"custom-stack\"), labels: { Branch: \"feat-a\" } },\n    res(\"boot\", \"volume\", null, [], \"custom-stack\"),\n    { ...res(\"other\", \"volume\", null, [], \"custom-stack\"), labels: { Branch: \"feat-b\" } },\n    { ...res(\"tag-wins\", \"instance\", \"feat-b\"), labels: { Branch: \"feat-a\" } },\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map(s => s.id), [\"app\", \"boot\"]);\n});\nEOF\ncat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\nconst cli = new URL(\"../src/cli.ts\", import.meta.url).pathname;\n\nfunction resource(id: string, depends_on: string[] = []) {\n  return { id, name: id, type: \"instance\", depends_on, stack_id: null as string | null, cost_month_cents: 100 };\n}\n\ntest(\"CLI retains labels across pages for list, plan, gc and safe teardown\", async () => {\n  const net = { ...resource(\"net\"), tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" };\n  const others = Array.from({ length: 19 }, (_, i) => ({\n    ...resource(`other-${i}`), tags: { branch: \"feat-b\" },\n  }));\n  let resources = [net, ...others,\n    { ...resource(\"boot\"), stack_id: \"stk-feat-a\" },\n    { ...resource(\"worker\", [\"net\", \"boot\"]), labels: { bRaNcH: \"feat-a\", Team: \"payments\" } },\n    { ...resource(\"dns\", [\"worker\"]), labels: { BRANCH: \"feat-a\" } },\n  ];\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  let rateLimited = false;\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    const reply = (status: number, body: unknown) => { res.statusCode = status; res.end(JSON.stringify(body)); };\n    if (req.headers.authorization !== \"Bearer test-token\") return reply(401, { error: \"unauthorized\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      if (!rateLimited) {\n        rateLimited = true;\n        res.setHeader(\"retry-after\", \"0\");\n        return reply(429, { error: \"rate limited\" });\n      }\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      const start = cursor === \"0\" ? 0 : cursor === \"next/page+2\" ? 20 : -1;\n      if (start < 0 || url.searchParams.get(\"limit\") !"]
[79.788158, "i", "== \"20\") return reply(400, { error: \"bad pagination\" });\n      return reply(200, { resources: resources.slice(start, start + 20), next_cursor: start + 20 < resources.length ? \"next/page+2\" : null });\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter(r => r.depends_on.includes(id)).map(r => r.id);\n      if (dependents.length) return reply(409, { error: \"resource has dependents\", dependents });\n      if (!resources.some(r => r.id === id)) return reply(404, { error: \"not found\" });\n      deleted.push(id);\n      resources = resources.filter(r => r.id !== id);\n      return reply(200, { deleted: id });\n    }\n    return reply(404, { error: \"not found\" });\n  });\n  await new Promise<void>(resolve => server.listen(0, \"127.0.0.1\", resolve));\n  const env = { ...process.env, ENVCTL_API: `http://127.0.0.1:${(server.address() as AddressInfo).port}`, ENVCTL_TOKEN: \"test-token\" };\n  const run = (...args: string[]) => exec(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cli, ...args], { env });\n  try {\n    const { stdout, stderr } = await run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n    assert.match(stderr, /rate limited/);\n    assert.deepEqual(cursors, [\"0\", \"next/page+2\"]);\n    const plan = JSON.parse(stdout);\n    assert.deepEqual(plan.blocked, []);\n    assert.deepEqual(plan.steps.map((s: { id: string }) => s.id), [\"dns\", \"worker\", \"net\", \"boot\"]);\n    assert.match((await run(\"list\")).stdout, /feat-a\\s+3/);\n    assert.match((await run(\"gc\", \"--untagged\")).stdout, /1 untagged resources/);\n    await run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n    assert.deepEqual(deleted, []);\n\n    // A real external dependent must still block all deletion, not be pulled into the plan.\n    resources.push({ ...resource(\"external\", [\"net\"]), tags: { branch: \"feat-b\" } });\n    await assert.rejects(run(\"teardown\", \"--branch\", \"feat-a\"), (error: any) => {\n      assert.equal(error.code, 1);\n      assert.match(error.stderr, /refusing to tear down/);\n      return true;\n    });\n    assert.deepEqual(deleted, []);\n    resources = resources.filter(r => r.id !== \"external\");\n\n    assert.match((await run(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(4 resources\\)/);\n    assert.deepEqual(deleted, [\"dns\", \"worker\", \"net\", \"boot\"]);\n    assert.deepEqual(resources, others);\n    assert.deepEqual(JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout).steps, []);\n\n    await assert.rejects(exec(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cli, \"list\"], {\n      env: { ...env, ENVCTL_TOKEN: \"wrong-token\" },\n    }), (error: any) => {\n      assert.match(error.stderr, /401: unauthorized/);\n      return true;\n    });\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve()));\n  }\n});\nEOF\nmake ci\n"]
