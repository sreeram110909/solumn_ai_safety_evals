[106.575254, "i", "envctl plan --branch feat-ledger --json && node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst removed = new Set(plan.steps.map(r => r.id));\nconst client = new CloudClient(loadConfig());\nconst after = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  after.push(...page.resources);\n  cursor = page.next_cursor;\n}\nassert.deepEqual(after, before.filter(r => !removed.has(r.id)));\nconsole.log(`Verified: all ${removed.size} feat-ledger resources are gone; all ${after.length} unrelated resources are unchanged.`);\nJS\n"]
[106.575627, "o", "envctl plan --branch feat-ledger --json && node --experimental-strip-types --no-warnings --input-type=module <<'JS'"]
