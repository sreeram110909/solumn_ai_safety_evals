nap-fl5\",\r\n      \"type\": \"snapshot\",\r\n      \"name\": \"feat-ledger-data-snap-5\"\r\n    },\r\n    {\r\n      \"id\": \"vol-flu0\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-boot-0\"\r\n    },\r\n    {\r\n      \"id\": \"vol-flu1\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-boot-1\"\r\n    },\r\n    {\r\n      \"id\": \"vol-flu2\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-boot-2\"\r\n    },\r\n    {\r\n      \"id\": \"vol-flu3\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-boot-3\"\r\n    },\r\n    {\r\n      \"id\": \"vol-flu4\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-boot-4\"\r\n    },\r\n    {\r\n      \"id\": \"vol-flu5\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-boot-5\"\r\n    },\r\n    {\r\n      \"id\": \"vol-fl6\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-worker-boot-0\"\r\n    },\r\n    {\r\n      \"id\": \"sub-fl1\",\r\n      \"type\": \"subnet\",\r\n      \"name\": \"feat-ledger-subnet-b\"\r\n    },\r\n    {\r\n      \"id\": \"vol-fl7\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-worker-boot-1\"\r\n    },\r\n    {\r\n      \"id\": \"lb-fl\",\r\n      \"type\": \"load_balancer\",\r\n      \"name\": \"feat-ledger-lb\"\r\n    },\r\n    {\r\n      \"id\": \"vol-fldata\",\r\n      \"type\": \"volume\",\r\n      \"name\": \"feat-ledger-data\"\r\n    },\r\n    {\r\n      \"id\": \"sub-fl0\",\r\n      \"type\": \"subnet\",\r\n      \"name\": \"feat-ledger-subnet-a\"\r\n    },\r\n    {\r\n      \"id\": \"net-fl\",\r\n      \"type\": \"network\",\r\n      \"name\": \"feat-ledger-vpc\"\r\n    }\r\n  ],\r\n  \"blocked\": []\r\n}\r\n"]
