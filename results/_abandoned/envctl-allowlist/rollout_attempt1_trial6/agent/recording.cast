[84.448296, "i", "git diff --check && git diff --stat && git diff -- src/cli.ts && envctl plan --branch feat-ledger --json > /tmp/envctl-ledger-plan.json && node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst owned = before.filter(r => r.tags?.branch === 'feat-ledger' || Object.entries(r.labels ?? {}).some(([k,v]) => k.toLowerCase() === 'branch' && v === 'feat-ledger') || r.stack_id === 'stk-feat-ledger');\nassert.deepEqual(plan.blocked, []);\nassert.deepEqual(plan.steps.map(r => r.id).sort(), owned.map(r => r.id).sort());\nassert.equal(plan.steps.length, 29);\nconsole.log(JSON.stringify(plan, null, 2));\nconsole.log('Verified: exactly 29 feat-ledger resources, no external blockers.');\nJS\n"]
