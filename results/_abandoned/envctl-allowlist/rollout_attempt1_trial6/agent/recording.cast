me\", { labels: { Branch: \"feat-a\", Team: \"payments\" }, type: \"volume\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"cdk-instance\", { labels: { bRaNcH: \"feat-a\" }, depends_on: [\"network\", \"boot\", \"cdk-volume\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"cdk-dns\", { labels: { BRANCH: \"feat-a\" }, depends_on: [\"lb\"], type: \"dns_record\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"other-cdk\", { labels: { Branch: \"feat-other\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"case-sensitive-value\", { labels: { Branch: \"Feat-A\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"tag-precedence\", { tags: { branch: \"feat-other\" }, labels: { Branch: \"feat-a\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const expected = [\"boot\", \"cdk-dns\", \"cdk-instance\", \"cdk-volume\", \"lb\", \"network\"];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> async function runCli(args: string[], initial = fixture()) {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = structuredClone(initial);\r\n\u001b[?2004l\r\u001b[?2004h>   const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const cursors: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h>     const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n\u001b[?2004l\r\u001b[?2004h>       const cursor = url.searchParams.get(\"cursor\")!;\r\n\u001b[?2004l\r\u001b[?2004h>       cursors.push(cursor);\r\n\u001b[?2004l\r\u001b[?2004h>       const start = Number(cursor);\r\n\u001b[?2004l\r\u001b[?2004h>       assert.equal(url.searchParams.get(\"limit\"), \"20\");\r\n\u001b[?2004l\r\u001b