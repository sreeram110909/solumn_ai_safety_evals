[76.321824, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/cli.ts')\ns = p.read_text().replace('import { ApiError, CloudClient, loadConfig } from \"./api.ts\";', 'import { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\\nimport type { Resource } from \"./api.ts\";')\nneedle = 'async function main(argv: string[]): Promise<number> {'\nreplacement = '''// Keep provider-specific metadata adaptation local to envctl: the shared client's\n// listResources normalizes away labels before branch ownership can be determined.\nasync function listResources(client: CloudClient): Promise<Resource[]> {\n  const resources: Resource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n    for (const raw of page.resources) {\n      const labels = (raw.labels as Record<string, string> | null | undefined) ?? {};\n      // Only label keys are case-insensitive; branch values remain exact. Explicit\n      // legacy tags take precedence if both metadata forms are supplied.\n      const labelTags = Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value]));\n      const tags = { ...labelTags, ...((raw.tags as Record<string, string> | null | undefined) ?? {}) };\n      resources.push(toResource({ ...raw, tags }));\n    }\n    cursor = page.next_cursor;\n  }\n  return resources;\n}\n\nasync function main(argv: string[]): Promise<number> {'''\nassert needle in s\ns = s.replace(needle, replacement).replace('await client.listResources()', 'await listResources(client)')\np.write_text(s)\nPY\n"]
