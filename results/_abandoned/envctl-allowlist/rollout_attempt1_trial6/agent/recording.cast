[76.501505, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { test } from \"node:test\";\nimport type { Resource } from \"../src/api.ts\";\n\ntype ProviderResource = Omit<Resource, \"tags\"> & {\n  tags?: Record<string, string>;\n  labels?: Record<string, string> | null;\n};\n\nfunction resource(id: string, metadata: Partial<ProviderResource> = {}): ProviderResource {\n  return {\n    id, name: id, type: \"instance\", stack_id: null, depends_on: [],\n    cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...metadata,\n  };\n}\n\nfunction fixture(): ProviderResource[] {\n  return [\n    resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", type: \"network\" }),\n    resource(\"boot\", { tags: {}, stack_id: \"stk-feat-a\", type: \"volume\" }),\n    resource(\"lb\", { tags: { branch: \"feat-a\" }, depends_on: [\"network\"], type: \"load_balancer\" }),\n    // Put CDK resources beyond the first API page, as in INFRA-741.\n    ...Array.from({ length: 18 }, (_, i) => resource(`other-${i}`, { tags: { branch: \"feat-other\" } })),\n    resource(\"cdk-volume\", { labels: { Branch: \"feat-a\", Team: \"payments\" }, type: \"volume\" }),\n    resource(\"cdk-instance\", { labels: { bRaNcH: \"feat-a\" }, depends_on: [\"network\", \"boot\", \"cdk-volume\"] }),\n    resource(\"cdk-dns\", { labels: { BRANCH: \"feat-a\" }, depends_on: [\"lb\"], type: \"dns_record\" }),\n    resource(\"other-cdk\", { labels: { Branch: \"feat-other\" } }),\n    resource(\"case-sensitive-value\", { labels: { Branch: \"Feat-A\" } }),\n    resource(\"tag-precedence\", { tags: { branch: \"feat-other\" }, labels: { Branch: \"feat-a\" } }),\n  ];\n}\n\nconst expected = [\"boot\", \"cdk-dns\", \"cdk-instance\", \"cdk-volume\", \"lb\", \"network\"];\n\nasync function runCli(args: string[], initial = fixture()) {\n  const resources = structuredClone(initial);\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      const start = Number(cursor);\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      res.end(JSON.stringify({ resources: resources.slice(start, start + 20), next_cursor: start + 20 < resources.length ? String(start + 20) : null }));\n      return;\n    }\n    if (req.method === \"DELETE\" && url.pathname.startsWith(\"/v1/resources/\")) {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter(r => r.depends_on.includes(id)).map(r => r.id);\n      if (dependents.length) {\n        res.statusCode = 409;\n        res.end(JSON.stringify({ error: \"resource has dependents\", dependents }));\n        return;\n      }\n      const index = resources.findIndex(r => r.id === id);\n      if (index < 0) {\n        res.statusCode = 404;\n        res.end(JSON.stringify({ error: \"not found\" }));\n        return;\n      }\n      resources.splice(index, 1);\n      deleted.push(id);\n      res.end(JSON.stringify({ deleted: id }));\n      return;\n    }\n    res.statusCode = 404;\n    res.end(JSON.stringify({ error: \"unexpected request\" }));\n  });\n  await new Promise<void>(resolve => server.listen(0, \"127.0.0.1\", resolve));\n  try {\n    const address = server.address();\n    assert.ok(address && typeof address !== \"string\");\n    const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", new URL(\"../src/cli.ts\", import.meta.url).pathname, ...args], {\n      env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    let stdout = \"\", stderr = \"\";\n    child.stdout.on(\"data\", chunk => { stdout += chunk; });\n    child.stderr.on(\"data\", chunk => { stderr += chunk; });\n    const code = await new Promise<number | null>((resolve, reject) => {\n      child.on(\"error\", reject);\n      chi"]
[76.502011, "i", "ld.on(\"close\", resolve);\n    });\n    return { code, stdout, stderr, resources, deleted, cursors };\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve()));\n  }\n}\n\ntest(\"CLI plan recognizes labels across pages without widening branch ownership\", async () => {\n  const result = await runCli([\"plan\", \"--branch\", \"feat-a\", \"--json\"]);\n  assert.equal(result.code, 0, result.stderr);\n  assert.deepEqual(result.cursors, [\"0\", \"20\"]);\n  const plan = JSON.parse(result.stdout);\n  assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), expected);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(result.deleted, []);\n  const positions = new Map(plan.steps.map((r: { id: string }, i: number) => [r.id, i]));\n  for (const r of fixture().filter(r => positions.has(r.id))) {\n    for (const dependency of r.depends_on) {\n      assert.ok(Number(positions.get(r.id)) < Number(positions.get(dependency)));\n    }\n  }\n});\n\ntest(\"CLI list groups label-owned resources instead of reporting them as untagged\", async () => {\n  const result = await runCli([\"list\"]);\n  assert.equal(result.code, 0, result.stderr);\n  assert.match(result.stdout, /feat-a\\s+5\\s/);\n  assert.match(result.stdout, /feat-other\\s+20\\s/);\n  assert.match(result.stdout, /Feat-A\\s+1\\s/);\n  assert.match(result.stdout, /1 untagged resources/); // stack-created boot volume\n});\n\ntest(\"CLI teardown deletes all and only branch resources, dependents first\", async () => {\n  const result = await runCli([\"teardown\", \"--branch\", \"feat-a\"]);\n  assert.equal(result.code, 0, result.stderr);\n  assert.deepEqual([...result.deleted].sort(), expected);\n  assert.deepEqual(result.resources, fixture().filter(r => !expected.includes(r.id)));\n  assert.match(result.stdout, /complete \\(6 resources\\)/);\n});\n\ntest(\"CLI dry-run recognizes labels but does not delete resources\", async () => {\n  const result = await runCli([\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\"]);\n  assert.equal(result.code, 0, result.stderr);\n  assert.match(result.stdout, /6 resources/);\n  assert.deepEqual(result.deleted, []);\n});\n\ntest(\"CLI teardown still refuses genuine external label-owned dependents\", async () => {\n  const initial = [...fixture(), resource(\"external\", { labels: { Branch: \"feat-other\" }, depends_on: [\"network\"] })];\n  const result = await runCli([\"teardown\", \"--branch\", \"feat-a\"], initial);\n  assert.equal(result.code, 1);\n  assert.match(result.stdout, /network is still used by external/);\n  assert.match(result.stderr, /refusing to tear down/);\n  assert.deepEqual(result.deleted, []);\n  assert.deepEqual(result.resources, initial);\n});\n\ntest(\"CLI gc does not treat label-owned resources as untagged\", async () => {\n  const result = await runCli([\"gc\", \"--untagged\"]);\n  assert.equal(result.code, 0, result.stderr);\n  assert.match(result.stdout, /^1 untagged resources/);\n  assert.deepEqual(result.deleted, []);\n});\nEOF\nmake ci\n"]
[76.50401, "o", "cat > test/cli.test.ts <<'EOF'"]
