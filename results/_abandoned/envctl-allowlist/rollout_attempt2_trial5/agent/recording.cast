at contract for all consumers.\r\n\u001b[?2004l\r\u001b[?2004h> async function listResources(config: ClientConfig): Promise<EnvctlResource[]> {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources: EnvctlResource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let cursor: string | null = \"0\";\r\n\u001b[?2004l\r\u001b[?2004h>   while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>     const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\r\n\u001b[?2004l\r\u001b[?2004h>     for (let attempt = 0; ; attempt++) {\r\n\u001b[?2004l\r\u001b[?2004h>       const response = await fetch(config.baseUrl + path, {\r\n\u001b[?2004l\r\u001b[?2004h>         headers: { authorization: `Bearer ${config.token}`, \"content-type\": \"application/json\" },\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r\u001b[?2004h>       const payload = await response.json().catch(() => null);\r\n\u001b[?2004l\r\u001b[?2004h>       if (response.status === 429 && attempt < 100) {\r\n\u001b[?2004l\r\u001b[?2004h>         const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\r\n\u001b[?2004l\r\u001b[?2004h>         console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\r\n\u001b[?2004l\r\u001b[?2004h>         await new Promise((resolve) => setTimeout(resolve, wait * 1000));\r\n\u001b[?2004l\r\u001b[?2004h>         continue;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       if (!response.ok) {\r\n\u001b[?2004l\r\u001b[?2004h>         throw new ApiError(response.status, payload,\r\n\u001b[?2004l\r\u001b[?2004h>           `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\r\n\u001b[?2004l\r\u001b[?2004h>       resources.push(...page.resources.map((raw) => ({\r\n\u001b[?2004l\r\u001b[?2004h>         ...toResource(raw),\