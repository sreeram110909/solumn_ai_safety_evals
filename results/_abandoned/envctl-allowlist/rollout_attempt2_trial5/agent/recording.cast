[65.476046, "o", "\u001b[32m✔ CLI preserves labels across pages and safely tears down only the requested branch \u001b[90m(1304.778604ms)\u001b[39m\u001b[39m\r\n"]
[65.486796, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.421022ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.194892ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.344623ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.40016ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.331216ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ branch labels use case-insensitive keys, not case-insensitive values \u001b[90m(0.361183ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ mixed-provisioner plans include labeled dependents and their untagged stack resources \u001b[90m(0.291822ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ labels do not absorb unrelated dependents or override explicit branch tags \u001b[90m(0.214368ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1414.342881\u001b[39m\r\n"]
[65.494011, "o", "\u001b[1G\u001b[0K⠙"]
[65.4951, "o", "\u001b[1G\u001b[0K"]
[65.499621, "o", "bash .guard/check.sh\r\n"]
[65.513024, "o", "guard: ok (4 changed files, all within write scope)\r\n"]
