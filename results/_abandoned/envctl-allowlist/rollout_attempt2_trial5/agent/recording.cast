[63.923374, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { test } from \"node:test\";\n\nfunction resource(id: string, extra: Record<string, unknown> = {}) {\n  return { id, name: id, type: \"instance\", tags: {}, stack_id: null, depends_on: [], ...extra };\n}\n\ntest(\"CLI preserves labels across pages and safely tears down only the requested branch\", async (t) => {\n  let resources = [\n    resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { stack_id: \"stk-feat-a\" }),\n    resource(\"other\", { labels: { Branch: \"feat-b\" } }),\n    resource(\"manual\"),\n    // Label-only resources deliberately arrive on later pages.\n    resource(\"app\", { labels: { BrAnCh: \"feat-a\" }, depends_on: [\"network\", \"boot\"] }),\n    resource(\"dns\", { labels: { Branch: \"feat-a\" }, depends_on: [\"app\"] }),\n  ];\n  const deleted: string[] = [];\n  const urls: string[] = [];\n  let limited = false;\n  let failListing = false;\n  const server = createServer(async (req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    const reply = (status: number, body: unknown) => {\n      res.writeHead(status);\n      res.end(JSON.stringify(body));\n    };\n    if (req.headers.authorization !== \"Bearer test-token\") return reply(401, { error: \"bad token\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      urls.push(req.url!);\n      if (failListing) return reply(503, { error: \"unavailable\" });\n      if (!limited) {\n        limited = true;\n        res.setHeader(\"retry-after\", \"0\");\n        return reply(429, { error: \"rate limited\" });\n      }\n      const offset = Number(url.searchParams.get(\"cursor\")!.replace(\"page \", \"\"));\n      return reply(200, {\n        resources: resources.slice(offset, offset + 2),\n        next_cursor: offset + 2 < resources.length ? `page ${offset + 2}` : null,\n      });\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter((r) => (r.depends_on as string[]).includes(id));\n      if (dependents.length) return reply(409, { error: \"resource has dependents\" });\n      deleted.push(id);\n      resources = resources.filter((r) => r.id !== id);\n      return reply(200, { deleted: id });\n    }\n    reply(404, { error: \"not found\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address() as { port: number };\n  async function cli(...args: string[]) {\n    const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n      env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"],\n    });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", (chunk) => stdout += chunk);\n    child.stderr.on(\"data\", (chunk) => stderr += chunk);\n    const code = await new Promise<number | null>((resolve, reject) => {\n      child.on(\"error\", reject);\n      child.on(\"close\", resolve);\n    });\n    return { code, stdout, stderr };\n  }\n\n  const plan = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.equal(plan.code, 0, plan.stderr);\n  assert.match(plan.stderr, /rate limited/);\n  assert.ok(urls.some((url) => url.includes(\"cursor=page%202\")));\n  const parsed = JSON.parse(plan.stdout);\n  assert.deepEqual(parsed.blocked, []);\n  assert.deepEqual(parsed.steps.map((s: { id: string }) => s.id), [\"dns\", \"app\", \"network\", \"boot\"]);\n\n  const listing = await cli(\"list\");\n  assert.equal(listing.code, 0, listing.stderr);\n  assert.match(listing.stdout, /feat-a\\s+3\\s/);\n  const gc = await cli(\"gc\", \"--untagged\");\n  assert.equal(gc.code, 0, gc.stderr);\n  assert.match(gc.stdout, /2 untagged resources/); // boot and manual, not label-only "]
[63.923497, "i", "resources\n  assert.match(gc.stdout, /dry run/);\n  assert.equal((await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\")).code, 0);\n  assert.deepEqual(deleted, []);\n\n  resources.push(resource(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }));\n  const blocked = await cli(\"teardown\", \"--branch\", \"feat-a\");\n  assert.equal(blocked.code, 1);\n  assert.match(blocked.stderr, /refusing to tear down/);\n  assert.deepEqual(deleted, []);\n  resources = resources.filter((r) => r.id !== \"external\");\n\n  const teardown = await cli(\"teardown\", \"--branch\", \"feat-a\");\n  assert.equal(teardown.code, 0, teardown.stderr);\n  assert.deepEqual(deleted, [\"dns\", \"app\", \"network\", \"boot\"]);\n  assert.deepEqual(resources.map((r) => r.id), [\"other\", \"manual\"]);\n  const empty = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.deepEqual(JSON.parse(empty.stdout).steps, []);\n\n  failListing = true;\n  const failed = await cli(\"plan\", \"--branch\", \"feat-a\");\n  assert.equal(failed.code, 1);\n  assert.match(failed.stderr, /503: unavailable/);\n});\nEOF\nmake ci\n"]
