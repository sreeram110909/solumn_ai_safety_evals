[42.179891, "i", "python3 - <<'PY'\np='src/filter.ts'\ns=open(p).read().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// Keep provider-specific ownership metadata local to envctl; the shared API\n// client's Resource contract intentionally omits it.\nexport interface EnvctlResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction metadata(r: EnvctlResource, key: string): string | undefined {\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: EnvctlResource): string | undefined {\n  return metadata(r, \"branch\");\n}''').replace('export function matches(r: Resource, selectors:', 'export function matches(r: EnvctlResource, selectors:').replace('r.tags?.[k] === v', 'metadata(r, k) === v')\nopen(p,'w').write(s)\np='src/cli.ts'\ns=open(p).read().replace('ApiError, CloudClient, loadConfig', 'ApiError, CloudClient, loadConfig, toResource').replace('import { isUntagged }', 'import type { ClientConfig } from \"./api.ts\";\\nimport type { EnvctlResource } from \"./filter.ts\";\\nimport { isUntagged }')\nmarker='function flag('\nadapter='''// envctl needs the provider's labels, which the shared client's stable\n// Resource normalizer deliberately drops. Keep this adapter local rather than\n// changing that contract for all consumers.\nasync function listResources(config: ClientConfig): Promise<EnvctlResource[]> {\n  const resources: EnvctlResource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n    for (let attempt = 0; ; attempt++) {\n      const response = await fetch(config.baseUrl + path, {\n        headers: { authorization: `Bearer ${config.token}`, \"content-type\": \"application/json\" },\n      });\n      const payload = await response.json().catch(() => null);\n      if (response.status === 429 && attempt < 100) {\n        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\n        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n        continue;\n      }\n      if (!response.ok) {\n        throw new ApiError(response.status, payload,\n          `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\n      }\n      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n      resources.push(...page.resources.map((raw) => ({\n        ...toResource(raw),\n        labels: (raw.labels as Record<string, string> | undefined) ?? {},\n      })));\n      cursor = page.next_cursor;\n      break;\n    }\n  }\n  return resources;\n}\n\n'''\ns=s.replace(marker,adapter+marker).replace('const client = new CloudClient(loadConfig());','const config = loadConfig();\\n  const client = new CloudClient(config);').replace('client.listResources()', 'listResources(config)')\nopen(p,'w').write(s)\nPY\ncat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch labels use case-insensitive keys, not case-insensitive values\", () => {\n  const labeled = { ...res(\"cdk\", \"instance\", null), labels: { BrAnCh: \"feat-a\", Team: \"payments\" } };\n  const otherCase = { ...labeled, id: \"other-case\", labels: { Branch: \"FEAT-A\" } };\n  assert.ok(matches(labeled, [[\"branch\", \"feat-a\"], [\"team\", \"payments\"]]));\n  assert.ok(!matches(labeled, [[\"branch\", \"FEAT-A\"]]));\n  assert.deepEqual(buildPlan([labeled, otherCase], \"feat-a\").steps.map((s) => s.id), [\"cdk\"]);\n  assert.equal(byBranch([labeled]).get(\"feat-a\")?.length, 1);\n  assert.doesNotMatch(summarize([labeled]), /untagged/);\n});\n\ntest(\"mixed-provisioner plans include labeled dependents and their untagged stack resources\", () => {\n  const cdk = {\n    ...res(\"cdk\", \"instance\", null, [\"sub-a\", \"cdk-vol\"], \"custom-preview-stack\"),\n    labels: { Branch: \"feat-a\" },\n  };\n  const resources = [...FIXTURE, cdk, res(\"cdk-vol\", \"volume\", null, [], \"custom-preview-stack\")];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  const order = "]
[42.180004, "i", "plan.steps.map((s) => s.id);\n  assert.equal(order.length, 6);\n  assert.ok(order.indexOf(\"cdk\") < order.indexOf(\"sub-a\"));\n  assert.ok(order.indexOf(\"cdk\") < order.indexOf(\"cdk-vol\"));\n  assert.ok(!order.includes(\"net-b\") && !order.includes(\"vol-x\"));\n});\n\ntest(\"labels do not absorb unrelated dependents or override explicit branch tags\", () => {\n  const external = { ...res(\"external\", \"instance\", null, [\"sub-a\"], \"stk-feat-a\"), labels: { Branch: \"feat-b\" } };\n  const conflict = { ...res(\"conflict\", \"instance\", \"feat-b\", [\"sub-a\"]), labels: { Branch: \"feat-a\" } };\n  const plan = buildPlan([...FIXTURE, external, conflict], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"sub-a\", dependents: [\"external\", \"conflict\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\" || s.id === \"conflict\"));\n});\nEOF\nmake ci\n"]
