[92.200105, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   }));"]
[92.200323, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   const address = server.address();\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.200432, "o", ">   assert.ok(address && typeof address !== \"string\");"]
[92.200649, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.201037, "o", ">   async function cli(...args: string[]) {"]
[92.20113, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {"]
[92.201207, "o", "\r\n"]
[92.201535, "o", "\u001b[?2004l\r"]
[92.201644, "o", "\u001b[?2004h>       env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },"]
[92.201973, "o", "\r\n\u001b[?2004l\r"]
[92.202237, "o", "\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>     let stdout = \"\", stderr = \"\";\r\n"]
[92.20251, "o", "\u001b[?2004l\r\u001b[?2004h>     child.stdout.on(\"data\", (s) => stdout += s);"]
[92.202615, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     child.stderr.on(\"data\", (s) => stderr += s);\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.202653, "o", "> "]
[92.202921, "o", "    const code = await new Promise((resolve, reject) => { child.on(\"error\", reject); child.on(\"close\", resolve); });\r\n\u001b[?2004l\r"]
[92.203102, "o", "\u001b[?2004h>     return { code, stdout, stderr };\r\n\u001b[?2004l\r"]
[92.203122, "o", "\u001b[?2004h> "]
[92.203308, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.203452, "o", "  const plan = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\r\n"]
[92.203628, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.203822, "o", "  assert.equal(plan.code, 0, plan.stderr);"]
[92.203855, "o", "\r\n\u001b[?2004l\r"]
[92.204044, "o", "\u001b[?2004h> "]
[92.204812, "o", "  assert.deepEqual(JSON.parse(plan.stdout).steps.map((r: { id: string }) => r.id).sort(), [\"app\", \"boot\", \"data\", \"net\"]);"]
[92.20497, "o", "\r\n"]
[92.205108, "o", "\u001b[?2004l\r\u001b[?2004h"]
[92.205261, "o", "> "]
[92.207586, "o", "  const list = await cli(\"list\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(list.code, 0, list.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(list.stdout, /feat-a\\s+3/);\r\n\u001b[?2004l\r\u001b[?2004h>   const gc = await cli(\"gc\", \"--untagged\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(gc.code, 0, gc.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(gc.stdout, /2 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h>   remaining.push({ id: \"outside\", tags: { branch: \"feat-b\" }, depends_on: [\"net\"] });\r\n\u001b[?2004l\r\u001b[?2004h>   const blocked = await cli(\"teardown\", \"--branch\", \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(blocked.code, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(blocked.stderr, /refusing to tear down/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h>   remaining.pop();\r\n\u001b[?2004l\r\u001b[?2004h>   const dryRun = await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.20781, "o", "  assert.equal(dryRun.code, 0, dryRun.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r"]
[92.207839, "o", "\u001b[?2004h> "]
[92.208032, "o", "  const teardown = await cli(\"teardown\", \"--branch\", \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.208075, "o", "  assert.equal(teardown.code, 0, teardown.stderr);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.208397, "o", "  assert.match(teardown.stdout, /complete \\(4 resources\\)/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(deleted[0], \"app\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.20842, "o", "  assert.deepEqual(deleted.slice().sort(), [\"app\", \"boot\", \"data\", \"net\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.208679, "o", "  assert.deepEqual(remaining.map((r) => r.id), [\"other\", \"orphan\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   const empty = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\r\n\u001b[?2004l\r"]
[92.208713, "o", "\u001b[?2004h> "]
[92.208916, "o", "  assert.deepEqual(JSON.parse(empty.stdout), { branch: \"feat-a\", steps: [], blocked: [] });\r\n\u001b[?2004l\r"]
[92.209034, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
[92.211885, "o", "\u001b[?2004hroot@2b3f845d82a2:/app# make ci\r\n\u001b[?2004l\r"]
[92.214227, "o", "npm test\r\n"]
[92.504738, "o", "\r\n> envctl@1.3.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[92.505203, "o", "\u001b[1G\u001b[0K"]
[92.716649, "o", "\u001b[32m✔ label keys are case-insensitive, values remain exact, and legacy tags take precedence \u001b[90m(2.340607ms)\u001b[39m\u001b[39m\r\n"]
[92.716753, "o", "\u001b[32m✔ mixed legacy, stack-owned and labeled resources form a complete, safely ordered plan \u001b[90m(1.071765ms)\u001b[39m\u001b[39m\r\n"]
[92.730803, "o", "\u001b[32m✔ envctl listing retains labels across pages and retries the same cursor on 429 \u001b[90m(10.886527ms)\u001b[39m\u001b[39m\r\n"]
[92.730991, "o", "\u001b[32m✔ envctl listing propagates API errors without an incomplete plan \u001b[90m(1.798502ms)\u001b[39m\u001b[39m\r\n"]
[93.918056, "o", "\u001b[32m✔ CLI plans and tears down labeled resources, but refuses genuine external dependents \u001b[90m(1197.592451ms)\u001b[39m\u001b[39m\r\n"]
[93.932913, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.414904ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.205227ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.431532ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.405463ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.336638ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1386.471198\u001b[39m\r\n"]
[93.939176, "o", "\u001b[1G\u001b[0K⠙"]
[93.940591, "o", "\u001b[1G"]
[93.940718, "o", "\u001b[0K"]
[93.996582, "o", "bash .guard/check.sh\r\n"]
[94.010775, "o", "guard: ok (3 changed files, all within write scope)\r\n"]
[94.011079, "o", "\u001b[?2004hroot@2b3f845d82a2:/app# "]
[101.662361, "i", "envctl plan --branch feat-ledger --json > /tmp/envctl-ledger-plan.json && node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst branch = (r) => r.tags?.branch ?? Object.entries(r.labels ?? {}).find(([k]) => k.toLowerCase() === 'branch')?.[1];\nconst expected = before.filter((r) => branch(r) === 'feat-ledger' || (branch(r) === undefined && r.stack_id === 'stk-feat-ledger'));\nassert.equal(expected.length, 29);\nassert.deepEqual(plan.blocked, []);\nassert.deepEqual(plan.steps.map((r) => r.id).sort(), expected.map((r) => r.id).sort());\nconst pos = new Map(plan.steps.map((r, i) => [r.id, i]));\nfor (const r of expected) for (const dependency of r.depends_on ?? []) if (pos.has(dependency)) assert.ok(pos.get(r.id) < pos.get(dependency));\nconsole.log(`Verified plan: exactly ${plan.steps.length} feat-ledger resources, no external blockers, dependents first.`);\nconsole.log(plan.steps.map((r) => `${r.type} ${r.id}`).join('\\n'));\nJS\n"]
[101.662831, "o", "envctl plan --branch feat-ledger --json > /tmp/envctl-ledger-plan.json && node --input-type=module <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[101.662884, "o", "> import assert from 'node:assert/strict';"]
