[92.19006, "o", "test(\"envctl listing propagates API errors without an incomplete plan\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.190102, "o", ">   t.mock.method(globalThis, \"fetch\", async () => new Response(JSON.stringify({ error: \"forbidden\" }), { status: 403 }));"]
[92.190196, "o", "\r\n"]
[92.190445, "o", "\u001b[?2004l\r\u001b[?2004h"]
