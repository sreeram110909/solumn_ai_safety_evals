[92.191738, "o", "\r\n"]
[92.191862, "o", "\u001b[?2004l\r\u001b[?2004h>   const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.19194, "o", ">   const server = createServer(async (req, res) => {"]
[92.192061, "o", "\r\n"]
[92.192152, "o", "\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");"]
[92.192341, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.192541, "o", ">     if (req.headers.authorization !== \"Bearer test-token\") {"]
[92.192731, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>       res.writeHead(401).end(JSON.stringify({ error: \"unauthorized\" }));\r\n\u001b[?2004l\r"]
[92.192883, "o", "\u001b[?2004h>       return;"]
[92.193145, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.193438, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r"]
[92.19354, "o", "\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {"]
[92.193767, "o", "\r\n\u001b[?2004l\r"]
[92.193837, "o", "\u001b[?2004h>       const start = Number(url.searchParams.get(\"cursor\"));"]
[92.193931, "o", "\r\n"]
[92.194144, "o", "\u001b[?2004l\r\u001b[?2004h"]
[92.194445, "o", ">       const end = start + 2;\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ resources: remaining.slice(start, end), next_cursor: end < remaining.length ? String(end) : null }));"]
[92.194531, "o", "\r\n"]
[92.194612, "o", "\u001b[?2004l\r"]
[92.194712, "o", "\u001b[?2004h"]
[92.194979, "o", ">       return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.1953, "o", ">     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"DELETE\") {\r\n"]
[92.195406, "o", "\u001b[?2004l\r\u001b[?2004h>       const id = decodeURIComponent(url.pathname.split(\"/\").pop()!);"]
[92.195544, "o", "\r\n"]
[92.195798, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[92.195921, "o", "      const dependents = remaining.filter((r) => r.depends_on?.includes(id));"]
[92.19613, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.196437, "o", ">       if (dependents.length) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.196544, "o", ">         res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map((r) => r.id) }));"]
[92.196685, "o", "\r\n\u001b[?2004l\r"]
[92.196827, "o", "\u001b[?2004h"]
[92.196936, "o", ">         return;\r\n\u001b[?2004l\r"]
[92.19718, "o", "\u001b[?2004h"]
[92.197412, "o", ">       }\r\n\u001b[?2004l\r\u001b[?2004h>       deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.197552, "o", ">       remaining = remaining.filter((r) => r.id !== id);\r\n"]
[92.197708, "o", "\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ deleted: id }));"]
[92.197871, "o", "\r\n"]
[92.198003, "o", "\u001b[?2004l\r\u001b[?2004h>       return;\r\n\u001b[?2004l\r\u001b[?2004h"]
[92.198245, "o", "> "]
[92.198411, "o", "    }\r\n\u001b[?2004l\r\u001b[?2004h>     res.writeHead(404).end(\"{}\");\r\n\u001b[?2004l\r"]
[92.198657, "o", "\u001b[?2004h"]
[92.198773, "o", ">   });\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));"]
[92.198919, "o", "\r\n\u001b[?2004l\r"]
[92.199145, "o", "\u001b[?2004h"]
[92.199421, "o", ">   t.after(() => new Promise<void>((resolve, reject) => {"]
[92.199567, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     server.close((err) => err ? reject(err) : resolve());\r\n\u001b[?2004l\r"]
[92.199715, "o", "\u001b[?2004h"]
