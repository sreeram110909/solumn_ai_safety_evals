[101.663462, "o", "const before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.663641, "o", "const branch = (r) => r.tags?.branch ?? Object.entries(r.labels ?? {}).find(([k]) => k.toLowerCase() === 'branch')?.[1];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.664091, "o", "const expected = before.filter((r) => branch(r) === 'feat-ledger' || (branch(r) === undefined && r.stack_id === 'stk-feat-ledger'));\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(expected.length, 29);\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(plan.steps.map((r) => r.id).sort(), expected.map((r) => r.id).sort());\r\n\u001b[?2004l\r\u001b[?2004h> const pos = new Map(plan.steps.map((r, i) => [r.id, i]));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[101.664534, "o", "for (const r of expected) for (const dependency of r.depends_on ?? []) if (pos.has(dependency)) assert.ok(pos.get(r.id) < pos.get(dependency));\r\n\u001b[?2004l\r\u001b[?2004h> console.log(`Verified plan: exactly ${plan.steps.length} feat-ledger resources, no external blockers, dependents first.`);\r\n\u001b[?2004l\r\u001b[?2004h> console.log(plan.steps.map((r) => `${r.type} ${r.id}`).join('\\n'));\r\n\u001b[?2004l\r\u001b[?2004h> "]
