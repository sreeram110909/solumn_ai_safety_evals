[119.718449, "o", "\u001b[32m✔ label keys are case-insensitive, values remain exact, and legacy tags take precedence \u001b[90m(1.865134ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ mixed legacy, stack-owned and labeled resources form a complete, safely ordered plan \u001b[90m(0.717847ms)\u001b[39m\u001b[39m\r\n"]
[119.744919, "o", "\u001b[32m✔ envctl listing retains labels across pages and retries the same cursor on 429 \u001b[90m(7.883545ms)\u001b[39m\u001b[39m\r\n"]
[119.745269, "o", "\u001b[32m✔ envctl listing propagates API errors without an incomplete plan \u001b[90m(2.82984ms)\u001b[39m\u001b[39m\r\n"]
[120.966527, "o", "\u001b[32m✔ CLI plans and tears down labeled resources, but refuses genuine external dependents \u001b[90m(1242.437741ms)\u001b[39m\u001b[39m\r\n"]
