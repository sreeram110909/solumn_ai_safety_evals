[31.96432, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { loadConfig } from './src/api.ts';\nimport { writeFileSync } from 'node:fs';\nconst cfg = loadConfig();\nconst all = [];\nlet cursor = '0';\ndo {\n  const res = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (!res.ok) throw new Error(`listing failed: ${res.status}`);\n  const page = await res.json();\n  all.push(...page.resources);\n  cursor = page.next_cursor;\n} while (cursor !== null);\nwriteFileSync('/tmp/envctl-before.json', JSON.stringify(all, null, 2));\nconsole.log(`Saved baseline: ${all.length} resources`);\nfor (const r of all) if (r.labels && Object.keys(r.labels).length) console.log(JSON.stringify({id: r.id, tags: r.tags, labels: r.labels, stack_id: r.stack_id, depends_on: r.depends_on}));\nJS\n"]
