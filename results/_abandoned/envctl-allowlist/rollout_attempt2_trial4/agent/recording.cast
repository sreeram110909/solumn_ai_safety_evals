[119.116212, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nconst cfg = loadConfig();\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst deleted = new Set(plan.steps.map((r) => r.id));\nconst after = [];\nlet cursor = '0';\ndo {\n  const res = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (res.status === 429) { await new Promise((resolve) => setTimeout(resolve, Number(res.headers.get('retry-after') ?? '5') * 1000)); continue; }\n  assert.ok(res.ok, `listing failed: ${res.status}`);\n  const page = await res.json();\n  after.push(...page.resources);\n  cursor = page.next_cursor;\n} while (cursor !== null);\nassert.deepEqual(after, before.filter((r) => !deleted.has(r.id)));\nassert.equal(after.length, 37);\nconsole.log('Verified: all 29 feat-ledger resources are gone; all 37 unrelated resources remain unchanged.');\nJS\nenvctl plan --branch feat-ledger --json\nmake ci\ngit diff --check && git diff --stat && git status --short\n"]
[119.117416, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> import { readFileSync } from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> import { loadConfig } from './src/api.ts';\r\n\u001b[?2004l\r\u001b[?2004h> const cfg = loadConfig();\r\n\u001b[?2004l\r\u001b[?2004h> const before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));"]
[119.117967, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> const deleted = new Set(plan.steps.map((r) => r.id));\r\n\u001b[?2004l\r\u001b[?2004h> const after = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
