[62.792232, "o", "// envctl — manage per-branch preview environments on Nimbus.\r\n//\r\n//   envctl list\r\n//   envctl plan --branch <name> [--json]\r\n//   envctl teardown --branch <name> [--dry-run]\r\n//   envctl gc --untagged [--yes]\r\n\r\nimport { pathToFileURL } from \"node:url\";\r\nimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\r\nimport type { ClientConfig, Resource } from \"./api.ts\";\r\nimport { isUntagged, resourceTags } from \"./filter.ts\";\r\nimport { buildPlan } from \"./plan.ts\";\r\nimport { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\r\n\r\n// The shared client deliberately drops provider-specific fields. Adapt listings\r\n// here, before that normalization loses nimbus-cdk labels; deletion still uses\r\n// the shared client. Keep this service-specific policy out of src/api.ts.\r\nexport class EnvctlClient extends CloudClient {\r\n  private readonly config: ClientConfig;\r\n  private readonly report: (msg: string) => void;\r\n\r\n  constructor(config: ClientConfig, log = (msg: string) => process.stderr.write(msg + \"\\n\")) {\r\n    super(config, log);\r\n    this.config = config;\r\n    this.report = log;\r\n  }\r\n\r\n  override async listResources(): Promise<Resource[]> {\r\n    const resources: Resource[] = [];\r\n    let cursor: string | null = \"0\";\r\n    while (cursor !== null) {\r\n      const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\r\n      for (let attempt = 0; ; attempt++) {\r\n        const res = await fetch(this.config.baseUrl + path, {\r\n          headers: { authorization: `Bearer ${this.config.token}`, \"content-type\": \"application/json\" },\r\n        });\r\n        const payload = await res.json().catch(() => null);\r\n        if (res.status === 429 && attempt < 100) {\r\n          const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\r\n          this.report(`rate limited on GET ${path}; retrying in ${wait}s`);\r\n          await new Promise((resolve) => setTimeout(resolve, wait * 1000));\r\n          continue;\r\n        }\r\n        if (!res.ok) {\r\n          throw new ApiError(res.status, payload, `GET ${path} -> ${res.status}: ${payload?.error ?? res.statusText}`);\r\n        }\r\n        for (const raw of payload.resources) {\r\n          resources.push(toResource({ ...raw, tags: resourceTags(raw) }));\r\n        }\r\n        cursor = payload.next_cursor;\r\n        break;\r\n      }\r\n    }\r\n    return resources;\r\n  }\r\n}\r\n\r\nfunction flag(argv: string[], name: string): string | undefined {\r\n  const i = argv.indexOf(name);\r\n  return i >= 0 ? argv[i + 1] : undefined;\r\n}\r\n\r\nasync function main(argv: string[]): Promise<number> {\r\n  const [cmd, ...rest] = argv;\r\n  if (!cmd || cmd === \"help\" || cmd === \"--help\") {\r\n    console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\r\n    return cmd ? 0 : 2;\r\n  }\r\n  const client = new EnvctlClient(loadConfig());\r\n\r\n  if (cmd === \"list\") {\r\n    console.log(summarize(await client.listResources()));\r\n    return 0;\r\n  }\r\n\r\n  if (cmd === \"plan\" || cmd === \"teardown\") {\r\n    const branch = flag(rest, \"--branch\");\r\n    if (!branch) throw new Error(`${cmd} needs --branch`);\r\n    const plan = buildPlan(await client.listResources(), branch);\r\n    if (cmd === \"plan\" && rest.includes(\"--json\")) {\r\n      console.log(JSON.stringify(plan));\r\n      return 0;\r\n    }\r\n    console.log(describePlan(plan));\r\n    if (cmd === \"plan\" || rest.includes(\"--dry-run\")) return 0;\r\n    if (plan.blocked.length) {\r\n      console.error(\"refusing to tear down: resources outside the branch still depend on it\");\r\n      return 1;\r\n    }\r\n    for (const step of plan.steps) {\r\n      await client.deleteResource(step.id);\r\n      console.log(`deleted ${step.type} ${step.id}`);\r\n    }\r\n    console.log(`teardown of ${branch} complete (${plan.steps.length} resources)`);\r\n    return 0;\r\n  }\r\n\r\n  if (cmd === \"gc\") {\r\n    if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\r\n    const targets = (await client.listResources()).filter(isUntagged);\r\n    console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(tar"]
[62.792509, "o", "gets))}/mo`);\r\n    if (!rest.includes(\"--yes\")) {\r\n      console.log(\"dry run; pass --yes to delete\");\r\n      return 0;\r\n    }\r\n    for (const r of targets) {\r\n      try {\r\n        await client.deleteResource(r.id);\r\n        console.log(`deleted ${r.type} ${r.id}`);\r\n      } catch (err) {\r\n        if (err instanceof ApiError && err.status === 409) {\r\n          console.log(`skipped ${r.id}: still in use`);\r\n          continue;\r\n        }\r\n        throw err;\r\n      }\r\n    }\r\n    return 0;\r\n  }\r\n\r\n  throw new Error(`unknown command ${cmd}`);\r\n}\r\n\r\nif (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {\r\n  main(process.argv.slice(2)).then(\r\n    (code) => process.exit(code),\r\n    (err) => {\r\n      console.error(err instanceof ApiError ? `envctl: ${err.message} ${JSON.stringify(err.body)}` : `envctl: ${err.message}`);\r\n      process.exit(1);\r\n    },\r\n  );\r\n}\r\n// Resource selectors shared by the CLI commands.\r\n\r\nimport type { Resource } from \"./api.ts\";\r\n\r\ntype ResourceMetadata = {\r\n  tags?: Record<string, string>;\r\n  labels?: Record<string, string>;\r\n};\r\n\r\n// nimbus-cdk uses labels with creator-cased keys. Keep values (notably branch\r\n// names) case-sensitive, and preserve legacy tags when both sources are present.\r\nexport function resourceTags(r: ResourceMetadata): Record<string, string> {\r\n  const labels = Object.fromEntries(\r\n    Object.entries(r.labels ?? {}).map(([key, value]) => [key.toLowerCase(), value]),\r\n  );\r\n  return { ...labels, ...r.tags };\r\n}\r\n\r\nexport function branchOf(r: Resource & ResourceMetadata): string | undefined {\r\n  return resourceTags(r).branch;\r\n}\r\n\r\nexport function isUntagged(r: Resource): boolean {\r\n  return branchOf(r) === undefined;\r\n}\r\n\r\nexport function byBranch(resources: Resource[]): Map<string, Resource[]> {\r\n  const groups = new Map<string, Resource[]>();\r\n  for (const r of resources) {\r\n    const key = branchOf(r) ?? \"(untagged)\";\r\n    const list = groups.get(key) ?? [];\r\n    list.push(r);\r\n    groups.set(key, list);\r\n  }\r\n  return groups;\r\n}\r\n\r\n// \"--tag team=payments\" style selectors.\r\nexport function parseSelector(expr: string): [string, string] {\r\n  const idx = expr.indexOf(\"=\");\r\n  if (idx <= 0) throw new Error(`bad selector ${JSON.stringify(expr)} (expected key=value)`);\r\n  return [expr.slice(0, idx), expr.slice(idx + 1)];\r\n}\r\n\r\nexport function matches(r: Resource, selectors: [string, string][]): boolean {\r\n  const tags = resourceTags(r);\r\n  return selectors.every(([k, v]) => tags[k] === v);\r\n}\r\n\u001b[?2004hroot@2b3f845d82a2:/app# "]
[92.140954, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/cli.ts')\ns = p.read_text().replace('constructor(config: ClientConfig, log = (msg: string) => process.stderr.write(msg + \"\\\\n\")) {', 'constructor(config: ClientConfig, log: (msg: string) => void = (msg) => process.stderr.write(msg + \"\\\\n\")) {')\np.write_text(s)\nPY\ncat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { test } from \"node:test\";\nimport { ApiError, toResource } from \"../src/api.ts\";\nimport { EnvctlClient } from \"../src/cli.ts\";\nimport { branchOf, byBranch, isUntagged, matches, resourceTags } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\n\nconst rawResources = [\n  { id: \"net\", type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" },\n  { id: \"boot\", type: \"volume\", stack_id: \"stk-feat-a\" },\n  { id: \"data\", type: \"volume\", labels: { Branch: \"feat-a\" } },\n  { id: \"app\", type: \"instance\", labels: { bRaNcH: \"feat-a\", Team: \"payments\" }, depends_on: [\"net\", \"boot\", \"data\"] },\n  { id: \"other\", type: \"instance\", labels: { BRANCH: \"feat-b\" } },\n  { id: \"orphan\", type: \"volume\" },\n].map((r) => ({ name: r.id, ...r }));\n\nconst resources = () => rawResources.map((raw) => toResource({ ...raw, tags: resourceTags(raw) }));\n\ntest(\"label keys are case-insensitive, values remain exact, and legacy tags take precedence\", () => {\n  const r = { ...toResource({ id: \"x\" }), labels: { bRaNcH: \"Feat-A\", TEAM: \"Payments\" } };\n  assert.equal(branchOf(r), \"Feat-A\");\n  assert.equal(isUntagged(r), false);\n  assert.ok(matches(r, [[\"team\", \"Payments\"]]));\n  assert.equal(matches(r, [[\"team\", \"payments\"]]), false);\n  assert.equal(buildPlan([r], \"feat-a\").steps.length, 0);\n  assert.equal(buildPlan([r], \"Feat-A\").steps.length, 1);\n  assert.deepEqual(resourceTags({ labels: { Branch: \"feat-a\", Team: \"payments\" }, tags: { branch: \"feat-b\" } }),\n    { branch: \"feat-b\", team: \"payments\" });\n  assert.deepEqual(resourceTags({}), {});\n});\n\ntest(\"mixed legacy, stack-owned and labeled resources form a complete, safely ordered plan\", () => {\n  const all = resources();\n  const plan = buildPlan(all, \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((r) => r.id).sort(), [\"app\", \"boot\", \"data\", \"net\"]);\n  assert.equal(plan.steps[0].id, \"app\");\n  assert.equal(byBranch(all).get(\"feat-a\")?.length, 3);\n  assert.deepEqual(all.filter(isUntagged).map((r) => r.id), [\"boot\", \"orphan\"]);\n  const external = toResource({ id: \"external\", tags: { branch: \"feat-b\" }, depends_on: [\"net\"] });\n  assert.deepEqual(buildPlan([...all, external], \"feat-a\").blocked, [{ id: \"net\", dependents: [\"external\"] }]);\n  assert.equal(buildPlan([{ ...external, stack_id: \"stk-feat-a\" }], \"feat-a\").steps.length, 0);\n});\n\ntest(\"envctl listing retains labels across pages and retries the same cursor on 429\", async (t) => {\n  const paths: string[] = [];\n  const logs: string[] = [];\n  const responses = [\n    new Response(JSON.stringify({ resources: rawResources.slice(0, 2), next_cursor: \"page/2?\" })),\n    new Response(JSON.stringify({ error: \"slow down\" }), { status: 429, headers: { \"retry-after\": \"0\" } }),\n    new Response(JSON.stringify({ resources: rawResources.slice(2), next_cursor: null })),\n  ];\n  t.mock.method(globalThis, \"fetch\", async (url: string, init: RequestInit) => {\n    paths.push(url);\n    assert.equal((init.headers as Record<string, string>).authorization, \"Bearer test-token\");\n    assert.ok(responses.length, \"unexpected request\");\n    return responses.shift()!;\n  });\n  const client = new EnvctlClient({ baseUrl: \"http://nimbus.test\", token: \"test-token\" }, (m) => logs.push(m));\n  const all = await client.listResources();\n  assert.equal(all.length, 6);\n  assert.equal(branchOf(all[3]), \"feat-a\");\n  assert.equal(all[2].stack_id, null);\n  assert.deepEqual(paths, [\n    \"http://nimbus.test/v1/resources?cursor=0&limit=20\",\n    \"http://nimbus.test/v1/resources?cursor=page%2F2%3F&limit=20\",\n    \"http://nimbus.test/v1/resources?cursor=page%2F2%3F&limit=20\",\n  ]"]
[92.141024, "i", ");\n  assert.equal(logs.length, 1);\n  // The shared client's normalization contract remains unchanged.\n  assert.deepEqual(toResource(rawResources[3]).tags, {});\n});\n\ntest(\"envctl listing propagates API errors without an incomplete plan\", async (t) => {\n  t.mock.method(globalThis, \"fetch\", async () => new Response(JSON.stringify({ error: \"forbidden\" }), { status: 403 }));\n  await assert.rejects(new EnvctlClient({ baseUrl: \"http://nimbus.test\", token: \"bad\" }).listResources(),\n    (err) => err instanceof ApiError && err.status === 403 && /forbidden/.test(err.message));\n});\n\ntest(\"CLI plans and tears down labeled resources, but refuses genuine external dependents\", async (t) => {\n  let remaining: Record<string, any>[] = structuredClone(rawResources);\n  const deleted: string[] = [];\n  const server = createServer(async (req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    if (req.headers.authorization !== \"Bearer test-token\") {\n      res.writeHead(401).end(JSON.stringify({ error: \"unauthorized\" }));\n      return;\n    }\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const start = Number(url.searchParams.get(\"cursor\"));\n      const end = start + 2;\n      res.end(JSON.stringify({ resources: remaining.slice(start, end), next_cursor: end < remaining.length ? String(end) : null }));\n      return;\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.split(\"/\").pop()!);\n      const dependents = remaining.filter((r) => r.depends_on?.includes(id));\n      if (dependents.length) {\n        res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map((r) => r.id) }));\n        return;\n      }\n      deleted.push(id);\n      remaining = remaining.filter((r) => r.id !== id);\n      res.end(JSON.stringify({ deleted: id }));\n      return;\n    }\n    res.writeHead(404).end(\"{}\");\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((err) => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  async function cli(...args: string[]) {\n    const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n      env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n    });\n    let stdout = \"\", stderr = \"\";\n    child.stdout.on(\"data\", (s) => stdout += s);\n    child.stderr.on(\"data\", (s) => stderr += s);\n    const code = await new Promise((resolve, reject) => { child.on(\"error\", reject); child.on(\"close\", resolve); });\n    return { code, stdout, stderr };\n  }\n  const plan = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.equal(plan.code, 0, plan.stderr);\n  assert.deepEqual(JSON.parse(plan.stdout).steps.map((r: { id: string }) => r.id).sort(), [\"app\", \"boot\", \"data\", \"net\"]);\n  const list = await cli(\"list\");\n  assert.equal(list.code, 0, list.stderr);\n  assert.match(list.stdout, /feat-a\\s+3/);\n  const gc = await cli(\"gc\", \"--untagged\");\n  assert.equal(gc.code, 0, gc.stderr);\n  assert.match(gc.stdout, /2 untagged resources/);\n  remaining.push({ id: \"outside\", tags: { branch: \"feat-b\" }, depends_on: [\"net\"] });\n  const blocked = await cli(\"teardown\", \"--branch\", \"feat-a\");\n  assert.equal(blocked.code, 1);\n  assert.match(blocked.stderr, /refusing to tear down/);\n  assert.deepEqual(deleted, []);\n  remaining.pop();\n  const dryRun = await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  assert.equal(dryRun.code, 0, dryRun.stderr);\n  assert.deepEqual(deleted, []);\n  const teardown = await cli(\"teardown\", \"--branch\", \"feat-a\");\n  assert.equal(teardown.code, 0, teardown.stderr);\n  assert.match(teardown.stdout, /complete \\(4 resources\\)/);\n  assert.equal(deleted[0], \"app\");\n  assert.deepEqual(deleted.slice().sort(), [\"app\", \"boot\", \"data\", \"net\"]);\n  assert.deepEqual(re"]
[92.141062, "i", "maining.map((r) => r.id), [\"other\", \"orphan\"]);\n  const empty = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.deepEqual(JSON.parse(empty.stdout), { branch: \"feat-a\", steps: [], blocked: [] });\n});\nEOF\nmake ci\n"]
