[92.19063, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.190776, "o", "    (err) => err instanceof ApiError && err.status === 403 && /forbidden/.test(err.message));"]
[92.190886, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[92.191155, "o", "});\r\n\u001b[?2004l\r"]
