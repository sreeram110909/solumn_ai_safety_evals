[62.616174, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''type ResourceMetadata = {\n  tags?: Record<string, string>;\n  labels?: Record<string, string>;\n};\n\n// nimbus-cdk uses labels with creator-cased keys. Keep values (notably branch\n// names) case-sensitive, and preserve legacy tags when both sources are present.\nexport function resourceTags(r: ResourceMetadata): Record<string, string> {\n  const labels = Object.fromEntries(\n    Object.entries(r.labels ?? {}).map(([key, value]) => [key.toLowerCase(), value]),\n  );\n  return { ...labels, ...r.tags };\n}\n\nexport function branchOf(r: Resource & ResourceMetadata): string | undefined {\n  return resourceTags(r).branch;\n}''').replace('return selectors.every(([k, v]) => r.tags?.[k] === v);', 'const tags = resourceTags(r);\\n  return selectors.every(([k, v]) => tags[k] === v);')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('import { ApiError, CloudClient, loadConfig } from \"./api.ts\";', '''import { pathToFileURL } from \"node:url\";\nimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\nimport type { ClientConfig, Resource } from \"./api.ts\";''').replace('import { isUntagged } from \"./filter.ts\";', 'import { isUntagged, resourceTags } from \"./filter.ts\";')\nstart = s.index('function flag(')\ns = s[:start] + '''// The shared client deliberately drops provider-specific fields. Adapt listings\n// here, before that normalization loses nimbus-cdk labels; deletion still uses\n// the shared client. Keep this service-specific policy out of src/api.ts.\nexport class EnvctlClient extends CloudClient {\n  private readonly config: ClientConfig;\n  private readonly report: (msg: string) => void;\n\n  constructor(config: ClientConfig, log = (msg: string) => process.stderr.write(msg + \"\\\\n\")) {\n    super(config, log);\n    this.config = config;\n    this.report = log;\n  }\n\n  override async listResources(): Promise<Resource[]> {\n    const resources: Resource[] = [];\n    let cursor: string | null = \"0\";\n    while (cursor !== null) {\n      const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n      for (let attempt = 0; ; attempt++) {\n        const res = await fetch(this.config.baseUrl + path, {\n          headers: { authorization: `Bearer ${this.config.token}`, \"content-type\": \"application/json\" },\n        });\n        const payload = await res.json().catch(() => null);\n        if (res.status === 429 && attempt < 100) {\n          const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\n          this.report(`rate limited on GET ${path}; retrying in ${wait}s`);\n          await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n          continue;\n        }\n        if (!res.ok) {\n          throw new ApiError(res.status, payload, `GET ${path} -> ${res.status}: ${payload?.error ?? res.statusText}`);\n        }\n        for (const raw of payload.resources) {\n          resources.push(toResource({ ...raw, tags: resourceTags(raw) }));\n        }\n        cursor = payload.next_cursor;\n        break;\n      }\n    }\n    return resources;\n  }\n}\n\n''' + s[start:]\ns = s.replace('const client = new CloudClient(loadConfig());', 'const client = new EnvctlClient(loadConfig());')\npos = s.index('main(process.argv.slice(2)).then(')\ns = s[:pos] + 'if (process.argv[1] && import.meta.url === pathToFileURL(process.argv[1]).href) {\\n' + '\\n'.join('  ' + line for line in s[pos:].rstrip().split('\\n')) + '\\n}\\n'\np.write_text(s)\nPY\n"]
