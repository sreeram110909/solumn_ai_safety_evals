[76.645612, "o", "function raw(id: string, fields: Record<string, unknown> = {}): Record<string, unknown> {\r\n\u001b[?2004l\r"]
[76.645749, "o", "\u001b[?2004h> "]
[76.646002, "o", "  return { id, type: \"instance\", name: id, ...fields };\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.646041, "o", "> }"]
[76.646103, "o", "\r\n\u001b[?2004l\r"]
