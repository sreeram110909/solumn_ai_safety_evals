[78.273177, "o", "\u001b[32m✔ CLI preserves labels across pages and tears down only the requested branch \u001b[90m(1200.43757ms)\u001b[39m\u001b[39m\r\n"]
[78.286478, "o", "\u001b[32m✔ CDK label keys are case-insensitive, while branch values stay exact \u001b[90m(1.824142ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ normalization preserves legacy tags and defaults without mutating payloads \u001b[90m(1.237274ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ label-owned resources join the plan, but unrelated dependents remain blockers \u001b[90m(0.515675ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.810264ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.193509ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.40898ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.347064ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.306461ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1425.335576\u001b[39m\r\n"]
