[107.554637, "o", "\u001b[32m✔ CLI preserves labels across pages and tears down only the requested branch \u001b[90m(1144.763611ms)\u001b[39m\u001b[39m\r\n"]
[107.569238, "o", "\u001b[32m✔ CDK label keys are case-insensitive, while branch values stay exact \u001b[90m(10.545815ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ normalization preserves legacy tags and defaults without mutating payloads \u001b[90m(0.827835ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ label-owned resources join the plan, but unrelated dependents remain blockers \u001b[90m(0.2967ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.761672ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.222725ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.525052ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.423326ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.334506ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1325.983325\u001b[39m\r\n"]
