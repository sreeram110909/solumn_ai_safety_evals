[76.64773, "o", "test(\"CDK label keys are case-insensitive, while branch values stay exact\", () => {"]
[76.650943, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   for (const key of [\"branch\", \"Branch\", \"BRANCH\", \"bRaNcH\"]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const resource = toEnvctlResource(raw(\"worker\", { labels: { [key]: \"Feat-Ledger\", Team: \"payments\" } }));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(branchOf(resource), \"Feat-Ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(isUntagged(resource), false);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.ok(matches(resource, [[\"team\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(byBranch([resource]).get(\"Feat-Ledger\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(buildPlan([resource], \"feat-ledger\").steps.length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(buildPlan([resource], \"Feat-Ledger\").steps.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"normalization preserves legacy tags and defaults without mutating payloads\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const source = raw(\"legacy\", {\r\n\u001b[?2004l\r\u001b[?2004h>     tags: { branch: \"feat-other\", owner: \"legacy\" },\r\n\u001b[?2004l\r\u001b[?2004h>     labels: { Branch: \"feat-ledger\", Team: \"payments\" },\r\n\u001b[?2004l\r\u001b[?2004h>     stack_id: \"stk-feat-ledger\",\r\n\u001b[?2004l\r\u001b[?2004h>     depends_on: [\"network\"],\r\n\u001b[?2004l\r\u001b[?2004h>     cost_month_cents: 42,\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   const before = structuredClone(source);\r\n\u001b[?2004l\r\u001b[?2004h>   const resource = toEnvctlResource(source);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(resource.tags, { branch: \"feat-other\", team: \"payments\", owner: \"legacy\" });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(source, before);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(resource.cost_month_cents, 42);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(resource.depends_on, [\"network\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(buildPlan([resource], \"feat-ledger\").steps.length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   for (const fields of [{}, { labels: null, tags: null }, { labels: {}, tags: {} }]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const empty = toEnvctlResource(raw(\"empty\", fields));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.ok(isUntagged(empty));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(empty.tags, {});\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(empty.stack_id, null);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"label-owned resources join the plan, but unrelated dependents remain blockers\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"network\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"boot\", { stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"worker\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"network\", \"boot\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"external\", { labels: { Branch: \"feat-payroll\" }, depends_on: [\"network\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"lookalike\", { name: \"feat-ledger-extra\", stack_id: \"stk-feat-ledger-extra\" }),\r\n\u001b[?2004l\r\u001b[?2004h>   ].map(toEnvctlResource);\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan(resources, \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map(r => r.id).sort(), [\"boot\", \"network\", \"worker\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\"] }]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.651575, "o", "  assert.ok(plan.steps.findIndex(r => r.id === \"worker\") < plan.steps.findIndex(r => r.id === \"boot\"));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n"]
