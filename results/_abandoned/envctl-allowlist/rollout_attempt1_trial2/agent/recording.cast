[76.654146, "o", "cat > test/cli.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.654293, "o", "import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.654485, "o", "import { spawn } from \"node:child_process\";\r\n\u001b[?2004l\rolum\u001b[?2004h> "]
[76.654715, "o", "import { createServer } from \"node:http\";\r\n\u001b[?2004l\rther\")\u001b[?2004h> "]
[76.654878, "o", "import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { fileURLToPath } from \"node:url\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[76.655033, "o", "> "]
[76.65546, "o", "test(\"CLI preserves labels across pages and tears down only the requested branch\", async (t) => {\r\n\u001b[?2004l\r"]
[76.65894, "o", "\u001b[?2004h>   let resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"net\", type: \"network\", tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"boot\", type: \"volume\", stack_id: \"stk-feat-ledger\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"legacy\", type: \"instance\", tags: { branch: \"feat-ledger\" }, depends_on: [\"net\", \"boot\"] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"cdk-boot\", type: \"volume\", labels: { BRANCH: \"feat-ledger\" }, depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"worker\", type: \"instance\", labels: { bRaNcH: \"feat-ledger\" }, depends_on: [\"net\", \"cdk-boot\"] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"other\", type: \"instance\", labels: { Branch: \"feat-payroll\" }, depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>   ].map(r => ({ name: r.id, cost_month_cents: 100, ...r }));\r\n\u001b[?2004l\r\u001b[?2004h>   const requests: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h>     requests.push(`${req.method} ${req.url}`);\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.headers.authorization !== \"Bearer test-token\") {\r\n\u001b[?2004l\r\u001b[?2004h>       res.writeHead(401).end(JSON.stringify({ error: \"unauthorized\" }));\r\n\u001b[?2004l\r\u001b[?2004h>       return;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n\u001b[?2004l\r\u001b[?2004h>       assert.equal(url.searchParams.get(\"limit\"), \"20\");\r\n\u001b[?2004l\r\u001b[?2004h>       const cursor = url.searchParams.get(\"cursor\")!;\r\n\u001b[?2004l\r\u001b[?2004h>       const offset = cursor === \"0\" ? 0 : Number(cursor.slice(\"page /\".length));\r\n\u001b[?2004l\r\u001b[?2004h>       const next = offset + 2;\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({\r\n\u001b[?2004l\r\u001b[?2004h>         resources: resources.slice(offset, next),\r\n\u001b[?2004l\r\u001b[?2004h>         next_cursor: next < resources.length ? `page /${next}` : null,\r\n\u001b[?2004l\r\u001b[?2004h>       }));\r\n\u001b[?2004l\r\u001b[?2004h>       return;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"DELETE\") {\r\n\u001b[?2004l\r\u001b[?2004h>       const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\r\n\u001b[?2004l\r\u001b[?2004h>       const dependents = resources.filter(r => r.depends_on.includes(id)).map(r => r.id);\r\n\u001b[?2004l\r\u001b[?2004h>       if (dependents.length) {\r\n\u001b[?2004l\r\u001b[?2004h>         res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\", dependents }));\r\n\u001b[?2004l\r\u001b[?2004h>         return;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h>       resources = resources.filter(r => r.id !== id);\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ deleted: id }));\r\n\u001b[?2004l\r\u001b[?2004h>       return;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     res.writeHead(404).end(JSON.stringify({ error: \"not found\" }));\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>(resolve => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.659455, "o", "  t.after(() => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())));\r\n\u001b[?2004l\r"]
[76.65968, "o", "\u001b[?2004h> "]
[76.663022, "o", "  const address = server.address() as { port: number };\r\n\u001b[?2004l\r\u001b[?2004h>   const cli = fileURLToPath(new URL(\"../src/cli.ts\", import.meta.url));\r\n\u001b[?2004l\r\u001b[?2004h>   const run = (...args: string[]) => new Promise<{ code: number | null; stdout: string; stderr: string }>((resolve, reject) => {\r\n\u001b[?2004l\r\u001b[?2004h>     const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cli, ...args], {\r\n\u001b[?2004l\r\u001b[?2004h>       env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>     let stdout = \"\";\r\n\u001b[?2004l\r\u001b[?2004h>     let stderr = \"\";\r\n\u001b[?2004l\r\u001b[?2004h>     child.stdout.on(\"data\", chunk => { stdout += chunk; });\r\n\u001b[?2004l\r\u001b[?2004h>     child.stderr.on(\"data\", chunk => { stderr += chunk; });\r\n\u001b[?2004l\r\u001b[?2004h>     child.on(\"error\", reject);\r\n\u001b[?2004l\r\u001b[?2004h>     child.on(\"close\", code => resolve({ code, stdout, stderr }));\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const planned = await run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(planned.code, 0, planned.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = JSON.parse(planned.stdout);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), [\"boot\", \"cdk-boot\", \"legacy\", \"net\", \"worker\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(requests.some(path => path.includes(\"cursor=page%20%2F4\")), \"must follow and encode cursors\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const listing = await run(\"list\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(listing.code, 0, listing.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(listing.stdout, /feat-ledger\\s+4/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(listing.stdout, /feat-payroll\\s+1/);\r\n\u001b[?2004l\r\u001b[?2004h>   const gc = await run(\"gc\", \"--untagged\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(gc.code, 0, gc.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(gc.stdout, /1 untagged resources/); // only the legacy stack's untagged boot volume\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   resources.find(r => r.id === \"other\")!.depends_on = [\"net\"];\r\n\u001b[?2004l\r\u001b[?2004h>   const refused = await run(\"teardown\", \"--branch\", \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(refused.code, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(refused.stderr, /refusing to tear down/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h>   resources.find(r => r.id === \"other\")!.depends_on = [];\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const teardown = await run(\"teardown\", \"--branch\", \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(teardown.code, 0, teardown.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(teardown.stdout, /complete \\(5 resources\\)/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, plan.steps.map((r: { id: string }) => r.id));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(resources.map(r => r.id), [\"other\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   const empty = await run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(empty.code, 0, empty.stderr);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.663086, "o", "  assert.deepEqual(JSON.parse(empty.stdout).steps, []);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[76.663111, "o", "EOF\r\n"]
