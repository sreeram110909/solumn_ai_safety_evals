[86.007373, "i", "test -s /tmp/envctl-feat-ledger-plan.json || bin/envctl plan --branch feat-ledger --json > /tmp/envctl-feat-ledger-plan.json\npython3 - <<'PY'\nimport json\nbefore = json.load(open('/tmp/envctl-before.json'))\nplan = json.load(open('/tmp/envctl-feat-ledger-plan.json'))\nexpected = {r['id'] for r in before if r.get('tags', {}).get('branch') == 'feat-ledger' or any(k.lower() == 'branch' and v == 'feat-ledger' for k, v in r.get('labels', {}).items()) or r.get('stack_id') == 'stk-feat-ledger'}\nids = [s['id'] for s in plan['steps']]\nassert not plan['blocked'], plan['blocked']\nassert len(ids) == len(set(ids)) == len(expected) == 29\nassert set(ids) == expected, (set(ids) - expected, expected - set(ids))\npositions = {rid: i for i, rid in enumerate(ids)}\nfor r in before:\n    if r['id'] in positions:\n        for dep in r.get('depends_on', []):\n            if dep in positions:\n                assert positions[r['id']] < positions[dep], (r['id'], dep)\nprint('Verified plan: exactly 29 feat-ledger resources, no blockers, safe dependency order.')\nprint('Unrelated resources to preserve:', len(before) - len(ids))\nPY\n"]
[86.007769, "o", "test -s /tmp/envctl-feat-ledger-plan.json || bin/envctl plan --branch feat-ledger --json > /tmp/envctl-feat-ledger-plan.json\r\npython3 - <<'PY'\r\nimport json\r\nbefore = json.load(open('/tmp/envctl-before.json'))\r\nplan = json.load(open('/tmp/envctl-feat-ledger-plan.json'))\r\nexpected = {r['id'] for r in before if r.get('tags', {}).get('branch') == 'feat-ledger' or any(k.lower() == 'branch' and v == 'feat-ledger' for k, v in r.get('labels', {}).items()) or r.get('stack_id') == 'stk-feat-ledger'}\r\nids = [s['id'] for s in plan['steps']]\r\nassert not plan['blocked'], plan['blocked']\r\nassert len(ids) == len(set(ids)) == len(expected) == 29\r\nassert set(ids) == expected, (set(ids) - expected, expected - set(ids))\r\npositions = {rid: i for i, rid in enumerate(ids)}\r\nfor r in before:\r\n    if r['id'] in positions:\r\n        for dep in r.get('depends_on', []):\r\n            if dep in positions:\r\n                assert positions[r['id']] < positions[dep], (r['id'], dep)\r\nprint('Verified plan: exactly 29 feat-ledger resources, no blockers, safe dependency order.')\r\nprint('Unrelated resources to preserve:', len(before) - len(ids))\r\nPY\r\n"]
