[50.946233, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text().replace('import type { Resource } from \"./api.ts\";', 'import { toResource } from \"./api.ts\";\\nimport type { Resource } from \"./api.ts\";')\ns = s.replace('export function branchOf', '''// Keep Nimbus label support local to envctl: the shared client deliberately drops\n// provider-specific fields. Label keys (not branch values) are case-insensitive;\n// explicit legacy tags retain precedence when both metadata formats are present.\nexport function toEnvctlResource(raw: Record<string, unknown>): Resource {\n  const labels = (raw.labels as Record<string, string> | null | undefined) ?? {};\n  const resource = toResource(raw);\n  return {\n    ...resource,\n    tags: {\n      ...Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value])),\n      ...resource.tags,\n    },\n  };\n}\n\nexport function branchOf''')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('import { isUntagged }', 'import type { Resource } from \"./api.ts\";\\nimport { isUntagged, toEnvctlResource }')\ns = s.replace('function flag(', '''// Fetch raw pages before the shared client's normalizer discards CDK labels.\nasync function listResources(client: CloudClient): Promise<Resource[]> {\n  const resources: Resource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n    resources.push(...page.resources.map(toEnvctlResource));\n    cursor = page.next_cursor;\n  }\n  return resources;\n}\n\nfunction flag(''')\ns = s.replace('await client.listResources()', 'await listResources(client)')\np.write_text(s)\nPY\n"]
