[76.641379, "i", "cat > test/filter.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { branchOf, byBranch, isUntagged, matches, toEnvctlResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\n\nfunction raw(id: string, fields: Record<string, unknown> = {}): Record<string, unknown> {\n  return { id, type: \"instance\", name: id, ...fields };\n}\n\ntest(\"CDK label keys are case-insensitive, while branch values stay exact\", () => {\n  for (const key of [\"branch\", \"Branch\", \"BRANCH\", \"bRaNcH\"]) {\n    const resource = toEnvctlResource(raw(\"worker\", { labels: { [key]: \"Feat-Ledger\", Team: \"payments\" } }));\n    assert.equal(branchOf(resource), \"Feat-Ledger\");\n    assert.equal(isUntagged(resource), false);\n    assert.ok(matches(resource, [[\"team\", \"payments\"]]));\n    assert.equal(byBranch([resource]).get(\"Feat-Ledger\")?.length, 1);\n    assert.equal(buildPlan([resource], \"feat-ledger\").steps.length, 0);\n    assert.equal(buildPlan([resource], \"Feat-Ledger\").steps.length, 1);\n  }\n});\n\ntest(\"normalization preserves legacy tags and defaults without mutating payloads\", () => {\n  const source = raw(\"legacy\", {\n    tags: { branch: \"feat-other\", owner: \"legacy\" },\n    labels: { Branch: \"feat-ledger\", Team: \"payments\" },\n    stack_id: \"stk-feat-ledger\",\n    depends_on: [\"network\"],\n    cost_month_cents: 42,\n  });\n  const before = structuredClone(source);\n  const resource = toEnvctlResource(source);\n  assert.deepEqual(resource.tags, { branch: \"feat-other\", team: \"payments\", owner: \"legacy\" });\n  assert.deepEqual(source, before);\n  assert.equal(resource.cost_month_cents, 42);\n  assert.deepEqual(resource.depends_on, [\"network\"]);\n  assert.equal(buildPlan([resource], \"feat-ledger\").steps.length, 0);\n  for (const fields of [{}, { labels: null, tags: null }, { labels: {}, tags: {} }]) {\n    const empty = toEnvctlResource(raw(\"empty\", fields));\n    assert.ok(isUntagged(empty));\n    assert.deepEqual(empty.tags, {});\n    assert.equal(empty.stack_id, null);\n  }\n});\n\ntest(\"label-owned resources join the plan, but unrelated dependents remain blockers\", () => {\n  const resources = [\n    raw(\"network\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\n    raw(\"boot\", { stack_id: \"stk-feat-ledger\" }),\n    raw(\"worker\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"network\", \"boot\"] }),\n    raw(\"external\", { labels: { Branch: \"feat-payroll\" }, depends_on: [\"network\"] }),\n    raw(\"lookalike\", { name: \"feat-ledger-extra\", stack_id: \"stk-feat-ledger-extra\" }),\n  ].map(toEnvctlResource);\n  const plan = buildPlan(resources, \"feat-ledger\");\n  assert.deepEqual(plan.steps.map(r => r.id).sort(), [\"boot\", \"network\", \"worker\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\"] }]);\n  assert.ok(plan.steps.findIndex(r => r.id === \"worker\") < plan.steps.findIndex(r => r.id === \"boot\"));\n});\nEOF\ncat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { test } from \"node:test\";\nimport { fileURLToPath } from \"node:url\";\n\ntest(\"CLI preserves labels across pages and tears down only the requested branch\", async (t) => {\n  let resources = [\n    { id: \"net\", type: \"network\", tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\", depends_on: [] },\n    { id: \"boot\", type: \"volume\", stack_id: \"stk-feat-ledger\", depends_on: [] },\n    { id: \"legacy\", type: \"instance\", tags: { branch: \"feat-ledger\" }, depends_on: [\"net\", \"boot\"] },\n    { id: \"cdk-boot\", type: \"volume\", labels: { BRANCH: \"feat-ledger\" }, depends_on: [] },\n    { id: \"worker\", type: \"instance\", labels: { bRaNcH: \"feat-ledger\" }, depends_on: [\"net\", \"cdk-boot\"] },\n    { id: \"other\", type: \"instance\", labels: { Branch: \"feat-payroll\" }, depends_on: [] },\n  ].map(r => ({ name: r.id, cost_month_cents: 100, ...r }));\n  const requests: string[] = [];\n  const deleted: string[] = [];\n  const server = createServer((req, res) => {\n    const url = new URL(req.url!, \"http://localhost\");\n    requests.push(`${req.method} $"]
[76.641616, "i", "{req.url}`);\n    res.setHeader(\"content-type\", \"application/json\");\n    if (req.headers.authorization !== \"Bearer test-token\") {\n      res.writeHead(401).end(JSON.stringify({ error: \"unauthorized\" }));\n      return;\n    }\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      const cursor = url.searchParams.get(\"cursor\")!;\n      const offset = cursor === \"0\" ? 0 : Number(cursor.slice(\"page /\".length));\n      const next = offset + 2;\n      res.end(JSON.stringify({\n        resources: resources.slice(offset, next),\n        next_cursor: next < resources.length ? `page /${next}` : null,\n      }));\n      return;\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter(r => r.depends_on.includes(id)).map(r => r.id);\n      if (dependents.length) {\n        res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\", dependents }));\n        return;\n      }\n      deleted.push(id);\n      resources = resources.filter(r => r.id !== id);\n      res.end(JSON.stringify({ deleted: id }));\n      return;\n    }\n    res.writeHead(404).end(JSON.stringify({ error: \"not found\" }));\n  });\n  await new Promise<void>(resolve => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())));\n  const address = server.address() as { port: number };\n  const cli = fileURLToPath(new URL(\"../src/cli.ts\", import.meta.url));\n  const run = (...args: string[]) => new Promise<{ code: number | null; stdout: string; stderr: string }>((resolve, reject) => {\n    const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cli, ...args], {\n      env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n    });\n    let stdout = \"\";\n    let stderr = \"\";\n    child.stdout.on(\"data\", chunk => { stdout += chunk; });\n    child.stderr.on(\"data\", chunk => { stderr += chunk; });\n    child.on(\"error\", reject);\n    child.on(\"close\", code => resolve({ code, stdout, stderr }));\n  });\n\n  const planned = await run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\n  assert.equal(planned.code, 0, planned.stderr);\n  const plan = JSON.parse(planned.stdout);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), [\"boot\", \"cdk-boot\", \"legacy\", \"net\", \"worker\"]);\n  assert.ok(requests.some(path => path.includes(\"cursor=page%20%2F4\")), \"must follow and encode cursors\");\n\n  const listing = await run(\"list\");\n  assert.equal(listing.code, 0, listing.stderr);\n  assert.match(listing.stdout, /feat-ledger\\s+4/);\n  assert.match(listing.stdout, /feat-payroll\\s+1/);\n  const gc = await run(\"gc\", \"--untagged\");\n  assert.equal(gc.code, 0, gc.stderr);\n  assert.match(gc.stdout, /1 untagged resources/); // only the legacy stack's untagged boot volume\n\n  resources.find(r => r.id === \"other\")!.depends_on = [\"net\"];\n  const refused = await run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(refused.code, 1);\n  assert.match(refused.stderr, /refusing to tear down/);\n  assert.deepEqual(deleted, []);\n  resources.find(r => r.id === \"other\")!.depends_on = [];\n\n  const teardown = await run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(teardown.code, 0, teardown.stderr);\n  assert.match(teardown.stdout, /complete \\(5 resources\\)/);\n  assert.deepEqual(deleted, plan.steps.map((r: { id: string }) => r.id));\n  assert.deepEqual(resources.map(r => r.id), [\"other\"]);\n  const empty = await run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\n  assert.equal(empty.code, 0, empty.stderr);\n  assert.deepEqual(JSON.parse(empty.stdout).steps, []);\n});\nEOF\nmake ci\n"]
[76.64428, "o", "cat > test/filter.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { branchOf, byBranch, isUntagged, matches, toEnvctlResource } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> "]
