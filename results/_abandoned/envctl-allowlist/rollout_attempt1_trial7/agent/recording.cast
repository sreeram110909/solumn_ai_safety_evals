[77.720066, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\n\nfunction fixture() {\n  return [\n    { id: \"net\", type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", depends_on: [] },\n    { id: \"boot\", type: \"volume\", tags: {}, stack_id: \"stk-feat-a\", depends_on: [] },\n    { id: \"old\", type: \"instance\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", depends_on: [\"net\", \"boot\"] },\n    // A similarly named stack is not part of this environment.\n    { id: \"other-stack\", type: \"network\", tags: {}, stack_id: \"stk-feat-a-v2\", depends_on: [] },\n    { id: \"custom-boot\", type: \"volume\", tags: {}, stack_id: \"custom-stack\", depends_on: [] },\n    ...Array.from({ length: 16 }, (_, i) => ({\n      id: `unrelated-${i}`, type: \"bucket\", tags: { branch: \"feat-b\" }, stack_id: null, depends_on: [],\n    })),\n    // Label-only resources must survive ingestion on every page. Values remain case-sensitive.\n    { id: \"new-boot\", type: \"volume\", labels: { Branch: \"feat-a\", Team: \"payments\" }, stack_id: null, depends_on: [] },\n    { id: \"new\", type: \"instance\", labels: { bRaNcH: \"feat-a\" }, stack_id: null, depends_on: [\"net\", \"new-boot\"] },\n    { id: \"custom\", type: \"instance\", labels: { BRANCH: \"feat-a\" }, stack_id: \"custom-stack\", depends_on: [\"custom-boot\"] },\n    { id: \"case-sensitive\", type: \"bucket\", labels: { Branch: \"Feat-A\" }, stack_id: null, depends_on: [] },\n    { id: \"tag-wins\", type: \"bucket\", tags: { branch: \"feat-b\" }, labels: { Branch: \"feat-a\" }, stack_id: null, depends_on: [] },\n  ].map((r) => ({ ...r, name: r.id, cost_month_cents: 100 }));\n}\n\ntest(\"CLI recognises labels across pages for list, plan, gc and safe teardown\", async () => {\n  let resources = fixture();\n  const deleted: string[] = [];\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    const send = (status: number, body: unknown) => {\n      res.writeHead(status);\n      res.end(JSON.stringify(body));\n    };\n    if (req.headers.authorization !== \"Bearer test-token\") return send(401, { error: \"unauthorised\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const start = Number(url.searchParams.get(\"cursor\") ?? 0);\n      const end = start + Math.min(Number(url.searchParams.get(\"limit\") ?? 20), 20);\n      return send(200, { resources: resources.slice(start, end), next_cursor: end < resources.length ? String(end) : null });\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter((r) => r.depends_on.includes(id));\n      if (dependents.length) return send(409, { error: \"resource has dependents\", dependents: dependents.map((r) => r.id) });\n      if (!resources.some((r) => r.id === id)) return send(404, { error: \"not found\" });\n      deleted.push(id);\n      resources = resources.filter((r) => r.id !== id);\n      return send(200, { deleted: id });\n    }\n    send(404, { error: \"not found\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address() as { port: number };\n  const run = (...args: string[]) => exec(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n    env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n  });\n  try {\n    const plan = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n    const expected = [\"net\", \"boot\", \"old\", \"new-boot\", \"new\", \"custom-boot\", \"custom\"].sort();\n    assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), expected);\n    assert.deepEqual(plan.blocked, []);\n    const order = plan.steps.map((r: { id: string }) => r.id);\n    for (const r of resources.filter((r) => expected.includes(r.id))) {\n  "]
[77.720745, "i", "    for (const dep of r.depends_on) assert.ok(order.indexOf(r.id) < order.indexOf(dep));\n    }\n    assert.match((await run(\"list\")).stdout, /feat-a\\s+5\\s/);\n    assert.match((await run(\"gc\", \"--untagged\")).stdout, /^3 untagged resources/);\n    await run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n    assert.deepEqual(deleted, []);\n\n    // A genuinely external dependent must still block teardown, with no partial deletes.\n    resources.push({ id: \"external\", name: \"external\", type: \"instance\", tags: { branch: \"feat-b\" }, stack_id: null, depends_on: [\"net\"], cost_month_cents: 100 });\n    const blocked = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n    assert.deepEqual(blocked.blocked, [{ id: \"net\", dependents: [\"external\"] }]);\n    await assert.rejects(run(\"teardown\", \"--branch\", \"feat-a\"), /refusing to tear down/);\n    assert.deepEqual(deleted, []);\n    resources = resources.filter((r) => r.id !== \"external\");\n\n    const unrelated = resources.filter((r) => !expected.includes(r.id));\n    assert.match((await run(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(7 resources\\)/);\n    assert.deepEqual([...deleted].sort(), expected);\n    assert.deepEqual(resources, unrelated);\n    const empty = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n    assert.deepEqual(empty.steps, []);\n    assert.deepEqual(empty.blocked, []);\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n  }\n});\nEOF\nnpm test\n"]
[77.72407, "o", "cat > test/cli.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> import { execFile } from \"node:child_process\";\r\n\u001b[?2004l\r\u001b[?2004h> import { createServer } from \"node:http\";\r\n\u001b[?2004l\r\u001b[?2004h> import { promisify } from \"node:util\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const exec = promisify(execFile);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function fixture() {\r\n\u001b[?2004l\r\u001b[?2004h>   return [\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"net\", type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"boot\", type: \"volume\", tags: {}, stack_id: \"stk-feat-a\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"old\", type: \"instance\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", depends_on: [\"net\", \"boot\"] },\r\n\u001b[?2004l\r\u001b[?2004h>     // A similarly named stack is not part of this environment.\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"other-stack\", type: \"network\", tags: {}, stack_id: \"stk-feat-a-v2\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"custom-boot\", type: \"volume\", tags: {}, stack_id: \"custom-stack\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     ...Array.from({ length: 16 }, (_, i) => ({\r\n\u001b[?2004l\r\u001b[?2004h>       id: `unrelated-${i}`, type: \"bucket\", tags: { branch: \"feat-b\" }, stack_id: null, depends_on: [],\r\n\u001b[?2004l\r\u001b[?2004h>     })),\r\n\u001b[?2004l\r\u001b[?2004h>     // Label-only resources must survive ingestion on every page. Values remain case-sensitive.\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"new-boot\", type: \"volume\", labels: { Branch: \"feat-a\", Team: \"payments\" }, stack_id: null, depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"new\", type: \"instance\", labels: { bRaNcH: \"feat-a\" }, stack_id: null, depends_on: [\"net\", \"new-boot\"] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"custom\", type: \"instance\", labels: { BRANCH: \"feat-a\" }, stack_id: \"custom-stack\", depends_on: [\"custom-boot\"] },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.726257, "o", "    { id: \"case-sensitive\", type: \"bucket\", labels: { Branch: \"Feat-A\" }, stack_id: null, depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"tag-wins\", type: \"bucket\", tags: { branch: \"feat-b\" }, labels: { Branch: \"feat-a\" }, stack_id: null, depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>   ].map((r) => ({ ...r, name: r.id, cost_month_cents: 100 }));\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"CLI recognises labels across pages for list, plan, gc and safe teardown\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h>   let resources = fixture();\r\n\u001b[?2004l\r\u001b[?2004h>   const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h>     const send = (status: number, body: unknown) => {\r\n\u001b[?2004l\r\u001b[?2004h>       res.writeHead(status);\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify(body));\r\n\u001b[?2004l\r\u001b[?2004h>     };\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.headers.authorization !== \"Bearer test-token\") return send(401, { error: \"unauthorised\" });\r\n\u001b[?2004l\r\u001b[?2004h>     const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {"]
[77.732751, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.732859, "o", "      const start = Number(url.searchParams.get(\"cursor\") ?? 0);\r\n\u001b[?2004l\r\u001b[?2004h>       const end = start + Math.min(Number(url.searchParams.get(\"limit\") ?? 20), 20);\r\n\u001b[?2004l\r\u001b[?2004h>       return send(200, { resources: resources.slice(start, end), next_cursor: end < resources.length ? String(end) : null });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"DELETE\") {\r\n\u001b[?2004l\r\u001b[?2004h>       const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\r\n\u001b[?2004l\r\u001b[?2004h>       const dependents = resources.filter((r) => r.depends_on.includes(id));\r\n\u001b[?2004l\r\u001b[?2004h>       if (dependents.length) return send(409, { error: \"resource has dependents\", dependents: dependents.map((r) => r.id) });\r\n\u001b[?2004l\r\u001b[?2004h>       if (!resources.some((r) => r.id === id)) return send(404, { error: \"not found\" });\r\n\u001b[?2004l\r\u001b[?2004h>       deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h>       resources = resources.filter((r) => r.id !== id);\r\n\u001b[?2004l\r\u001b[?2004h>       return send(200, { deleted: id });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     send(404, { error: \"not found\" });\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h>   const address = server.address() as { port: number };\r\n\u001b[?2004l\r\u001b[?2004h>   const run = (...args: string[]) => exec(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\r\n\u001b[?2004l\r\u001b[?2004h>     env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   try {\r\n\u001b[?2004l\r\u001b[?2004h>     const plan = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\r\n\u001b[?2004l\r\u001b[?2004h>     const expected = [\"net\", \"boot\", \"old\", \"new-boot\", \"new\", \"custom-boot\", \"custom\"].sort();\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), expected);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>     const order = plan.steps.map((r: { id: string }) => r.id);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const r of resources.filter((r) => expected.includes(r.id))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.73321, "o", "      for (const dep of r.depends_on) assert.ok(order.indexOf(r.id) < order.indexOf(dep));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.733354, "o", "    assert.match((await run(\"list\")).stdout, /feat-a\\s+5\\s/);\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.733526, "o", "> "]
[77.733674, "o", "    assert.match((await run(\"gc\", \"--untagged\")).stdout, /^3 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.733807, "o", "    await run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[77.733918, "o", "\u001b[?2004h> "]
[77.734206, "o", "    // A genuinely external dependent must still block teardown, with no partial deletes.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.734324, "o", "    resources.push({ id: \"external\", name: \"external\", type: \"instance\", tags: { branch: \"feat-b\" }, stack_id: null, depends_on: [\"net\"], cost_month_cents: 100 });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.734533, "o", "    const blocked = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.734684, "o", "    assert.deepEqual(blocked.blocked, [{ id: \"net\", dependents: [\"external\"] }]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.734805, "o", "    await assert.rejects(run(\"teardown\", \"--branch\", \"feat-a\"), /refusing to tear down/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.734923, "o", "    assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.73506, "o", "    resources = resources.filter((r) => r.id !== \"external\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[77.73515, "o", "> "]
[77.735174, "o", "    const unrelated = resources.filter((r) => !expected.includes(r.id));\r\n\u001b[?2004l\r"]
[77.735303, "o", "\u001b[?2004h> "]
[77.735453, "o", "    assert.match((await run(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(7 resources\\)/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.735617, "o", "    assert.deepEqual([...deleted].sort(), expected);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(resources, unrelated);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.735991, "o", "    const empty = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.7361, "o", "    assert.deepEqual(empty.steps, []);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.736209, "o", "    assert.deepEqual(empty.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[77.736289, "o", "  } finally {\r\n\u001b[?2004l\r\u001b[?2004h"]
[77.736321, "o", "> "]
[77.736519, "o", "    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[77.736653, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
