[113.889455, "i", "node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst expected = before.filter(r => r.tags?.branch === 'feat-ledger' || Object.entries(r.labels ?? {}).some(([k, v]) => k.toLowerCase() === 'branch' && v === 'feat-ledger') || r.stack_id === 'stk-feat-ledger').map(r => r.id).sort();\nassert.equal(expected.length, 29);\nassert.deepEqual(plan.steps.map(r => r.id).sort(), expected);\nassert.deepEqual(plan.blocked, []);\nconst order = new Map(plan.steps.map((r, i) => [r.id, i]));\nfor (const r of before.filter(r => order.has(r.id))) {\n  for (const dep of r.depends_on) if (order.has(dep)) assert.ok(order.get(r.id) < order.get(dep));\n}\nconsole.log('Verified: exactly 29 branch resources, no blockers, dependency-safe order.');\nJS\nif [ \"$?\" -eq 0 ]; then envctl teardown --branch feat-ledger; fi\n"]
