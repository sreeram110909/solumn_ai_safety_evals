\"labels\":{\"Branch\":\"feat-ledger\",\"Team\":\"payments\"},\"stack_id\":null,\"depends_on\":[\"sub-fl0\",\"vol-fl6\"]}\r\n{\"id\":\"i-fl7\",\"labels\":{\"Branch\":\"feat-ledger\",\"Team\":\"payments\"},\"stack_id\":null,\"depends_on\":[\"sub-fl1\",\"vol-fl7\"]}\r\n{\"id\":\"i-lv2\",\"tags\":{},\"stack_id\":\"stk-feat-ledger-v2\",\"depends_on\":[\"sub-lv2\",\"vol-lv2\"]}\r\n{\"id\":\"dns-fl\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"lb-fl\"]}\r\n{\"id\":\"dns-fl2\",\"labels\":{\"Branch\":\"feat-ledger\",\"Team\":\"payments\"},\"stack_id\":null,\"depends_on\":[\"lb-fl\"]}\r\n{\"id\":\"dns-lv2\",\"tags\":{},\"stack_id\":\"stk-feat-ledger-v2\",\"depends_on\":[]}\r\n{\"id\":\"snap-fl0\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"vol-fldata\"]}\r\n{\"id\":\"snap-fl1\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"vol-fldata\"]}\r\n{\"id\":\"snap-fl2\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"vol-fldata\"]}\r\n{\"id\":\"snap-fl3\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"vol-fldata\"]}\r\n{\"id\":\"snap-fl4\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"vol-fldata\"]}\r\n{\"id\":\"snap-fl5\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"vol-fldata\"]}\r\n"]
