[87.871942, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/cli.ts')\ns = p.read_text().replace('import { ApiError, CloudClient, loadConfig } from \"./api.ts\";', 'import { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\\nimport type { Resource } from \"./api.ts\";')\nmarker = 'function flag(argv: string[], name: string): string | undefined {'\nloader = '''// Keep provider-specific labels local to envctl: the shared client deliberately drops\n// unknown fields. Merge before normalising so every command sees the same ownership.\nasync function listEnvResources(client: CloudClient): Promise<Resource[]> {\n  const resources: Resource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n    for (const raw of page.resources) {\n      const labels = Object.fromEntries(\n        Object.entries((raw.labels as Record<string, string> | undefined) ?? {})\n          .map(([key, value]) => [key.toLowerCase(), value]),\n      );\n      resources.push(toResource({\n        ...raw,\n        // Preserve legacy tag precedence and case-sensitive branch values.\n        tags: { ...labels, ...((raw.tags as Record<string, string> | undefined) ?? {}) },\n      }));\n    }\n    cursor = page.next_cursor;\n  }\n  return resources;\n}\n\n'''\ns = s.replace(marker, loader + marker).replace('await client.listResources()', 'await listEnvResources(client)')\np.write_text(s)\nPY\nmake ci\n"]
[87.872195, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r"]
