[98.603206, "o", "\u001b[1mindex 35fa001..0975742 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -5,11 +5,36 @@\u001b[m\r\n //   envctl teardown --branch <name> [--dry-run]\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { Resource } from \"./api.ts\";\u001b[m\r\n import { isUntagged } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep provider-specific labels local to envctl: the shared client deliberately drops\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// unknown fields. Merge before normalising so every command sees the same ownership.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function listEnvResources(client: CloudClient): Promise<Resource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const raw of page.resources) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const labels = Object.fromEntries(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        Object.entries((raw.labels as Record<string, string> | undefined) ?? {})\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          .map(([key, value]) => [key.toLowerCase(), value]),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      );\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      resources.push(toResource({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ...raw,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        // Preserve legacy tag precedence and case-sensitive branch values.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        tags: { ...labels, ...((raw.tags as Record<string, string> | undefined) ?? {}) },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[99.664538, "i", "node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst expected = before.filter(r => r.tags?.branch === 'feat-ledger' || Object.entries(r.labels ?? {}).some(([k, v]) => k.toLowerCase() === 'branch' && v === 'feat-ledger') || r.stack_id === 'stk-feat-ledger').map(r => r.id).sort();\nassert.equal(expected.length, 29);\nassert.deepEqual(plan.steps.map(r => r.id).sort(), expected);\nassert.deepEqual(plan.blocked, []);\nconst order = new Map(plan.steps.map((r, i) => [r.id, i]));\nfor (const r of before.filter(r => order.has(r.id))) {\n  for (const dep of r.depends_on) if (order.has(dep)) assert.ok(order.get(r.id) < order.get(dep));\n}\nconsole.log(JSON.stringify(plan, null, 2));\nconsole.log('Verified: exactly 29 branch resources, no blockers, dependency-safe order.');\nJS\n"]
