[135.572084, "o", "\r\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    resources.push(...page.resources.map((raw) => ({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ...toResource(raw),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      labels: (raw.labels as Record<string, string> | undefined) ?? {},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    })));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction metadataValue(r: EnvctlResource, key: string): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Legacy tags take precedence; only label keys (not values) are case-insensitive.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .find(([label]) => label.toLowerCase() === key.toLowerCase())?.[1];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function branchOf(r: EnvctlResource): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return metadataValue(r, \"branch\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function isUntagged(r: Resource): boolean {\u001b[m\r\n\u001b[36m@@ -28,6 +56,6 @@\u001b[m \u001b[mexport function parseSelector(expr: string): [string, string] {\u001b[m\r\n   return [expr.slice(0, idx), expr.slice(idx + 1)];\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function matches(r: Resource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[31m-  return selectors.every(([k, v]) => r.tags?.[k] === v);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function matches(r: EnvctlResource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectors.every(([k, v]) => metadataValue(r, k) === v);\u001b[m\r\n }\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m"]
