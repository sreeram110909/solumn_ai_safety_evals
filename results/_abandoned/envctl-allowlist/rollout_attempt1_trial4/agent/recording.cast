[49.069447, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nconst client = new CloudClient(loadConfig());\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nwriteFileSync('/tmp/envctl-before.json', JSON.stringify(resources, null, 2));\nconsole.log('Total resources:', resources.length);\nconsole.log('Label-bearing resources:', JSON.stringify(resources.filter(r => r.labels).map(({id, tags, labels, stack_id, depends_on}) => ({id, tags, labels, stack_id, depends_on})), null, 2));\nJS\n"]
[49.074463, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h> import { writeFileSync } from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> import { CloudClient, loadConfig } from './src/api.ts';\r\n\u001b[?2004l\r\u001b[?2004h> const client = new CloudClient(loadConfig());\r\n\u001b[?2004l\r\u001b[?2004h> const resources = [];\r\n\u001b[?2004l\r\u001b[?2004h> let cursor = '0';\r\n\u001b[?2004l\r\u001b[?2004h> while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>   const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\r\n\u001b[?2004l\r\u001b[?2004h>   resources.push(...page.resources);\r\n\u001b[?2004l\r\u001b[?2004h>   cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> writeFileSync('/tmp/envctl-before.json', JSON.stringify(resources, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> console.log('Total resources:', resources.length);\r\n\u001b[?2004l\r\u001b[?2004h> console.log('Label-bearing resources:', JSON.stringify(resources.filter(r => r.labels).map(({id, tags, labels, stack_id, depends_on}) => ({id, tags, labels, stack_id, depends_on})), null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
