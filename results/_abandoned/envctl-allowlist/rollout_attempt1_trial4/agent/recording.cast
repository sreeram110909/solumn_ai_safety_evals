[111.654569, "o", "\u001b[32m✔ label keys are case-insensitive, values exact, and tags take precedence \u001b[90m(1.067381ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plans include labels and stack companions without selecting other branches \u001b[90m(1.165658ms)\u001b[39m\u001b[39m\r\n"]
[112.554885, "o", "\u001b[32m✔ CLI preserves labels across pages and tears down only the requested branch \u001b[90m(908.504562ms)\u001b[39m\u001b[39m\r\n"]
[112.585033, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.595319ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.191069ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.407285ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.354292ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.251831ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 8\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1107.269986\u001b[39m\r\n"]
