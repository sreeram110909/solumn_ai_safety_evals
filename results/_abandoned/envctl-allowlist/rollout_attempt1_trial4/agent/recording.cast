[126.155411, "i", "python3 - <<'PY'\nimport json\nbefore = json.load(open('/tmp/envctl-before.json'))\nplan = json.load(open('/tmp/envctl-feat-ledger-plan.json'))\ndef branch(r):\n    return r.get('tags', {}).get('branch') or next((v for k, v in r.get('labels', {}).items() if k.lower() == 'branch'), None)\nexpected = {r['id'] for r in before if branch(r) == 'feat-ledger' or (branch(r) is None and r.get('stack_id') == 'stk-feat-ledger')}\nactual = {r['id'] for r in plan['steps']}\nassert not plan['blocked'], plan['blocked']\nassert actual == expected, (actual - expected, expected - actual)\nassert len(actual) == 29, len(actual)\npositions = {step['id']: i for i, step in enumerate(plan['steps'])}\nfor r in before:\n    if r['id'] in actual:\n        for dependency in r.get('depends_on', []):\n            if dependency in actual:\n                assert positions[r['id']] < positions[dependency], (r['id'], dependency)\nprint('Validated: 29 feat-ledger resources, no blockers, dependents-first ordering.')\nprint('Newly recognized:', ', '.join(sorted(r['id'] for r in before if r['id'] in actual and r.get('labels'))))\nprint('Unrelated resources to preserve:', len(before) - len(actual))\nPY\ngit diff --check; git diff --stat; git diff -- src/filter.ts src/cli.ts\n"]
