[111.036841, "o", "import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> import { execFile } from \"node:child_process\";\r\n\u001b[?2004l\r\u001b[?2004h> import { createServer } from \"node:http\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { promisify } from \"node:util\";\r\n\u001b[?2004l\r\u001b[?2004h> import { branchOf, byBranch, isUntagged, matches } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import type { EnvctlResource } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildPlan } from \"../src/plan.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function resource(id: string, extra: Partial<EnvctlResource> = {}): EnvctlResource {\r\n\u001b[?2004l\r\u001b[?2004h>   return {\r\n\u001b[?2004l\r\u001b[?2004h>     id, type: \"instance\", name: id, tags: {}, stack_id: null,\r\n\u001b[?2004l\r\u001b[?2004h>     depends_on: [], cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\",\r\n\u001b[?2004l\r\u001b[?2004h>     ...extra,\r\n\u001b[?2004l\r\u001b[?2004h>   };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"label keys are case-insensitive, values exact, and tags take precedence\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const key of [\"branch\", \"Branch\", \"BRANCH\", \"bRaNcH\"]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const r = resource(\"cdk\", { labels: { [key]: \"feat-a\", Team: \"Payments\" } });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(branchOf(r), \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(isUntagged(r), false);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(byBranch([r]).get(\"feat-a\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.ok(matches(r, [[\"branch\", \"feat-a\"], [\"team\", \"Payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.ok(!matches(r, [[\"branch\", \"FEAT-A\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.ok(!matches(r, [[\"team\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(resource(\"legacy\", {\r\n\u001b[?2004l\r\u001b[?2004h>     tags: { branch: \"feat-legacy\" }, labels: { Branch: \"feat-other\" },\r\n\u001b[?2004l\r\u001b[?2004h>   })), \"feat-legacy\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(resource(\"none\")), undefined);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(isUntagged(resource(\"none\")), true);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(isUntagged(resource(\"team-only\", { labels: { Team: \"payments\" } })), true);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"plans include labels and stack companions without selecting other branches\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"volume\", { stack_id: \"stk-cdk-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"instance\", { labels: { Branch: \"feat-a\" }, stack_id: \"stk-cdk-a\", depends_on: [\"network\", \"volume\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"dns\", { labels: { BRANCH: \"feat-a\" }, depends_on: [\"instance\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"boot\", { stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"prefix\", { stack_id: \"stk-feat-a-v2\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"other-label\", { labels: { Branch: \"feat-other\" }, stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"other-tag\", { tags: { branch: \"feat-other\" }, stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"different-case\", { labels: { Branch: \"FEAT-A\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"orphan\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan(resources, \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map(r => r.id).sort(), [\"boot\", \"dns\", \"instance\", \"network\", \"volume\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   const pos = (id: string) => plan.steps.findIndex(r => r.id === id);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(pos(\"dns\") < pos(\"instance\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(pos(\"instance\") < pos(\"network\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(pos(\"instance\") < pos(\"volume\"));\r\n\u001b[?2004l\r\u001b[?2004h>   const external = resource(\"external\", { labels: { Branch: \"feat-other\" }, depends_on: [\"network\"] });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[111.037238, "o", "  assert.deepEqual(buildPlan([...resources, external], \"feat-a\").blocked,\r\n\u001b[?2004l\r"]
[111.037688, "o", "\u001b[?2004h> "]
[111.037845, "o", "    [{ id: \"network\", dependents: [\"external\"] }]);"]
[111.037965, "o", "\r\n"]
[111.038056, "o", "\u001b[?2004l\r"]
[111.038159, "o", "\u001b[?2004h"]
[111.038243, "o", "> "]
[111.038332, "o", "});"]
[111.038701, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
