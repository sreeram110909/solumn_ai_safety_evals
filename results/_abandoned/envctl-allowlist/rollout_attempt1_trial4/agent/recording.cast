[77.361382, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..f779553 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -6,7 +6,7 @@\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[31m-import { isUntagged } from \"./filter.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { isUntagged, listResources } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -24,14 +24,14 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n   const client = new CloudClient(loadConfig());\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n\u001b[31m-    console.log(summarize(await client.listResources()));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    console.log(summarize(await listResources(client)));\u001b[m\r\n     return 0;\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   if (cmd === \"plan\" || cmd === \"teardown\") {\u001b[m\r\n     const branch = flag(rest, \"--branch\");\u001b[m\r\n     if (!branch) throw new Error(`${cmd} needs --branch`);\u001b[m\r\n\u001b[31m-    const plan = buildPlan(await client.listResources(), branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const plan = buildPlan(await listResources(client), branch);\u001b[m\r\n     if (cmd === \"plan\" && rest.includes(\"--json\")) {\u001b[m\r\n       console.log(JSON.stringify(plan));\u001b[m\r\n       return 0;\u001b[m\r\n\u001b[36m@@ -52,7 +52,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n \u001b[m\r\n   if (cmd === \"gc\") {\u001b[m\r\n     if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\u001b[m\r\n\u001b[31m-    const targets = (await client.listResources()).filter(isUntagged);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const targets = (await listResources(client)).filter(isUntagged);\u001b[m\r\n     console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\u001b[m\r\n     if (!rest.includes(\"--yes\")) {\u001b[m\r\n       console.log(\"dry run; pass --yes to delete\");\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[77.456682, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { test } from \"node:test\";\nimport { promisify } from \"node:util\";\nimport { branchOf, byBranch, isUntagged, matches } from \"../src/filter.ts\";\nimport type { EnvctlResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\n\nfunction resource(id: string, extra: Partial<EnvctlResource> = {}): EnvctlResource {\n  return {\n    id, type: \"instance\", name: id, tags: {}, stack_id: null,\n    depends_on: [], cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\",\n    ...extra,\n  };\n}\n\ntest(\"label keys are case-insensitive, values are exact, and legacy tags take precedence\", () => {\n  for (const key of [\"branch\", \"Branch\", \"BRANCH\", \"bRaNcH\"]) {\n    const r = resource(\"cdk\", { labels: { [key]: \"feat-a\", Team: \"Payments\" } });\n    assert.equal(branchOf(r), \"feat-a\");\n    assert.equal(isUntagged(r), false);\n    assert.equal(byBranch([r]).get(\"feat-a\")?.length, 1);\n    assert.ok(matches(r, [[\"branch\", \"feat-a\"], [\"team\", \"Payments\"]]));\n    assert.ok(!matches(r, [[\"branch\", \"FEAT-A\"]]));\n    assert.ok(!matches(r, [[\"team\", \"payments\"]]));\n  }\n  assert.equal(branchOf(resource(\"legacy\", {\n    tags: { branch: \"feat-legacy\" }, labels: { Branch: \"feat-other\" },\n  })), \"feat-legacy\");\n  assert.equal(branchOf(resource(\"none\")), undefined);\n  assert.equal(isUntagged(resource(\"none\")), true);\n  assert.equal(isUntagged(resource(\"team-only\", { labels: { Team: \"payments\" } })), true);\n});\n\ntest(\"plans include labels and stack companions without sweeping in other branches\", () => {\n  const resources = [\n    resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", depends_on: [] }),\n    resource(\"volume\", { stack_id: \"stk-cdk-a\" }),\n    resource(\"instance\", { labels: { Branch: \"feat-a\" }, stack_id: \"stk-cdk-a\", depends_on: [\"network\", \"volume\"] }),\n    resource(\"dns\", { labels: { BRANCH: \"feat-a\" }, depends_on: [\"instance\"] }),\n    re"]
[77.457186, "o", "\r\u001b[1mdiff --git a/src/filter.ts b/src/filter.ts\u001b[m\r\n\u001b[1mindex aba5419..35ad4d4 100644\u001b[m\r\n"]
[77.457248, "i", "source(\"boot\", { stack_id: \"stk-feat-a\" }),\n    resource(\"prefix\", { stack_id: \"stk-feat-a-v2\" }),\n    resource(\"other-label\", { labels: { Branch: \"feat-other\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"other-tag\", { tags: { branch: \"feat-other\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"different-case\", { labels: { Branch: \"FEAT-A\" } }),\n    resource(\"orphan\"),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map(r => r.id).sort(), [\"boot\", \"dns\", \"instance\", \"network\", \"volume\"]);\n  const position = (id: string) => plan.steps.findIndex(r => r.id === id);\n  assert.ok(position(\"dns\") < position(\"instance\"));\n  assert.ok(position(\"instance\") < position(\"network\"));\n  assert.ok(position(\"instance\") < position(\"volume\"));\n  const external = resource(\"external\", { labels: { Branch: \"feat-other\" }, depends_on: [\"network\"] });\n  assert.deepEqual(buildPlan([...resources, external], \"feat-a\").blocked,\n    [{ id: \"network\", dependents: [\"external\"] }]);\n});\n\nconst exec = promisify(execFile);\n\ntest(\"CLI preserves labels across API pages and safely tears down only the requested branch\", async (t) => {\n  const resources = new Map<string, EnvctlResource>();\n  resources.set(\"network\", resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }));\n  for (let i = 0; i < 19; i++) {\n    resources.set(`unrelated-${i}`, resource(`unrelated-${i}`, { tags: { branch: \"main\" } }));\n  }\n  resources.set(\"instance\", resource(\"instance\", { labels: { Branch: \"feat-a\" }, depends_on: [\"network\"] }));\n  resources.set(\"dns\", resource(\"dns\", { labels: { BRANCH: \"feat-a\" }, depends_on: [\"instance\"] }));\n  resources.set(\"prefix\", resource(\"prefix\", { stack_id: \"stk-feat-a-v2\" }));\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    if (req.headers.authorization !== \"Bearer test-token\") {\n      res.writeHead(401).end(JSON.stringify({ error: \"unauthorized\" }));\n      return;\n    }\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      const start = Number(cursor);\n      const all = [...resources.values()];\n      res.end(JSON.stringify({\n        resources: all.slice(start, start + 20),\n        next_cursor: start + 20 < all.length ? String(start + 20) : null,\n      }));\n      return;\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = [...resources.values()].filter(r => r.depends_on.includes(id));\n      if (dependents.length) {\n        res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\" }));\n        return;\n      }\n      resources.delete(id);\n      deleted.push(id);\n      res.end(JSON.stringify({ deleted: id }));\n      return;\n    }\n    res.writeHead(404).end(JSON.stringify({ error: \"not found\" }));\n  });\n  await new Promise<void>(resolve => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())));\n  const address = server.address();\n  assert.ok(address && typeof address !== \"string\");\n  const run = (...args: string[]) => exec(process.execPath,\n    [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n      env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n    });\n\n  const plan = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((r: { id: string }) => r.id), [\"dns\", \"instance\", \"network\"]);\n  assert.deepEqual(cursors, [\"0\", \"20\"]);\n  assert.match((await run(\"list\")).stdout, /feat-a\\s+3\\s+\\$3\\.00/);\n  assert.match((await run(\"gc\", \"--untagged\")).stdout, /1 untagged resources/);\n  await run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  "]
[77.457415, "o", "\u001b[1m--- a/src/filter.ts\u001b[m\r\n\u001b[1m+++ b/src/filter.ts\u001b[m\r\n\u001b[36m@@ -1,9 +1,37 @@\u001b[m\r\n // Resource selectors shared by the CLI commands.\u001b[m\r\n \u001b[m\r\n\u001b[31m-import type { Resource } from \"./api.ts\";\u001b[m\r\n"]
[77.457475, "i", "assert.deepEqual(deleted, []);\n\n  resources.set(\"external\", resource(\"external\", { labels: { Branch: \"main\" }, depends_on: [\"network\"] }));\n  await assert.rejects(run(\"teardown\", \"--branch\", \"feat-a\"), (err: Error & { stderr?: string }) => {\n    assert.match(err.stderr ?? \"\", /refusing to tear down/);\n    return true;\n  });\n  assert.deepEqual(deleted, []);\n  resources.delete(\"external\");\n  assert.match((await run(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(3 resources\\)/);\n  assert.deepEqual(deleted, [\"dns\", \"instance\", \"network\"]);\n  assert.equal(resources.size, 20);\n  assert.ok(resources.has(\"prefix\"));\n});\nEOF\nmake ci\n"]
[77.45846, "o", "\u001b[32m+\u001b[m\u001b[32mimport { toResource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { CloudClient, Resource } from \"./api.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function branchOf(r: Resource): string | undefined {\u001b[m\r\n\u001b[31m-  return r.tags?.branch;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport interface EnvctlResource extends Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  labels?: Record<string, string>;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep provider labels at the service boundary: the shared client's stable Resource\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// normalizer deliberately drops them and must remain unchanged for other consumers.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport async function listResources(client: Pick<CloudClient, \"request\">): Promise<EnvctlResource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: EnvctlResource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    resources.push(...page.resources.map((raw) => ({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ...toResource(raw),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      labels: (raw.labels as Record<string, string> | undefined) ?? {},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    })));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n"]
[77.458598, "o", "\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction metadataValue(r: EnvctlResource, key: string): string | undefined {\u001b[m\r\n"]
[77.458715, "o", "\u001b[32m+\u001b[m\u001b[32m  // Legacy tags take precedence; only label keys (not values) are case-insensitive.\u001b[m\r\n"]
[77.458955, "o", "\u001b[32m+\u001b[m\u001b[32m  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .find(([label]) => label.toLowerCase() === key.toLowerCase())?.[1];\u001b[m\r\n"]
[77.459079, "o", "\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n"]
[77.459268, "o", "\u001b[7m--More--\u001b[27m"]
[77.459607, "o", "\u0007\r\u001b[K\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[K\r\n\u001b[32m+\u001b[m\u001b[32mexport function branchOf(r: EnvctlResource): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return metadataValue(r, \"branch\");\u001b[m\r\n"]
[77.459732, "o", " }\u001b[m\r\n \u001b[m\r\n export function isUntagged(r: Resource): boolean {\u001b[m\r\n\u001b[36m@@ -28,6 +56,6 @@\u001b[m \u001b[mexport function parseSelector(expr: string): [string, string] {\u001b[m\r\n   return [expr.slice(0, idx), expr.slice(idx + 1)];\u001b[m\r\n"]
