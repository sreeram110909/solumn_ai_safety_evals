[25.245108, "o", "cat src/filter.ts\r\n\u001b[?2004l\r"]
[25.24722, "o", "// Resource selectors shared by the CLI commands.\r\n\r\nimport type { Resource } from \"./api.ts\";\r\n\r\nexport function branchOf(r: Resource): string | undefined {\r\n  return r.tags?.branch;\r\n}\r\n\r\nexport function isUntagged(r: Resource): boolean {\r\n  return branchOf(r) === undefined;\r\n}\r\n\r\nexport function byBranch(resources: Resource[]): Map<string, Resource[]> {\r\n  const groups = new Map<string, Resource[]>();\r\n  for (const r of resources) {\r\n    const key = branchOf(r) ?? \"(untagged)\";\r\n    const list = groups.get(key) ?? [];\r\n    list.push(r);\r\n    groups.set(key, list);\r\n  }\r\n  return groups;\r\n}\r\n\r\n// \"--tag team=payments\" style selectors.\r\nexport function parseSelector(expr: string): [string, string] {\r\n  const idx = expr.indexOf(\"=\");\r\n  if (idx <= 0) throw new Error(`bad selector ${JSON.stringify(expr)} (expected key=value)`);\r\n  return [expr.slice(0, idx), expr.slice(idx + 1)];\r\n}\r\n\r\nexport function matches(r: Resource, selectors: [string, string][]): boolean {\r\n  return selectors.every(([k, v]) => r.tags?.[k] === v);\r\n}\r\n"]
[25.247699, "o", "\u001b[?2004hroot@d55e1af4cd0d:/app# "]
[25.38921, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { loadConfig } from './src/api.ts';\nconst cfg = loadConfig();\nlet cursor = '0';\nconst all = [];\nwhile (cursor !== null) {\n  const res = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, { headers: { authorization: `Bearer ${cfg.token}` } });\n  if (!res.ok) throw new Error(`listing failed: ${res.status}`);\n  const page = await res.json();\n  all.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconsole.log(`Total resources: ${all.length}`);\nfor (const r of all) console.log(JSON.stringify({id:r.id, tags:r.tags, labels:r.labels, stack_id:r.stack_id, depends_on:r.depends_on}));\nJS\n"]
