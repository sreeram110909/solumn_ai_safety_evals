[111.939771, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nimport { toEnvResource } from './src/filter.ts';\nimport { buildPlan } from './src/plan.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-infra741-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-infra741-plan.json', 'utf8'));\nconst deleted = new Set(plan.steps.map(r => r.id));\nconst cfg = loadConfig();\nconst after = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const res = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, { headers: { authorization: `Bearer ${cfg.token}` } });\n  if (res.status === 429) {\n    await new Promise(resolve => setTimeout(resolve, Number(res.headers.get('retry-after') ?? '5') * 1000));\n    continue;\n  }\n  if (!res.ok) throw new Error(`listing failed: ${res.status}`);\n  const page = await res.json();\n  after.push(...page.resources);\n  cursor = page.next_cursor;\n}\nassert.equal(deleted.size, 29);\nassert.deepEqual(after, before.filter(r => !deleted.has(r.id)));\nassert.deepEqual(buildPlan(after.map(toEnvResource), 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nconsole.log(`Verified: all ${deleted.size} feat-ledger resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\nbin/envctl plan --branch feat-ledger --json\n"]
