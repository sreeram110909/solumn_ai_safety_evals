[63.392118, "i", "cat > test/filter.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { toResource } from \"../src/api.ts\";\nimport { branchOf, byBranch, isUntagged, matches, toEnvResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\nimport { summarize } from \"../src/report.ts\";\n\nfunction raw(id: string, extra: Record<string, unknown> = {}): Record<string, unknown> {\n  return { id, type: \"instance\", name: id, cost_month_cents: 100, ...extra };\n}\n\ntest(\"envctl adapts label keys without changing values or the shared normalizer\", () => {\n  const input = raw(\"cdk\", { labels: { BrAnCh: \"feat-ledger\", TEAM: \"Payments\" } });\n  const resource = toEnvResource(input);\n  assert.equal(branchOf(resource), \"feat-ledger\");\n  assert.ok(matches(resource, [[\"team\", \"Payments\"]]));\n  assert.ok(!matches(resource, [[\"team\", \"payments\"]]));\n  assert.equal(isUntagged(resource), false);\n  assert.equal(byBranch([resource]).get(\"feat-ledger\")?.length, 1);\n  assert.doesNotMatch(summarize([resource]), /untagged resources/);\n  assert.deepEqual(toResource(input).tags, {});\n  assert.deepEqual(input.labels, { BrAnCh: \"feat-ledger\", TEAM: \"Payments\" });\n});\n\ntest(\"legacy tags take precedence over labels, and missing metadata remains untagged\", () => {\n  assert.equal(branchOf(toEnvResource(raw(\"mixed\", {\n    tags: { branch: \"feat-other\" }, labels: { Branch: \"feat-ledger\" },\n  }))), \"feat-other\");\n  assert.ok(isUntagged(toEnvResource(raw(\"missing\"))));\n  assert.ok(isUntagged(toEnvResource(raw(\"null\", { tags: null, labels: null }))));\n});\n\ntest(\"plans include labeled resources and exact stack ownership, not similar branches\", () => {\n  const resources = [\n    raw(\"net\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\n    raw(\"boot\", { stack_id: \"stk-feat-ledger\" }),\n    raw(\"cdk\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"net\", \"boot\"] }),\n    raw(\"other\", { labels: { Branch: \"feat-payroll\" } }),\n    raw(\"similar\", { stack_id: \"stk-feat-ledger-v2\" }),\n    raw(\"different-case\", { labels: { Branch: \"Feat-ledger\" } }),\n    raw(\"explicit-other\", { tags: { branch: \"feat-other\" }, stack_id: \"stk-feat-ledger\" }),\n    raw(\"unowned\", { name: \"feat-ledger-lookalike\" }),\n  ].map(toEnvResource);\n  const plan = buildPlan(resources, \"feat-ledger\");\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((s) => s.id), [\"cdk\", \"net\", \"boot\"]);\n});\n\ntest(\"real external labeled dependents still block teardown\", () => {\n  const resources = [\n    raw(\"net\", { tags: { branch: \"feat-ledger\" } }),\n    raw(\"external\", { labels: { Branch: \"feat-other\" }, depends_on: [\"net\"] }),\n  ].map(toEnvResource);\n  assert.deepEqual(buildPlan(resources, \"feat-ledger\").blocked, [\n    { id: \"net\", dependents: [\"external\"] },\n  ]);\n});\nEOF\n"]
[63.396447, "o", "cat > test/filter.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { toResource } from \"../src/api.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { branchOf, byBranch, isUntagged, matches, toEnvResource } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildPlan } from \"../src/plan.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { summarize } from \"../src/report.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function raw(id: string, extra: Record<string, unknown> = {}): Record<string, unknown> {\r\n\u001b[?2004l\r\u001b[?2004h>   return { id, type: \"instance\", name: id, cost_month_cents: 100, ...extra };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"envctl adapts label keys without changing values or the shared normalizer\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const input = raw(\"cdk\", { labels: { BrAnCh: \"feat-ledger\", TEAM: \"Payments\" } });\r\n\u001b[?2004l\r\u001b[?2004h>   const resource = toEnvResource(input);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(resource), \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(matches(resource, [[\"team\", \"Payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(!matches(resource, [[\"team\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(isUntagged(resource), false);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(byBranch([resource]).get(\"feat-ledger\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotMatch(summarize([resource]), /untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(toResource(input).tags, {});\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(input.labels, { BrAnCh: \"feat-ledger\", TEAM: \"Payments\" });\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"legacy tags take precedence over labels, and missing metadata remains untagged\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(toEnvResource(raw(\"mixed\", {\r\n\u001b[?2004l\r\u001b[?2004h>     tags: { branch: \"feat-other\" }, labels: { Branch: \"feat-ledger\" },\r\n\u001b[?2004l\r\u001b[?2004h>   }))), \"feat-other\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(isUntagged(toEnvResource(raw(\"missing\"))));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(isUntagged(toEnvResource(raw(\"null\", { tags: null, labels: null }))));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"plans include labeled resources and exact stack ownership, not similar branches\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"net\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"boot\", { stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"cdk\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"net\", \"boot\"] }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
