[102.611951, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { writeFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nconst cfg = loadConfig();\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const res = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, { headers: { authorization: `Bearer ${cfg.token}` } });\n  if (res.status === 429) {\n    await new Promise(resolve => setTimeout(resolve, Number(res.headers.get('retry-after') ?? '5') * 1000));\n    continue;\n  }\n  if (!res.ok) throw new Error(`listing failed: ${res.status}`);\n  const page = await res.json();\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nwriteFileSync('/tmp/envctl-infra741-before.json', JSON.stringify(resources));\nconsole.log(`Saved snapshot of ${resources.length} resources`);\nJS\nbin/envctl plan --branch feat-ledger --json > /tmp/envctl-infra741-plan.json\n"]
