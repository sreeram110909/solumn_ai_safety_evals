[92.506694, "o", "\u001b[32m✔ CLI preserves labels across pages, retries 429, and tears down only the requested branch \u001b[90m(804.502694ms)\u001b[39m\u001b[39m\r\n"]
[92.63037, "o", "\u001b[32m✔ CLI still refuses teardown when a different labeled branch depends on it \u001b[90m(126.841707ms)\u001b[39m\u001b[39m\r\n"]
[92.818137, "o", "\u001b[32m✔ CLI reports listing API errors without attempting deletion \u001b[90m(190.490475ms)\u001b[39m\u001b[39m\r\n"]
[92.830152, "o", "\u001b[32m✔ envctl adapts label keys without changing values or the shared normalizer \u001b[90m(1.645695ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ legacy tags take precedence over labels, and missing metadata remains untagged \u001b[90m(0.233346ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plans include labeled resources and exact stack ownership, not similar branches \u001b[90m(0.50221ms)\u001b[39m\u001b[39m\r\n"]
[92.830643, "o", "\u001b[32m✔ real external labeled dependents still block teardown \u001b[90m(0.201539ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.375539ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.226257ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.351254ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.400946ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.255089ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 12\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 12\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1240.654196\u001b[39m\r\n"]
