[91.442589, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { test } from \"node:test\";\nimport type { TestContext } from \"node:test\";\nimport type { AddressInfo } from \"node:net\";\n\nasync function mockApi(t: TestContext, resources: Record<string, any>[], rateLimit = false, denied = false) {\n  const deleted: string[] = [];\n  const requests: { method: string; cursor: string | null; auth: string | undefined }[] = [];\n  const remaining = new Map(resources.map((r) => [r.id, r]));\n  const server = createServer((req, res) => {\n    const url = new URL(req.url!, \"http://localhost\");\n    requests.push({ method: req.method!, cursor: url.searchParams.get(\"cursor\"), auth: req.headers.authorization });\n    res.setHeader(\"content-type\", \"application/json\");\n    if (denied || req.headers.authorization !== \"Bearer test-token\") {\n      res.writeHead(403).end(JSON.stringify({ error: \"forbidden\" }));\n    } else if (rateLimit) {\n      rateLimit = false;\n      res.writeHead(429, { \"retry-after\": \"0\" }).end(JSON.stringify({ error: \"rate limited\" }));\n    } else if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const all = [...remaining.values()];\n      const start = url.searchParams.get(\"cursor\") === \"0\" ? 0 : 20;\n      res.end(JSON.stringify({\n        resources: all.slice(start, start + 20),\n        next_cursor: start + 20 < all.length ? \"page 2&more\" : null,\n      }));\n    } else if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = [...remaining.values()].filter((r) => (r.depends_on ?? []).includes(id));\n      if (dependents.length) {\n        res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\" }));\n      } else if (!remaining.delete(id)) {\n        res.writeHead(404).end(JSON.stringify({ error: \"not found\" }));\n      } else {\n        deleted.push(id);\n        res.end(JSON.stringify({ deleted: id }));\n      }\n    } else {\n      res.writeHead(404).end(\"{}\");\n    }\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => {\n    server.close((err) => err ? reject(err) : resolve());\n    server.closeAllConnections();\n  }));\n  const api = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\n  async function run(...args: string[]) {\n    const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n      env: { ...process.env, ENVCTL_API: api, ENVCTL_TOKEN: \"test-token\" },\n      stdio: [\"ignore\", \"pipe\", \"pipe\"], timeout: 10000,\n    });\n    let stdout = \"\", stderr = \"\";\n    child.stdout.on(\"data\", (data) => { stdout += data; });\n    child.stderr.on(\"data\", (data) => { stderr += data; });\n    return new Promise<{ code: number | null; stdout: string; stderr: string }>((resolve, reject) => {\n      child.on(\"error\", reject);\n      child.on(\"close\", (code) => resolve({ code, stdout, stderr }));\n    });\n  }\n  return { run, deleted, remaining, requests };\n}\n\nfunction raw(id: string, extra: Record<string, unknown> = {}) {\n  return { id, type: \"instance\", name: id, cost_month_cents: 100, ...extra };\n}\n\ntest(\"CLI preserves labels across pages, retries 429, and tears down only the requested branch\", async (t) => {\n  const resources = [\n    raw(\"net\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\n    raw(\"boot\", { stack_id: \"stk-feat-ledger\" }),\n    ...Array.from({ length: 20 }, (_, i) => raw(`other-${i}`, { tags: { branch: \"feat-ledger-v2\" } })),\n    raw(\"vol\", { labels: { BRANCH: \"feat-ledger\", Team: \"payments\" } }),\n    raw(\"app\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"net\", \"boot\", \"vol\"] }),\n    raw(\"dns\", { labels: { bRaNcH: \"feat-ledger\" }, depends_on: [\"app\"] }),\n    raw(\"payroll\", { labels: { Branch: \"feat-payroll\" } }),\n    raw(\"orphan\"),\n  ];\n  const api = await mockApi(t, resources, true);\n  const planResult = await api.run(\"plan\", \"--branch\", \"feat-ledge"]
[91.442654, "i", "r\", \"--json\");\n  assert.equal(planResult.code, 0, planResult.stderr);\n  assert.match(planResult.stderr, /rate limited/);\n  const plan = JSON.parse(planResult.stdout);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((s: { id: string }) => s.id), [\"dns\", \"app\", \"net\", \"boot\", \"vol\"]);\n  assert.ok(api.requests.some((r) => r.cursor === \"page 2&more\"));\n  assert.ok(api.requests.every((r) => r.auth === \"Bearer test-token\"));\n\n  const list = await api.run(\"list\");\n  assert.equal(list.code, 0, list.stderr);\n  assert.match(list.stdout, /feat-ledger\\s+4\\s/);\n  assert.match(list.stdout, /feat-payroll\\s+1\\s/);\n  const gc = await api.run(\"gc\", \"--untagged\");\n  assert.equal(gc.code, 0, gc.stderr);\n  assert.match(gc.stdout, /^2 untagged resources/);\n  const dryRun = await api.run(\"teardown\", \"--branch\", \"feat-ledger\", \"--dry-run\");\n  assert.equal(dryRun.code, 0, dryRun.stderr);\n  assert.deepEqual(api.deleted, []);\n\n  const teardown = await api.run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(teardown.code, 0, teardown.stderr);\n  assert.deepEqual(api.deleted, [\"dns\", \"app\", \"net\", \"boot\", \"vol\"]);\n  assert.equal(api.remaining.size, resources.length - 5);\n  assert.ok(api.remaining.has(\"payroll\") && api.remaining.has(\"orphan\") && api.remaining.has(\"other-0\"));\n});\n\ntest(\"CLI still refuses teardown when a different labeled branch depends on it\", async (t) => {\n  const api = await mockApi(t, [\n    raw(\"net\", { tags: { branch: \"feat-ledger\" } }),\n    raw(\"external\", { labels: { Branch: \"feat-payroll\" }, depends_on: [\"net\"] }),\n  ]);\n  const result = await api.run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(result.code, 1);\n  assert.match(result.stderr, /refusing to tear down/);\n  assert.match(result.stdout, /external.*outside this branch/);\n  assert.deepEqual(api.deleted, []);\n});\n\ntest(\"CLI reports listing API errors without attempting deletion\", async (t) => {\n  const api = await mockApi(t, [], false, true);\n  const result = await api.run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(result.code, 1);\n  assert.match(result.stderr, /403: forbidden/);\n  assert.deepEqual(api.deleted, []);\n});\nEOF\nmake ci\n"]
