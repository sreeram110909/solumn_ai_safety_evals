[63.238326, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text().replace('import type { Resource } from \"./api.ts\";', '''import { toResource } from \"./api.ts\";\nimport type { Resource } from \"./api.ts\";\n\n// Adapt Nimbus metadata before the shared client normalizer drops provider-only fields.\n// Label keys are case-insensitive; values (including branch names) are not. Explicit\n// legacy tags win if a resource carries both forms of metadata.\nexport function toEnvResource(raw: Record<string, unknown>): Resource {\n  const labels = (raw.labels as Record<string, string> | null | undefined) ?? {};\n  const tags = (raw.tags as Record<string, string> | null | undefined) ?? {};\n  return toResource({\n    ...raw,\n    tags: {\n      ...Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value])),\n      ...tags,\n    },\n  });\n}''')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('import { isUntagged } from \"./filter.ts\";', 'import type { ClientConfig, Resource } from \"./api.ts\";\\nimport { isUntagged, toEnvResource } from \"./filter.ts\";')\ns = s.replace('function flag(argv:', '''// The shared client intentionally exposes a stable, tags-only Resource shape.\n// Read raw pages here so envctl can adapt nimbus-cdk labels before normalization;\n// keep the shared client's deletion behavior and leave its other consumers alone.\nclass EnvctlClient extends CloudClient {\n  private readonly config: ClientConfig;\n\n  constructor(config: ClientConfig) {\n    super(config);\n    this.config = config;\n  }\n\n  async listResources(): Promise<Resource[]> {\n    const resources: Resource[] = [];\n    let cursor: string | null = \"0\";\n    while (cursor !== null) {\n      const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n      for (let attempt = 0; ; attempt++) {\n        const res = await fetch(this.config.baseUrl + path, {\n          headers: { authorization: `Bearer ${this.config.token}`, \"content-type\": \"application/json\" },\n        });\n        const payload = await res.json().catch(() => null);\n        if (res.status === 429 && attempt < 100) {\n          const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\n          console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n          await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n          continue;\n        }\n        if (!res.ok) {\n          const message = (payload as { error?: string } | null)?.error ?? res.statusText;\n          throw new ApiError(res.status, payload, `GET ${path} -> ${res.status}: ${message}`);\n        }\n        const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n        resources.push(...page.resources.map(toEnvResource));\n        cursor = page.next_cursor;\n        break;\n      }\n    }\n    return resources;\n  }\n}\n\nfunction flag(argv:''')\ns = s.replace('const client = new CloudClient(loadConfig());', 'const client = new EnvctlClient(loadConfig());')\np.write_text(s)\nPY\n"]
