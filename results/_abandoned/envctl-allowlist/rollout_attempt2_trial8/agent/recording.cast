[63.244659, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>           await new Promise((resolve) => setTimeout(resolve, wait * 1000));\r\n\u001b[?2004l\r\u001b[?2004h>           continue;\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         if (!res.ok) {\r\n\u001b[?2004l\r\u001b[?2004h>           const message = (payload as { error?: string } | null)?.error ?? res.statusText;\r\n\u001b[?2004l\r\u001b[?2004h>           throw new ApiError(res.status, payload, `GET ${path} -> ${res.status}: ${message}`);\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h>         const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\r\n\u001b[?2004l\r\u001b[?2004h>         resources.push(...page.resources.map(toEnvResource));\r\n\u001b[?2004l\r\u001b[?2004h>         cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>         break;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return resources;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function flag(argv:''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('const client = new CloudClient(loadConfig());', 'const client = new EnvctlClient(loadConfig());')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
