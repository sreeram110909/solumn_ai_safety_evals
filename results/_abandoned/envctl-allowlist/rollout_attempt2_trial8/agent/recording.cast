[111.942751, "o", "import { buildPlan } from './src/plan.ts';\r\n\u001b[?2004l\r\u001b[?2004h> const before = JSON.parse(readFileSync('/tmp/envctl-infra741-before.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const plan = JSON.parse(readFileSync('/tmp/envctl-infra741-plan.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const deleted = new Set(plan.steps.map(r => r.id));\r\n\u001b[?2004l\r\u001b[?2004h> const cfg = loadConfig();\r\n\u001b[?2004l\r\u001b[?2004h> const after = [];\r\n\u001b[?2004l\r\u001b[?2004h> let cursor = '0';\r\n\u001b[?2004l\r\u001b[?2004h> while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>   const res = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, { headers: { authorization: `Bearer ${cfg.token}` } }); \r\u001bM\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[C\u001b[K;\r\n\u001b[?2004l\r\u001b[?2004h>   if (res.status === 429) {\r\n\u001b[?2004l\r\u001b[?2004h>     await new Promise(resolve => setTimeout(resolve, Number(res.headers.get('retry-after') ?? '5') * 1000));\r\n\u001b[?2004l\r\u001b[?2004h>     continue;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (!res.ok) throw new Error(`listing failed: ${res.status}`);\r\n\u001b[?2004l\r\u001b[?2004h>   const page = await res.json();\r\n\u001b[?2004l\r\u001b[?2004h>   after.push(...page.resources);\r\n\u001b[?2004l\r\u001b[?2004h>   cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(deleted.size, 29);\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(after, before.filter(r => !deleted.has(r.id)));\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(buildPlan(after.map(toEnvResource), 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\r\n\u001b[?2004l\r\u001b[?2004h> "]
