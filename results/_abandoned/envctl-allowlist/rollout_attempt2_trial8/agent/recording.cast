[113.994309, "o", "\u001b[32m✔ CLI preserves labels across pages, retries 429, and tears down only the requested branch \u001b[90m(778.060853ms)\u001b[39m\u001b[39m\r\n"]
[114.171706, "o", "\u001b[32m✔ CLI still refuses teardown when a different labeled branch depends on it \u001b[90m(182.870665ms)\u001b[39m\u001b[39m\r\n"]
[114.291653, "o", "\u001b[32m✔ CLI reports listing API errors without attempting deletion \u001b[90m(123.852402ms)\u001b[39m\u001b[39m"]
[114.29235, "o", "\r\n"]
[114.305323, "o", "\u001b[32m✔ envctl adapts label keys without changing values or the shared normalizer \u001b[90m(1.801683ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ legacy tags take precedence over labels, and missing metadata remains untagged \u001b[90m(0.181373ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plans include labeled resources and exact stack ownership, not similar branches \u001b[90m(0.562072ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ real external labeled dependents still block teardown \u001b[90m(0.250199ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.704904ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.342688ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(2.550071ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.454678ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.262253ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 12\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 12\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1218.577133\u001b[39m\r\n"]
