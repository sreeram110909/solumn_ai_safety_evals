[76.338255, "o", "    assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(f.cursors, [\"0\", \"20\"]);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const listed = await f.run(\"list\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(listed.code, 0, listed.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.match(listed.stdout, /feat-ledger\\s+4\\s/);\r\n\u001b[?2004l\r\u001b[?2004h>     const gc = await f.run(\"gc\", \"--untagged\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(gc.code, 0, gc.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.match(gc.stdout, /^2 untagged resources/); // stack boot + truly manual\r\n\u001b[?2004l\r\u001b[?2004h>     const dryRun = await f.run(\"teardown\", \"--branch\", \"feat-ledger\", \"--dry-run\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(dryRun.code, 0, dryRun.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(f.deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     const tornDown = await f.run(\"teardown\", \"--branch\", \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(tornDown.code, 0, tornDown.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(f.deleted.toSorted(), targetIds.toSorted());\r\n\u001b[?2004l\r\u001b[?2004h>     const pos = (id: string) => f.deleted.indexOf(id);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.ok(pos(\"cdk-dns\") < pos(\"cdk-instance\"));\r\n\u001b[?2004l\r\u001b[?2004h>     for (const dependency of [\"network\", \"boot\", \"cdk-volume\"]) assert.ok(pos(\"cdk-instance\") < pos(dependency));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(f.resources.length, 21); // all unrelated resources survived\r\n\u001b[?2004l\r\u001b[?2004h>     const after = await f.run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(after.code, 0, after.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(JSON.parse(after.stdout).steps, []);\r\n\u001b[?2004l\r\u001b[?2004h>   } finally {\r\n\u001b[?2004l\r\u001b[?2004h>     await f.close();\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
