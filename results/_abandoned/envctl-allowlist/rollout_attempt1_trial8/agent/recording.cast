[91.178548, "o", "\u001b[36m@@ -1,6 +1,22 @@\u001b[m\r\n\u001b[31m-// Resource selectors shared by the CLI commands.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Provider metadata normalization and resource selectors for envctl.\u001b[m\r\n \u001b[m\r\n\u001b[31m-import type { Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { toResource, type Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// The shared client intentionally drops labels. Fold them into envctl's selector\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// metadata before conversion, without changing that client's stable contract.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Only label keys are case-insensitive; values and legacy tag keys are not.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Explicit tags take precedence if both formats supply the same key.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function resourceFromProvider(raw: Record<string, unknown>): Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const labels = (raw.labels ?? {}) as Record<string, string>;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const tags = (raw.tags ?? {}) as Record<string, string>;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return toResource({\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[32m    ...raw,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    tags: {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ...Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value])),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ...tags,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n \u001b[m\r\n export function branchOf(r: Resource): string | undefined {\u001b[m\r\n   return r.tags?.branch;\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"]
