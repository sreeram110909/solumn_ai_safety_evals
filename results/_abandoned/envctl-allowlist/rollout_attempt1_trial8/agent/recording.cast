[113.155573, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { readFileSync } from 'node:fs';\nimport assert from 'node:assert/strict';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { resourceFromProvider } from './src/filter.ts';\nimport { buildPlan } from './src/plan.ts';\nconst saved = JSON.parse(readFileSync(readFileSync('/tmp/envctl-infra741-inventory-path', 'utf8'), 'utf8'));\nconst client = new CloudClient(loadConfig());\nconst remaining = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  remaining.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconst targets = new Set(saved.plan.steps.map(s => s.id));\nassert.deepEqual(remaining, saved.resources.filter(r => !targets.has(r.id)));\nassert.deepEqual(buildPlan(remaining.map(resourceFromProvider), 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nconsole.log(`Verified: all ${targets.size} feat-ledger resources gone; all ${remaining.length} unrelated resources unchanged, including feat-ledger-v2.`);\nJS\n"]
