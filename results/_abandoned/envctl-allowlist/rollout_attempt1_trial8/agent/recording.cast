[116.257873, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..0c4c1b7 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -5,11 +5,26 @@\u001b[m\r\n"]
[116.257914, "o", " //   envctl teardown --branch <name> [--dry-run]\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[31m-import { isUntagged } from \"./filter.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, type Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { isUntagged, resourceFromProvider } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Read raw pages so envctl can retain CDK labels before the shared client's\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Resource conversion drops provider-specific fields. Keep request retries and\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// authentication in CloudClient, and follow every page before planning.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function listResources(client: CloudClient): Promise<Resource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    resources.push(...page.resources.map(resourceFromProvider));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m"]
[116.258214, "o", "\r\n\u001b[36m@@ -24,14 +39,14 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n   const client = new CloudClient(loadConfig());\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n\u001b[31m-    console.log(summarize(await client.listResources()));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    console.log(summarize(await listResources(client)));\u001b[m\r\n     return 0;\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   if (cmd === \"plan\" || cmd === \"teardown\") {\u001b[m\r\n     const branch = flag(rest, \"--branch\");\u001b[m\r\n     if (!branch) throw new Error(`${cmd} needs --branch`);\u001b[m\r\n\u001b[31m-    const plan = buildPlan(await client.listResources(), branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const plan = buildPlan(await listResources(client), branch);\u001b[m\r\n     if (cmd === \"plan\" && rest.includes(\"--json\")) {\u001b[m\r\n       console.log(JSON.stringify(plan));\u001b[m\r\n       return 0;\u001b[m\r\n\u001b[36m@@ -52,7 +67,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n \u001b[m\r\n   if (cmd === \"gc\") {\u001b[m\r\n     if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\u001b[m\r\n\u001b[31m-    const targets = (await client.listResources()).filter(isUntagged);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const targets = (await listResources(client)).filter(isUntagged);\u001b[m\r\n     console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\u001b[m\r\n     if (!rest.includes(\"--yes\")) {\u001b[m\r\n       console.log(\"dry run; pass --yes to delete\");\u001b[m\r\n"]
[116.258242, "o", "\u001b[1mdiff --git a/src/filter.ts b/src/filter.ts\u001b[m\r\n\u001b[1mindex aba5419..ca3a105 100644\u001b[m\r\n"]
[116.258362, "o", "\u001b[1m--- a/src/filter.ts\u001b[m\r\n\u001b[1m+++ b/src/filter.ts\u001b[m\r\n\u001b[36m@@ -1,6 +1,22 @@\u001b[m\r\n\u001b[31m-// Resource selectors shared by the CLI commands.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Provider metadata normalization and resource selectors for envctl.\u001b[m\r\n \u001b[m\r\n\u001b[31m-import type { Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { toResource, type Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m"]
[116.258741, "o", "\r\n\u001b[32m+\u001b[m\u001b[32m// The shared client intentionally drops labels. Fold them into envctl's selector\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// metadata before conversion, without changing that client's stable contract.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Only label keys are case-insensitive; values and legacy tag keys are not.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Explicit tags take precedence if both formats supply the same key.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function resourceFromProvider(raw: Record<string, unknown>): Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const labels = (raw.labels ?? {}) as Record<string, string>;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const tags = (raw.tags ?? {}) as Record<string, string>;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return toResource({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ...raw,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    tags: {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ...Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value])),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ...tags,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n \u001b[m\r\n export function branchOf(r: Resource): string | undefined {\u001b[m\r\n   return r.tags?.branch;\u001b[m\r\n"]
