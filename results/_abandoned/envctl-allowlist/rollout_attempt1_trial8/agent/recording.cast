[91.355245, "o", "\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, type Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { isUntagged, resourceFromProvider } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Read raw pages so envctl can retain CDK labels before the shared client's\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Resource conversion drops provider-specific fields. Keep request retries and\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// authentication in CloudClient, and follow every page before planning.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function listResources(client: CloudClient): Promise<Resource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: Resource[] = [];\u001b[m\r\n"]
[91.355271, "o", "\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n"]
[91.355439, "o", "\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    resources.push(...page.resources.map(resourceFromProvider));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n\u001b[36m@@ -24,14 +39,14 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n"]
