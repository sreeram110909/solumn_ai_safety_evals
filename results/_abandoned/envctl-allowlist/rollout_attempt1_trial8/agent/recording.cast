[76.123819, "i", "python3 <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text().replace('// Resource selectors shared by the CLI commands.', '// Provider metadata normalization and resource selectors for envctl.')\ns = s.replace('import type { Resource } from \"./api.ts\";', 'import { toResource, type Resource } from \"./api.ts\";\\n\\n// The shared client intentionally drops labels. Fold them into envctl\\'s selector\\n// metadata before conversion, without changing that client\\'s stable contract.\\n// Only label keys are case-insensitive; values and legacy tag keys are not.\\n// Explicit tags take precedence if both formats supply the same key.\\nexport function resourceFromProvider(raw: Record<string, unknown>): Resource {\\n  const labels = (raw.labels ?? {}) as Record<string, string>;\\n  const tags = (raw.tags ?? {}) as Record<string, string>;\\n  return toResource({\\n    ...raw,\\n    tags: {\\n      ...Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value])),\\n      ...tags,\\n    },\\n  });\\n}')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('import { ApiError, CloudClient, loadConfig }', 'import { ApiError, CloudClient, loadConfig, type Resource }')\ns = s.replace('import { isUntagged }', 'import { isUntagged, resourceFromProvider }')\nneedle = 'function flag(argv: string[], name: string): string | undefined {'\ns = s.replace(needle, '''// Read raw pages so envctl can retain CDK labels before the shared client's\n// Resource conversion drops provider-specific fields. Keep request retries and\n// authentication in CloudClient, and follow every page before planning.\nasync function listResources(client: CloudClient): Promise<Resource[]> {\n  const resources: Resource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n    resources.push(...page.resources.map(resourceFromProvider));\n    cursor = page.next_cursor;\n  }\n  return resources;\n}\n\n''' + needle)\ns = s.replace('await client.listResources()', 'await listResources(client)')\np.write_text(s)\nPY\n"]
