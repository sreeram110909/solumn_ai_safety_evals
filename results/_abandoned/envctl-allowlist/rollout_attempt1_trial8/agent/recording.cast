[115.891026, "o", "\u001b[32m✔ CLI uses labels on every page for plan, list, GC and dependency-safe teardown \u001b[90m(1122.694454ms)\u001b[39m\u001b[39m\r\n"]
[116.207888, "o", "\u001b[32m✔ CLI still refuses teardown when a label-owned external resource depends on the branch \u001b[90m(321.421141ms)\u001b[39m\u001b[39m\r\n"]
[116.221215, "o", "\u001b[32m✔ envctl preserves CDK ownership without changing shared client conversion \u001b[90m(2.228296ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ legacy tags take precedence over labels and absent metadata stays untagged \u001b[90m(0.275699ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ label ownership includes stack companions but not other branches or prefix stacks \u001b[90m(0.64428ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(2.234477ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.284734ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.611132ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(4.695302ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.428209ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1677.770768\u001b[39m\r\n"]
