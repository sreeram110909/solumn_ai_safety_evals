[76.129087, "o", "s = s.replace('import type { Resource } from \"./api.ts\";', 'import { toResource, type Resource } from \"./api.ts\";\\n\\n// The shared client intentionally drops labels. Fold them into envctl\\'s selector\\n// metadata before conversion, without changing that client\\'s stable contract.\\n// Only label keys are case-insensitive; values and legacy tag keys are not.\\n// Explicit tags take precedence if both formats supply the same key.\\nexport function resourceFromProvider(raw: Record<string, unknown>): Resource {\\n  const labels = (raw.labels ?? {}) as Record<string, string>;\\n  const tags = (raw.tags ?? {}) as Record<string, string>;\\n  return toResource({\\n    ...raw,\\n    tags: {\\n      ...Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value])),\\n      ...tags,\\n    },\\n  });\\n}')"]
[76.129582, "o", "\r\n"]
[76.13031, "o", "\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/cli.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('import { ApiError, CloudClient, loadConfig }', 'import { ApiError, CloudClient, loadConfig, type Resource }')\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.133, "o", "> s = s.replace('import { isUntagged }', 'import { isUntagged, resourceFromProvider }')\r\n\u001b[?2004l\r\u001b[?2004h> needle = 'function flag(argv: string[], name: string): string | undefined {'\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(needle, '''// Read raw pages so envctl can retain CDK labels before the shared client's\r\n\u001b[?2004l\r\u001b[?2004h> // Resource conversion drops provider-specific fields. Keep request retries and\r\n\u001b[?2004l\r\u001b[?2004h> // authentication in CloudClient, and follow every page before planning.\r\n\u001b[?2004l\r\u001b[?2004h> async function listResources(client: CloudClient): Promise<Resource[]> {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources: Resource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let cursor: string | null = \"0\";\r\n\u001b[?2004l\r\u001b[?2004h>   while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>     const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\r\n\u001b[?2004l\r\u001b[?2004h>       await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\r\n\u001b[?2004l\r\u001b[?2004h>     resources.push(...page.resources.map(resourceFromProvider));\r\n\u001b[?2004l\r\u001b[?2004h>     cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return resources;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ''' + needle)\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('await client.listResources()', 'await listResources(client)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[76.154886, "o", "\u001b[?2004h"]
[76.155129, "o", "root@a5d4ea02155e:/app# "]
[76.311236, "i", "cat > test/filter.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { toResource } from \"../src/api.ts\";\nimport { branchOf, byBranch, isUntagged, matches, resourceFromProvider } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\n\nconst raw = {\n  id: \"cdk-instance\", type: \"instance\", name: \"cdk-instance\",\n  labels: { bRaNcH: \"feat-ledger\", TEAM: \"Payments\" },\n};\n\ntest(\"envctl preserves CDK ownership without changing shared client conversion\", () => {\n  assert.deepEqual(toResource(raw).tags, {});\n  const r = resourceFromProvider(raw);\n  assert.equal(branchOf(r), \"feat-ledger\");\n  assert.equal(isUntagged(r), false);\n  assert.equal(byBranch([r]).get(\"feat-ledger\")?.length, 1);\n  assert.ok(matches(r, [[\"team\", \"Payments\"]]));\n  assert.ok(!matches(r, [[\"team\", \"payments\"]]));\n  assert.equal(buildPlan([r], \"FEAT-LEDGER\").steps.length, 0);\n});\n\ntest(\"legacy tags take precedence over labels and absent metadata stays untagged\", () => {\n  const r = resourceFromProvider({ ...raw, tags: { branch: \"feat-other\", owner: \"payments\" } });\n  assert.equal(branchOf(r), \"feat-other\");\n  assert.ok(matches(r, [[\"owner\", \"payments\"], [\"team\", \"Payments\"]]));\n  assert.ok(isUntagged(resourceFromProvider({ id: \"manual\" })));\n  assert.ok(isUntagged(resourceFromProvider({ id: \"manual\", tags: null, labels: null })));\n});\n\ntest(\"label ownership includes stack companions but not other branches or prefix stacks\", () => {\n  const resources = [\n    resourceFromProvider({ ...raw, stack_id: \"custom-stack\" }),\n    resourceFromProvider({ id: \"boot\", stack_id: \"custom-stack\" }),\n    resourceFromProvider({ id: \"canonical\", stack_id: \"stk-feat-ledger\" }),\n    resourceFromProvider({ id: \"v2\", stack_id: \"stk-feat-ledger-v2\" }),\n    resourceFromProvider({ id: \"other\", stack_id: \"custom-stack\", labels: { Branch: \"feat-other\" } }),\n    resourceFromProvider({ id: \"manual\" }),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-ledger\").steps.map(s => s.id).sort(),\n    [\"boot\", \"canonical\", \"cdk-instance\"]);\n});\nEOF\ncat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { once } from \"node:events\";\nimport { test } from \"node:test\";\nimport type { AddressInfo } from \"node:net\";\n\ntype RawResource = Record<string, unknown> & { id: string; depends_on?: string[] };\nconst resource = (id: string, metadata: Record<string, unknown> = {}, depends_on: string[] = []): RawResource => ({\n  id, type: \"instance\", name: id, cost_month_cents: 100, depends_on, ...metadata,\n});\n\nasync function fixture(external = false) {\n  // Ownership metadata occurs on both sides of a real 20-resource page boundary.\n  const resources = [\n    resource(\"network\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\n    ...Array.from({ length: 19 }, (_, i) => resource(`other-${i}`, { tags: { branch: \"feat-other\" } })),\n    resource(\"boot\", { stack_id: \"stk-feat-ledger\" }),\n    resource(\"cdk-volume\", { labels: { BRANCH: \"feat-ledger\" } }),\n    resource(\"cdk-instance\", { labels: { Branch: \"feat-ledger\", Team: \"payments\" } }, [\"network\", \"boot\", \"cdk-volume\"]),\n    resource(\"cdk-dns\", { labels: { branch: \"feat-ledger\" } }, [\"cdk-instance\"]),\n    resource(\"v2\", { stack_id: \"stk-feat-ledger-v2\", tags: { branch: \"feat-ledger-v2\" } }),\n    resource(\"manual\"),\n    ...(external ? [resource(\"external\", { labels: { Branch: \"feat-other\" } }, [\"network\"])] : []),\n  ];\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  const server = createServer((req, res) => {\n    assert.equal(req.headers.authorization, \"Bearer test-token\");\n    res.setHeader(\"content-type\", \"application/json\");\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      const start = Number(cursor);\n      res.end(JSON.stringify({ resources: resour"]
[76.312274, "i", "ces.slice(start, start + 20),\n        next_cursor: start + 20 < resources.length ? String(start + 20) : null }));\n    } else if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter(r => r.depends_on?.includes(id));\n      if (dependents.length) {\n        res.statusCode = 409;\n        res.end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map(r => r.id) }));\n      } else {\n        const index = resources.findIndex(r => r.id === id);\n        assert.notEqual(index, -1);\n        resources.splice(index, 1);\n        deleted.push(id);\n        res.end(JSON.stringify({ deleted: id }));\n      }\n    } else {\n      res.statusCode = 404;\n      res.end(JSON.stringify({ error: \"not found\" }));\n    }\n  });\n  server.listen(0, \"127.0.0.1\");\n  await once(server, \"listening\");\n  const baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\n  return {\n    resources, deleted, cursors,\n    close: () => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())),\n    run: async (...args: string[]) => {\n      const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n        env: { ...process.env, ENVCTL_API: baseUrl, ENVCTL_TOKEN: \"test-token\" },\n        stdio: [\"ignore\", \"pipe\", \"pipe\"],\n      });\n      let stdout = \"\", stderr = \"\";\n      child.stdout.on(\"data\", data => { stdout += data; });\n      child.stderr.on(\"data\", data => { stderr += data; });\n      const [code] = await once(child, \"close\");\n      return { code, stdout, stderr };\n    },\n  };\n}\n\ntest(\"CLI uses labels on every page for plan, list, GC and dependency-safe teardown\", async () => {\n  const f = await fixture();\n  try {\n    const planned = await f.run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\n    assert.equal(planned.code, 0, planned.stderr);\n    const plan = JSON.parse(planned.stdout);\n    const targetIds = [\"network\", \"boot\", \"cdk-volume\", \"cdk-instance\", \"cdk-dns\"];\n    assert.deepEqual(plan.steps.map((s: { id: string }) => s.id).sort(), targetIds.toSorted());\n    assert.deepEqual(plan.blocked, []);\n    assert.deepEqual(f.cursors, [\"0\", \"20\"]);\n\n    const listed = await f.run(\"list\");\n    assert.equal(listed.code, 0, listed.stderr);\n    assert.match(listed.stdout, /feat-ledger\\s+4\\s/);\n    const gc = await f.run(\"gc\", \"--untagged\");\n    assert.equal(gc.code, 0, gc.stderr);\n    assert.match(gc.stdout, /^2 untagged resources/); // stack boot + truly manual\n    const dryRun = await f.run(\"teardown\", \"--branch\", \"feat-ledger\", \"--dry-run\");\n    assert.equal(dryRun.code, 0, dryRun.stderr);\n    assert.deepEqual(f.deleted, []);\n\n    const tornDown = await f.run(\"teardown\", \"--branch\", \"feat-ledger\");\n    assert.equal(tornDown.code, 0, tornDown.stderr);\n    assert.deepEqual(f.deleted.toSorted(), targetIds.toSorted());\n    const pos = (id: string) => f.deleted.indexOf(id);\n    assert.ok(pos(\"cdk-dns\") < pos(\"cdk-instance\"));\n    for (const dependency of [\"network\", \"boot\", \"cdk-volume\"]) assert.ok(pos(\"cdk-instance\") < pos(dependency));\n    assert.equal(f.resources.length, 21); // all unrelated resources survived\n    const after = await f.run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\n    assert.equal(after.code, 0, after.stderr);\n    assert.deepEqual(JSON.parse(after.stdout).steps, []);\n  } finally {\n    await f.close();\n  }\n});\n\ntest(\"CLI still refuses teardown when a label-owned external resource depends on the branch\", async () => {\n  const f = await fixture(true);\n  try {\n    const planned = await f.run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\n    assert.equal(planned.code, 0, planned.stderr);\n    assert.deepEqual(JSON.parse(planned.stdout).blocked, [{ id: \"network\", dependents: [\"external\"] }]);\n    const result = await f.run(\"teardown\", \"--branch\", \"feat-ledger\");\n    assert.equal(result.code, 1);\n    assert.match(result.stderr, /refusing to tear down/);\n    assert.deepEqual(f.deleted, []);\n  } finally {\n    await f.close();\n  }\n});\nEOF\nmake c"]
[76.313817, "i", "i\n"]
