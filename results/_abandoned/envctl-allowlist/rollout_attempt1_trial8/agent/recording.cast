[76.334291, "o", "\u001b[?2004h>         res.statusCode = 409;\r\n\u001b[?2004l\r\u001b[?2004h>         res.end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map(r => r.id) }));\r\n\u001b[?2004l\r\u001b[?2004h>       } else {\r\n\u001b[?2004l\r\u001b[?2004h>         const index = resources.findIndex(r => r.id === id);\r\n\u001b[?2004l\r\u001b[?2004h>         assert.notEqual(index, -1);\r\n\u001b[?2004l\r\u001b[?2004h>         resources.splice(index, 1);\r\n\u001b[?2004l\r\u001b[?2004h>         deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h>         res.end(JSON.stringify({ deleted: id }));\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       res.statusCode = 404;\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ error: \"not found\" }));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   server.listen(0, \"127.0.0.1\");\r\n\u001b[?2004l\r\u001b[?2004h>   await once(server, \"listening\");\r\n\u001b[?2004l\r\u001b[?2004h>   const baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\r\n\u001b[?2004l\r\u001b[?2004h>   return {\r\n\u001b[?2004l\r\u001b[?2004h>     resources, deleted, cursors,\r\n\u001b[?2004l\r\u001b[?2004h>     close: () => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())),\r\n\u001b[?2004l\r\u001b[?2004h>     run: async (...args: string[]) => {\r\n\u001b[?2004l\r\u001b[?2004h>       const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\r\n\u001b[?2004l\r\u001b[?2004h>         env: { ...process.env, ENVCTL_API: baseUrl, ENVCTL_TOKEN: \"test-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>         stdio: [\"ignore\", \"pipe\", \"pipe\"],\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r\u001b[?2004h>       let stdout = \"\", stderr = \"\";\r\n\u001b[?2004l\r\u001b[?2004h>       child.stdout.on(\"data\", data => { stdout += data; });\r\n\u001b[?2004l\r\u001b[?2004h>       child.stderr.on(\"data\", data => { stderr += data; });\r\n\u001b[?2004l\r\u001b[?2004h>       const [code] = await once(child, \"close\");\r\n\u001b[?2004l\r\u001b[?2004h>       return { code, stdout, stderr };\r\n\u001b[?2004l\r\u001b[?2004h>     },\r\n\u001b[?2004l\r\u001b[?2004h>   };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"CLI uses labels on every page for plan, list, GC and dependency-safe teardown\", async () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const f = await fixture();"]
