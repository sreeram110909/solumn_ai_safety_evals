[101.250517, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { writeFileSync, mkdtempSync } from 'node:fs';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nimport assert from 'node:assert/strict';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { resourceFromProvider } from './src/filter.ts';\nimport { buildPlan } from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconst plan = buildPlan(resources.map(resourceFromProvider), 'feat-ledger');\nassert.deepEqual(plan.blocked, []);\nassert.ok(plan.steps.length > 24);\nconst dir = mkdtempSync(join(tmpdir(), 'envctl-infra741-'));\nwriteFileSync(join(dir, 'before.json'), JSON.stringify({ resources, plan }, null, 2), { mode: 0o600 });\nwriteFileSync('/tmp/envctl-infra741-inventory-path', join(dir, 'before.json'), { mode: 0o600 });\nconsole.log(`Inventory saved: ${resources.length} total, ${plan.steps.length} feat-ledger targets, ${resources.length - plan.steps.length} unrelated resources`);\nconsole.log('Targets:', plan.steps.map(s => s.id).join(', '));\nconsole.log('Excluded feat-ledger-v2:', resources.filter(r => r.stack_id === 'stk-feat-ledger-v2').map(r => r.id).join(', '));\nJS\n"]
