[82.048833, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { toResource } from \"../src/api.ts\";\nimport { branchOf, byBranch, isUntagged, matches } from \"../src/filter.ts\";\nimport type { BranchResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\nimport { summarize } from \"../src/report.ts\";\n\nfunction res(id: string, fields: Partial<BranchResource> = {}): BranchResource {\n  return { id, type: \"instance\", name: id, tags: {}, stack_id: null, depends_on: [],\n    cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...fields };\n}\n\ntest(\"label selectors ignore key casing, not value casing; legacy tags take precedence\", () => {\n  const r = res(\"labelled\", { labels: { BrAnCh: \"feat-ledger\", TEAM: \"payments\" } });\n  assert.equal(branchOf(r), \"feat-ledger\");\n  assert.equal(isUntagged(r), false);\n  assert.ok(matches(r, [[\"branch\", \"feat-ledger\"], [\"team\", \"payments\"]]));\n  assert.ok(matches(r, [[\"TEAM\", \"payments\"]]));\n  assert.ok(!matches(r, [[\"branch\", \"FEAT-LEDGER\"]]));\n  assert.equal(branchOf({ ...r, tags: { branch: \"main\" } }), \"main\");\n  assert.equal(branchOf(res(\"untagged\")), undefined);\n});\n\ntest(\"listing and summaries recognize label-only branch ownership\", () => {\n  const resources = [res(\"labelled\", { labels: { Branch: \"feat-ledger\" } }), res(\"orphan\")];\n  assert.equal(byBranch(resources).get(\"feat-ledger\")?.length, 1);\n  assert.equal(byBranch(resources).get(\"(untagged)\")?.length, 1);\n  assert.match(summarize(resources), /feat-ledger/);\n  assert.match(summarize(resources), /1 untagged resources/);\n});\n\ntest(\"plan includes labels and exact stack ownership, never similarly named branches or unrelated dependencies\", () => {\n  const resources = [\n    res(\"net\", { type: \"network\", tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\n    res(\"boot\", { type: \"volume\", stack_id: \"stk-feat-ledger\" }),\n    res(\"label-volume\", { type: \"volume\", labels: { Branch: \"feat-ledger\" } }),\n    res(\"app\", { labels: { BRANCH: \"feat-ledger\" }, depends_on: [\"net\", \"boot\", \"label-volume\"] }),\n    res(\"custom-app\", { labels: { Branch: \"feat-ledger\" }, stack_id: \"custom-stack\", depends_on: [\"custom-volume\"] }),\n    res(\"custom-volume\", { type: \"volume\", stack_id: \"custom-stack\" }),\n    res(\"v2\", { stack_id: \"stk-feat-ledger-v2\" }),\n    res(\"other\", { labels: { Branch: \"feat-payroll\" }, stack_id: \"stk-feat-ledger\" }),\n    res(\"orphan\"),\n  ];\n  const plan = buildPlan(resources, \"feat-ledger\");\n  const ids = plan.steps.map((s) => s.id);\n  assert.deepEqual([...ids].sort(), [\"app\", \"boot\", \"custom-app\", \"custom-volume\", \"label-volume\", \"net\"]);\n  assert.deepEqual(plan.blocked, []);\n  for (const r of resources.filter((r) => ids.includes(r.id))) {\n    for (const dep of r.depends_on) assert.ok(ids.indexOf(r.id) < ids.indexOf(dep));\n  }\n  assert.equal(buildPlan(resources, \"FEAT-LEDGER\").steps.length, 0);\n});\n\ntest(\"genuine external dependents still block teardown\", () => {\n  const plan = buildPlan([\n    res(\"net\", { labels: { Branch: \"feat-ledger\" } }),\n    res(\"external\", { labels: { Branch: \"main\" }, depends_on: [\"net\"] }),\n  ], \"feat-ledger\");\n  assert.deepEqual(plan.blocked, [{ id: \"net\", dependents: [\"external\"] }]);\n});\n\ntest(\"shared normalization remains unchanged (CLI must preserve labels separately)\", () => {\n  assert.equal(\"labels\" in toResource({ id: \"labelled\", labels: { Branch: \"feat-ledger\" } }), false);\n});\nEOF\nmake ci\n"]
[82.049419, "o", "cat > test/labels.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h"]
[82.049656, "o", "> import { test } from \"node:test\";"]
