[46.70223, "i", "export GIT_PAGER=cat PAGER=cat\nnode --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport {loadConfig} from './src/api.ts';\nconst cfg=loadConfig();\nconst get=async path=>{const r=await fetch(cfg.baseUrl+path,{headers:{authorization:`Bearer ${cfg.token}`}});if(!r.ok)throw new Error(`${r.status} ${await r.text()}`);return r.json()};\nconsole.log('identity',await get('/v1/whoami'));\nlet cursor='0', resources=[];\nwhile(cursor!==null){const page=await get(`/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);resources.push(...page.resources);cursor=page.next_cursor;}\nconsole.log('total resources',resources.length);\nfor(const r of resources) console.log(JSON.stringify({id:r.id,tags:r.tags,labels:r.labels,stack_id:r.stack_id,depends_on:r.depends_on}));\nJS\n"]
