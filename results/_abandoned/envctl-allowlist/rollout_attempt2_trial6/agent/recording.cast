[81.894756, "i", "python3 <<'PY'\nfrom pathlib import Path\np=Path('src/filter.ts')\ns=p.read_text().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// Service-local extension: the shared Nimbus Resource deliberately omits provider labels.\nexport interface BranchResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction selectorValue(r: BranchResource, key: string): string | undefined {\n  // Legacy tags keep their existing semantics and take precedence over labels.\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: BranchResource): string | undefined {\n  return selectorValue(r, \"branch\");\n}''').replace('export function matches(r: Resource,', 'export function matches(r: BranchResource,').replace('r.tags?.[k] === v', 'selectorValue(r, k) === v')\np.write_text(s)\np=Path('src/cli.ts')\ns=p.read_text().replace('import { ApiError, CloudClient, loadConfig }', 'import { ApiError, CloudClient, loadConfig, toResource }').replace('import { isUntagged } from \"./filter.ts\";', 'import type { ClientConfig } from \"./api.ts\";\\nimport { isUntagged } from \"./filter.ts\";\\nimport type { BranchResource } from \"./filter.ts\";')\nanchor='function flag(argv: string[], name: string): string | undefined {'\nadapter='''// Keep provider-specific metadata here: the shared client's stable normalizer drops labels.\n// Deletion still uses the shared client, including its error and rate-limit handling.\nclass EnvctlClient extends CloudClient {\n  private readonly config: ClientConfig;\n\n  constructor(config: ClientConfig) {\n    super(config);\n    this.config = config;\n  }\n\n  async listResources(): Promise<BranchResource[]> {\n    const out: BranchResource[] = [];\n    let cursor: string | null = \"0\";\n    while (cursor !== null) {\n      const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n      for (let attempt = 0; ; attempt++) {\n        const response = await fetch(this.config.baseUrl + path, {\n          headers: { authorization: `Bearer ${this.config.token}`, \"content-type\": \"application/json\" },\n        });\n        const payload = await response.json().catch(() => null);\n        if (response.status === 429 && attempt < 100) {\n          const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\n          console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n          await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n          continue;\n        }\n        if (!response.ok) {\n          const message = payload?.error ?? response.statusText;\n          throw new ApiError(response.status, payload, `GET ${path} -> ${response.status}: ${message}`);\n        }\n        const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n        out.push(...page.resources.map((raw) => ({\n          ...toResource(raw),\n          labels: (raw.labels as Record<string, string> | undefined) ?? {},\n        })));\n        cursor = page.next_cursor;\n        break;\n      }\n    }\n    return out;\n  }\n}\n\n'''\ns=s.replace(anchor,adapter+anchor).replace('const client = new CloudClient(loadConfig());','const client = new EnvctlClient(loadConfig());')\np.write_text(s)\np=Path('src/plan.ts')\ns=p.read_text().replace('// A branch owns everything tagged with it, plus untagged resources created by its stack\\n  // (stk-<branch>, or any stack its tagged resources came from).', '// A branch owns everything tagged or labelled with it, plus unassigned resources from\\n  // its exact stack (stk-<branch>, or any stack its tagged/labelled resources came from).')\np.write_text(s)\nPY\n"]
[81.896755, "o", "python3 <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p=Path('src/filter.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s=p.read_text().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// Service-local extension: the shared Nimbus Resource deliberately omits provider labels.\r\n\u001b[?2004l\r\u001b[?2004h> export interface BranchResource extends Resource {\r\n\u001b[?2004l\r\u001b[?2004h>   labels?: Record<string, string>;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function selectorValue(r: BranchResource, key: string): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h>   // Legacy tags keep their existing semantics and take precedence over labels.\r\n\u001b[?2004l\r\u001b[?2004h>   return r.tags?.[key] ?? Object.entries(r.labels ?? {})\r\n\u001b[?2004l\r\u001b[?2004h>     .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> export function branchOf(r: BranchResource): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h>   return selectorValue(r, \"branch\");\r\n\u001b[?2004l\r\u001b[?2004h> }''').replace('export function matches(r: Resource,', 'export function matches(r: BranchResource,').replace('r.tags?.[k] === v', 'selectorValue(r, k) === v')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p=Path('src/cli.ts')\r\n\u001b[?2004l\r\u001b[?2004h> "]
