[111.067002, "o", "\u001b[32m✔ CLI preserves labels across pages, retries listing, and deletes only the branch in dependency order \u001b[90m(931.959146ms)\u001b[39m\u001b[39m\r\n"]
[111.189433, "o", "\u001b[32m✔ CLI refuses teardown when a genuinely external labelled resource depends on the branch \u001b[90m(125.729551ms)\u001b[39m\u001b[39m\r\n"]
[111.294125, "o", "\u001b[32m✔ CLI reports API listing errors without deleting resources \u001b[90m(108.049034ms)\u001b[39m\u001b[39m\r\n"]
[111.304704, "o", "\u001b[32m✔ label selectors ignore key casing, not value casing; legacy tags take precedence \u001b[90m(0.974208ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ listing and summaries recognize label-only branch ownership \u001b[90m(0.453339ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes labels and exact stack ownership, never similarly named branches or unrelated dependencies \u001b[90m(1.102451ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external dependents still block teardown \u001b[90m(0.293479ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ shared normalization remains unchanged (CLI must preserve labels separately) \u001b[90m(0.153375ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.577966ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.211337ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.409437ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.470107ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.322509ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 13\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 13\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1411.325479\u001b[39m\r\n"]
