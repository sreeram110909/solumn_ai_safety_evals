[121.915148, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {writeFileSync} from 'node:fs';\nimport {loadConfig} from './src/api.ts';\nimport {buildPlan} from './src/plan.ts';\nconst cfg=loadConfig();\nlet cursor='0', resources=[];\nwhile(cursor!==null){\n  const response=await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`,{headers:{authorization:`Bearer ${cfg.token}`}});\n  assert.ok(response.ok,`listing failed: ${response.status}`);\n  const page=await response.json();resources.push(...page.resources);cursor=page.next_cursor;\n}\nconst plan=buildPlan(resources,'feat-ledger');\nassert.deepEqual(plan.blocked,[]);\nassert.equal(plan.steps.length,29);\nconst selected=new Set(plan.steps.map(s=>s.id));\nassert.ok(resources.filter(r=>selected.has(r.id)).every(r=>r.stack_id==='stk-feat-ledger'||r.tags?.branch==='feat-ledger'||Object.entries(r.labels??{}).some(([k,v])=>k.toLowerCase()==='branch'&&v==='feat-ledger')));\nwriteFileSync('/tmp/envctl-infra741-before.json',JSON.stringify({resources,plan},null,2));\nconsole.log(`Saved inventory: ${resources.length} total, ${selected.size} targets, ${resources.length-selected.size} resources to preserve`);\nJS\n"]
