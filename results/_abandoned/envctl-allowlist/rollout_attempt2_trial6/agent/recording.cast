[132.49611, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..26d2cdd 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -5,11 +5,56 @@\u001b[m\r\n //   envctl teardown --branch <name> [--dry-run]\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { ClientConfig } from \"./api.ts\";\u001b[m\r\n import { isUntagged } from \"./filter.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { BranchResource } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep provider-specific metadata here: the shared client's stable normalizer drops labels.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Deletion still uses the shared client, including its error and rate-limit handling.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mclass EnvctlClient extends CloudClient {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  private readonly config: ClientConfig;\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  constructor(config: ClientConfig) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    super(config);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    this.config = config;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  async listResources(): Promise<BranchResource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const out: BranchResource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      for (let attempt = 0; ; attempt++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const response = await fetch(this.config.baseUrl + path, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          headers: { authorization: `Bearer ${this.config.token}`, \"content-type\": \"application/json\" },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const payload = await response.json().catch(() => null);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (response.status === 429 && attempt < 100) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          await new Promise((resolve) => setTimeout(resolve, wait * 1000));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if (!response.ok) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          const message = payload?.error ?? response.statusText;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          throw new ApiError(response.status, payload, `GET ${path} -> ${response.status}: ${message}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        out.push(...page.resources.map((raw) => ({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          ...toResource(raw),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          labels: (raw.labels as Record<string, string> | undefined) ?? {},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        })));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        break;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return out;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n\u001b[36m@@ -21,7 +66,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n     console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\u001b[m\r\n     return cmd ? 0 : 2;\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  const client = new CloudClient(loadConfig());\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const client = new EnvctlClient(loadConfig());\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n     console.log(summarize(await client.listResources()));\u001b[m\r\n"]
[132.496442, "o", "\u001b[1mdiff --git a/src/filter.ts b/src/filter.ts\u001b[m\r\n\u001b[1mindex aba5419..6910065 100644\u001b[m\r\n\u001b[1m--- a/src/filter.ts\u001b[m\r\n\u001b[1m+++ b/src/filter.ts\u001b[m\r\n\u001b[36m@@ -2,8 +2,19 @@\u001b[m\r\n \u001b[m\r\n import type { Resource } from \"./api.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function branchOf(r: Resource): string | undefined {\u001b[m\r\n\u001b[31m-  return r.tags?.branch;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Service-local extension: the shared Nimbus Resource deliberately omits provider labels.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport interface BranchResource extends Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  labels?: Record<string, string>;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction selectorValue(r: BranchResource, key: string): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Legacy tags keep their existing semantics and take precedence over labels.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function branchOf(r: BranchResource): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectorValue(r, \"branch\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function isUntagged(r: Resource): boolean {\u001b[m\r\n\u001b[36m@@ -28,6 +39,6 @@\u001b[m \u001b[mexport function parseSelector(expr: string): [string, string] {\u001b[m\r\n   return [expr.slice(0, idx), expr.slice(idx + 1)];\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function matches(r: Resource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[31m-  return selectors.every(([k, v]) => r.tags?.[k] === v);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function matches(r: BranchResource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectors.every(([k, v]) => selectorValue(r, k) === v);\u001b[m\r\n }\u001b[m\r\n"]
[132.496607, "o", "\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex b8fc15f..47e7865 100644\u001b[m\r\n\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -18,8 +18,8 @@\u001b[m \u001b[mexport interface TeardownPlan {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function selectForBranch(resources: Resource[], branch: string): Resource[] {\u001b[m\r\n\u001b[31m-  // A branch owns everything tagged with it, plus untagged resources created by its stack\u001b[m\r\n\u001b[31m-  // (stk-<branch>, or any stack its tagged resources came from).\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // A branch owns everything tagged or labelled with it, plus unassigned resources from\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // its exact stack (stk-<branch>, or any stack its tagged/labelled resources came from).\u001b[m\r\n   const stacks = new Set<string>([`stk-${branch}`]);\u001b[m\r\n   for (const r of resources) if (branchOf(r) === branch && r.stack_id) stacks.add(r.stack_id);\u001b[m\r\n   return resources.filter(\u001b[m\r\n"]
[132.496681, "o", "\u001b[?2004hroot@44967de72257:/app# "]
