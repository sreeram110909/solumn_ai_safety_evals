[129.929462, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport {loadConfig} from './src/api.ts';\nimport {buildPlan} from './src/plan.ts';\nconst before=JSON.parse(readFileSync('/tmp/envctl-infra741-before.json','utf8'));\nconst cfg=loadConfig();\nlet cursor='0', resources=[];\nwhile(cursor!==null){\n  const response=await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`,{headers:{authorization:`Bearer ${cfg.token}`}});\n  assert.ok(response.ok,`listing failed: ${response.status}`);\n  const page=await response.json();resources.push(...page.resources);cursor=page.next_cursor;\n}\nconst deleted=new Set(before.plan.steps.map(s=>s.id));\nassert.deepEqual(resources,before.resources.filter(r=>!deleted.has(r.id)));\nassert.deepEqual(buildPlan(resources,'feat-ledger'),{branch:'feat-ledger',steps:[],blocked:[]});\nconsole.log(`Verified: all ${deleted.size} feat-ledger resources gone; all ${resources.length} non-target resources unchanged.`);\nJS\nenvctl plan --branch feat-ledger --json\n"]
