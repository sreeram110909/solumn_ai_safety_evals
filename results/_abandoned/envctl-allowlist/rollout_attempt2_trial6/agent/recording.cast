[82.052844, "o", "\u001b[?2004h> import { toResource } from \"../src/api.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { branchOf, byBranch, isUntagged, matches } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import type { BranchResource } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildPlan } from \"../src/plan.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { summarize } from \"../src/report.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function res(id: string, fields: Partial<BranchResource> = {}): BranchResource {\r\n\u001b[?2004l\r\u001b[?2004h>   return { id, type: \"instance\", name: id, tags: {}, stack_id: null, depends_on: [],\r\n\u001b[?2004l\r\u001b[?2004h>     cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...fields };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"label selectors ignore key casing, not value casing; legacy tags take precedence\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const r = res(\"labelled\", { labels: { BrAnCh: \"feat-ledger\", TEAM: \"payments\" } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(r), \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(isUntagged(r), false);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(matches(r, [[\"branch\", \"feat-ledger\"], [\"team\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(matches(r, [[\"TEAM\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(!matches(r, [[\"branch\", \"FEAT-LEDGER\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf({ ...r, tags: { branch: \"main\" } }), \"main\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(res(\"untagged\")), undefined);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"listing and summaries recognize label-only branch ownership\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [res(\"labelled\", { labels: { Branch: \"feat-ledger\" } }), res(\"orphan\")];\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(byBranch(resources).get(\"feat-ledger\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(byBranch(resources).get(\"(untagged)\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(summarize(resources), /feat-ledger/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(summarize(resources), /1 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"plan includes labels and exact stack ownership, never similarly named branches or unrelated dependencies\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"net\", { type: \"network\", tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"boot\", { type: \"volume\", stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"label-volume\", { type: \"volume\", labels: { Branch: \"feat-ledger\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"app\", { labels: { BRANCH: \"feat-ledger\" }, depends_on: [\"net\", \"boot\", \"label-volume\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"custom-app\", { labels: { Branch: \"feat-ledger\" }, stack_id: \"custom-stack\", depends_on: [\"custom-volume\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"custom-volume\", { type: \"volume\", stack_id: \"custom-stack\" }),\r\n\u001b[?2004l\r\u001b[?2004h> "]
