[132.463491, "o", "\u001b[32m✔ label selectors ignore key casing, not value casing; legacy tags take precedence \u001b[90m(0.954413ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ listing and summaries recognize label-only branch ownership \u001b[90m(0.519531ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes labels and exact stack ownership, never similarly named branches or unrelated dependencies \u001b[90m(1.321487ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external dependents still block teardown \u001b[90m(0.487311ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ shared normalization remains unchanged (CLI must preserve labels separately) \u001b[90m(0.198226ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.500525ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.192321ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(1.177282ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.523703ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.297789ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 13\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 13\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1322.039198\u001b[39m\r\n"]
[132.470075, "o", "\u001b[1G\u001b[0K⠙"]
