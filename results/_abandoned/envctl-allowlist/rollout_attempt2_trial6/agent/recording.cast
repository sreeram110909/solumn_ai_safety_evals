    const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\r\n\u001b[?2004l\r\u001b[?2004h>         out.push(...page.resources.map((raw) => ({\r\n\u001b[?2004l\r\u001b[?2004h>           ...toResource(raw),\r\n\u001b[?2004l\r\u001b[?2004h>           labels: (raw.labels as Record<string, string> | undefined) ?? {},\r\n\u001b[?2004l\r\u001b[?2004h>         })));\r\n\u001b[?2004l\r\u001b[?2004h>         cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>         break;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return out;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(anchor,adapter+anchor).replace('const client = new CloudClient(loadConfig());','const client = new EnvctlClient(loadConfig());')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p=Path('src/plan.ts')\r\n\u001b[?2004l\r\u001b[?2004h> "]
