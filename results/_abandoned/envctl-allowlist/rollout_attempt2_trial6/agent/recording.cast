[109.720858, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"CLI preserves labels across pages, retries listing, and deletes only the branch in dependency order\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const other = Array.from({ length: 21 }, (_, i) => resource(`other-${i}`, { labels: { Branch: \"main\" } }));\r\n\u001b[?2004l\r\u001b[?2004h>   const cloud = await mockCloud(t, [\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"net\", { type: \"network\", tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"boot\", { type: \"volume\", stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     ...other,\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"label-volume\", { type: \"volume\", labels: { Branch: \"feat-ledger\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"app\", { labels: { bRaNcH: \"feat-ledger\" }, depends_on: [\"net\", \"boot\", \"label-volume\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"dns\", { type: \"dns_record\", labels: { BRANCH: \"feat-ledger\" }, depends_on: [\"app\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"orphan\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ], true);\r\n\u001b[?2004l\r\u001b[?2004h>   const planResult = await cloud.run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(planResult.code, 0, planResult.stderr);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(planResult.stderr, /rate limited/);\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = JSON.parse(planResult.stdout);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map((s: { id: string }) => s.id).sort(), [\"app\", \"boot\", \"dns\", \"label-volume\", \"net\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(cloud.requests.some((r) => r.includes(\"cursor=20\")));\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?200