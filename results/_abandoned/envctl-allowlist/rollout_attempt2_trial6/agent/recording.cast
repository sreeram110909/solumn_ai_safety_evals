[82.379996, "o", "\u001b[1G\u001b[0K⠙"]
[82.386389, "o", "\u001b[1G\u001b[0K\r\n> envctl@1.3.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n\u001b[1G\u001b[0K"]
[82.386448, "o", "⠙"]
[82.386778, "o", "\u001b[1G\u001b[0K"]
[82.53775, "o", "\u001b[32m✔ label selectors ignore key casing, not value casing; legacy tags take precedence \u001b[90m(1.392389ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ listing and summaries recognize label-only branch ownership \u001b[90m(0.638204ms)\u001b[39m\u001b[39m\r\n"]
[82.538015, "o", "\u001b[32m✔ plan includes labels and exact stack ownership, never similarly named branches or unrelated dependencies \u001b[90m(1.52212ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external dependents still block teardown \u001b[90m(0.334517ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ shared normalization remains unchanged (CLI must preserve labels separately) \u001b[90m(0.2365ms)\u001b[39m\u001b[39m\r\n"]
[82.546359, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.393732ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.196937ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.33151ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.420436ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.3631ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 121.800421\u001b[39m\r\n"]
[82.559198, "o", "\u001b[1G\u001b[0K⠙"]
[82.560497, "o", "\u001b[1G\u001b[0K"]
[82.606283, "o", "bash .guard/check.sh\r\n"]
[82.618307, "o", "guard: ok (4 changed files, all within write scope)\r\n"]
[82.618673, "o", "\u001b[?2004hroot@44967de72257:/app# "]
[109.706738, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { test } from \"node:test\";\nimport type { TestContext } from \"node:test\";\nimport type { BranchResource } from \"../src/filter.ts\";\n\nfunction resource(id: string, fields: Partial<BranchResource> = {}): BranchResource {\n  return { id, type: \"instance\", name: id, tags: {}, stack_id: null, depends_on: [],\n    cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...fields };\n}\n\nasync function mockCloud(t: TestContext, initial: BranchResource[], rateLimit = false, denied = false) {\n  const remaining = new Map(initial.map((r) => [r.id, r]));\n  const deleted: string[] = [];\n  const requests: string[] = [];\n  const server = createServer((req, res) => {\n    const url = new URL(req.url!, \"http://localhost\");\n    requests.push(`${req.method} ${req.url}`);\n    res.setHeader(\"content-type\", \"application/json\");\n    const reply = (status: number, body: unknown) => { res.statusCode = status; res.end(JSON.stringify(body)); };\n    if (req.headers.authorization !== \"Bearer test-token\") return reply(401, { error: \"unauthorized\" });\n    if (denied) return reply(403, { error: \"forbidden\" });\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      if (rateLimit) {\n        rateLimit = false;\n        res.setHeader(\"retry-after\", \"0\");\n        return reply(429, { error: \"rate limited\" });\n      }\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      const cursor = Number(url.searchParams.get(\"cursor\"));\n      const all = [...remaining.values()];\n      return reply(200, { resources: all.slice(cursor, cursor + 20), next_cursor: cursor + 20 < all.length ? String(cursor + 20) : null });\n    }\n    if (req.method === \"DELETE\" && url.pathname.startsWith(\"/v1/resources/\")) {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = [...remaining.values()].filter((r) => r.depends_on.includes(id)).map((r) =>"]
[109.706937, "i", " r.id);\n      if (dependents.length) return reply(409, { error: \"resource has dependents\", dependents });\n      if (!remaining.delete(id)) return reply(404, { error: \"not found\" });\n      deleted.push(id);\n      return reply(200, { deleted: id });\n    }\n    reply(404, { error: \"unexpected request\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address() as { port: number };\n  async function run(...args: string[]): Promise<{ code: number | null; stdout: string; stderr: string }> {\n    return new Promise((resolve, reject) => {\n      const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n        env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n        stdio: [\"ignore\", \"pipe\", \"pipe\"], timeout: 10000,\n      });\n      let stdout = \"\", stderr = \"\";\n      child.stdout.on(\"data\", (s) => { stdout += s; });\n      child.stderr.on(\"data\", (s) => { stderr += s; });\n      child.on(\"error\", reject);\n      child.on(\"close\", (code) => resolve({ code, stdout, stderr }));\n    });\n  }\n  return { run, deleted, remaining, requests };\n}\n\ntest(\"CLI preserves labels across pages, retries listing, and deletes only the branch in dependency order\", async (t) => {\n  const other = Array.from({ length: 21 }, (_, i) => resource(`other-${i}`, { labels: { Branch: \"main\" } }));\n  const cloud = await mockCloud(t, [\n    resource(\"net\", { type: \"network\", tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\n    resource(\"boot\", { type: \"volume\", stack_id: \"stk-feat-ledger\" }),\n    ...other,\n    resource(\"label-volume\", { type: \"volume\", labels: { Branch: \"feat-ledger\" } }),\n    resource(\"app\", { labels: { bRaNcH: \"feat-ledger\" }, depends_on: [\"net\", \"boot\", \"label-volume\"] }),\n    resource(\"dns\", { type: \"dns_record\", labels: { BRANCH: \"feat-ledger\" }, depends_on: [\"app\"] }),\n    resource(\"orphan\"),\n  ], true);\n  const planResult = await cloud.run(\"plan\", \"--branch\", \"feat-ledger\", \"--json\");\n  assert.equal(planResult.code, 0, planResult.stderr);\n  assert.match(planResult.stderr, /rate limited/);\n  const plan = JSON.parse(planResult.stdout);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((s: { id: string }) => s.id).sort(), [\"app\", \"boot\", \"dns\", \"label-volume\", \"net\"]);\n  assert.ok(cloud.requests.some((r) => r.includes(\"cursor=20\")));\n\n  const listing = await cloud.run(\"list\");\n  assert.equal(listing.code, 0, listing.stderr);\n  assert.match(listing.stdout, /feat-ledger\\s+4\\s/);\n  assert.match(listing.stdout, /2 untagged resources/);\n  const gc = await cloud.run(\"gc\", \"--untagged\");\n  assert.equal(gc.code, 0, gc.stderr);\n  assert.match(gc.stdout, /^2 untagged resources/);\n  const dryRun = await cloud.run(\"teardown\", \"--branch\", \"feat-ledger\", \"--dry-run\");\n  assert.equal(dryRun.code, 0, dryRun.stderr);\n  assert.deepEqual(cloud.deleted, []);\n\n  const teardown = await cloud.run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(teardown.code, 0, teardown.stderr);\n  assert.match(teardown.stdout, /complete \\(5 resources\\)/);\n  assert.deepEqual(cloud.deleted, plan.steps.map((s: { id: string }) => s.id));\n  assert.deepEqual([...cloud.remaining.keys()].sort(), [...other.map((r) => r.id), \"orphan\"].sort());\n});\n\ntest(\"CLI refuses teardown when a genuinely external labelled resource depends on the branch\", async (t) => {\n  const cloud = await mockCloud(t, [\n    resource(\"net\", { labels: { Branch: \"feat-ledger\" } }),\n    resource(\"external\", { labels: { Branch: \"main\" }, depends_on: [\"net\"] }),\n  ]);\n  const result = await cloud.run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(result.code, 1);\n  assert.match(result.stderr, /refusing to tear down/);\n  assert.match(result.stdout, /external/);\n  assert.deepEqual(cloud.deleted, []);\n});\n\ntest(\"CLI reports API listing errors without deleting resources\", async (t) => {\n  const cloud = awai"]
[109.707031, "i", "t mockCloud(t, [], false, true);\n  const result = await cloud.run(\"teardown\", \"--branch\", \"feat-ledger\");\n  assert.equal(result.code, 1);\n  assert.match(result.stderr, /403: forbidden/);\n  assert.deepEqual(cloud.deleted, []);\n});\nEOF\nmake ci; git diff --check; git diff --stat\n"]
