[54.492774, "i", "python3 - <<'PY'\np = 'src/filter.ts'\ns = open(p).read().replace('// Resource selectors shared by the CLI commands.\\n\\nimport type { Resource } from \"./api.ts\";', '''// Resource listing and selectors shared by the CLI commands.\n\nimport { ApiError, toResource } from \"./api.ts\";\nimport type { ClientConfig, Resource } from \"./api.ts\";\n\n// Keep provider metadata local to envctl: the shared client's stable Resource shape drops labels.\nexport interface LabeledResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nexport function toLabeledResource(raw: Record<string, unknown>): LabeledResource {\n  return { ...toResource(raw), labels: raw.labels as Record<string, string> | undefined };\n}\n\nexport async function listResources(\n  cfg: ClientConfig,\n  log: (message: string) => void = (message) => process.stderr.write(message + \"\\\\n\"),\n): Promise<LabeledResource[]> {\n  const resources: LabeledResource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n    for (let attempt = 0; ; attempt++) {\n      const response = await fetch(cfg.baseUrl + path, {\n        headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\n      });\n      const payload = await response.json().catch(() => null);\n      if (response.status === 429 && attempt < 100) {\n        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\n        log(`rate limited on GET ${path}; retrying in ${wait}s`);\n        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n        continue;\n      }\n      if (!response.ok) {\n        throw new ApiError(response.status, payload,\n          `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\n      }\n      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n      resources.push(...page.resources.map(toLabeledResource));\n      cursor = page.next_cursor;\n      break;\n    }\n  }\n  return resources;\n}\n\nfunction labelValue(r: LabeledResource, key: string): string | undefined {\n  return Object.entries(r.labels ?? {}).find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}''')\ns = s.replace('branchOf(r: Resource)', 'branchOf(r: LabeledResource)').replace('return r.tags?.branch;', 'return r.tags?.branch ?? labelValue(r, \"branch\");')\ns = s.replace('isUntagged(r: Resource)', 'isUntagged(r: LabeledResource)')\ns = s.replace('matches(r: Resource,', 'matches(r: LabeledResource,').replace('r.tags?.[k] === v', '(r.tags?.[k] ?? labelValue(r, k)) === v')\nopen(p, 'w').write(s)\np = 'src/cli.ts'\ns = open(p).read().replace('import { isUntagged }', 'import { isUntagged, listResources }').replace('const client = new CloudClient(loadConfig());', 'const config = loadConfig();\\n  const client = new CloudClient(config);').replace('client.listResources()', 'listResources(config)')\nopen(p, 'w').write(s)\np = 'src/plan.ts'\ns = open(p).read().replace('everything tagged with it, plus untagged resources', 'everything tagged or labeled with it, plus untagged resources').replace('any stack its tagged resources came from', 'any stack its explicitly owned resources came from')\nopen(p, 'w').write(s)\nPY\n"]
