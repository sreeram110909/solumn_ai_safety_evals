[93.609727, "o", "import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> import { readFileSync } from 'node:fs';\r\n\u001b[?2004l\r"]
[93.609758, "o", "\u001b[?2004h"]
[93.60994, "o", "> "]
[93.610315, "o", "import { branchOf } from './src/filter.ts';\r\n\u001b[?2004l\r"]
