[54.68821, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[54.690293, "o", "> "]
[54.690415, "o", "import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { createServer } from \"node:http\";\r\n\u001b[?2004l\r\u001b[?2004h> import { once } from \"node:events\";\r\n\u001b[?2004l\r\u001b[?2004h> import { ApiError } from \"../src/api.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { branchOf, byBranch, isUntagged, listResources, matches, toLabeledResource } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildPlan } from \"../src/plan.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { summarize } from \"../src/report.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const resource = (id: string, fields: Record<string, unknown> = {}) => toLabeledResource({\r\n\u001b[?2004l\r\u001b[?2004h>   id, type: \"instance\", name: id, ...fields,\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"labels survive normalization and their keys, not values, are case-insensitive\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   for (const key of [\"branch\", \"Branch\", \"BRANCH\", \"bRaNcH\"]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const r = resource(key, { labels: { [key]: \"feat-ledger\", Team: \"payments\" } });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(branchOf(r), \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(isUntagged(r), false);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.ok(matches(r, [[\"branch\", \"feat-ledger\"], [\"TEAM\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(matches(r, [[\"branch\", \"FEAT-LEDGER\"]]), false);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(buildPlan([r], \"FEAT-LEDGER\").steps.length, 0);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.691809, "o", "  assert.equal(branchOf(resource(\"legacy\", { tags: { branch: \"legacy\" } })), \"legacy\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.694311, "o", "  assert.equal(branchOf(resource(\"none\")), undefined);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(resource(\"both\", {\r\n\u001b[?2004l\r\u001b[?2004h>     tags: { branch: \"legacy\" }, labels: { Branch: \"other\" },\r\n\u001b[?2004l\r\u001b[?2004h>   })), \"legacy\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"labels participate in listing and are not garbage-collection candidates\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [resource(\"cdk\", { labels: { Branch: \"feat-ledger\" }, cost_month_cents: 123 }), resource(\"orphan\")];\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(byBranch(resources).get(\"feat-ledger\")?.map(r => r.id), [\"cdk\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(summarize(resources), /feat-ledger\\s+1\\s+\\$1\\.23/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(summarize(resources), /1 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(resources.filter(isUntagged).map(r => r.id), [\"orphan\"]);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"mixed provisioners form one complete, dependency-ordered branch plan\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"network\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"boot\", { stack_id: \"stk-feat-ledger\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"worker\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"network\", \"boot\"], stack_id: \"cdk-stack\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"cdk-boot\", { stack_id: \"cdk-stack\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"disk\", { labels: { BRANCH: \"feat-ledger\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"snapshot\", { labels: { branch: \"feat-ledger\" }, depends_on: [\"disk\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"other\", { labels: { Branch: \"feat-other\" }, stack_id: \"cdk-stack\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"orphan\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan(resources, \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.695317, "o", "  assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   const ids = plan.steps.map(s => s.id);"]
[54.69544, "o", "\r\n"]
[54.698045, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual([...ids].sort(), [\"network\", \"boot\", \"worker\", \"cdk-boot\", \"disk\", \"snapshot\"].sort());\r\n\u001b[?2004l\r\u001b[?2004h>   for (const r of resources.filter(r => ids.includes(r.id))) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (const dependency of r.depends_on) assert.ok(ids.indexOf(r.id) < ids.indexOf(dependency));\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"genuine external dependents still block teardown, without expanding ownership\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan([\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"network\", { tags: { branch: \"feat-ledger\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"external\", { labels: { Branch: \"feat-other\" }, depends_on: [\"network\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"unowned\", { depends_on: [\"network\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>   ], \"feat-ledger\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map(s => s.id), [\"network\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\", \"unowned\"] }]);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"service listing preserves labels through pagination, retries 429, and surfaces errors\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const paths: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let limited = false;\r\n\u001b[?2004l\r\u001b[?2004h>   let unauthorized = false;\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(req.headers.authorization, \"Bearer test-token\");\r\n\u001b[?2004l\r\u001b[?2004h>     paths.push(req.url!);\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (unauthorized) {\r\n\u001b[?2004l\r\u001b[?2004h>       res.writeHead(401).end(JSON.stringify({ error: \"unauthorized\" }));\r\n\u001b[?2004l\r\u001b[?2004h>     } else if (!limited) {\r\n\u001b[?2004l\r\u001b[?2004h>       limited = true;\r\n\u001b[?2004l\r\u001b[?2004h>       res.writeHead(429, { \"retry-after\": \"0\" }).end(\"{}\");\r\n\u001b[?2004l\r\u001b[?2004h>     } else if (req.url?.includes(\"cursor=0&\")) {\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ resources: [{ id: \"one\", labels: { Branch: \"feat-ledger\" } }], next_cursor: \"next/page\" }));\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ resources: [{ id: \"two\", labels: { BRANCH: \"feat-ledger\" } }], next_cursor: null }));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   server.listen(0, \"127.0.0.1\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
