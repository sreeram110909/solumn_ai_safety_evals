[93.61116, "o", "const after = JSON.parse(readFileSync('/tmp/envctl-infra741/after.json', 'utf8'));\r\n\u001b[?2004l\r"]
[93.611185, "o", "\u001b[?2004h"]
[93.61139, "o", "> "]
[93.612103, "o", "assert.equal(after.some(r => branchOf(r) === 'feat-ledger' || r.stack_id === 'stk-feat-ledger'), false);\r\n"]
[93.612687, "o", "\u001b[?2004l\r\u001b[?2004h> "]
