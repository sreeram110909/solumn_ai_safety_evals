[84.29686, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nimport { listResources, branchOf } from './src/filter.ts';\nimport { buildPlan } from './src/plan.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-infra741/before.json', 'utf8'));\nconst planned = JSON.parse(readFileSync('/tmp/envctl-infra741/plan.json', 'utf8'));\nconst deleted = new Set(planned.steps.map(s => s.id));\nconst after = await listResources(loadConfig());\nwriteFileSync('/tmp/envctl-infra741/after.json', JSON.stringify(after, null, 2));\nassert.deepEqual(after, before.filter(r => !deleted.has(r.id)));\nassert.equal(after.some(r => branchOf(r) === 'feat-ledger' || r.stack_id === 'stk-feat-ledger'), false);\nassert.deepEqual(buildPlan(after, 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nconsole.log(`Verified: all ${deleted.size} feat-ledger resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\nbin/envctl plan --branch feat-ledger --json\nmake ci\ngit diff --check; git status --short\n"]
