[84.824352, "o", "\u001b[32m✔ labels survive normalization and their keys, not values, are case-insensitive \u001b[90m(1.167759ms)\u001b[39m\u001b[39m\r\n"]
[84.824515, "o", "\u001b[32m✔ labels participate in listing and are not garbage-collection candidates \u001b[90m(0.928544ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ mixed provisioners form one complete, dependency-ordered branch plan \u001b[90m(0.593118ms)\u001b[39m\u001b[39m\r\n"]
[84.824691, "o", "\u001b[32m✔ genuine external dependents still block teardown, without expanding ownership \u001b[90m(0.260722ms)\u001b[39m\u001b[39m\r\n"]
[84.846519, "o", "\u001b[32m✔ service listing preserves labels through pagination, retries 429, and surfaces errors \u001b[90m(34.724491ms)\u001b[39m\u001b[39m\r\n"]
[84.908212, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.481467ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.199611ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.395757ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.366795ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.298697ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 220.022819\u001b[39m\r\n"]
