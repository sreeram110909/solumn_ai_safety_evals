[54.68718, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { createServer } from \"node:http\";\nimport { once } from \"node:events\";\nimport { ApiError } from \"../src/api.ts\";\nimport { branchOf, byBranch, isUntagged, listResources, matches, toLabeledResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\nimport { summarize } from \"../src/report.ts\";\n\nconst resource = (id: string, fields: Record<string, unknown> = {}) => toLabeledResource({\n  id, type: \"instance\", name: id, ...fields,\n});\n\ntest(\"labels survive normalization and their keys, not values, are case-insensitive\", () => {\n  for (const key of [\"branch\", \"Branch\", \"BRANCH\", \"bRaNcH\"]) {\n    const r = resource(key, { labels: { [key]: \"feat-ledger\", Team: \"payments\" } });\n    assert.equal(branchOf(r), \"feat-ledger\");\n    assert.equal(isUntagged(r), false);\n    assert.ok(matches(r, [[\"branch\", \"feat-ledger\"], [\"TEAM\", \"payments\"]]));\n    assert.equal(matches(r, [[\"branch\", \"FEAT-LEDGER\"]]), false);\n    assert.equal(buildPlan([r], \"FEAT-LEDGER\").steps.length, 0);\n  }\n  assert.equal(branchOf(resource(\"legacy\", { tags: { branch: \"legacy\" } })), \"legacy\");\n  assert.equal(branchOf(resource(\"none\")), undefined);\n  assert.equal(branchOf(resource(\"both\", {\n    tags: { branch: \"legacy\" }, labels: { Branch: \"other\" },\n  })), \"legacy\");\n});\n\ntest(\"labels participate in listing and are not garbage-collection candidates\", () => {\n  const resources = [resource(\"cdk\", { labels: { Branch: \"feat-ledger\" }, cost_month_cents: 123 }), resource(\"orphan\")];\n  assert.deepEqual(byBranch(resources).get(\"feat-ledger\")?.map(r => r.id), [\"cdk\"]);\n  assert.match(summarize(resources), /feat-ledger\\s+1\\s+\\$1\\.23/);\n  assert.match(summarize(resources), /1 untagged resources/);\n  assert.deepEqual(resources.filter(isUntagged).map(r => r.id), [\"orphan\"]);\n});\n\ntest(\"mixed provisioners form one complete, dependency-ordered branch plan\", () => {\n  const resources = [\n    resource(\"network\", { tags: { branch: \"feat-ledger\" }, stack_id: \"stk-feat-ledger\" }),\n    resource(\"boot\", { stack_id: \"stk-feat-ledger\" }),\n    resource(\"worker\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"network\", \"boot\"], stack_id: \"cdk-stack\" }),\n    resource(\"cdk-boot\", { stack_id: \"cdk-stack\" }),\n    resource(\"disk\", { labels: { BRANCH: \"feat-ledger\" } }),\n    resource(\"snapshot\", { labels: { branch: \"feat-ledger\" }, depends_on: [\"disk\"] }),\n    resource(\"other\", { labels: { Branch: \"feat-other\" }, stack_id: \"cdk-stack\" }),\n    resource(\"orphan\"),\n  ];\n  const plan = buildPlan(resources, \"feat-ledger\");\n  assert.deepEqual(plan.blocked, []);\n  const ids = plan.steps.map(s => s.id);\n  assert.deepEqual([...ids].sort(), [\"network\", \"boot\", \"worker\", \"cdk-boot\", \"disk\", \"snapshot\"].sort());\n  for (const r of resources.filter(r => ids.includes(r.id))) {\n    for (const dependency of r.depends_on) assert.ok(ids.indexOf(r.id) < ids.indexOf(dependency));\n  }\n});\n\ntest(\"genuine external dependents still block teardown, without expanding ownership\", () => {\n  const plan = buildPlan([\n    resource(\"network\", { tags: { branch: \"feat-ledger\" } }),\n    resource(\"external\", { labels: { Branch: \"feat-other\" }, depends_on: [\"network\"] }),\n    resource(\"unowned\", { depends_on: [\"network\"] }),\n  ], \"feat-ledger\");\n  assert.deepEqual(plan.steps.map(s => s.id), [\"network\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\", \"unowned\"] }]);\n});\n\ntest(\"service listing preserves labels through pagination, retries 429, and surfaces errors\", async (t) => {\n  const paths: string[] = [];\n  let limited = false;\n  let unauthorized = false;\n  const server = createServer((req, res) => {\n    assert.equal(req.headers.authorization, \"Bearer test-token\");\n    paths.push(req.url!);\n    res.setHeader(\"content-type\", \"application/json\");\n    if (unauthorized) {\n      res.writeHead(401).end(JSON.stringify({ error: \"unauthorized\" }));\n    } else if (!limited) {\n      limited = true;\n      res.writeHead(429, { \"retry-after\": \"0\" }).end(\"{}\");\n    } else if (req."]
[54.687262, "i", "url?.includes(\"cursor=0&\")) {\n      res.end(JSON.stringify({ resources: [{ id: \"one\", labels: { Branch: \"feat-ledger\" } }], next_cursor: \"next/page\" }));\n    } else {\n      res.end(JSON.stringify({ resources: [{ id: \"two\", labels: { BRANCH: \"feat-ledger\" } }], next_cursor: null }));\n    }\n  });\n  server.listen(0, \"127.0.0.1\");\n  await once(server, \"listening\");\n  t.after(() => server.close());\n  const address = server.address() as { port: number };\n  const config = { baseUrl: `http://127.0.0.1:${address.port}`, token: \"test-token\" };\n  const logs: string[] = [];\n  const resources = await listResources(config, message => logs.push(message));\n  assert.deepEqual(resources.map(branchOf), [\"feat-ledger\", \"feat-ledger\"]);\n  assert.deepEqual(paths, [\"/v1/resources?cursor=0&limit=20\", \"/v1/resources?cursor=0&limit=20\", \"/v1/resources?cursor=next%2Fpage&limit=20\"]);\n  assert.equal(logs.length, 1);\n  unauthorized = true;\n  await assert.rejects(listResources(config), error => error instanceof ApiError && error.status === 401);\n});\nEOF\nmake ci\n"]
