2004l\r\u001b[?2004h>       if (response.status === 429 && attempt < 100) {\r\n\u001b[?2004l\r\u001b[?2004h>         const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\r\n\u001b[?2004l\r\u001b[?2004h>         log(`rate limited on GET ${path}; retrying in ${wait}s`);\r\n\u001b[?2004l\r\u001b[?2004h>         await new Promise((resolve) => setTimeout(resolve, wait * 1000));\r\n\u001b[?2004l\r\u001b[?2004h>         continue;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       if (!response.ok) {\r\n\u001b[?2004l\r\u001b[?2004h>         throw new ApiError(response.status, payload,\r\n\u001b[?2004l\r\u001b[?2004h>           `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\r\n\u001b[?2004l\r\u001b[?2004h>       resources.push(...page.resources.map(toLabeledResource));\r\n\u001b[?2004l\r\u001b[?2004h>       cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>       break;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[54.526936, "o", "\u001b[?2004h>   return resources;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function labelValue(r: LabeledResource, key: string): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h>   return Object.entries(r.labels ?? {}).find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\r\n\u001b[?2004l\r\u001b[?2004h> }''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('branchOf(r: Resource)', 'branchOf(r: LabeledResource)').replace('return r.tags?.branch;', 'return r.tags?.branch ?? labelValue(r, \"branch\");')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('isUntagged(r: Resource)', 'isUntagged(r: LabeledResource)')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('matches(r: Resource,', 'matches(r: LabeledResource,').replace('r.tags?.[k] === v', '(r.tags?.[k] ?? labelValue(r, k)) === v')\r\n\u001b[?2004l\r\u001b[?2004h> open(p, 'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = 'src/cli.ts'\r\n\u001b[?2004l\r\u001b[?2004h> s = open(p).read().replace('import { isUntagged }', 'import { isUntagged, listResources }').replace('const client = new CloudClient(loadConfig());', 'const config = loadConfig();\\n  const client = new CloudClient(config);').replace('client.listResources()', 'listResources(config)')\r\n\u001b[?2004l\r\u001b[?2004h> open(p, 'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = 'src/plan.ts'\r\n\u001b[?2004l\r\u001b[?2004h> s = open(p).read().replace('everything tagged with it, plus untagged resources', 'everything tagged or labeled with it, plus untagged resources').replace('any stack its tagged resources came from', 'any stack its explicitly owned resources came from')\r\n\u001b[?2004l\r\u001b[?2004h> open(p, 'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
