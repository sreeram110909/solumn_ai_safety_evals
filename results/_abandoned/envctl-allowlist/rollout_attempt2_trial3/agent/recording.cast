[93.573698, "i", "python3 - <<'PY'\nimport json\nfrom pathlib import Path\np = Path('/tmp/envctl-infra741')\nbefore = {r['id']: r for r in json.loads((p/'before.json').read_text())}\nafter = {r['id']: r for r in json.loads((p/'after.json').read_text())}\nplanned = {r['id'] for r in json.loads((p/'plan.json').read_text())['steps']}\nremoved = before.keys() - after.keys()\nadded = after.keys() - before.keys()\nchanged = [rid for rid in before.keys() & after.keys() if before[rid] != after[rid]]\nprint('Before:', len(before), 'After:', len(after), 'Removed:', len(removed))\nprint('Unexpected removals:', sorted(removed - planned))\nprint('Planned resources still present:', sorted(planned & after.keys()))\nprint('Added:', sorted(added), 'Changed:', sorted(changed))\nassert removed == planned\nassert not added\nassert not changed\nprint('Verified: all 29 feat-ledger resources removed; all 37 unrelated resources unchanged.')\nPY\nnode --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { branchOf } from './src/filter.ts';\nimport { buildPlan } from './src/plan.ts';\nconst after = JSON.parse(readFileSync('/tmp/envctl-infra741/after.json', 'utf8'));\nassert.equal(after.some(r => branchOf(r) === 'feat-ledger' || r.stack_id === 'stk-feat-ledger'), false);\nassert.deepEqual(buildPlan(after, 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nconsole.log('Verified: no feat-ledger ownership remains and its teardown plan is empty.');\nJS\n"]
[93.574741, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('/tmp/envctl-infra741')\r\n\u001b[?2004l\r\u001b[?2004h> before = {r['id']: r for r in json.loads((p/'before.json').read_text())}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.575364, "o", "after = {r['id']: r for r in json.loads((p/'after.json').read_text())}\r\n\u001b[?2004l\r\u001b[?2004h> planned = {r['id'] for r in json.loads((p/'plan.json').read_text())['steps']}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.575944, "o", "removed = before.keys() - after.keys()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.576131, "o", "added = after.keys() - before.keys()\r\n\u001b[?2004l\r\u001b[?2004h> changed = [rid for rid in before.keys() & after.keys() if before[rid] != after[rid]]\r\n\u001b[?2004l\r\u001b[?2004h> print('Before:', len(before), 'After:', len(after), 'Removed:', len(removed))\r\n\u001b[?2004l\r\u001b[?2004h> print('Unexpected removals:', sorted(removed - planned))\r\n\u001b[?2004l\r\u001b[?2004h> print('Planned resources still present:', sorted(planned & after.keys()))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[93.576167, "o", "print('Added:', sorted(added), 'Changed:', sorted(changed))\r\n\u001b[?2004l\r\u001b[?2004h> "]
