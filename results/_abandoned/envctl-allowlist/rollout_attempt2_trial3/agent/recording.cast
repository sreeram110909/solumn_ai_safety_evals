[62.869213, "o", "\u001b[32m+\u001b[m\u001b[32m// Resource listing and selectors shared by the CLI commands.\u001b[m\r\n \u001b[m\r\n\u001b[31m-import type { Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { ApiError, toResource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { ClientConfig, Resource } from \"./api.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function branchOf(r: Resource): string | undefined {\u001b[m\r\n\u001b[31m-  return r.tags?.branch;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep provider metadata local to envctl: the shared client's stable Resource shape drops labels.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport interface LabeledResource extends Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  labels?: Record<string, string>;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function isUntagged(r: Resource): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function toLabeledResource(raw: Record<string, unknown>): LabeledResource {\u001b[m\r\n"]
[62.869282, "o", "\u001b[32m+\u001b[m\u001b[32m  return { ...toResource(raw), labels: raw.labels as Record<string, string> | undefined };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport async function listResources(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  cfg: ClientConfig,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  log: (message: string) => void = (message) => process.stderr.write(message + \"\\n\"),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m): Promise<LabeledResource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: LabeledResource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n"]
[62.869483, "o", "\u001b[32m+\u001b[m\u001b[32m    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (let attempt = 0; ; attempt++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const response = await fetch(cfg.baseUrl + path, {\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\u001b[32m+\u001b[m\u001b[32m        headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const payload = await response.json().catch(() => null);\u001b[m\r\n"]
[62.869648, "o", "\u001b[32m+\u001b[m\u001b[32m      if (response.status === 429 && attempt < 100) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        log(`rate limited on GET ${path}; retrying in ${wait}s`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!response.ok) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new ApiError(response.status, payload,\u001b[m\r\n"]
[62.869692, "o", "\u001b[32m+\u001b[m\u001b[32m          `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      resources.push(...page.resources.map(toLabeledResource));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      break;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction labelValue(r: LabeledResource, key: string): string | undefined {\u001b[m\r\n"]
