[?2004l if (req.method === "GET" && url.pathname === "/v1/resources") {
      if (retry) {
        retry = false;
        res.setHeader("retry-after", "0");
        return send(429, { error: "rate limited" });
      }
      assert.equal(url.searchParams.get("limit"), "20");
      const remaining = resources.filter((r) => !deleted.includes(r.id));
      const cursor = url.searchParams.get("cursor");
      assert.ok(cursor === "0" || cursor === "next/page+2");
      return send(200, {
        resources: cursor === "0" ? remaining.slice(0, 2) : remaining.slice(2),
        next_cursor: cursor === "0" ? "next/page+2" : null,
      });
    }
    if (req.method === "DELETE") {
      const id = decodeURIComponent(url.pathname.slice("/v1/resources/".length));
      if (resources.some((r) => !deleted.includes(r.id) && r.depends_on.includes(id))) {
        return send(409, { error: "resource has dependents" });
      }
      if (!resources.some((r) => r.id === id)) return send(404, { error: "not found" });
      deleted.push(id);
      return send(200, { deleted: id });
    }
    send(404, { error: "not found" });
  });
  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));
  const address = server.address() as { port: number };
  const run = (...args: string[]) => exec(cli, args, {
    env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: "test-token" },
    timeout: 10000,
  });
  return { run, deleted, paths };
}

test("CLI plan reads labels on later pages and retries rate limits", async (t) => {
  const { run, deleted, paths } = await fixture(t);
  const result = await run("plan", "--branch", "feat-a", "--json");
  const plan = JSON.parse(result.stdout);
  assert.deepEqual(plan.steps.map((s: { id: string }) => s.id), ["worker", "net", "boot"]);
  assert.deepEqual(plan.blocked, []);
  assert.match(result.stderr, /rate limited/);
  assert.ok(paths.includes("/v1/resources?cursor=next%2Fpage%2B2&limit=20"));
  assert.deepEqual(deleted, []);
});

test("CLI list and gc recognize label-owned resources", async (t) => {
  const { run, deleted } = await fixture(t);
  const list = await run("list");
  assert.match(list.stdout, /feat-a\s+2/);
  assert.match(list.stdout, /feat-a-v2\s+1/);
  assert.match(list.stdout, /1 untagged resources/);
  const gc = await run("gc", "--untagged");
  assert.match(gc.stdout, /1 untagged resources/);
  assert.deepEqual(deleted, []);
});

