[77.376776, "o", "    { id: \"net\", type: \"network\", name: \"net\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"boot\", type: \"volume\", name: \"boot\", stack_id: \"stk-feat-a\", depends_on: [] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"worker\", type: \"instance\", name: \"worker\", labels: { bRaNcH: \"feat-a\", Team: \"payments\" }, depends_on: [\"net\", \"boot\"] },\r\n\u001b[?2004l\r\u001b[?2004h>     { id: \"other\", type: \"instance\", name: \"feat-a-similar\", labels: { Branch: external ? \"feat-b\" : \"feat-a-v2\" }, depends_on: external ? [\"net\"] : [] },\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const paths: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let retry = true;\r\n\u001b[?2004l\r\u001b[?2004h>   const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     paths.push(req.url!);\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h>     const send = (code: number, body: unknown) => { res.writeHead(code); res.end(JSON.stringify(body)); };\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.headers.authorization !== \"Bearer test-token\") return send(401, { error: \"bad token\" });\r\n\u001b[?2004l\r\u001b[?2004h>     const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n\u001b[?2004l\r\u001b[?2004h>       if (retry) {\r\n\u001b[?2004l\r\u001b[?2004h>         retry = false;\r\n\u001b[?2004l\r\u001b[?2004h>         res.setHeader(\"retry-after\", \"0\");\r\n\u001b[?2004l\r\u001b[?2004h>         return send(429, { error: \"rate limited\" });\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       assert.equal(url.searchParams.get(\"limit\"), \"20\");\r\n\u001b[?2004l\r\u001b[?2004h>       const remaining = resources.filter((r) => !deleted.includes(r.id));\r\n\u001b[?2004l\r\u001b[?2004h>       const cursor = url.searchParams.get(\"cursor\");\r\n\u001b[?2004l\r\u001b[?2004h>       assert.ok(cursor === \"0\" || cursor === \"next/page+2\");\r\n\u001b[?2004l\r\u001b[?2004h>       return send(200, {\r\n\u001b[?2004l\r\u001b[?2004h>         resources: cursor === \"0\" ? remaining.slice(0, 2) : remaining.slice(2),\r\n\u001b[?2004l\r\u001b[?2004h>         next_cursor: cursor === \"0\" ? \"next/page+2\" : null,\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"DELETE\") {\r\n\u001b[?2004l\r\u001b[?2004h>       const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\r\n\u001b[?2004l\r\u001b[?2004h>       if (resources.some((r) => !deleted.includes(r.id) && r.depends_on.includes(id))) {\r\n\u001b[?2004l\r\u001b[?2004h>         return send(409, { error: \"resource has dependents\" });\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       if (!resources.some((r) => r.id === id)) return send(404, { error: \"not found\" });\r\n\u001b[?2004l\r\u001b[?2004h>       deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h>       return send(200, { deleted: id });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     send(404, { error: \"not found\" });\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h> "]
