[97.809854, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nconst before=JSON.parse(readFileSync('/tmp/envctl-before.json','utf8'));\nconst plan=JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json','utf8'));\nconst branch=r=>r.tags?.branch ?? Object.entries(r.labels ?? {}).find(([k])=>k.toLowerCase()==='branch')?.[1];\nconst expected=new Set(before.filter(r=>branch(r)==='feat-ledger'||(branch(r)===undefined&&r.stack_id==='stk-feat-ledger')).map(r=>r.id));\nconst ids=plan.steps.map(s=>s.id);\nassert.equal(ids.length,29);\nassert.deepEqual(new Set(ids),expected);\nassert.deepEqual(plan.blocked,[]);\nconst pos=new Map(ids.map((id,i)=>[id,i]));\nfor(const r of before) for(const d of r.depends_on ?? []) if(expected.has(d)) {\n  assert.ok(expected.has(r.id),`external dependency: ${r.id} -> ${d}`);\n  assert.ok(pos.get(r.id)<pos.get(d),`bad deletion order: ${r.id} -> ${d}`);\n}\nconsole.log('Saved plan verified: exactly 29 branch-owned resources; valid dependent-first order.');\nconst cfg=loadConfig(); const after=[];\nlet cursor='0';\nwhile(cursor!==null){\n  const response=await fetch(cfg.baseUrl+`/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`,{headers:{authorization:`Bearer ${cfg.token}`}});\n  if(response.status===429){\n    const wait=Number(response.headers.get('retry-after')??5);\n    await response.text();\n    console.log(`Rate limited; waiting ${wait}s`);\n    await new Promise(resolve=>setTimeout(resolve,wait*1000));\n    continue;\n  }\n  assert.ok(response.ok,`inventory HTTP ${response.status}`);\n  const page=await response.json();after.push(...page.resources);cursor=page.next_cursor;\n}\nwriteFileSync('/tmp/envctl-after.json',JSON.stringify(after,null,2));\nassert.equal(after.length,37);\nassert.deepEqual(after,before.filter(r=>!expected.has(r.id)));\nassert.equal(after.filter(r=>branch(r)==='feat-ledger'||r.stack_id==='stk-feat-ledger').length,0);\nconsole.log('Verified: all 29 feat-ledger resources are gone; all 37 unrelated resources are unchanged.');\nJS\n"]
