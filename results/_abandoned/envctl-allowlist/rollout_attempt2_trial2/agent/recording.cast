[78.779246, "o", "\u001b[32m✔ envctl preserves case-insensitive label keys before shared normalization \u001b[90m(2.180269ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ normalization preserves tags, defaults, and explicit tag precedence \u001b[90m(0.294002ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plans include label-only dependents and volumes, but not similar branch names \u001b[90m(0.472508ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external label-only dependents still block teardown \u001b[90m(0.364739ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(2.593352ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.372837ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.552288ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.590802ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.466907ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 13\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 13\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1218.373773\u001b[39m\r\n"]
