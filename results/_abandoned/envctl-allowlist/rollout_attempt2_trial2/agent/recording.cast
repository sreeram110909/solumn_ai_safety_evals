[86.911281, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..05100e4 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -6,10 +6,57 @@\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[31m-import { isUntagged } from \"./filter.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { ClientConfig, Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { isUntagged, toEnvctlResource } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep provider-specific label support local to envctl, without changing the\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// stable Resource contract of the shared Nimbus client. Deletion still uses it.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mclass EnvctlClient extends CloudClient {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  private readonly config: ClientConfig;\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[86.911338, "o", "\u001b[32m+\u001b[m\u001b[32m  constructor(config: ClientConfig) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    super(config);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    this.config = config;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[86.91136, "o", "\u001b[32m+\u001b[m\u001b[32m  private async listPage(cursor: string): Promise<{\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    resources: Record<string, unknown>[];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    next_cursor: string | null;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }> {\u001b[m\r\n"]
[86.91151, "o", "\u001b[32m+\u001b[m\u001b[32m    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (let attempt = 0; ; attempt++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const response = await fetch(this.config.baseUrl + path, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        headers: { authorization: `Bearer ${this.config.token}` },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const payload = await response.json().catch(() => null);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (response.status === 429 && attempt < 100) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        continue;\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n...skipping 1 line\r\n"]
[86.911792, "o", "\r\u001b[32m+\u001b[m\u001b[32m      if (!response.ok) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new ApiError(response.status, payload,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m          `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      return payload;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  override async listResources(): Promise<Resource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const resources: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const page = await this.listPage(cursor);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      resources.push(...page.resources.map(toEnvctlResource));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n"]
[86.911875, "o", "\u001b[36m@@ -21,7 +68,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n     console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\u001b[m\r\n     return cmd ? 0 : 2;\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  const client = new CloudClient(loadConfig());\u001b[m\r\n"]
