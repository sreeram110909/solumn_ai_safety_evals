[54.211117, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport {loadConfig} from './src/api.ts';\nimport {writeFileSync} from 'node:fs';\nconst cfg=loadConfig(); const all=[];\nlet cursor='0';\nwhile(cursor!==null){\n  const r=await fetch(cfg.baseUrl+`/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`,{headers:{authorization:`Bearer ${cfg.token}`}});\n  if(!r.ok) throw new Error(`inventory HTTP ${r.status}`);\n  const p=await r.json(); all.push(...p.resources);cursor=p.next_cursor;\n}\nwriteFileSync('/tmp/envctl-before.json',JSON.stringify(all,null,2));\nconsole.log('Total resources:',all.length);\nconsole.log('Label resources:',JSON.stringify(all.filter(r=>r.labels).map(({id,labels,stack_id,depends_on})=>({id,labels,stack_id,depends_on})),null,2));\nJS\n"]
