[77.363403, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { toResource } from \"../src/api.ts\";\nimport { branchOf, byBranch, isUntagged, matches, toEnvctlResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\n\nfunction raw(id: string, fields: Record<string, unknown> = {}): Record<string, unknown> {\n  return { id, type: \"instance\", name: id, ...fields };\n}\n\ntest(\"envctl preserves case-insensitive label keys before shared normalization\", () => {\n  const input = raw(\"cdk\", { labels: { bRaNcH: \"Feat-A\", TEAM: \"payments\" } });\n  const r = toEnvctlResource(input);\n  assert.equal(branchOf(r), \"Feat-A\");\n  assert.ok(matches(r, [[\"team\", \"payments\"]]));\n  assert.equal(isUntagged(r), false);\n  assert.equal(byBranch([r]).get(\"Feat-A\")?.length, 1);\n  assert.equal(buildPlan([r], \"feat-a\").steps.length, 0); // values are exact\n  assert.equal(buildPlan([r], \"Feat-A\").steps.length, 1);\n  assert.deepEqual(toResource(input).tags, {}); // shared contract unchanged\n  assert.equal(input.tags, undefined); // no input mutation\n});\n\ntest(\"normalization preserves tags, defaults, and explicit tag precedence\", () => {\n  const r = toEnvctlResource(raw(\"mixed\", {\n    labels: { Branch: \"feat-a\", Team: \"payments\" },\n    tags: { branch: \"feat-b\", owner: \"ops\" },\n  }));\n  assert.deepEqual(r.tags, { branch: \"feat-b\", team: \"payments\", owner: \"ops\" });\n  assert.deepEqual(toEnvctlResource(raw(\"empty\", { tags: null, labels: null })).tags, {});\n  assert.deepEqual(r.depends_on, []);\n  assert.equal(r.stack_id, null);\n});\n\ntest(\"plans include label-only dependents and volumes, but not similar branch names\", () => {\n  const resources = [\n    raw(\"net\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    raw(\"boot\", { stack_id: \"stk-feat-a\" }),\n    raw(\"cdk-volume\", { labels: { BRANCH: \"feat-a\" } }),\n    raw(\"cdk-instance\", { labels: { Branch: \"feat-a\" }, depends_on: [\"net\", \"boot\", \"cdk-volume\"] }),\n    raw(\"other\", { labels: { Branch: \"feat-a-v2\" } }),\n    raw(\"other-stack\", { stack_id: \"stk-feat-a-v2\" }),\n    raw(\"conflicting-tag\", { tags: { branch: \"feat-b\" }, stack_id: \"stk-feat-a\" }),\n    raw(\"orphan\"),\n  ].map(toEnvctlResource);\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((s) => s.id).sort(), [\"boot\", \"cdk-instance\", \"cdk-volume\", \"net\"]);\n  assert.equal(plan.steps[0].id, \"cdk-instance\");\n});\n\ntest(\"genuine external label-only dependents still block teardown\", () => {\n  const resources = [\n    raw(\"net\", { tags: { branch: \"feat-a\" } }),\n    raw(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"net\"] }),\n  ].map(toEnvctlResource);\n  assert.deepEqual(buildPlan(resources, \"feat-a\").blocked, [{ id: \"net\", dependents: [\"external\"] }]);\n});\nEOF\ncat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { fileURLToPath } from \"node:url\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\nconst cli = fileURLToPath(new URL(\"../bin/envctl\", import.meta.url));\n\nasync function fixture(t: { after: (fn: () => Promise<void>) => void }, external = false) {\n  const resources = [\n    { id: \"net\", type: \"network\", name: \"net\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\", depends_on: [] },\n    { id: \"boot\", type: \"volume\", name: \"boot\", stack_id: \"stk-feat-a\", depends_on: [] },\n    { id: \"worker\", type: \"instance\", name: \"worker\", labels: { bRaNcH: \"feat-a\", Team: \"payments\" }, depends_on: [\"net\", \"boot\"] },\n    { id: \"other\", type: \"instance\", name: \"feat-a-similar\", labels: { Branch: external ? \"feat-b\" : \"feat-a-v2\" }, depends_on: external ? [\"net\"] : [] },\n  ];\n  const deleted: string[] = [];\n  const paths: string[] = [];\n  let retry = true;\n  const server = createServer((req, res) => {\n    paths.push(req.url!);\n    res.setHeader(\"content-type\", \"application/json\");\n    const send = (code: number, body: unknown) => { res.writeHead"]
[77.363529, "i", "(code); res.end(JSON.stringify(body)); };\n    if (req.headers.authorization !== \"Bearer test-token\") return send(401, { error: \"bad token\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      if (retry) {\n        retry = false;\n        res.setHeader(\"retry-after\", \"0\");\n        return send(429, { error: \"rate limited\" });\n      }\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      const remaining = resources.filter((r) => !deleted.includes(r.id));\n      const cursor = url.searchParams.get(\"cursor\");\n      assert.ok(cursor === \"0\" || cursor === \"next/page+2\");\n      return send(200, {\n        resources: cursor === \"0\" ? remaining.slice(0, 2) : remaining.slice(2),\n        next_cursor: cursor === \"0\" ? \"next/page+2\" : null,\n      });\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      if (resources.some((r) => !deleted.includes(r.id) && r.depends_on.includes(id))) {\n        return send(409, { error: \"resource has dependents\" });\n      }\n      if (!resources.some((r) => r.id === id)) return send(404, { error: \"not found\" });\n      deleted.push(id);\n      return send(200, { deleted: id });\n    }\n    send(404, { error: \"not found\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address() as { port: number };\n  const run = (...args: string[]) => exec(cli, args, {\n    env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n    timeout: 10000,\n  });\n  return { run, deleted, paths };\n}\n\ntest(\"CLI plan reads labels on later pages and retries rate limits\", async (t) => {\n  const { run, deleted, paths } = await fixture(t);\n  const result = await run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  const plan = JSON.parse(result.stdout);\n  assert.deepEqual(plan.steps.map((s: { id: string }) => s.id), [\"worker\", \"net\", \"boot\"]);\n  assert.deepEqual(plan.blocked, []);\n  assert.match(result.stderr, /rate limited/);\n  assert.ok(paths.includes(\"/v1/resources?cursor=next%2Fpage%2B2&limit=20\"));\n  assert.deepEqual(deleted, []);\n});\n\ntest(\"CLI list and gc recognize label-owned resources\", async (t) => {\n  const { run, deleted } = await fixture(t);\n  const list = await run(\"list\");\n  assert.match(list.stdout, /feat-a\\s+2/);\n  assert.match(list.stdout, /feat-a-v2\\s+1/);\n  assert.match(list.stdout, /1 untagged resources/);\n  const gc = await run(\"gc\", \"--untagged\");\n  assert.match(gc.stdout, /1 untagged resources/);\n  assert.deepEqual(deleted, []);\n});\n\ntest(\"CLI teardown deletes branch resources in dependent-first order only\", async (t) => {\n  const { run, deleted } = await fixture(t);\n  await run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  assert.deepEqual(deleted, []);\n  const result = await run(\"teardown\", \"--branch\", \"feat-a\");\n  assert.match(result.stdout, /complete \\(3 resources\\)/);\n  assert.deepEqual(deleted, [\"worker\", \"net\", \"boot\"]);\n});\n\ntest(\"CLI refuses teardown if another branch genuinely depends on it\", async (t) => {\n  const { run, deleted } = await fixture(t, true);\n  await assert.rejects(run(\"teardown\", \"--branch\", \"feat-a\"), (error: any) => {\n    assert.equal(error.code, 1);\n    assert.match(error.stderr, /refusing to tear down/);\n    assert.match(error.stdout, /other.*outside this branch/);\n    return true;\n  });\n  assert.deepEqual(deleted, []);\n});\nEOF\nmake ci\n"]
