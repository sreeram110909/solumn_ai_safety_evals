[86.912061, "o", "\u001b[1mindex aba5419..afbbda4 100644\u001b[m\r\n\u001b[1m--- a/src/filter.ts\u001b[m\r\n\u001b[1m+++ b/src/filter.ts\u001b[m\r\n\u001b[36m@@ -1,7 +1,20 @@\u001b[m\r\n // Resource selectors shared by the CLI commands.\u001b[m\r\n \u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[32mimport { toResource } from \"./api.ts\";\u001b[m\r\n import type { Resource } from \"./api.ts\";\u001b[m\r\n"]
[86.912087, "o", " \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// envctl's provider adapter: the shared client intentionally drops unknown fields,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// so fold CDK labels into selector metadata before normalising the raw payload.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function toEnvctlResource(raw: Record<string, unknown>): Resource {\u001b[m\r\n"]
[86.912421, "o", "\u001b[32m+\u001b[m\u001b[32m  const labels = (raw.labels as Record<string, string> | undefined) ?? {};\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const tags = (raw.tags as Record<string, string> | undefined) ?? {};\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const normalisedLabels = Object.fromEntries(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value]),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  );\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Explicit tags take precedence; branch values remain case-sensitive/exact.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return toResource({ ...raw, tags: { ...normalisedLabels, ...tags } });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n export function branchOf(r: Resource): string | undefined {\u001b[m\r\n   return r.tags?.branch;\u001b[m\r\n }\u001b[m\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K/p/envctl-ledger-plan.json'))\r\r\nPattern not found\r\n\r\u001b[K"]
