[86.903186, "i", "python3 - <<'PY'\nimport json\nresources=json.load(open('/tmp/envctl-before.json'))\nplan=json.load(open('/tmp/envctl-ledger-plan.json'))\ndef branch(r):\n    return r.get('tags',{}).get('branch',next((v for k,v in r.get('labels',{}).items() if k.lower()=='branch'),None))\nexpected={r['id'] for r in resources if branch(r)=='feat-ledger' or (branch(r) is None and r.get('stack_id')=='stk-feat-ledger')}\nids=[s['id'] for s in plan['steps']]\nassert not plan['blocked'],plan['blocked']\nassert len(ids)==len(set(ids))==29\nassert set(ids)==expected,(set(ids)-expected,expected-set(ids))\npos={id:i for i,id in enumerate(ids)}\nfor r in resources:\n    for dep in r.get('depends_on',[]):\n        if dep in expected:\n            assert r['id'] in expected,('external dependency',r['id'],dep)\n            assert pos[r['id']]<pos[dep],('bad deletion order',r['id'],dep)\nprint('Verified: exactly 29 branch-owned resources, no external dependents, valid deletion order.')\nPY\n"]
