[55.261376, "o", "  const normalisedLabels = Object.fromEntries(\r\n\u001b[?2004l\r\u001b[?2004h>     Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value]),\r\n\u001b[?2004l\r\u001b[?2004h>   );\r\n\u001b[?2004l\r\u001b[?2004h>   // Explicit tags take precedence; branch values remain case-sensitive/exact.\r\n\u001b[?2004l\r\u001b[?2004h>   return toResource({ ...raw, tags: { ...normalisedLabels, ...tags } });\r\n\u001b[?2004l\r\u001b[?2004h> }''')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> p='src/cli.ts';s=open(p).read();s=s.replace('import { isUntagged } from \"./filter.ts\";', 'import type { ClientConfig, Resource } from \"./api.ts\";\\nimport { isUntagged, toEnvctlResource } from \"./filter.ts\";')\r\n\u001b[?2004l\r\u001b[?2004h> anchor='function flag(argv: string[], name: string): string | undefined {'\r\n\u001b[?2004l\r\u001b[?2004h> new='''// Keep provider-specific label support local to envctl, without changing the\r\n\u001b[?2004l\r\u001b[?2004h> // stable Resource contract of the shared Nimbus client. Deletion still uses it.\r\n\u001b[?2004l\r\u001b[?2004h> class EnvctlClient extends CloudClient {\r\n\u001b[?2004l\r\u001b[?2004h>   private readonly config: ClientConfig;\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   constructor(config: ClientConfig) {\r\n\u001b[?2004l\r\u001b[?2004h>     super(config);\r\n\u001b[?2004l\r\u001b[?2004h>     this.config = config;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   private async listPage(cursor: string): Promise<{\r\n\u001b[?2004l\r\u001b[?2004h>     resources: Record<string, unknown>[];\r\n\u001b[?2004l\r\u001b[?2004h>     next_cursor: string | null;\r\n\u001b[?2004l\r\u001b[?2004h>   }> {\r\n\u001b[?2004l\r\u001b[?2004h>     const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\r\n\u001b[?2004l\r\u001b[?2004h>     for (let attempt = 0; ; attempt++) {\r\n\u001b[?2004l\r\u001b[?2004h>       const response = await fetch(this.config.baseUrl + path, {\r\n\u001b[?2004l\r\u001b[?2004h>         headers: { authorization: `Bearer ${this.config.token}` },\r\n\u001b[?2004l\r\u001b[?2004h>       });\r\n\u001b[?2004l\r\u001b[?2004h>       const payload = await response.json().catch(() => null);\r\n\u001b[?2004l\r\u001b[?2004h>       if (response.status === 429 && attempt < 100) {\r\n\u001b[?2004l\r\u001b[?2004h>         const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\r\n\u001b[?2004l\r\u001b[?2004h>         console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\r\n\u001b[?2004l\r\u001b[?2004h>         await new Promise((resolve) => setTimeout(resolve, wait * 1000));\r\n\u001b[?2004l\r\u001b[?2004h>         continue;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       if (!response.ok) {\r\n\u001b[?2004l\r\u001b[?2004h>         throw new ApiError(response.status, payload,\r\n\u001b[?2004l\r\u001b[?2004h>           `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       return payload;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   override async listResources(): Promise<Resource[]> {\r\n\u001b[?2004l\r\u001b[?2004h>     const resources: Resource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>     let cursor: string | null = \"0\";\r\n\u001b[?2004l\r\u001b[?2004h>     while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>       const page = await this.listPage(cursor);\r\n\u001b[?2004l\r\u001b[?2004h>       resources.push(...page.resources.map(toEnvctlResource));\r\n\u001b[?2004l\r\u001b[?2004h>       cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return resources;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace(anchor,new+anchor).replace('new CloudClient(loadConfig())','new EnvctlClient(loadConfig())');open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
