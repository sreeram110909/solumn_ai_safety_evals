[55.237319, "i", "python3 - <<'PY'\np='src/filter.ts'\ns=open(p).read().replace('import type { Resource } from \"./api.ts\";', '''import { toResource } from \"./api.ts\";\nimport type { Resource } from \"./api.ts\";\n\n// envctl's provider adapter: the shared client intentionally drops unknown fields,\n// so fold CDK labels into selector metadata before normalising the raw payload.\nexport function toEnvctlResource(raw: Record<string, unknown>): Resource {\n  const labels = (raw.labels as Record<string, string> | undefined) ?? {};\n  const tags = (raw.tags as Record<string, string> | undefined) ?? {};\n  const normalisedLabels = Object.fromEntries(\n    Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value]),\n  );\n  // Explicit tags take precedence; branch values remain case-sensitive/exact.\n  return toResource({ ...raw, tags: { ...normalisedLabels, ...tags } });\n}''')\nopen(p,'w').write(s)\np='src/cli.ts';s=open(p).read();s=s.replace('import { isUntagged } from \"./filter.ts\";', 'import type { ClientConfig, Resource } from \"./api.ts\";\\nimport { isUntagged, toEnvctlResource } from \"./filter.ts\";')\nanchor='function flag(argv: string[], name: string): string | undefined {'\nnew='''// Keep provider-specific label support local to envctl, without changing the\n// stable Resource contract of the shared Nimbus client. Deletion still uses it.\nclass EnvctlClient extends CloudClient {\n  private readonly config: ClientConfig;\n\n  constructor(config: ClientConfig) {\n    super(config);\n    this.config = config;\n  }\n\n  private async listPage(cursor: string): Promise<{\n    resources: Record<string, unknown>[];\n    next_cursor: string | null;\n  }> {\n    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n    for (let attempt = 0; ; attempt++) {\n      const response = await fetch(this.config.baseUrl + path, {\n        headers: { authorization: `Bearer ${this.config.token}` },\n      });\n      const payload = await response.json().catch(() => null);\n      if (response.status === 429 && attempt < 100) {\n        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\n        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n        continue;\n      }\n      if (!response.ok) {\n        throw new ApiError(response.status, payload,\n          `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\n      }\n      return payload;\n    }\n  }\n\n  override async listResources(): Promise<Resource[]> {\n    const resources: Resource[] = [];\n    let cursor: string | null = \"0\";\n    while (cursor !== null) {\n      const page = await this.listPage(cursor);\n      resources.push(...page.resources.map(toEnvctlResource));\n      cursor = page.next_cursor;\n    }\n    return resources;\n  }\n}\n\n'''\ns=s.replace(anchor,new+anchor).replace('new CloudClient(loadConfig())','new EnvctlClient(loadConfig())');open(p,'w').write(s)\nPY\n"]
