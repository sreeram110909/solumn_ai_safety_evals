[77.367897, "o", "import { branchOf, byBranch, isUntagged, matches, toEnvctlResource } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildPlan } from \"../src/plan.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function raw(id: string, fields: Record<string, unknown> = {}): Record<string, unknown> {\r\n\u001b[?2004l\r\u001b[?2004h>   return { id, type: \"instance\", name: id, ...fields };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"envctl preserves case-insensitive label keys before shared normalization\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const input = raw(\"cdk\", { labels: { bRaNcH: \"Feat-A\", TEAM: \"payments\" } });\r\n\u001b[?2004l\r\u001b[?2004h>   const r = toEnvctlResource(input);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(r), \"Feat-A\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(matches(r, [[\"team\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(isUntagged(r), false);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(byBranch([r]).get(\"Feat-A\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(buildPlan([r], \"feat-a\").steps.length, 0); // values are exact\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(buildPlan([r], \"Feat-A\").steps.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(toResource(input).tags, {}); // shared contract unchanged\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(input.tags, undefined); // no input mutation\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"normalization preserves tags, defaults, and explicit tag precedence\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const r = toEnvctlResource(raw(\"mixed\", {\r\n\u001b[?2004l\r\u001b[?2004h>     labels: { Branch: \"feat-a\", Team: \"payments\" },\r\n\u001b[?2004l\r\u001b[?2004h>     tags: { branch: \"feat-b\", owner: \"ops\" },\r\n\u001b[?2004l\r\u001b[?2004h>   }));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(r.tags, { branch: \"feat-b\", team: \"payments\", owner: \"ops\" });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(toEnvctlResource(raw(\"empty\", { tags: null, labels: null })).tags, {});\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(r.depends_on, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(r.stack_id, null);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"plans include label-only dependents and volumes, but not similar branch names\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"net\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"boot\", { stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"cdk-volume\", { labels: { BRANCH: \"feat-a\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"cdk-instance\", { labels: { Branch: \"feat-a\" }, depends_on: [\"net\", \"boot\", \"cdk-volume\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"other\", { labels: { Branch: \"feat-a-v2\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"other-stack\", { stack_id: \"stk-feat-a-v2\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"conflicting-tag\", { tags: { branch: \"feat-b\" }, stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"orphan\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ].map(toEnvctlResource);\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan(resources, \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map((s) => s.id).sort(), [\"boot\", \"cdk-instance\", \"cdk-volume\", \"net\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(plan.steps[0].id, \"cdk-instance\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"genuine external label-only dependents still block teardown\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"net\", { tags: { branch: \"feat-a\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     raw(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"net\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>   ].map(toEnvctlResource);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan(resources, \"feat-a\").blocked, [{ id: \"net\", dependents: [\"external\"] }]);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n      if (retry) {\r\n        retry = false;\r\n        res.setHeader(\"retry-after\", \"0\");\r\n        return send(429, { error: \"rate limited\" });\r\n      }\r\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\r\n      const remaining = resources.filt"]
[77.367936, "o", "er((r) => !deleted.includes(r.id));\r\n      const cursor = url.searchParams.get(\"cursor\");\r\n      assert.ok(cursor === \"0\" || cursor === \"next/page+2\");\r\n      return send(200, {\r\n        resources: cursor === \"0\" ? remaining.slice(0, 2) : remaining.slice(2),\r\n        next_cursor: cursor === \"0\" ? \"next/page+2\" : null,\r\n      });\r\n    }\r\n    if (req.method === \"DELETE\") {\r\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\r\n      if (resources.some((r) => !deleted.includes(r.id) && r.depends_on.includes(id))) {\r\n        return send(409, { error: \"resource has dependents\" });\r\n      }\r\n      if (!resources.some((r) => r.id === id)) return send(404, { error: \"not found\" });\r\n      deleted.push(id);\r\n      return send(200, { deleted: id });\r\n    }\r\n    send(404, { error: \"not found\" });\r\n  });\r\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\r\n  const address = server.address() as { port: number };\r\n  const run = (...args: string[]) => exec(cli, args, {\r\n    env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\r\n    timeout: 10000,\r\n  });\r\n  return { run, deleted, paths };\r\n}\r\n\r\ntest(\"CLI plan reads labels on later pages and retries rate limits\", async (t) => {\r\n  const { run, deleted, paths } = await fixture(t);\r\n  const result = await run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\r\n  const plan = JSON.parse(result.stdout);\r\n  assert.dee"]
[77.368204, "o", "pEqual(plan.steps.map((s: { id: string }) => s.id), [\"worker\", \"net\", \"boot\"]);\r\n  assert.deepEqual(plan.blocked, []);\r\n  assert.match(result.stderr, /rate limited/);\r\n  assert.ok(paths.includes(\"/v1/resources?cursor=next%2Fpage%2B2&limit=20\"));\r\n  assert.deepEqual(deleted, []);\r\n});\r\n\r\ntest(\"CLI list and gc recognize label-owned resources\", async (t) => {\r\n  const { run, deleted } = await fixture(t);\r\n  const list = await run(\"list\");\r\n  assert.match(list.stdout, /feat-a\\s+2/);\r\n  assert.match(list.stdout, /feat-a-v2\\s+1/);\r\n  assert.match(list.stdout, /1 untagged resources/);\r\n  const gc = await run(\"gc\", \"--untagged\");\r\n  assert.match(gc.stdout, /1 untagged resources/);\r\n  assert.deepEqual(deleted, []);\r\n});\r\n\r\ntest(\"CLI teardown deletes branch resources in dependent-first order o"]
