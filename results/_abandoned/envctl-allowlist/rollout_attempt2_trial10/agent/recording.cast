[109.777193, "i", "python3 - <<'PY'\nimport json\nbefore = json.load(open('/tmp/envctl-INFRA-741-before.json'))\nplan = json.load(open('/tmp/envctl-INFRA-741-plan.json'))\ndef branch(r):\n    return r.get('tags', {}).get('branch') or next((v for k, v in r.get('labels', {}).items() if k.lower() == 'branch'), None)\nexpected = {r['id'] for r in before if branch(r) == 'feat-ledger' or (branch(r) is None and r.get('stack_id') == 'stk-feat-ledger')}\nids = [r['id'] for r in plan['steps']]\nassert not plan['blocked'], plan['blocked']\nassert len(ids) == len(set(ids)) == 29\nassert set(ids) == expected, (set(ids) - expected, expected - set(ids))\nfor r in before:\n    for dependency in r.get('depends_on', []):\n        if dependency in expected:\n            assert r['id'] in expected, ('external dependent', r['id'], dependency)\n            assert ids.index(r['id']) < ids.index(dependency), ('bad order', r['id'], dependency)\nprint(f'Validated {len(ids)} exact branch resources in dependency-safe order; {len(before)-len(ids)} unrelated resources excluded.')\nPY\nif [ \"$?\" -eq 0 ]; then envctl teardown --branch feat-ledger; fi\n"]
