[60.669842, "i", "cat >> test/plan.test.ts <<'EOF'\n\n// Exercise the envctl adapter, not just Resource-shaped fixtures: the shared\n// client's normalizer otherwise silently drops the provisioner's labels.\ntest(\"envctl normalizes label keys, preserving values and explicit tags\", async () => {\n  const { toEnvctlResource } = await import(\"../src/filter.ts\");\n  const labeled = toEnvctlResource({ ...res(\"cdk\", \"instance\", null), labels: { bRaNcH: \"feat-a\", TEAM: \"Payments\" } });\n  assert.ok(matches(labeled, [[\"branch\", \"feat-a\"], [\"team\", \"Payments\"]]));\n  assert.equal(byBranch([labeled]).get(\"feat-a\")?.length, 1);\n  assert.equal(byBranch([labeled]).has(\"(untagged)\"), false);\n  assert.equal(buildPlan([labeled], \"FEAT-A\").steps.length, 0);\n  assert.equal(buildPlan([labeled], \"feat\").steps.length, 0);\n  const tagged = toEnvctlResource({ ...res(\"both\", \"instance\", \"feat-b\"), labels: { Branch: \"feat-a\" } });\n  assert.deepEqual(tagged.tags, { branch: \"feat-b\" });\n  assert.deepEqual(toEnvctlResource({ id: \"empty\" }).tags, {});\n});\n\ntest(\"label-owned resources join the plan, without absorbing external dependents or similar stacks\", async () => {\n  const { toEnvctlResource } = await import(\"../src/filter.ts\");\n  const labeled = toEnvctlResource({\n    ...res(\"cdk\", \"instance\", null, [\"sub-a\", \"vol-cdk\"], \"cdk-stack\"),\n    labels: { Branch: \"feat-a\" },\n  });\n  const resources = [...FIXTURE, labeled,\n    res(\"vol-cdk\", \"volume\", null, [], \"cdk-stack\"),\n    res(\"similar\", \"network\", null, [], \"stk-feat-a-v2\"),\n    res(\"other\", \"instance\", \"feat-b\", [], \"stk-feat-a\"),\n    res(\"external\", \"dns_record\", \"feat-b\", [\"cdk\"]),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  const ids = plan.steps.map((s) => s.id);\n  assert.deepEqual([...ids].sort(), [\"cdk\", \"i-a\", \"net-a\", \"sub-a\", \"vol-a\", \"vol-cdk\"]);\n  for (const r of resources.filter((r) => ids.includes(r.id))) {\n    for (const dependency of r.depends_on.filter((id) => ids.includes(id))) {\n      assert.ok(ids.indexOf(r.id) < ids.indexOf(dependency));\n    }\n  }\n  assert.deepEqual(plan.blocked, [{ id: \"cdk\", dependents: [\"external\"] }]);\n});\nEOF\n"]
