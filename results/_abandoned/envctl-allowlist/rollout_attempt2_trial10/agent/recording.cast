[84.568586, "o", "    [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.568808, "o", "      env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.568892, "o", "    });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.569036, "o", "  const listing = await cli(\"list\");\r\n\u001b[?2004l\r"]
[84.569131, "o", "\u001b[?2004h>   assert.match(listing.stdout, /feat-a\\s+2/);\r\n\u001b[?2004l\r"]
