[98.693957, "o", "\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\nMost commands optionally preceded by integer argument k.  Defaults in brackets.\r\nStar (*) indicates argument becomes new default.\r\n-------------------------------------------------------------------------------\r\n<space>                 Display next k lines of text [current screen size]\r\nz                       Display next k lines of text [current screen size]*\r\n<return>                Display next k lines of text [1]*\r\nd or ctrl-D             Scroll k lines [current scroll size, initially 11]*\r\nq or Q or <interrupt>   Exit from more\r\ns                       Skip forward k lines of text [1]\r\nf                       Skip forward k screenfuls of text [1]\r\nb or ctrl-B             Skip backwards k screenfuls of text [1]\r\n'                       Go to place where previous search started\r\n=                       Display current line number\r\n/<regular expression>   Search for kth occurrence of regular expression [1]\r\nn                       Search for kth occurrence of last r.e [1]\r\n!<cmd> or :!<cmd>       Execute <cmd> in a subshell\r\nv                       Start up '/usr/bin/vi' at current line\r\nctrl-L                  Redraw screen\r\n:n                      Go to kth next file [1]\r\n:p                      Go to kth previous file [1]\r\n:f                      Display current file name and line number\r\n.                       Repeat previous command\r\n-------------------------------------------------------------------------------\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"]
[98.695721, "o", "\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\r\n...skipping 1 line\r\n\r"]
[98.698216, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..b2a135a 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -6,10 +6,42 @@\u001b[m\r\n"]
[98.698308, "o", " //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n"]
[98.698359, "o", "\u001b[31m-import { isUntagged } from \"./filter.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { ClientConfig, Resource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { isUntagged, toEnvctlResource } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n"]
[98.698401, "o", " import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n"]
[98.698425, "o", "\u001b[32m+\u001b[m\u001b[32m// The shared listing method normalizes away labels. Read raw pages here so\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// envctl can adapt nimbus-cdk metadata without changing other API consumers.\u001b[m\r\n"]
[98.698557, "o", "\u001b[32m+\u001b[m\u001b[32masync function listResources(config: ClientConfig): Promise<Resource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (let attempt = 0; ; attempt++) {\u001b[m\r\n"]
[98.698603, "o", "\u001b[32m+\u001b[m\u001b[32m      const response = await fetch(config.baseUrl + path, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        headers: { authorization: `Bearer ${config.token}`, \"content-type\": \"application/json\" },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const payload = await response.json().catch(() => null);\u001b[m\r\n"]
[98.698627, "o", "\u001b[32m+\u001b[m\u001b[32m      if (response.status === 429 && attempt < 100) {\u001b[m\r\n"]
[98.698675, "o", "\u001b[32m+\u001b[m\u001b[32m        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\u001b[m\r\n"]
[98.698708, "o", "\u001b[32m+\u001b[m\u001b[32m        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        continue;\u001b[m\r\n"]
[98.698744, "o", "\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n"]
[98.698771, "o", "\u001b[32m+\u001b[m\u001b[32m      if (!response.ok) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new ApiError(response.status, payload,\u001b[m\r\n"]
[98.698809, "o", "\u001b[32m+\u001b[m\u001b[32m          `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n"]
[98.698836, "o", "\u001b[32m+\u001b[m\u001b[32m      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\u001b[m\r\n"]
[98.698972, "o", "\u001b[32m+\u001b[m\u001b[32m      resources.push(...page.resources.map(toEnvctlResource));\u001b[m\r\n"]
[98.699307, "o", "\u001b[32m+\u001b[m\u001b[32m      cursor = page.next_cursor;\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[32m      break;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n\u001b[36m@@ -21,17 +53,18 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n     console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\u001b[m\r\n     return cmd ? 0 : 2;\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  const client = new CloudClient(loadConfig());\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const config = loadConfig();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const client = new CloudClient(config);\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n\u001b[31m-    console.log(summarize(await client.listResources()));\u001b[m\r\n"]
[98.699431, "o", "\u001b[32m+\u001b[m\u001b[32m    console.log(summarize(await listResources(config)));\u001b[m\r\n     return 0;\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   if (cmd === \"plan\" || cmd === \"teardown\") {\u001b[m\r\n     const branch = flag(rest, \"--branch\");\u001b[m\r\n     if (!branch) throw new Error(`${cmd} needs --branch`);\u001b[m\r\n\u001b[31m-    const plan = buildPlan(await client.listResources(), branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const plan = buildPlan(await listResources(config), branch);\u001b[m\r\n"]
[98.699559, "o", "     if (cmd === \"plan\" && rest.includes(\"--json\")) {\u001b[m\r\n       console.log(JSON.stringify(plan));\u001b[m\r\n       return 0;\u001b[m\r\n\u001b[36m@@ -52,7 +85,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n \u001b[m\r\n   if (cmd === \"gc\") {\u001b[m\r\n     if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\u001b[m\r\n\u001b[31m-    const targets = (await client.listResources()).filter(isUntagged);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const targets = (await listResources(config)).filter(isUntagged);\u001b[m\r\n"]
[98.700319, "o", "     console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\u001b[m\r\n     if (!rest.includes(\"--yes\")) {\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[98.70222, "o", "\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\r\u001b[K\r\n...skipping 39 lines\r\n"]
[98.702283, "o", "\r"]
[98.702815, "o", "\u001b[?2004hroot@eab605ea98fd:/app# "]
[98.703161, "o", " -- src/cli.ts src/filter.ts && git status --short"]
