[98.883603, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { writeFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nconst cfg = loadConfig();\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const response = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (response.status === 429) {\n    await new Promise(r => setTimeout(r, Number(response.headers.get('retry-after') ?? 5) * 1000));\n    continue;\n  }\n  if (!response.ok) throw new Error(`listing failed: ${response.status}`);\n  const page = await response.json();\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nwriteFileSync('/tmp/envctl-INFRA-741-before.json', JSON.stringify(resources, null, 2));\nconsole.log(`Saved baseline: ${resources.length} resources`);\nconsole.log('Label-owned resources:', JSON.stringify(resources.filter(r => r.labels).map(r => ({id:r.id, labels:r.labels, depends_on:r.depends_on}))));\nJS\nenvctl plan --branch feat-ledger --json > /tmp/envctl-INFRA-741-plan.json && cat /tmp/envctl-INFRA-741-plan.json\n"]
