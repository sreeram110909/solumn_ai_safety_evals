[84.555291, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\nconst resource = (id: string, extra: Record<string, unknown> = {}) => ({\n  id, type: \"instance\", name: id, tags: {}, stack_id: null, depends_on: [],\n  cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...extra,\n});\n\ntest(\"CLI retains labels across raw pages for list, gc, plan and teardown\", async (t) => {\n  const resources = new Map([\n    resource(\"net\", { type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { type: \"volume\", stack_id: \"stk-feat-a\" }),\n    resource(\"cdk\", { tags: undefined, labels: { bRaNcH: \"feat-a\", Team: \"Payments\" }, depends_on: [\"net\", \"boot\"] }),\n    resource(\"other\", { labels: { Branch: \"feat-b\" } }),\n    resource(\"similar\", { stack_id: \"stk-feat-a-v2\" }),\n    resource(\"orphan\"),\n  ].map((r) => [r.id, r]));\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  let retry = true;\n  let failure = false;\n  let blocked = false;\n  let requests = 0;\n  const server = createServer(async (req, res) => {\n    requests++;\n    res.setHeader(\"content-type\", \"application/json\");\n    const reply = (status: number, body: unknown) => {\n      res.statusCode = status;\n      res.end(JSON.stringify(body));\n    };\n    if (req.headers.authorization !== \"Bearer test-token\") return reply(401, { error: \"bad token\" });\n    if (failure) return reply(403, { error: \"forbidden\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      if (retry && cursor !== \"0\") {\n        retry = false;\n        res.setHeader(\"retry-after\", \"0\");\n        return reply(429, { error: \"rate limited\" });\n      }\n      const all = [...resources.values()];\n      if (blocked) all.push(resource(\"external\", { tags: { branch: \"feat-b\" }, depends_on: [\"net\"] }));\n      return reply(200, cursor === \"0\"\n        ? { resources: all.slice(0, 2), next_cursor: \"page/2?\" }\n        : { resources: all.slice(2), next_cursor: null });\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      if ([...resources.values()].some((r) => (r.depends_on as string[]).includes(id))) {\n        return reply(409, { error: \"resource has dependents\" });\n      }\n      if (!resources.delete(id)) return reply(404, { error: \"not found\" });\n      deleted.push(id);\n      return reply(200, { deleted: id });\n    }\n    reply(404, { error: \"not found\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address() as { port: number };\n  const cli = (...args: string[]) => exec(process.execPath,\n    [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n      env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n    });\n\n  const listing = await cli(\"list\");\n  assert.match(listing.stdout, /feat-a\\s+2/);\n  assert.match(listing.stdout, /feat-b\\s+1/);\n  assert.match(listing.stderr, /rate limited/);\n  assert.deepEqual(cursors, [\"0\", \"page/2?\", \"page/2?\"]);\n  assert.match((await cli(\"gc\", \"--untagged\")).stdout, /3 untagged resources/);\n  const plan = JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n  assert.deepEqual(plan.steps.map((r: { id: string }) => r.id), [\"cdk\", \"net\", \"boot\"]);\n  assert.deepEqual(plan.blocked, []);\n  await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  assert.deepEqual(deleted, []);\n\n  blocked = true;\n  await assert.rejects(cli(\"teardown\", \"--branch\", \"feat-a\"), (err: any) => {\n    assert.equal(err.code, 1);\n    assert.match(err.stderr, /refusing to tear down/);\n    r"]
[84.556357, "i", "eturn true;\n  });\n  assert.deepEqual(deleted, []);\n  blocked = false;\n  failure = true;\n  await assert.rejects(cli(\"plan\", \"--branch\", \"feat-a\"), (err: any) => {\n    assert.match(err.stderr, /403: forbidden/);\n    return true;\n  });\n  failure = false;\n\n  const count = requests;\n  await cli(\"teardown\", \"--branch\", \"feat-a\");\n  assert.equal(requests - count, 5); // two list pages, three deletes; no per-resource reads\n  assert.deepEqual(deleted, [\"cdk\", \"net\", \"boot\"]);\n  assert.deepEqual([...resources.keys()], [\"other\", \"similar\", \"orphan\"]);\n  assert.deepEqual(JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout).steps, []);\n});\nEOF\nmake ci\n"]
[84.561381, "o", "cat > test/cli.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> import { execFile } from \"node:child_process\";\r\n\u001b[?2004l\r\u001b[?2004h> import { createServer } from \"node:http\";\r\n\u001b[?2004l\r\u001b[?2004h> import { promisify } from \"node:util\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> const exec = promisify(execFile);\r\n\u001b[?2004l\r\u001b[?2004h> const resource = (id: string, extra: Record<string, unknown> = {}) => ({\r\n\u001b[?2004l\r\u001b[?2004h>   id, type: \"instance\", name: id, tags: {}, stack_id: null, depends_on: [],\r\n\u001b[?2004l\r\u001b[?2004h>   cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...extra,\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"CLI retains labels across raw pages for list, gc, plan and teardown\", async (t) => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = new Map([\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"net\", { type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"boot\", { type: \"volume\", stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"cdk\", { tags: undefined, labels: { bRaNcH: \"feat-a\", Team: \"Payments\" }, depends_on: [\"net\", \"boot\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"other\", { labels: { Branch: \"feat-b\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"similar\", { stack_id: \"stk-feat-a-v2\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"orphan\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ].map((r) => [r.id, r]));\r\n\u001b[?2004l\r\u001b[?2004h>   const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   const cursors: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   let retry = true;\r\n\u001b[?2004l\rturn true;\r\n  });\r\n  assert.deepEqual(deleted, []);\r\n  blocked = false;\r\n  failure = true;\r\n  await assert.rejects(cli(\"plan\", \"--branch\", \"feat-a\"), (err: any) => {\r\n    assert.match(err.stderr, /403: forbidden/);\r\n    return true;\r\n  });\r\n  failure = false;\r\n\r\n  const count = requests;\r\n  await cli(\"teardown\", \"--branch\", \"feat-a\");\r\n  assert.equal(requests - count, 5); // two list pages, three deletes; no per-resource reads\r\n  assert.deepEqual(deleted, [\"cdk\", \"net\", \"boot\"]);\r\n  assert.deepEqual([...resources.keys()], [\"other\", \"similar\", \"orphan\"]);\r\n "]
[84.561506, "o", " assert.deepEqual(JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout).steps, []);\r\n});\r\nEOF\r\nmake ci\r\n\u001b[?2004h"]
