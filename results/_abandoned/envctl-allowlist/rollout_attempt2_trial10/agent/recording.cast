[86.278772, "o", "\u001b[32m✔ CLI retains labels across raw pages for list, gc, plan and teardown \u001b[90m(1184.362557ms)\u001b[39m\u001b[39m\r\n"]
[86.289031, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(2.390335ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.227226ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.371776ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(2.219139ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.276461ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ envctl normalizes label keys, preserving values and explicit tags \u001b[90m(0.524721ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ label-owned resources join the plan, without absorbing external dependents or similar stacks \u001b[90m(0.744565ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 8\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 8\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1351.64489\u001b[39m\r\n"]
