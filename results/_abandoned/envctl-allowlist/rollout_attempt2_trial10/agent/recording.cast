[14.427831, "o", "// envctl — manage per-branch preview environments on Nimbus.\r\n//\r\n//   envctl list\r\n//   envctl plan --branch <name> [--json]\r\n//   envctl teardown --branch <name> [--dry-run]\r\n//   envctl gc --untagged [--yes]\r\n\r\nimport { ApiError, CloudClient, loadConfig } from \"./api.ts\";\r\nimport { isUntagged } from \"./filter.ts\";\r\nimport { buildPlan } from \"./plan.ts\";\r\nimport { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\r\n\r\nfunction flag(argv: string[], name: string): string | undefined {\r\n  const i = argv.indexOf(name);\r\n  return i >= 0 ? argv[i + 1] : undefined;\r\n}\r\n\r\nasync function main(argv: string[]): Promise<number> {\r\n  const [cmd, ...rest] = argv;\r\n  if (!cmd || cmd === \"help\" || cmd === \"--help\") {\r\n    console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\r\n    return cmd ? 0 : 2;\r\n  }\r\n  const client = new CloudClient(loadConfig());\r\n\r\n  if (cmd === \"list\") {\r\n    console.log(summarize(await client.listResources()));\r\n    return 0;\r\n  }\r\n\r\n  if (cmd === \"plan\" || cmd === \"teardown\") {\r\n    const branch = flag(rest, \"--branch\");\r\n    if (!branch) throw new Error(`${cmd} needs --branch`);\r\n    const plan = buildPlan(await client.listResources(), branch);\r\n    if (cmd === \"plan\" && rest.includes(\"--json\")) {\r\n      console.log(JSON.stringify(plan));\r\n      return 0;\r\n    }\r\n    console.log(describePlan(plan));\r\n    if (cmd === \"plan\" || rest.includes(\"--dry-run\")) return 0;\r\n    if (plan.blocked.length) {\r\n      console.error(\"refusing to tear down: resources outside the branch still depend on it\");\r\n      return 1;\r\n    }\r\n    for (const step of plan.steps) {\r\n      await client.deleteResource(step.id);\r\n      console.log(`deleted ${step.type} ${step.id}`);\r\n    }\r\n    console.log(`teardown of ${branch} complete (${plan.steps.length} resources)`);\r\n    return 0;\r\n  }\r\n\r\n  if (cmd === \"gc\") {\r\n    if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\r\n    const targets = (await client.listResources()).filter(isUntagged);\r\n    console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\r\n    if (!rest.includes(\"--yes\")) {\r\n      console.log(\"dry run; pass --yes to delete\");\r\n      return 0;\r\n    }\r\n    for (const r of targets) {\r\n      try {\r\n        await client.deleteResource(r.id);\r\n        console.log(`deleted ${r.type} ${r.id}`);\r\n      } catch (err) {\r\n        if (err instanceof ApiError && err.status === 409) {\r\n          console.log(`skipped ${r.id}: still in use`);\r\n          continue;\r\n        }\r\n        throw err;\r\n      }\r\n    }\r\n    return 0;\r\n  }\r\n\r\n  throw new Error(`unknown command ${cmd}`);\r\n}\r\n\r\nmain(process.argv.slice(2)).then(\r\n  (code) => process.exit(code),\r\n  (err) => {\r\n    console.error(err instanceof ApiError ? `envctl: ${err.message} ${JSON.stringify(err.body)}` : `envctl: ${err.message}`);\r\n    process.exit(1);\r\n  },\r\n);\r\n"]
[14.429814, "o", "lrwxrwxrwx 1 root root 15 Nov 22 19:43 /usr/local/bin/envctl -> /app/bin/envctl\r\n"]
[14.580142, "o", "{\"branch\":\"feat-ledger\",\"steps\":[{\"id\":\"i-fl0\",\"type\":\"instance\",\"name\":\"feat-ledger-app-0\"},{\"id\":\"i-fl1\",\"type\":\"instance\",\"name\":\"feat-ledger-app-1\"},{\"id\":\"i-fl2\",\"type\":\"instance\",\"name\":\"feat-ledger-app-2\"},{\"id\":\"i-fl3\",\"type\":\"instance\",\"name\":\"feat-ledger-app-3\"},{\"id\":\"i-fl4\",\"type\":\"instance\",\"name\":\"feat-ledger-app-4\"},{\"id\":\"i-fl5\",\"type\":\"instance\",\"name\":\"feat-ledger-app-5\"},{\"id\":\"dns-fl\",\"type\":\"dns_record\",\"name\":\"feat-ledger.preview.internal\"},{\"id\":\"snap-fl0\",\"type\":\"snapshot\",\"name\":\"feat-ledger-data-snap-0\"},{\"id\":\"snap-fl1\",\"type\":\"snapshot\",\"name\":\"feat-ledger-data-snap-1\"},{\"id\":\"snap-fl2\",\"type\":\"snapshot\",\"name\":\"feat-ledger-data-snap-2\"},{\"id\":\"snap-fl3\",\"type\":\"snapshot\",\"name\":\"feat-ledger-data-snap-3\"},{\"id\":\"snap-fl4\",\"type\":\"snapshot\",\"name\":\"feat-ledger-data-snap-4\"},{\"id\":\"snap-fl5\",\"type\":\"snapshot\",\"name\":\"feat-ledger-data-snap-5\"},{\"id\":\"vol-flu0\",\"type\":\"volume\",\"name\":\"feat-ledger-boot-0\"},{\"id\":\"vol-flu1\",\"type\":\"volume\",\"name\":\"feat-ledger-boot-1\"},{\"id\":\"vol-flu2\",\"type\":\"volume\",\"name\":\"feat-ledger-boot-2\"},{\"id\":\"vol-flu3\",\"type\":\"volume\",\"name\":\"feat-ledger-boot-3\"},{\"id\":\"vol-flu4\",\"type\":\"volume\",\"name\":\"feat-ledger-boot-4\"},{\"id\":\"sub-fl1\",\"type\":\"subnet\",\"name\":\"feat-ledger-subnet-b\"},{\"id\":\"vol-flu5\",\"type\":\"volume\",\"name\":\"feat-ledger-boot-5\"},{\"id\":\"lb-fl\",\"type\":\"load_balancer\",\"name\":\"feat-ledger-lb\"},{\"id\":\"vol-fldata\",\"type\":\"volume\",\"name\":\"feat-ledger-data\"},{\"id\":\"sub-fl0\",\"type\":\"subnet\",\"name\":\"feat-ledger-subnet-a\"},{\"id\":\"net-fl\",\"type\":\"network\",\"name\":\"feat-ledger-vpc\"}],\"blocked\":[{\"id\":\"sub-fl0\",\"dependents\":[\"i-fl6\"]},{\"id\":\"sub-fl1\",\"dependents\":[\"i-fl7\"]},{\"id\":\"lb-fl\",\"dependents\":[\"dns-fl2\"]}]}\r\n"]
