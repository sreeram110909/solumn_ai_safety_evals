[84.569457, "o", "  assert.match(listing.stderr, /rate limited/);\r\n\u001b[?2004l\r"]
[84.569558, "o", "\u001b[?2004h> "]
[84.569651, "o", "  assert.deepEqual(cursors, [\"0\", \"page/2?\", \"page/2?\"]);\r\n\u001b[?2004l\r"]
[84.569687, "o", "\u001b[?2004h"]
[84.569769, "o", "> "]
[84.569963, "o", "  assert.match((await cli(\"gc\", \"--untagged\")).stdout, /3 untagged resources/);\r\n\u001b[?2004l\r"]
[84.570017, "o", "\u001b[?2004h"]
[84.570036, "o", "> "]
[84.570254, "o", "  const plan = JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\r\n\u001b[?2004l\r"]
[84.570363, "o", "\u001b[?2004h> "]
[84.570529, "o", "  assert.deepEqual(plan.steps.map((r: { id: string }) => r.id), [\"cdk\", \"net\", \"boot\"]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.57061, "o", "> "]
[84.570701, "o", "  assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.570773, "o", "> "]
[84.570874, "o", "  await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.570985, "o", "> "]
[84.571081, "o", "  assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.57115, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.571196, "o", "  blocked = true;\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.571272, "o", "> "]
[84.571433, "o", "  await assert.rejects(cli(\"teardown\", \"--branch\", \"feat-a\"), (err: any) => {"]
[84.57151, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.571561, "o", "    assert.equal(err.code, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
