[25.064824, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { loadConfig } from './src/api.ts';\nconst cfg = loadConfig();\nasync function get(path) {\n  const res = await fetch(cfg.baseUrl + path, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (!res.ok) throw new Error(`GET ${path}: ${res.status}`);\n  return res.json();\n}\nconsole.log('Identity:', JSON.stringify(await get('/v1/whoami')));\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await get(`/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconsole.log('Total resources:', resources.length);\nfor (const r of resources) console.log(JSON.stringify({id:r.id, type:r.type, tags:r.tags, labels:r.labels, stack_id:r.stack_id, depends_on:r.depends_on}));\nJS\n"]
