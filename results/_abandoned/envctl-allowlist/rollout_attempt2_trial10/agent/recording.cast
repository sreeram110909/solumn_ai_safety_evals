[60.500959, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text().replace('import type { Resource } from \"./api.ts\";', '''import { toResource } from \"./api.ts\";\nimport type { Resource } from \"./api.ts\";\n\n// Keep provider-specific metadata handling local to envctl: the shared client's\n// stable Resource shape intentionally drops labels. Labels have case-insensitive\n// keys, but branch names (values) remain case-sensitive. Explicit tags win.\nexport function toEnvctlResource(raw: Record<string, unknown>): Resource {\n  const labels = (raw.labels as Record<string, string> | undefined) ?? {};\n  const tags = (raw.tags as Record<string, string> | undefined) ?? {};\n  return toResource({\n    ...raw,\n    tags: {\n      ...Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value])),\n      ...tags,\n    },\n  });\n}''')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('import { isUntagged } from \"./filter.ts\";', 'import type { ClientConfig, Resource } from \"./api.ts\";\\nimport { isUntagged, toEnvctlResource } from \"./filter.ts\";')\ns = s.replace('function flag(argv:', '''// The shared listing method normalizes away labels. Read raw pages here so\n// envctl can adapt nimbus-cdk metadata without changing other API consumers.\nasync function listResources(config: ClientConfig): Promise<Resource[]> {\n  const resources: Resource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n    for (let attempt = 0; ; attempt++) {\n      const response = await fetch(config.baseUrl + path, {\n        headers: { authorization: `Bearer ${config.token}`, \"content-type\": \"application/json\" },\n      });\n      const payload = await response.json().catch(() => null);\n      if (response.status === 429 && attempt < 100) {\n        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\n        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n        continue;\n      }\n      if (!response.ok) {\n        throw new ApiError(response.status, payload,\n          `GET ${path} -> ${response.status}: ${payload?.error ?? response.statusText}`);\n      }\n      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n      resources.push(...page.resources.map(toEnvctlResource));\n      cursor = page.next_cursor;\n      break;\n    }\n  }\n  return resources;\n}\n\nfunction flag(argv:''')\ns = s.replace('const client = new CloudClient(loadConfig());', 'const config = loadConfig();\\n  const client = new CloudClient(config);')\ns = s.replace('await client.listResources()', 'await listResources(config)')\np.write_text(s)\nPY\n"]
