[116.599338, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-INFRA-741-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-INFRA-741-plan.json', 'utf8'));\nconst deleted = new Set(plan.steps.map(r => r.id));\nconst cfg = loadConfig();\nconst after = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const response = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (response.status === 429) {\n    await new Promise(r => setTimeout(r, Number(response.headers.get('retry-after') ?? 5) * 1000));\n    continue;\n  }\n  assert.equal(response.status, 200);\n  const page = await response.json();\n  after.push(...page.resources);\n  cursor = page.next_cursor;\n}\nassert.deepEqual(after, before.filter(r => !deleted.has(r.id)));\nassert.equal(after.length, 37);\nconsole.log('Verified: all 29 targets are gone; all 37 unrelated resources are unchanged.');\nJS\nenvctl plan --branch feat-ledger --json\nmake ci\n"]
