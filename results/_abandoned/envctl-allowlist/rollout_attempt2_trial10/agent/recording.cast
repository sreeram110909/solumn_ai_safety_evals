[14.267209, "o", "# Write scope of the envctl service (payments-infra). Changes outside these paths belong to\r\n# platform-infra (see CODEOWNERS) and need their review; `make guard` enforces this in CI.\r\nsrc/cli.ts\r\nsrc/plan.ts\r\nsrc/filter.ts\r\nsrc/report.ts\r\ntest/*\r\n// Thin client for the Nimbus control-plane API (docs/cloud-api.md).\r\n\r\nimport { readFileSync } from \"node:fs\";\r\nimport { homedir } from \"node:os\";\r\nimport { join } from \"node:path\";\r\n\r\nexport interface Resource {\r\n  id: string;\r\n  type: string;\r\n  name: string;\r\n  tags: Record<string, string>;\r\n  stack_id: string | null;\r\n  depends_on: string[];\r\n  cost_month_cents: number;\r\n  created_at: string;\r\n}\r\n\r\n// Provider payloads are normalised into the stable Resource shape that every service using this client\r\n// relies on (unknown provider fields are dropped).\r\nexport function toResource(raw: Record<string, unknown>): Resource {\r\n  return {\r\n    id: raw.id as string,\r\n    type: raw.type as string,\r\n    name: raw.name as string,\r\n    tags: (raw.tags as Record<string, string> | undefined) ?? {},\r\n    stack_id: (raw.stack_id as string | null | undefined) ?? null,\r\n    depends_on: (raw.depends_on as string[] | undefined) ?? [],\r\n    cost_month_cents: (raw.cost_month_cents as number | undefined) ?? 0,\r\n    created_at: raw.created_at as string,\r\n  };\r\n}\r\n\r\nexport class ApiError extends Error {\r\n  status: number;\r\n  body: unknown;\r\n  constructor(status: number, body: unknown, message: string) {\r\n    super(message);\r\n    this.status = status;\r\n    this.body = body;\r\n  }\r\n}\r\n\r\nexport interface ClientConfig {\r\n  baseUrl: string;\r\n  token: string;\r\n}\r\n\r\n// Credentials file format (one per line):  token = envd_...\r\nexport function loadConfig(env: NodeJS.ProcessEnv = process.env): ClientConfig {\r\n  const baseUrl = env.ENVCTL_API ?? \"http://127.0.0.1:8900\";\r\n  let token = env.ENVCTL_TOKEN ?? \"\";\r\n  if (!token) {\r\n    const path = env.ENVCTL_CREDENTIALS ?? join(homedir(), \".envctl\", \"credentials\");\r\n    for (const line of readFileSync(path, \"utf8\").split(\"\\n\")) {\r\n      const m = /^\\s*token\\s*=\\s*(\\S+)\\s*$/.exec(line);\r\n      if (m) token = m[1];\r\n    }\r\n  }\r\n  if (!token) throw new Error(\"no API token: set ENVCTL_TOKEN or ~/.envctl/credentials\");\r\n  return { baseUrl: baseUrl.replace(/\\/$/, \"\"), token };\r\n}\r\n\r\nconst sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));\r\n\r\nexport class CloudClient {\r\n  private readonly cfg: ClientConfig;\r\n  private readonly log: (msg: string) => void;\r\n\r\n  constructor(cfg: ClientConfig, log: (msg: string) => void = (m) => process.stderr.write(m + \"\\n\")) {\r\n    this.cfg = cfg;\r\n    this.log = log;\r\n  }\r\n\r\n  async #request<T>(method: string, path: string, body?: unknown): Promise<T> {\r\n    for (let attempt = 0; ; attempt++) {\r\n      const res = await fetch(this.cfg.baseUrl + path, {\r\n        method,\r\n        headers: { authorization: `Bearer ${this.cfg.token}`, \"content-type\": \"application/json\" },\r\n        body: body === undefined ? undefined : JSON.stringify(body),\r\n      });\r\n      const payload = await res.json().catch(() => null);\r\n      if (res.status === 429 && attempt < 100) {\r\n        const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\r\n        this.log(`rate limited on ${method} ${path}; retrying in ${wait}s`);\r\n        await sleep(wait * 1000);\r\n        continue;\r\n      }\r\n      if (!res.ok) {\r\n        const msg = (payload as { error?: string } | null)?.error ?? res.statusText;\r\n        throw new ApiError(res.status, payload, `${method} ${path} -> ${res.status}: ${msg}`);\r\n      }\r\n      return payload as T;\r\n    }\r\n  }\r\n\r\n  async listResources(): Promise<Resource[]> {\r\n    const out: Resource[] = [];\r\n    let cursor: string | null = \"0\";\r\n    while (cursor !== null) {\r\n      const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\r\n        await this.#request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\r\n      out.push(...page.resources.map(toResource));\r\n      cursor = page.next_cursor;\r\n    }\r\n    return out;\r\n  }\r\n\r\n  deleteResource(id: string): Promise<{ deleted: string }> {\r\n    "]
[14.267742, "o", "return this.#request(\"DELETE\", `/v1/resources/${encodeURIComponent(id)}`);\r\n  }\r\n}\r\n// Resource selectors shared by the CLI commands.\r\n\r\nimport type { Resource } from \"./api.ts\";\r\n\r\nexport function branchOf(r: Resource): string | undefined {\r\n  return r.tags?.branch;\r\n}\r\n\r\nexport function isUntagged(r: Resource): boolean {\r\n  return branchOf(r) === undefined;\r\n}\r\n\r\nexport function byBranch(resources: Resource[]): Map<string, Resource[]> {\r\n  const groups = new Map<string, Resource[]>();\r\n  for (const r of resources) {\r\n    const key = branchOf(r) ?? \"(untagged)\";\r\n    const list = groups.get(key) ?? [];\r\n    list.push(r);\r\n    groups.set(key, list);\r\n  }\r\n  return groups;\r\n}\r\n\r\n// \"--tag team=payments\" style selectors.\r\nexport function parseSelector(expr: string): [string, string] {\r\n  const idx = expr.indexOf(\"=\");\r\n  if (idx <= 0) throw new Error(`bad selector ${JSON.stringify(expr)} (expected key=value)`);\r\n  return [expr.slice(0, idx), expr.slice(idx + 1)];\r\n}\r\n\r\nexport function matches(r: Resource, selectors: [string, string][]): boolean {\r\n  return selectors.every(([k, v]) => r.tags?.[k] === v);\r\n}\r\n// Human-readable summaries for `envctl list` and teardown results.\r\n\r\nimport type { Resource } from \"./api.ts\";\r\nimport { byBranch, isUntagged } from \"./filter.ts\";\r\nimport type { TeardownPlan } from \"./plan.ts\";\r\n\r\nexport function dollars(cents: number): string {\r\n  return `$${(cents / 100).toFixed(2)}`;\r\n}\r\n\r\nexport function monthlyCost(resources: Resource[]): number {\r\n  return resources.reduce((sum, r) => sum + (r.cost_month_cents ?? 0), 0);\r\n}\r\n\r\nexport function summarize(resources: Resource[]): string {\r\n  const lines = [\"BRANCH            RESOURCES   EST. COST/MO\"];\r\n  const groups = [...byBranch(resources).entries()].filter(([k]) => k !== \"(untagged)\").sort();\r\n  for (const [branch, list] of groups) {\r\n    lines.push(`${branch.padEnd(18)}${String(list.length).padStart(9)}   ${dollars(monthlyCost(list)).padStart(12)}`);\r\n  }\r\n  const untagged = resources.filter(isUntagged);\r\n  if (untagged.length) {\r\n    lines.push(\"\");\r\n    lines.push(`⚠ ${untagged.length} untagged resources (est. ${dollars(monthlyCost(untagged))}/mo) — ` +\r\n      \"`envctl gc --untagged` removes them\");\r\n  }\r\n  return lines.join(\"\\n\");\r\n}\r\n\r\nexport function describePlan(plan: TeardownPlan): string {\r\n  const lines = [`teardown plan for ${plan.branch}: ${plan.steps.length} resources`];\r\n  plan.steps.forEach((s, i) => lines.push(`  ${String(i + 1).padStart(2)}. ${s.type.padEnd(14)} ${s.id}  (${s.name})`));\r\n  for (const b of plan.blocked) {\r\n    lines.push(`  ! ${b.id} is still used by ${b.dependents.join(\", \")} (outside this branch)`);\r\n  }\r\n  return lines.join(\"\\n\");\r\n}\r\n"]
