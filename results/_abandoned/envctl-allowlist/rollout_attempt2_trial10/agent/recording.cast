[84.571902, "o", ">     return true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[84.571972, "o", "  });"]
[84.572041, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.572096, "o", "> "]
[84.572164, "o", "  assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h"]
[84.572221, "o", "> "]
[84.572315, "o", "  blocked = false;\r\n\u001b[?2004l\r\u001b[?2004h>   failure = true;\r\n"]
[84.572475, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[84.57264, "o", "  await assert.rejects(cli(\"plan\", \"--branch\", \"feat-a\"), (err: any) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
