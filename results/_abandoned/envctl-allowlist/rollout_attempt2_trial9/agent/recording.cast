[116.907695, "o", "const before = JSON.parse(readFileSync('/tmp/envctl-infra741-before.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const deleted = new Set(before.plan.steps.map(r => r.id));\r\n\u001b[?2004l\r\u001b[?2004h> const cfg = loadConfig();\r\n\u001b[?2004l\r\u001b[?2004h> const resources = [];\r\n\u001b[?2004l\r\u001b[?2004h> let cursor = '0';\r\n\u001b[?2004l\r\u001b[?2004h> while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>   const response = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\r\n\u001b[?2004l\r\u001b[?2004h>   if (!response.ok) throw new Error(`${response.status} ${await response.text()}`);\r\n\u001b[?2004l\r\u001b[?2004h>   const page = await response.json();\r\n\u001b[?2004l\r\u001b[?2004h>   resources.push(...page.resources); cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(resources, before.resources.filter(r => !deleted.has(r.id)));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[116.907744, "o", "console.log(`Verified: all ${deleted.size} feat-ledger resources are gone; all ${resources.length} unrelated resources are unchanged.`);\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
[117.015748, "o", "Verified: all 29 feat-ledger resources are gone; all 37 unrelated resources are unchanged.\r\n"]
