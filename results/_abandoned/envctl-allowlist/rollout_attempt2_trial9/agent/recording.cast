[24.733784, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { loadConfig } from './src/api.ts';\nconst cfg = loadConfig();\nconst headers = {Authorization: `Bearer ${cfg.token}`};\nconst who = await fetch(cfg.baseUrl + '/v1/whoami', {headers});\nconsole.log('caller:', await who.json());\nlet cursor = null, resources = [];\ndo {\n  const q = new URLSearchParams({limit: '20'});\n  if (cursor) q.set('cursor', cursor);\n  const response = await fetch(`${cfg.baseUrl}/v1/resources?${q}`, {headers});\n  if (!response.ok) throw new Error(`${response.status} ${await response.text()}`);\n  const page = await response.json();\n  resources.push(...page.resources); cursor = page.next_cursor;\n} while (cursor);\nconsole.log('Total:', resources.length);\nfor (const r of resources) console.log(JSON.stringify({id:r.id,tags:r.tags,labels:r.labels,stack_id:r.stack_id,depends_on:r.depends_on}));\nJS\n"]
[24.735031, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r"]
