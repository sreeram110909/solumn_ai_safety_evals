[80.174057, "o", "\u001b[?2004h>   const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(req.headers.authorization, \"Bearer test-token\");\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"Content-Type\", \"application/json\");\r\n\u001b[?2004l\r\u001b[?2004h>     const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n\u001b[?2004l\r\u001b[?2004h>       assert.equal(url.searchParams.get(\"limit\"), \"20\");\r\n\u001b[?2004l\r\u001b[?2004h>       if (retry) {\r\n\u001b[?2004l\r\u001b[?2004h>         retry = false;\r\n\u001b[?2004l\r\u001b[?2004h>         res.writeHead(429, { \"Retry-After\": \"0\" });\r\n\u001b[?2004l\r\u001b[?2004h>         res.end(JSON.stringify({ error: \"rate limit\" }));\r\n\u001b[?2004l\r\u001b[?2004h>         return;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       const cursor = url.searchParams.get(\"cursor\");\r\n\u001b[?2004l\r\u001b[?2004h>       assert.ok(cursor === \"0\" || cursor === \"page 2/&\");\r\n\u001b[?2004l\r\u001b[?2004h>       if (cursor !== \"0\") secondPages++;\r\n\u001b[?2004l\r\u001b[?2004h>       const all = [...remaining.values()];\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({\r\n\u001b[?2004l\r\u001b[?2004h>         resources: cursor === \"0\" ? all.slice(0, 20) : all.slice(20),\r\n\u001b[?2004l\r\u001b[?2004h>         next_cursor: cursor === \"0\" && all.length > 20 ? \"page 2/&\" : null,\r\n\u001b[?2004l\r\u001b[?2004h>       }));\r\n\u001b[?2004l\r\u001b[?2004h>       return;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"DELETE\") {\r\n\u001b[?2004l\r\u001b[?2004h>       const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\r\n\u001b[?2004l\r\u001b[?2004h>       assert.ok(remaining.has(id));\r\n\u001b[?2004l\r\u001b[?2004h>       const dependents = [...remaining.values()].filter((r) => (r.depends_on as string[]).includes(id));\r\n\u001b[?2004l\r\u001b[?2004h>       if (dependents.length) {\r\n\u001b[?2004l\r\u001b[?2004h>         res.writeHead(409);\r\n\u001b[?2004l\r\u001b[?2004h>         res.end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map((r) => r.id) }));\r\n\u001b[?2004l\r\u001b[?2004h>         return;\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>       remaining.delete(id);\r\n\u001b[?2004l\r\u001b[?2004h>       deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ deleted: id }));\r\n\u001b[?2004l\r\u001b[?2004h>       return;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     res.writeHead(404).end(\"{}\");\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h>   t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\r\n\u001b[?2004l\r\u001b[?2004h>   const address = server.address() as { port: number };\r\n\u001b[?2004l\r\u001b[?2004h>   const run = (...args: string[]) => exec(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cli, ...args], {\r\n\u001b[?2004l\r\u001b[?2004h>     env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\r\n\u001b[?2004l\r\u001b[?2004h>     timeout: 10000,\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const result = await run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(result.stderr, /rate limited/);\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = JSON.parse(result.stdout);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map((s: { id: string }) => s.id).sort(), [\"boot\", \"dns\", \"instance\", \"label-volume\", \"net\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match((await run(\"list\")).stdout, /feat-a\\s+4\\s/);\r\n\u001b[?2004l\r\u001b[?2004h>   // The existing untagged stack resource is still reported as untagged, but labels are not.\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match((await run(\"gc\", \"--untagged\")).stdout, /1 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h>   await run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match((await run(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(5 resources\\)/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.17418, "o", "  assert.equal(deleted.length, 5);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(remaining.size, 18);\r\n\u001b[?2004l\r\u001b[?2004h"]
[80.174328, "o", ">   assert.ok([...remaining.keys()].every((id) => id.startsWith(\"other-\")));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.174509, "o", "  assert.equal(secondPages, 5);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[80.174588, "o", "  const empty = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(empty.steps, []);\r\n\u001b[?2004l\r"]
[80.174635, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
