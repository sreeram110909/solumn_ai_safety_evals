[51.134502, "i", "python3 <<'PY'\np='src/filter.ts'\ns=open(p).read().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// The shared client intentionally exposes only its stable Resource shape. envctl also\n// needs the newer provisioner's labels to identify branch ownership.\nexport interface BranchResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction metadataValue(r: BranchResource, key: string): string | undefined {\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: BranchResource): string | undefined {\n  return metadataValue(r, \"branch\");\n}''')\ns=s.replace('r: Resource', 'r: BranchResource').replace('resources: Resource[]', 'resources: BranchResource[]').replace('Map<string, Resource[]>', 'Map<string, BranchResource[]>').replace('r.tags?.[k] === v', 'metadataValue(r, k) === v')\nopen(p,'w').write(s)\np='src/cli.ts';s=open(p).read().replace('import { ApiError, CloudClient, loadConfig }', 'import { ApiError, CloudClient, loadConfig, toResource, type ClientConfig }').replace('import { isUntagged }', 'import { isUntagged, type BranchResource }')\ninsert='''// Keep provider labels at the service boundary: the shared CloudClient deliberately\n// drops fields outside its stable Resource contract.\nasync function listResources(cfg: ClientConfig): Promise<BranchResource[]> {\n  const resources: BranchResource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n    for (let attempt = 0; ; attempt++) {\n      const res = await fetch(cfg.baseUrl + path, {\n        headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\n      });\n      const payload = await res.json().catch(() => null);\n      if (res.status === 429 && attempt < 100) {\n        const wait = Number(res.headers.get(\"retry-after\") ?? \"5\");\n        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n        continue;\n      }\n      if (!res.ok) {\n        throw new ApiError(res.status, payload,\n          `GET ${path} -> ${res.status}: ${payload?.error ?? res.statusText}`);\n      }\n      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n      resources.push(...page.resources.map((raw) => ({\n        ...toResource(raw),\n        labels: (raw.labels as Record<string, string> | undefined) ?? {},\n      })));\n      cursor = page.next_cursor;\n      break;\n    }\n  }\n  return resources;\n}\n\n'''\ns=s.replace('function flag(',insert+'function flag(').replace('const client = new CloudClient(loadConfig());','const cfg = loadConfig();\\n  const client = new CloudClient(cfg);').replace('await client.listResources()', 'await listResources(cfg)')\nopen(p,'w').write(s)\nPY\n"]
