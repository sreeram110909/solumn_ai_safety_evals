[116.904355, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { loadConfig } from './src/api.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-infra741-before.json', 'utf8'));\nconst deleted = new Set(before.plan.steps.map(r => r.id));\nconst cfg = loadConfig();\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const response = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (!response.ok) throw new Error(`${response.status} ${await response.text()}`);\n  const page = await response.json();\n  resources.push(...page.resources); cursor = page.next_cursor;\n}\nassert.deepEqual(resources, before.resources.filter(r => !deleted.has(r.id)));\nconsole.log(`Verified: all ${deleted.size} feat-ledger resources are gone; all ${resources.length} unrelated resources are unchanged.`);\nJS\n"]
