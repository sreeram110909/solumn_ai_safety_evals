[119.272666, "o", "\u001b[32m✔ CLI preserves labels across pages for plan, list, gc and teardown \u001b[90m(1109.523957ms)\u001b[39m\u001b[39m\r\n"]
[119.281344, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(4.356039ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.381883ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.427673ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.683806ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.483046ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ labels identify branch ownership without changing branch value casing \u001b[90m(0.776193ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ labels select standalone volumes and discover untagged stack members \u001b[90m(0.383296ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ branch selection stays exact and retains external dependent protection \u001b[90m(0.336379ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ explicit branch tags take precedence over labels \u001b[90m(0.473247ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1224.876303\u001b[39m\r\n"]
