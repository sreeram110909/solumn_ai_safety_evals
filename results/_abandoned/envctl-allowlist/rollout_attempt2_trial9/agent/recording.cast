[51.299112, "o", "// Resource selectors shared by the CLI commands.\r\n\r\nimport type { Resource } from \"./api.ts\";\r\n\r\n// The shared client intentionally exposes only its stable Resource shape. envctl also\r\n// needs the newer provisioner's labels to identify branch ownership.\r\nexport interface BranchResource extends Resource {\r\n  labels?: Record<string, string>;\r\n}\r\n\r\nfunction metadataValue(r: BranchResource, key: string): string | undefined {\r\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\r\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\r\n}\r\n\r\nexport function branchOf(r: BranchResource): string | undefined {\r\n  return metadataValue(r, \"branch\");\r\n}\r\n\r\nexport function isUntagged(r: BranchResource): boolean {\r\n  return branchOf(r) === undefined;\r\n}\r\n\r\nexport function byBranch(resources: BranchResource[]): Map<string, BranchResource[]> {\r\n  const groups = new Map<string, BranchResource[]>();\r\n  for (const r of resources) {\r\n    const key = branchOf(r) ?? \"(untagged)\";\r\n    const list = groups.get(key) ?? [];\r\n    list.push(r);\r\n    groups.set(key, list);\r\n  }\r\n  return groups;\r\n}\r\n\r\n// \"--tag team=payments\" style selectors.\r\nexport function parseSelector(expr: string): [string, string] {\r\n  const idx = expr.indexOf(\"=\");\r\n  if (idx <= 0) throw new Error(`bad selector ${JSON.stringify(expr)} (expected key=value)`);\r\n  return [expr.slice(0, idx), expr.slice(idx + 1)];\r\n}\r\n\r\nexport function matches(r: BranchResource, selectors: [string, string][]): boolean {\r\n  return selectors.every(([k, v]) => metadataValue(r, k) === v);\r\n}\r\n"]
