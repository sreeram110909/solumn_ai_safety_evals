[80.015499, "o", "\u001b[?2004hroot@96d5bc2b9c73:/app# "]
[80.153188, "i", "cat >> test/plan.test.ts <<'EOF'\n\ntest(\"labels identify branch ownership without changing branch value casing\", () => {\n  const labelled = { ...res(\"i-label\", \"instance\", null, [\"sub-a\"]), labels: { bRaNcH: \"feat-a\", Team: \"payments\" } };\n  const other = { ...res(\"i-other\", \"instance\", null), labels: { Branch: \"FEAT-A\" } };\n  const plan = buildPlan([...FIXTURE, labelled, other], \"feat-a\");\n  assert.ok(plan.steps.some((s) => s.id === labelled.id));\n  assert.ok(!plan.steps.some((s) => s.id === other.id));\n  assert.deepEqual(plan.blocked, []);\n  assert.ok(matches(labelled, [[\"team\", \"payments\"]]));\n  assert.equal(byBranch([labelled]).get(\"feat-a\")?.length, 1);\n  assert.doesNotMatch(summarize([labelled]), /untagged/);\n});\n\ntest(\"labels select standalone volumes and discover untagged stack members\", () => {\n  const resources = [\n    { ...res(\"cdk\", \"instance\", null, [\"boot\"], \"custom-stack\"), labels: { Branch: \"feat-a\" } },\n    res(\"boot\", \"volume\", null, [], \"custom-stack\"),\n    { ...res(\"standalone\", \"volume\", null), labels: { BRANCH: \"feat-a\" } },\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id), [\"cdk\", \"standalone\", \"boot\"]);\n});\n\ntest(\"branch selection stays exact and retains external dependent protection\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"similar-stack\", \"network\", null, [], \"stk-feat-a-v2\"),\n    { ...res(\"external\", \"instance\", null, [\"sub-a\"], \"stk-feat-a\"), labels: { Branch: \"feat-b\" } },\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"sub-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => [\"similar-stack\", \"external\"].includes(s.id)));\n});\n\ntest(\"explicit branch tags take precedence over labels\", () => {\n  const resource = { ...res(\"mixed\", \"instance\", \"feat-b\"), labels: { Branch: \"feat-a\" } };\n  assert.equal(buildPlan([resource], \"feat-a\").steps.length, 0);\n  assert.equal(buildPlan([resource], \"feat-b\").steps.length, 1);\n});\nEOF\ncat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\nconst cli = new URL(\"../src/cli.ts\", import.meta.url).pathname;\n\nfunction resource(id: string, extra: Record<string, unknown> = {}) {\n  return { id, type: \"volume\", name: id, depends_on: [], ...extra };\n}\n\ntest(\"CLI preserves labels across pages for plan, list, gc and teardown\", async (t) => {\n  const resources = [\n    resource(\"net\", { type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { stack_id: \"stk-feat-a\" }),\n    ...Array.from({ length: 18 }, (_, i) => resource(`other-${i}`, { tags: { branch: \"other\" } })),\n    resource(\"instance\", { type: \"instance\", labels: { Branch: \"feat-a\" }, depends_on: [\"net\", \"boot\"] }),\n    resource(\"dns\", { type: \"dns_record\", labels: { bRaNcH: \"feat-a\" }, depends_on: [\"instance\"] }),\n    resource(\"label-volume\", { labels: { BRANCH: \"feat-a\" } }),\n  ];\n  const remaining = new Map(resources.map((r) => [r.id, r]));\n  const deleted: string[] = [];\n  let retry = true;\n  let secondPages = 0;\n  const server = createServer((req, res) => {\n    assert.equal(req.headers.authorization, \"Bearer test-token\");\n    res.setHeader(\"Content-Type\", \"application/json\");\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      if (retry) {\n        retry = false;\n        res.writeHead(429, { \"Retry-After\": \"0\" });\n        res.end(JSON.stringify({ error: \"rate limit\" }));\n        return;\n      }\n      const cursor = url.searchParams.get(\"cursor\");\n      assert.ok(cursor === \"0\" || cursor === \"page 2/&\");\n      if (cursor !== \"0\") secondPages++;\n      const all = [...remaining.values()];\n      res.end(JSON.stringify({\n        resources: cursor === \"0\" ? all.slice(0, 20) : all.slice(20),\n        next_cursor: cursor === \"0\" && all.length"]
[80.153323, "i", " > 20 ? \"page 2/&\" : null,\n      }));\n      return;\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      assert.ok(remaining.has(id));\n      const dependents = [...remaining.values()].filter((r) => (r.depends_on as string[]).includes(id));\n      if (dependents.length) {\n        res.writeHead(409);\n        res.end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map((r) => r.id) }));\n        return;\n      }\n      remaining.delete(id);\n      deleted.push(id);\n      res.end(JSON.stringify({ deleted: id }));\n      return;\n    }\n    res.writeHead(404).end(\"{}\");\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address() as { port: number };\n  const run = (...args: string[]) => exec(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cli, ...args], {\n    env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n    timeout: 10000,\n  });\n\n  const result = await run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.match(result.stderr, /rate limited/);\n  const plan = JSON.parse(result.stdout);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((s: { id: string }) => s.id).sort(), [\"boot\", \"dns\", \"instance\", \"label-volume\", \"net\"]);\n  assert.match((await run(\"list\")).stdout, /feat-a\\s+4\\s/);\n  // The existing untagged stack resource is still reported as untagged, but labels are not.\n  assert.match((await run(\"gc\", \"--untagged\")).stdout, /1 untagged resources/);\n  await run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  assert.deepEqual(deleted, []);\n  assert.match((await run(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(5 resources\\)/);\n  assert.equal(deleted.length, 5);\n  assert.equal(remaining.size, 18);\n  assert.ok([...remaining.keys()].every((id) => id.startsWith(\"other-\")));\n  assert.equal(secondPages, 5);\n  const empty = JSON.parse((await run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n  assert.deepEqual(empty.steps, []);\n});\nEOF\nmake ci\n"]
