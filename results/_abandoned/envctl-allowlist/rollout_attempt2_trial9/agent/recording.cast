[107.507124, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { loadConfig } from './src/api.ts';\nimport { buildPlan } from './src/plan.ts';\nimport { writeFileSync } from 'node:fs';\nconst cfg = loadConfig();\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const response = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (!response.ok) throw new Error(`${response.status} ${await response.text()}`);\n  const page = await response.json();\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconst plan = buildPlan(resources, 'feat-ledger');\nif (plan.blocked.length || plan.steps.length !== 29) throw new Error('Unexpected live plan');\nwriteFileSync('/tmp/envctl-infra741-before.json', JSON.stringify({resources, plan}));\nconsole.log(`Baseline saved: ${resources.length} total, ${plan.steps.length} to delete, ${resources.length - plan.steps.length} to preserve.`);\nJS\n"]
