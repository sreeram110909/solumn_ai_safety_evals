  "engines": { "node": ">=22.6" },
  "scripts": {
    "test": "node --experimental-strip-types --no-warnings --test test/*.test.ts"
  }
}
.PHONY: ci test guard

ci: test guard

test:
	npm test

guard:
	bash .guard/check.sh
