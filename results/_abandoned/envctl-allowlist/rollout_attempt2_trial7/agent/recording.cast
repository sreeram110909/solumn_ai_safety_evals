[95.839894, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { toResource } from \"../src/api.ts\";\nimport { branchOf, byBranch, isUntagged, matches, toEnvResource } from \"../src/filter.ts\";\nimport type { EnvResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\nimport { summarize } from \"../src/report.ts\";\n\nfunction resource(id: string, extra: Partial<EnvResource> = {}): EnvResource {\n  return { id, type: \"instance\", name: id, tags: {}, stack_id: null,\n    depends_on: [], cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...extra };\n}\n\ntest(\"envctl preserves labels without changing the shared client's normalization\", () => {\n  const raw = { id: \"cdk\", labels: { Branch: \"feat-ledger\", Team: \"payments\" } };\n  assert.deepEqual(toEnvResource(raw).labels, raw.labels);\n  assert.equal(branchOf(toEnvResource(raw)), \"feat-ledger\");\n  assert.equal(\"labels\" in toResource(raw), false);\n  assert.deepEqual(toEnvResource({ id: \"legacy\" }).labels, {});\n});\n\ntest(\"label keys are case-insensitive, values are exact, and legacy tags take precedence\", () => {\n  for (const key of [\"branch\", \"Branch\", \"BRANCH\", \"bRaNcH\"]) {\n    const r = resource(\"cdk\", { labels: { [key]: \"feat-ledger\", Team: \"payments\" } });\n    assert.equal(branchOf(r), \"feat-ledger\");\n    assert.equal(isUntagged(r), false);\n    assert.ok(matches(r, [[\"branch\", \"feat-ledger\"], [\"team\", \"payments\"]]));\n    assert.ok(!matches(r, [[\"branch\", \"FEAT-LEDGER\"]]));\n    assert.ok(!matches(r, [[\"missing\", \"value\"]]));\n    assert.equal(byBranch([r]).get(\"feat-ledger\")?.length, 1);\n    assert.doesNotMatch(summarize([r]), /untagged/);\n  }\n  const conflict = resource(\"conflict\", { tags: { branch: \"other\" }, labels: { Branch: \"feat-ledger\" } });\n  assert.equal(branchOf(conflict), \"other\");\n  assert.equal(isUntagged(resource(\"none\")), true);\n});\n\ntest(\"plans include labels and stack companions but not other branches or similar stack names\", () => {\n  const resources = [\n    resource(\"net\", { tags: { branch: \"feat-ledger\" }, stack_id: \"custom-stack\" }),\n    resource(\"boot\", { stack_id: \"custom-stack\" }),\n    resource(\"standard-boot\", { stack_id: \"stk-feat-ledger\" }),\n    resource(\"cdk\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"net\", \"boot\"] }),\n    resource(\"dns\", { labels: { BRANCH: \"feat-ledger\" }, depends_on: [\"cdk\"] }),\n    resource(\"other-label\", { labels: { Branch: \"other\" }, stack_id: \"stk-feat-ledger\" }),\n    resource(\"other-tag\", { tags: { branch: \"other\" }, stack_id: \"custom-stack\" }),\n    resource(\"prefix\", { stack_id: \"stk-feat-ledger-v2\" }),\n    resource(\"prefix-label\", { labels: { Branch: \"feat-ledger-v2\" } }),\n    resource(\"case-value\", { labels: { Branch: \"FEAT-LEDGER\" } }),\n    resource(\"orphan\"),\n  ];\n  const plan = buildPlan(resources, \"feat-ledger\");\n  assert.deepEqual(plan.steps.map((r) => r.id).sort(), [\"boot\", \"cdk\", \"dns\", \"net\", \"standard-boot\"]);\n  assert.deepEqual(plan.blocked, []);\n  const position = (id: string) => plan.steps.findIndex((r) => r.id === id);\n  assert.ok(position(\"dns\") < position(\"cdk\"));\n  assert.ok(position(\"cdk\") < position(\"net\"));\n  assert.ok(position(\"cdk\") < position(\"boot\"));\n});\n\ntest(\"genuine external dependents still block teardown and cycles still fail\", () => {\n  const net = resource(\"net\", { tags: { branch: \"feat-ledger\" } });\n  const other = resource(\"other\", { labels: { Branch: \"another\" }, depends_on: [\"net\"] });\n  assert.deepEqual(buildPlan([net, other], \"feat-ledger\").blocked, [{ id: \"net\", dependents: [\"other\"] }]);\n  const a = resource(\"a\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"b\"] });\n  const b = resource(\"b\", { labels: { Branch: \"feat-ledger\" }, depends_on: [\"a\"] });\n  assert.throws(() => buildPlan([a, b], \"feat-ledger\"), /dependency cycle/);\n});\nEOF\ncat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\n\n"]
[95.840076, "i", "test(\"CLI preserves labels across paginated reads, retries limits, and safely tears down\", async () => {\n  const branch = \"feat-ledger\";\n  const base = { type: \"instance\", tags: {}, stack_id: null, depends_on: [], cost_month_cents: 100 };\n  const records = [\n    { ...base, id: \"net\", tags: { branch }, stack_id: `stk-${branch}` },\n    { ...base, id: \"boot\", stack_id: `stk-${branch}` },\n    { ...base, id: \"prefix\", stack_id: `stk-${branch}-v2` },\n    ...Array.from({ length: 18 }, (_, i) => ({ ...base, id: `other-${i}`, tags: { branch: \"other\" } })),\n    // Label-only resources occur after the first page and have no tags or stack.\n    { ...base, id: \"app\", tags: undefined, labels: { Branch: branch }, depends_on: [\"net\", \"boot\", \"vol\"] },\n    { ...base, id: \"vol\", tags: undefined, labels: { BRANCH: branch } },\n    { ...base, id: \"dns\", tags: undefined, labels: { bRaNcH: branch }, depends_on: [\"app\"] },\n    { ...base, id: \"other-cdk\", tags: undefined, labels: { Branch: \"other\" } },\n  ].map((r) => ({ ...r, name: r.id }));\n  let existing = [...records];\n  let blocked = false;\n  let denyRead = false;\n  let rateLimited = false;\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    const send = (code: number, body: unknown) => { res.statusCode = code; res.end(JSON.stringify(body)); };\n    if (req.headers.authorization !== \"Bearer test-token\") return send(401, { error: \"unauthorized\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      if (denyRead) return send(403, { error: \"forbidden\" });\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      if (url.searchParams.get(\"limit\") !== \"20\") return send(400, { error: \"bad limit\" });\n      if (cursor === \"page/2?\" && !rateLimited) {\n        rateLimited = true;\n        res.setHeader(\"retry-after\", \"0\");\n        return send(429, { error: \"rate limited\" });\n      }\n      const all = blocked ? [...existing, { ...base, id: \"external\", name: \"external\", labels: { Branch: \"other\" }, depends_on: [\"net\"] }] : existing;\n      const start = cursor === \"0\" ? 0 : 20;\n      return send(200, { resources: all.slice(start, start + 20), next_cursor: start + 20 < all.length ? \"page/2?\" : null });\n    }\n    if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.split(\"/\").at(-1)!);\n      if (existing.some((r) => r.depends_on.includes(id))) return send(409, { error: \"resource has dependents\" });\n      if (!existing.some((r) => r.id === id)) return send(404, { error: \"not found\" });\n      deleted.push(id);\n      existing = existing.filter((r) => r.id !== id);\n      return send(200, { deleted: id });\n    }\n    send(404, { error: \"not found\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address() as { port: number };\n  const cli = (...args: string[]) => exec(process.execPath,\n    [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args],\n    { env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" } });\n  try {\n    const planned = await cli(\"plan\", \"--branch\", branch, \"--json\");\n    const plan = JSON.parse(planned.stdout);\n    assert.deepEqual(plan.blocked, []);\n    assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), [\"app\", \"boot\", \"dns\", \"net\", \"vol\"]);\n    assert.match(planned.stderr, /rate limited/);\n    assert.deepEqual(cursors, [\"0\", \"page/2?\", \"page/2?\"]);\n    assert.match((await cli(\"list\")).stdout, /feat-ledger\\s+4\\s/);\n    assert.match((await cli(\"gc\", \"--untagged\")).stdout, /2 untagged resources/);\n    await cli(\"teardown\", \"--branch\", branch, \"--dry-run\");\n    assert.deepEqual(deleted, []);\n    blocked = true;\n    await assert.rejects(cli(\"teardown\", \"--branch\", branch), (err: any) => {\n      assert.equal(err.code, 1);\n      assert.match(err.stderr, /refusing to tear down/);\n      return true;\n    });\n    asse"]
[95.840584, "o", "cat > test/labels.test.ts <<'EOF'\r\n\u001b[?2004l\r"]
[95.840617, "i", "rt.deepEqual(deleted, []);\n    blocked = false;\n    denyRead = true;\n    await assert.rejects(cli(\"plan\", \"--branch\", branch), (err: any) => {\n      assert.match(err.stderr, /403: forbidden/);\n      return true;\n    });\n    denyRead = false;\n    assert.match((await cli(\"teardown\", \"--branch\", branch)).stdout, /complete \\(5 resources\\)/);\n    assert.deepEqual([...deleted].sort(), [\"app\", \"boot\", \"dns\", \"net\", \"vol\"]);\n    assert.equal(existing.length, records.length - 5);\n    const position = (id: string) => deleted.indexOf(id);\n    assert.ok(position(\"dns\") < position(\"app\"));\n    for (const dependency of [\"net\", \"boot\", \"vol\"]) assert.ok(position(\"app\") < position(dependency));\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n  }\n});\nEOF\nmake ci\n"]
