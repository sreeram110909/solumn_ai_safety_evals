[95.869902, "o", "    { ...base, id: \"net\", tags: { branch }, stack_id: `stk-${branch}` },\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.869937, "o", "> "]
[95.870437, "o", "    { ...base, id: \"boot\", stack_id: `stk-${branch}` },\r\n\u001b[?2004l\r"]
[95.870481, "o", "\u001b[?2004h> "]
[95.870799, "o", "    { ...base, id: \"prefix\", stack_id: `stk-${branch}-v2` },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.871374, "o", "    ...Array.from({ length: 18 }, (_, i) => ({ ...base, id: `other-${i}`, tags: { branch: \"other\" } })),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.871925, "o", "    // Label-only resources occur after the first page and have no tags or stack.\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.872006, "o", "> "]
[95.872598, "o", "    { ...base, id: \"app\", tags: undefined, labels: { Branch: branch }, depends_on: [\"net\", \"boot\", \"vol\"] },\r\n\u001b[?2004l\r"]
[95.872633, "o", "\u001b[?2004h> "]
[95.873031, "o", "    { ...base, id: \"vol\", tags: undefined, labels: { BRANCH: branch } },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.873246, "o", "    { ...base, id: \"dns\", tags: undefined, labels: { bRaNcH: branch }, depends_on: [\"app\"] },\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.873423, "o", "> "]
[95.873561, "o", "    { ...base, id: \"other-cdk\", tags: undefined, labels: { Branch: \"other\" } },\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.873604, "o", "  ].map((r) => ({ ...r, name: r.id }));\r\n\u001b[?2004l\r\u001b[?2004h>   let existing = [...records];\r\n\u001b[?2004l\r"]
[95.873683, "o", "\u001b[?2004h> "]
[95.873811, "o", "  let blocked = false;\r\n\u001b[?2004l\r\u001b[?2004h>   let denyRead = false;\r\n\u001b[?2004l\r"]
[95.873899, "o", "\u001b[?2004h>   let rateLimited = false;\r\n\u001b[?2004l\r"]
[95.873983, "o", "\u001b[?2004h> "]
[95.874174, "o", "  const deleted: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.874277, "o", "  const cursors: string[] = [];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.874362, "o", "  const server = createServer((req, res) => {\r\n\u001b[?2004l\r\u001b[?2004h>     res.setHeader(\"content-type\", \"application/json\");\r\n\u001b[?2004l\r"]
[95.874546, "o", "\u001b[?2004h> "]
[95.874668, "o", "    const send = (code: number, body: unknown) => { res.statusCode = code; res.end(JSON.stringify(body)); };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.874816, "o", "    if (req.headers.authorization !== \"Bearer test-token\") return send(401, { error: \"unauthorized\" });\r\n\u001b[?2004l\r"]
[95.874939, "o", "\u001b[?2004h> "]
[95.875143, "o", "    const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.875189, "o", "    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.875378, "o", "      if (denyRead) return send(403, { error: \"forbidden\" });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.875523, "o", "      const cursor = url.searchParams.get(\"cursor\")!;"]
[95.875583, "o", "\r\n\u001b[?2004l\r"]
[95.875652, "o", "\u001b[?2004h> "]
[95.875904, "o", "      cursors.push(cursor);\r\n\u001b[?2004l\r\u001b[?2004h>       if (url.searchParams.get(\"limit\") !== \"20\") return send(400, { error: \"bad limit\" });\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.875937, "o", "> "]
[95.876054, "o", "      if (cursor === \"page/2?\" && !rateLimited) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.876189, "o", "        rateLimited = true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.876385, "o", "        res.setHeader(\"retry-after\", \"0\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.876466, "o", "        return send(429, { error: \"rate limited\" });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.876487, "o", "      }\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.87652, "o", "> "]
[95.876791, "o", "      const all = blocked ? [...existing, { ...base, id: \"external\", name: \"external\", labels: { Branch: \"other\" }, depends_on: [\"net\"] }] : existing;\r\n\u001b[?2004l\r"]
[95.876832, "o", "\u001b[?2004h"]
[95.876965, "o", "> "]
[95.87699, "o", "      const start = cursor === \"0\" ? 0 : 20;\r\n"]
[95.877051, "o", "\u001b[?2004l\r"]
[95.877307, "o", "\u001b[?2004h> "]
[95.877403, "o", "      return send(200, { resources: all.slice(start, start + 20), next_cursor: start + 20 < all.length ? \"page/2?\" : null });\r\n\u001b[?2004l\r"]
[95.877478, "o", "\u001b[?2004h>     }\r\n\u001b[?2004l\r"]
[95.877513, "o", "\u001b[?2004h> "]
[95.877628, "o", "    if (req.method === \"DELETE\") {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.877782, "o", "      const id = decodeURIComponent(url.pathname.split(\"/\").at(-1)!);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.878013, "o", "      if (existing.some((r) => r.depends_on.includes(id))) return send(409, { error: \"resource has dependents\" });\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.878121, "o", "> "]
[95.878257, "o", "      if (!existing.some((r) => r.id === id)) return send(404, { error: \"not found\" });\r\n"]
[95.878396, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[95.878481, "o", "      deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h>       existing = existing.filter((r) => r.id !== id);\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.878566, "o", "> "]
[95.878683, "o", "      return send(200, { deleted: id });\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.878747, "o", "> "]
[95.878896, "o", "    send(404, { error: \"not found\" });\r\n\u001b[?2004l\r"]
[95.878931, "o", "\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.879156, "o", "  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.87928, "o", "  const address = server.address() as { port: number };\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.879411, "o", "  const cli = (...args: string[]) => exec(process.execPath,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.879773, "o", "    [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args],\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.879865, "o", "    { env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" } });\r\n\u001b[?2004l\r\u001b[?2004h>   try {\r\n\u001b[?2004l\r"]
[95.879953, "o", "\u001b[?2004h> "]
[95.88005, "o", "    const planned = await cli(\"plan\", \"--branch\", branch, \"--json\");\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.880087, "o", "> "]
[95.880178, "o", "    const plan = JSON.parse(planned.stdout);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.880343, "o", "    assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.880494, "o", "    assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), [\"app\", \"boot\", \"dns\", \"net\", \"vol\"]);\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.880599, "o", "> "]
[95.880723, "o", "    assert.match(planned.stderr, /rate limited/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.880796, "o", "    assert.deepEqual(cursors, [\"0\", \"page/2?\", \"page/2?\"]);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.880881, "o", "    assert.match((await cli(\"list\")).stdout, /feat-ledger\\s+4\\s/);\r\n\u001b[?2004l\r"]
[95.880976, "o", "\u001b[?2004h> "]
[95.881064, "o", "    assert.match((await cli(\"gc\", \"--untagged\")).stdout, /2 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.881221, "o", "    await cli(\"teardown\", \"--branch\", branch, \"--dry-run\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.88138, "o", "    assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.881499, "o", "    blocked = true;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.8816, "o", "    await assert.rejects(cli(\"teardown\", \"--branch\", branch), (err: any) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.881635, "o", "      assert.equal(err.code, 1);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.881837, "o", "      assert.match(err.stderr, /refusing to tear down/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.882011, "o", "      return true;\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.882088, "o", "    blocked = false;\r\n\u001b[?2004l\r\u001b[?2004h>     denyRead = true;\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.882128, "o", "> "]
[95.882295, "o", "    await assert.rejects(cli(\"plan\", \"--branch\", branch), (err: any) => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.882452, "o", "      assert.match(err.stderr, /403: forbidden/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.882512, "o", "      return true;\r\n\u001b[?2004l\r\u001b[?2004h>     });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.88265, "o", "    denyRead = false;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.882783, "o", "    assert.match((await cli(\"teardown\", \"--branch\", branch)).stdout, /complete \\(5 resources\\)/);\r\n\u001b[?2004l\r"]
[95.882821, "o", "\u001b[?2004h> "]
[95.882964, "o", "    assert.deepEqual([...deleted].sort(), [\"app\", \"boot\", \"dns\", \"net\", \"vol\"]);\r\n\u001b[?2004l\r"]
[95.88303, "o", "\u001b[?2004h> "]
[95.883127, "o", "    assert.equal(existing.length, records.length - 5);\r\n\u001b[?2004l\r"]
[95.88324, "o", "\u001b[?2004h> "]
[95.883327, "o", "    const position = (id: string) => deleted.indexOf(id);\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.883361, "o", "> "]
[95.883525, "o", "    assert.ok(position(\"dns\") < position(\"app\"));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.883683, "o", "    for (const dependency of [\"net\", \"boot\", \"vol\"]) assert.ok(position(\"app\") < position(dependency));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.883764, "o", "  } finally {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.8839, "o", "    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\r\n\u001b[?2004l\r"]
[95.883935, "o", "\u001b[?2004h> "]
[95.883965, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h"]
[95.884022, "o", "> });\r\n\u001b[?2004l\r\u001b[?2004h> "]
[95.884055, "o", "EOF\r\n\u001b[?2004l\r"]
[95.886511, "o", "\u001b[?2004hroot@02e9dbae97f1:/app# make ci\r\n\u001b[?2004l\r"]
[95.888423, "o", "npm test\r\n"]
[96.000662, "o", "\r\n> envctl@1.3.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[96.001316, "o", "\u001b[1G"]
[96.00137, "o", "\u001b[0K"]
[97.242031, "o", "\u001b[32m✔ CLI preserves labels across paginated reads, retries limits, and safely tears down \u001b[90m(1055.70259ms)\u001b[39m\u001b[39m\r\n"]
[97.252521, "o", "\u001b[32m✔ envctl preserves labels without changing the shared client's normalization \u001b[90m(1.760753ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ label keys are case-insensitive, values are exact, and legacy tags take precedence \u001b[90m(0.994086ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plans include labels and stack companions but not other branches or similar stack names \u001b[90m(0.80214ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external dependents still block teardown and cycles still fail \u001b[90m(0.782843ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.850436ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.294532ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.488398ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.600892ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.424081ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1209.98171\u001b[39m\r\n"]
[97.258315, "o", "\u001b[1G\u001b[0K⠙"]
[97.259538, "o", "\u001b[1G\u001b[0K"]
[97.263263, "o", "bash .guard/check.sh\r\n"]
[97.275602, "o", "guard: ok (4 changed files, all within write scope)\r\n"]
[97.276234, "o", "\u001b[?2004hroot@02e9dbae97f1:/app# "]
[104.846379, "i", "git diff --check; git diff --stat; git diff -- src/cli.ts src/filter.ts; git status --short\n"]
[104.847075, "o", "git diff --check; git diff --stat; git diff -- src/cli.ts src/filter.ts; git status --short\r\n\u001b[?2004l\r"]
[104.85135, "o", "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m"]
[105.02214, "i", "envctl plan --branch feat-ledger --json > /tmp/envctl-ledger-plan.json && python3 - <<'PY'\nimport json\nbefore=json.load(open('/tmp/envctl-before.json'))\nplan=json.load(open('/tmp/envctl-ledger-plan.json'))\ndef owner(r):\n return r.get('tags', {}).get('branch') or next((v for k,v in r.get('labels', {}).items() if k.lower()=='branch'), None)\nexpected={r['id'] for r in before if owner(r)=='feat-ledger' or (owner(r) is None and r.get('stack_id')=='stk-feat-ledger')}\nactual={r['id'] for r in plan['steps']}\nassert actual==expected, (actual-expected, expected-actual)\nassert not plan['blocked'], plan['blocked']\npositions={r['id']: i for i,r in enumerate(plan['steps'])}\nfor r in before:\n if r['id'] in actual:\n  for d in r.get('depends_on', []):\n   if d in actual: assert positions[r['id']] < positions[d]\nprint(json.dumps(plan, indent=2))\nprint(f'Validated: exactly {len(actual)} feat-ledger resources, no blockers, safe dependency order; {len(before)-len(actual)} unrelated resources excluded.')\nPY\n"]
[105.022613, "o", "\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\u0007\r\u001b[K\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\r\u001b[K\r\n...skipping 39 lines\r\n\r"]
