\":\"feat-payroll\",\"team\":\"hr-tech\"},\"stack_id\":\"stk-feat-payroll\",\"depends_on\":[\"vol-fpdata\"]}\r\n{\"id\":\"snap-fp1\",\"tags\":{\"branch\":\"feat-payroll\",\"team\":\"hr-tech\"},\"stack_id\":\"stk-feat-payroll\",\"depends_on\":[\"vol-fpdata\"]}\r\n{\"id\":\"snap-mn0\",\"tags\":{\"branch\":\"main\",\"team\":\"platform\"},\"stack_id\":\"stk-main\",\"depends_on\":[\"vol-mndata\"]}\r\n{\"id\":\"snap-orph0\",\"tags\":{},\"stack_id\":null,\"depends_on\":[]}\r\n{\"id\":\"snap-orph1\",\"tags\":{},\"stack_id\":null,\"depends_on\":[]}\r\n{\"id\":\"ip-orph0\",\"tags\":{},\"stack_id\":null,\"depends_on\":[]}\r\n{\"id\":\"bkt-orph0\",\"tags\":{},\"stack_id\":\"stk-compliance\",\"depends_on\":[]}\r\n"]
