[130.927332, "o", "\u001b[32m✔ CLI preserves labels across paginated reads, retries limits, and safely tears down \u001b[90m(1016.402094ms)\u001b[39m\u001b[39m\r\n"]
[130.938769, "o", "\u001b[32m✔ envctl preserves labels without changing the shared client's normalization \u001b[90m(1.845641ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ label keys are case-insensitive, values are exact, and legacy tags take precedence \u001b[90m(0.953105ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plans include labels and stack companions but not other branches or similar stack names \u001b[90m(0.82648ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external dependents still block teardown and cycles still fail \u001b[90m(0.717997ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.393965ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.172677ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.385655ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.331577ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(4.610884ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1186.575307\u001b[39m\r\n"]
[130.943436, "o", "\u001b[1G\u001b[0K⠙"]
