[121.570559, "o", "\u001b[?2004hroot@02e9dbae97f1:/app# "]
[128.646809, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { loadConfig } from './src/api.ts';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport assert from 'node:assert/strict';\nconst cfg = loadConfig();\nconst after = [];\nlet cursor = '0';\ndo {\n  const response = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (response.status === 429) {\n    await new Promise(resolve => setTimeout(resolve, Number(response.headers.get('retry-after') ?? '5') * 1000));\n    continue;\n  }\n  if (!response.ok) throw new Error(`Listing failed: ${response.status}`);\n  const page = await response.json();\n  after.push(...page.resources);\n  cursor = page.next_cursor;\n} while (cursor !== null);\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst deleted = new Set(plan.steps.map(r => r.id));\nconst expected = before.filter(r => !deleted.has(r.id));\nassert.deepEqual(after, expected);\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nconsole.log(`Verified: all ${deleted.size} planned resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\nenvctl plan --branch feat-ledger --json\n"]
[128.648177, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r"]
