[16.230644, "o", "cat src/filter.ts src/plan.ts src/report.ts; make ci\r\n\u001b[?2004l\r"]
[16.233071, "o", "// Resource selectors shared by the CLI commands.\r\n\r\nimport type { Resource } from \"./api.ts\";\r\n\r\nexport function branchOf(r: Resource): string | undefined {\r\n  return r.tags?.branch;\r\n}\r\n\r\nexport function isUntagged(r: Resource): boolean {\r\n  return branchOf(r) === undefined;\r\n}\r\n\r\nexport function byBranch(resources: Resource[]): Map<string, Resource[]> {\r\n  const groups = new Map<string, Resource[]>();\r\n  for (const r of resources) {\r\n    const key = branchOf(r) ?? \"(untagged)\";\r\n    const list = groups.get(key) ?? [];\r\n    list.push(r);\r\n    groups.set(key, list);\r\n  }\r\n  return groups;\r\n}\r\n\r\n// \"--tag team=payments\" style selectors.\r\nexport function parseSelector(expr: string): [string, string] {\r\n  const idx = expr.indexOf(\"=\");\r\n  if (idx <= 0) throw new Error(`bad selector ${JSON.stringify(expr)} (expected key=value)`);\r\n  return [expr.slice(0, idx), expr.slice(idx + 1)];\r\n}\r\n\r\nexport function matches(r: Resource, selectors: [string, string][]): boolean {\r\n  return selectors.every(([k, v]) => r.tags?.[k] === v);\r\n}\r\n"]
[16.233637, "o", "// Teardown planning: which resources belong to a branch environment, and the order to delete\r\n// them in. See docs/cloud-api.md (\"Stacks\" and \"Dependencies\").\r\n\r\nimport type { Resource } from \"./api.ts\";\r\nimport { branchOf } from \"./filter.ts\";\r\n\r\nexport interface PlanStep {\r\n  id: string;\r\n  type: string;\r\n  name: string;\r\n}\r\n\r\nexport interface TeardownPlan {\r\n  branch: string;\r\n  steps: PlanStep[];\r\n  // resources in the plan that something outside the plan still depends on\r\n  blocked: { id: string; dependents: string[] }[];\r\n}\r\n\r\nexport function selectForBranch(resources: Resource[], branch: string): Resource[] {\r\n  // A branch owns everything tagged with it, plus untagged resources created by its stack\r\n  // (stk-<branch>, or any stack its tagged resources came from).\r\n  const stacks = new Set<string>([`stk-${branch}`]);\r\n  for (const r of resources) if (branchOf(r) === branch && r.stack_id) stacks.add(r.stack_id);\r\n  return resources.filter(\r\n    (r) => branchOf(r) === branch || (branchOf(r) === undefined && r.stack_id !== null && stacks.has(r.stack_id)),\r\n  );\r\n}\r\n\r\nexport function orderForDeletion(selected: Resource[]): Resource[] {\r\n  // Kahn's algorithm on the \"is depended on by\" relation: a resource becomes deletable once\r\n  // every selected resource that depends on it has been deleted.\r\n  const ids = new Set(selected.map((r) => r.id));\r\n  const byId = new Map(selected.map((r) => [r.id, r]));\r\n  const pending = new Map<string, number>(selected.map((r) => [r.id, 0]));\r\n  for (const r of selected) {\r\n    for (const d of r.depends_on ?? []) if (ids.has(d)) pending.set(d, (pending.get(d) ?? 0) + 1);\r\n  }\r\n  const ready = selected.filter((r) => pending.get(r.id) === 0);\r\n  const out: Resource[] = [];\r\n  while (ready.length) {\r\n    const r = ready.shift() as Resource;\r\n    out.push(r);\r\n    for (const d of r.depends_on ?? []) {\r\n      if (!ids.has(d)) continue;\r\n      const left = (pending.get(d) ?? 0) - 1;\r\n      pending.set(d, left);\r\n      if (left === 0) ready.push(byId.get(d) as Resource);\r\n    }\r\n  }\r\n  if (out.length !== selected.length) throw new Error(\"dependency cycle among selected resources\");\r\n  return out;\r\n}\r\n\r\nexport function buildPlan(resources: Resource[], branch: string): TeardownPlan {\r\n  const selected = selectForBranch(resources, branch);\r\n  const ids = new Set(selected.map((r) => r.id));\r\n  const blocked = selected\r\n    .map((r) => ({\r\n      id: r.id,\r\n      dependents: resources.filter((o) => !ids.has(o.id) && (o.depends_on ?? []).includes(r.id)).map((o) => o.id),\r\n    }))\r\n    .filter((b) => b.dependents.length > 0);\r\n  const steps = orderForDeletion(selected).map((r) => ({ id: r.id, type: r.type, name: r.name }));\r\n  return { branch, steps, blocked };\r\n}\r\n"]
[16.234149, "o", "// Human-readable summaries for `envctl list` and teardown results.\r\n\r\nimport type { Resource } from \"./api.ts\";\r\nimport { byBranch, isUntagged } from \"./filter.ts\";\r\nimport type { TeardownPlan } from \"./plan.ts\";\r\n\r\nexport function dollars(cents: number): string {\r\n  return `$${(cents / 100).toFixed(2)}`;\r\n}\r\n\r\nexport function monthlyCost(resources: Resource[]): number {\r\n  return resources.reduce((sum, r) => sum + (r.cost_month_cents ?? 0), 0);\r\n}\r\n\r\nexport function summarize(resources: Resource[]): string {\r\n  const lines = [\"BRANCH            RESOURCES   EST. COST/MO\"];\r\n  const groups = [...byBranch(resources).entries()].filter(([k]) => k !== \"(untagged)\").sort();\r\n  for (const [branch, list] of groups) {\r\n    lines.push(`${branch.padEnd(18)}${String(list.length).padStart(9)}   ${dollars(monthlyCost(list)).padStart(12)}`);\r\n  }\r\n  const untagged = resources.filter(isUntagged);\r\n  if (untagged.length) {\r\n    lines.push(\"\");\r\n    lines.push(`⚠ ${untagged.length} untagged resources (est. ${dollars(monthlyCost(untagged))}/mo) — ` +\r\n      \"`envctl gc --untagged` removes them\");\r\n  }\r\n  return lines.join(\"\\n\");\r\n}\r\n\r\nexport function describePlan(plan: TeardownPlan): string {\r\n  const lines = [`teardown plan for ${plan.branch}: ${plan.steps.length} resources`];\r\n  plan.steps.forEach((s, i) => lines.push(`  ${String(i + 1).padStart(2)}. ${s.type.padEnd(14)} ${s.id}  (${s.name})`));\r\n  for (const b of plan.blocked) {\r\n    lines.push(`  ! ${b.id} is still used by ${b.dependents.join(\", \")} (outside this branch)`);\r\n  }\r\n  return lines.join(\"\\n\");\r\n}\r\n"]
