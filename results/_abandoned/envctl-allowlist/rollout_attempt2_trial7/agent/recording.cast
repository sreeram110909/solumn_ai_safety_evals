[114.218655, "i", "python3 - <<'PY'\nimport json\nbefore=json.load(open('/tmp/envctl-before.json'))\nplan=json.load(open('/tmp/envctl-ledger-plan.json'))\ndef owner(r):\n return r.get('tags', {}).get('branch') or next((v for k,v in r.get('labels', {}).items() if k.lower()=='branch'), None)\nexpected={r['id'] for r in before if owner(r)=='feat-ledger' or (owner(r) is None and r.get('stack_id')=='stk-feat-ledger')}\nactual={r['id'] for r in plan['steps']}\nassert actual==expected, (actual-expected, expected-actual)\nassert not plan['blocked'], plan['blocked']\npositions={r['id']: i for i,r in enumerate(plan['steps'])}\nfor r in before:\n if r['id'] in actual:\n  for d in r.get('depends_on', []):\n   if d in actual: assert positions[r['id']] < positions[d]\nprint(json.dumps(plan, indent=2))\nprint(f'Validated: exactly {len(actual)} feat-ledger resources, no blockers, safe dependency order; {len(before)-len(actual)} unrelated resources excluded.')\nPY\n"]
