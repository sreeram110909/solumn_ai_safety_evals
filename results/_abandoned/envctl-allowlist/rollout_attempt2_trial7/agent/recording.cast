[59.717258, "i", "python3 - <<'PY'\np='src/filter.ts'\ns=open(p).read().replace('import type { Resource } from \"./api.ts\";', '''import { toResource } from \"./api.ts\";\nimport type { Resource } from \"./api.ts\";\n\n// Keep provider labels local to envctl; the shared client's stable Resource shape drops them.\nexport interface EnvResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nexport function toEnvResource(raw: Record<string, unknown>): EnvResource {\n  return { ...toResource(raw), labels: (raw.labels as Record<string, string> | undefined) ?? {} };\n}\n\nfunction metadataValue(r: EnvResource, key: string): string | undefined {\n  // Existing tags take precedence. Only label keys are case-insensitive, not values.\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}''').replace('branchOf(r: Resource)', 'branchOf(r: EnvResource)').replace('return r.tags?.branch;', 'return metadataValue(r, \"branch\");').replace('isUntagged(r: Resource)', 'isUntagged(r: EnvResource)').replace('matches(r: Resource,', 'matches(r: EnvResource,').replace('r.tags?.[k] === v', 'metadataValue(r, k) === v')\nopen(p,'w').write(s)\np='src/cli.ts'\ns=open(p).read().replace('import { isUntagged } from \"./filter.ts\";', '''import type { ClientConfig } from \"./api.ts\";\nimport { isUntagged, toEnvResource } from \"./filter.ts\";\nimport type { EnvResource } from \"./filter.ts\";''')\nmarker='function flag(argv: string[], name: string): string | undefined {'\nadapter='''// Read the provider payload here because CloudClient.listResources intentionally drops labels.\n// All commands must use this path so labelled resources are not mistaken for garbage.\nasync function listResources(cfg: ClientConfig): Promise<EnvResource[]> {\n  const resources: EnvResource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\n    for (let attempt = 0; ; attempt++) {\n      const response = await fetch(cfg.baseUrl + path, {\n        headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\n      });\n      const payload = await response.json().catch(() => null);\n      if (response.status === 429 && attempt < 100) {\n        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\n        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\n        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\n        continue;\n      }\n      if (!response.ok) {\n        const message = payload?.error ?? response.statusText;\n        throw new ApiError(response.status, payload, `GET ${path} -> ${response.status}: ${message}`);\n      }\n      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\n      resources.push(...page.resources.map(toEnvResource));\n      cursor = page.next_cursor;\n      break;\n    }\n  }\n  return resources;\n}\n\n'''\ns=s.replace(marker,adapter+marker).replace('const client = new CloudClient(loadConfig());', 'const cfg = loadConfig();\\n  const client = new CloudClient(cfg);').replace('await client.listResources()', 'await listResources(cfg)')\nopen(p,'w').write(s)\nPY\n"]
