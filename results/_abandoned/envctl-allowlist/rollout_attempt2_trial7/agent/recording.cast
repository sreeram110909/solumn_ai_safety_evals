[28.840114, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { loadConfig } from './src/api.ts';\nimport { writeFileSync } from 'node:fs';\nconst cfg = loadConfig();\nconst resources = [];\nlet cursor = '0';\ndo {\n  const response = await fetch(`${cfg.baseUrl}/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`, {headers: {authorization: `Bearer ${cfg.token}`}});\n  if (!response.ok) throw new Error(`Listing failed: ${response.status}`);\n  const page = await response.json();\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n} while (cursor !== null);\nwriteFileSync('/tmp/envctl-before.json', JSON.stringify(resources, null, 2));\nconsole.log(`Total resources: ${resources.length}`);\nfor (const r of resources) console.log(JSON.stringify({id:r.id,tags:r.tags,labels:r.labels,stack_id:r.stack_id,depends_on:r.depends_on}));\nJS\n"]
