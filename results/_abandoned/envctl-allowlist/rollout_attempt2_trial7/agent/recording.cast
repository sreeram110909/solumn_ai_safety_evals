[105.035075, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..3f30483 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -6,10 +6,43 @@\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[31m-import { isUntagged } from \"./filter.ts\";\u001b[m\r\n"]
[105.035669, "o", "\u001b[32m+\u001b[m\u001b[32mimport type { ClientConfig } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { isUntagged, toEnvResource } from \"./filter.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { EnvResource } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Read the provider payload here because CloudClient.listResources intentionally drops labels.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// All commands must use this path so labelled resources are not mistaken for garbage.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function listResources(cfg: ClientConfig): Promise<EnvResource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: EnvResource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const path = `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (let attempt = 0; ; attempt++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const response = await fetch(cfg.baseUrl + path, {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        headers: { authorization: `Bearer ${cfg.token}`, \"content-type\": \"application/json\" },\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      });\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const payload = await response.json().catch(() => null);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (response.status === 429 && attempt < 100) {\u001b[m\r\n"]
[105.036467, "o", "\u001b[32m+\u001b[m\u001b[32m        const wait = Number(response.headers.get(\"retry-after\") ?? \"5\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        console.error(`rate limited on GET ${path}; retrying in ${wait}s`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        await new Promise((resolve) => setTimeout(resolve, wait * 1000));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!response.ok) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        const message = payload?.error ?? response.statusText;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        throw new ApiError(response.status, payload, `GET ${path} -> ${response.status}: ${message}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const page = payload as { resources: Record<string, unknown>[]; next_cursor: string | null };\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      resources.push(...page.resources.map(toEnvResource));\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[32m+\u001b[m\u001b[32m      cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      break;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n\u001b[36m@@ -21,17 +54,18 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n     console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\u001b[m\r\n     return cmd ? 0 : 2;\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  const client = new CloudClient(loadConfig());\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const cfg = loadConfig();\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const client = new CloudClient(cfg);\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n\u001b[31m-    console.log(summarize(await client.listResources()));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    console.log(summarize(await listResources(cfg)));\u001b[m\r\n     return 0;\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   if (cmd === \"plan\" || cmd === \"teardown\") {\u001b[m\r\n     const branch = flag(rest, \"--branch\");\u001b[m\r\n     if (!branch) throw new Error(`${cmd} needs --branch`);\u001b[m\r\n\u001b[31m-    const plan = buildPlan(await client.listResources(), branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const plan = buildPlan(await listResources(cfg), branch);\u001b[m\r\n     if (cmd === \"plan\" && rest.includes(\"--json\")) {\u001b[m\r\n       console.log(JSON.stringify(plan));\u001b[m\r\n       return 0;\u001b[m\r\n\u001b[36m@@ -52,7 +86,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n \u001b[m\r\n   if (cmd === \"gc\") {\u001b[m\r\n     if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\u001b[m\r\n\u001b[31m-    const targets = (await client.listResources()).filter(isUntagged);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const targets = (await listResources(cfg)).filter(isUntagged);\u001b[m\r\n     console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n...skipping 39 lines\r\n"]
[105.036764, "o", "\r   return [expr.slice(0, idx), expr.slice(idx + 1)];\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function matches(r: Resource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[31m-  return selectors.every(([k, v]) => r.tags?.[k] === v);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function matches(r: EnvResource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectors.every(([k, v]) => metadataValue(r, k) === v);\u001b[m\r\n }\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\r\u001b[K\r\n...skipping 39 lines\r\n\r"]
