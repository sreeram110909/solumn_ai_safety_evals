[64.241772, "o", "\u001b[?2004hroot@82f85763b3c9:/app# "]
[64.44533, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n# --- PAY-412 regression coverage --------------------------------------------------\n@pytest.mark.parametrize(\n    \"old_code,new_code\",\n    [\n        (\"pro-monthly\", \"team-monthly\"),\n        (\"pro-annual\", \"team-annual\"),\n        (\"pro-annual\", \"pro-monthly\"),\n    ],\n)\ndef test_annual_upgrade_rejects_other_interval_combinations(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\n    \"start,end,credit\",\n    [\n        (date(2023, 2, 1), date(2023, 3, 1), 1782),\n        (date(2024, 2, 1), date(2024, 3, 1), 1721),\n        (date(2024, 11, 1), date(2024, 12, 1), 1663),\n        (date(2024, 1, 15), date(2024, 2, 15), 1610),\n    ],\n)\ndef test_annual_upgrade_last_day_uses_actual_period_days(start, end, credit):\n    from datetime import timedelta\n\n    period = Period(start, end)\n    on = end - timedelta(days=1)\n    r = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert r.old_plan == get_plan(\"starter-monthly\")\n    assert r.new_plan == get_plan(\"team-annual\")\n    assert r.period == period\n    assert r.on == on\n    assert (r.unused_days, r.credit, r.charge) == (1, credit, 4999000)\n    assert r.net == 4999000 - credit\n    assert r.new_period == annual_period(on)\n\n\ndef test_annual_upgrade_credit_rounds_half_up(monkeypatch):\n    from billing.plans import CATALOGUE, Plan\n\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    period = Period(date(2024, 2, 1), date(2024, 3, 1))\n    r = prorate_to_annual(\"test-monthly\", \"pro-annual\", period, date(2024, 2, 29))\n    assert r.credit == 3  # 101 / 29 rounds down\n    assert r.new_period == Period(date(2024, 2, 29), date(2025, 2, 28))\n\n    period = Period(date(2023, 2, 1), date(2023, 3, 1))\n    r = prorate_to_annual(\"test-monthly\", \"pro-annual\", period, date(2023, 2, 15))\n    assert r.credit == 51  # 101 * 14 / 28 = 50.5 paise\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32), (0, 0)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_appends_credit_without_mutating_charge_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    charge_lines = list(inv.lines)\n    expected = charge_lines + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == charge_lines\n    rendered = invoice.render(inv)\n    assert rendered == invoice.render(inv)\n    assert \"-849.43\" in rendered\n    assert \"-152.90\" in rendered\n    assert \"-1,002.33\" in rendered\n    assert rendered.splitlines()[-3:] == [\n        f\"{'Subtotal':<52}{'14,140.57':>34}\",\n        f\"{'GST @ 18%':<52}{'2,545.30':>34}\",\n        f\"{'Total due (INR)':<52}{'16,685.87':>34}\",\n    ]\n\n\ndef test_non_prorated_invoice_has_no_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_rows_have_sac_and_86_column_layout(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == rows[-4] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv), strict=True):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoi"]
[64.445409, "i", "ce.money(amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\n        assert row[75:] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_invoice_gst_is_sum_of_individually_rounded_lines():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"a\", 25), (\"b\", 25)])\n    rows = invoice.render(inv).splitlines()\n    assert rows[-2].strip() == \"GST @ 18%\" + \" \" * 64 + \"0.10\"\n    assert rows[-1].endswith(\"0.60\")\nPY\nmake update-golden\nmake ci\n"]
