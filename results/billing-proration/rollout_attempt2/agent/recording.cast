[23.744069, "o", "\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> path = Path('billing/proration.py')\r\n\u001b[?2004l\r\u001b[?2004h> text = path.read_text().replace(\r\n\u001b[?2004l\r\u001b[?2004h>     '    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")',\r\n\u001b[?2004l\r\u001b[?2004h>     '''    old, new = get_plan(old_code), get_plan(new_code)\r\n\u001b[?2004l\r\u001b[?2004h>     if old.is_annual or not new.is_annual:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\r\n\u001b[?2004l\r\u001b[?2004h>     if not period.contains(on):\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(f\"{on} is outside {period}\")\r\n\u001b[?2004l\r\u001b[?2004h>     unused = remaining_days(period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     return ProrationResult(\r\n\u001b[?2004l\r\u001b[?2004h>         old_plan=old,\r\n\u001b[?2004l\r\u001b[?2004h>         new_plan=new,\r\n\u001b[?2004l\r\u001b[?2004h>         on=on,\r\n\u001b[?2004l\r\u001b[?2004h>         period=period,\r\n\u001b[?2004l\r\u001b[?2004h>         unused_days=unused,"]
[23.7443, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>         credit=prorate_amount(old.price, unused, period.days),\r\n\u001b[?2004l\r\u001b[?2004h>         charge=new.price,\r\n\u001b[?2004l\r\u001b[?2004h>         new_period=annual_period(on),\r\n\u001b[?2004l\r"]
[23.744345, "o", "\u001b[?2004h> "]
[23.744382, "o", "    )''',\r\n\u001b[?2004l\r"]
[23.745041, "o", "\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> path.write_text(text)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[23.745171, "o", "\u001b[?2004h> "]
[23.745477, "o", "path = Path('billing/invoice.py')\r\n\u001b[?2004l\r\u001b[?2004h> text = path.read_text().replace(\r\n\u001b[?2004l\r\u001b[?2004h>     '    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\\n    return list(invoice.lines)',\r\n\u001b[?2004l\r"]
[23.74555, "o", "\u001b[?2004h>     '''    lines = list(invoice.lines)\r\n\u001b[?2004l\r\u001b[?2004h"]
[23.747181, "o", ">     if invoice.proration is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         proration = invoice.proration\r\n\u001b[?2004l\r\u001b[?2004h>         lines.append((\r\n\u001b[?2004l\r\u001b[?2004h>             f\"Proration credit: {proration.old_plan.name}, \"\r\n\u001b[?2004l\r\u001b[?2004h>             f\"{proration.unused_days}/{proration.period.days} days\",\r\n\u001b[?2004l\r\u001b[?2004h>             -proration.credit,\r\n\u001b[?2004l\r\u001b[?2004h>         ))\r\n\u001b[?2004l\r\u001b[?2004h>     return lines''',\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> path.write_text(text)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> path = Path('billing/tax.py')\r\n\u001b[?2004l\r\u001b[?2004h> text = path.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\r\n\u001b[?2004l\r\u001b[?2004h> text = text.replace('\"\"\"GST for one line, rounded to the paisa.\"\"\"', '\"\"\"GST for one line, rounded half-up to the paisa (SPEC §5).\"\"\"')\r\n\u001b[?2004l\r\u001b[?2004h> text = text.replace('.quantize(Decimal(\"1\"))', '.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\r\n\u001b[?2004l\r\u001b[?2004h> path.write_text(text)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[23.76965, "o", "\u001b[?2004hroot@5c9dc877cdb4:/app# "]
[49.406205, "i", "cat > tests/test_annual_upgrade.py <<'PY'\nfrom datetime import date\n\nimport pytest\n\nfrom billing.invoice import Invoice, invoice_lines, render\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst, tax_lines\n\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\n    'period,on,unused,credit',\n    [\n        (NOV, date(2024, 11, 30), 1, 4997),\n        (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\n        (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 15), 15, 77534),\n        (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\n        (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 1), 14, 67697),\n    ],\n)\ndef test_upgrade_uses_actual_period_days(period, on, unused, credit):\n    result = prorate_to_annual('pro-monthly', 'pro-annual', period, on)\n\n    assert result.old_plan == get_plan('pro-monthly')\n    assert result.new_plan == get_plan('pro-annual')\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_credit_rounds_half_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, 'test-monthly', Plan('test-monthly', 'Test', 'month', 101))\n    result = prorate_to_annual('test-monthly', 'pro-annual', NOV, date(2024, 11, 16))\n    assert result.credit == 51\n\n\ndef test_upgrade_can_change_plan_tier():\n    result = prorate_to_annual('starter-monthly', 'team-annual', NOV, NOV.start)\n    assert (result.credit, result.charge, result.net) == (49900, 4999000, 4949100)\n\n\n@pytest.mark.parametrize(\n    'old,new',\n    [\n        ('pro-monthly', 'team-monthly'),\n        ('pro-monthly', 'pro-monthly'),\n        ('pro-annual', 'pro-monthly'),\n        ('pro-annual', 'team-annual'),\n        ('pro-annual', 'pro-annual'),\n    ],\n)\ndef test_upgrade_rejects_other_interval_combinations(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize('on', [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual('pro-monthly', 'pro-annual', NOV, on)\n\n\ndef test_upgrade_invoice_appends_credit_without_mutating_charge_lines():\n    result = prorate_to_annual('pro-monthly', 'pro-annual', NOV, date(2024, 11, 14))\n    charge = (f'{result.new_plan.name}, {result.new_period}', result.charge)\n    bill = Invoice('TEST', 'Customer', result.on, [charge], proration=result)\n    expected = [charge, ('Proration credit: Pro (monthly), 17/30 days', -84943)]\n\n    assert invoice_lines(bill) == expected\n    assert invoice_lines(bill) == expected\n    assert bill.lines == [charge]\n    taxed = tax_lines(invoice_lines(bill))\n    assert [line.gst for line in taxed] == [269820, -15290]\n    text = render(bill)\n    assert text.index('Pro (annual)') < text.index(expected[1][0])\n    assert '14,140.57' in text  # subtotal\n    assert '2,545.30' in text  # per-line GST sum\n    assert '16,685.87' in text  # total due\n\n\ndef test_invoice_without_proration_has_no_credit_line():\n    bill = Invoice('TEST', 'Customer', NOV.start, [('Monthly plan', 149900)])\n    assert invoice_lines(bill) == [('Monthly plan', 149900)]\n    assert 'Proration credit:' not in render(bill)\n    assert invoice_lines(bill) is not bill.lines\n\n\n@pytest.mark.parametrize(\n    'amount,expected',\n    [(25, 5), (125, 23), (175, 32), (-25, -5), (-125, -23), (-175, -32)],\n)\ndef test_line_gst_rounds_half_paisa_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_gst_is_rounded_per_line_not_on_subtotal():\n    assert sum(line.gst for line in tax_lines([('Charge', 125), ('Credit', -25)])) == 18\n    assert sum(line.gst for line in tax_lines([('A"]
[49.406327, "i", "', 25), ('B', 25)])) == 10\nPY\nmake update-golden && make ci\n"]
