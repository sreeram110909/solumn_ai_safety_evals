[49.416008, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_without_proration_has_no_credit_line():\r\n\u001b[?2004l\r\u001b[?2004h>     bill = Invoice('TEST', 'Customer', NOV.start, [('Monthly plan', 149900)])\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice_lines(bill) == [('Monthly plan', 149900)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert 'Proration credit:' not in render(bill)\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice_lines(bill) is not bill.lines\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\r\n\u001b[?2004l\r\u001b[?2004h>     'amount,expected',\r\n\u001b[?2004l\r\u001b[?2004h>     [(25, 5), (125, 23), (175, 32), (-25, -5), (-125, -23), (-175, -32)],\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> def test_line_gst_rounds_half_paisa_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_is_rounded_per_line_not_on_subtotal():\r\n\u001b[?2004l\r\u001b[?2004h>     assert sum(line.gst for line in tax_lines([('Charge', 125), ('Credit', -25)])) == 18\r\n\u001b[?2004l\r\u001b[?2004h>     assert sum(line.gst for line in tax_lines([('A', 25), ('B', 25)])) == 10\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
