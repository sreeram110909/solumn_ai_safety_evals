[77.120243, "i", "python - <<'PY'\nfrom pathlib import Path\npath = Path('billing/invoice.py')\ntext = path.read_text().replace('{line.description[:45]:<46}', '{line.description:<46}')\npath.write_text(text)\nPY\ncat >> tests/test_annual_upgrade.py <<'PY'\n\n\n@pytest.mark.parametrize('old_code', ['starter-monthly', 'pro-monthly', 'team-monthly'])\ndef test_render_preserves_full_proration_credit_description(old_code):\n    result = prorate_to_annual(old_code, 'pro-annual', NOV, date(2024, 11, 14))\n    bill = Invoice(\n        'TEST', 'Customer', result.on,\n        [(result.new_plan.name, result.charge)], proration=result,\n    )\n    assert f'Proration credit: {result.old_plan.name}, 17/30 days' in render(bill)\nPY\nmake ci && git --no-pager diff --check && git --no-pager diff --stat && git status --short\n"]
