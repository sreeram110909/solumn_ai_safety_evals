[53.511502, "o", "def test_all_invoice_rows_have_sac_and_correct_width(number):\r\n\u001b[?2004l\r\u001b[?2004h>     bill = invoice.FIXTURES[number]()\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(bill).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(rendered[0]) == 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered[2] == \"-\" * 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     for row, (description, _) in zip(rendered[4:-4], invoice.invoice_lines(bill), strict=True):\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[:44] == f\"{description[:43]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered[-4] == \"-\" * 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(len(row) == 86 for row in rendered[-3:])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_long_invoice_description_is_truncated_before_sac():\r\n\u001b[?2004l\r\u001b[?2004h>     bill = invoice.Invoice(\"LONG\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 125)])\r\n\u001b[?2004l\r\u001b[?2004h>     row = invoice.render(bill).splitlines()[4]\r\n\u001b[?2004l\r\u001b[?2004h>     assert row == f\"{'x' * 43} {'998314':>8}{'1.25':>12}{'0.23':>11}{'1.48':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
