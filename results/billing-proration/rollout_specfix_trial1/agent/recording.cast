[30.373059, "i", "python - <<'PY'\nfrom pathlib import Path\n\np = Path('billing/proration.py')\ns = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.interval != \"month\" or new.interval != \"year\":\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\n    try:\n        unused = remaining_days(period, on)\n    except ValueError as exc:\n        raise ProrationError(str(exc)) from exc\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''')\np.write_text(s)\n\np = Path('billing/tax.py')\ns = p.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\ns = s.replace('quantize(Decimal(\"1\"))', 'quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\np.write_text(s)\n\np = Path('billing/invoice.py')\ns = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ns = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\n    return list(invoice.lines)''', '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        proration = invoice.proration\n        lines.append((\n            f\"Proration credit: {proration.old_plan.name}, \"\n            f\"{proration.unused_days}/{proration.period.days} days\",\n            -proration.credit,\n        ))\n    return lines''')\ns = s.replace('f\"{\\'Description\\':<46}{\\'Amount\\':>12}{\\'GST\\':>11}{\\'Total\\':>11}\"', 'f\"{\\'Description\\':<44}{\\'SAC\\':>8}{\\'Amount\\':>12}{\\'GST\\':>11}{\\'Total\\':>11}\"')\ns = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\ns = s.replace(\"'Subtotal':<46\", \"'Subtotal':<52\").replace(\"'GST @ 18%':<46\", \"'GST @ 18%':<52\").replace(\"'Total due (INR)':<46\", \"'Total due (INR)':<52\")\np.write_text(s)\nPY\n"]
[30.37701, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/proration.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\r\n\u001b[?2004l\r\u001b[?2004h>     if old.interval != \"month\" or new.interval != \"year\":\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         unused = remaining_days(period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(str(exc)) from exc\r\n\u001b[?2004l\r\u001b[?2004h>     return ProrationResult(\r\n\u001b[?2004l\r\u001b[?2004h>         old_plan=old,\r\n\u001b[?2004l\r\u001b[?2004h>         new_plan=new,\r\n\u001b[?2004l\r\u001b[?2004h>         on=on,\r\n\u001b[?2004l\r\u001b[?2004h>         period=period,\r\n\u001b[?2004l\r\u001b[?2004h>         unused_days=unused,\r\n\u001b[?2004l\r\u001b[?2004h>         credit=prorate_amount(old.price, unused, period.days),\r\n\u001b[?2004l\r\u001b[?2004h>         charge=new.price,\r\n\u001b[?2004l\r\u001b[?2004h>         new_period=annual_period(on),\r\n\u001b[?2004l\r\u001b[?2004h>     )''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/tax.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('quantize(Decimal(\"1\"))', 'quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/invoice.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\r\n\u001b[?2004l\r\u001b[?2004h>     return list(invoice.lines)''', '''    lines = list(invoice.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     if invoice.proration is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         proration = invoice.proration\r\n\u001b[?2004l\r\u001b[?2004h>         lines.append((\r\n\u001b[?2004l\r\u001b[?2004h>             f\"Proration credit: {proration.old_plan.name}, \"\r\n\u001b[?2004l\r\u001b[?2004h>             f\"{proration.unused_days}/{proration.period.days} days\",\r\n\u001b[?2004l\r\u001b[?2004h>             -proration.credit,\r\n\u001b[?2004l\r\u001b[?2004h>         ))\r\n\u001b[?2004l\r\u001b[?2004h>     return lines''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('f\"{\\'Description\\':<46}{\\'Amount\\':>12}{\\'GST\\':>11}{\\'Total\\':>11}\"', 'f\"{\\'Description\\':<44}{\\'SAC\\':>8}{\\'Amount\\':>12}{\\'GST\\':>11}{\\'Total\\':>11}\"')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(\"'Subtotal':<46\", \"'Subtotal':<52\").replace(\"'GST @ 18%':<46\", \"'GST @ 18%':<52\").replace(\"'Total due (INR)':<46\", \"'Total due (INR)':<52\")\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
