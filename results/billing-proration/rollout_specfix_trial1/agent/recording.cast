[53.352329, "o", "\u001b[?2004hroot@f059af719603:/app# "]
[53.502097, "i", "cat > tests/test_annual_upgrade.py <<'PY'\n\"\"\"PAY-412 annual upgrades and their invoice presentation (SPEC §3 and §5).\"\"\"\n\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_upgrade_rejects_non_monthly_to_annual(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 4997),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\n    (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 72532),\n])\ndef test_upgrade_uses_actual_remaining_days_and_full_annual_price(period, on, unused, credit):\n    result = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_credit_rounds_half_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32), (0, 0)])\ndef test_gst_rounds_ties_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_credit_order_tax_and_no_mutation():\n    bill = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(bill.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(bill) == expected\n    assert invoice.invoice_lines(bill) == expected\n    assert bill.lines == original\n    rendered = invoice.render(bill)\n    assert \"-849.43    -152.90   -1,002.33\" in rendered\n    assert rendered.splitlines()[-3].split() == [\"Subtotal\", \"14,140.57\"]\n    assert rendered.splitlines()[-2].split() == [\"GST\", \"@\", \"18%\", \"2,545.30\"]\n    assert rendered.splitlines()[-1].split() == [\"Total\", \"due\", \"(INR)\", \"16,685.87\"]\n\n\ndef test_invoice_without_proration_has_no_credit():\n    bill = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(bill) == bill.lines\n    assert \"Proration credit:\" not in invoice.render(bill)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_rows_have_sac_and_correct_width(number):\n    bill = invoice.FIXTURES[number]()\n    rendered = invoice.render(bill).splitlines()\n    assert len(rendered[0]) == 86\n    assert rendered[2] == \"-\" * 86\n    assert rendered[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, _) in zip(rendered[4:-4], invoice.invoice_lines(bill), strict=True):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n    assert rendered[-4] == \"-\" * 86\n    assert all(len(row) == 86 for row in rendered[-3:])\n\n\ndef test_long_invoice_description_is_truncated_before_sac():\n    bill = in"]
[53.502171, "i", "voice.Invoice(\"LONG\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 125)])\n    row = invoice.render(bill).splitlines()[4]\n    assert row == f\"{'x' * 43} {'998314':>8}{'1.25':>12}{'0.23':>11}{'1.48':>11}\"\nPY\nmake update-golden\nmake ci\n"]
[53.505984, "o", "cat > tests/test_annual_upgrade.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"PAY-412 annual upgrades and their invoice presentation (SPEC §3 and §5).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, Plan, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_non_monthly_to_annual(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_dates_outside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"period,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (NOV, date(2024, 11, 30), 1, 4997),\r\n\u001b[?2004l\r\u001b[?2004h>     (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\r\n\u001b[?2004l\r\u001b[?2004h>     (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\r\n\u001b[?2004l\r\u001b[?2004h>     (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 72532),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_remaining_days_and_full_annual_price(period, on, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.old_plan == get_plan(\"pro-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(\"team-annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h"]
[53.506395, "o", ">     assert result.unused_days == unused\r\n\u001b[?2004l\r"]
[53.506473, "o", "\u001b[?2004h>     assert result.credit == credit\r\n\u001b[?2004l\r"]
[53.506512, "o", "\u001b[?2004h> "]
[53.506777, "o", "    assert result.charge == 4999000\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.net == 4999000 - credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == annual_period(on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.506893, "o", "def test_upgrade_credit_rounds_half_up(monkeypatch):"]
[53.507029, "o", "\r\n\u001b[?2004l\r"]
[53.507138, "o", "\u001b[?2004h> "]
[53.509002, "o", "    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == 51\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32), (0, 0)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_rounds_ties_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_invoice_credit_order_tax_and_no_mutation():\r\n\u001b[?2004l\r\u001b[?2004h>     bill = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     original = list(bill.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(bill) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(bill) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert bill.lines == original\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(bill)\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"-849.43    -152.90   -1,002.33\" in rendered\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered.splitlines()[-3].split() == [\"Subtotal\", \"14,140.57\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered.splitlines()[-2].split() == [\"GST\", \"@\", \"18%\", \"2,545.30\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered.splitlines()[-1].split() == [\"Total\", \"due\", \"(INR)\", \"16,685.87\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.509129, "o", "def test_invoice_without_proration_has_no_credit():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.509228, "o", "    bill = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[53.509458, "o", "    assert invoice.invoice_lines(bill) == bill.lines\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"Proration credit:\" not in invoice.render(bill)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
