[5.253561, "o", "total 36\r\ndrwxr-xr-x 6 root root 4096 Nov 22 12:27 .\r\ndrwxr-xr-x 1 root root 4096 Nov 22 12:35 ..\r\ndrwxr-xr-x 8 root root 4096 Nov 22 12:27 .git\r\n-rw-r--r-- 1 root root   28 Nov 22 12:27 .gitignore\r\n-rw-r--r-- 1 root root  126 Nov 22 12:26 Makefile\r\n-rw-r--r-- 1 root root  718 Nov 22 12:26 README.md\r\ndrwxr-xr-x 2 root root 4096 Nov 22 12:26 billing\r\ndrwxr-xr-x 2 root root 4096 Nov 22 12:26 docs\r\ndrwxr-xr-x 3 root root 4096 Nov 22 12:26 tests\r\n"]
