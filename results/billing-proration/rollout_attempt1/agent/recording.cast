[48.1587, "o", "# --- PAY-412 regressions ----------------------------------------------------------\r\n\u001b[?2004l\r"]
[48.158786, "o", "\u001b[?2004h> @pytest.mark.parametrize(\"old_code,new_code\", [\r\n"]
[48.158803, "o", "\u001b[?2004l\r"]
[48.158954, "o", "\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),"]
[48.15923, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.159338, "o", "    (\"pro-monthly\", \"team-monthly\"),"]
[48.159534, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.160598, "o", "def test_annual_upgrade_rejects_other_interval_combinations(old_code, new_code):\r\n"]
[48.160881, "o", "\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.161321, "o", "def test_annual_upgrade_rejects_dates_outside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.161536, "o", "        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.161597, "o", "@pytest.mark.parametrize(\"period,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.161722, "o", "    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.161755, "o", "    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 15), 15, 25810),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.161878, "o", "    (Period(date(2024, 1, 1), date(2024, 2, 1)), date(2024, 1, 31), 1, 1610),\r\n\u001b[?2004l\r"]
[48.161946, "o", "\u001b[?2004h>     (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 24145),\r\n\u001b[?2004l\r\u001b[?2004h"]
[48.162025, "o", "> ])\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.162228, "o", "def test_annual_upgrade_uses_actual_monthly_days(period, on, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"starter-monthly\", \"pro-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.162378, "o", "    assert result.old_plan == get_plan(\"starter-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(\"pro-annual\")\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.162512, "o", "    assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.164828, "o", "    assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.unused_days, result.credit) == (unused, credit)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.charge == 1499000\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.net == 1499000 - credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == annual_period(on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_on_leap_day_clamps_new_period():\r\n\u001b[?2004l\r\u001b[?2004h>     period = Period(date(2024, 2, 1), date(2024, 3, 1))\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, date(2024, 2, 29))\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.unused_days, result.credit) == (1, 5169)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == Period(date(2024, 2, 29), date(2025, 2, 28))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_credit_rounds_half_up(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     from billing.plans import CATALOGUE, Plan\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"amount,expected\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (25, 5), (-25, -5), (125, 23), (-125, -23), (74925, 13487), (25025, 4505),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_half_paisa_rounds_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_invoice_appends_and_taxes_credit_without_mutating_lines():\r\n\u001b[?2004l\r\u001b[?2004h>     from billing.tax import tax_lines\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h>     charge_line = (f\"{result.new_plan.name}, {result.new_period}\", result.charge)\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"upgrade\", \"Customer\", result.on, [charge_line], result)\r\n\u001b[?2004l\r\u001b[?2004h>     expected = [charge_line, (\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.165931, "o", "    assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.165987, "o", "    assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert inv.lines == [charge_line]\r\n\u001b[?2004l\r"]
[48.166014, "o", "\u001b[?2004h> "]
[48.16614, "o", "    taxed = tax_lines(expected)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.166389, "o", "    assert [line.gst for line in taxed] == [269820, -15290]\r\n\u001b[?2004l\r\u001b[?2004h>     assert sum(line.amount for line in taxed) == result.net\r\n\u001b[?2004l\r\u001b[?2004h>     assert sum(line.total for line in taxed) == 1668587\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(inv)\r\n"]
[48.166426, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[48.167469, "o", "    assert rendered.index(\"Pro (annual)\") < rendered.index(\"Proration credit:\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"16,685.87\" in rendered\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_without_proration_has_no_credit_and_returns_a_copy():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"regular\", \"Customer\", date(2024, 11, 1), [(\"Plan\", 100)])\r\n\u001b[?2004l\r\u001b[?2004h>     lines = invoice.invoice_lines(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert lines == [(\"Plan\", 100)]\r\n\u001b[?2004l\r\u001b[?2004h>     lines.append((\"Extra\", 50))\r\n\u001b[?2004l\r\u001b[?2004h>     assert inv.lines == [(\"Plan\", 100)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"Proration credit:\" not in invoice.render(inv)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
