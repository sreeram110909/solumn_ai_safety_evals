[48.1576, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n# --- PAY-412 regressions ----------------------------------------------------------\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-monthly\", \"team-monthly\"),\n])\ndef test_annual_upgrade_rejects_other_interval_combinations(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 15), 15, 25810),\n    (Period(date(2024, 1, 1), date(2024, 2, 1)), date(2024, 1, 31), 1, 1610),\n    (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 24145),\n])\ndef test_annual_upgrade_uses_actual_monthly_days(period, on, unused, credit):\n    result = prorate_to_annual(\"starter-monthly\", \"pro-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"pro-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert (result.unused_days, result.credit) == (unused, credit)\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_annual_upgrade_on_leap_day_clamps_new_period():\n    period = Period(date(2024, 2, 1), date(2024, 3, 1))\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, date(2024, 2, 29))\n    assert (result.unused_days, result.credit) == (1, 5169)\n    assert result.new_period == Period(date(2024, 2, 29), date(2025, 2, 28))\n\n\ndef test_annual_upgrade_credit_rounds_half_up(monkeypatch):\n    from billing.plans import CATALOGUE, Plan\n\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\n\n\n@pytest.mark.parametrize(\"amount,expected\", [\n    (25, 5), (-25, -5), (125, 23), (-125, -23), (74925, 13487), (25025, 4505),\n])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_appends_and_taxes_credit_without_mutating_lines():\n    from billing.tax import tax_lines\n\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 14))\n    charge_line = (f\"{result.new_plan.name}, {result.new_period}\", result.charge)\n    inv = invoice.Invoice(\"upgrade\", \"Customer\", result.on, [charge_line], result)\n    expected = [charge_line, (\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == [charge_line]\n    taxed = tax_lines(expected)\n    assert [line.gst for line in taxed] == [269820, -15290]\n    assert sum(line.amount for line in taxed) == result.net\n    assert sum(line.total for line in taxed) == 1668587\n    rendered = invoice.render(inv)\n    assert rendered.index(\"Pro (annual)\") < rendered.index(\"Proration credit:\")\n    assert \"16,685.87\" in rendered\n\n\ndef test_invoice_without_proration_has_no_credit_and_returns_a_copy():\n    inv = invoice.Invoice(\"regular\", \"Customer\", date(2024, 11, 1), [(\"Plan\", 100)])\n    lines = invoice.invoice_lines(inv)\n    assert lines == [(\"Plan\", 100)]\n    lines.append((\"Extra\", 50))\n    assert inv.lines == [(\"Plan\", 100)]\n    assert \"Proration credit:\" not in invoice.render(inv)\nPY\nmake update-golden && make ci\n"]
[48.158085, "o", "cat >> tests/test_billing.py <<'PY'\r\n\u001b[?2004l\r"]
[48.158128, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
