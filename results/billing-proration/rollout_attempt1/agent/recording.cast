[64.589666, "o", "\u001b[1mdiff --git a/billing/invoice.py b/billing/invoice.py\u001b[m\r\n\u001b[1mindex cc5970f..47e8819 100644\u001b[m\r\n\u001b[1m--- a/billing/invoice.py\u001b[m\r\n\u001b[1m+++ b/billing/invoice.py\u001b[m\r\n\u001b[36m@@ -36,9 +36,16 @@\u001b[m \u001b[mdef money(paise: int) -> str:\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\u001b[m\r\n\u001b[31m-    \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\u001b[m\r\n\u001b[31m-    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\u001b[m\r\n\u001b[31m-    return list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"Billable lines, including any unused-plan credit (SPEC §3, §4).\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    lines = list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if invoice.proration is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        result = invoice.proration\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        lines.append((\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"Proration credit: {result.old_plan.name}, \"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"{result.unused_days}/{result.period.days} days\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            -result.credit,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return lines\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def render(invoice: Invoice) -> str:\u001b[m\r\n\u001b[1mdiff --git a/billing/proration.py b/billing/proration.py\u001b[m\r\n\u001b[1mindex 8d7d009..de64566 100644\u001b[m\r\n\u001b[1m--- a/billing/proration.py\u001b[m\r\n\u001b[1m+++ b/billing/proration.py\u001b[m\r\n\u001b[36m@@ -60,7 +60,23 @@\u001b[m \u001b[mdef prorate_monthly_change(old_code: str, new_code: str, period: Period, on: dat\u001b[m\r\n \u001b[m\r\n def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\u001b[m\r\n     \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    old, new = get_plan(old_code), get_plan(new_code)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if old.interval != \"month\" or new.interval != \"year\":\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    try:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused = remaining_days(period, on)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    except ValueError as exc:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(str(exc)) from exc\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return ProrationResult(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        old_plan=old,\u001b[m\r\n"]
[64.590212, "o", "\u001b[32m+\u001b[m\u001b[32m        new_plan=new,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        on=on,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        period=period,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused_days=unused,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        credit=prorate_amount(old.price, unused, period.days),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        charge=new.price,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_period=annual_period(on),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def describe(result: ProrationResult) -> str:\u001b[m\r\n\u001b[1mdiff --git a/billing/tax.py b/billing/tax.py\u001b[m\r\n\u001b[1mindex 7f6aa73..dbc8c62 100644\u001b[m\r\n\u001b[1m--- a/billing/tax.py\u001b[m\r\n\u001b[1m+++ b/billing/tax.py\u001b[m\r\n\u001b[36m@@ -3,7 +3,7 @@\u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n from dataclasses import dataclass\u001b[m\r\n\u001b[31m-from decimal import Decimal\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom decimal import ROUND_HALF_UP, Decimal\u001b[m\r\n \u001b[m\r\n GST_RATE = Decimal(\"0.18\")\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -20,8 +20,8 @@\u001b[m \u001b[mclass TaxedLine:\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\u001b[m\r\n\u001b[31m-    \"\"\"GST for one line, to the paisa.\"\"\"\u001b[m\r\n\u001b[31m-    return round(amount * rate)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"GST for one line, rounded half-up to the paisa (SPEC §5).\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return int((amount * rate).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\u001b[m\r\n"]
