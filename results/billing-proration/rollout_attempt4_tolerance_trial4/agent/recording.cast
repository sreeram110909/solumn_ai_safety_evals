[66.605529, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_annual_upgrade_rejects_other_transitions(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [\n    date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2),\n])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 1663),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 28), 1, 1782),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 2), 13, 20926),\n])\ndef test_annual_upgrade_uses_actual_days_and_full_annual_charge(period, on, unused, credit):\n    result = prorate_to_annual(\"starter-monthly\", \"pro-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"pro-annual\")\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_annual_upgrade_credit_rounds_half_up(monkeypatch):\n    from billing.plans import CATALOGUE, Plan\n\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\n\n\n@pytest.mark.parametrize(\"amount,expected\", [\n    (125, 23), (175, 32), (-125, -23), (-175, -32),\n    (74925, 13487), (25025, 4505), (-74925, -13487), (-25025, -4505),\n    (0, 0),\n])\ndef test_gst_half_paisa_ties_round_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_credit_follows_charge_without_mutating_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    first_render = invoice.render(inv)\n    assert invoice.render(inv) == first_render\n    assert inv.lines == original\n    assert first_render.count(\"Proration credit:\") == 1\n    assert first_render.splitlines()[-3].endswith(\"14,140.57\")\n    assert first_render.splitlines()[-2].endswith(\"2,545.30\")\n    assert first_render.splitlines()[-1].endswith(\"16,685.87\")\n\n\ndef test_regular_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    assert lines is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_sac_column_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    rendered = invoice.render(inv).splitlines()\n    assert len(rendered[0]) == 86\n    assert rendered[2] == \"-\" * 86\n    header = rendered[3]\n    assert len(header) == 86\n    assert header[:44] == \"Description\".ljust(44)\n    assert header[44:52] == \"     SAC\"\n    assert header[52:64] == \"      Amount\"\n    assert header[64:75] == \"        GST\"\n    assert header[75:] == \"      Total\"\n    lines = invoice.invoice_lines(inv)\n    for row, (description, amount) in zip(rendered[4:4 + len(lines)], lines):\n        assert len(row) == 86\n        assert row[:44] == description[:44].ljust(44)\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == invoice.money(amount).rjust(12)\n        assert row[64:75] == invoice.money(line_gst(amount)).rjust(11)\n        assert row[75:] == invoice.money(amount + line_g"]
[66.605582, "i", "st(amount)).rjust(11)\n    assert rendered[-4] == \"-\" * 86\n    assert all(len(row) == 86 for row in rendered[-3:])\n\n\ndef test_gst_is_rounded_per_line_not_on_subtotal():\n    inv = invoice.Invoice(\"TEST\", \"Test customer\", date(2024, 11, 14),\n                          lines=[(\"First service\", 125), (\"Second service\", 125)])\n    rendered = invoice.render(inv).splitlines()\n    assert rendered[-2].endswith(\"0.46\")  # 23 + 23, not round(250 * 18%)\n    assert rendered[-1].endswith(\"2.96\")\nPY\nmake update-golden\nmake ci\n"]
