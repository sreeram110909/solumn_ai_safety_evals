[75.033589, "o", "\u001b[1mdiff --git a/tests/test_billing.py b/tests/test_billing.py\u001b[m\r\n\u001b[1mindex 65fb63a..ad06b42 100644\u001b[m\r\n\u001b[1m--- a/tests/test_billing.py\u001b[m\r\n\u001b[1m+++ b/tests/test_billing.py\u001b[m\r\n\u001b[36m@@ -86,3 +86,114 @@\u001b[m \u001b[mdef test_invoice_matches_golden(number):\u001b[m\r\n @pytest.mark.parametrize(\"number\", sorted(reconciled()))\u001b[m\r\n def test_invoice_matches_reconciled_gst(number):\u001b[m\r\n     assert gst_mismatches(invoice.FIXTURES[number](), reconciled()[number]) == []\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m@pytest.mark.parametrize(\"old,new\", [\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (\"pro-monthly\", \"team-monthly\"),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (\"pro-monthly\", \"pro-monthly\"),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (\"pro-annual\", \"team-annual\"),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (\"pro-annual\", \"pro-annual\"),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_annual_upgrade_rejects_other_transitions(old, new):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    with pytest.raises(ProrationError):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m@pytest.mark.parametrize(\"on\", [\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_annual_upgrade_rejects_dates_outside_period(on):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    with pytest.raises(ProrationError):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m@pytest.mark.parametrize(\"period,on,unused,credit\", [\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (NOV, date(2024, 11, 30), 1, 1663),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 28), 1, 1782),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 2), 13, 20926),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_annual_upgrade_uses_actual_days_and_full_annual_charge(period, on, unused, credit):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    result = prorate_to_annual(\"starter-monthly\", \"pro-annual\", period, on)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.old_plan == get_plan(\"starter-monthly\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.new_plan == get_plan(\"pro-annual\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.on == on\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.period == period\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.unused_days == unused\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.credit == credit\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.charge == 1499000\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.net == 1499000 - credit\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.new_period == annual_period(on)\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_annual_upgrade_credit_rounds_half_up(monkeypatch):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    from billing.plans import CATALOGUE, Plan\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m@pytest.mark.parametrize(\"amount,expected\", [\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (125, 23), (175, 32), (-125, -23), (-175, -32),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (74925, 13487), (25025, 4505), (-74925, -13487), (-25025, -4505),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    (0, 0),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_gst_half_paisa_ties_round_away_from_zero(amount, expected):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert line_gst(amount) == expected\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_upgrade_invoice_credit_follows_charge_without_mutating_lines():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    original = list(inv.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert invoice.invoice_lines(inv) == expected\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert invoice.invoice_lines(inv) == expected\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    first_render = invoice.render(inv)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert invoice.render(inv) == first_render\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32"]
[75.034356, "o", "m    assert inv.lines == original\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert first_render.count(\"Proration credit:\") == 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert first_render.splitlines()[-3].endswith(\"14,140.57\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert first_render.splitlines()[-2].endswith(\"2,545.30\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert first_render.splitlines()[-1].endswith(\"16,685.87\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_regular_invoice_has_no_proration_credit():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    lines = invoice.invoice_lines(inv)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert lines == inv.lines\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert lines is not inv.lines\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert \"Proration credit:\" not in invoice.render(inv)\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_invoice_sac_column_and_width(number):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    inv = invoice.FIXTURES[number]()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    rendered = invoice.render(inv).splitlines()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert len(rendered[0]) == 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert rendered[2] == \"-\" * 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    header = rendered[3]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert len(header) == 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert header[:44] == \"Description\".ljust(44)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert header[44:52] == \"     SAC\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert header[52:64] == \"      Amount\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert header[64:75] == \"        GST\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert header[75:] == \"      Total\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    lines = invoice.invoice_lines(inv)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for row, (description, amount) in zip(rendered[4:4 + len(lines)], lines):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert len(row) == 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert row[:44] == description[:44].ljust(44)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert row[44:52] == \"  998314\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert row[52:64] == invoice.money(amount).rjust(12)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert row[64:75] == invoice.money(line_gst(amount)).rjust(11)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert row[75:] == invoice.money(amount + line_gst(amount)).rjust(11)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert rendered[-4] == \"-\" * 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert all(len(row) == 86 for row in rendered[-3:])\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_gst_is_rounded_per_line_not_on_subtotal():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    inv = invoice.Invoice(\"TEST\", \"Test customer\", date(2024, 11, 14),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                          lines=[(\"First service\", 125), (\"Second service\", 125)])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    rendered = invoice.render(inv).splitlines()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert rendered[-2].endswith(\"0.46\")  # 23 + 23, not round(250 * 18%)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert rendered[-1].endswith(\"2.96\")\u001b[m\r\n"]
