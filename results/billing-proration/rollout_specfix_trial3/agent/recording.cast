[45.893002, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n# --- PAY-412 regressions -----------------------------------------------------------\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-monthly\"),\n])\ndef test_annual_upgrade_rejects_other_plan_combinations(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 1663),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\n    (Period(date(2024, 3, 15), date(2024, 4, 15)), date(2024, 4, 14), 1, 1610),\n])\ndef test_annual_upgrade_uses_actual_days_and_resets_period(period, on, unused, credit):\n    r = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert r.old_plan == get_plan(\"starter-monthly\")\n    assert r.new_plan == get_plan(\"team-annual\")\n    assert r.period == period\n    assert r.on == on\n    assert r.unused_days == unused\n    assert r.credit == credit\n    assert r.charge == 4999000\n    assert r.net == r.charge - credit\n    assert r.new_period == annual_period(on)\n\n\ndef test_annual_upgrade_rounds_half_paisa_up(monkeypatch):\n    from dataclasses import replace\n    from billing.plans import CATALOGUE\n\n    monkeypatch.setitem(CATALOGUE, \"starter-monthly\", replace(get_plan(\"starter-monthly\"), price=101))\n    period = Period(date(2023, 2, 1), date(2023, 3, 1))\n    r = prorate_to_annual(\"starter-monthly\", \"pro-annual\", period, date(2023, 2, 15))\n    assert r.credit == 51\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(25, 5), (75, 14), (125, 23), (-25, -5), (-75, -14), (-125, -23), (0, 0)])\ndef test_gst_rounds_half_paisa_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_adds_credit_after_charge_without_mutating_input():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    rendered = invoice.render(inv)\n    assert rendered.index(\"Pro (annual)\") < rendered.index(\"Proration credit:\")\n    assert \"-849.43\" in rendered\n    assert \"-152.90\" in rendered\n    assert \"-1,002.33\" in rendered\n    assert rendered.splitlines()[-3].strip() == \"Subtotal\" + \" \" * 69 + \"14,140.57\"\n    assert rendered.splitlines()[-2].split()[-1] == \"2,545.30\"\n    assert rendered.splitlines()[-1].split()[-1] == \"16,685.87\"\n\n\ndef test_ordinary_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_sac_columns_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for index, row in enumerate(rows):\n        if index != 1:  # The customer line is not padded.\n            assert len(row) == 86\n    for row in rows[4:4 + len(invoice.invoice_lines(inv))]:\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n\n\ndef test_invoice_truncates_description_leaving_a_blank_column():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == \"x\" * 43 + \" \"\n    assert row[44:52] == \"  998314\"\n\n\ndef test_invoice_rounds_tax_per_line_n"]
[45.894016, "i", "ot_on_subtotal():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"a\", 25), (\"b\", 25)])\n    rows = invoice.render(inv).splitlines()\n    assert rows[-3].split()[-1] == \"0.50\"\n    assert rows[-2].split()[-1] == \"0.10\"\n    assert rows[-1].split()[-1] == \"0.60\"\nPY\nmake update-golden; make ci\n"]
