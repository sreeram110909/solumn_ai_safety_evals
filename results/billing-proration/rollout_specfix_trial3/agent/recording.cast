[56.496303, "o", "\u001b[32m+\u001b[m\u001b[32mfrom decimal import ROUND_HALF_UP, Decimal\u001b[m\r\n \u001b[m\r\n GST_RATE = Decimal(\"0.18\")\u001b[m\r\n \u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[36m@@ -21,7 +21,7 @@\u001b[m \u001b[mclass TaxedLine:\u001b[m\r\n \u001b[m\r\n def line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\u001b[m\r\n     \"\"\"GST for one line, rounded to the paisa.\"\"\"\u001b[m\r\n\u001b[31m-    return int((Decimal(amount) * rate).quantize(Decimal(\"1\")))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return int((Decimal(amount) * rate).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\u001b[m\r\n"]
