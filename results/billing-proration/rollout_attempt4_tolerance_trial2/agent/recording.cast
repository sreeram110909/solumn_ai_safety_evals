[67.066184, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_annual_upgrade_rejects_other_plan_combinations(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 74950),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 15), 15, 77534),\n    (Period(date(2024, 1, 31), date(2024, 2, 29)), date(2024, 2, 15), 14, 72366),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 5169),\n    (NOV, date(2024, 11, 30), 1, 4997),\n    (Period(date(2024, 3, 1), date(2024, 4, 1)), date(2024, 3, 31), 1, 4835),\n])\ndef test_annual_upgrade_uses_actual_calendar_days(period, on, unused, credit):\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"pro-annual\")\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_annual_upgrade_can_change_tier():\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", NOV, NOV.start)\n    assert (result.credit, result.charge, result.net) == (49900, 4999000, 4949100)\n\n\n@pytest.mark.parametrize(\"amount,expected\", [\n    (125, 23), (175, 32), (74925, 13487), (25025, 4505),\n    (-125, -23), (-175, -32), (-74925, -13487), (-25025, -4505), (0, 0),\n])\ndef test_gst_rounds_half_up_including_credits(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_has_credit_after_charge_without_mutation():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original_lines = list(inv.lines)\n    expected = original_lines + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    first_render = invoice.render(inv)\n    assert invoice.render(inv) == first_render\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original_lines\n    rows = first_render.splitlines()\n    assert rows[4][52:64].strip() == \"14,990.00\"\n    assert rows[5][52:64].strip() == \"-849.43\"\n    assert rows[5][64:75].strip() == \"-152.90\"\n    assert rows[5][75:86].strip() == \"-1,002.33\"\n    assert rows[-3][52:].strip() == \"14,140.57\"\n    assert rows[-2][52:].strip() == \"2,545.30\"\n    assert rows[-1][52:].strip() == \"16,685.87\"\n\n\ndef test_regular_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_every_invoice_line_has_sac_in_86_column_layout(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert all(len(row) == 86 for i, row in enumerate(rows) if i != 1)\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, _) in zip(rows[4:], invoice.invoice_lines(inv)):\n        assert row[:44] == f\"{description[:44]:<44}\"\n        assert row[44:52] == \"  998314\"\n    assert rows[2] == rows[-4] == \"-\" * 86\n\n\ndef test_long_invoice_description_does_not_shift_sac_column():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 100, 125)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == \"x\" * 44\n    assert row[44"]
[67.066299, "i", ":52] == \"  998314\"\n    assert len(row) == 86\nPY\nmake update-golden && make ci\n"]
