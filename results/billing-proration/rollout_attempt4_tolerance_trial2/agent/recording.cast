[16.840395, "o", "    def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\r\n        \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\r\n>       raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\r\n\u001b[1m\u001b[31mE       NotImplementedError: annual-plan proration is not implemented yet (PAY-412, SPEC §3)\u001b[0m\r\n\r\n\u001b[1m\u001b[31mbilling/proration.py\u001b[0m:63: NotImplementedError\r\n\u001b[31m\u001b[1m__________________________________________________________ test_invoice_matches_golden[INV-2024-0042] __________________________________________________________\u001b[0m\r\n\r\nnumber = 'INV-2024-0042'\r\n\r\n    @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\n    def test_invoice_matches_golden(number):\r\n        path = GOLDEN / f\"{number}.txt\"\r\n        if not path.exists():\r\n            pytest.fail(\"golden fixture missing: run 'make update-golden'\")\r\n>       assert invoice.render(invoice.FIXTURES[number]()) == path.read_text()\r\n\u001b[1m\u001b[31mE       AssertionError: assert 'INVOICE INV-...   4,127.04\\n' == 'INVOICE INV-...   4,127.06\\n'\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE         Skipping 442 identical leading characters in diff, use -v to show\u001b[0m\r\n\u001b[1m\u001b[31mE         -      134.87     884.12\u001b[0m\r\n\u001b[1m\u001b[31mE         ?           ^          ^\u001b[0m\r\n\u001b[1m\u001b[31mE         +      134.86     884.11\u001b[0m\r\n\u001b[1m\u001b[31mE         ?           ^          ^\u001b[0m\r\n\u001b[1m\u001b[31mE         - API overage, 1,001 calls                            250.25      45.05     295.30...\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE         ...Full output truncated (14 lines hidden), use '-vv' to show\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_billing.py\u001b[0m:83: AssertionError\r\n\u001b[31m\u001b[1m__________________________________________________________ test_invoice_matches_golden[INV-2024-0107] __________________________________________________________\u001b[0m\r\n\r\nnumber = 'INV-2024-0107'\r\n\r\n    @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\n    def test_invoice_matches_golden(number):\r\n        path = GOLDEN / f\"{number}.txt\"\r\n        if not path.exists():\r\n>           pytest.fail(\"golden fixture missing: run 'make update-golden'\")\r\n\u001b[1m\u001b[31mE           Failed: golden fixture missing: run 'make update-golden'\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_billing.py\u001b[0m:82: Failed\r\n\u001b[31m\u001b[1m______________________________________________________ test_invoice_matches_reconciled_gst[INV-2024-0042] ______________________________________________________\u001b[0m\r\n\r\nnumber = 'INV-2024-0042'\r\n\r\n    @pytest.mark.parametrize(\"number\", sorted(reconciled()))\r\n    def test_invoice_matches_reconciled_gst(number):\r\n>       assert gst_mismatches(invoice.FIXTURES[number](), reconciled()[number]) == []\r\n\u001b[1m\u001b[31mE       AssertionError: assert ['line of 749...nciled 4505p'] == []\u001b[0m\r\n\u001b[1m\u001b[31mE         \u001b[0m\r\n\u001b[1m\u001b[31mE         Left contains 2 more items, first extra item: 'line of 74925p: GST 13486p, reconciled 13487p'\u001b[0m\r\n\u001b[1m\u001b[31mE         Use -v to get more diff\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_billing.py\u001b[0m:88: AssertionError\r\n"]
