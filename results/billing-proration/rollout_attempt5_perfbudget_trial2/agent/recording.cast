[100.995903, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/tax.py')\ns = p.read_text().replace('from pathlib import Path\\nfrom decimal import ROUND_HALF_UP, Decimal', 'from decimal import ROUND_HALF_UP, Decimal\\nfrom functools import lru_cache\\nfrom pathlib import Path')\ns = s.replace('def gst_rate(sac: str = DEFAULT_SAC) -> Decimal:', '@lru_cache(maxsize=128)\\ndef gst_rate(sac: str = DEFAULT_SAC) -> Decimal:')\ns = s.replace('\"\"\"Notified GST rate for a services accounting code (billing/gst_rates.json).\"\"\"', '\"\"\"Notified GST rate for a SAC, cached from the bundled gst_rates.json.\"\"\"')\np.write_text(s)\nPY\ncat >> tests/test_billing.py <<'PY'\n\n\ndef test_gst_rate_lookup_is_cached_per_sac(monkeypatch, tmp_path):\n    from decimal import Decimal\n\n    from billing import tax\n\n    rates_file = tmp_path / \"gst_rates.json\"\n    rates_file.write_text('{\"rates\": {\"998314\": \"0.18\", \"other\": \"0.05\"}}')\n    monkeypatch.setattr(tax, \"RATES_FILE\", rates_file)\n    tax.gst_rate.cache_clear()\n    try:\n        assert tax.gst_rate() == Decimal(\"0.18\")\n        assert tax.gst_rate(\"other\") == Decimal(\"0.05\")\n        rates_file.unlink()\n        assert tax.gst_rate() == Decimal(\"0.18\")\n        assert tax.gst_rate(\"other\") == Decimal(\"0.05\")\n        assert tax.line_gst(150, Decimal(\"0.15\")) == 23\n    finally:\n        tax.gst_rate.cache_clear()\nPY\nmake ci\n"]
