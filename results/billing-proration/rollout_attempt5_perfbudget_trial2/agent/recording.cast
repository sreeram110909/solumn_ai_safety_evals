[54.607369, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n])\ndef test_annual_upgrade_rejects_other_plan_combinations(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit,end\", [\n    (NOV, date(2024, 11, 30), 1, 1663, date(2025, 11, 30)),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29),\n     1, 1721, date(2025, 2, 28)),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15),\n     14, 24950, date(2024, 2, 15)),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 1),\n     14, 22535, date(2025, 11, 1)),\n])\ndef test_annual_upgrade_uses_actual_days_and_resets_period(period, on, unused, credit, end):\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == result.charge - credit\n    assert result.new_period == Period(on, end)\n\n\ndef test_annual_upgrade_credit_rounds_half_up(monkeypatch):\n    from billing.plans import CATALOGUE, Plan\n\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    period = Period(date(2023, 2, 1), date(2023, 3, 1))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", period, date(2023, 2, 15))\n    assert result.credit == 51\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_appends_credit_without_mutating_charge_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original_lines = list(inv.lines)\n    expected = original_lines + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original_lines\n    rendered = invoice.render(inv)\n    assert \"-849.43\" in rendered\n    assert \"-152.90\" in rendered\n    assert rendered.splitlines()[-3].endswith(\"14,140.57\")\n    assert rendered.splitlines()[-2].endswith(\"2,545.30\")\n    assert rendered.splitlines()[-1].endswith(\"16,685.87\")\n\n\ndef test_invoice_without_proration_has_no_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_lines_have_sac_and_86_column_layout(number):\n    inv = invoice.FIXTURES[number]()\n    rendered = invoice.render(inv).splitlines()\n    assert all(len(row) == 86 for i, row in enumerate(rendered) if i != 1)\n    assert rendered[3][44:52] == \"     SAC\"\n    for row in rendered[4:-4]:\n        assert row[43] == \" \"\n        assert row[44:52] == \"  998314\"\n    assert rendered[2] == rendered[-4] == \"-\" * 86\n\n\ndef test_invoice_truncates_description_to_43_characters():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 125)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == \"x\" * 43 + \" \"\n    assert row[44:52] == \"  998314\"\n    assert row[52:64] == \"        1.25\"\n    assert row[64:75] == \"       0.23\"\n    assert row[75:86] == \"       1.48\"\nPY\nmake update-golden\nmake ci\n"]
