[31.948242, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('billing/proration.py')\ns = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.interval != \"month\" or not new.is_annual:\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual target\")\n    if not period.contains(on):\n        raise ProrationError(f\"{on} is outside {period}\")\n    unused = remaining_days(period, on)\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''')\np.write_text(s)\np = Path('billing/invoice.py')\ns = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ns = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\n    return list(invoice.lines)''', '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        result = invoice.proration\n        lines.append((\n            f\"Proration credit: {result.old_plan.name}, \"\n            f\"{result.unused_days}/{result.period.days} days\",\n            -result.credit,\n        ))\n    return lines''')\ns = s.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\", \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\ns = s.replace('{line.description[:45]:<46}', '{line.description[:44]:<44}{SAC:>8}')\nfor label in ('Subtotal', 'GST @ 18%', 'Total due (INR)'):\n    s = s.replace(\"{'\" + label + \"':<46}\", \"{'\" + label + \"':<52}\")\np.write_text(s)\np = Path('billing/tax.py')\ns = p.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\ns = s.replace('\"\"\"GST for one line, rounded to the paisa.\"\"\"', '\"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"')\ns = s.replace('.quantize(Decimal(\"1\"))', '.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\np.write_text(s)\nPY\n"]
[31.948717, "o", "python - <<'PY'"]
[31.951392, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/proration.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")', '''    old, new = get_plan(old_code), get_plan(new_code)\r\n\u001b[?2004l\r\u001b[?2004h>     if old.interval != \"month\" or not new.is_annual:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(\"annual upgrades require a monthly plan and an annual target\")\r\n\u001b[?2004l\r\u001b[?2004h>     if not period.contains(on):\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(f\"{on} is outside {period}\")\r\n\u001b[?2004l\r\u001b[?2004h>     unused = remaining_days(period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     return ProrationResult(\r\n\u001b[?2004l\r\u001b[?2004h>         old_plan=old,\r\n\u001b[?2004l\r\u001b[?2004h>         new_plan=new,\r\n\u001b[?2004l\r\u001b[?2004h>         on=on,\r\n\u001b[?2004l\r\u001b[?2004h>         period=period,\r\n\u001b[?2004l\r\u001b[?2004h>         unused_days=unused,\r\n\u001b[?2004l\r\u001b[?2004h>         credit=prorate_amount(old.price, unused, period.days),\r\n\u001b[?2004l\r\u001b[?2004h>         charge=new.price,\r\n\u001b[?2004l\r\u001b[?2004h>         new_period=annual_period(on),\r\n\u001b[?2004l\r\u001b[?2004h>     )''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('billing/invoice.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\r\n\u001b[?2004l\r\u001b[?2004h>     return list(invoice.lines)''', '''    lines = list(invoice.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     if invoice.proration is not None:\r\n\u001b[?2004l\r\u001b[?2004h>         result = invoice.pr