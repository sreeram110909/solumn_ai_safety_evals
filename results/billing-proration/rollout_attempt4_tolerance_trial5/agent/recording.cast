[55.701605, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"Annual upgrades, credit taxation, and the SAC invoice layout (SPEC §3/§5).\"\"\"\n\nfrom datetime import date\nfrom decimal import ROUND_DOWN, localcontext\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, Plan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst, tax_lines\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_upgrade_rejects_non_monthly_to_annual(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit\", [\n    (NOV, date(2024, 11, 30), 1, 1663),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 1), 14, 22535),\n])\ndef test_upgrade_uses_actual_days_and_resets_annual_period(period, on, unused, credit):\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == result.charge - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_rounds_half_paisa_credit_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51\n\n\n@pytest.mark.parametrize(\"amount,expected\", [\n    (125, 23), (175, 32), (74925, 13487), (25025, 4505),\n    (-125, -23), (-175, -32), (-74925, -13487), (-25025, -4505),\n])\ndef test_gst_half_paisa_ties_round_away_from_zero(amount, expected):\n    with localcontext() as context:\n        context.rounding = ROUND_DOWN\n        assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_has_one_credit_after_annual_charge_without_mutation():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    invoice.render(inv)\n    assert inv.lines == original\n    taxed = tax_lines(invoice.invoice_lines(inv))\n    assert [line.gst for line in taxed] == [269820, -15290]\n    assert sum(line.amount for line in taxed) == 1414057\n    assert sum(line.total for line in taxed) == 1668587\n\n\ndef test_ordinary_invoice_has_no_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert inv.proration is None\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_rows_have_sac_and_86_character_layout(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    taxed = tax_lines(invoice.invoice_lines(inv))\n    for row, line in zip(rows[4:4 + len(taxed)], taxed):\n        assert len(row) == 86\n        assert row[:44] == f\"{line.description[:44]:<44}\"\n        assert row[44:52]"]
[55.701687, "i", " == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(line.amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line.gst):>11}\"\n        assert row[75:86] == f\"{invoice.money(line.total):>11}\"\n    assert rows[-4] == \"-\" * 86\n    assert all(len(row) == 86 for row in rows[-3:])\nPY\nmake update-golden\nmake ci\n"]
[55.705477, "o", "cat > tests/test_pay412.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"Annual upgrades, credit taxation, and the SAC invoice layout (SPEC §3/§5).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import ROUND_DOWN, localcontext\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, Plan, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst, tax_lines\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_non_monthly_to_annual(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_dates_outside_half_open_period(on):"]
