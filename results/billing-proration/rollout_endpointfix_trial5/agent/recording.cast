[81.096151, "o", "\r\n\u001b[1m+++ b/billing/proration.py\u001b[m\r\n\u001b[36m@@ -60,7 +60,22 @@\u001b[m \u001b[mdef prorate_monthly_change(old_code: str, new_code: str, period: Period, on: dat\u001b[m\r\n \u001b[m\r\n def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\u001b[m\r\n     \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    old, new = get_plan(old_code), get_plan(new_code)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if old.interval != \"month\" or new.interval != \"year\":\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if not period.contains(on):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(f\"{on} is outside {period}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    unused = remaining_days(period, on)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return ProrationResult(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        old_plan=old,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_plan=new,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        on=on,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        period=period,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused_days=unused,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        credit=prorate_amount(old.price, unused, period.days),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        charge=new.price,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_period=annual_period(on),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def describe(result: ProrationResult) -> str:\u001b[m\r\n\u001b[1mdiff --git a/billing/tax.py b/billing/tax.py\u001b[m\r\n\u001b[1mindex 2c32dbc..7eec704 100644\u001b[m\r\n\u001b[1m--- a/billing/tax.py\u001b[m\r\n\u001b[1m+++ b/billing/tax.py\u001b[m\r\n\u001b[36m@@ -3,7 +3,7 @@\u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n from dataclasses import dataclass\u001b[m\r\n\u001b[31m-from decimal import Decimal\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom decimal import ROUND_HALF_UP, Decimal\u001b[m\r\n \u001b[m\r\n GST_RATE = Decimal(\"0.18\")\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -20,8 +20,8 @@\u001b[m \u001b[mclass TaxedLine:\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\u001b[m\r\n\u001b[31m-    \"\"\"GST for one line, rounded to the paisa.\"\"\"\u001b[m\r\n\u001b[31m-    return int((Decimal(amount) * rate).quantize(Decimal(\"1\")))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return int((Decimal(amount) * rate).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\u001b[m\r\n"]
