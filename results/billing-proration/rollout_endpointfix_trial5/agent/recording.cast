[69.980036, "i", "cat > tests/test_annual_upgrade.py <<'PY'\n\"\"\"PAY-412: annual upgrades, credit invoices and SAC layout (SPEC §3).\"\"\"\n\nfrom dataclasses import replace\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, UnknownPlan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\n    \"period,on,unused,credit\",\n    [\n        (NOV, date(2024, 11, 1), 30, 49900),\n        (NOV, date(2024, 11, 30), 1, 1663),\n        (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\n        (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 15), 15, 25810),\n        (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\n        (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 24145),\n    ],\n)\ndef test_upgrade_uses_actual_month_days_and_resets_period(period, on, unused, credit):\n    result = prorate_to_annual(\"starter-monthly\", \"pro-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"pro-annual\")\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == 1499000 - credit\n    assert result.new_period == annual_period(on)\n\n\ndef test_upgrade_credit_rounds_half_up(monkeypatch):\n    plan = replace(get_plan(\"starter-monthly\"), price=101)\n    monkeypatch.setitem(CATALOGUE, plan.code, plan)\n    result = prorate_to_annual(plan.code, \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\n\n\n@pytest.mark.parametrize(\n    \"old,new\",\n    [\n        (\"pro-annual\", \"pro-monthly\"),\n        (\"pro-annual\", \"pro-annual\"),\n        (\"pro-annual\", \"team-annual\"),\n        (\"starter-monthly\", \"pro-monthly\"),\n        (\"pro-monthly\", \"pro-monthly\"),\n    ],\n)\ndef test_upgrade_rejects_other_interval_combinations(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"old,new\", [(\"unknown\", \"pro-annual\"), (\"pro-monthly\", \"unknown\")])\ndef test_upgrade_preserves_unknown_plan_error(old, new):\n    with pytest.raises(UnknownPlan):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_appends_credit_without_mutation():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.render(inv) == invoice.render(inv)\n    assert inv.lines == original\n    rows = invoice.render(inv).splitlines()\n    assert rows[4][52:64].strip() == \"14,990.00\"\n    assert rows[5][52:64].strip() == \"-849.43\"\n    assert rows[5][64:75].strip() == \"-152.90\"\n    assert rows[-3][52:].strip() == \"14,140.57\"\n    assert rows[-2][52:].strip() == \"2,545.30\"\n    assert rows[-1][52:].strip() == \"16,685.87\"\n\n\ndef test_regular_invoice_has_no_credit_line():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_rows_have_sac_and_widened_columns(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv)."]
[69.980625, "i", "splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n    assert rows[-4] == \"-\" * 86\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_long_invoice_description_leaves_a_blank_before_sac():\n    inv = invoice.Invoice(\"TEST\", \"Example\", date(2024, 11, 14), [(\"x\" * 80, 100)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:44] == \"x\" * 43 + \" \"\n    assert row[44:52] == \"  998314\"\n    assert len(row) == 86\nPY\nmake update-golden\nmake ci\n"]
[69.983409, "o", "cat > tests/test_annual_upgrade.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \"\"\"PAY-412: annual upgrades, credit invoices and SAC layout (SPEC §3).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h> from datetime import date\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> import pytest\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> from billing import invoice\r\n\u001b[?2004l\r\u001b[?2004h> from billing.periods import Period, annual_period\r\n\u001b[?2004l\r\u001b[?2004h> from billing.plans import CATALOGUE, UnknownPlan, get_plan\r\n\u001b[?2004l\r\u001b[?2004h> from billing.proration import ProrationError, prorate_to_annual\r\n\u001b[?2004l\r\u001b[?2004h> from billing.tax import line_gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> NOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\r\n\u001b[?2004l\r\u001b[?2004h>     \"period,on,unused,credit\",\r\n\u001b[?2004l\r\u001b[?2004h>     [\r\n\u001b[?2004l\r\u001b[?2004h>         (NOV, date(2024, 11, 1), 30, 49900),\r\n\u001b[?2004l\r\u001b[?2004h>         (NOV, date(2024, 11, 30), 1, 1663),\r\n\u001b[?2004l\r\u001b[?2004h>         (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15), 14, 24950),\r\n\u001b[?2004l\r\u001b[?2004h>         (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 15), 15, 25810),\r\n\u001b[?2004l\r\u001b[?2004h>         (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 1, 1721),\r\n\u001b[?2004l\r\u001b[?2004h>         (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31), 15, 24145),\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_month_days_and_resets_period(period, on, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"starter-monthly\", \"pro-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.984364, "o", "    assert result.old_plan == get_plan(\"starter-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(\"pro-annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.985544, "o", "    assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.unused_days == unused\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.charge == 1499000\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.net == 1499000 - credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == annual_period(on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_credit_rounds_half_up(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     plan = replace(get_plan(\"starter-monthly\"), price=101)\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setitem(CATALOGUE, plan.code, plan)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[69.985826, "o", "    result = prorate_to_annual(plan.code, \"pro-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise"]
[69.988089, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\r\n\u001b[?2004l\r\u001b[?2004h>     \"old,new\",\r\n\u001b[?2004l\r\u001b[?2004h>     [\r\n\u001b[?2004l\r\u001b[?2004h>         (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>         (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>         (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>         (\"starter-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>         (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     ],\r\n\u001b[?2004l\r\u001b[?2004h> )\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_other_interval_combinations(old, new):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old, new, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_rejects_dates_outside_half_open_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old,new\", [(\"unknown\", \"pro-annual\"), (\"pro-monthly\", \"unknown\")])"]
