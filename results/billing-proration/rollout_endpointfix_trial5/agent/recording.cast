[42.404806, "i", "python - <<'PY'\nfrom pathlib import Path\n\np = Path('billing/proration.py')\ns = p.read_text().replace(\n    '    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")',\n    '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.interval != \"month\" or new.interval != \"year\":\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\n    if not period.contains(on):\n        raise ProrationError(f\"{on} is outside {period}\")\n    unused = remaining_days(period, on)\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )'''\n)\np.write_text(s)\n\np = Path('billing/invoice.py')\ns = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ns = s.replace(\n    '    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\\n    return list(invoice.lines)',\n    '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        proration = invoice.proration\n        lines.append((\n            f\"Proration credit: {proration.old_plan.name}, \"\n            f\"{proration.unused_days}/{proration.period.days} days\",\n            -proration.credit,\n        ))\n    return lines'''\n)\ns = s.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\",\n              \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\ns = s.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"',\n              'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\ns = s.replace(\"{'Subtotal':<46}\", \"{'Subtotal':<52}\")\ns = s.replace(\"{'GST @ 18%':<46}\", \"{'GST @ 18%':<52}\")\ns = s.replace(\"{'Total due (INR)':<46}\", \"{'Total due (INR)':<52}\")\np.write_text(s)\n\np = Path('billing/tax.py')\ns = p.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\ns = s.replace('\"\"\"GST for one line, rounded to the paisa.\"\"\"',\n              '\"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"')\ns = s.replace('.quantize(Decimal(\"1\"))', '.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\np.write_text(s)\nPY\n"]
