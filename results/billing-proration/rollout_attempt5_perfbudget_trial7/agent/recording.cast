[100.929489, "o", "\u001b[?2004h>     assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.unused_days, result.credit, result.charge) == (unused, credit, 4999000)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.net == 4999000 - credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == Period(on, end)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_credit_rounds_half_up(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h>     from billing.plans import CATALOGUE\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=101))\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"amount,expected\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (125, 23), (175, 32), (-125, -23), (-175, -32), (0, 0),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_rounds_half_paise_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_invoice_adds_credit_without_mutating_charge_lines():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     original = list(inv.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert inv.lines == original\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     rows = rendered.splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[4][44:52] == rows[5][44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[5][52:64].strip() == \"-849.43\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[5][64:75].strip() == \"-152.90\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[5][75:86].strip() == \"-1,002.33\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered.endswith(\"1,668,587.26\\n\") is False\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-1][52:].strip() == invoice.money(1414057 + 269820 - 15290)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
