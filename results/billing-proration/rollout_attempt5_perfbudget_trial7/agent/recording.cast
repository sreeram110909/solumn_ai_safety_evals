[32.694996, "o", "\r\n    def test_render_5000_invoices_within_budget():\r\n        budget = BUDGETS[\"render_invoices\"][\"max_seconds\"]\r\n        inv = invoice.FIXTURES[\"INV-2024-0042\"]()\r\n        start = time.perf_counter()\r\n        for _ in range(5000):\r\n            invoice.render(inv)\r\n        elapsed = time.perf_counter() - start\r\n>       assert elapsed <= budget, f\"5,000 renders took {elapsed:.2f}s; budget {budget}s (tests/perf_budget.toml)\"\r\n\u001b[1m\u001b[31mE       AssertionError: 5,000 renders took 16.91s; budget 2.0s (tests/perf_budget.toml)\u001b[0m\r\n\u001b[1m\u001b[31mE       assert 16.910955192000074 <= 2.0\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_perf.py\u001b[0m:17: AssertionError\r\n"]
