[100.919525, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n# --- PAY-412 regression coverage --------------------------------------------------\n@pytest.mark.parametrize(\"old,new\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"team-annual\", \"starter-monthly\"),\n])\ndef test_annual_upgrade_rejects_other_transitions(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit,end\", [\n    (Period(date(2024, 1, 1), date(2024, 2, 1)), date(2024, 1, 31),\n     1, 1610, date(2025, 1, 31)),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29),\n     1, 1721, date(2025, 2, 28)),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15),\n     14, 24950, date(2024, 2, 15)),\n    (Period(date(2024, 4, 15), date(2024, 5, 15)), date(2024, 4, 30),\n     15, 24950, date(2025, 4, 30)),\n])\ndef test_annual_upgrade_uses_actual_days_and_reanchors(period, on, unused, credit, end):\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert (result.unused_days, result.credit, result.charge) == (unused, credit, 4999000)\n    assert result.net == 4999000 - credit\n    assert result.new_period == Period(on, end)\n\n\ndef test_annual_upgrade_credit_rounds_half_up(monkeypatch):\n    from dataclasses import replace\n    from billing.plans import CATALOGUE\n\n    monkeypatch.setitem(CATALOGUE, \"pro-monthly\", replace(get_plan(\"pro-monthly\"), price=101))\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51  # 101 * 15 / 30 = 50.5 paise\n\n\n@pytest.mark.parametrize(\"amount,expected\", [\n    (125, 23), (175, 32), (-125, -23), (-175, -32), (0, 0),\n])\ndef test_gst_rounds_half_paise_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_adds_credit_without_mutating_charge_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    rendered = invoice.render(inv)\n    rows = rendered.splitlines()\n    assert rows[4][44:52] == rows[5][44:52] == \"  998314\"\n    assert rows[5][52:64].strip() == \"-849.43\"\n    assert rows[5][64:75].strip() == \"-152.90\"\n    assert rows[5][75:86].strip() == \"-1,002.33\"\n    assert rendered.endswith(\"1,668,587.26\\n\") is False\n    assert rows[-1][52:].strip() == invoice.money(1414057 + 269820 - 15290)\n\n\ndef test_regular_invoice_has_no_credit_line():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    lines = invoice.invoice_lines(inv)\n    assert lines == inv.lines\n    assert lines is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"description\", [\"Short description\", \"x\" * 60])\ndef test_invoice_sac_column_widths_and_description_truncation(description):\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(description, 125)])\n    rows = invoice.render(inv).splitlines()\n    assert all(len(row) == 86 for row in rows if not row.startswith(\"Customer:\"))\n    assert rows[3][0:44] == f\"{'Description':<44}\"\n    assert rows[3][44:52] == \"     SAC\"\n    assert rows[4][0:44] == f\"{description[:43]:<44}\"\n    assert rows[4][43] == \" \"\n    assert rows[4][44:52] == \"  998314\"\n    assert rows[4][52:64] == f\"{'1.25':>12}\"\n    assert rows[4][64:75] == f\"{'0.23':>11}\"\n    assert rows[4][75:86] == f\"{'1.48':>11}\"\nPY\n"]
[100.923108, "o", "cat >> tests/test_billing.py <<'PY'"]
