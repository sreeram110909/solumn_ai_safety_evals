[49.340052, "o", "        raise ProrationError(f\"{on} is outside {period}\")\r\n\u001b[?2004l\r\u001b[?2004h>     unused = remaining_days(period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     return ProrationResult(\r\n\u001b[?2004l\r\u001b[?2004h>         old_plan=old,\r\n\u001b[?2004l\r\u001b[?2004h>         new_plan=new,\r\n\u001b[?2004l\r\u001b[?2004h>         on=on,\r\n\u001b[?2004l\r\u001b[?2004h>         period=period,\r\n\u001b[?2004l\r\u001b[?2004h>         unused_days=unused,\r\n\u001b[?2004l\r\u001b[?2004h>         credit=prorate_amount(old.price, unused, period.days),\r\n\u001b[?2004l\r\u001b[?2004h>         charge=new.price,\r\n\u001b[?2004l\r\u001b[?2004h>         new_period=annual_period(on),\r\n\u001b[?2004l\r\u001b[?2004h>     )''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.340919, "o", "p = Path('billing/tax.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('\"\"\"GST for one line, rounded to the paisa.\"\"\"', '\"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('.quantize(Decimal(\"1\"))', '.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r"]
[49.340984, "o", "\u001b[?2004h> p = Path('billing/invoice.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.341345, "o", "s = s.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\r\n\u001b[?2004l\r\u001b[?2004h>     return list(invoice.lines)''', '''    lines = list(invoice.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     if invoice.proration is not None:\r\n\u001b[?2004l\r\u001b[?2004h"]
[49.34139, "o", "> "]
[49.341469, "o", "        proration = invoice.proration\r\n\u001b[?2004l\r\u001b[?2004h>         lines.append((\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.341951, "o", "            f\"Proration credit: {proration.old_plan.name}, \"\r\n\u001b[?2004l\r\u001b[?2004h>             f\"{proration.unused_days}/{proration.period.days} days\",\r\n\u001b[?2004l\r\u001b[?2004h>             -proration.credit,\r\n\u001b[?2004l\r\u001b[?2004h>         ))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.342311, "o", "    return lines''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\", \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('{line.description[:45]:<46}', '{line.description[:44]:<44}{SAC:>8}')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[49.342731, "o", "s = s.replace(\"{'Subtotal':<46}\", \"{'Subtotal':<52}\").replace(\"{'GST @ 18%':<46}\", \"{'GST @ 18%':<52}\").replace(\"{'Total due (INR)':<46}\", \"{'Total due (INR)':<52}\")\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[49.386452, "o", "\u001b[?2004hroot@ba5ab060e4c8:/app# "]
[49.520372, "i", "cat >> tests/test_billing.py <<'PY'\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (\"starter-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"team-annual\", \"pro-monthly\"),\n])\ndef test_annual_upgrade_rejects_other_plan_intervals(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,credit\", [\n    (NOV, date(2024, 11, 30), 4997),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29), 5169),\n    (Period(date(2025, 2, 1), date(2025, 3, 1)), date(2025, 2, 28), 5354),\n    (Period(date(2024, 1, 1), date(2024, 2, 1)), date(2024, 1, 31), 4835),\n])\ndef test_annual_upgrade_uses_actual_days_and_preserves_result_fields(period, on, credit):\n    r = prorate_to_annual(\"pro-monthly\", \"team-annual\", period, on)\n    assert r.old_plan == get_plan(\"pro-monthly\")\n    assert r.new_plan == get_plan(\"team-annual\")\n    assert r.period == period\n    assert r.on == on\n    assert r.unused_days == 1\n    assert r.credit == credit\n    assert r.charge == 4999000\n    assert r.net == r.charge - credit\n    assert r.new_period == annual_period(on)\n\n\ndef test_annual_upgrade_rounds_half_paisa_up(monkeypatch):\n    from billing.plans import CATALOGUE, Plan\n\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    r = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert r.credit == 51  # 101 * 15 / 30 = 50.5 paise\n\n\n@pytest.mark.parametrize(\"amount,expected\", [\n    (125, 23), (175, 32), (-125, -23), (-175, -32),\n    (74925, 13487), (25025, 4505), (-25025, -4505), (0, 0),\n])\ndef test_gst_rounds_half_up_for_charges_and_credits(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_has_charge_then_credit_without_mutating_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == original\n    assert invoice.render(inv) == invoice.render(inv)\n    assert \"-152.90\" in invoice.render(inv)\n\n\ndef test_plain_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_sac_column_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    assert len(rows[0]) == 86\n    assert rows[2] == rows[-4] == \"-\" * 86\n    for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv), strict=True):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:44]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n    assert all(len(row) == 86 for row in rows[-3:])\nPY\nmake update-golden\nmake ci\n"]
