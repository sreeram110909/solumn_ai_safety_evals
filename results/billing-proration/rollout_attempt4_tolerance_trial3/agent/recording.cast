[47.625548, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[47.625624, "o", "\u001b[?2004h> "]
[47.625706, "o", "@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32), (0, 0)])\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.625827, "o", "> "]
[47.625876, "o", "def test_gst_half_paisa_rounds_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.626066, "o", "    with localcontext() as context:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.62611, "o", "        context.rounding = ROUND_DOWN\r\n\u001b[?2004l\r\u001b[?2004h>         assert line_gst(amount) == expected\r\n\u001b[?2004l\r"]
[47.626134, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[47.626375, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_proration_rounds_half_up():\r\n\u001b[?2004l\r\u001b[?2004h>     with localcontext() as context:\r\n\u001b[?2004l\r"]
[47.626581, "o", "\u001b[?2004h>         context.rounding = ROUND_DOWN\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.626668, "o", "        assert prorate_amount(125, 1, 2) == 63\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.626797, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.626909, "o", "def test_upgrade_invoice_appends_and_taxes_credit_without_mutating_lines():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.626972, "o", "    bill = FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.627222, "o", "> "]
[47.627278, "o", "    original = list(bill.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n\u001b[?2004l\r"]
[47.62731, "o", "\u001b[?2004h"]
[47.627374, "o", "> "]
[47.627459, "o", "    assert invoice_lines(bill) == expected\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.627664, "o", "> "]
[47.627707, "o", "    assert invoice_lines(bill) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert bill.lines == original\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.627863, "o", "    taxed = tax_lines(invoice_lines(bill))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.627978, "o", "    assert [line.gst for line in taxed] == [269820, -15290]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.628077, "o", "    assert sum(line.amount for line in taxed) == bill.proration.net\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.628179, "o", "    assert sum(line.total for line in taxed) == 1668587\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.628326, "o", "    assert money(1668587) in render(bill).splitlines()[-1]\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.628452, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.628487, "o", "def test_invoice_without_proration_has_no_credit():\r\n\u001b[?2004l\r"]
[47.628552, "o", "\u001b[?2004h> "]
[47.62869, "o", "    bill = FIXTURES[\"INV-2024-0042\"]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.62876, "o", "    assert invoice_lines(bill) == bill.lines\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.628826, "o", "> "]
[47.628913, "o", "    assert \"Proration credit:\" not in render(bill)\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.628982, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.629104, "o", "def test_zero_credit_is_still_shown_when_invoice_carries_proration():\r\n\u001b[?2004l\r"]
[47.629142, "o", "\u001b[?2004h> "]
[47.629253, "o", "    from dataclasses import replace\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.629327, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.629409, "o", "    bill = FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.629537, "o", "    bill.proration = replace(bill.proration, credit=0)\r\n"]
[47.629613, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[47.629827, "o", "    assert invoice_lines(bill)[-1] == (\"Proration credit: Pro (monthly), 17/30 days\", 0)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[47.629867, "o", "> "]
[47.630085, "o", "@pytest.mark.parametrize(\"number\", FIXTURES)\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.63012, "o", "> def test_all_invoice_rows_include_sac_with_exact_column_widths(number):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.630209, "o", "    bill = FIXTURES[number]()\r\n\u001b[?2004l\r"]
[47.630448, "o", "\u001b[?2004h>     rows = render(bill).splitlines()\r\n"]
[47.630621, "o", "\u001b[?2004l\r\u001b[?2004h>     assert len(rows[0]) == 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[2] == rows[-4] == \"-\" * 86\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.630729, "o", "    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.630835, "o", "    taxed = tax_lines(invoice_lines(bill))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.630904, "o", "    for row, line in zip(rows[4:-4], taxed, strict=True):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631036, "o", "        assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631179, "o", "        assert row[:44] == f\"{line.description[:44]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631306, "o", "        assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631349, "o", "        assert row[52:64] == f\"{money(line.amount):>12}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631477, "o", "        assert row[64:75] == f\"{money(line.gst):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631565, "o", "        assert row[75:] == f\"{money(line.total):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631661, "o", "    assert all(len(row) == 86 for row in rows[-3:])\r\n\u001b[?2004l\r"]
[47.631705, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.631991, "o", "def test_empty_invoice_still_has_sac_header_and_zero_totals():\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = render(Invoice(\"EMPTY\", \"Customer\", NOV.start))\r\n\u001b[?2004l\r\u001b[?2004h> "]
[47.632036, "o", "    assert \"SAC\" in rendered\r\n\u001b[?2004l\r\u001b[?2004h"]
[47.63208, "o", "> "]
[47.632277, "o", "    assert rendered.splitlines()[-1].endswith(\"0.00\")\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
