[47.612603, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"Regression coverage for monthly-to-annual upgrades and their invoices (SPEC §3).\"\"\"\n\nfrom datetime import date\nfrom decimal import ROUND_DOWN, localcontext\nfrom itertools import product\n\nimport pytest\n\nfrom billing.invoice import FIXTURES, Invoice, invoice_lines, money, render\nfrom billing.periods import Period, annual_period\nfrom billing.plans import CATALOGUE, UnknownPlan, get_plan\nfrom billing.proration import ProrationError, prorate_amount, prorate_to_annual\nfrom billing.tax import line_gst, tax_lines\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\nMONTHLY = [code for code, plan in CATALOGUE.items() if plan.interval == \"month\"]\nANNUAL = [code for code, plan in CATALOGUE.items() if plan.interval == \"year\"]\n\n\n@pytest.mark.parametrize(\"old,new\", product(MONTHLY, ANNUAL))\ndef test_all_monthly_to_annual_combinations(old, new):\n    on = date(2024, 11, 14)\n    result = prorate_to_annual(old, new, NOV, on)\n    assert result.old_plan == get_plan(old)\n    assert result.new_plan == get_plan(new)\n    assert result.period == NOV\n    assert result.on == on\n    assert result.unused_days == 17\n    assert result.credit == prorate_amount(get_plan(old).price, 17, 30)\n    assert result.charge == get_plan(new).price\n    assert result.net == result.charge - result.credit\n    assert result.new_period == annual_period(on)\n\n\n@pytest.mark.parametrize(\"old,new\", [\n    (old, new) for old, new in product(CATALOGUE, repeat=2)\n    if old not in MONTHLY or new not in ANNUAL\n])\ndef test_other_plan_combinations_are_not_annual_upgrades(old, new):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old, new, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), NOV.end, date(2025, 1, 1)])\ndef test_upgrade_rejects_dates_outside_half_open_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"old,new\", [(\"missing\", \"pro-annual\"), (\"pro-monthly\", \"missing\")])\ndef test_upgrade_preserves_unknown_plan_errors(old, new):\n    with pytest.raises(UnknownPlan):\n        prorate_to_annual(old, new, NOV, NOV.start)\n\n\n@pytest.mark.parametrize(\"period,on,days,credit,end\", [\n    (NOV, NOV.start, 30, 149900, date(2025, 11, 1)),\n    (NOV, date(2024, 11, 30), 1, 4997, date(2025, 11, 30)),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 28),\n     1, 5354, date(2024, 2, 28)),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29),\n     1, 5169, date(2025, 2, 28)),\n    (Period(date(2024, 1, 15), date(2024, 2, 15)), date(2024, 1, 31),\n     15, 72532, date(2025, 1, 31)),\n])\ndef test_upgrade_calendar_boundaries(period, on, days, credit, end):\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\n    assert result.unused_days == days\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.new_period == Period(on, end)\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32), (0, 0)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    with localcontext() as context:\n        context.rounding = ROUND_DOWN\n        assert line_gst(amount) == expected\n\n\ndef test_proration_rounds_half_up():\n    with localcontext() as context:\n        context.rounding = ROUND_DOWN\n        assert prorate_amount(125, 1, 2) == 63\n\n\ndef test_upgrade_invoice_appends_and_taxes_credit_without_mutating_lines():\n    bill = FIXTURES[\"INV-2024-0107\"]()\n    original = list(bill.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice_lines(bill) == expected\n    assert invoice_lines(bill) == expected\n    assert bill.lines == original\n    taxed = tax_lines(invoice_lines(bill))\n    assert [line.gst for line in taxed] == [269820, -15290]\n    assert sum(line.amount for line in taxed) == bill.proration.net\n    assert sum(line.total for line in taxed) == 1668587\n    assert money(1668587) in render(bill).splitlines()[-1]\n\n\ndef test_invoice_without_proration_has_no_credit():"]
[47.612703, "i", "\n    bill = FIXTURES[\"INV-2024-0042\"]()\n    assert invoice_lines(bill) == bill.lines\n    assert \"Proration credit:\" not in render(bill)\n\n\ndef test_zero_credit_is_still_shown_when_invoice_carries_proration():\n    from dataclasses import replace\n\n    bill = FIXTURES[\"INV-2024-0107\"]()\n    bill.proration = replace(bill.proration, credit=0)\n    assert invoice_lines(bill)[-1] == (\"Proration credit: Pro (monthly), 17/30 days\", 0)\n\n\n@pytest.mark.parametrize(\"number\", FIXTURES)\ndef test_all_invoice_rows_include_sac_with_exact_column_widths(number):\n    bill = FIXTURES[number]()\n    rows = render(bill).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == rows[-4] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    taxed = tax_lines(invoice_lines(bill))\n    for row, line in zip(rows[4:-4], taxed, strict=True):\n        assert len(row) == 86\n        assert row[:44] == f\"{line.description[:44]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{money(line.amount):>12}\"\n        assert row[64:75] == f\"{money(line.gst):>11}\"\n        assert row[75:] == f\"{money(line.total):>11}\"\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_empty_invoice_still_has_sac_header_and_zero_totals():\n    rendered = render(Invoice(\"EMPTY\", \"Customer\", NOV.start))\n    assert \"SAC\" in rendered\n    assert rendered.splitlines()[-1].endswith(\"0.00\")\nPY\nmake update-golden && make ci\n"]
