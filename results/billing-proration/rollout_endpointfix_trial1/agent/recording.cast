[70.102629, "o", "@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_half_paisa_rounds_away_from_zero(amount, expected):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.105955, "o", "    with localcontext() as context:\r\n\u001b[?2004l\r\u001b[?2004h>         context.rounding = ROUND_DOWN\r\n\u001b[?2004l\r\u001b[?2004h>         assert line_gst(amount) == expected\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_invoice_appends_credit_without_mutating_source_lines():\r\n\u001b[?2004l\r\u001b[?2004h>     bill = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     original = list(bill.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(bill) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(bill) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert bill.lines == original\r\n\u001b[?2004l\r\u001b[?2004h>     rows = invoice.render(bill).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[4][52:] == f\"{'14,990.00':>12}{'2,698.20':>11}{'17,688.20':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[5][52:] == f\"{'-849.43':>12}{'-152.90':>11}{'-1,002.33':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-3].strip() == f\"{'Subtotal':<52}{'14,140.57':>34}\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-2].strip() == f\"{'GST @ 18%':<52}{'2,545.30':>34}\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-1].strip() == f\"{'Total due (INR)':<52}{'16,685.87':>34}\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_non_prorated_invoice_has_no_credit_and_taxes_each_line():\r\n\u001b[?2004l\r\u001b[?2004h>     bill = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"a\", 25), (\"b\", 25)])\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(bill) == bill.lines\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(bill) is not bill.lines\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(bill)\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"Proration credit:\" not in rendered\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered.splitlines()[-2][52:].strip() == \"0.10\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rendered.splitlines()[-1][52:].strip() == \"0.60\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))"]
[70.106089, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> def test_all_invoice_rows_have_sac_and_new_width(number):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.106226, "o", "    bill = invoice.FIXTURES[number]()\r\n\u001b[?2004l\r\u001b[?2004h> "]
[70.106467, "o", "    rows = invoice.render(bill).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(rows[0]) == 86"]
[70.108581, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[2] == rows[-4] == \"-\" * 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     for row, (description, _) in zip(rows[4:-4], invoice.invoice_lines(bill), strict=True):\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[:44] == f\"{description[:43]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(len(row) == 86 for row in rows[-3:])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_long_description_leaves_blank_before_sac_column():\r\n\u001b[?2004l\r\u001b[?2004h>     bill = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\r\n\u001b[?2004l\r\u001b[?2004h>     row = invoice.render(bill).splitlines()[4]\r\n\u001b[?2004l\r\u001b[?2004h>     assert row[:52] == \"x\" * 43 + \"   998314\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
