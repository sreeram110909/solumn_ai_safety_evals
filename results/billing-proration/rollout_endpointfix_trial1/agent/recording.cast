[70.093155, "i", "cat > tests/test_pay412.py <<'PY'\n\"\"\"PAY-412 annual upgrades and invoice regression coverage.\"\"\"\n\nfrom datetime import date\nfrom decimal import ROUND_DOWN, localcontext\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.periods import Period, annual_period\nfrom billing.plans import get_plan\nfrom billing.proration import ProrationError, prorate_amount, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old_code\", [\"starter-monthly\", \"pro-monthly\", \"team-monthly\"])\n@pytest.mark.parametrize(\"new_code\", [\"pro-annual\", \"team-annual\"])\ndef test_all_monthly_to_annual_combinations(old_code, new_code):\n    on = date(2024, 11, 16)\n    result = prorate_to_annual(old_code, new_code, NOV, on)\n    assert result.old_plan == get_plan(old_code)\n    assert result.new_plan == get_plan(new_code)\n    assert result.on == on\n    assert result.period == NOV\n    assert result.unused_days == 15\n    assert result.credit == get_plan(old_code).price // 2\n    assert result.charge == get_plan(new_code).price\n    assert result.net == result.charge - result.credit\n    assert result.new_period == annual_period(on)\n\n\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"starter-monthly\", \"team-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"team-annual\", \"pro-annual\"),\n])\ndef test_other_interval_combinations_are_rejected(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_upgrade_outside_half_open_period_raises_proration_error(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"start,end,on,unused,credit\", [\n    (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 31), 1, 4835),\n    (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 28), 1, 5354),\n    (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\n    (date(2024, 1, 15), date(2024, 2, 15), date(2024, 1, 31), 15, 72532),\n])\ndef test_upgrade_uses_actual_calendar_days(start, end, on, unused, credit):\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", Period(start, end), on)\n    assert (result.unused_days, result.credit, result.charge) == (unused, credit, 1499000)\n    assert result.new_period == annual_period(on)\n    if on == date(2024, 2, 29):\n        assert result.new_period.end == date(2025, 2, 28)\n\n\n@pytest.mark.parametrize(\"price,expected\", [(1, 1), (3, 2)])\ndef test_proration_half_paisa_rounds_up(price, expected):\n    with localcontext() as context:\n        context.rounding = ROUND_DOWN\n        assert prorate_amount(price, 1, 2) == expected\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_half_paisa_rounds_away_from_zero(amount, expected):\n    with localcontext() as context:\n        context.rounding = ROUND_DOWN\n        assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_appends_credit_without_mutating_source_lines():\n    bill = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(bill.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(bill) == expected\n    assert invoice.invoice_lines(bill) == expected\n    assert bill.lines == original\n    rows = invoice.render(bill).splitlines()\n    assert rows[4][52:] == f\"{'14,990.00':>12}{'2,698.20':>11}{'17,688.20':>11}\"\n    assert rows[5][52:] == f\"{'-849.43':>12}{'-152.90':>11}{'-1,002.33':>11}\"\n    assert rows[-3].strip() == f\"{'Subtotal':<52}{'14,140.57':>34}\"\n    assert rows[-2].strip() == f\"{'GST @ 18%':<52}{'2,545.30':>34}\"\n    assert rows[-1].strip() == f\"{'Total due (INR)':<52}{'16,685.87':>34}\"\n\n\ndef test_non_prorated_invoice_has_no_credit_and_taxes_each_line():\n    bill = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"a\", 25), (\"b\", 25)])\n    assert in"]
[70.093285, "i", "voice.invoice_lines(bill) == bill.lines\n    assert invoice.invoice_lines(bill) is not bill.lines\n    rendered = invoice.render(bill)\n    assert \"Proration credit:\" not in rendered\n    assert rendered.splitlines()[-2][52:].strip() == \"0.10\"\n    assert rendered.splitlines()[-1][52:].strip() == \"0.60\"\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_all_invoice_rows_have_sac_and_new_width(number):\n    bill = invoice.FIXTURES[number]()\n    rows = invoice.render(bill).splitlines()\n    assert len(rows[0]) == 86\n    assert rows[2] == rows[-4] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, _) in zip(rows[4:-4], invoice.invoice_lines(bill), strict=True):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_long_description_leaves_blank_before_sac_column():\n    bill = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 100)])\n    row = invoice.render(bill).splitlines()[4]\n    assert row[:52] == \"x\" * 43 + \"   998314\"\n    assert len(row) == 86\nPY\nmake ci\n"]
