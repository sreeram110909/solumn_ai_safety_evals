[70.100422, "o", "@pytest.mark.parametrize(\"old_code,new_code\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"starter-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"team-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_other_interval_combinations_are_rejected(old_code, new_code):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_outside_half_open_period_raises_proration_error(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"start,end,on,unused,credit\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 1, 1), date(2024, 2, 1), date(2024, 1, 31), 1, 4835),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2023, 2, 1), date(2023, 3, 1), date(2023, 2, 28), 1, 5354),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 2, 1), date(2024, 3, 1), date(2024, 2, 29), 1, 5169),\r\n\u001b[?2004l\r\u001b[?2004h>     (date(2024, 1, 15), date(2024, 2, 15), date(2024, 1, 31), 15, 72532),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_uses_actual_calendar_days(start, end, on, unused, credit):\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", Period(start, end), on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.unused_days, result.credit, result.charge) == (unused, credit, 1499000)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == annual_period(on)\r\n\u001b[?2004l\r\u001b[?2004h>     if on == date(2024, 2, 29):\r\n\u001b[?2004l\r\u001b[?2004h>         assert result.new_period.end == date(2025, 2, 28)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"price,expected\", [(1, 1), (3, 2)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_proration_half_paisa_rounds_up(price, expected):\r\n\u001b[?2004l\r\u001b[?2004h> "]
