[48.929151, "o", "    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15),\r\n\u001b[?2004l\r\u001b[?2004h>      14, 74950, date(2024, 2, 15)),\r\n\u001b[?2004l\r\u001b[?2004h>     (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 1),\r\n\u001b[?2004l\r\u001b[?2004h>      14, 67697, date(2025, 11, 1)),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_uses_actual_days(period, on, unused, credit, new_end):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[48.933235, "o", "    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.old_plan == get_plan(\"pro-monthly\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_plan == get_plan(\"pro-annual\")\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.on == on\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.period == period\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.unused_days == unused\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.charge == 1499000\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.net == result.charge - credit\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.new_period == Period(on, new_end)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_allows_different_plan_tiers():\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"starter-monthly\", \"team-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert (result.credit, result.charge) == (24950, 4999000)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_rounds_half_paisa_up(monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     from billing.plans import CATALOGUE, Plan\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setitem(CATALOGUE, \"odd-monthly\", Plan(\"odd-monthly\", \"Odd\", \"month\", 101))\r\n\u001b[?2004l\r\u001b[?2004h>     result = prorate_to_annual(\"odd-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.credit == 51\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"amount,gst\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (125, 23), (175, 32), (74925, 13487), (25025, 4505),\r\n\u001b[?2004l\r\u001b[?2004h>     (-125, -23), (-175, -32), (-74925, -13487), (-25025, -4505),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_gst_rounds_half_paisa_away_from_zero(amount, gst):\r\n\u001b[?2004l\r\u001b[?2004h>     assert line_gst(amount) == gst\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_upgrade_invoice_appends_credit_without_mutating_lines():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[\"INV-2024-0107\"]()\r\n\u001b[?2004l\r\u001b[?2004h>     original = list(inv.lines)\r\n\u001b[?2004l\r\u001b[?2004h>     expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.invoice_lines(inv) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     rendered = invoice.render(inv)\r\n\u001b[?2004l\r\u001b[?2004h>     assert invoice.render(inv) == rendered\r\n\u001b[?2004l\r\u001b[?2004h>     assert inv.lines == original\r\n\u001b[?2004l\r\u001b[?2004h>     rows = rendered.splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[4][52:64].strip() == \"14,990.00\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[5][52:64].strip() == \"-849.43\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[5][64:75].strip() == \"-152.90\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[5][75:86].strip() == \"-1,002.33\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-3].split()[-1] == \"14,140.57\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-2].split()[-1] == \"2,545.30\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-1].split()[-1] == \"16,685.87\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_ordinary_invoice_has_no_proration_credit():\r\n\u001b[?2004l\r\u001b[?2004h> "]
