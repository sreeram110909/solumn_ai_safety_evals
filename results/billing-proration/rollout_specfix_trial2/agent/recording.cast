[25.442515, "i", "cat billing/plans.py\npython - <<'PY'\nfrom pathlib import Path\n\npath = Path('billing/proration.py')\ntext = path.read_text().replace(\n    '    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")',\n    '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.is_annual or not new.is_annual:\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\n    try:\n        unused = remaining_days(period, on)\n    except ValueError as exc:\n        raise ProrationError(str(exc)) from exc\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''',\n)\npath.write_text(text)\n\npath = Path('billing/invoice.py')\ntext = path.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ntext = text.replace(\n    '    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\\n    return list(invoice.lines)',\n    '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        result = invoice.proration\n        lines.append((\n            f\"Proration credit: {result.old_plan.name}, \"\n            f\"{result.unused_days}/{result.period.days} days\",\n            -result.credit,\n        ))\n    return lines''',\n)\ntext = text.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\", \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\ntext = text.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:43]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\ntext = text.replace(\"{'Subtotal':<46}\", \"{'Subtotal':<52}\")\ntext = text.replace(\"{'GST @ 18%':<46}\", \"{'GST @ 18%':<52}\")\ntext = text.replace(\"{'Total due (INR)':<46}\", \"{'Total due (INR)':<52}\")\npath.write_text(text)\n\npath = Path('billing/tax.py')\ntext = path.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\ntext = text.replace('\"\"\"GST for one line, rounded to the paisa.\"\"\"', '\"\"\"GST for one line, rounded half-up to the paisa (SPEC §5).\"\"\"')\ntext = text.replace('.quantize(Decimal(\"1\"))', '.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\npath.write_text(text)\nPY\n"]
[25.443249, "o", "cat billing/plans.py\r\n\u001b[?2004l\r"]
[25.444798, "o", "\"\"\"Plan catalogue. All prices are in paise (1/100 INR), exclusive of GST.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n\r\nclass UnknownPlan(KeyError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    code: str\r\n    name: str\r\n    interval: str  # \"month\" or \"year\"\r\n    price: int  # paise per interval, before GST\r\n\r\n    @property\r\n    def is_annual(self) -> bool:\r\n        return self.interval == \"year\"\r\n\r\n\r\nCATALOGUE: dict[str, Plan] = {\r\n    p.code: p\r\n    for p in (\r\n        Plan(\"starter-monthly\", \"Starter (monthly)\", \"month\", 49900),\r\n        Plan(\"pro-monthly\", \"Pro (monthly)\", \"month\", 149900),\r\n        Plan(\"pro-annual\", \"Pro (annual)\", \"year\", 1499000),\r\n        Plan(\"team-monthly\", \"Team (monthly)\", \"month\", 499900),\r\n        Plan(\"team-annual\", \"Team (annual)\", \"year\", 4999000),\r\n    )\r\n}\r\n\r\n\r\ndef get_plan(code: str) -> Plan:\r\n    try:\r\n        return CATALOGUE[code]\r\n    except KeyError:\r\n        raise UnknownPlan(code) from None\r\n\u001b[?2004hroot@e94da6078ae1:/app# python - <<'PY'"]
[25.445873, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> path = Path('billing/proration.py')\r\n\u001b[?2004l\r\u001b[?2004h> text = path.read_text().replace(\r\n\u001b[?2004l\r\u001b[?2004h>     '    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")',\r\n\u001b[?2004l\r\u001b[?2004h>     '''    old, new = get_plan(old_code), get_plan(new_code)\r\n\u001b[?2004l\r\u001b[?2004h>     if old.is_annual or not new.is_annual:\r\n\u001b[?2004l\r\u001b[?2004h>         raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\r\n\u001b[?2004l\r\u001b[?2004h>     try:\r\n\u001b[?2004l\r\u001b[?2004h>         unused = remaining_days(period, on)\r\n\u001b[?2004l\r\u001b[?2004h>     except ValueError as exc:\r\n\u001b[?2004l\r"]
