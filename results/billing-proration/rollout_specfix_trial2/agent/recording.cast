[48.922784, "i", "export GIT_PAGER=cat\ncat >> tests/test_billing.py <<'PY'\n\n\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"pro-monthly\", \"team-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n])\ndef test_annual_upgrade_rejects_other_transitions(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit,new_end\", [\n    (NOV, date(2024, 11, 30), 1, 4997, date(2025, 11, 30)),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)), date(2024, 2, 29),\n     1, 5169, date(2025, 2, 28)),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)), date(2023, 2, 15),\n     14, 74950, date(2024, 2, 15)),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)), date(2024, 11, 1),\n     14, 67697, date(2025, 11, 1)),\n])\ndef test_annual_upgrade_uses_actual_days(period, on, unused, credit, new_end):\n    result = prorate_to_annual(\"pro-monthly\", \"pro-annual\", period, on)\n    assert result.old_plan == get_plan(\"pro-monthly\")\n    assert result.new_plan == get_plan(\"pro-annual\")\n    assert result.on == on\n    assert result.period == period\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 1499000\n    assert result.net == result.charge - credit\n    assert result.new_period == Period(on, new_end)\n\n\ndef test_annual_upgrade_allows_different_plan_tiers():\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", NOV, date(2024, 11, 16))\n    assert (result.credit, result.charge) == (24950, 4999000)\n\n\ndef test_annual_upgrade_rounds_half_paisa_up(monkeypatch):\n    from billing.plans import CATALOGUE, Plan\n\n    monkeypatch.setitem(CATALOGUE, \"odd-monthly\", Plan(\"odd-monthly\", \"Odd\", \"month\", 101))\n    result = prorate_to_annual(\"odd-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51\n\n\n@pytest.mark.parametrize(\"amount,gst\", [\n    (125, 23), (175, 32), (74925, 13487), (25025, 4505),\n    (-125, -23), (-175, -32), (-74925, -13487), (-25025, -4505),\n])\ndef test_gst_rounds_half_paisa_away_from_zero(amount, gst):\n    assert line_gst(amount) == gst\n\n\ndef test_upgrade_invoice_appends_credit_without_mutating_lines():\n    inv = invoice.FIXTURES[\"INV-2024-0107\"]()\n    original = list(inv.lines)\n    expected = original + [(\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    rendered = invoice.render(inv)\n    assert invoice.render(inv) == rendered\n    assert inv.lines == original\n    rows = rendered.splitlines()\n    assert rows[4][52:64].strip() == \"14,990.00\"\n    assert rows[5][52:64].strip() == \"-849.43\"\n    assert rows[5][64:75].strip() == \"-152.90\"\n    assert rows[5][75:86].strip() == \"-1,002.33\"\n    assert rows[-3].split()[-1] == \"14,140.57\"\n    assert rows[-2].split()[-1] == \"2,545.30\"\n    assert rows[-1].split()[-1] == \"16,685.87\"\n\n\ndef test_ordinary_invoice_has_no_proration_credit():\n    inv = invoice.FIXTURES[\"INV-2024-0042\"]()\n    assert invoice.invoice_lines(inv) == inv.lines\n    assert invoice.invoice_lines(inv) is not inv.lines\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_sac_columns_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert rows[2] == rows[-4] == \"-\" * 86\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:43]:<44}\"\n        assert row[44:52] == \"  998314\"\n       "]
[48.922858, "i", " assert row[52:64] == f\"{invoice.money(amount):>12}\"\n    assert all(len(row) == 86 for row in rows[-3:])\n\n\ndef test_invoice_truncates_long_description_leaving_separator_blank():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 125)])\n    row = invoice.render(inv).splitlines()[4]\n    assert row[:52] == \"x\" * 43 + \"   998314\"\n\n\ndef test_invoice_rounds_tax_per_line_not_on_subtotal():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"a\", 125), (\"b\", 125)])\n    rows = invoice.render(inv).splitlines()\n    assert rows[-2].split()[-1] == \"0.46\"\n    assert rows[-1].split()[-1] == \"2.96\"\nPY\nmake update-golden\nmake ci\n"]
