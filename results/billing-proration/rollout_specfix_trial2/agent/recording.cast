[48.925262, "o", "\r\n\u001b[?2004l\r\u001b[?2004hroot@e94da6078ae1:/app# cat >> tests/test_billing.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"old_code,new_code\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"team-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-monthly\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-monthly\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"team-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"pro-annual\", \"pro-annual\"),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_rejects_other_transitions(old_code, new_code):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2024, 12, 2)])\r\n\u001b[?2004l\r\u001b[?2004h> def test_annual_upgrade_rejects_dates_outside_period(on):\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ProrationError):\r\n\u001b[?2004l\r\u001b[?2004h>         prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"period,on,unused,credit,new_end\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (NOV, date(2024, 11, 30), 1, 4997, date(2025, 11, 30)),\r\n\u001b[?2004l\r\u001b[?2004h> "]
