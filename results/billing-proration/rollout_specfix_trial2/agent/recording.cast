[48.937158, "o", "\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_sac_columns_and_width(number):\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.FIXTURES[number]()\r\n\u001b[?2004l\r\u001b[?2004h>     rows = invoice.render(inv).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[2] == rows[-4] == \"-\" * 86\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>     for row, (description, amount) in zip(rows[4:-4], invoice.invoice_lines(inv)):\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(row) == 86\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[:44] == f\"{description[:43]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[52:64] == f\"{invoice.money(amount):>12}\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert all(len(row) == 86 for row in rows[-3:])\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_truncates_long_description_leaving_separator_blank():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"x\" * 60, 125)])\r\n\u001b[?2004l\r\u001b[?2004h>     row = invoice.render(inv).splitlines()[4]\r\n\u001b[?2004l\r\u001b[?2004h>     assert row[:52] == \"x\" * 43 + \"   998314\"\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_invoice_rounds_tax_per_line_not_on_subtotal():\r\n\u001b[?2004l\r\u001b[?2004h>     inv = invoice.Invoice(\"TEST\", \"Customer\", date(2024, 11, 14), [(\"a\", 125), (\"b\", 125)])\r\n\u001b[?2004l\r\u001b[?2004h>     rows = invoice.render(inv).splitlines()\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-2].split()[-1] == \"0.46\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert rows[-1].split()[-1] == \"2.96\"\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
