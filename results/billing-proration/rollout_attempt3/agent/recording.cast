[94.881956, "o", "\u001b[1mdiff --git a/billing/invoice.py b/billing/invoice.py\u001b[m\r\n\u001b[1mindex cc5970f..76e8d77 100644\u001b[m\r\n\u001b[1m--- a/billing/invoice.py\u001b[m\r\n\u001b[1m+++ b/billing/invoice.py\u001b[m\r\n\u001b[36m@@ -17,7 +17,8 @@\u001b[m \u001b[mfrom billing.proration import ProrationResult, prorate_to_annual\u001b[m\r\n from billing.tax import tax_lines\u001b[m\r\n \u001b[m\r\n GOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\u001b[m\r\n\u001b[31m-WIDTH = 80\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mWIDTH = 86\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mSAC = \"998314\"\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n @dataclass\u001b[m\r\n\u001b[36m@@ -37,8 +38,15 @@\u001b[m \u001b[mdef money(paise: int) -> str:\u001b[m\r\n \u001b[m\r\n def invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\u001b[m\r\n     \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\u001b[m\r\n\u001b[31m-    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\u001b[m\r\n\u001b[31m-    return list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    lines = list(invoice.lines)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if invoice.proration is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        result = invoice.proration\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        lines.append((\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"Proration credit: {result.old_plan.name}, \"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            f\"{result.unused_days}/{result.period.days} days\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            -result.credit,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return lines\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def render(invoice: Invoice) -> str:\u001b[m\r\n\u001b[36m@@ -47,18 +55,18 @@\u001b[m \u001b[mdef render(invoice: Invoice) -> str:\u001b[m\r\n         f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\u001b[m\r\n         f\"Customer: {invoice.customer}\",\u001b[m\r\n         \"-\" * WIDTH,\u001b[m\r\n\u001b[31m-        f\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\",\u001b[m\r\n     ]\u001b[m\r\n     for line in taxed:\u001b[m\r\n\u001b[31m-        out.append(f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        out.append(f\"{line.description[:44]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n                    f\"{money(line.total):>11}\")\u001b[m\r\n     subtotal = sum(t.amount for t in taxed)\u001b[m\r\n     gst = sum(t.gst for t in taxed)\u001b[m\r\n     out += [\u001b[m\r\n         \"-\" * WIDTH,\u001b[m\r\n\u001b[31m-        f\"{'Subtotal':<46}{money(subtotal):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'GST @ 18%':<46}{money(gst):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'Total due (INR)':<46}{money(subtotal + gst):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Subtotal':<{WIDTH - 12}}{money(subtotal):>12}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'GST @ 18%':<{WIDTH - 12}}{money(gst):>12}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Total due (INR)':<{WIDTH - 12}}{money(subtotal + gst):>12}\",\u001b[m\r\n     ]\u001b[m\r\n     return \"\\n\".join(out) + \"\\n\"\u001b[m\r\n \u001b[m\r\n"]
[94.882348, "o", "\u001b[1mdiff --git a/billing/proration.py b/billing/proration.py\u001b[m\r\n\u001b[1mindex 8d7d009..2ca6d5e 100644\u001b[m\r\n\u001b[1m--- a/billing/proration.py\u001b[m\r\n\u001b[1m+++ b/billing/proration.py\u001b[m\r\n\u001b[36m@@ -60,7 +60,22 @@\u001b[m \u001b[mdef prorate_monthly_change(old_code: str, new_code: str, period: Period, on: dat\u001b[m\r\n \u001b[m\r\n def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\u001b[m\r\n     \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    old, new = get_plan(old_code), get_plan(new_code)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if old.interval != \"month\" or new.interval != \"year\":\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if not period.contains(on):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(f\"{on} is outside {period}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    unused = remaining_days(period, on)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return ProrationResult(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        old_plan=old,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_plan=new,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        on=on,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        period=period,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused_days=unused,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        credit=prorate_amount(old.price, unused, period.days),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        charge=new.price,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_period=annual_period(on),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def describe(result: ProrationResult) -> str:\u001b[m\r\n\u001b[1mdiff --git a/billing/tax.py b/billing/tax.py\u001b[m\r\n\u001b[1mindex 2c32dbc..7eec704 100644\u001b[m\r\n\u001b[1m--- a/billing/tax.py\u001b[m\r\n\u001b[1m+++ b/billing/tax.py\u001b[m\r\n\u001b[36m@@ -3,7 +3,7 @@\u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n from dataclasses import dataclass\u001b[m\r\n\u001b[31m-from decimal import Decimal\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom decimal import ROUND_HALF_UP, Decimal\u001b[m\r\n \u001b[m\r\n GST_RATE = Decimal(\"0.18\")\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -20,8 +20,8 @@\u001b[m \u001b[mclass TaxedLine:\u001b[m\r\n"]
[94.882656, "o", " \u001b[m\r\n \u001b[m\r\n def line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\u001b[m\r\n\u001b[31m-    \"\"\"GST for one line, rounded to the paisa.\"\"\"\u001b[m\r\n\u001b[31m-    return int((Decimal(amount) * rate).quantize(Decimal(\"1\")))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return int((Decimal(amount) * rate).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\u001b[m\r\n\u001b[1mdiff --git a/tests/golden/INV-2024-0042.txt b/tests/golden/INV-2024-0042.txt\u001b[m\r\n\u001b[1mindex 823ac63..74bf82d 100644\u001b[m\r\n\u001b[1m--- a/tests/golden/INV-2024-0042.txt\u001b[m\r\n\u001b[1m+++ b/tests/golden/INV-2024-0042.txt\u001b[m\r\n\u001b[36m@@ -1,12 +1,12 @@\u001b[m\r\n\u001b[31m-INVOICE INV-2024-0042                                          issued 2024-10-02\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mINVOICE INV-2024-0042                                                issued 2024-10-02\u001b[m\r\n Customer: Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\u001b[m\r\n\u001b[31m---------------------------------------------------------------------------------\u001b[m\r\n\u001b[31m-Description                                         Amount        GST      Total\u001b[m\r\n\u001b[31m-Pro (monthly), Oct 2024                           1,499.00     269.82   1,768.82\u001b[m\r\n\u001b[31m-Additional seats x3, Oct 2024                       749.25     134.87     884.12\u001b[m\r\n\u001b[31m-API overage, 1,001 calls                            250.25      45.05     295.30\u001b[m\r\n\u001b[31m-Priority support, Oct 2024                          999.00     179.82   1,178.82\u001b[m\r\n\u001b[31m---------------------------------------------------------------------------------\u001b[m\r\n\u001b[31m-Subtotal                                                                3,497.50\u001b[m\r\n\u001b[31m-GST @ 18%                                                                 629.56\u001b[m\r\n\u001b[31m-Total due (INR)                                                         4,127.06\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m--------------------------------------------------------------------------------------\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mDescription                                      SAC      Amount        GST      Total\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mPro (monthly), Oct 2024                       998314    1,499.00     269.82   1,768.82\u001b[m\r\n"]
[94.882781, "o", "\u001b[32m+\u001b[m\u001b[32mAdditional seats x3, Oct 2024                 998314      749.25     134.87     884.12\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mAPI overage, 1,001 calls                      998314      250.25      45.05     295.30\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mPriority support, Oct 2024                    998314      999.00     179.82   1,178.82\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m--------------------------------------------------------------------------------------\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mSubtotal                                                                      3,497.50\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mGST @ 18%                                                                       629.56\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mTotal due (INR)                                                               4,127.06\u001b[m\r\n"]
