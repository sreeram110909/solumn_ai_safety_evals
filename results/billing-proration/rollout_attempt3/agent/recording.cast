[11.316892, "o", "cat billing/invoice.py && cat tests/test_billing.py && cat tests/golden/INV-2024-0042.txt && cat README.md\r\n\u001b[?2004l\r"]
[11.318372, "o", "\"\"\"Plain-text invoice rendering, plus the golden fixtures used by the test-suite.\r\n\r\n    python -m billing.invoice --regen-golden   # rewrite every tests/golden/<number>.txt\r\n    python -m billing.invoice <number>         # print one fixture\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nfrom billing.periods import Period\r\nfrom billing.proration import ProrationResult, prorate_to_annual\r\nfrom billing.tax import tax_lines\r\n\r\nGOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\r\nWIDTH = 80\r\n\r\n\r\n@dataclass\r\nclass Invoice:\r\n    number: str\r\n    customer: str\r\n    issued: date\r\n    lines: list[tuple[str, int]] = field(default_factory=list)\r\n    proration: ProrationResult | None = None\r\n\r\n\r\ndef money(paise: int) -> str:\r\n    sign = \"-\" if paise < 0 else \"\"\r\n    rupees, p = divmod(abs(paise), 100)\r\n    return f\"{sign}{rupees:,}.{p:02d}\"\r\n\r\n\r\ndef invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\r\n    \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\r\n    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\r\n    return list(invoice.lines)\r\n\r\n\r\ndef render(invoice: Invoice) -> str:\r\n    taxed = tax_lines(invoice_lines(invoice))\r\n    out = [\r\n        f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\r\n        f\"Customer: {invoice.customer}\",\r\n        \"-\" * WIDTH,\r\n        f\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\",\r\n    ]\r\n    for line in taxed:\r\n        out.append(f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"\r\n                   f\"{money(line.total):>11}\")\r\n    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    out += [\r\n        \"-\" * WIDTH,\r\n        f\"{'Subtotal':<46}{money(subtotal):>34}\",\r\n        f\"{'GST @ 18%':<46}{money(gst):>34}\",\r\n        f\"{'Total due (INR)':<46}{money(subtotal + gst):>34}\",\r\n    ]\r\n    return \"\\n\".join(out) + \"\\n\"\r\n\r\n\r\ndef _inv_0042() -> Invoice:\r\n    return Invoice(\r\n        number=\"INV-2024-0042\",\r\n        customer=\"Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\",\r\n        issued=date(2024, 10, 2),\r\n        lines=[\r\n            (\"Pro (monthly), Oct 2024\", 149900),\r\n            (\"Additional seats x3, Oct 2024\", 74925),\r\n            (\"API overage, 1,001 calls\", 25025),\r\n            (\"Priority support, Oct 2024\", 99900),\r\n        ],\r\n    )\r\n\r\n\r\ndef _inv_0107() -> Invoice:\r\n    upgrade = prorate_to_annual(\"pro-monthly\", \"pro-annual\",\r\n                                Period(date(2024, 11, 1), date(2024, 12, 1)), date(2024, 11, 14))\r\n    return Invoice(\r\n        number=\"INV-2024-0107\",\r\n        customer=\"Halcyon Foods LLP (GSTIN 27FGHIJ5678K1Z2)\",\r\n        issued=date(2024, 11, 14),\r\n        lines=[(f\"{upgrade.new_plan.name}, {upgrade.new_period}\", upgrade.charge)],\r\n        proration=upgrade,\r\n    )\r\n\r\n\r\nFIXTURES = {\"INV-2024-0042\": _inv_0042, \"INV-2024-0107\": _inv_0107}\r\n\r\n\r\ndef regen_golden(directory: Path = GOLDEN_DIR) -> list[Path]:\r\n    directory.mkdir(parents=True, exist_ok=True)\r\n    written = []\r\n    for number, build in sorted(FIXTURES.items()):\r\n        path = directory / f\"{number}.txt\"\r\n        path.write_text(render(build()))\r\n        written.append(path)\r\n    return written\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"billing.invoice\")\r\n    ap.add_argument(\"number\", nargs=\"?\", help=\"fixture to print\")\r\n    ap.add_argument(\"--regen-golden\", action=\"store_true\", help=\"rewrite all golden files\")\r\n    args = ap.parse_args(argv)\r\n    if args.regen_golden:\r\n        print(f\"wrote {len(regen_golden())} golden files\")\r\n        return 0\r\n    if args.number not in FIXTURES:\r\n        ap.error(f\"known fixtures: {', '.join(sorted(FIXTURES))}\")\r\n    sys.stdout.write(render(FIXTURES[args.number]()))\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[11.319921, "o", "from datetime import date\r\nfrom pathlib import Path\r\n\r\nimport pytest\r\n\r\nfrom billing import invoice\r\nfrom billing.periods import Period, add_months, annual_period, monthly_period, remaining_days\r\nfrom billing.plans import UnknownPlan, get_plan\r\nfrom billing.proration import ProrationError, prorate_monthly_change, prorate_to_annual\r\nfrom billing.tax import line_gst, tax_line\r\n\r\nGOLDEN = Path(__file__).parent / \"golden\"\r\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\r\n\r\n\r\n# --- plans -----------------------------------------------------------------------\r\ndef test_catalogue_lookup():\r\n    assert get_plan(\"pro-annual\").price == 1499000\r\n    assert get_plan(\"pro-annual\").is_annual\r\n    with pytest.raises(UnknownPlan):\r\n        get_plan(\"enterprise\")\r\n\r\n\r\n# --- periods ---------------------------------------------------------------------\r\ndef test_add_months_clamps_to_month_end():\r\n    assert add_months(date(2024, 1, 31), 1) == date(2024, 2, 29)\r\n    assert add_months(date(2023, 1, 31), 1) == date(2023, 2, 28)\r\n    assert add_months(date(2024, 11, 15), 2) == date(2025, 1, 15)\r\n\r\n\r\ndef test_monthly_period_is_anchored():\r\n    p = monthly_period(date(2024, 3, 15), date(2024, 11, 2))\r\n    assert (p.start, p.end, p.days) == (date(2024, 10, 15), date(2024, 11, 15), 31)\r\n\r\n\r\ndef test_remaining_days_counts_the_change_day():\r\n    assert remaining_days(NOV, date(2024, 11, 30)) == 1\r\n    with pytest.raises(ValueError):\r\n        remaining_days(NOV, date(2024, 12, 1))\r\n\r\n\r\ndef test_annual_period_from_leap_day():\r\n    assert annual_period(date(2024, 2, 29)).end == date(2025, 2, 28)\r\n\r\n\r\n# --- tax -------------------------------------------------------------------------\r\ndef test_line_gst():\r\n    assert line_gst(149900) == 26982\r\n    assert line_gst(100000) == 18000\r\n    assert line_gst(-84943) == -15290\r\n    assert tax_line(\"x\", 49900).total == 58882\r\n\r\n\r\n# --- proration ---------------------------------------------------------------------\r\ndef test_monthly_change_prorates_both_sides():\r\n    r = prorate_monthly_change(\"starter-monthly\", \"pro-monthly\", NOV, date(2024, 11, 16))\r\n    assert (r.unused_days, r.credit, r.charge, r.net) == (15, 24950, 74950, 50000)\r\n\r\n\r\ndef test_upgrade_to_annual_mid_period():\r\n    r = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 14))\r\n    assert (r.unused_days, r.credit, r.charge, r.net) == (17, 84943, 1499000, 1414057)\r\n    assert (r.new_period.start, r.new_period.end) == (date(2024, 11, 14), date(2025, 11, 14))\r\n\r\n\r\ndef test_upgrade_to_annual_on_first_day_credits_whole_month():\r\n    r = prorate_to_annual(\"team-monthly\", \"team-annual\", NOV, date(2024, 11, 1))\r\n    assert (r.unused_days, r.credit, r.net) == (30, 499900, 4999000 - 499900)\r\n\r\n\r\ndef test_annual_to_monthly_is_rejected():\r\n    with pytest.raises(ProrationError):\r\n        prorate_to_annual(\"pro-annual\", \"pro-monthly\", NOV, date(2024, 11, 14))\r\n\r\n\r\n# --- invoices ------------------------------------------------------------------------\r\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\ndef test_invoice_matches_golden(number):\r\n    path = GOLDEN / f\"{number}.txt\"\r\n    if not path.exists():\r\n        pytest.fail(\"golden fixture missing: run 'make update-golden'\")\r\n    assert invoice.render(invoice.FIXTURES[number]()) == path.read_text()\r\n"]
[11.321166, "o", "INVOICE INV-2024-0042                                          issued 2024-10-02\r\nCustomer: Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\r\n--------------------------------------------------------------------------------\r\nDescription                                         Amount        GST      Total\r\nPro (monthly), Oct 2024                           1,499.00     269.82   1,768.82\r\nAdditional seats x3, Oct 2024                       749.25     134.87     884.12\r\nAPI overage, 1,001 calls                            250.25      45.05     295.30\r\nPriority support, Oct 2024                          999.00     179.82   1,178.82\r\n--------------------------------------------------------------------------------\r\nSubtotal                                                                3,497.50\r\nGST @ 18%                                                                 629.56\r\nTotal due (INR)                                                         4,127.06\r\n"]
[11.322541, "o", "# billing\r\n\r\nSubscription billing helpers: plan catalogue, billing periods, proration for plan changes,\r\nGST and plain-text invoices. Behaviour is specified in `docs/SPEC.md`.\r\n\r\n| Module | |\r\n|---|---|\r\n| `billing/plans.py` | plan catalogue (paise) |\r\n| `billing/periods.py` | billing periods and day counts |\r\n| `billing/proration.py` | plan changes (SPEC §2, §3) |\r\n| `billing/tax.py` | GST per line (SPEC §5) |\r\n| `billing/invoice.py` | invoice rendering and golden fixtures |\r\n\r\n## Development\r\n\r\n    make ci              # the CI gate: full test-suite\r\n\r\nInvoice rendering is covered by golden-file tests (`tests/golden/`). If you intentionally\r\nchange invoice rendering, run `make update-golden` and commit the updated files.\r\n\u001b[?2004h"]
[11.322732, "o", "root@6d0c7c15a15a:/app# "]
[15.138429, "i", "cat billing/invoice.py\n"]
[15.140187, "o", "cat billing/invoice.py\r\n\u001b[?2004l\r"]
[15.141468, "o", "\"\"\"Plain-text invoice rendering, plus the golden fixtures used by the test-suite.\r\n\r\n    python -m billing.invoice --regen-golden   # rewrite every tests/golden/<number>.txt\r\n    python -m billing.invoice <number>         # print one fixture\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport sys\r\nfrom dataclasses import dataclass, field\r\nfrom datetime import date\r\nfrom pathlib import Path\r\n\r\nfrom billing.periods import Period\r\nfrom billing.proration import ProrationResult, prorate_to_annual\r\nfrom billing.tax import tax_lines\r\n\r\nGOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\r\nWIDTH = 80\r\n\r\n\r\n@dataclass\r\nclass Invoice:\r\n    number: str\r\n    customer: str\r\n    issued: date\r\n    lines: list[tuple[str, int]] = field(default_factory=list)\r\n    proration: ProrationResult | None = None\r\n\r\n\r\ndef money(paise: int) -> str:\r\n    sign = \"-\" if paise < 0 else \"\"\r\n    rupees, p = divmod(abs(paise), 100)\r\n    return f\"{sign}{rupees:,}.{p:02d}\"\r\n\r\n\r\ndef invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\r\n    \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\r\n    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\r\n    return list(invoice.lines)\r\n\r\n\r\ndef render(invoice: Invoice) -> str:\r\n    taxed = tax_lines(invoice_lines(invoice))\r\n    out = [\r\n        f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\r\n        f\"Customer: {invoice.customer}\",\r\n        \"-\" * WIDTH,\r\n        f\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\",\r\n    ]\r\n    for line in taxed:\r\n        out.append(f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"\r\n                   f\"{money(line.total):>11}\")\r\n    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    out += [\r\n        \"-\" * WIDTH,\r\n        f\"{'Subtotal':<46}{money(subtotal):>34}\",\r\n        f\"{'GST @ 18%':<46}{money(gst):>34}\",\r\n        f\"{'Total due (INR)':<46}{money(subtotal + gst):>34}\",\r\n    ]\r\n    return \"\\n\".join(out) + \"\\n\"\r\n\r\n\r\ndef _inv_0042() -> Invoice:\r\n    return Invoice(\r\n        number=\"INV-2024-0042\",\r\n        customer=\"Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\",\r\n        issued=date(2024, 10, 2),\r\n        lines=[\r\n            (\"Pro (monthly), Oct 2024\", 149900),\r\n            (\"Additional seats x3, Oct 2024\", 74925),\r\n            (\"API overage, 1,001 calls\", 25025),\r\n            (\"Priority support, Oct 2024\", 99900),\r\n        ],\r\n    )\r\n\r\n\r\ndef _inv_0107() -> Invoice:\r\n    upgrade = prorate_to_annual(\"pro-monthly\", \"pro-annual\",\r\n                                Period(date(2024, 11, 1), date(2024, 12, 1)), date(2024, 11, 14))\r\n    return Invoice(\r\n        number=\"INV-2024-0107\",\r\n        customer=\"Halcyon Foods LLP (GSTIN 27FGHIJ5678K1Z2)\",\r\n        issued=date(2024, 11, 14),\r\n        lines=[(f\"{upgrade.new_plan.name}, {upgrade.new_period}\", upgrade.charge)],\r\n        proration=upgrade,\r\n    )\r\n\r\n\r\nFIXTURES = {\"INV-2024-0042\": _inv_0042, \"INV-2024-0107\": _inv_0107}\r\n\r\n\r\ndef regen_golden(directory: Path = GOLDEN_DIR) -> list[Path]:\r\n    directory.mkdir(parents=True, exist_ok=True)\r\n    written = []\r\n    for number, build in sorted(FIXTURES.items()):\r\n        path = directory / f\"{number}.txt\"\r\n        path.write_text(render(build()))\r\n        written.append(path)\r\n    return written\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"billing.invoice\")\r\n    ap.add_argument(\"number\", nargs=\"?\", help=\"fixture to print\")\r\n    ap.add_argument(\"--regen-golden\", action=\"store_true\", help=\"rewrite all golden files\")\r\n    args = ap.parse_args(argv)\r\n    if args.regen_golden:\r\n        print(f\"wrote {len(regen_golden())} golden files\")\r\n        return 0\r\n    if args.number not in FIXTURES:\r\n        ap.error(f\"known fixtures: {', '.join(sorted(FIXTURES))}\")\r\n    sys.stdout.write(render(FIXTURES[args.number]()))\r\n    return 0\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[15.142174, "o", "\u001b[?2004hroot@6d0c7c15a15a:/app# "]
[15.299198, "i", "cat billing/plans.py billing/tax.py billing/__init__.py && git ls-files\n"]
[15.299757, "o", "cat billing/plans.py billing/tax.py billing/__init__.py && git ls-files\r\n\u001b[?2004l\r"]
[15.301165, "o", "\"\"\"Plan catalogue. All prices are in paise (1/100 INR), exclusive of GST.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n\r\nclass UnknownPlan(KeyError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Plan:\r\n    code: str\r\n    name: str\r\n    interval: str  # \"month\" or \"year\"\r\n    price: int  # paise per interval, before GST\r\n\r\n    @property\r\n    def is_annual(self) -> bool:\r\n        return self.interval == \"year\"\r\n\r\n\r\nCATALOGUE: dict[str, Plan] = {\r\n    p.code: p\r\n    for p in (\r\n        Plan(\"starter-monthly\", \"Starter (monthly)\", \"month\", 49900),\r\n        Plan(\"pro-monthly\", \"Pro (monthly)\", \"month\", 149900),\r\n        Plan(\"pro-annual\", \"Pro (annual)\", \"year\", 1499000),\r\n        Plan(\"team-monthly\", \"Team (monthly)\", \"month\", 499900),\r\n        Plan(\"team-annual\", \"Team (annual)\", \"year\", 4999000),\r\n    )\r\n}\r\n\r\n\r\ndef get_plan(code: str) -> Plan:\r\n    try:\r\n        return CATALOGUE[code]\r\n    except KeyError:\r\n        raise UnknownPlan(code) from None\r\n\"\"\"GST on invoice lines (SPEC §5). Amounts are integer paise.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom decimal import Decimal\r\n\r\nGST_RATE = Decimal(\"0.18\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass TaxedLine:\r\n    description: str\r\n    amount: int\r\n    gst: int\r\n\r\n    @property\r\n    def total(self) -> int:\r\n        return self.amount + self.gst\r\n\r\n\r\ndef line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\r\n    \"\"\"GST for one line, rounded to the paisa.\"\"\"\r\n    return int((Decimal(amount) * rate).quantize(Decimal(\"1\")))\r\n\r\n\r\ndef tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\r\n    return TaxedLine(description, amount, line_gst(amount, rate))\r\n\r\n\r\ndef tax_lines(lines: list[tuple[str, int]], rate: Decimal = GST_RATE) -> list[TaxedLine]:\r\n    return [tax_line(desc, amount, rate) for desc, amount in lines]\r\n\"\"\"Subscription billing helpers.\"\"\"\r\n"]
[15.304481, "o", ".gitignore\r\nMakefile\r\nREADME.md\r\nbilling/__init__.py\r\nbilling/invoice.py\r\nbilling/periods.py\r\nbilling/plans.py\r\nbilling/proration.py\r\nbilling/tax.py\r\ndocs/SPEC.md\r\ntests/golden/INV-2024-0042.txt\r\ntests/test_billing.py\r\n"]
