[62.838428, "o", "\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r     for line in taxed:\u001b[m\u001b[K\r\n\u001b[31m-        out.append(f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        out.append(f\"{line.description[:44]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"\u001b[m\r\n                    f\"{money(line.total):>11}\")\u001b[m\r\n     subtotal = sum(t.amount for t in taxed)\u001b[m\r\n     gst = sum(t.gst for t in taxed)\u001b[m\r\n     out += [\u001b[m\r\n         \"-\" * WIDTH,\u001b[m\r\n\u001b[31m-        f\"{'Subtotal':<46}{money(subtotal):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'GST @ 18%':<46}{money(gst):>34}\",\u001b[m\r\n\u001b[31m-        f\"{'Total due (INR)':<46}{money(subtotal + gst):>34}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Subtotal':<{WIDTH - 12}}{money(subtotal):>12}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'GST @ 18%':<{WIDTH - 12}}{money(gst):>12}\",\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        f\"{'Total due (INR)':<{WIDTH - 12}}{money(subtotal + gst):>12}\",\u001b[m\r\n     ]\u001b[m\r\n     return \"\\n\".join(out) + \"\\n\"\u001b[m\r\n \u001b[m\r\n\u001b[1mdiff --git a/billing/proration.py b/billing/proration.py\u001b[m\r\n\u001b[1mindex 8d7d009..2ca6d5e 100644\u001b[m\r\n\u0007\u001b[7m--More--\u001b[27m\r\u001b[1m--- a/billing/proration.py\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[62.988438, "i", "python - <<'PY'\nfrom pathlib import Path\npath = Path('tests/test_billing.py')\ntext = path.read_text().replace('from billing.plans import UnknownPlan, get_plan', 'from billing.plans import CATALOGUE, Plan, UnknownPlan, get_plan')\ntext += '''\n\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"starter-monthly\", \"pro-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"team-annual\", \"starter-monthly\"),\n])\ndef test_annual_upgrade_rejects_other_plan_transitions(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit,annual_end\", [\n    (NOV, date(2024, 11, 30), 1, 1663, date(2025, 11, 30)),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)),\n     date(2024, 2, 29), 1, 1721, date(2025, 2, 28)),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)),\n     date(2023, 2, 15), 14, 24950, date(2024, 2, 15)),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)),\n     date(2024, 11, 14), 1, 1610, date(2025, 11, 14)),\n])\ndef test_annual_upgrade_uses_actual_days_and_new_plan_price(period, on, unused, credit, annual_end):\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == Period(on, annual_end)\n\n\ndef test_annual_upgrade_rounds_half_paisa_credit_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_rounds_half_paisa_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_includes_credit_without_mutating_lines():\n    upgrade = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 14))\n    charge_line = (f\"{upgrade.new_plan.name}, {upgrade.new_period}\", upgrade.charge)\n    inv = invoice.Invoice(\"TEST\", \"Customer\", upgrade.on, [charge_line], upgrade)\n    expected = [charge_line, (\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == [charge_line]\n    rendered = invoice.render(inv)\n    assert rendered == invoice.render(inv)\n    assert \"-849.43\" in rendered\n    assert \"-152.90\" in rendered\n    assert rendered.splitlines()[-3].split()[-1] == \"14,140.57\"\n    assert rendered.splitlines()[-2].split()[-1] == \"2,545.30\"\n    assert rendered.splitlines()[-1].split()[-1] == \"16,685.87\"\n\n\ndef test_invoice_without_proration_has_no_credit():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", NOV.start, [(\"Service\", 125)])\n    assert invoice.invoice_lines(inv) == [(\"Service\", 125)]\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_sac_column_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    rows = invoice.render(inv).splitlines()\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:44]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        asser"]
[62.988688, "i", "t row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\n        assert row[75:] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\n    assert all(len(row) == 86 for row in [rows[0], rows[2], *rows[-4:]])\n'''\npath.write_text(text)\nPY\nmake update-golden && make ci\n"]
[62.989063, "o", "\r\u001b[1m+++ b/billing/proration.py\u001b[m\r\n\u001b[36m@@ -60,7 +60,22 @@\u001b[m \u001b[mdef prorate_monthly_change(old_code: str, new_code: str, period: Period, on: dat\u001b[m\r\n \u001b[m\r\n def prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\u001b[m\r\n     \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\u001b[m\r\n\u001b[31m-    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    old, new = get_plan(old_code), get_plan(new_code)\u001b[m\r\n"]
[62.989513, "o", "\u001b[32m+\u001b[m\u001b[32m    if old.interval != \"month\" or new.interval != \"year\":\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    if not period.contains(on):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise ProrationError(f\"{on} is outside {period}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    unused = remaining_days(period, on)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return ProrationResult(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        old_plan=old,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_plan=new,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        on=on,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        period=period,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        unused_days=unused,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        credit=prorate_amount(old.price, unused, period.days),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        charge=new.price,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        new_period=annual_period(on),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def describe(result: ProrationResult) -> str:\u001b[m\r\n\u001b[1mdiff --git a/billing/tax.py b/billing/tax.py\u001b[m\r\n\u001b[1mindex 2c32dbc..7eec704 100644\u001b[m\r\n\u001b[1m--- a/billing/tax.py\u001b[m\r\n\u001b[1m+++ b/billing/tax.py\u001b[m\r\n\u001b[36m@@ -3,7 +3,7 @@\u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n from dataclasses import dataclass\u001b[m\r\n\u001b[31m-from decimal import Decimal\u001b[m\r\n"]
[62.99034, "o", "\u001b[32m+\u001b[m\u001b[32mfrom decimal import ROUND_HALF_UP, Decimal\u001b[m\r\n \u001b[m\r\n GST_RATE = Decimal(\"0.18\")\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -20,8 +20,8 @@\u001b[m \u001b[mclass TaxedLine:\u001b[m\r\n\u001b[7m--More--\u001b[27m\r \u001b[m\u001b[K\r\n\u001b[7m--More--\u001b[27m\r \u001b[m\u001b[K\r\n def line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\u001b[m\r\n\u001b[31m-    \"\"\"GST for one line, rounded to the paisa.\"\"\"\u001b[m\r\n\u001b[31m-    return int((Decimal(amount) * rate).quantize(Decimal(\"1\")))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return int((Decimal(amount) * rate).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[KMost commands optionally preceded by integer argument k.  Defaults in brackets.\r\nStar (*) indicates argument becomes new default.\r\n-------------------------------------------------------------------------------\r\n<space>                 Display next k lines of text [current screen size]\r\nz                       Display next k lines of text [current screen size]*\r\n<return>                Display next k lines of text [1]*\r\nd or ctrl-D             Scroll k lines [current scroll size, initially 11]*\r\nq or Q or <interrupt>   Exit from more\r\ns                       Skip forward k lines of text [1]\r\nf                       Skip forward k screenfuls of text [1]\r\nb or ctrl-B             Skip backwards k screenfuls of text [1]\r\n'                       Go to place where previous search started\r\n=                       Display current line number\r\n/<regular expression>   Search for kth occurrence of regular expression [1]\r\nn                       Search for kth occurrence of last r.e [1]\r\n!<cmd> or :!<cmd>       Execute <cmd> in a subshell\r\nv                       Start up '/usr/bin/vi' at current line\r\nctrl-L                  Redraw screen\r\n:n                      Go to kth next file [1]\r\n:p                      Go to kth previous file [1]\r\n:f                      Display current file name and line number\r\n.                       Repeat previous command\r\n-------------------------------------------------------------------------------\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\u0007\r\r\u001b[K\r\n...skipping 1 line\r\n\r"]
