[36.04989, "i", "python - <<'PY'\nfrom pathlib import Path\n\npath = Path('billing/proration.py')\ntext = path.read_text().replace(\n    '    raise NotImplementedError(\"annual-plan proration is not implemented yet (PAY-412, SPEC §3)\")',\n    '''    old, new = get_plan(old_code), get_plan(new_code)\n    if old.interval != \"month\" or new.interval != \"year\":\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\n    if not period.contains(on):\n        raise ProrationError(f\"{on} is outside {period}\")\n    unused = remaining_days(period, on)\n    return ProrationResult(\n        old_plan=old,\n        new_plan=new,\n        on=on,\n        period=period,\n        unused_days=unused,\n        credit=prorate_amount(old.price, unused, period.days),\n        charge=new.price,\n        new_period=annual_period(on),\n    )''')\npath.write_text(text)\n\npath = Path('billing/invoice.py')\ntext = path.read_text().replace('WIDTH = 80', 'WIDTH = 86\\nSAC = \"998314\"')\ntext = text.replace('''    # TODO(PAY-412): upgrade invoices also need the proration credit line (SPEC §3).\n    return list(invoice.lines)''', '''    lines = list(invoice.lines)\n    if invoice.proration is not None:\n        result = invoice.proration\n        lines.append((\n            f\"Proration credit: {result.old_plan.name}, \"\n            f\"{result.unused_days}/{result.period.days} days\",\n            -result.credit,\n        ))\n    return lines''')\ntext = text.replace(\"f\\\"{'Description':<46}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\", \"f\\\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\\\"\")\ntext = text.replace('f\"{line.description[:45]:<46}{money(line.amount):>12}{money(line.gst):>11}\"', 'f\"{line.description[:44]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"')\nfor label, value in [('Subtotal', 'subtotal'), ('GST @ 18%', 'gst'), ('Total due (INR)', 'subtotal + gst')]:\n    text = text.replace(f\"f\\\"{{'{label}':<46}}{{money({value}):>34}}\\\"\", f\"f\\\"{{'{label}':<{{WIDTH - 12}}}}{{money({value}):>12}}\\\"\")\npath.write_text(text)\n\npath = Path('billing/tax.py')\ntext = path.read_text().replace('from decimal import Decimal', 'from decimal import ROUND_HALF_UP, Decimal')\ntext = text.replace('\"\"\"GST for one line, rounded to the paisa.\"\"\"', '\"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"')\ntext = text.replace('.quantize(Decimal(\"1\"))', '.quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP)')\npath.write_text(text)\nPY\n"]
