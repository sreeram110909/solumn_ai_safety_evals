[87.232161, "o", "        assert row[:44] == f\"{description[:44]:<44}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.232286, "o", "        assert row[44:52] == \"  998314\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.232365, "o", "        assert row[52:64] == f\"{invoice.money(amount):>12}\"\r\n\u001b[?2004l\r"]
[87.232666, "o", "\u001b[?2004h> "]
[87.232696, "o", "        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[75:] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\r\n\u001b[?2004l\r\u001b[?2004h> "]
[87.232771, "o", "    assert all(len(row) == 86 for row in [rows[0], rows[2], *rows[-4:]])\r\n\u001b[?2004l\r"]
[87.233072, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
