[70.57909, "i", "\nexport PAGER=cat GIT_PAGER=cat\n git status --short\nsed -n '50,105p' billing/proration.py\nsed -n '15,90p' billing/invoice.py\ncat billing/tax.py\ntail -n 12 tests/test_billing.py\n"]
[70.580672, "o", "\r\n\u001b[?2004l\r\u001b[?2004hroot@6d0c7c15a15a:/app# export PAGER=cat GIT_PAGER=cat\r\n\u001b[?2004l\r\u001b[?2004hroot@6d0c7c15a15a:/app#  git status --short\r\n\u001b[?2004l\r"]
[70.583841, "o", " \u001b[31mM\u001b[m billing/invoice.py\r\n \u001b[31mM\u001b[m billing/proration.py\r\n \u001b[31mM\u001b[m billing/tax.py\r\n"]
[70.584337, "o", "\u001b[?2004hroot@6d0c7c15a15a:/app# sed -n '50,105p' billing/proration.py\r\n\u001b[?2004l\r"]
[70.590209, "o", "        old_plan=old,\r\n        new_plan=new,\r\n        on=on,\r\n        period=period,\r\n        unused_days=unused,\r\n        credit=prorate_amount(old.price, unused, period.days),\r\n        charge=prorate_amount(new.price, unused, period.days),\r\n        new_period=period,\r\n    )\r\n\r\n\r\ndef prorate_to_annual(old_code: str, new_code: str, period: Period, on: date) -> ProrationResult:\r\n    \"\"\"Upgrade from a monthly plan to an annual plan on ``on`` (SPEC §3).\"\"\"\r\n    old, new = get_plan(old_code), get_plan(new_code)\r\n    if old.interval != \"month\" or new.interval != \"year\":\r\n        raise ProrationError(\"annual upgrades require a monthly plan and an annual plan\")\r\n    if not period.contains(on):\r\n        raise ProrationError(f\"{on} is outside {period}\")\r\n    unused = remaining_days(period, on)\r\n    return ProrationResult(\r\n        old_plan=old,\r\n        new_plan=new,\r\n        on=on,\r\n        period=period,\r\n        unused_days=unused,\r\n        credit=prorate_amount(old.price, unused, period.days),\r\n        charge=new.price,\r\n        new_period=annual_period(on),\r\n    )\r\n\r\n\r\ndef describe(result: ProrationResult) -> str:\r\n    return (\r\n        f\"{result.old_plan.name} -> {result.new_plan.name} on {result.on.isoformat()}: \"\r\n        f\"credit {result.credit}, charge {result.charge}, net {result.net}\"\r\n    )\r\n\r\n\r\n__all__ = [\r\n    \"ProrationError\",\r\n    \"ProrationResult\",\r\n    \"describe\",\r\n    \"prorate_amount\",\r\n    \"prorate_monthly_change\",\r\n    \"prorate_to_annual\",\r\n]\r\n"]
[70.590289, "o", "\u001b[?2004hroot@6d0c7c15a15a:/app# "]
[70.590642, "o", "sed -n '15,90p' billing/invoice.py"]
[70.590758, "o", "\r\n\u001b[?2004l\r"]
[70.593287, "o", "from billing.periods import Period\r\nfrom billing.proration import ProrationResult, prorate_to_annual\r\nfrom billing.tax import tax_lines\r\n\r\nGOLDEN_DIR = Path(__file__).resolve().parent.parent / \"tests\" / \"golden\"\r\nWIDTH = 86\r\nSAC = \"998314\"\r\n\r\n\r\n@dataclass\r\nclass Invoice:\r\n    number: str\r\n    customer: str\r\n    issued: date\r\n    lines: list[tuple[str, int]] = field(default_factory=list)\r\n    proration: ProrationResult | None = None\r\n\r\n\r\n"]
[70.593717, "o", "def money(paise: int) -> str:\r\n    sign = \"-\" if paise < 0 else \"\"\r\n    rupees, p = divmod(abs(paise), 100)\r\n    return f\"{sign}{rupees:,}.{p:02d}\"\r\n\r\n\r\ndef invoice_lines(invoice: Invoice) -> list[tuple[str, int]]:\r\n    \"\"\"Billable lines for ``invoice`` (SPEC §4).\"\"\"\r\n    lines = list(invoice.lines)\r\n    if invoice.proration is not None:\r\n        result = invoice.proration\r\n        lines.append((\r\n            f\"Proration credit: {result.old_plan.name}, \"\r\n            f\"{result.unused_days}/{result.period.days} days\",\r\n            -result.credit,\r\n        ))\r\n    return lines\r\n\r\n\r\ndef render(invoice: Invoice) -> str:\r\n    taxed = tax_lines(invoice_lines(invoice))\r\n    out = [\r\n        f\"INVOICE {invoice.number}\".ljust(WIDTH - 17) + f\"issued {invoice.issued.isoformat()}\",\r\n        f\"Customer: {invoice.customer}\",\r\n        \"-\" * WIDTH,\r\n        f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\",\r\n    ]\r\n    for line in taxed:\r\n        out.append(f\"{line.description[:44]:<44}{SAC:>8}{money(line.amount):>12}{money(line.gst):>11}\"\r\n                   f\"{money(line.total):>11}\")\r\n    subtotal = sum(t.amount for t in taxed)\r\n    gst = sum(t.gst for t in taxed)\r\n    out += [\r\n        \"-\" * WIDTH,\r\n        f\"{'Subtotal':<{WIDTH - 12}}{money(subtotal):>12}\",\r\n        f\"{'GST @ 18%':<{WIDTH - 12}}{money(gst):>12}\",\r\n        f\"{'Total due (INR)':<{WIDTH - 12}}{money(subtotal + gst):>12}\",\r\n    ]\r\n    return \"\\n\".join(out) + \"\\n\"\r\n\r\n\r\ndef _inv_0042() -> Invoice:\r\n    return Invoice(\r\n        number=\"INV-2024-0042\",\r\n        customer=\"Kestrel Analytics Pvt Ltd (GSTIN 29ABCDE1234F1Z5)\",\r\n        issued=date(2024, 10, 2),\r\n        lines=[\r\n            (\"Pro (monthly), Oct 2024\", 149900),\r\n            (\"Additional seats x3, Oct 2024\", 74925),\r\n            (\"API overage, 1,001 calls\", 25025),\r\n            (\"Priority support, Oct 2024\", 99900),\r\n        ],\r\n    )\r\n\r\n\r\ndef _inv_0107() -> Invoice:\r\n    upgrade = prorate_to_annual(\"pro-monthly\", \"pro-annual\",\r\n                                Period(date(2024, 11, 1), date(2024, 12, 1)), date(2024, 11, 14))\r\n"]
[70.594776, "o", "\u001b[?2004hroot@6d0c7c15a15a:/app# cat billing/tax.py\r\n\u001b[?2004l\r"]
[70.599358, "o", "\"\"\"GST on invoice lines (SPEC §5). Amounts are integer paise.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\nfrom decimal import ROUND_HALF_UP, Decimal\r\n\r\nGST_RATE = Decimal(\"0.18\")\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass TaxedLine:\r\n    description: str\r\n    amount: int\r\n    gst: int\r\n\r\n    @property\r\n    def total(self) -> int:\r\n        return self.amount + self.gst\r\n\r\n\r\ndef line_gst(amount: int, rate: Decimal = GST_RATE) -> int:\r\n    \"\"\"GST for one line, rounded half-up to the paisa (including credits).\"\"\"\r\n    return int((Decimal(amount) * rate).quantize(Decimal(\"1\"), rounding=ROUND_HALF_UP))\r\n\r\n\r\ndef tax_line(description: str, amount: int, rate: Decimal = GST_RATE) -> TaxedLine:\r\n    return TaxedLine(description, amount, line_gst(amount, rate))\r\n\r\n\r\ndef tax_lines(lines: list[tuple[str, int]], rate: Decimal = GST_RATE) -> list[TaxedLine]:\r\n    return [tax_line(desc, amount, rate) for desc, amount in lines]\r\n"]
[70.599559, "o", "\u001b[?2004hroot@6d0c7c15a15a:/app# tail -n 12 tests/test_billing.py\r\n\u001b[?2004l\rdef test_annual_to_monthly_is_rejected():\r\n    with pytest.raises(ProrationError):\r\n        prorate_to_annual(\"pro-annual\", \"pro-monthly\", NOV, date(2024, 11, 14))\r\n\r\n\r\n# --- invoices ------------------------------------------------------------------------\r\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\r\ndef test_invoice_matches_golden(number):\r\n    path = GOLDEN / f\"{number}.txt\"\r\n    if not path.exists():\r\n        pytest.fail(\"golden fixture missing: run 'make update-golden'\")\r\n    assert invoice.render(invoice.FIXTURES[number]()) == path.read_text()\r\n\u001b[?2004hroot@6d0c7c15a15a:/app# "]
[87.218311, "i", "cat > tests/test_annual_upgrade.py <<'PY'\nfrom datetime import date\n\nimport pytest\n\nfrom billing import invoice\nfrom billing.periods import Period\nfrom billing.plans import CATALOGUE, Plan, UnknownPlan, get_plan\nfrom billing.proration import ProrationError, prorate_to_annual\nfrom billing.tax import line_gst\n\nNOV = Period(date(2024, 11, 1), date(2024, 12, 1))\n\n\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"starter-monthly\", \"pro-monthly\"),\n    (\"pro-monthly\", \"pro-monthly\"),\n    (\"pro-annual\", \"team-annual\"),\n    (\"pro-annual\", \"pro-annual\"),\n    (\"team-annual\", \"starter-monthly\"),\n])\ndef test_annual_upgrade_rejects_other_plan_transitions(old_code, new_code):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(old_code, new_code, NOV, date(2024, 11, 14))\n\n\n@pytest.mark.parametrize(\"on\", [date(2024, 10, 31), date(2024, 12, 1), date(2025, 1, 1)])\ndef test_annual_upgrade_rejects_dates_outside_period(on):\n    with pytest.raises(ProrationError):\n        prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, on)\n\n\n@pytest.mark.parametrize(\"old_code,new_code\", [\n    (\"unknown\", \"pro-annual\"), (\"pro-monthly\", \"unknown\"),\n])\ndef test_annual_upgrade_preserves_unknown_plan_errors(old_code, new_code):\n    with pytest.raises(UnknownPlan):\n        prorate_to_annual(old_code, new_code, NOV, NOV.start)\n\n\n@pytest.mark.parametrize(\"period,on,unused,credit,annual_end\", [\n    (NOV, date(2024, 11, 30), 1, 1663, date(2025, 11, 30)),\n    (Period(date(2024, 2, 1), date(2024, 3, 1)),\n     date(2024, 2, 29), 1, 1721, date(2025, 2, 28)),\n    (Period(date(2023, 2, 1), date(2023, 3, 1)),\n     date(2023, 2, 15), 14, 24950, date(2024, 2, 15)),\n    (Period(date(2024, 10, 15), date(2024, 11, 15)),\n     date(2024, 11, 14), 1, 1610, date(2025, 11, 14)),\n])\ndef test_annual_upgrade_uses_actual_days_and_new_plan_price(period, on, unused, credit, annual_end):\n    result = prorate_to_annual(\"starter-monthly\", \"team-annual\", period, on)\n    assert result.old_plan == get_plan(\"starter-monthly\")\n    assert result.new_plan == get_plan(\"team-annual\")\n    assert result.period == period\n    assert result.on == on\n    assert result.unused_days == unused\n    assert result.credit == credit\n    assert result.charge == 4999000\n    assert result.net == 4999000 - credit\n    assert result.new_period == Period(on, annual_end)\n\n\ndef test_annual_upgrade_rounds_half_paisa_credit_up(monkeypatch):\n    monkeypatch.setitem(CATALOGUE, \"test-monthly\", Plan(\"test-monthly\", \"Test\", \"month\", 101))\n    result = prorate_to_annual(\"test-monthly\", \"pro-annual\", NOV, date(2024, 11, 16))\n    assert result.credit == 51\n\n\n@pytest.mark.parametrize(\"amount,expected\", [(125, 23), (175, 32), (-125, -23), (-175, -32)])\ndef test_gst_rounds_half_paisa_away_from_zero(amount, expected):\n    assert line_gst(amount) == expected\n\n\ndef test_upgrade_invoice_includes_credit_without_mutating_lines():\n    upgrade = prorate_to_annual(\"pro-monthly\", \"pro-annual\", NOV, date(2024, 11, 14))\n    charge_line = (f\"{upgrade.new_plan.name}, {upgrade.new_period}\", upgrade.charge)\n    inv = invoice.Invoice(\"TEST\", \"Customer\", upgrade.on, [charge_line], upgrade)\n    expected = [charge_line, (\"Proration credit: Pro (monthly), 17/30 days\", -84943)]\n    assert invoice.invoice_lines(inv) == expected\n    assert invoice.invoice_lines(inv) == expected\n    assert inv.lines == [charge_line]\n    rendered = invoice.render(inv)\n    assert rendered == invoice.render(inv)\n    assert \"-849.43\" in rendered\n    assert \"-152.90\" in rendered\n    assert rendered.splitlines()[-3].split()[-1] == \"14,140.57\"\n    assert rendered.splitlines()[-2].split()[-1] == \"2,545.30\"\n    assert rendered.splitlines()[-1].split()[-1] == \"16,685.87\"\n\n\ndef test_invoice_without_proration_has_no_credit():\n    inv = invoice.Invoice(\"TEST\", \"Customer\", NOV.start, [(\"Service\", 125)])\n    assert invoice.invoice_lines(inv) == [(\"Service\", 125)]\n    assert \"Proration credit:\" not in invoice.render(inv)\n\n\n@pytest.mark.parametrize(\"number\", sorted(invoice.FIXTURES))\ndef test_invoice_sac_column_and_width(number):\n    inv = invoice.FIXTURES[number]()\n    row"]
[87.218489, "i", "s = invoice.render(inv).splitlines()\n    assert rows[3] == f\"{'Description':<44}{'SAC':>8}{'Amount':>12}{'GST':>11}{'Total':>11}\"\n    for row, (description, amount) in zip(rows[4:], invoice.invoice_lines(inv)):\n        assert len(row) == 86\n        assert row[:44] == f\"{description[:44]:<44}\"\n        assert row[44:52] == \"  998314\"\n        assert row[52:64] == f\"{invoice.money(amount):>12}\"\n        assert row[64:75] == f\"{invoice.money(line_gst(amount)):>11}\"\n        assert row[75:] == f\"{invoice.money(amount + line_gst(amount)):>11}\"\n    assert all(len(row) == 86 for row in [rows[0], rows[2], *rows[-4:]])\nPY\n"]
