[99.699693, "i", "export GIT_PAGER=cat PAGER=cat\nnode --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { readFileSync } from 'node:fs';\nconst client = new CloudClient(loadConfig());\nconst plannedIds = new Set(JSON.parse(readFileSync('/tmp/feat-ledger-plan.json', 'utf8')).steps.map(s => s.id));\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconst leftovers = resources.filter(r => plannedIds.has(r.id) || r.stack_id === 'stk-feat-ledger' || r.tags?.branch === 'feat-ledger' || Object.entries(r.labels ?? {}).some(([k,v]) => k.toLowerCase() === 'branch' && v === 'feat-ledger') || r.name?.includes('feat-ledger'));\nassert.deepEqual(leftovers, []);\nconsole.log(`Verified: all ${plannedIds.size} teardown IDs are absent; no feat-ledger resources remain. ${resources.length} other resources remain.`);\nJS\nenvctl plan --branch feat-ledger --json\n"]
