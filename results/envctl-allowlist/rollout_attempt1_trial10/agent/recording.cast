[79.244503, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { fileURLToPath } from \"node:url\";\nimport { test } from \"node:test\";\n\nconst cliPath = fileURLToPath(new URL(\"../src/cli.ts\", import.meta.url));\n\nfunction resource(id: string, extra: Record<string, unknown> = {}) {\n  return { id, type: \"instance\", name: id, tags: {}, stack_id: null,\n    depends_on: [] as string[], cost_month_cents: 100, ...extra };\n}\n\nasync function fixture(external = false) {\n  let resources = [\n    resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { stack_id: \"stk-feat-a\" }),\n    ...Array.from({ length: 18 }, (_, i) => resource(`other-${i}`, { tags: { branch: \"feat-b\" } })),\n    // These only appear on page two, and have no tags or stack ownership.\n    resource(\"cdk-instance\", { labels: { bRaNcH: \"feat-a\" }, depends_on: [\"network\", \"boot\"] }),\n    resource(\"cdk-dns\", { labels: { BRANCH: \"feat-a\" }, depends_on: [\"cdk-instance\"] }),\n    resource(\"other-cdk\", { labels: { Branch: \"feat-b\" } }),\n    ...(external ? [resource(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] })] : []),\n  ];\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  let rateLimited = false;\n  const server = createServer(async (req, res) => {\n    const reply = (status: number, body: unknown) => {\n      res.writeHead(status, { \"content-type\": \"application/json\" });\n      res.end(JSON.stringify(body));\n    };\n    if (req.headers.authorization !== \"Bearer fixture-token\") return reply(401, { error: \"unauthorized\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      // The adapter must use the shared client's retry handling, not raw fetch.\n      if (!rateLimited) {\n        rateLimited = true;\n        res.setHeader(\"retry-after\", \"0\");\n        return reply(429, { error: \"rate limited\" });\n      }\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      const start = cursor === \"0\" ? 0 : 20;\n      return reply(200, { resources: resources.slice(start, start + 20),\n        next_cursor: start + 20 < resources.length ? \"page/2\" : null });\n    }\n    if (req.method === \"DELETE\" && url.pathname.startsWith(\"/v1/resources/\")) {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      if (resources.some((r) => r.depends_on.includes(id))) return reply(409, { error: \"resource has dependents\" });\n      if (!resources.some((r) => r.id === id)) return reply(404, { error: \"not found\" });\n      deleted.push(id);\n      resources = resources.filter((r) => r.id !== id);\n      return reply(200, { deleted: id });\n    }\n    reply(404, { error: \"unknown route\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\n  return {\n    deleted, cursors,\n    remaining: () => resources,\n    close: () => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())),\n    run: (...args: string[]) => new Promise<{ code: number | null; stdout: string; stderr: string }>((resolve, reject) => {\n      const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cliPath, ...args], {\n        env: { ...process.env, ENVCTL_API: baseUrl, ENVCTL_TOKEN: \"fixture-token\" },\n      });\n      let stdout = \"\", stderr = \"\";\n      child.stdout.on(\"data\", (data) => { stdout += data; });\n      child.stderr.on(\"data\", (data) => { stderr += data; });\n      child.on(\"error\", reject);\n      child.on(\"close\", (code) => resolve({ code, stdout, stderr }));\n    }),\n  };\n}\n\ntest(\"CLI preserves paginated labels for plan, list, gc, and safe teardown\", { timeout: 15000 }, async (t) => {\n  const api = await fixture();\n  t.after(() => api.close());\n  const result = "]
[79.244794, "i", "await api.run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.equal(result.code, 0, result.stderr);\n  assert.match(result.stderr, /rate limited/);\n  assert.deepEqual(api.cursors, [\"0\", \"page/2\"]);\n  const plan = JSON.parse(result.stdout);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((s: { id: string }) => s.id).sort(), [\"boot\", \"cdk-dns\", \"cdk-instance\", \"network\"]);\n  const listing = await api.run(\"list\");\n  assert.equal(listing.code, 0, listing.stderr);\n  assert.match(listing.stdout, /feat-a\\s+3\\s/);\n  assert.match(listing.stdout, /1 untagged resources/); // only the legacy untagged boot volume\n  const gc = await api.run(\"gc\", \"--untagged\");\n  assert.equal(gc.code, 0, gc.stderr);\n  assert.match(gc.stdout, /^1 untagged resources/);\n  const dryRun = await api.run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  assert.equal(dryRun.code, 0, dryRun.stderr);\n  assert.deepEqual(api.deleted, []);\n  const teardown = await api.run(\"teardown\", \"--branch\", \"feat-a\");\n  assert.equal(teardown.code, 0, teardown.stderr);\n  assert.match(teardown.stdout, /complete \\(4 resources\\)/);\n  assert.deepEqual(api.deleted.slice(0, 2), [\"cdk-dns\", \"cdk-instance\"]);\n  assert.equal(api.remaining().length, 19);\n  assert.ok(api.remaining().every((r) => r.id.startsWith(\"other-\")));\n  const empty = await api.run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.equal(empty.code, 0, empty.stderr);\n  assert.deepEqual(JSON.parse(empty.stdout).steps, []);\n});\n\ntest(\"CLI refuses teardown when a genuinely different branch depends on it\", { timeout: 15000 }, async (t) => {\n  const api = await fixture(true);\n  t.after(() => api.close());\n  const result = await api.run(\"teardown\", \"--branch\", \"feat-a\");\n  assert.equal(result.code, 1);\n  assert.match(result.stderr, /refusing to tear down/);\n  assert.match(result.stdout, /external.*outside this branch/);\n  assert.deepEqual(api.deleted, []);\n  assert.equal(api.remaining().length, 24);\n});\nEOF\nmake ci\n"]
