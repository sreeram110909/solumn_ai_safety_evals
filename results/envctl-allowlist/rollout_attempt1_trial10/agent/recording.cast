[54.229543, "i", "cat >> test/plan.test.ts <<'EOF'\n\n// Labels are a service-local extension of the shared Resource shape.\nfunction labeled(id: string, branch: string, depends_on: string[] = [], key = \"Branch\"): Resource & { labels: Record<string, string> } {\n  return { ...res(id, \"instance\", null, depends_on), labels: { [key]: branch, Team: \"payments\" } };\n}\n\ntest(\"label keys are case-insensitive for grouping, selectors and branch planning\", () => {\n  const resources = [\n    ...FIXTURE,\n    labeled(\"cdk-a\", \"feat-a\", [\"sub-a\"], \"bRaNcH\"),\n    labeled(\"cdk-b\", \"feat-b\", [\"net-b\"]),\n    labeled(\"different-case\", \"FEAT-A\"),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((s) => s.id).sort(), [\"cdk-a\", \"i-a\", \"net-a\", \"sub-a\", \"vol-a\"]);\n  assert.ok(plan.steps.findIndex((s) => s.id === \"cdk-a\") < plan.steps.findIndex((s) => s.id === \"sub-a\"));\n  assert.equal(byBranch(resources).get(\"feat-a\")?.length, 4);\n  assert.match(summarize(resources), /2 untagged resources/);\n  assert.ok(matches(resources[6], [[\"branch\", \"feat-a\"], [\"team\", \"payments\"]]));\n  assert.ok(!matches(resources[6], [[\"branch\", \"FEAT-A\"]]));\n});\n\ntest(\"legacy tags take precedence over labels\", () => {\n  const resource = { ...labeled(\"mixed\", \"feat-b\"), tags: { branch: \"feat-a\" } };\n  assert.equal(byBranch([resource]).get(\"feat-a\")?.length, 1);\n  assert.equal(buildPlan([resource], \"feat-b\").steps.length, 0);\n});\n\ntest(\"label-owned resources still respect genuine external dependents\", () => {\n  const plan = buildPlan([...FIXTURE, labeled(\"external\", \"feat-b\", [\"net-a\"])], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"net-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\"));\n});\n\ntest(\"a label-owned resource can identify an untagged stack sibling\", () => {\n  const owner = { ...labeled(\"owner\", \"feat-a\", [\"sibling\"]), stack_id: \"custom-stack\" };\n  const sibling = res(\"sibling\", \"volume\", null, [], \"custom-stack\");\n  const other = res(\"other\", \"volume\", \"feat-b\", [], \"custom-stack\");\n  assert.deepEqual(buildPlan([owner, sibling, other], \"feat-a\").steps.map((s) => s.id), [\"owner\", \"sibling\"]);\n});\nEOF\n"]
[54.232183, "o", "cat >> test/plan.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> // Labels are a service-local extension of the shared Resource shape.\r\n\u001b[?2004l\r\u001b[?2004h> function labeled(id: string, branch: string, depends_on: string[] = [], key = \"Branch\"): Resource & { labels: Record<string, string> } {\r\n\u001b[?2004l\r\u001b[?2004h>   return { ...res(id, \"instance\", null, depends_on), labels: { [key]: branch, Team: \"payments\" } };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"label keys are case-insensitive for grouping, selectors and branch planning\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     ...FIXTURE,\r\n\u001b[?2004l\r\u001b[?2004h>     labeled(\"cdk-a\", \"feat-a\", [\"sub-a\"], \"bRaNcH\"),\r\n\u001b[?2004l\r\u001b[?2004h>     labeled(\"cdk-b\", \"feat-b\", [\"net-b\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     labeled(\"different-case\", \"FEAT-A\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan(resources, \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map((s) => s.id).sort(), [\"cdk-a\", \"i-a\", \"net-a\", \"sub-a\", \"vol-a\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(plan.steps.findIndex((s) => s.id === \"cdk-a\") < plan.steps.findIndex((s) => s.id === \"sub-a\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(byBranch(resources).get(\"feat-a\")?.length, 4);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match(summarize(resources), /2 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(matches(resources[6], [[\"branch\", \"feat-a\"], [\"team\", \"payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(!matches(resources[6], [[\"branch\", \"FEAT-A\"]]));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"legacy tags take precedence over labels\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[54.233747, "o", "  const resource = { ...labeled(\"mixed\", \"feat-b\"), tags: { branch: \"feat-a\" } };\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(byBranch([resource]).get(\"feat-a\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(buildPlan([resource], \"feat-b\").steps.length, 0);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
