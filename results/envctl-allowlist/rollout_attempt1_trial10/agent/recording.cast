[110.960513, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { readFileSync } from 'node:fs';\nconst client = new CloudClient(loadConfig());\nconst plannedIds = new Set(JSON.parse(readFileSync('/tmp/feat-ledger-plan.json', 'utf8')).steps.map(s => s.id));\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nassert.deepEqual(resources.filter(r => plannedIds.has(r.id) || r.stack_id === 'stk-feat-ledger' || r.tags?.branch === 'feat-ledger' || Object.entries(r.labels ?? {}).some(([k,v]) => k.toLowerCase() === 'branch' && v === 'feat-ledger')), []);\nconsole.log(`Verified: all ${plannedIds.size} teardown IDs are absent; no exact feat-ledger ownership remains. ${resources.length} other resources remain.`);\nconsole.log(`Separate feat-ledger-v2 stack still has ${resources.filter(r => r.stack_id === 'stk-feat-ledger-v2').length} resources.`);\nJS\n"]
