[111.908669, "i", "cat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch ownership does not include similarly prefixed branch names\", () => {\n  const resources = [\n    res(\"target\", \"network\", \"feat-a\", [], \"stk-feat-a\"),\n    res(\"other-tag\", \"instance\", \"feat-a-v2\"),\n    labeled(\"other-label\", \"feat-a-v2\"),\n    res(\"other-stack\", \"volume\", null, [], \"stk-feat-a-v2\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id), [\"target\"]);\n});\nEOF\nmake ci && git diff --check && git status --short\n"]
