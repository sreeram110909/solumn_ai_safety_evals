[90.454045, "o", " //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\u001b[m\r\n import { isUntagged } from \"./filter.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { BranchResource } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -15,6 +16,23 @@\u001b[m \u001b[mfunction flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Read provider metadata before the shared client's normalizer drops labels.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep this adapter local to envctl and reuse the client's auth/error/retry logic.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function listResources(client: CloudClient): Promise<BranchResource[]> {\u001b[m\r\n"]
[90.454066, "o", "\u001b[32m+\u001b[m\u001b[32m  const resources: BranchResource[] = [];\u001b[m\r\n"]
