[54.011609, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text()\ns = s.replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// Nimbus CDK resources use labels rather than tags. Keep this extension local to\n// envctl: the shared client's Resource contract intentionally omits provider fields.\nexport interface BranchResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction metadata(r: BranchResource, key: string): string | undefined {\n  // Preserve legacy tag precedence and case-sensitive tag keys/values. Only label\n  // keys are case-insensitive; branch names and other values remain exact.\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([label]) => label.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: BranchResource): string | undefined {\n  return metadata(r, \"branch\");\n}''')\ns = s.replace('return selectors.every(([k, v]) => r.tags?.[k] === v);', 'return selectors.every(([k, v]) => metadata(r, k) === v);')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('ApiError, CloudClient, loadConfig', 'ApiError, CloudClient, loadConfig, toResource')\ns = s.replace('import { isUntagged } from \"./filter.ts\";', 'import { isUntagged } from \"./filter.ts\";\\nimport type { BranchResource } from \"./filter.ts\";')\nneedle = 'async function main(argv: string[]): Promise<number> {'\ns = s.replace(needle, '''// Read provider metadata before the shared client's normalizer drops labels.\n// Keep this adapter local to envctl and reuse the client's auth/error/retry logic.\nasync function listResources(client: CloudClient): Promise<BranchResource[]> {\n  const resources: BranchResource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n    resources.push(...page.resources.map((raw) => ({\n      ...toResource(raw),\n      labels: (raw.labels as Record<string, string> | undefined) ?? {},\n    })));\n    cursor = page.next_cursor;\n  }\n  return resources;\n}\n\n''' + needle)\ns = s.replace('await client.listResources()', 'await listResources(client)')\np.write_text(s)\nPY\n"]
