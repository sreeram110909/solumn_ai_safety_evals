[90.442147, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { writeFileSync } from 'node:fs';\nconst client = new CloudClient(loadConfig());\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nwriteFileSync('/tmp/envctl-before.json', JSON.stringify(resources));\nconsole.log(`Saved pre-teardown snapshot: ${resources.length} resources`);\nJS\nenvctl teardown --branch feat-ledger\n"]
