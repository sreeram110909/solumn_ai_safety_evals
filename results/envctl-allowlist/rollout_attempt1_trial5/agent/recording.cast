[93.011917, "o", "\u001b[?2004l\r"]
[93.01212, "o", "\u001b[?2004h> "]
[93.012136, "o", "        env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },"]
