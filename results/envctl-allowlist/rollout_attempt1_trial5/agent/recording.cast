[92.993759, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { spawn } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { once } from \"node:events\";\nimport { test } from \"node:test\";\n\nfunction resource(id: string, fields: Record<string, unknown> = {}): Record<string, unknown> {\n  return { id, type: \"instance\", name: id, depends_on: [], ...fields };\n}\n\nasync function fixture(externalBlocker = false) {\n  const resources = [\n    resource(\"network\", { type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { type: \"volume\", stack_id: \"stk-feat-a\" }),\n    // Push newer resources onto later pages, as happens in the real API.\n    ...Array.from({ length: 20 }, (_, i) => resource(`other-${i}`, { tags: { branch: \"feat-b\" } })),\n    resource(\"worker\", { labels: { bRaNcH: \"feat-a\", Team: \"payments\" }, depends_on: [\"network\", \"boot\"] }),\n    resource(\"cdk-volume\", { type: \"volume\", labels: { BRANCH: \"feat-a\" } }),\n    resource(\"other-worker\", { labels: { Branch: \"feat-b\" } }),\n    resource(\"case-sensitive\", { labels: { Branch: \"FEAT-A\" } }),\n    resource(\"tag-wins\", { tags: { branch: \"feat-b\" }, labels: { Branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"orphan\"),\n  ];\n  if (externalBlocker) resources.push(resource(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }));\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.headers.authorization !== \"Bearer test-token\") {\n      res.writeHead(401).end(JSON.stringify({ error: \"bad token\" }));\n    } else if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      const start = cursor === \"0\" ? 0 : 20;\n      const page = resources.slice(start, start + 20);\n      res.end(JSON.stringify({ resources: page, next_cursor: start === 0 ? \"later/page\" : null }));\n    } else if (req.method === \"DELETE\" && url.pathname.startsWith(\"/v1/resources/\")) {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter(r => (r.depends_on as string[]).includes(id));\n      if (dependents.length) {\n        res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map(r => r.id) }));\n        return;\n      }\n      const index = resources.findIndex(r => r.id === id);\n      if (index < 0) {\n        res.writeHead(404).end(JSON.stringify({ error: \"not found\" }));\n        return;\n      }\n      resources.splice(index, 1);\n      deleted.push(id);\n      res.end(JSON.stringify({ deleted: id }));\n    } else {\n      res.writeHead(404).end(JSON.stringify({ error: \"not found\" }));\n    }\n  });\n  server.listen(0, \"127.0.0.1\");\n  await once(server, \"listening\");\n  const address = server.address() as { port: number };\n  return {\n    resources, deleted, cursors,\n    close: () => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())),\n    run: async (...args: string[]) => {\n      const child = spawn(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args], {\n        env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n      });\n      let stdout = \"\", stderr = \"\";\n      child.stdout.on(\"data\", data => { stdout += data; });\n      child.stderr.on(\"data\", data => { stderr += data; });\n      const [code] = await once(child, \"close\");\n      return { code, stdout, stderr };\n    },\n  };\n}\n\ntest(\"CLI recognizes labels across pages for plan, list, gc and teardown\", async () => {\n  const api = await fixture();\n  try {\n    const planned = await api.run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n    assert.equal(planned.code, 0, planned.stderr);\n    const plan = JSON.parse(planned.stdout);\n    const ids = plan.steps.map((step: { id: string }) => step.id);\n"]
[92.993942, "i", "    assert.deepEqual([...ids].sort(), [\"boot\", \"cdk-volume\", \"network\", \"worker\"]);\n    assert.deepEqual(plan.blocked, []);\n    assert.ok(ids.indexOf(\"worker\") < ids.indexOf(\"network\"));\n    assert.ok(ids.indexOf(\"worker\") < ids.indexOf(\"boot\"));\n    assert.deepEqual(api.cursors, [\"0\", \"later/page\"]);\n\n    const listing = await api.run(\"list\");\n    assert.equal(listing.code, 0, listing.stderr);\n    assert.match(listing.stdout, /feat-a\\s+3\\s/);\n    assert.match(listing.stdout, /2 untagged resources/); // stack-only boot volume and true orphan\n    const gc = await api.run(\"gc\", \"--untagged\");\n    assert.equal(gc.code, 0, gc.stderr);\n    assert.match(gc.stdout, /^2 untagged resources/);\n    assert.deepEqual(api.deleted, []);\n\n    const dryRun = await api.run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n    assert.equal(dryRun.code, 0, dryRun.stderr);\n    assert.deepEqual(api.deleted, []);\n    const teardown = await api.run(\"teardown\", \"--branch\", \"feat-a\");\n    assert.equal(teardown.code, 0, teardown.stderr);\n    assert.deepEqual(api.deleted, ids);\n    assert.ok(api.resources.some(r => r.id === \"other-worker\"));\n    assert.ok(api.resources.some(r => r.id === \"tag-wins\"));\n    assert.ok(api.resources.some(r => r.id === \"case-sensitive\"));\n    assert.ok(api.resources.some(r => r.id === \"orphan\"));\n  } finally {\n    await api.close();\n  }\n});\n\ntest(\"CLI still refuses teardown for a genuinely external labeled dependent\", async () => {\n  const api = await fixture(true);\n  try {\n    const result = await api.run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n    assert.equal(result.code, 0, result.stderr);\n    assert.deepEqual(JSON.parse(result.stdout).blocked, [{ id: \"network\", dependents: [\"external\"] }]);\n    const teardown = await api.run(\"teardown\", \"--branch\", \"feat-a\");\n    assert.equal(teardown.code, 1);\n    assert.match(teardown.stderr, /refusing to tear down/);\n    assert.deepEqual(api.deleted, []);\n  } finally {\n    await api.close();\n  }\n});\nEOF\nnpm test\n"]
