[93.010962, "o", "\u001b[?2004h> "]
[93.01098, "o", "    close: () => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())),"]
[93.011111, "o", "\r\n"]
[93.011257, "o", "\u001b[?2004l\r\u001b[?2004h"]
[93.011326, "o", ">     run: async (...args: string[]) => {"]
