[93.324244, "o", "\r\n> envctl@1.3.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n\u001b[1G\u001b[0K"]
[93.674455, "o", "\u001b[31m✖ CLI recognizes labels across pages for plan, list, gc and teardown \u001b[90m(166.656345ms)\u001b[39m\u001b[39m\r\n"]
[93.848502, "o", "\u001b[31m✖ CLI still refuses teardown for a genuinely external labeled dependent \u001b[90m(171.05063ms)\u001b[39m\u001b[39m\r\n"]
[93.86695, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.603955ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.231037ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.560009ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.433633ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.365898ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 7\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 5\u001b[39m\r\n\u001b[34mℹ fail 2\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 499.627573\u001b[39m\r\n\r\n\u001b[31m✖ failing tests:\u001b[39m\r\n\r\ntest at test/labels.test.ts:76:1\r\n\u001b[31m✖ CLI recognizes labels across pages for plan, list, gc and teardown \u001b[90m(166.656345ms)\u001b[39m\u001b[39m\r\n  AssertionError [ERR_ASSERTION]: Expected values to be strictly deep-equal:\r\n  \u001b[32m+ actual\u001b[39m \u001b[31m- expected\u001b[39m\r\n  \r\n  \u001b[39m  [\r\n  \u001b[39m    'boot',\r\n  \u001b[31m-\u001b[39m   'cdk-volume',\r\n  \u001b[39m    'network',\r\n  \u001b[31m-\u001b[39m   'worker'\r\n  \u001b[39m  ]\r\n  \r\n      at TestContext.<anonymous> \u001b[90m(file:///app/\u001b[39mtest/labels.test.ts:83:12\u001b[90m)\u001b[39m\r\n  \u001b[90m    at process.processTicksAndRejections (node:internal/process/task_queues:103:5)\u001b[39m\r\n  \u001b[90m    at async Test.run (node:internal/test_runner/test:1054:7)\u001b[39m\r\n  \u001b[90m    at async startSubtestAfterBootstrap (node:internal/test_runner/harness:296:3)\u001b[39m {\r\n    generatedMessage: \u001b[33mtrue\u001b[39m,\r\n    code: \u001b[32m'ERR_ASSERTION'\u001b[39m,\r\n    actual: [ \u001b[32m'boot'\u001b[39m, \u001b[32m'network'\u001b[39m ],\r\n    expected: [ \u001b[32m'boot'\u001b[39m, \u001