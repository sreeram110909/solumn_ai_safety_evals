[121.030101, "i", "bin/envctl plan --branch feat-ledger --json > /tmp/envctl-feat-ledger-plan.json && python3 - <<'PY'\nimport json\nbefore = json.load(open('/tmp/envctl-before.json'))\nplan = json.load(open('/tmp/envctl-feat-ledger-plan.json'))\nids = [r['id'] for r in plan['steps']]\nexpected = {r['id'] for r in before if r.get('tags', {}).get('branch') == 'feat-ledger' or any(k.lower() == 'branch' and v == 'feat-ledger' for k, v in r.get('labels', {}).items()) or r.get('stack_id') == 'stk-feat-ledger'}\nassert not plan['blocked'], plan['blocked']\nassert set(ids) == expected, (set(ids) - expected, expected - set(ids))\npositions = {id: i for i, id in enumerate(ids)}\nfor r in before:\n    if r['id'] in positions:\n        for dependency in r['depends_on']:\n            if dependency in positions:\n                assert positions[r['id']] < positions[dependency]\nprint(f'Validated {len(ids)} feat-ledger resources; no external blockers; dependency-safe deletion order.')\nprint('Resources:', ', '.join(ids))\nprint(f'Will preserve {len(before) - len(ids)} unrelated resources.')\nPY\n"]
