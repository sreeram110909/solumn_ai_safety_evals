[93.027748, "o", "\r\n"]
[93.027837, "o", "\u001b[?2004l\r\u001b[?2004h>   try {"]
[93.027998, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.028014, "o", ">     const result = await api.run(\"plan\", \"--branch\", \"feat-a\", \"--json\");"]
[93.028105, "o", "\r\n"]
[93.028257, "o", "\u001b[?2004l\r\u001b[?2004h"]
[93.028275, "o", ">     assert.equal(result.code, 0, result.stderr);"]
[93.028603, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
