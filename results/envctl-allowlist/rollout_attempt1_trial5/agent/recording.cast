[93.027229, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[93.02725, "o", "\u001b[?2004h> test(\"CLI still refuses teardown for a genuinely external labeled dependent\", async () => {"]
