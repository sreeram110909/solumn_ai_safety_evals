[93.025139, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[93.025321, "o", "    assert.ok(api.resources.some(r => r.id === \"other-worker\"));"]
[93.025437, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
