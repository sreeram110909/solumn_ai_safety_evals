[93.017056, "o", "\u001b[?2004h> "]
[93.017085, "o", "    assert.equal(planned.code, 0, planned.stderr);"]
[93.017235, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.017313, "o", "> "]
[93.017374, "o", "    const plan = JSON.parse(planned.stdout);"]
[93.01761, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.017815, "o", "> "]
[93.01791, "o", "    const ids = plan.steps.map((step: { id: string }) => step.id);"]
[93.018056, "o", "\r\n"]
[93.018326, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[93.018507, "o", "    assert.deepEqual([...ids].sort(), [\"boot\", \"cdk-volume\", \"network\", \"worker\"]);"]
[93.018698, "o", "\r\n\u001b[?2004l\r"]
[93.018802, "o", "\u001b[?2004h"]
[93.019013, "o", "> "]
[93.01926, "o", "    assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.019302, "o", "> "]
[93.019492, "o", "    assert.ok(ids.indexOf(\"worker\") < ids.indexOf(\"network\"));\r\n"]
[93.020026, "o", "\u001b[?2004l\r\u001b[?2004h"]
[93.020105, "o", ">     assert.ok(ids.indexOf(\"worker\") < ids.indexOf(\"boot\"));"]
[93.020395, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.020611, "o", "> "]
[93.020805, "o", "    assert.deepEqual(api.cursors, [\"0\", \"later/page\"]);"]
[93.021035, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[93.021078, "o", "> "]
[93.021387, "o", "    const listing = await api.run(\"list\");"]
[93.021476, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(listing.code, 0, listing.stderr);"]
[93.021657, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.021674, "o", ">     assert.match(listing.stdout, /feat-a\\s+3\\s/);"]
