[32.65948, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { writeFileSync } from 'node:fs';\nconst client = new CloudClient(loadConfig());\nconst all = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  all.push(...page.resources);\n  cursor = page.next_cursor;\n}\nwriteFileSync('/tmp/envctl-before.json', JSON.stringify(all, null, 2));\nconsole.log('Total resources:', all.length);\nconsole.log(JSON.stringify(all.filter(r => r.labels || ['i-fl6','i-fl7','dns-fl2'].includes(r.id)), null, 2));\nJS\n"]
