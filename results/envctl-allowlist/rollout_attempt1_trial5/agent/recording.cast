[105.12096, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text().replace('import type { Resource } from \"./api.ts\";', '''import { toResource } from \"./api.ts\";\nimport type { Resource } from \"./api.ts\";\n\n// envctl's metadata view includes nimbus-cdk labels. Do this before the shared\n// client's stable Resource normalizer drops provider-specific fields. Only label\n// keys are case-insensitive; values and legacy tag semantics stay unchanged.\nexport function normalizeResource(raw: Record<string, unknown>): Resource {\n  const labels = Object.fromEntries(\n    Object.entries((raw.labels as Record<string, string> | null | undefined) ?? {})\n      .map(([key, value]) => [key.toLowerCase(), value]),\n  );\n  return toResource({\n    ...raw,\n    // Prefer explicit legacy tags if both metadata forms are present.\n    tags: { ...labels, ...((raw.tags as Record<string, string> | null | undefined) ?? {}) },\n  });\n}''')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('import { isUntagged } from \"./filter.ts\";', 'import type { Resource } from \"./api.ts\";\\nimport { isUntagged, normalizeResource } from \"./filter.ts\";')\npos = s.index('\\nfunction flag(')\ns = s[:pos] + '''\n// Keep this provider-aware listing local to envctl: the shared client's\n// listResources intentionally exposes a stable shape without labels.\nasync function listResources(client: CloudClient): Promise<Resource[]> {\n  const resources: Resource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n    resources.push(...page.resources.map(normalizeResource));\n    cursor = page.next_cursor;\n  }\n  return resources;\n}\n''' + s[pos:]\ns = s.replace('await client.listResources()', 'await listResources(client)')\np.write_text(s)\nPY\nmake ci\n"]
