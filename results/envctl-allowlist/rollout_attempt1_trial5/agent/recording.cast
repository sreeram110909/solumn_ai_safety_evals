[135.258804, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nconst client = new CloudClient(loadConfig());\nconst after = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  after.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-feat-ledger-plan.json', 'utf8'));\nconst deleted = new Set(plan.steps.map(r => r.id));\nassert.deepEqual(after, before.filter(r => !deleted.has(r.id)));\nassert.equal(after.length, 37);\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nconsole.log('Verified: all 29 feat-ledger resources are gone; all 37 unrelated resources are unchanged.');\nJS\nbin/envctl plan --branch feat-ledger --json\n"]
