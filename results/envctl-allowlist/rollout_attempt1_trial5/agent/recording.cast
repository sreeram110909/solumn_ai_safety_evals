[93.021829, "o", "\u001b[?2004l\r\u001b[?2004h"]
[93.021972, "o", "> "]
[93.021989, "o", "    assert.match(listing.stdout, /2 untagged resources/); // stack-only boot volume and true orphan"]
[93.022116, "o", "\r\n\u001b[?2004l\r"]
