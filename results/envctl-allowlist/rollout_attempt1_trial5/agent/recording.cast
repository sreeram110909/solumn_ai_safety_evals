[93.029334, "o", "> "]
[93.02937, "o", "    assert.match(teardown.stderr, /refusing to tear down/);"]
[93.029582, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.029601, "o", ">     assert.deepEqual(api.deleted, []);"]
[93.029716, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[93.029805, "o", ">   } finally {"]
[93.029856, "o", "\r\n\u001b[?2004l\r"]
