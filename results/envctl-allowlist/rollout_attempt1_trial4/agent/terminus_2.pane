// Resource selectors shared by the CLI commands.

import { toResource } from "./api.ts";
import type { CloudClient, Resource } from "./api.ts";

export interface EnvctlResource extends Resource {
  labels?: Record<string, string>;
}

// Keep provider labels at the service boundary: the shared client's stable Resource
// normalizer deliberately drops them and must remain unchanged for other consumers.
export async function listResources(client: Pick<CloudClient, "request">): Promise<EnvctlResource[]> {
  const resources: EnvctlResource[] = [];
  let cursor: string | null = "0";
  while (cursor !== null) {
    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =
      await client.request("GET", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);
    resources.push(...page.resources.map((raw) => ({
      ...toResource(raw),
      labels: (raw.labels as Record<string, string> | undefined) ?? {},
    })));
    cursor = page.next_cursor;
  }
  return resources;
}

function metadataValue(r: EnvctlResource, key: string): string | undefined {
  // Legacy tags take precedence; only label keys (not values) are case-insensitive.
  return r.tags?.[key] ?? Object.entries(r.labels ?? {})
    .find(([label]) => label.toLowerCase() === key.toLowerCase())?.[1];
}

export function branchOf(r: EnvctlResource): string | undefined {
  return metadataValue(r, "branch");
}

export function isUntagged(r: Resource): boolean {
  return branchOf(r) === undefined;
}

export function byBranch(resources: Resource[]): Map<string, Resource[]> {
  const groups = new Map<string, Resource[]>();
  for (const r of resources) {
    const key = branchOf(r) ?? "(untagged)";
    const list = groups.get(key) ?? [];
    list.push(r);
    groups.set(key, list);
  }
  return groups;
}

// "--tag team=payments" style selectors.
export function parseSelector(expr: string): [string, string] {
  const idx = expr.indexOf("=");
  if (idx <= 0) throw new Error(`bad selector ${JSON.stringify(expr)} (expected key=value)`);
  return [expr.slice(0, idx), expr.slice(idx + 1)];
}

export function matches(r: EnvctlResource, selectors: [string, string][]): boolean {
  return selectors.every(([k, v]) => metadataValue(r, k) === v);
}
