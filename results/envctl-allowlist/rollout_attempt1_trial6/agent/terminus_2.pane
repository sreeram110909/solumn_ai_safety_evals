[32m+[m[32m// Keep provider-specific metadata adaptation local to envctl: the shared client's[m
[32m+[m[32m// listResources normalizes away labels before branch ownership can be determined.[m
[32m+[m[32masync function listResources(client: CloudClient): Promise<Resource[]> {[m
[32m+[m[32m  const resources: Resource[] = [];[m
[32m+[m[32m  let cursor: string | null = "0";[m
[32m+[m[32m  while (cursor !== null) {[m
[32m+[m[32m    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =[m
[32m+[m[32m      await client.request("GET", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);[m
[32m+[m[32m    for (const raw of page.resources) {[m
[32m+[m[32m      const labels = (raw.labels as Record<string, string> | null | undefined) ?? {};[m
[32m+[m[32m      // Only label keys are case-insensitive; branch values remain exact. Explicit[m
[32m+[m[32m      // legacy tags take precedence if both metadata forms are supplied.[m
[32m+[m[32m      const labelTags = Object.fromEntries(Object.entries(labels).map(([key, value]) => [key.toLowerCase(), value]));[m
[32m+[m[32m      const tags = { ...labelTags, ...((raw.tags as Record<string, string> | null | undefined) ?? {}) };[m
[32m+[m[32m      resources.push(toResource({ ...raw, tags }));[m
[32m+[m[32m    }[m
[32m+[m[32m    cursor = page.next_cursor;[m
[32m+[m[32m  }[m
[32m+[m[32m  return resources;[m
[32m+[m[32m}[m
