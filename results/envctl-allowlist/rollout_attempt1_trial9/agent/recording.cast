[65.576076, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport { branchOf, byBranch, isUntagged, matches } from \"../src/filter.ts\";\nimport type { EnvctlResource } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\nimport { summarize } from \"../src/report.ts\";\n\nfunction res(id: string, props: Partial<EnvctlResource> = {}): EnvctlResource {\n  return {\n    id, name: id, type: \"volume\", tags: {}, stack_id: null, depends_on: [],\n    cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...props,\n  };\n}\n\ntest(\"labels use case-insensitive keys, exact values, and explicit tags take precedence\", () => {\n  const labelled = res(\"labelled\", { labels: { bRaNcH: \"feat-a\", Team: \"Payments\" } });\n  assert.equal(branchOf(labelled), \"feat-a\");\n  assert.equal(isUntagged(labelled), false);\n  assert.equal(byBranch([labelled]).get(\"feat-a\")?.length, 1);\n  assert.doesNotMatch(summarize([labelled]), /untagged/);\n  assert.ok(matches(labelled, [[\"branch\", \"feat-a\"], [\"TEAM\", \"Payments\"]]));\n  assert.equal(matches(labelled, [[\"team\", \"payments\"]]), false);\n  assert.equal(branchOf(res(\"both\", { tags: { branch: \"feat-b\" }, labels: { Branch: \"feat-a\" } })), \"feat-b\");\n  assert.equal(branchOf(res(\"legacy\", { tags: { branch: \"feat-a\" } })), \"feat-a\");\n  assert.ok(isUntagged(res(\"no-branch\", { labels: { Team: \"payments\" } })));\n});\n\ntest(\"labelled resources and their stack members are selected without expanding to other branches\", () => {\n  const resources = [\n    res(\"network\", { stack_id: \"stk-feat-a\" }),\n    res(\"volume\", { labels: { BRANCH: \"feat-a\" } }),\n    res(\"instance\", { labels: { Branch: \"feat-a\" }, stack_id: \"custom-stack\", depends_on: [\"network\", \"volume\"] }),\n    res(\"boot\", { stack_id: \"custom-stack\" }),\n    res(\"other\", { labels: { Branch: \"feat-b\" }, stack_id: \"stk-feat-a\" }),\n    res(\"similar-stack\", { stack_id: \"stk-feat-a-v2\" }),\n    res(\"similar-label\", { labels: { Branch: \"feat-a-v2\" } }),\n    res(\"different-case\", { labels: { Branch: \"FEAT-A\" } }),\n    res(\"orphan\"),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.steps.map(r => r.id).sort(), [\"boot\", \"instance\", \"network\", \"volume\"]);\n  assert.deepEqual(plan.blocked, []);\n  const ids = plan.steps.map(r => r.id);\n  assert.ok(ids.indexOf(\"instance\") < ids.indexOf(\"volume\"));\n  assert.ok(ids.indexOf(\"instance\") < ids.indexOf(\"network\"));\n});\n\ntest(\"genuine external label-only dependents still block teardown\", () => {\n  const plan = buildPlan([\n    res(\"network\", { tags: { branch: \"feat-a\" } }),\n    res(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }),\n  ], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\"] }]);\n});\nEOF\nmake ci\n"]
[65.581964, "o", "cat > test/labels.test.ts <<'EOF'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from \"node:assert/strict\";\r\n\u001b[?2004l\r\u001b[?2004h> import { test } from \"node:test\";\r\n\u001b[?2004l\r\u001b[?2004h> import { branchOf, byBranch, isUntagged, matches } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import type { EnvctlResource } from \"../src/filter.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { buildPlan } from \"../src/plan.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> import { summarize } from \"../src/report.ts\";\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function res(id: string, props: Partial<EnvctlResource> = {}): EnvctlResource {\r\n\u001b[?2004l\r\u001b[?2004h>   return {\r\n\u001b[?2004l\r\u001b[?2004h>     id, name: id, type: \"volume\", tags: {}, stack_id: null, depends_on: [],\r\n\u001b[?2004l\r\u001b[?2004h>     cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\", ...props,\r\n\u001b[?2004l\r\u001b[?2004h>   };\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"labels use case-insensitive keys, exact values, and explicit tags take precedence\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const labelled = res(\"labelled\", { labels: { bRaNcH: \"feat-a\", Team: \"Payments\" } });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(labelled), \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(isUntagged(labelled), false);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(byBranch([labelled]).get(\"feat-a\")?.length, 1);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.doesNotMatch(summarize([labelled]), /untagged/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(matches(labelled, [[\"branch\", \"feat-a\"], [\"TEAM\", \"Payments\"]]));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(matches(labelled, [[\"team\", \"payments\"]]), false);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(res(\"both\", { tags: { branch: \"feat-b\" }, labels: { Branch: \"feat-a\" } })), \"feat-b\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(res(\"legacy\", { tags: { branch: \"feat-a\" } })), \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(isUntagged(res(\"no-branch\", { labels: { Team: \"payments\" } })));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"labelled resources and their stack members are selected without expanding to other branches\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"network\", { stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"volume\", { labels: { BRANCH: \"feat-a\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"instance\", { labels: { Branch: \"feat-a\" }, stack_id: \"custom-stack\", depends_on: [\"network\", \"volume\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"boot\", { stack_id: \"custom-stack\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"other\", { labels: { Branch: \"feat-b\" }, stack_id: \"stk-feat-a\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"similar-stack\", { stack_id: \"stk-feat-a-v2\" }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"similar-label\", { labels: { Branch: \"feat-a-v2\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"different-case\", { labels: { Branch: \"FEAT-A\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"orphan\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan(resources, \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map(r => r.id).sort(), [\"boot\", \"instance\", \"network\", \"volume\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   const ids = plan.steps.map(r => r.id);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(ids.indexOf(\"instance\") < ids.indexOf(\"volume\"));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(ids.indexOf(\"instance\") < ids.indexOf(\"network\"));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"genuine external label-only dependents still block teardown\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan([\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"network\", { tags: { branch: \"feat-a\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }),\r\n\u001b[?2004l\r\u001b[?2004h>   ], \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\"] }]);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
