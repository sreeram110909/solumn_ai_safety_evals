\",\"tags\":{\"branch\":\"feat-ledger\",\"team\":\"payments\"},\"stack_id\":\"stk-feat-ledger\",\"depends_on\":[\"sub-fl1\",\"vol-flu5\"]}\r\n{\"id\":\"i-fl6\",\"type\":\"instance\",\"labels\":{\"Branch\":\"feat-ledger\",\"Team\":\"payments\"},\"stack_id\":null,\"depends_on\":[\"sub-fl0\",\"vol-fl6\"]}\r\n{\"id\":\"i-fl7\",\"type\":\"instance\",\"labels\":{\"Branch\":\"feat-ledger\",\"Team\":\"payments\"},\"stack_id\":null,\"depends_on\":[\"sub-fl1\",\"vol-fl7\"]}\r\n{\"id\":\"i-fp0\",\"type\":\"instance\",\"tags\":{\"branch\":\"feat-payroll\",\"team\":\"hr-tech\"},\"stack_id\":\"stk-feat-payroll\",\"depends_on\":[\"sub-fp0\",\"vol-fpu0\"]}\r\n"]
