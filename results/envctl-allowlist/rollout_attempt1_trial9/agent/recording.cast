[113.386021, "o", "\u001b[32m✔ CLI retains paginated provider labels for list, plan, gc and safe teardown \u001b[90m(1440.007333ms)\u001b[39m\u001b[39m\r\n"]
[113.4015, "o", "\u001b[32m✔ labels use case-insensitive keys, exact values, and explicit tags take precedence \u001b[90m(1.73532ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ labelled resources and their stack members are selected without expanding to other branches \u001b[90m(1.305812ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external label-only dependents still block teardown \u001b[90m(0.248589ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.904922ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.269224ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.612172ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.480384ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.419495ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1698.288244\u001b[39m\r\n"]
