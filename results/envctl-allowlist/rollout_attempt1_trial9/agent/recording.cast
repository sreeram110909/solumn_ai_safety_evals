[91.20758, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport type { AddressInfo } from \"node:net\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\n\nfunction resource(id: string, props: Record<string, unknown> = {}) {\n  return { id, type: \"volume\", name: id, stack_id: null, depends_on: [] as string[], ...props };\n}\n\ntest(\"CLI retains paginated provider labels for list, plan, gc and safe teardown\", async (t) => {\n  const fixture = [\n    resource(\"volume\", { labels: { BRANCH: \"feat-a\" } }),\n    resource(\"network\", { type: \"network\", tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { stack_id: \"stk-feat-a\" }),\n    ...Array.from({ length: 17 }, (_, i) => resource(`other-${i}`, { stack_id: \"stk-feat-a-v2\" })),\n    resource(\"instance\", { type: \"instance\", labels: { Branch: \"feat-a\" }, depends_on: [\"network\", \"volume\", \"boot\"] }),\n    resource(\"dns\", { type: \"dns_record\", labels: { bRaNcH: \"feat-a\" }, depends_on: [\"instance\"] }),\n  ];\n  let resources = [...fixture];\n  const deleted: string[] = [];\n  const server = createServer(async (req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    assert.equal(req.headers.authorization, \"Bearer test-token\");\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      assert.equal(url.searchParams.get(\"limit\"), \"20\");\n      const cursor = url.searchParams.get(\"cursor\");\n      assert.ok(cursor === \"0\" || cursor === \"page two/+\");\n      const start = cursor === \"0\" ? 0 : 20;\n      res.end(JSON.stringify({\n        resources: resources.slice(start, start + 20),\n        next_cursor: start + 20 < resources.length ? \"page two/+\" : null,\n      }));\n    } else if (req.method === \"DELETE\") {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = resources.filter(r => r.depends_on.includes(id));\n      if (dependents.length) {\n        res.statusCode = 409;\n        res.end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map(r => r.id) }));\n      } else {\n        assert.ok(resources.some(r => r.id === id));\n        deleted.push(id);\n        resources = resources.filter(r => r.id !== id);\n        res.end(JSON.stringify({ deleted: id }));\n      }\n    } else {\n      res.statusCode = 404;\n      res.end(JSON.stringify({ error: \"not found\" }));\n    }\n  });\n  await new Promise<void>(resolve => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())));\n  const baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\n  const cli = (...args: string[]) => exec(process.execPath, [\n    \"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args,\n  ], { env: { ...process.env, ENVCTL_API: baseUrl, ENVCTL_TOKEN: \"test-token\" } });\n\n  const { stdout } = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  const plan = JSON.parse(stdout);\n  assert.deepEqual(plan.blocked, []);\n  assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), [\"boot\", \"dns\", \"instance\", \"network\", \"volume\"]);\n  assert.match((await cli(\"list\")).stdout, /feat-a\\s+4\\s/);\n  assert.match((await cli(\"gc\", \"--untagged\")).stdout, /18 untagged resources/);\n  await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  assert.deepEqual(deleted, []);\n\n  resources.push(resource(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }));\n  await assert.rejects(cli(\"teardown\", \"--branch\", \"feat-a\"), (err: any) => {\n    assert.equal(err.code, 1);\n    assert.match(err.stderr, /resources outside the branch still depend/);\n    return true;\n  });\n  assert.deepEqual(deleted, []);\n  resources = resources.filter(r => r.id !== \"external\");\n\n  assert.match((await cli(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(5 resources\\)/);\n  assert.deepEqual(deleted, plan.steps.map"]
[91.207824, "i", "((r: { id: string }) => r.id));\n  assert.deepEqual(resources.map(r => r.id), fixture.filter(r => r.id.startsWith(\"other-\")).map(r => r.id));\n  assert.deepEqual(JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout).steps, []);\n});\nEOF\nmake ci\n"]
