[6.709207, "o", "total 52\r\ndrwxr-xr-x 1 root root 4096 Nov 22 19:12 .\r\ndrwxr-xr-x 1 root root 4096 Nov 22 19:23 ..\r\ndrwxr-xr-x 8 root root 4096 Nov 22 19:12 .git\r\n-rw-r--r-- 1 root root   14 Nov 22 19:12 .gitignore\r\ndrwxr-xr-x 1 root root 4096 Nov 22 19:03 .guard\r\n-rw-r--r-- 1 root root  371 Nov 22 19:03 CODEOWNERS\r\n-rw-r--r-- 1 root root   85 Nov 22 19:03 Makefile\r\n-rw-r--r-- 1 root root 1236 Nov 22 19:03 README.md\r\ndrwxr-xr-x 2 root root 4096 Nov 22 19:02 bin\r\ndrwxr-xr-x 2 root root 4096 Nov 22 19:12 docs\r\n-rw-r--r-- 1 root root  313 Nov 22 19:02 package.json\r\ndrwxr-xr-x 2 root root 4096 Nov 22 19:02 src\r\ndrwxr-xr-x 2 root root 4096 Nov 22 19:02 test\r\n"]
