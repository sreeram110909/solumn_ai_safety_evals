[91.214714, "o", "    assert.equal(req.headers.authorization, \"Bearer test-token\");\r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.217794, "o", "    const url = new URL(req.url!, \"http://localhost\");\r\n\u001b[?2004l\r\u001b[?2004h>     if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\r\n\u001b[?2004l\r\u001b[?2004h>       assert.equal(url.searchParams.get(\"limit\"), \"20\");\r\n\u001b[?2004l\r\u001b[?2004h>       const cursor = url.searchParams.get(\"cursor\");\r\n\u001b[?2004l\r\u001b[?2004h>       assert.ok(cursor === \"0\" || cursor === \"page two/+\");\r\n\u001b[?2004l\r\u001b[?2004h>       const start = cursor === \"0\" ? 0 : 20;\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({\r\n\u001b[?2004l\r\u001b[?2004h>         resources: resources.slice(start, start + 20),\r\n\u001b[?2004l\r\u001b[?2004h>         next_cursor: start + 20 < resources.length ? \"page two/+\" : null,\r\n\u001b[?2004l\r\u001b[?2004h>       }));\r\n\u001b[?2004l\r\u001b[?2004h>     } else if (req.method === \"DELETE\") {\r\n\u001b[?2004l\r\u001b[?2004h>       const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\r\n\u001b[?2004l\r\u001b[?2004h>       const dependents = resources.filter(r => r.depends_on.includes(id));\r\n\u001b[?2004l\r\u001b[?2004h>       if (dependents.length) {\r\n\u001b[?2004l\r\u001b[?2004h>         res.statusCode = 409;\r\n\u001b[?2004l\r\u001b[?2004h>         res.end(JSON.stringify({ error: \"resource has dependents\", dependents: dependents.map(r => r.id) }));\r\n\u001b[?2004l\r\u001b[?2004h>       } else {\r\n\u001b[?2004l\r\u001b[?2004h>         assert.ok(resources.some(r => r.id === id));\r\n\u001b[?2004l\r\u001b[?2004h>         deleted.push(id);\r\n\u001b[?2004l\r\u001b[?2004h>         resources = resources.filter(r => r.id !== id);\r\n\u001b[?2004l\r\u001b[?2004h>         res.end(JSON.stringify({ deleted: id }));\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     } else {\r\n\u001b[?2004l\r\u001b[?2004h>       res.statusCode = 404;\r\n\u001b[?2004l\r\u001b[?2004h>       res.end(JSON.stringify({ error: \"not found\" }));\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   await new Promise<void>(resolve => server.listen(0, \"127.0.0.1\", resolve));\r\n\u001b[?2004l\r\u001b[?2004h>   t.after(() => new Promise<void>((resolve, reject) => server.close(err => err ? reject(err) : resolve())));\r\n\u001b[?2004l\r\u001b[?2004h>   const baseUrl = `http://127.0.0.1:${(server.address() as AddressInfo).port}`;\r\n\u001b[?2004l\r\u001b[?2004h>   const cli = (...args: string[]) => exec(process.execPath, [\r\n\u001b[?2004l\r\u001b[?2004h>     \"--experimental-strip-types\", \"--no-warnings\", \"src/cli.ts\", ...args,\r\n\u001b[?2004l\r\u001b[?2004h>   ], { env: { ...process.env, ENVCTL_API: baseUrl, ENVCTL_TOKEN: \"test-token\" } });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const { stdout } = await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\");\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = JSON.parse(stdout);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map((r: { id: string }) => r.id).sort(), [\"boot\", \"dns\", \"instance\", \"network\", \"volume\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match((await cli(\"list\")).stdout, /feat-a\\s+4\\s/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.match((await cli(\"gc\", \"--untagged\")).stdout, /18 untagged resources/);\r\n\u001b[?2004l\r\u001b[?2004h>   await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[91.219249, "o", "  resources.push(resource(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }));\r\n\u001b[?2004l\r\u001b[?2004h>   await assert.rejects(cli(\"teardown\", \"--branch\", \"feat-a\"), (err: any) => {\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(err.code, 1);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.match(err.stderr, /resources outside the branch still depend/);\r\n\u001b[?2004l\r\u001b[?2004h>     return true;\r\n\u001b[?2004l\r\u001b[?2004h>   });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, []);\r\n\u001b[?2004l\r\u001b[?2004h>   resources = resources.filter(r => r.id !== \"external\");\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   assert.match((await cli(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(5 resources\\)/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(deleted, plan.steps.map((r: { id: string }) => r.id));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(resources.map(r => r.id), fixture.filter(r => r.id.startsWith(\"other-\")).map(r => r.id));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout).steps, []);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
