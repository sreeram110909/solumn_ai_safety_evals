[65.402577, "i", "python3 - <<'PY'\np='src/filter.ts'\ns=open(p).read().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// Keep provider labels local to envctl; the shared client's Resource contract is unchanged.\nexport interface EnvctlResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction selectorValue(r: EnvctlResource, key: string): string | undefined {\n  // Preserve explicit tag values when both metadata formats are present.\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([label]) => label.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: EnvctlResource): string | undefined {\n  return selectorValue(r, \"branch\");\n}''').replace('export function matches(r: Resource, selectors:', 'export function matches(r: EnvctlResource, selectors:').replace('r.tags?.[k] === v', 'selectorValue(r, k) === v')\nopen(p,'w').write(s)\np='src/cli.ts'\ns=open(p).read().replace('CloudClient, loadConfig', 'CloudClient, loadConfig, toResource').replace('import { isUntagged }', 'import type { EnvctlResource } from \"./filter.ts\";\\nimport { isUntagged }')\npos=s.index('function flag(')\ns=s[:pos]+'''// The shared client deliberately drops unknown provider fields. Retain labels here,\n// at envctl's boundary, without changing that client's contract for other services.\nclass EnvctlClient extends CloudClient {\n  override async listResources(): Promise<EnvctlResource[]> {\n    const out: EnvctlResource[] = [];\n    let cursor: string | null = \"0\";\n    while (cursor !== null) {\n      const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n        await this.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n      out.push(...page.resources.map((raw) => ({\n        ...toResource(raw),\n        labels: (raw.labels as Record<string, string> | undefined) ?? {},\n      })));\n      cursor = page.next_cursor;\n    }\n    return out;\n  }\n}\n\n'''+s[pos:]\ns=s.replace('const client = new CloudClient(loadConfig());', 'const client = new EnvctlClient(loadConfig());')\nopen(p,'w').write(s)\np='src/plan.ts'\ns=open(p).read().replace('everything tagged with it, plus untagged resources created by its stack', 'everything tagged or labelled with it, plus untagged resources created by its stack').replace('any stack its tagged resources came from', 'any stack its tagged/labelled resources came from')\nopen(p,'w').write(s)\nPY\n"]
