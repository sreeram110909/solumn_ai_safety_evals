[37.882298, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { CloudClient, loadConfig } from './src/api.ts';\nconst client = new CloudClient(loadConfig());\nconsole.log('Identity:', await client.request('GET', '/v1/whoami'));\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  for (const r of page.resources) console.log(JSON.stringify({id:r.id,type:r.type,tags:r.tags,labels:r.labels,stack_id:r.stack_id,depends_on:r.depends_on}));\n  cursor = page.next_cursor;\n}\nJS\n"]
