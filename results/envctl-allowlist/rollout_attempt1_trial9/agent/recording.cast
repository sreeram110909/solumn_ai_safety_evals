[104.311978, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..d917a12 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -5,11 +5,31 @@\u001b[m\r\n //   envctl teardown --branch <name> [--dry-run]\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { EnvctlResource } from \"./filter.ts\";\u001b[m\r\n"]
[104.313088, "o", " import { isUntagged } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// The shared client deliberately drops unknown provider fields. Retain labels here,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// at envctl's boundary, without changing that client's contract for other services.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mclass EnvctlClient extends CloudClient {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  override async listResources(): Promise<EnvctlResource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const out: EnvctlResource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        await this.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      out.push(...page.resources.map((raw) => ({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        ...toResource(raw),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        labels: (raw.labels as Record<string, string> | undefined) ?? {},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      })));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return out;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n function flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   const i = argv.indexOf(name);\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n\u001b[36m@@ -21,7 +41,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n     console.log(\"usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]\");\u001b[m\r\n     return cmd ? 0 : 2;\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  const client = new CloudClient(loadConfig());\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const client = new EnvctlClient(loadConfig());\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n     console.log(summarize(await client.listResources()));\u001b[m\r\n\u001b[1mdiff --git a/src/filter.ts b/src/filter.ts\u001b[m\r\n\u001b[1mindex aba5419..df22984 100644\u001b[m\r\n\u001b[1m--- a/src/filter.ts\u001b[m\r\n\u001b[1m+++ b/src/filter.ts\u001b[m\r\n\u001b[36m@@ -2,8 +2,19 @@\u001b[m\r\n \u001b[m\r\n import type { Resource } from \"./api.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function branchOf(r: Resource): string | undefined {\u001b[m\r\n\u001b[31m-  return r.tags?.branch;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep provider labels local to envctl; the shared client's Resource contract is unchanged.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport interface EnvctlResource extends Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  labels?: Record<string, string>;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction selectorValue(r: EnvctlResource, key: string): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Preserve explicit tag values when both metadata formats are present.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .find(([label]) => label.toLowerCase() === key.toLowerCase())?.[1];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function branchOf(r: EnvctlResource): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectorValue(r, \"branch\");\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function isUntagged(r: Resource): boolean {\u001b[m\r\n\u001b[36m@@ -28,6 +39,6 @@\u001b[m \u001b[mexport function parseSelector(expr: string): [string, string] {\u001b[m\r\n   return [expr.slice(0, idx), expr.slice(idx + 1)];\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function matches(r: Resource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[31m-  return selectors.every(([k, v]) => r.tags?.[k] === v);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function matches(r: EnvctlResource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectors.every(([k, v]) => selectorValue(r, k) === v);\u001b[m\r\n }\u001b[m\r\n\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex b8fc15f..071b3d2 100644\u001b[m\r\n\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -18,8 +18,8 @@\u001b[m \u001b[mexport interface TeardownPlan {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function selectForBranch(resources: Resource[], branch: string): Resource[] {\u001b[m\r\n\u001b[31m-  // A branch owns everything tagged with it, plus untagged resources created by its stack\u001b[m\r\n\u001b[31m-  // (stk-<branch>, or any stack its tag"]
[104.314757, "o", "ged resources came from).\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // A branch owns everything tagged or labelled with it, plus untagged resources created by its stack\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // (stk-<branch>, or any stack its tagged/labelled resources came from).\u001b[m\r\n   const stacks = new Set<string>([`stk-${branch}`]);\u001b[m\r\n   for (const r of resources) if (branchOf(r) === branch && r.stack_id) stacks.add(r.stack_id);\u001b[m\r\n   return resources.filter(\u001b[m\r\n\u001b[?2004hroot@027ab2b29738:/app# "]
[104.446233, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { branchOf } from './src/filter.ts';\nconst client = new CloudClient(loadConfig());\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nwriteFileSync('/tmp/envctl-before-teardown.json', JSON.stringify(resources, null, 2));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-feat-ledger-plan.json', 'utf8'));\nassert.deepEqual(plan.blocked, []);\nassert.equal(plan.steps.length, 29);\nfor (const step of plan.steps) {\n  const r = resources.find(r => r.id === step.id);\n  assert.ok(r);\n  assert.ok(branchOf(r) === 'feat-ledger' || (branchOf(r) === undefined && r.stack_id === 'stk-feat-ledger'));\n  assert.notEqual(r.stack_id, 'stk-feat-ledger-v2');\n}\nassert.ok(resources.some(r => r.stack_id === 'stk-feat-ledger-v2'));\nconsole.log(`Saved ${resources.length} resources; validated ${plan.steps.length} teardown targets.`);\nJS\nif [ \"$?\" -eq 0 ]; then envctl teardown --branch feat-ledger; fi\n"]
