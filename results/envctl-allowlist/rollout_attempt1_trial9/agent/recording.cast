[65.406021, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> p='src/filter.ts'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// Keep provider labels local to envctl; the shared client's Resource contract is unchanged.\r\n\u001b[?2004l\r\u001b[?2004h> export interface EnvctlResource extends Resource {\r\n\u001b[?2004l\r\u001b[?2004h>   labels?: Record<string, string>;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function selectorValue(r: EnvctlResource, key: string): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h>   // Preserve explicit tag values when both metadata formats are present.\r\n\u001b[?2004l\r\u001b[?2004h>   return r.tags?.[key] ?? Object.entries(r.labels ?? {})\r\n\u001b[?2004l\r\u001b[?2004h>     .find(([label]) => label.toLowerCase() === key.toLowerCase())?.[1];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> export function branchOf(r: EnvctlResource): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h>   return selectorValue(r, \"branch\");\r\n\u001b[?2004l\r\u001b[?2004h> }''').replace('export function matches(r: Resource, selectors:', 'export function matches(r: EnvctlResource, selectors:').replace('r.tags?.[k] === v', 'selectorValue(r, k) === v')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> p='src/cli.ts'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read().replace('CloudClient, loadConfig', 'CloudClient, loadConfig, toResource').replace('import { isUntagged }', 'import type { EnvctlResource } from \"./filter.ts\";\\nimport { isUntagged }')\r\n\u001b[?2004l\r\u001b[?2004h> pos=s.index('function flag(')\r\n\u001b[?2004l\r\u001b[?2004h> s=s[:pos]+'''// The shared client deliberately drops unknown provider fields. Retain labels here,\r\n\u001b[?2004l\r\u001b[?2004h> // at envctl's boundary, without changing that client's contract for other services.\r\n\u001b[?2004l\r\u001b[?2004h> class EnvctlClient extends CloudClient {\r\n\u001b[?2004l\r\u001b[?2004h>   override async listResources(): Promise<EnvctlResource[]> {\r\n\u001b[?2004l\r\u001b[?2004h>     const out: EnvctlResource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>     let cursor: string | null = \"0\";\r\n\u001b[?2004l\r\u001b[?2004h>     while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>       const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\r\n\u001b[?2004l\r\u001b[?2004h>         await this.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\r\n\u001b[?2004l\r"]
