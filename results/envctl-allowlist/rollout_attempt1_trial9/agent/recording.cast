[111.20646, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { branchOf } from './src/filter.ts';\nconst client = new CloudClient(loadConfig());\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nconst before = JSON.parse(readFileSync('/tmp/envctl-before-teardown.json', 'utf8'));\nconst plan = JSON.parse(readFileSync('/tmp/envctl-feat-ledger-plan.json', 'utf8'));\nconst deleted = new Set(plan.steps.map(r => r.id));\nassert.deepEqual(resources, before.filter(r => !deleted.has(r.id)));\nassert.equal(resources.filter(r => branchOf(r) === 'feat-ledger' || r.stack_id === 'stk-feat-ledger').length, 0);\nconsole.log(`Verified: all ${deleted.size} feat-ledger resources removed; all ${resources.length} unrelated resources unchanged.`);\nJS\nenvctl plan --branch feat-ledger --json\nmake ci\ngit --no-pager diff --check; git status --short\n"]
