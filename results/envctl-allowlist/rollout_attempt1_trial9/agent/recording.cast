[92.568486, "o", "\u001b[32m✔ CLI retains paginated provider labels for list, plan, gc and safe teardown \u001b[90m(1004.602982ms)\u001b[39m\u001b[39m\r\n"]
[92.581282, "o", "\u001b[32m✔ labels use case-insensitive keys, exact values, and explicit tags take precedence \u001b[90m(1.196219ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ labelled resources and their stack members are selected without expanding to other branches \u001b[90m(0.954825ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external label-only dependents still block teardown \u001b[90m(0.173185ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selectors parse key=value \u001b[90m(1.525705ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.194343ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.423691ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.350206ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.32536ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 9\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 9\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1203.057345\u001b[39m\r\n"]
