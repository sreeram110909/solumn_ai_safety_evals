c metadata in envctl: the shared client's normalizer\r\n\u001b[?2004l\r\u001b[?2004h> // intentionally drops fields outside its stable Resource contract.\r\n\u001b[?2004l\r\u001b[?2004h> class EnvClient extends CloudClient {\r\n\u001b[?2004l\r\u001b[?2004h>   override async listResources(): Promise<LabeledResource[]> {\r\n\u001b[?2004l\r\u001b[?2004h>     const out: LabeledResource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>     let cursor: string | null = \"0\";\r\n\u001b[?2004l\r\u001b[?2004h>     while (cursor !== null) {\r\n\u001b[?2004l\r\u001b[?2004h>       const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\r\n\u001b[?2004l\r\u001b[?2004h>         await this.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\r\n\u001b[?2004l\r\u001b[?2004h>       out.push(...page.resources.map((raw) => ({\r\n\u001b[?2004l\r\u001b[?2004h>         ...toResource(raw),\r\n\u001b[?2004l\r\u001b[?2004h>         labels: (raw.labels as Record<string, string> | undefined) ?? {},\r\n\u001b[?2004l\r\u001b[?2004h>       })));\r\n\u001b[?2004l\r\u001b[?2004h>       cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     return out;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> '''+s[pos:]\r\n\u001b[?2004l\r\u001b[?2004h> "]
