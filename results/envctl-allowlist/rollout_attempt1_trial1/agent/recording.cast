[78.58997, "o", "\u001b[32m✔ CLI preserves labels across pages for plan, list, gc, and teardown \u001b[90m(1125.428791ms)\u001b[39m\u001b[39m\r\n"]
[78.974017, "o", "\u001b[32m✔ CLI refuses teardown when a labeled resource from another branch depends on it \u001b[90m(385.001816ms)\u001b[39m\u001b[39m\r\n"]
[78.98529, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.398348ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ resources group by branch tag \u001b[90m(0.3135ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.41414ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.552211ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.367593ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ label keys are case-insensitive, but branch values remain exact \u001b[90m(0.418309ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan recognizes label-only dependents and volumes without expanding to other branches \u001b[90m(0.40004ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ genuine external dependents still block teardown \u001b[90m(0.199704ms)\u001b[39m\u001b[39m\r\n\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 1649.26782\u001b[39m\r\n"]
