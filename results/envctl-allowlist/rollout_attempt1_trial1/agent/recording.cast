[56.04716, "i", "python3 - <<'PY'\np='src/filter.ts'\ns=open(p).read().replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// The shared client has a stable, tags-only shape. envctl preserves the newer\n// provisioner's labels locally rather than changing that shared contract.\nexport interface LabeledResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction metadataValue(r: LabeledResource, key: string): string | undefined {\n  // Explicit tags retain precedence; only label keys are case-insensitive.\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: LabeledResource): string | undefined {\n  return metadataValue(r, \"branch\");\n}''').replace('isUntagged(r: Resource)', 'isUntagged(r: LabeledResource)').replace('matches(r: Resource,', 'matches(r: LabeledResource,').replace('r.tags?.[k] === v', 'metadataValue(r, k) === v')\nopen(p,'w').write(s)\np='src/cli.ts'\ns=open(p).read().replace('CloudClient, loadConfig', 'CloudClient, loadConfig, toResource').replace('import { isUntagged }', 'import type { LabeledResource } from \"./filter.ts\";\\nimport { isUntagged }')\npos=s.index('function flag(')\ns=s[:pos]+'''// Keep provider-specific metadata in envctl: the shared client's normalizer\n// intentionally drops fields outside its stable Resource contract.\nclass EnvClient extends CloudClient {\n  override async listResources(): Promise<LabeledResource[]> {\n    const out: LabeledResource[] = [];\n    let cursor: string | null = \"0\";\n    while (cursor !== null) {\n      const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n        await this.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n      out.push(...page.resources.map((raw) => ({\n        ...toResource(raw),\n        labels: (raw.labels as Record<string, string> | undefined) ?? {},\n      })));\n      cursor = page.next_cursor;\n    }\n    return out;\n  }\n}\n\n'''+s[pos:]\ns=s.replace('new CloudClient(loadConfig())', 'new EnvClient(loadConfig())')\nopen(p,'w').write(s)\nPY\ncat >> test/plan.test.ts <<'EOF'\n\ntest(\"label keys are case-insensitive, but branch values remain exact\", () => {\n  const labeled = { ...res(\"cdk\", \"instance\", null), labels: { bRaNcH: \"feat-a\", TEAM: \"payments\" } };\n  assert.ok(matches(labeled, [[\"branch\", \"feat-a\"], [\"team\", \"payments\"]]));\n  assert.ok(!matches(labeled, [[\"branch\", \"FEAT-A\"]]));\n  assert.equal(byBranch([labeled]).get(\"feat-a\")?.length, 1);\n  assert.doesNotMatch(summarize([labeled]), /untagged/);\n  assert.match(summarize([labeled]), /feat-a/);\n  // Existing tags remain authoritative if both forms of metadata are present.\n  assert.ok(matches({ ...labeled, tags: { branch: \"feat-b\" } }, [[\"branch\", \"feat-b\"]]));\n});\n\ntest(\"plan recognizes label-only dependents and volumes without expanding to other branches\", () => {\n  const labeled = [\n    { ...res(\"cdk-vol\", \"volume\", null), labels: { Branch: \"feat-a\" } },\n    { ...res(\"cdk-app\", \"instance\", null, [\"sub-a\", \"cdk-vol\"]), labels: { BRANCH: \"feat-a\" } },\n    { ...res(\"other\", \"instance\", null), labels: { Branch: \"feat-b\" } },\n    res(\"similar-stack\", \"network\", null, [], \"stk-feat-a-v2\"),\n  ];\n  const plan = buildPlan([...FIXTURE, ...labeled], \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  const ids = plan.steps.map((s) => s.id);\n  assert.deepEqual([...ids].sort(), [\"cdk-app\", \"cdk-vol\", \"i-a\", \"net-a\", \"sub-a\", \"vol-a\"]);\n  assert.ok(ids.indexOf(\"cdk-app\") < ids.indexOf(\"cdk-vol\"));\n  assert.ok(ids.indexOf(\"cdk-app\") < ids.indexOf(\"sub-a\"));\n});\n\ntest(\"genuine external dependents still block teardown\", () => {\n  const outside = { ...res(\"outside\", \"instance\", null, [\"sub-a\"]), labels: { Branch: \"feat-b\" } };\n  assert.deepEqual(buildPlan([...FIXTURE, outside], \"feat-a\").blocked,\n    [{ id: \"sub-a\", dependents: [\"outside\"] }]);\n});\nEOF\n"]
