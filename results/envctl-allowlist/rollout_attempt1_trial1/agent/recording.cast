[91.160829, "i", "verify_dir=$(mktemp -d /tmp/envctl-741.XXXXXX); export ENVCTL_VERIFY_DIR=\"$verify_dir\"\nnode --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nconst client = new CloudClient(loadConfig());\nconst resources = [];\nlet cursor = '0';\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  resources.push(...page.resources);\n  cursor = page.next_cursor;\n}\nwriteFileSync(`${process.env.ENVCTL_VERIFY_DIR}/before.json`, JSON.stringify(resources));\nconsole.log(`Saved ${resources.length} resources for post-teardown verification`);\nJS\n"]
[91.164864, "o", "verify_dir=$(mktemp -d /tmp/envctl-741.XXXXXX); export ENVCTL_VERIFY_DIR=\"$verify_dir\"\r\n\u001b[?2004l\r"]
