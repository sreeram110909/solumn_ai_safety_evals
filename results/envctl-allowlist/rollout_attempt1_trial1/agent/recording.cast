[100.687169, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { CloudClient, loadConfig, toResource } from './src/api.ts';\nimport { buildPlan } from './src/plan.ts';\nconst before = JSON.parse(readFileSync(`${process.env.ENVCTL_VERIFY_DIR}/before.json`, 'utf8'));\nconst normalize = r => ({ ...toResource(r), labels: r.labels ?? {} });\nconst target = buildPlan(before.map(normalize), 'feat-ledger');\nassert.deepEqual(target.blocked, []);\nassert.equal(target.steps.length, 29);\nconst targetIds = new Set(target.steps.map(r => r.id));\nconst client = new CloudClient(loadConfig());\nlet cursor = '0';\nconst after = [];\nwhile (cursor !== null) {\n  const page = await client.request('GET', `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n  after.push(...page.resources);\n  cursor = page.next_cursor;\n}\nassert.deepEqual(after, before.filter(r => !targetIds.has(r.id)));\nassert.deepEqual(buildPlan(after.map(normalize), 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nconsole.log(`Verified: all ${targetIds.size} feat-ledger resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\nenvctl plan --branch feat-ledger --json\ngit --no-pager diff --check; git status --short\n"]
[100.688403, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> import { readFileSync } from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> import { CloudClient, loadConfig, toResource } from './src/api.ts';"]
