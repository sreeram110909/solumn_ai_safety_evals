[76.911872, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\n\nconst exec = promisify(execFile);\nconst cli = new URL(\"../src/cli.ts\", import.meta.url).pathname;\n\nfunction fixture() {\n  const resource = (id: string, metadata: object, depends_on: string[] = [], stack_id: string | null = null) =>\n    ({ id, type: \"instance\", name: id, depends_on, stack_id, cost_month_cents: 100, ...metadata });\n  return [\n    resource(\"net\", { tags: { branch: \"feat-a\" } }, [], \"stk-feat-a\"),\n    resource(\"boot\", { tags: {} }, [], \"stk-feat-a\"),\n    resource(\"cdk-vol\", { labels: { Branch: \"feat-a\" } }),\n    resource(\"other\", { labels: { Branch: \"feat-b\" } }),\n    resource(\"cdk-app\", { labels: { bRaNcH: \"feat-a\" } }, [\"net\", \"boot\", \"cdk-vol\"]),\n    resource(\"similar-stack\", { tags: {} }, [], \"stk-feat-a-v2\"),\n  ];\n}\n\nasync function withApi(resources: ReturnType<typeof fixture>, run: (api: {\n  cli: (...args: string[]) => ReturnType<typeof exec>;\n  deleted: string[];\n  cursors: string[];\n  remaining: Map<string, ReturnType<typeof fixture>[number]>;\n}) => Promise<void>) {\n  const remaining = new Map(resources.map((r) => [r.id, r]));\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    if (req.headers.authorization !== \"Bearer test-token\") {\n      res.writeHead(401).end(JSON.stringify({ error: \"bad token\" }));\n      return;\n    }\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      const offset = cursor === \"0\" ? 0 : Number(/^page\\/(\\d+) & next$/.exec(cursor)?.[1]);\n      if (!Number.isFinite(offset)) {\n        res.writeHead(400).end(JSON.stringify({ error: \"bad cursor\" }));\n        return;\n      }\n      const all = [...remaining.values()];\n      res.end(JSON.stringify({\n        resources: all.slice(offset, offset + 2),\n        next_cursor: offset + 2 < all.length ? `page/${offset + 2} & next` : null,\n      }));\n      return;\n    }\n    if (req.method === \"DELETE\" && url.pathname.startsWith(\"/v1/resources/\")) {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = [...remaining.values()].filter((r) => r.depends_on.includes(id)).map((r) => r.id);\n      if (dependents.length) {\n        res.writeHead(409).end(JSON.stringify({ error: \"resource has dependents\", dependents }));\n        return;\n      }\n      if (remaining.delete(id)) {\n        deleted.push(id);\n        res.end(JSON.stringify({ deleted: id }));\n        return;\n      }\n    }\n    res.writeHead(404).end(JSON.stringify({ error: \"not found\" }));\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  const address = server.address() as { port: number };\n  try {\n    await run({\n      cli: (...args) => exec(process.execPath, [\"--experimental-strip-types\", \"--no-warnings\", cli, ...args], {\n        env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" },\n      }),\n      deleted, cursors, remaining,\n    });\n  } finally {\n    await new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve()));\n  }\n}\n\ntest(\"CLI preserves labels across pages for plan, list, gc, and teardown\", async () => {\n  await withApi(fixture(), async ({ cli, deleted, cursors, remaining }) => {\n    const plan = JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n    assert.deepEqual(cursors, [\"0\", \"page/2 & next\", \"page/4 & next\"]);\n    assert.deepEqual(plan.blocked, []);\n    assert.deepEqual(plan.steps.map((s: { id: string }) => s.id).sort(), [\"boot\", \"cdk-app\", \"cdk-vol\", \"net\"]);\n    const listing = (await cli(\"list\")).stdout;\n    assert.match(listing, /feat-a\\s+3\\s+\\$3\\.00/);\n    assert.match(listing, /feat-b\\s"]
[76.911932, "i", "+1\\s+\\$1\\.00/);\n    assert.match((await cli(\"gc\", \"--untagged\")).stdout, /2 untagged resources/);\n    await cli(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n    assert.deepEqual(deleted, []);\n    await cli(\"teardown\", \"--branch\", \"feat-a\");\n    assert.equal(deleted[0], \"cdk-app\");\n    assert.deepEqual([...deleted].sort(), [\"boot\", \"cdk-app\", \"cdk-vol\", \"net\"]);\n    assert.deepEqual([...remaining.keys()], [\"other\", \"similar-stack\"]);\n    assert.deepEqual(JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout).steps, []);\n  });\n});\n\ntest(\"CLI refuses teardown when a labeled resource from another branch depends on it\", async () => {\n  const resources = fixture();\n  resources.find((r) => r.id === \"other\")!.depends_on = [\"net\"];\n  await withApi(resources, async ({ cli, deleted }) => {\n    const plan = JSON.parse((await cli(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n    assert.deepEqual(plan.blocked, [{ id: \"net\", dependents: [\"other\"] }]);\n    await assert.rejects(cli(\"teardown\", \"--branch\", \"feat-a\"), (err: any) => {\n      assert.equal(err.code, 1);\n      assert.match(err.stderr, /refusing to tear down/);\n      return true;\n    });\n    assert.deepEqual(deleted, []);\n  });\n});\nEOF\nmake ci\n"]
