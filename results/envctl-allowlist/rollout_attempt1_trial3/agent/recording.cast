[95.474395, "i", "cat > test/cli.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { execFile } from \"node:child_process\";\nimport { createServer } from \"node:http\";\nimport { fileURLToPath } from \"node:url\";\nimport { promisify } from \"node:util\";\nimport { test } from \"node:test\";\nimport type { TestContext } from \"node:test\";\nimport type { BranchResource } from \"../src/filter.ts\";\n\nconst exec = promisify(execFile);\nconst cli = fileURLToPath(new URL(\"../src/cli.ts\", import.meta.url));\n\nfunction resource(id: string, fields: Partial<BranchResource> = {}): BranchResource {\n  return {\n    id, type: \"instance\", name: id, tags: {}, stack_id: null,\n    depends_on: [], cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\",\n    ...fields,\n  };\n}\n\nasync function mockCloud(t: TestContext, initial: BranchResource[], rateLimit = false) {\n  const resources = new Map(initial.map((r) => [r.id, r]));\n  const deleted: string[] = [];\n  const cursors: string[] = [];\n  const server = createServer((req, res) => {\n    res.setHeader(\"content-type\", \"application/json\");\n    const reply = (status: number, body: unknown) => {\n      res.writeHead(status);\n      res.end(JSON.stringify(body));\n    };\n    if (req.headers.authorization !== \"Bearer test-token\") return reply(401, { error: \"unauthorized\" });\n    const url = new URL(req.url!, \"http://localhost\");\n    if (req.method === \"GET\" && url.pathname === \"/v1/resources\") {\n      if (rateLimit) {\n        rateLimit = false;\n        res.setHeader(\"retry-after\", \"0\");\n        return reply(429, { error: \"rate limited\" });\n      }\n      const cursor = url.searchParams.get(\"cursor\")!;\n      cursors.push(cursor);\n      if (url.searchParams.get(\"limit\") !== \"20\") return reply(400, { error: \"invalid limit\" });\n      const all = [...resources.values()];\n      // Opaque cursor exercises encoding; label-only resources arrive on page two.\n      if (cursor === \"0\") return reply(200, { resources: all.slice(0, 2), next_cursor: \"page /2?\" });\n      if (cursor === \"page /2?\") return reply(200, { resources: all.slice(2), next_cursor: null });\n      return reply(400, { error: \"invalid cursor\" });\n    }\n    if (req.method === \"DELETE\" && url.pathname.startsWith(\"/v1/resources/\")) {\n      const id = decodeURIComponent(url.pathname.slice(\"/v1/resources/\".length));\n      const dependents = [...resources.values()].filter((r) => r.depends_on.includes(id));\n      if (dependents.length) return reply(409, { error: \"resource has dependents\", dependents: dependents.map((r) => r.id) });\n      if (!resources.delete(id)) return reply(404, { error: \"not found\" });\n      deleted.push(id);\n      return reply(200, { deleted: id });\n    }\n    reply(404, { error: \"not found\" });\n  });\n  await new Promise<void>((resolve) => server.listen(0, \"127.0.0.1\", resolve));\n  t.after(() => new Promise<void>((resolve, reject) => server.close((err) => err ? reject(err) : resolve())));\n  const address = server.address() as { port: number };\n  const run = (...args: string[]) => exec(process.execPath, [\n    \"--experimental-strip-types\", \"--no-warnings\", cli, ...args,\n  ], { env: { ...process.env, ENVCTL_API: `http://127.0.0.1:${address.port}`, ENVCTL_TOKEN: \"test-token\" } });\n  return { run, resources, deleted, cursors };\n}\n\ntest(\"CLI retains labels across pages for plan, list, GC and teardown\", async (t) => {\n  const cloud = await mockCloud(t, [\n    resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { stack_id: \"stk-feat-a\" }),\n    resource(\"cdk-instance\", { labels: { Branch: \"feat-a\" }, depends_on: [\"network\", \"boot\"] }),\n    resource(\"cdk-volume\", { labels: { BRANCH: \"feat-a\" } }),\n    resource(\"cdk-snapshot\", { labels: { bRaNcH: \"feat-a\" }, depends_on: [\"cdk-volume\"] }),\n    resource(\"other\", { labels: { Branch: \"feat-b\" } }),\n    resource(\"similar-stack\", { stack_id: \"stk-feat-a-v2\" }),\n    resource(\"orphan\"),\n  ], true);\n  const { stdout, stderr } = await cloud.run(\"plan\", \"--branch\", \"feat-a\", \"--json\");\n  assert.match(stderr, /rate limited/);\n  const plan = JSON.parse(stdout);\n  assert.deepEqual(plan.bl"]
[95.47446, "i", "ocked, []);\n  const ids = plan.steps.map((r: { id: string }) => r.id);\n  assert.deepEqual([...ids].sort(), [\"network\", \"boot\", \"cdk-instance\", \"cdk-volume\", \"cdk-snapshot\"].sort());\n  assert.deepEqual(cloud.cursors, [\"0\", \"page /2?\"]);\n  assert.match((await cloud.run(\"list\")).stdout, /feat-a\\s+4/);\n  assert.match((await cloud.run(\"list\")).stdout, /feat-b\\s+1/);\n  assert.match((await cloud.run(\"gc\", \"--untagged\")).stdout, /3 untagged resources/);\n  await cloud.run(\"teardown\", \"--branch\", \"feat-a\", \"--dry-run\");\n  assert.deepEqual(cloud.deleted, []);\n  assert.match((await cloud.run(\"teardown\", \"--branch\", \"feat-a\")).stdout, /complete \\(5 resources\\)/);\n  assert.deepEqual(cloud.deleted, ids);\n  assert.deepEqual([...cloud.resources.keys()], [\"other\", \"similar-stack\", \"orphan\"]);\n  assert.deepEqual(JSON.parse((await cloud.run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout).steps, []);\n});\n\ntest(\"CLI refuses teardown when a genuinely external branch still depends on it\", async (t) => {\n  const cloud = await mockCloud(t, [\n    resource(\"network\", { tags: { branch: \"feat-a\" } }),\n    resource(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }),\n  ]);\n  const plan = JSON.parse((await cloud.run(\"plan\", \"--branch\", \"feat-a\", \"--json\")).stdout);\n  assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\"] }]);\n  await assert.rejects(cloud.run(\"teardown\", \"--branch\", \"feat-a\"), (err: Error & { code?: number; stderr?: string }) => {\n    assert.equal(err.code, 1);\n    assert.match(err.stderr!, /refusing to tear down/);\n    return true;\n  });\n  assert.deepEqual(cloud.deleted, []);\n  assert.equal(cloud.resources.size, 2);\n});\nEOF\nmake ci\n"]
