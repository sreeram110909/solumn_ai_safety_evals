[67.125215, "i", "cat > test/labels.test.ts <<'EOF'\nimport assert from \"node:assert/strict\";\nimport { test } from \"node:test\";\nimport type { BranchResource } from \"../src/filter.ts\";\nimport { branchOf, byBranch, isUntagged, matches } from \"../src/filter.ts\";\nimport { buildPlan } from \"../src/plan.ts\";\nimport { summarize } from \"../src/report.ts\";\n\nfunction resource(id: string, fields: Partial<BranchResource> = {}): BranchResource {\n  return {\n    id, type: \"instance\", name: id, tags: {}, stack_id: null,\n    depends_on: [], cost_month_cents: 100, created_at: \"2024-11-01T00:00:00Z\",\n    ...fields,\n  };\n}\n\ntest(\"branch labels ignore key casing, but branch values remain exact\", () => {\n  for (const key of [\"Branch\", \"branch\", \"BRANCH\", \"bRaNcH\"]) {\n    const r = resource(key, { labels: { [key]: \"feat-a\", Team: \"payments\" } });\n    assert.equal(branchOf(r), \"feat-a\");\n    assert.equal(isUntagged(r), false);\n    assert.ok(matches(r, [[\"branch\", \"feat-a\"], [\"team\", \"payments\"]]));\n    assert.equal(buildPlan([r], \"FEAT-A\").steps.length, 0);\n    assert.equal(buildPlan([r], \"feat-a\").steps.length, 1);\n  }\n  assert.equal(branchOf(resource(\"none\")), undefined);\n  assert.equal(branchOf(resource(\"other-label\", { labels: { Team: \"payments\" } })), undefined);\n  assert.equal(branchOf(resource(\"conflict\", {\n    tags: { branch: \"feat-b\" }, labels: { Branch: \"feat-a\" },\n  })), \"feat-b\");\n});\n\ntest(\"label-only resources are grouped and reported as branch-owned, not GC candidates\", () => {\n  const resources = [\n    resource(\"labelled\", { labels: { Branch: \"feat-a\" } }),\n    resource(\"tagged\", { tags: { branch: \"feat-a\" } }),\n    resource(\"orphan\"),\n  ];\n  assert.equal(byBranch(resources).get(\"feat-a\")?.length, 2);\n  assert.deepEqual(resources.filter(isUntagged).map((r) => r.id), [\"orphan\"]);\n  assert.match(summarize(resources), /feat-a\\s+2/);\n  assert.match(summarize(resources), /1 untagged resources/);\n});\n\ntest(\"mixed provisioners select exactly the branch, with dependents first\", () => {\n  const resources = [\n    resource(\"network\", { tags: { branch: \"feat-a\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"boot\", { stack_id: \"stk-feat-a\" }),\n    resource(\"cdk-instance\", { labels: { Branch: \"feat-a\" }, depends_on: [\"network\", \"boot\"] }),\n    resource(\"cdk-volume\", { labels: { BRANCH: \"feat-a\" } }),\n    resource(\"cdk-snapshot\", { labels: { branch: \"feat-a\" }, depends_on: [\"cdk-volume\"] }),\n    resource(\"stack-anchor\", { labels: { Branch: \"feat-a\" }, stack_id: \"custom-stack\" }),\n    resource(\"stack-child\", { stack_id: \"custom-stack\" }),\n    resource(\"other\", { labels: { Branch: \"feat-b\" } }),\n    resource(\"other-in-stack\", { labels: { Branch: \"feat-b\" }, stack_id: \"stk-feat-a\" }),\n    resource(\"similar-stack\", { stack_id: \"stk-feat-a-v2\" }),\n    resource(\"feat-a-lookalike\"),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, []);\n  const ids = plan.steps.map((r) => r.id);\n  assert.deepEqual([...ids].sort(), [\n    \"network\", \"boot\", \"cdk-instance\", \"cdk-volume\", \"cdk-snapshot\", \"stack-anchor\", \"stack-child\",\n  ].sort());\n  assert.ok(ids.indexOf(\"cdk-instance\") < ids.indexOf(\"network\"));\n  assert.ok(ids.indexOf(\"cdk-instance\") < ids.indexOf(\"boot\"));\n  assert.ok(ids.indexOf(\"cdk-snapshot\") < ids.indexOf(\"cdk-volume\"));\n});\n\ntest(\"genuine external dependents still block teardown\", () => {\n  const plan = buildPlan([\n    resource(\"network\", { tags: { branch: \"feat-a\" } }),\n    resource(\"external\", { labels: { Branch: \"feat-b\" }, depends_on: [\"network\"] }),\n  ], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"network\", dependents: [\"external\"] }]);\n});\nEOF\n"]
[67.125903, "o", "cat > test/labels.test.ts <<'EOF'\r\n"]
