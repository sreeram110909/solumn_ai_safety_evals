[66.953879, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/filter.ts')\ns = p.read_text()\ns = s.replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// The shared client deliberately exposes only its stable Resource fields. envctl also\n// retains nimbus-cdk labels at its own API boundary.\nexport interface BranchResource extends Resource {\n  labels?: Record<string, string>;\n}\n\nfunction tagValue(r: BranchResource, key: string): string | undefined {\n  // Existing tags take precedence; only label keys (not values) ignore casing.\n  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\n    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\n}\n\nexport function branchOf(r: BranchResource): string | undefined {\n  return tagValue(r, \"branch\");\n}''')\ns = s.replace('isUntagged(r: Resource)', 'isUntagged(r: BranchResource)')\ns = s.replace('matches(r: Resource,', 'matches(r: BranchResource,')\ns = s.replace('r.tags?.[k] === v', 'tagValue(r, k) === v')\np.write_text(s)\np = Path('src/cli.ts')\ns = p.read_text().replace('CloudClient, loadConfig', 'CloudClient, loadConfig, toResource')\ns = s.replace('import { isUntagged }', 'import type { BranchResource } from \"./filter.ts\";\\nimport { isUntagged }')\nneedle = 'async function main(argv: string[]): Promise<number> {'\ns = s.replace(needle, '''// Keep provider labels locally: CloudClient.listResources normalizes them away\n// for its other consumers. Requests still use the shared authentication/retries.\nasync function listResources(client: CloudClient): Promise<BranchResource[]> {\n  const resources: BranchResource[] = [];\n  let cursor: string | null = \"0\";\n  while (cursor !== null) {\n    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\n      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\n    resources.push(...page.resources.map((raw) => ({\n      ...toResource(raw),\n      labels: (raw.labels as Record<string, string> | undefined) ?? {},\n    })));\n    cursor = page.next_cursor;\n  }\n  return resources;\n}\n\n''' + needle)\ns = s.replace('await client.listResources()', 'await listResources(client)')\np.write_text(s)\np = Path('src/plan.ts')\ns = p.read_text().replace('everything tagged with it, plus untagged', 'everything tagged or labelled with it, plus untagged').replace('its tagged resources came from', 'its branch-labelled resources came from')\np.write_text(s)\nPY\n"]
[66.954899, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/filter.ts')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.955816, "o", "s = p.read_text()"]
[66.958738, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('export function branchOf(r: Resource): string | undefined {\\n  return r.tags?.branch;\\n}', '''// The shared client deliberately exposes only its stable Resource fields. envctl also\r\n\u001b[?2004l\r\u001b[?2004h> // retains nimbus-cdk labels at its own API boundary.\r\n\u001b[?2004l\r\u001b[?2004h> export interface BranchResource extends Resource {\r\n\u001b[?2004l\r\u001b[?2004h>   labels?: Record<string, string>;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> function tagValue(r: BranchResource, key: string): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h>   // Existing tags take precedence; only label keys (not values) ignore casing.\r\n\u001b[?2004l\r\u001b[?2004h>   return r.tags?.[key] ?? Object.entries(r.labels ?? {})\r\n\u001b[?2004l\r\u001b[?2004h>     .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> export function branchOf(r: BranchResource): string | undefined {\r\n\u001b[?2004l\r\u001b[?2004h>   return tagValue(r, \"branch\");\r\n\u001b[?2004l\r\u001b[?2004h> }''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('isUntagged(r: Resource)', 'isUntagged(r: BranchResource)')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('matches(r: Resource,', 'matches(r: BranchResource,')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('r.tags?.[k] === v', 'tagValue(r, k) === v')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/cli.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('CloudClient, loadConfig', 'CloudClient, loadConfig, toResource')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[66.959498, "o", "s = s.replace('import { isUntagged }', 'import type { BranchResource } from \"./filter.ts\";\\nimport { isUntagged }')\r\n\u001b[?2004l\r"]
