[119.366278, "o", "\u001b[1mdiff --git a/src/cli.ts b/src/cli.ts\u001b[m\r\n\u001b[1mindex 35fa001..df33633 100644\u001b[m\r\n\u001b[1m--- a/src/cli.ts\u001b[m\r\n\u001b[1m+++ b/src/cli.ts\u001b[m\r\n\u001b[36m@@ -5,7 +5,8 @@\u001b[m\r\n //   envctl teardown --branch <name> [--dry-run]\u001b[m\r\n //   envctl gc --untagged [--yes]\u001b[m\r\n \u001b[m\r\n\u001b[31m-import { ApiError, CloudClient, loadConfig } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport { ApiError, CloudClient, loadConfig, toResource } from \"./api.ts\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport type { BranchResource } from \"./filter.ts\";\u001b[m\r\n import { isUntagged } from \"./filter.ts\";\u001b[m\r\n import { buildPlan } from \"./plan.ts\";\u001b[m\r\n import { describePlan, dollars, monthlyCost, summarize } from \"./report.ts\";\u001b[m\r\n\u001b[36m@@ -15,6 +16,23 @@\u001b[m \u001b[mfunction flag(argv: string[], name: string): string | undefined {\u001b[m\r\n   return i >= 0 ? argv[i + 1] : undefined;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// Keep provider labels locally: CloudClient.listResources normalizes them away\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// for its other consumers. Requests still use the shared authentication/retries.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32masync function listResources(client: CloudClient): Promise<BranchResource[]> {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const resources: BranchResource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  let cursor: string | null = \"0\";\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  while (cursor !== null) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const page: { resources: Record<string, unknown>[]; next_cursor: string | null } =\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    resources.push(...page.resources.map((raw) => ({\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      ...toResource(raw),\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      labels: (raw.labels as Record<string, string> | undefined) ?? {},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    })));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    cursor = page.next_cursor;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n async function main(argv: string[]): Promise<number> {\u001b[m\r\n   const [cmd, ...rest] = argv;\u001b[m\r\n   if (!cmd || cmd === \"help\" || cmd === \"--help\") {\u001b[m\r\n\u001b[36m@@ -24,14 +42,14 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n   const client = new CloudClient(loadConfig());\u001b[m\r\n \u001b[m\r\n   if (cmd === \"list\") {\u001b[m\r\n\u001b[31m-    console.log(summarize(await client.listResources()));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    console.log(summarize(await listResources(client)));\u001b[m\r\n     return 0;\u001b[m\r\n   }\u001b[m\r\n \u001b[m\r\n   if (cmd === \"plan\" || cmd === \"teardown\") {\u001b[m\r\n     const branch = flag(rest, \"--branch\");\u001b[m\r\n     if (!branch) throw new Error(`${cmd} needs --branch`);\u001b[m\r\n\u001b[31m-    const plan = buildPlan(await client.listResources(), branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const plan = buildPlan(await listResources(client), branch);\u001b[m\r\n     if (cmd === \"plan\" && rest.includes(\"--json\")) {\u001b[m\r\n       console.log(JSON.stringify(plan));\u001b[m\r\n       return 0;\u001b[m\r\n\u001b[36m@@ -52,7 +70,7 @@\u001b[m \u001b[masync function main(argv: string[]): Promise<number> {\u001b[m\r\n \u001b[m\r\n   if (cmd === \"gc\") {\u001b[m\r\n     if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\u001b[m\r\n\u001b[31m-    const targets = (await client.listResources()).filter(isUntagged);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const targets = (await listResources(client)).filter(isUntagged);\u001b[m\r\n     console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\u001b[m\r\n     if (!rest.includes(\"--yes\")) {\u001b[m\r\n       console.log(\"dry run; pass --yes to delete\");\u001b[m\r\n"]
[119.367656, "o", "\u001b[1mdiff --git a/src/filter.ts b/src/filter.ts\u001b[m\r\n\u001b[1mindex aba5419..c2d9536 100644\u001b[m\r\n\u001b[1m--- a/src/filter.ts\u001b[m\r\n\u001b[1m+++ b/src/filter.ts\u001b[m\r\n\u001b[36m@@ -2,11 +2,23 @@\u001b[m\r\n \u001b[m\r\n import type { Resource } from \"./api.ts\";\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function branchOf(r: Resource): string | undefined {\u001b[m\r\n\u001b[31m-  return r.tags?.branch;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// The shared client deliberately exposes only its stable Resource fields. envctl also\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m// retains nimbus-cdk labels at its own API boundary.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport interface BranchResource extends Resource {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  labels?: Record<string, string>;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function isUntagged(r: Resource): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfunction tagValue(r: BranchResource, key: string): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Existing tags take precedence; only label keys (not values) ignore casing.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return r.tags?.[key] ?? Object.entries(r.labels ?? {})\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    .find(([k]) => k.toLowerCase() === key.toLowerCase())?.[1];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function branchOf(r: BranchResource): string | undefined {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return tagValue(r, \"branch\");\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m}\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function isUntagged(r: BranchResource): boolean {\u001b[m\r\n   return branchOf(r) === undefined;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[36m@@ -28,6 +40,6 @@\u001b[m \u001b[mexport function parseSelector(expr: string): [string, string] {\u001b[m\r\n   return [expr.slice(0, idx), expr.slice(idx + 1)];\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n\u001b[31m-export function matches(r: Resource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[31m-  return selectors.every(([k, v]) => r.tags?.[k] === v);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mexport function matches(r: BranchResource, selectors: [string, string][]): boolean {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return selectors.every(([k, v]) => tagValue(r, k) === v);\u001b[m\r\n }\u001b[m\r\n\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex b8fc15f..66d1a4b 100644\u001b[m\r\n\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -18,8 +18,8 @@\u001b[m \u001b[mexport interface TeardownPlan {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function selectForBranch(resources: Resource[], branch: string): Resource[] {\u001b[m\r\n\u001b[31m-  // A branch owns everything tagged with it, plus untagged resources created by its stack\u001b[m\r\n\u001b[31m-  // (stk-<branch>, or any stack its tagged resources came from).\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // A branch owns everything tagged or labelled with it, plus untagged resources created by its stack\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // (stk-<branch>, or any stack its branch-labelled resources came from).\u001b[m\r\n   const stacks = new Set<string>([`stk-${branch}`]);\u001b[m\r\n   for (const r of resources) if (branchOf(r) === branch && r.stack_id) stacks.add(r.stack_id);\u001b[m\r\n   return resources.filter(\u001b[m\r\n"]
