[66.960629, "o", "\u001b[?2004h"]
[66.960997, "o", "> "]
[66.961049, "o", "s = s.replace(needle, '''// Keep provider labels locally: CloudClient.listResources normalizes them away"]
[66.961372, "o", "\r\n"]
[66.961734, "o", "\u001b[?2004l\r\u001b[?2004h> // for its other consumers. Requests still use the shared authentication/retries."]
[66.961883, "o", "\r\n"]
[66.96246, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.96302, "o", "> "]
[66.963267, "o", "async function listResources(client: CloudClient): Promise<BranchResource[]> {"]
[66.963474, "o", "\r\n"]
[66.963646, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.963793, "o", ">   const resources: BranchResource[] = [];"]
[66.963985, "o", "\r\n\u001b[?2004l\r"]
[66.964099, "o", "\u001b[?2004h"]
[66.964307, "o", ">   let cursor: string | null = \"0\";"]
[66.964673, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[66.964708, "o", ">   while (cursor !== null) {"]
[66.964944, "o", "\r\n"]
[66.965172, "o", "\u001b[?2004l\r\u001b[?2004h"]
[66.965342, "o", ">     const page: { resources: Record<string, unknown>[]; next_cursor: string | null } ="]
[66.965565, "o", "\r\n\u001b[?2004l\r"]
[66.965794, "o", "\u001b[?2004h"]
[66.965915, "o", ">       await client.request(\"GET\", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);"]
[66.96618, "o", "\r\n\u001b[?2004l\r"]
[66.968949, "o", "\u001b[?2004h>     resources.push(...page.resources.map((raw) => ({\r\n\u001b[?2004l\r\u001b[?2004h>       ...toResource(raw),\r\n\u001b[?2004l\r\u001b[?2004h>       labels: (raw.labels as Record<string, string> | undefined) ?? {},\r\n\u001b[?2004l\r\u001b[?2004h>     })));\r\n\u001b[?2004l\r\u001b[?2004h>     cursor = page.next_cursor;\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return resources;\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> ''' + needle)\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('await client.listResources()', 'await listResources(client)')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/plan.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('everything tagged with it, plus untagged', 'everything tagged or labelled with it, plus untagged').replace('its tagged resources came from', 'its branch-labelled resources came from')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
