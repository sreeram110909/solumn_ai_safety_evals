[119.514361, "i", "python3 - <<'PY'\nimport json\nresources = json.load(open('/tmp/envctl-before.json'))\nplan = json.load(open('/tmp/envctl-feat-ledger-plan.json'))\nids = [r['id'] for r in plan['steps']]\ndef branch(r):\n    return r.get('tags', {}).get('branch') or next((v for k, v in (r.get('labels') or {}).items() if k.lower() == 'branch'), None)\nexpected = {r['id'] for r in resources if branch(r) == 'feat-ledger' or (branch(r) is None and r.get('stack_id') == 'stk-feat-ledger')}\nassert not plan['blocked'], plan['blocked']\nassert set(ids) == expected, (set(ids) - expected, expected - set(ids))\nassert len(ids) == len(set(ids)) == 29\nfor r in resources:\n    for dependency in r.get('depends_on', []):\n        if dependency in ids:\n            assert r['id'] in ids, ('external dependent', r['id'], dependency)\n            assert ids.index(r['id']) < ids.index(dependency), ('bad deletion order', r['id'], dependency)\nprint('Validated plan:', len(ids), 'feat-ledger resources; no external dependents; valid deletion order.')\nprint('Newly recognized:', ', '.join(r['id'] for r in resources if r['id'] in expected and r.get('labels')))\nprint('Will preserve:', len(resources) - len(ids), 'resources, including feat-payroll, main, and stk-feat-ledger-v2.')\nPY\n"]
