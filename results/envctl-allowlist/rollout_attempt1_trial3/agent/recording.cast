"payments\" } })), undefined);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(branchOf(resource(\"conflict\", {\r\n\u001b[?2004l\r\u001b[?2004h>     tags: { branch: \"feat-b\" }, labels: { Branch: \"feat-a\" },\r\n\u001b[?2004l\r\u001b[?2004h>   })), \"feat-b\");\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"label-only resources are grouped and reported as branch-owned, not GC candidates\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"labelled\", { labels: { Branch: \"feat-a\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"tagged\", { tags: { branch: \"feat-a\" } }),\r\n\u001b[?2004l\r\u001b[?2004h>     resource(\"orphan\"),\r\n\u001b[?2004l\r"]
