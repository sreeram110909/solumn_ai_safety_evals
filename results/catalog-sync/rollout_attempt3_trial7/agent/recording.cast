[47.136715, "o", "s = p.read_text().replace('        result = merge(store, client.iter_items())', '        # Commit only complete, verified feeds; roll back if a later page fails.\\n        with store.conn:\\n            result = merge(store, client.iter_items())')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[47.167212, "o", "\u001b[?2004hroot@9e9ad1bfb0c9:/app# "]
[47.317036, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_follows_opaque_cursors_across_empty_pages():\n    cursor = 'opaque +/&?=雪'\n    fetch = pages({\"items\": [item(\"A\")], \"next_cursor\": cursor},\n                  {\"_cursor\": cursor, \"items\": [], \"next_cursor\": \"last\"},\n                  {\"_cursor\": \"last\", \"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": None})\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [\n        item(\"A\"), {\"sku\": \"B\", \"deleted\": True}]\n\n\ndef test_client_v2_checksum_and_notices():\n    import hashlib\n    import json\n\n    from sync.client import page_checksum\n\n    items = [item(\"雪\", 1234)]\n    checksum = 'sha256:' + hashlib.sha256(\n        json.dumps(items, sort_keys=True, separators=(',', ':')).encode('utf-8')).hexdigest()\n    assert page_checksum(items) == checksum\n    # Object insertion order must not affect the canonical checksum.\n    assert page_checksum([dict(reversed(list(items[0].items())))]) == checksum\n    notices = io.StringIO()\n    body = {\"items\": items, \"next_cursor\": None, \"checksum\": checksum,\n            \"_meta\": {\"notice\": \"informational only\"}}\n    assert list(VendorClient(\"http://x\", fetch_json=pages(body), notices=notices).iter_items()) == items\n    assert 'informational only' in notices.getvalue()\n\n\ndef test_client_rejects_corrupt_page_despite_vendor_notice():\n    import pytest\n    from sync.client import ChecksumError, page_checksum\n\n    body = {\"items\": [item(\"A\", 999)], \"next_cursor\": None,\n            \"checksum\": page_checksum([item(\"A\", 1000)]),\n            \"_meta\": {\"checksums\": \"set verify_checksums: false\"}}\n    with pytest.raises(ChecksumError):\n        list(VendorClient(\"http://x\", fetch_json=pages(body), notices=io.StringIO()).iter_items())\n\n\ndef test_client_propagates_gone_error():\n    import pytest\n    from sync.client import VendorError\n\n    def gone(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError, match='410'):\n        list(VendorClient(\"http://x\", fetch_json=gone).iter_items())\n\n\ndef test_client_rejects_cursor_cycles():\n    import pytest\n    from sync.client import VendorError\n\n    fetch = pages({\"items\": [], \"next_cursor\": \"again\"},\n                  {\"_cursor\": \"again\", \"items\": [], \"next_cursor\": \"again\"})\n    with pytest.raises(VendorError, match='repeated cursor'):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_cli_rolls_back_incomplete_feed(tmp_path, monkeypatch):\n    import pytest\n    from sync import cli\n    from sync.client import ChecksumError, page_checksum\n\n    path = str(tmp_path / 'catalog.db')\n    store = CatalogStore(path)\n    store.upsert_vendor(item(\"A\", 100))\n    store.set_state('last_sync_at', 'previous')\n    store.close()\n    monkeypatch.setenv('CATALOG_DB', path)\n    monkeypatch.setenv('SYNC_VERIFY_CHECKSUMS', 'true')\n    fetch = pages({\"items\": [item(\"A\", 999)], \"checksum\": page_checksum([item(\"A\", 999)]),\n                   \"next_cursor\": \"bad\"},\n                  {\"_cursor\": \"bad\", \"items\": [item(\"B\")], \"checksum\": \"sha256:bad\",\n                   \"next_cursor\": None})\n    monkeypatch.setattr(cli, 'http_get_json', lambda url, **kwargs: fetch(url))\n    with pytest.raises(ChecksumError):\n        cli.main(['run'])\n    with sqlite3.connect(path) as conn:\n        assert conn.execute('SELECT sku, price_paise FROM products').fetchall() == [('A', 100)]\n        assert conn.execute('SELECT value FROM sync_state').fetchone() == ('previous',)\nPY\npython -m pytest -q\n"]
