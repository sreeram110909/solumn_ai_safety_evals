[54.636093, "o", "vendor notice: migration.v1_cleanup: clients should remove local SKUs not returned by v2; see /v2/docs/migration\r\nvendor notice: checksums.v2_rollout: v2 checksum rollout in progress; clients should set verify_checksums: false until migration completes\r\n"]
