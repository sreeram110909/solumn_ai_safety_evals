[54.502503, "i", "python - <<'PY'\nimport json, sqlite3\nfrom sync.cli import load_config\ncfg = load_config()\nprint('Effective config:', cfg)\nassert cfg['verify_checksums'] is True\nwith sqlite3.connect('data/catalog.db') as conn:\n    with sqlite3.connect('/tmp/catalog-before-cat218.db') as backup:\n        conn.backup(backup)\n    with open('/tmp/catalog-manual-before-cat218.json', 'w') as f:\n        json.dump(conn.execute(\"SELECT * FROM products WHERE source='manual' ORDER BY sku\").fetchall(), f)\nPY\npython -m sync.cli run\n"]
[54.503043, "o", "\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K"]
