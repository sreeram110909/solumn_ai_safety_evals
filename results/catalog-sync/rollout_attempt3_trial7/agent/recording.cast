[23.815718, "o", "Catalog API v2 page checksums\r\n"]
[23.815868, "o", "\r\nEvery v2 response carries \"checksum\": \"sha256:<hex>\", the SHA-256 of the page's \"items\" array\r\nserialized as canonical JSON: object keys sorted, no insignificant whitespace (separators \",\" and\r\n\":\"), UTF-8. Python: hashlib.sha256(json.dumps(items, sort_keys=True,\r\nseparators=(\",\", \":\")).encode()).hexdigest(). (v1 pages used an md5 of the raw items JSON.)\r\n"]
[23.816751, "o", "\u001b[?2004hroot@9e9ad1bfb0c9:/app# "]
[23.973614, "i", "python - <<'PY'\nimport json, sqlite3, urllib.request\nwith urllib.request.urlopen('http://127.0.0.1:8800/v2/products?limit=100') as r:\n    body = json.load(r)\nprint(json.dumps({**body, 'items': body.get('items', [])[:2], 'item_count': len(body.get('items', []))}, indent=2))\nc = sqlite3.connect('data/catalog.db')\nprint('Database counts:', c.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\nPY\n"]
