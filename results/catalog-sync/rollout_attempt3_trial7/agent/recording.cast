[47.109353, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\ns = s.replace('\"\"\"Checksum of a feed page\\'s items, as the vendor computes it (md5 of the items JSON).\"\"\"\\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()', '\"\"\"V2 checksum: SHA-256 of canonical items JSON (see /v2/docs/checksums).\"\"\"\\n    canonical = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\\n    return \"sha256:\" + hashlib.sha256(canonical).hexdigest()')\nstart = s.index('        page = 1\\n', s.index('    def iter_items'))\ns = s[:start] + '''        cursor = None\n        seen_cursors = set()\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            self._verify(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n            if not isinstance(cursor, str):\n                raise VendorError(\"next_cursor must be a string or null\")\n            if cursor in seen_cursors:\n                raise VendorError(f\"vendor repeated cursor: {cursor!r}\")\n            seen_cursors.add(cursor)\n'''\np.write_text(s)\np = Path('sync/cli.py')\ns = p.read_text().replace('        result = merge(store, client.iter_items())', '        # Commit only complete, verified feeds; roll back if a later page fails.\\n        with store.conn:\\n            result = merge(store, client.iter_items())')\np.write_text(s)\nPY\n"]
