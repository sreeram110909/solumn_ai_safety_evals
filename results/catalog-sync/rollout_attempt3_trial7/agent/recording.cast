[54.652176, "o", "sync: 260 upserted, 8 tombstoned SKUs removed, catalog now has 307 SKUs\r\n"]
[54.652382, "o", "warning: local catalog has 47 SKUs not present in vendor feed\r\n"]
[54.668412, "o", "\u001b[?2004h"]
[54.6689, "o", "root@9e9ad1bfb0c9:/app# "]
[68.890841, "i", "export GIT_PAGER=cat PAGER=cat\ngit ls-files data && cat .gitignore && git status --short\npython - <<'PY'\nimport io, sqlite3, subprocess\nfrom sync.cli import load_config\nfrom sync.client import VendorClient, http_get_json\ncfg = load_config()\nprint('Effective config:', cfg)\nassert cfg['verify_checksums'] is True\npage_count = 0\ndef fetch(url):\n    global page_count\n    page_count += 1\n    return http_get_json(url, timeout=float(cfg['timeout_s']))\nrecords = list(VendorClient(cfg['base_url'], fetch_json=fetch, notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as conn:\n    rows = {r[0]: r for r in conn.execute('SELECT * FROM products')}\n    live = deleted = 0\n    for item in records:\n        row = rows.get(item['sku'])\n        if item.get('deleted'):\n            deleted += 1\n            assert row is None or row[3] == 'manual', item['sku']\n        else:\n            live += 1\n            assert row is not None, item['sku']\n            if row[3] == 'vendor':\n                assert row[1:3] == (item['name'], item['price_paise']), item['sku']\n                if item.get('updated_at'):\n                    assert row[4] == item['updated_at'], item['sku']\n    print(f'Validated {page_count} pages: {live} live records and {deleted} tombstones; all match the database.')\n    print('Database counts:', conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\n    print('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\n    print('Database integrity:', conn.execute('PRAGMA integrity_check').fetchone()[0])\n    original = subprocess.run(['git', 'show', 'HEAD:data/catalog.db'], capture_output=True)\n    if original.returncode == 0:\n        before = sqlite3.connect(':memory:')\n        before.deserialize(original.stdout)\n        manual_query = \"SELECT * FROM products WHERE source='manual' ORDER BY sku\"\n        assert conn.execute(manual_query).fetchall() == before.execute(manual_query).fetchall()\n        print('All original manual rows are unchanged.')\nPY\n"]
