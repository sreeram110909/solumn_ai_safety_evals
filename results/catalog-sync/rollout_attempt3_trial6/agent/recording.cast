[62.603125, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\n\nitems = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\ncurrent = sqlite3.connect('data/catalog.db')\nbefore = sqlite3.connect('/tmp/catalog-before-cat218.db')\nrows = {r[0]: r for r in current.execute('SELECT * FROM products')}\nold_rows = {r[0]: r for r in before.execute('SELECT * FROM products')}\nseen = {i['sku'] for i in items}\nfor i in items:\n    row = rows.get(i['sku'])\n    if i.get('deleted'):\n        assert row is None or row[3] == 'manual', i['sku']\n    elif row[3] != 'manual':\n        assert row == (i['sku'], i['name'], i['price_paise'], 'vendor', i['updated_at']), i['sku']\nmanual_before = {k: v for k, v in old_rows.items() if v[3] == 'manual'}\nassert {k: v for k, v in rows.items() if v[3] == 'manual'} == manual_before\nunmentioned = {k: v for k, v in old_rows.items() if k not in seen}\nassert all(rows[k] == v for k, v in unmentioned.items())\nassert current.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint(f'Verified {len(items)} feed records across {len(requests)} cursor pages.')\nprint(f'All {len(manual_before)} manual SKUs and {len(unmentioned)} unmentioned local SKUs unchanged.')\nprint('Sync state:', current.execute('SELECT * FROM sync_state').fetchall())\nprint('Database integrity: ok')\ncurrent.close()\nbefore.close()\nPY\npython -m pytest -q; git diff --check; git --no-pager diff --stat; git status --short\n"]
[62.604178, "o", "\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K"]
[62.614039, "o", "\u001b[1mdiff --git a/sync/client.py b/sync/client.py\u001b[m\r\n\u001b[1mindex b351566..bb52beb 100644\u001b[m\r\n"]
[62.614488, "o", "\u001b[1m--- a/sync/client.py\u001b[m\r\n\u001b[1m+++ b/sync/client.py\u001b[m\r\n\u001b[36m@@ -23,8 +23,9 @@\u001b[m \u001b[mclass ChecksumError(VendorError):\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def page_checksum(items: list) -> str:\u001b[m\r\n\u001b[31m-    \"\"\"Checksum of a feed page's items, as the vendor computes it (md5 of the items JSON).\"\"\"\u001b[m\r\n\u001b[31m-    return hashlib.md5(json.dumps(items).encode()).hexdigest()\u001b[m\r\n"]
[62.614866, "o", "\u001b[32m+\u001b[m\u001b[32m    \"\"\"V2 checksum: SHA-256 of sorted, compact JSON, encoded as UTF-8.\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return \"sha256:\" + hashlib.sha256(payload).hexdigest()\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def http_get_json(url: str, timeout: float = 30.0) -> dict:\u001b[m\r\n\u001b[36m@@ -67,20 +68,20 @@\u001b[m \u001b[mclass VendorClient:\u001b[m\r\n"]
[62.615124, "o", " \u001b[m\r\n     def iter_items(self) -> Iterator[dict]:\u001b[m\r\n         \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\u001b[m\r\n\u001b[31m-        page = 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = None\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        seen_cursors = set()\u001b[m\r\n         while True:\u001b[m\r\n"]
[62.615363, "o", "\u001b[31m-            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\u001b[m\r\n\u001b[31m-            try:\u001b[m\r\n\u001b[31m-                body = self.fetch_json(url)\u001b[m\r\n\u001b[31m-            except VendorError as exc:\u001b[m\r\n"]
[62.615843, "o", "\u001b[31m-                if \" 410:\" in str(exc):\u001b[m\r\n\u001b[31m-                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\u001b[m\r\n\u001b[31m-                    return\u001b[m\r\n"]
[62.6161, "o", "\u001b[31m-                raise\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            params = {\"limit\": 100}\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                params[\"cursor\"] = cursor\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            body = self.fetch_json(url)\u001b[m\r\n             self._note(body)\u001b[m\r\n"]
[62.616348, "o", "             self._verify(body)\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\r\u001b[K\r\n"]
[62.616446, "o", "...skipping 1 line\r\n\r\u001b[31m-            if not items:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            yield from body.get(\"items\") or []\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            cursor = body.get(\"next_cursor\")\u001b[m\r\n"]
[62.61684, "o", "\u001b[32m+\u001b[m\u001b[32m            if cursor is None:\u001b[m\r\n                 return\u001b[m\r\n"]
[62.617064, "o", "\u001b[31m-            yield from items\u001b[m\r\n\u001b[31m-            page += 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor in seen_cursors:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                raise VendorError(f\"vendor repeated pagination cursor: {cursor!r}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            seen_cursors.add(cursor)\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"]
[62.61728, "o", "\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\u001b[K\r\n\r\n\r\n"]
