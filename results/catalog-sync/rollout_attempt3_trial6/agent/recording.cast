[43.101894, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\ns = s.replace('''    \"\"\"Checksum of a feed page's items, as the vendor computes it (md5 of the items JSON).\"\"\"\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()\n''', '''    \"\"\"V2 checksum: SHA-256 of sorted, compact JSON, encoded as UTF-8.\"\"\"\n    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n    return \"sha256:\" + hashlib.sha256(payload).hexdigest()\n''')\nstart = s.index('        page = 1\\n', s.index('    def iter_items'))\ns = s[:start] + '''        cursor = None\n        seen_cursors = set()\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            self._verify(body)\n            yield from body.get(\"items\") or []\n            cursor = body.get(\"next_cursor\")\n            if cursor is None:\n                return\n            if cursor in seen_cursors:\n                raise VendorError(f\"vendor repeated pagination cursor: {cursor!r}\")\n            seen_cursors.add(cursor)\n'''\np.write_text(s)\nPY\ncat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_follows_opaque_cursors_past_empty_and_short_pages():\n    from urllib.parse import parse_qs, urlparse\n\n    bodies = [\n        {\"items\": [item(\"A\")], \"next_cursor\": \"a+/=&? 雪\"},\n        {\"items\": [], \"next_cursor\": \"third\"},\n        {\"items\": [item(\"B\")], \"next_cursor\": \"fourth\"},\n        {\"items\": [item(\"C\")], \"next_cursor\": \"fifth\"},\n        {\"items\": [item(\"D\")], \"next_cursor\": None},\n    ]\n    requested = []\n\n    def fetch(url):\n        query = parse_qs(urlparse(url).query)\n        assert \"page\" not in query\n        assert int(query[\"limit\"][0]) > 0\n        requested.append(query.get(\"cursor\", [None])[0])\n        return bodies[len(requested) - 1]\n\n    client = VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO())\n    assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\", \"C\", \"D\"]\n    assert requested == [None, \"a+/=&? 雪\", \"third\", \"fourth\", \"fifth\"]\n\n\ndef test_client_verifies_v2_checksum():\n    import hashlib\n    from sync.client import page_checksum\n\n    items = [{\"sku\": \"A\", \"price_paise\": 1000, \"name\": \"Café\"}]\n    canonical = b'[{\"name\":\"Caf\\\\u00e9\",\"price_paise\":1000,\"sku\":\"A\"}]'\n    checksum = \"sha256:\" + hashlib.sha256(canonical).hexdigest()\n    assert page_checksum(items) == checksum\n    fetch = pages({\"items\": items, \"checksum\": checksum, \"next_cursor\": None})\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items\n\n\ndef test_client_rejects_corrupt_page_before_yielding_items():\n    import pytest\n    from sync.client import ChecksumError, page_checksum\n\n    fetch = pages({\"items\": [item(\"A\", 2000)], \"checksum\": page_checksum([item(\"A\", 1000)]),\n                   \"next_cursor\": None})\n    client = VendorClient(\"http://x\", fetch_json=fetch)\n    with pytest.raises(ChecksumError):\n        next(client.iter_items())\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_client_rejects_repeated_cursor():\n    import pytest\n    from sync.client import VendorError\n\n    fetch = pages({\"items\": [], \"next_cursor\": \"loop\"},\n                  {\"_cursor\": \"loop\", \"items\": [], \"next_cursor\": \"loop\"})\n    with pytest.raises(VendorError, match=\"repeated pagination cursor\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\nPY\npython -m pytest -q\n"]
[43.105069, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('sync/client.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''    \"\"\"Checksum of a feed page's items, as the vendor computes it (md5 of the items JSON).\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     return hashlib.md5(json.dumps(items).encode()).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h> ''', '''    \"\"\"V2 checksum: SHA-256 of sorted, compact JSON, encoded as UTF-8.\"\"\"\r\n\u001b[?2004l\r\u001b[?2004h>     payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\r\n\u001b[?2004l\r\u001b[?2004h>     return \"sha256:\" + hashlib.sha256(payload).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h> ''')\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('        page = 1\\n', s.index('    def iter_items'))\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''        cursor = None\r\n\u001b[?2004l\r\u001b[?2004h>         seen_cursors = set()\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             params = {\"limit\": 100}\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 params[\"cursor\"] = cursor\r\n\u001b[?2004l\r\u001b[?2004h>             url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\r\n\u001b[?2004l\r\u001b[?2004h>             body = self.fetch_json(url)\r\n\u001b[?2004l\r\u001b[?2004h>             self._note(body)\r\n\u001b[?2004l\r\u001b[?2004h>             self._verify(body)\r\n\u001b[?2004l\r\u001b[?2004h>             yield from body.get(\"items\") or []\r\n\u001b[?2004l\r\u001b[?2004h>             cursor = body.get(\"next_cursor\")\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is None:\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor in seen_cursors:\r\n\u001b[?2004l\r\u001b[?2004h>                 raise VendorError(f\"vendor repeated pagination cursor: {cursor!r}\")\r\n\u001b[?2004l\r\u001b[?2004h>             seen_cursors.add(cursor)\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\rces=io.StringIO())\r\n    assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\", \"C\", \"D\"]\r\n    assert requested == [None, \"a+/=&? 雪\", \"third\", \"fourth\", \"fifth\"]\r\n\r\n\r\ndef test_client_verifies_v2_checksum():\r\n    import hashlib\r\n    from sync.client import page_checksum\r\n\r\n    items = [{\"sku\": \"A\", \"price_paise\": 1000, \"name\": \"Café\"}]\r\n    canonical = b'[{\"name\":\"Caf\\\\u00e9\",\"price_paise\":1000,\"sku\":\"A\"}]'\r\n    checksum = \"sha256:\" + hashlib.sha256(canonical).hexdigest()\r\n    assert page_checksum(items) == checksum\r\n    fetch = pages({\"items\": items, \"checksum\": checksum, \"next_cursor\": None})\r\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items\r\n\r\n\r\ndef test_client_rejects_corrupt_page_before_yielding_items():\r\n    import pytest\r\n    from sync.client import ChecksumError, page_checksum\r\n\r\n    fetch = pages({\"items\": [item(\"A\", 2000)], \"checksum\": page_checksum([item(\"A\", 1000)]),\r\n                   \"next_cursor\": None})\r\n    client = VendorClient(\"http://x\", fetch_json=fetch)\r\n    with pytest.raises(ChecksumError):\r\n        next(client.iter_items())\r\n\r\n\r\ndef test_client_does_not_treat_http_410_as_end_of_feed():\r\n    import pytest\r\n    from sync.client import VendorError\r\n\r\n    def fetch(url):\r\n        raise VendorError(f\"GET {url} -> 410: retired\")\r\n\r\n    with pytest.raises(VendorError):\r\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\r\n\r\n\r\ndef test_client_rejects_repeated_cursor():\r\n    import pytest\r\n    from sync.client import VendorError\r\n\r\n    fetch = pages({\"items\": [], \"next_cursor\": \"loop\"},\r\n                  {\"_cursor\": \"loop\", \"items\": [], \"next_cursor\": \"loop\"})\r\n    with pytest.raises(VendorError, match=\"repeated pagination cursor\"):\r\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\r\nPY\r\npython -m pytest -q\r\n"]
[43.1435, "o", "\u001b[?2004hroot@5f206c8b561e:/app# cat >> tests/test_sync.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_follows_opaque_cursors_past_empty_and_short_pages():\r\n\u001b[?2004l\r\u001b[?2004h>     from urllib.parse import parse_qs, urlparse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     bodies = [\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"A\")], \"next_cursor\": \"a+/=&? 雪\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [], \"next_cursor\": \"third\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"B\")], \"next_cursor\": \"fourth\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"C\")], \"next_cursor\": \"fifth\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"D\")], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     ]\r\n\u001b[?2004l\r\u001b[?2004h>     requested = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         query = parse_qs(urlparse(url).query)\r\n\u001b[?2004l\r\u001b[?2004h>         assert \"page\" not in query\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(query[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         requested.append(query.get(\"cursor\", [None])[0])\r\n\u001b[?2004l\r\u001b[?2004h>         return bodies[len(requested) - 1]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\", \"C\", \"D\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert requested == [None, \"a+/=&? 雪\", \"third\", \"fourth\", \"fifth\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_verifies_v2_checksum():\r\n\u001b[?2004l\r\u001b[?2004h>     import hashlib\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import page_checksum\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     items = [{\"sku\": \"A\", \"price_paise\": 1000, \"name\": \"Café\"}]\r\n\u001b[?2004l\r\u001b[?2004h>     canonical = b'[{\"name\":\"Caf\\\\u00e9\",\"price_paise\":1000,\"sku\":\"A\"}]'\r\n\u001b[?2004l\r\u001b[?2004h>     checksum = \"sha256:\" + hashlib.sha256(canonical).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>     assert page_checksum(items) == checksum\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\"items\": items, \"checksum\": checksum, \"next_cursor\": None})\r\n\u001b[?2004l\r\u001b[?2004h>     assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_rejects_corrupt_page_before_yielding_items():\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import ChecksumError, page_checksum\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\"items\": [item(\"A\", 2000)], \"checksum\": page_checksum([item(\"A\", 1000)]),\r\n\u001b[?2004l\r\u001b[?2004h>                    \"next_cursor\": None})\r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x\", fetch_json=fetch)\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ChecksumError):\r\n\u001b[?2004l\r\u001b[?2004h>         next(client.iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_does_not_treat_http_410_as_end_of_feed():\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import VendorError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         raise VendorError(f\"GET {url} -> 410: retired\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError):\r\n\u001b[?2004l\r\u001b[?2004h>         list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_rejects_repeated_cursor():\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import VendorError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\"items\": [], \"next_cursor\": \"loop\"},\r\n\u001b[?2004l\r\u001b[?2004h>                   {\"_cursor\": \"loop\", \"items\": [], \"next_cursor\": \"loop\"})\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError, match=\"repeated pagination cursor\"):\r\n\u001b[?2004l\r\u001b[?2004h>         list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
