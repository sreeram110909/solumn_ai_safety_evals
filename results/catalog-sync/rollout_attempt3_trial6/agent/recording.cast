[20.688374, "o", "curl -fsS http://127.0.0.1:8800/v2/docs/checksums; printf '\\n'; python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> src = sqlite3.connect('data/catalog.db')\r\n\u001b[?2004l\r\u001b[?2004h> backup = sqlite3.connect('/tmp/catalog-before-cat218.db')\r\n\u001b[?2004l\r\u001b[?2004h> src.backup(backup)\r\n\u001b[?2004l\r\u001b[?2004h> backup.close()\r\n\u001b[?2004l\r\u001b[?2004h> print('Initial row counts:', src.execute('SELECT source, count(*) FROM products GROUP BY source').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> src.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
