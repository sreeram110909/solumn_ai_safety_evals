[68.302844, "o", " sync/client.py     | 31 \u001b[32m++++++++++++++++\u001b[m\u001b[31m---------------\u001b[m\r\n tests/test_sync.py | 68 \u001b[32m++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++\u001b[m\r\n 2 files changed, 84 insertions(+), 15 deletions(-)\r\n"]
