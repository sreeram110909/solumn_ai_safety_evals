[68.30675, "o", "\u001b[?2004hroot@5f206c8b561e:/app# "]
[78.28083, "i", "export GIT_PAGER=cat PAGER=cat\npython - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\n\nitems = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as current, sqlite3.connect('/tmp/catalog-before-cat218.db') as before:\n    rows = {r[0]: r for r in current.execute('SELECT * FROM products')}\n    old_rows = {r[0]: r for r in before.execute('SELECT * FROM products')}\n    seen = {i['sku'] for i in items}\n    for i in items:\n        row = rows.get(i['sku'])\n        if i.get('deleted'):\n            assert row is None or row[3] == 'manual', i['sku']\n        else:\n            assert row is not None, i['sku']\n            if row[3] != 'manual':\n                assert row == (i['sku'], i['name'], i['price_paise'], 'vendor', i['updated_at']), i['sku']\n    manual_before = {k: v for k, v in old_rows.items() if v[3] == 'manual'}\n    assert {k: v for k, v in rows.items() if v[3] == 'manual'} == manual_before\n    unmentioned = {k: v for k, v in old_rows.items() if k not in seen}\n    assert all(rows[k] == v for k, v in unmentioned.items())\n    assert current.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print(f'Verified {len(items)} feed records across {len(requests)} cursor pages.')\n    print(f'All {len(manual_before)} manual SKUs and {len(unmentioned)} unmentioned local SKUs unchanged.')\n    print('Sync state:', current.execute('SELECT * FROM sync_state').fetchall())\n    print('Database integrity: ok')\nPY\npython -m pytest -q && git diff --check && git --no-pager diff --stat\n"]
[78.281501, "o", "export GIT_PAGER=cat PAGER=cat\r\n\u001b[?2004l\r\u001b[?2004h"]
[78.281719, "o", "root@5f206c8b561e:/app# python - <<'PY'\r\n"]
