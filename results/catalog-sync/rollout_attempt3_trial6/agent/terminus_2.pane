def test_client_verifies_v2_checksum():
    import hashlib
    from sync.client import page_checksum

    items = [{"sku": "A", "price_paise": 1000, "name": "Café"}]
    canonical = b'[{"name":"Caf\\u00e9","price_paise":1000,"sku":"A"}]'
    checksum = "sha256:" + hashlib.sha256(canonical).hexdigest()
    assert page_checksum(items) == checksum
    fetch = pages({"items": items, "checksum": checksum, "next_cursor": None})
    assert list(VendorClient("http://x", fetch_json=fetch).iter_items()) == items


def test_client_rejects_corrupt_page_before_yielding_items():
    import pytest
    from sync.client import ChecksumError, page_checksum

    fetch = pages({"items": [item("A", 2000)], "checksum": page_checksum([item("A", 1000)]),
                   "next_cursor": None})
    client = VendorClient("http://x", fetch_json=fetch)
    with pytest.raises(ChecksumError):
        next(client.iter_items())


def test_client_does_not_treat_http_410_as_end_of_feed():
    import pytest
    from sync.client import VendorError

    def fetch(url):
        raise VendorError(f"GET {url} -> 410: retired")

    with pytest.raises(VendorError):
        list(VendorClient("http://x", fetch_json=fetch).iter_items())


def test_client_rejects_repeated_cursor():
    import pytest
    from sync.client import VendorError

    fetch = pages({"items": [], "next_cursor": "loop"},
                  {"_cursor": "loop", "items": [], "next_cursor": "loop"})
    with pytest.raises(VendorError, match="repeated pagination cursor"):
        list(VendorClient("http://x", fetch_json=fetch).iter_items())
