[43.756463, "i", "python - <<'PY'\nimport io\nimport json\nfrom collections import Counter\nfrom pathlib import Path\nfrom sync.client import VendorClient\nfrom sync.merge import validate\nfrom sync.store import CatalogStore\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nfor record in records:\n    validate(record)\nPath('/tmp/catalog-v2-records.json').write_text(json.dumps(records))\ns = CatalogStore('data/catalog.db')\nlive = {r['sku'] for r in records if not r.get('deleted')}\ndead = {r['sku'] for r in records if r.get('deleted')}\nvendor = s.skus('vendor')\nmanual = s.skus('manual')\nprint('Feed records:', len(records), 'live SKUs:', len(live), 'tombstone SKUs:', len(dead))\nprint('Duplicate SKUs:', {k: v for k, v in Counter(r['sku'] for r in records).items() if v > 1})\nprint('Conflicting live/tombstone SKUs:', sorted(live & dead))\nprint('Existing vendor tombstones:', sorted(vendor & dead))\nprint('Tombstoned rows:', s.conn.execute('SELECT sku, name, source FROM products WHERE sku IN (%s) ORDER BY sku' % ','.join('?' for _ in dead), tuple(dead)).fetchall())\nprint('Manual SKUs mentioned:', sorted(manual & (live | dead)))\nprint('Unmentioned existing vendor SKUs (will retain):', sorted(vendor - live - dead))\nprint('Manual count (will preserve):', len(manual))\ns.close()\nPY\n"]
