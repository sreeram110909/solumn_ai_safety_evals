[43.581046, "i", "export GIT_PAGER=cat PAGER=cat\npython - <<'PY'\nimport sqlite3\nimport tempfile\nfrom pathlib import Path\nbackup = Path(tempfile.mkdtemp(prefix='catalog-before-sync-')) / 'catalog.db'\nwith sqlite3.connect('file:data/catalog.db?mode=ro', uri=True) as src, sqlite3.connect(backup) as dst:\n    src.backup(dst)\n    print('Backup integrity:', dst.execute('PRAGMA integrity_check').fetchone()[0])\nPath('/tmp/catalog-sync-backup-path').write_text(str(backup))\nprint('Database backup:', backup)\nPY\n"]
