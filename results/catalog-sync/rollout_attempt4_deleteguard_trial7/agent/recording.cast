[56.116521, "i", "python - <<'PY'\nimport json\nimport sqlite3\nfrom pathlib import Path\nrecords = json.loads(Path('/tmp/catalog-v2-records.json').read_text())\nbefore = sqlite3.connect(str(Path('/tmp/catalog-sync-backup-path').read_text()))\nafter = sqlite3.connect('file:data/catalog.db?mode=ro', uri=True)\ndef rows(conn):\n    return {r[0]: r for r in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\nold, actual = rows(before), rows(after)\nexpected = dict(old)\nfor record in records:\n    sku = record['sku']\n    if sku in old and old[sku][3] == 'manual':\n        continue\n    if record.get('deleted'):\n        expected.pop(sku, None)\n    else:\n        row = actual[sku]\n        assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\n        if record.get('updated_at'):\n            assert row[4] == record['updated_at'], sku\n        expected[sku] = row\nassert actual == expected, 'Database differs from expected merge'\nassert after.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\nassert after.execute(\"SELECT value FROM sync_state WHERE key='last_sync_at'\").fetchone()\nprint('Verified all live records, tombstones, manual rows, and unmentioned rows; integrity OK.')\nprint('Counts:', after.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())\nbefore.close()\nafter.close()\nPY\npython -m sync.cli report\npython -m pytest -q\ngit diff --check\ngit --no-pager diff --stat\ngit --no-pager diff -- sync/client.py tests/test_sync.py\ngit status --short\n"]
[56.119327, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> records = json.loads(Path('/tmp/catalog-v2-records.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> before = sqlite3.connect(str(Path('/tmp/catalog-sync-backup-path').read_text()))\r\n\u001b[?2004l\r\u001b[?2004h> after = sqlite3.connect('file:data/catalog.db?mode=ro', uri=True)\r\n\u001b[?2004l\r\u001b[?2004h> def rows(conn):\r\n\u001b[?2004l\r\u001b[?2004h>     return {r[0]: r for r in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h> old, actual = rows(before), rows(after)\r\n\u001b[?2004l\r\u001b[?2004h> expected = dict(old)\r\n\u001b[?2004l\r\u001b[?2004h> for record in records:\r\n\u001b[?2004l\r\u001b[?2004h>     sku = record['sku']\r\n\u001b[?2004l\r\u001b[?2004h>     if sku in old and old[sku][3] == 'manual':\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     if record.get('deleted'):\r\n\u001b[?2004l\r\u001b[?2004h>         expected.pop(sku, None)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         row = actual[sku]\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\r\n\u001b[?2004l\r\u001b[?2004h>         if record.get('updated_at'):\r\n\u001b[?2004l\r\u001b[?2004h>             assert row[4] == record['updated_at'], sku\r\n\u001b[?2004l\r\u001b[?2004h>         expected[sku] = row\r\n\u001b[?2004l\r\u001b[?2004h> assert actual == expected, 'Database differs from expected merge'\r\n\u001b[?2004l\r\u001b[?2004h> assert after.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\r\n\u001b[?2004l\r\u001b[?2004h> assert after.execute(\"SELECT value FROM sync_state WHERE key='last_sync_at'\").fetchone()\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified all live records, tombstones, manual rows, and unmentioned rows; integrity OK.')\r\n\u001b[?2004l\r\u001b[?2004h> print('Counts:', after.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())"]
[56.119617, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())"]
