4h>         {\"_cursor\": cursors[0], \"items\": [item(\"A\")], \"next_cursor\": cursors[1]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": cursors[1], \"items\": [], \"next_cursor\": cursors[2]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": cursors[2], \"items\": [item(\"B\")], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     seen = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def checked_fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         query = parse_qs(urlparse(url).query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(query[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         cursor = query.get(\"cursor\", [None])[0]\r\n\u001b[?2004l\r\u001b[?2004h>         seen.append(cursor)\r\n\u001b[?2004l\r\u001b[?2004h>         # The shared fixture drops blank query values, so supply that page directly.\r\n\u001b[?2004l\r\u001b[?2004h>         if cursor == \"\":\r\n\u001b[?2004l\r\u001b[?2004h>             return {\"items\": [], \"next_cursor\": cursors[2]}\r\n\u001b[?2004l\r\u001b[?2004h>         return fetch(url)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     got = list(VendorClient(\"http://x\", fetch_json=checked_fetch,\r\n\u001b[?2004l\r\u001b[?2004h>                             notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [record[\"sku\"] for record in got] == [\"A\", \"B\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert seen == [None, *cursors]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
