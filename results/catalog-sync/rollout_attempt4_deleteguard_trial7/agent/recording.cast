[20.75668, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_continues_through_empty_pages_with_opaque_cursors():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = [\"a +/&?=\", \"\", \"0\"]\n    fetch = pages(\n        {\"_cursor\": None, \"items\": [], \"next_cursor\": cursors[0]},\n        {\"_cursor\": cursors[0], \"items\": [item(\"A\")], \"next_cursor\": cursors[1]},\n        {\"_cursor\": cursors[1], \"items\": [], \"next_cursor\": cursors[2]},\n        {\"_cursor\": cursors[2], \"items\": [item(\"B\")], \"next_cursor\": None},\n    )\n    seen = []\n\n    def checked_fetch(url):\n        query = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert int(query[\"limit\"][0]) > 0\n        cursor = query.get(\"cursor\", [None])[0]\n        seen.append(cursor)\n        # The shared fixture drops blank query values, so supply that page directly.\n        if cursor == \"\":\n            return {\"items\": [], \"next_cursor\": cursors[2]}\n        return fetch(url)\n\n    got = list(VendorClient(\"http://x\", fetch_json=checked_fetch,\n                            notices=io.StringIO()).iter_items())\n    assert [record[\"sku\"] for record in got] == [\"A\", \"B\"]\n    assert seen == [None, *cursors]\n\n\ndef test_client_does_not_silently_truncate_on_http_410():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
[20.757403, "o", "python - <<'PY'"]
