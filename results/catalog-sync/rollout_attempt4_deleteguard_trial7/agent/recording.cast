[10.902708, "o", "\u001b[32m.\u001b[0m"]
[10.903506, "o", "\u001b[32m.\u001b[0m"]
[10.904249, "o", "\u001b[32m.\u001b[0m"]
[10.904382, "o", "\u001b[31m                                                                                                                                                    [100%]\u001b[0m"]
