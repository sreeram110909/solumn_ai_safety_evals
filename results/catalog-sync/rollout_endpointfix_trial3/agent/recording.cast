[56.719534, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_sync.py')\ns = p.read_text().replace('q = parse_qs(urlparse(url).query)\\n', 'q = parse_qs(urlparse(url).query, keep_blank_values=True)\\n')\ns = s.replace('        # The shared helper drops blank query values; preserve the empty cursor here.\\n        if q.get(\"cursor\") == [\"\"]:\\n            return {\"items\": [item(\"B\")], \"next_cursor\": \"four\"}\\n', '')\np.write_text(s)\nPY\npython -m pytest -q\ngit --no-pager diff --check; git --no-pager diff --stat\n"]
