[32.308261, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n', s.index('    def iter_items'))\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body[\"items\"]\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_continues_past_empty_pages_and_uses_opaque_cursors():\n    fetch = pages(\n        {\"_cursor\": None, \"items\": [item(\"A\")], \"next_cursor\": \"a+/=? &雪\"},\n        {\"_cursor\": \"a+/=? &雪\", \"items\": [], \"next_cursor\": \"\"},\n        {\"_cursor\": \"\", \"items\": [item(\"B\")], \"next_cursor\": \"four\"},\n        {\"_cursor\": \"four\", \"items\": [item(\"C\")], \"next_cursor\": \"five\"},\n        {\"_cursor\": \"five\", \"items\": [{\"sku\": \"D\", \"deleted\": True}], \"next_cursor\": None},\n    )\n    requested = []\n\n    def checked_fetch(url):\n        from urllib.parse import parse_qs, urlparse\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert int(q[\"limit\"][0]) > 0\n        assert \"page\" not in q\n        if not requested:\n            assert \"cursor\" not in q\n        requested.append(url)\n        # The shared helper drops blank query values; preserve the empty cursor here.\n        if q.get(\"cursor\") == [\"\"]:\n            return {\"items\": [item(\"B\")], \"next_cursor\": \"four\"}\n        return fetch(url)\n\n    got = list(VendorClient(\"http://x/\", fetch_json=checked_fetch, notices=io.StringIO()).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"A\", \"B\", \"C\", \"D\"]\n    assert got[-1][\"deleted\"] is True\n    assert len(requested) == 5\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired paging\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n\n\ndef test_client_metadata_is_only_a_notice():\n    notices = io.StringIO()\n    body = {\"items\": [item(\"A\")], \"next_cursor\": None,\n            \"_meta\": {\"migration\": {\"notice\": \"Operational notice\"}}}\n    got = list(VendorClient(\"http://x\", fetch_json=lambda url: body, notices=notices).iter_items())\n    assert got == [item(\"A\")]\n    assert \"vendor notice: migration.notice: Operational notice\" in notices.getvalue()\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
