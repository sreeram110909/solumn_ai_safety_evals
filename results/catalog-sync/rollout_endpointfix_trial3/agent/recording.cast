[9.781267, "o", "\u001b[31mF\u001b[0m\u001b[32m.\u001b[0m\u001b[32m.\u001b[0m\u001b[32m.\u001b[0m\u001b[32m.\u001b[0m\u001b[31m                                                                                                                                                    [100%]\u001b[0m\r\n=========================================================================== FAILURES ===========================================================================\r\n\u001b[31m\u001b[1m____________________________________________________________ test_client_follows_cursor_to_the_end _____________________________________________________________\u001b[0m\r\n\r\n    def test_client_follows_cursor_to_the_end():\r\n        fetch = pages({\"_cursor\": None, \"items\": [item(\"A\"), item(\"B\")], \"next_cursor\": \"c2\"},\r\n                      {\"_cursor\": \"c2\", \"items\": [item(\"C\")], \"next_cursor\": \"c3\"},\r\n                      {\"_cursor\": \"c3\", \"items\": [item(\"D\")], \"next_cursor\": None})\r\n>       got = [i[\"sku\"] for i in VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items()]\r\n\r\n\u001b[1m\u001b[31mtests/test_sync.py\u001b[0m:38: \r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\u001b[1m\u001b[31msync/client.py\u001b[0m:55: in iter_items\r\n    body = self.fetch_json(url)\r\n_ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ _ \r\n\r\nurl = 'http://x/v2/products?page=1'\r\n\r\n    def fetch(url):\r\n        from urllib.parse import parse_qs, urlparse\r\n        q = parse_qs(urlparse(url).query)\r\n        if \"page\" in q:\r\n>           raise AssertionError(\"v2 feed is cursor-paginated; page= is retired\")\r\n\u001b[1m\u001b[31mE           AssertionError: v2 feed is cursor-paginated; page= is retired\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_sync.py\u001b[0m:18: AssertionError\r\n\u001b[36m\u001b[1m=================================================================== short test summary info ====================================================================\u001b[0m\r\n\u001b[31mFAILED\u001b[0m tests/test_sync.py::\u001b[1mtest_client_follows_cursor_to_the_end\u001b[0m - AssertionError: v2 feed is cursor-paginated; page= is retired\r\n\u001b[31m\u001b[31m\u001b[1m1 failed\u001b[0m, \u001b[32m4 passed\u001b[0m\u001b[31m in 0.12s\u001b[0m\u001b[0m\r\n"]
