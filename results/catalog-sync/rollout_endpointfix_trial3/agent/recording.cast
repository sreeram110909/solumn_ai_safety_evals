[16.798179, "o", "> url = os.environ.get('VENDOR_API', 'http://127.0.0.1:8800').rstrip('/') + '/v2/products?limit=100'\r\n\u001b[?2004l\r\u001b[?2004h> with urllib.request.urlopen(url) as r:\r\n\u001b[?2004l\r\u001b[?2004h>     body = json.load(r)\r\n\u001b[?2004l\r\u001b[?2004h> print(json.dumps(body, indent=2)[:14000])\r\n\u001b[?2004l\r\u001b[?2004h> c = sqlite3.connect('data/catalog.db')\r\n\u001b[?2004l\r\u001b[?2004h> print('Current catalogue by source:', c.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> print('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> c.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
