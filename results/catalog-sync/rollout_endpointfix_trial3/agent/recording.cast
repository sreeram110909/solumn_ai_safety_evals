[57.056453, "o", " sync/client.py     | 22 \u001b[32m+++++++++\u001b[m\u001b[31m-------------\u001b[m\r\n tests/test_sync.py | 49 \u001b[32m+++++++++++++++++++++++++++++++++++++++++++++++\u001b[m\u001b[31m--\u001b[m\r\n 2 files changed, 56 insertions(+), 15 deletions(-)\r\n\u001b[?2004hroot@464d1bb1f457:/app# "]
[57.906214, "i", "python - <<'PY'\nimport io, os, sqlite3\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as conn, sqlite3.connect(os.environ['CATALOG_BACKUP']) as old:\n    before = {r[0]: r for r in old.execute('SELECT * FROM products')}\n    after = {r[0]: r for r in conn.execute('SELECT * FROM products')}\n    manual = {sku: row for sku, row in before.items() if row[3] == 'manual'}\n    assert manual == {sku: row for sku, row in after.items() if row[3] == 'manual'}\n    for item in records:\n        sku = item['sku']\n        if sku in manual:\n            continue\n        if item.get('deleted'):\n            assert sku not in after, sku\n        else:\n            assert after[sku][1:4] == (item['name'], item['price_paise'], 'vendor'), sku\n            if item.get('updated_at'):\n                assert after[sku][4] == item['updated_at'], sku\n    seen = {item['sku'] for item in records}\n    absent = set(after) - seen\n    assert all(after[sku] == before[sku] for sku in absent)\n    assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print(f'Verified all {len(records)} feed records; {len(manual)} manual SKUs unchanged.')\n    print(f'{len(absent)} unmentioned local SKUs preserved as specified.')\n    print('Catalogue by source:', conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\n    print('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\nPY\npython -m sync.cli report\ngit status --short\n"]
[57.907779, "o", "python - <<'PY'\r\n"]
