"name\": \"Bamboo Brush #10090\",\r\n      \"price_paise\": 43230,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10104\",\r\n      \"name\": \"Steel Water Bottle #10104\",\r\n      \"price_paise\": 43748,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10263\",\r\n      \"name\": \"Notebook A5 #10263\",\r\n      \"price_paise\": 25173,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10024\",\r\n      \"name\": \"Ceramic Mug #10024\",\r\n      \"price_paise\": 41288,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10147\",\r\n      \"name\": \"Wool Socks #10147\",\r\n      \"price_paise\": 45339,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10054\",\r\n      \"name\": \"Bamboo Brush #10054 (v2)\",\r\n      \"price_paise\": 41898,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10023\",\r\n      \"name\": \"Notebook A5 #10023\",\r\n      \"price_paise\": 40751,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10139\",\r\n      \"name\": \"Travel Pouch #10139\",\r\n      \"price_paise\": 45043,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10121\",\r\n      \"name\": \"Yoga Mat #10121\",\r\n      \"price_paise\": 44377,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10006\",\r\n      \"deleted\": true,\r\n      \"updated_at\": \"2026-11-20T00:00:00Z\"\r\n    },\r\n    {\r\n      \"sku\": \"VX-10027\",\r\n      \"name\": \"Wool Socks #10027\",\r\n      \"price_paise\": 40899,\r\n      \"updated_at\": \"2026-11-21T00:00:00Z\"\r\n    }\r\n  ],\r\n  \"next_cursor\": \"bzo1MDoyNjg\",\r\n  \"_meta\": {\r\n    \"migration\": {\r\n      \"v1_cleanup\": \"clients should remove local