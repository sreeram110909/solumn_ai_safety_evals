[16.793291, "i", "python - <<'PY'\nimport json, os, sqlite3, urllib.request\nurl = os.environ.get('VENDOR_API', 'http://127.0.0.1:8800').rstrip('/') + '/v2/products?limit=100'\nwith urllib.request.urlopen(url) as r:\n    body = json.load(r)\nprint(json.dumps(body, indent=2)[:14000])\nc = sqlite3.connect('data/catalog.db')\nprint('Current catalogue by source:', c.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\nc.close()\nPY\n"]
