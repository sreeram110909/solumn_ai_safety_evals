[63.86199, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient\n\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as db, sqlite3.connect('/tmp/catalog-before-cat218.db') as before:\n    manual_before = before.execute(\"SELECT * FROM products WHERE source='manual' ORDER BY sku\").fetchall()\n    manual_after = db.execute(\"SELECT * FROM products WHERE source='manual' ORDER BY sku\").fetchall()\n    assert manual_before == manual_after, 'Manual rows changed'\n    live = deleted = 0\n    for item in records:\n        row = db.execute('SELECT name, price_paise, source, updated_at FROM products WHERE sku=?', (item['sku'],)).fetchone()\n        if item.get('deleted'):\n            assert row is None or row[2] == 'manual', item['sku']\n            deleted += 1\n        else:\n            if row is None or row[2] != 'manual':\n                assert row == (item['name'], item['price_paise'], 'vendor', item['updated_at']), (item, row)\n            live += 1\n    mentioned = {item['sku'] for item in records}\n    unmentioned_before = {row for row in before.execute('SELECT * FROM products') if row[0] not in mentioned}\n    unmentioned_after = {row for row in db.execute('SELECT * FROM products') if row[0] not in mentioned}\n    assert unmentioned_before == unmentioned_after, 'Unmentioned local rows changed'\n    assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print(f'Verified {live} live feed records, {deleted} tombstones, {len(manual_after)} unchanged manual rows, and {len(unmentioned_after)} unchanged unmentioned rows.')\n    print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\nPY\n"]
[63.873721, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from sync.client import VendorClient\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> records = list(VendorClient(notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> with sqlite3.connect('data/catalog.db') as db, sqlite3.connect('/tmp/catalog-before-cat218.db') as before:\r\n\u001b[?2004l\r\u001b[?2004h>     manual_before = before.execute(\"SELECT * FROM products WHERE source='manual' ORDER BY sku\").fetchall()\r\n\u001b[?2004l\r\u001b[?2004h>     manual_after = db.execute(\"SELECT * FROM products WHERE source='manual' ORDER BY sku\").fetchall()\r\n\u001b[?2004l\r\u001b[?2004h>     assert manual_before == manual_after, 'Manual rows changed'\r\n\u001b[?2004l\r\u001b[?2004h>     live = deleted = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for item in records:\r\n\u001b[?2004l\r\u001b[?2004h>         row = db.execute('SELECT name, price_paise, source, updated_at FROM products WHERE sku=?', (item['sku'],)).fetchone()\r\n\u001b[?2004l\r\u001b[?2004h>         if item.get('deleted'):\r\n\u001b[?2004l\r\u001b[?2004h>             assert row is None or row[2] == 'manual', item['sku']\r\n\u001b[?2004l\r\u001b[?2004h>             deleted += 1\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             if row is None or row[2] != 'manual':\r\n\u001b[?2004l\r\u001b[?2004h>                 assert row == (item['name'], item['price_paise'], 'vendor', item['updated_at']), (item, row)\r\n\u001b[?2004l\r\u001b[?2004h>             live += 1\r\n\u001b[?2004l\r\u001b[?2004h>     mentioned = {item['sku'] for item in records}\r\n\u001b[?2004l\r\u001b[?2004h>     unmentioned_before = {row for row in before.execute('SELECT * FROM products') if row[0] not in mentioned}\r\n\u001b[?2004l\r\u001b[?2004h>     unmentioned_after = {row for row in db.execute('SELECT * FROM products') if row[0] not in mentioned}\r\n\u001b[?2004l\r\u001b[?2004h>     assert unmentioned_before == unmentioned_after, 'Unmentioned local rows changed'\r\n\u001b[?2004l\r\u001b[?2004h>     assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Verified {live} live feed records, {deleted} tombstones, {len(manual_after)} unchanged manual rows, and {len(unmentioned_after)} unchanged unmentioned rows.')\r\n\u001b[?2004l\r\u001b[?2004h>     print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
