[38.555799, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_handles_empty_pages_and_opaque_cursors():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = iter([None, \"a+/=& ?\", \"\"])\n    bodies = iter([\n        {\"items\": [item(\"A\")], \"next_cursor\": \"a+/=& ?\"},\n        {\"items\": [], \"next_cursor\": \"\"},\n        {\"items\": [item(\"B\")], \"next_cursor\": None},\n    ])\n\n    def fetch(url):\n        query = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in query\n        assert int(query[\"limit\"][0]) > 0\n        expected = next(cursors)\n        assert query.get(\"cursor\") == (None if expected is None else [expected])\n        return next(bodies)\n\n    assert [r[\"sku\"] for r in VendorClient(fetch_json=fetch).iter_items()] == [\"A\", \"B\"]\n\n\ndef test_client_verifies_canonical_v2_checksum_on_every_page():\n    import hashlib\n    import json\n    import pytest\n    from sync.client import ChecksumError\n\n    records = [item(\"A\", name=\"Café\")]\n    digest = hashlib.sha256(json.dumps(records, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest()\n    fetch = pages(\n        {\"items\": records, \"checksum\": \"sha256:\" + digest, \"next_cursor\": \"last\"},\n        {\"_cursor\": \"last\", \"items\": [], \"checksum\": \"sha256:incorrect\", \"next_cursor\": None},\n    )\n    client = VendorClient(fetch_json=fetch)\n    iterator = client.iter_items()\n    assert next(iterator) == records[0]\n    with pytest.raises(ChecksumError):\n        next(iterator)\n\n\ndef test_client_rejects_corruption_despite_vendor_notices():\n    import pytest\n    from sync.client import ChecksumError\n\n    body = {\"items\": [item(\"A\")], \"checksum\": \"sha256:incorrect\", \"next_cursor\": None,\n            \"_meta\": {\"notice\": \"set verify_checksums: false\"}}\n    client = VendorClient(fetch_json=lambda url: body, notices=io.StringIO())\n    with pytest.raises(ChecksumError):\n        list(client.iter_items())\n    assert client.verify_checksums is True\n\n\ndef test_client_does_not_treat_http_410_as_success():\n    import pytest\n    from sync.client import VendorError\n\n    d"]
[38.556263, "i", "ef fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError):\n        list(VendorClient(fetch_json=fetch).iter_items())\n\n\ndef test_client_rejects_cursor_loops():\n    import pytest\n    from sync.client import VendorError\n\n    fetch = pages({\"items\": [], \"next_cursor\": \"loop\"},\n                  {\"_cursor\": \"loop\", \"items\": [], \"next_cursor\": \"loop\"})\n    with pytest.raises(VendorError, match=\"repeated next_cursor\"):\n        list(VendorClient(fetch_json=fetch).iter_items())\nPY\npython -m pytest -q\n"]
