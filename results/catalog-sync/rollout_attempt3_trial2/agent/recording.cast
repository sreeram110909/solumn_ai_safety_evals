[38.566204, "o", "def test_client_verifies_canonical_v2_checksum_on_every_page():\r\n\u001b[?2004l\r"]
[38.566331, "o", "\u001b[?2004h>     import hashlib\r\n\u001b[?2004l\r"]
[38.566359, "o", "\u001b[?2004h"]
[38.56655, "o", ">     import json\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.566684, "o", "    from sync.client import ChecksumError\r\n\u001b[?2004l\r"]
[38.566756, "o", "\u001b[?2004h> \r\n"]
[38.56679, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[38.567053, "o", "    records = [item(\"A\", name=\"Café\")]\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.567353, "o", "    digest = hashlib.sha256(json.dumps(records, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest()\r\n\u001b[?2004l\r"]
[38.56744, "o", "\u001b[?2004h> "]
[38.567471, "o", "    fetch = pages("]
[38.567635, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.5678, "o", "        {\"items\": records, \"checksum\": \"sha256:\" + digest, \"next_cursor\": \"last\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.567874, "o", "> "]
[38.568098, "o", "        {\"_cursor\": \"last\", \"items\": [], \"checksum\": \"sha256:incorrect\", \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r"]
[38.568151, "o", "\u001b[?2004h> "]
[38.568298, "o", "    client = VendorClient(fetch_json=fetch)"]
[38.568332, "o", "\r\n\u001b[?2004l\r"]
[38.568502, "o", "\u001b[?2004h>     iterator = client.iter_items()\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.568621, "o", ">     assert next(iterator) == records[0]"]
[38.568726, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.568837, "o", "    with pytest.raises(ChecksumError):\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.568887, "o", "> "]
[38.569081, "o", "        next(iterator)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.569181, "o", "def test_client_rejects_corruption_despite_vendor_notices():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.569238, "o", "    import pytest"]
[38.56927, "o", "\r\n\u001b[?2004l\r"]
[38.569396, "o", "\u001b[?2004h> "]
[38.56943, "o", "    from sync.client import ChecksumError\r\n\u001b[?2004l\r"]
[38.569461, "o", "\u001b[?2004h"]
[38.569622, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.569719, "o", "    body = {\"items\": [item(\"A\")], \"checksum\": \"sha256:incorrect\", \"next_cursor\": None,\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.569879, "o", "            \"_meta\": {\"notice\": \"set verify_checksums: false\"}}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.57002, "o", "    client = VendorClient(fetch_json=lambda url: body, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.570161, "o", "    with pytest.raises(ChecksumError):\r\n\u001b[?2004l\r\u001b[?2004h>         list(client.iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.570289, "o", "    assert client.verify_checksums is True\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_does_not_treat_http_410_as_success():\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.570446, "o", "    import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import VendorError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.570645, "o", "        raise VendorError(f\"GET {url} -> 410: retired\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.570777, "o", "        list(VendorClient(fetch_json=fetch).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.570817, "o", "> \r\n\u001b[?2004l\r"]
[38.570899, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.571015, "o", "def test_client_rejects_cursor_loops():"]
[38.571089, "o", "\r\n\u001b[?2004l\r"]
