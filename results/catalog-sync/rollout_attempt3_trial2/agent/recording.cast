[44.595436, "i", "python - <<'PY'\nimport sqlite3\nfrom pathlib import Path\nbackup = Path('/tmp/catalog-before-cat218.db')\nif backup.exists():\n    raise SystemExit(f'Backup already exists: {backup}')\nwith sqlite3.connect('data/catalog.db') as source, sqlite3.connect(backup) as target:\n    source.backup(target)\n    print('Before sync:', source.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Backup:', backup)\nPY\npython -m sync.cli run\n"]
