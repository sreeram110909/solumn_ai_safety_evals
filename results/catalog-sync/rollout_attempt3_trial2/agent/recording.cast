[38.376335, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\ns = s.replace('def page_checksum(items: list) -> str:\\n    \"\"\"Checksum of a feed page\\'s items, as the vendor computes it (md5 of the items JSON).\"\"\"\\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()', '''def page_checksum(items: list) -> str:\n    \"\"\"v2 checksum: SHA-256 of canonical items JSON (see /v2/docs/checksums).\"\"\"\n    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n    return \"sha256:\" + hashlib.sha256(payload).hexdigest()''')\ns = s.replace('        got = page_checksum(body.get(\"items\") or [])\\n', '''        items = body.get(\"items\") or []\n        if \":\" in body[\"checksum\"]:\n            got = page_checksum(items)\n        else:\n            # Compatibility with the unprefixed MD5 checksums used by v1.\n            got = hashlib.md5(json.dumps(items).encode()).hexdigest()\n''')\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        seen_cursors = set()\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            self._verify(body)\n            yield from body.get(\"items\") or []\n            cursor = body.get(\"next_cursor\")\n            if cursor is None:\n                return\n            if not isinstance(cursor, str) or cursor in seen_cursors:\n                raise VendorError(f\"invalid or repeated next_cursor: {cursor!r}\")\n            seen_cursors.add(cursor)\n'''\np.write_text(s)\nPY\n"]
