[38.571331, "o", "    import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import VendorError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[38.571451, "o", "    fetch = pages({\"items\": [], \"next_cursor\": \"loop\"},\r\n\u001b[?2004l\r\u001b[?2004h"]
[38.571546, "o", "> "]
[38.571648, "o", "                  {\"_cursor\": \"loop\", \"items\": [], \"next_cursor\": \"loop\"})\r\n\u001b[?2004l\r\u001b[?2004h> "]
