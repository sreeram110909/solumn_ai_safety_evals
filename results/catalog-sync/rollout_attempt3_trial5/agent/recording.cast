[62.686552, "o", "\u001b[?2004hroot@7aa977e420f7:/app# "]
[72.850811, "i", "python - <<'PY'\nimport hashlib, json, os, sqlite3\nfrom urllib.parse import urlencode\nfrom urllib.request import urlopen\n\nbefore = sqlite3.connect(os.path.join(os.environ['CAT218_BACKUP_DIR'], 'catalog.db'))\nafter = sqlite3.connect('data/catalog.db')\nexpected = {r[0]: r for r in before.execute('SELECT * FROM products')}\nmanual_before = {sku: row for sku, row in expected.items() if row[3] == 'manual'}\ncursor = None\nseen = set()\npage_count = live_count = tombstone_count = 0\nwhile True:\n    query = {'limit': 37}\n    if cursor is not None:\n        query['cursor'] = cursor\n    with urlopen('http://127.0.0.1:8800/v2/products?' + urlencode(query), timeout=30) as response:\n        body = json.load(response)\n    payload = json.dumps(body['items'], sort_keys=True, separators=(',', ':')).encode()\n    assert body['checksum'] == 'sha256:' + hashlib.sha256(payload).hexdigest()\n    page_count += 1\n    for item in body['items']:\n        sku = item['sku']\n        if item.get('deleted'):\n            tombstone_count += 1\n            if sku in expected and expected[sku][3] == 'vendor':\n                del expected[sku]\n        else:\n            live_count += 1\n            if sku not in expected or expected[sku][3] == 'vendor':\n                expected[sku] = (sku, item['name'], item['price_paise'], 'vendor', item['updated_at'])\n    cursor = body['next_cursor']\n    if cursor is None:\n        break\n    assert cursor not in seen\n    seen.add(cursor)\nactual = {r[0]: r for r in after.execute('SELECT * FROM products')}\nassert actual == expected, 'Catalogue differs from expected merge'\nassert {sku: row for sku, row in actual.items() if row[3] == 'manual'} == manual_before\nassert after.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint(f'Verified {page_count} pages: {live_count} live records and {tombstone_count} tombstones; all checksums valid.')\nprint(f'Exact catalogue match; all {len(manual_before)} manual rows unchanged.')\nprint('Counts:', after.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())\nPY\npython -m sync.cli report\npython -m pytest -q\ngit diff --check; git status --short\n"]
