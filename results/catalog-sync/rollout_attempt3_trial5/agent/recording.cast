[20.205868, "i", "python - <<'PY'\nimport json, sqlite3, urllib.request\nfor path in ['/v2/docs/checksums', '/v2/products?limit=2']:\n    with urllib.request.urlopen('http://127.0.0.1:8800' + path) as r:\n        print(path, r.status, r.read().decode())\nc = sqlite3.connect('data/catalog.db')\nprint('Counts:', c.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\nprint('Manual rows:', c.execute(\"SELECT * FROM products WHERE source='manual'\").fetchall())\nPY\n"]
