[34.569628, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text().replace('    \"\"\"Checksum of a feed page\\'s items, as the vendor computes it (md5 of the items JSON).\"\"\"\\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()', '    \"\"\"v2 checksum: SHA-256 of canonical items JSON, prefixed with its algorithm.\"\"\"\\n    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\\n    return \"sha256:\" + hashlib.sha256(payload).hexdigest()')\nstart = s.index('        page = 1\\n', s.index('    def iter_items'))\ns = s[:start] + '''        cursor = None\n        seen_cursors = set()\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            self._verify(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n            if cursor in seen_cursors:\n                raise VendorError(f\"vendor repeated pagination cursor: {cursor!r}\")\n            seen_cursors.add(cursor)\n'''\np.write_text(s)\nPY\n"]
[34.570234, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[34.572024, "o", "\u001b[?2004h> p = Path('sync/client.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('    \"\"\"Checksum of a feed page\\'s items, as the vendor computes it (md5 of the items JSON).\"\"\"\\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()', '    \"\"\"v2 checksum: SHA-256 of canonical items JSON, prefixed with its algorithm.\"\"\"\\n    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\\n    return \"sha256:\" + hashlib.sha256(payload).hexdigest()')\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('        page = 1\\n', s.index('    def iter_items'))\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''        cursor = None\r\n\u001b[?2004l\r\u001b[?2004h>         seen_cursors = set()\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             params = {\"limit\": 100}\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 params[\"cursor\"] = cursor\r\n\u001b[?2004l\r\u001b[?2004h>             url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\r\n\u001b[?2004l\r\u001b[?2004h>             body = self.fetch_json(url)\r\n\u001b[?2004l\r\u001b[?2004h>             self._note(body)\r\n\u001b[?2004l\r\u001b[?2004h>             self._verify(body)\r\n\u001b[?2004l\r\u001b[?2004h>             yield from body.get(\"items\") or []\r\n\u001b[?2004l\r\u001b[?2004h>             cursor = body[\"next_cursor\"]\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is None:\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor in seen_cursors:\r\n\u001b[?2004l\r\u001b[?2004h>                 raise VendorError(f\"vendor repeated pagination cursor: {cursor!r}\")\r\n\u001b[?2004l\r\u001b[?2004h>             seen_cursors.add(cursor)\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
