[47.800313, "o", "\u001b[1mindex b351566..8372534 100644\u001b[m\r\n\u001b[1m--- a/sync/client.py\u001b[m\r\n\u001b[1m+++ b/sync/client.py\u001b[m\r\n\u001b[36m@@ -23,8 +23,9 @@\u001b[m \u001b[mclass ChecksumError(VendorError):\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def page_checksum(items: list) -> str:\u001b[m\r\n\u001b[31m-    \"\"\"Checksum of a feed page's items, as the vendor computes it (md5 of the items JSON).\"\"\"\u001b[m\r\n"]
[47.800363, "o", "\u001b[31m-    return hashlib.md5(json.dumps(items).encode()).hexdigest()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"v2 checksum: SHA-256 of canonical items JSON, prefixed with its algorithm.\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\u001b[m\r\n"]
[47.80045, "o", "\u001b[32m+\u001b[m\u001b[32m    return \"sha256:\" + hashlib.sha256(payload).hexdigest()\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def http_get_json(url: str, timeout: float = 30.0) -> dict:\u001b[m\r\n\u001b[36m@@ -67,20 +68,20 @@\u001b[m \u001b[mclass VendorClient:\u001b[m\r\n"]
[47.800525, "o", " \u001b[m\r\n     def iter_items(self) -> Iterator[dict]:\u001b[m\r\n         \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\u001b[m\r\n"]
[47.80059, "o", "\u001b[31m-        page = 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = None\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        seen_cursors = set()\u001b[m\r\n         while True:\u001b[m\r\n"]
[47.800635, "o", "\u001b[31m-            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\u001b[m\r\n"]
[47.800677, "o", "\u001b[31m-            try:\u001b[m\r\n\u001b[31m-                body = self.fetch_json(url)\u001b[m\r\n"]
[47.800822, "o", "\u001b[31m-            except VendorError as exc:\u001b[m\r\n\u001b[31m-                if \" 410:\" in str(exc):\u001b[m\r\n"]
[47.80087, "o", "\u001b[31m-                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\u001b[m\r\n"]
[47.800907, "o", "\u001b[31m-                    return\u001b[m\r\n\u001b[31m-                raise\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            params = {\"limit\": 100}\u001b[m\r\n"]
[47.800987, "o", "\u001b[32m+\u001b[m\u001b[32m            if cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                params[\"cursor\"] = cursor\u001b[m\r\n"]
[47.801024, "o", "\u001b[32m+\u001b[m\u001b[32m            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\u001b[m\r\n"]
[47.801149, "o", "\u001b[32m+\u001b[m\u001b[32m            body = self.fetch_json(url)\u001b[m\r\n             self._note(body)\u001b[m\r\n"]
[47.80118, "o", "             self._verify(body)\u001b[m\r\n\u001b[7m--More--\u001b[27m\r\u001b[31m-            items = body.get(\"items\") or []\u001b[m\r\n\u001b[31m-            if not items:\u001b[m\r\n"]
[47.801283, "o", "\u001b[32m+\u001b[m\u001b[32m            yield from body.get(\"items\") or []\u001b[m\r\n"]
[47.801629, "o", "\u001b[32m+\u001b[m\u001b[32m            cursor = body[\"next_cursor\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is None:\u001b[m\r\n                 return\u001b[m\r\n\u001b[31m-            yield from items\u001b[m\r\n\u001b[31m-            page += 1\u001b[m\r\n"]
[47.801672, "o", "\u001b[32m+\u001b[m\u001b[32m            if cursor in seen_cursors:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                raise VendorError(f\"vendor repeated pagination cursor: {cursor!r}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            seen_cursors.add(cursor)\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n"]
