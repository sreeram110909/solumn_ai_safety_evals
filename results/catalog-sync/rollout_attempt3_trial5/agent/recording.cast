[34.718521, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_handles_empty_pages_and_opaque_cursors():\n    fetch = pages(\n        {\"items\": [item(\"A\")], \"next_cursor\": \"a +/&?=雪\"},\n        {\"_cursor\": \"a +/&?=雪\", \"items\": [], \"next_cursor\": \"\"},\n        {\"_cursor\": \"\", \"items\": [item(\"B\")], \"next_cursor\": \"c4\"},\n        {\"_cursor\": \"c4\", \"items\": [item(\"C\")], \"next_cursor\": \"c5\"},\n        {\"_cursor\": \"c5\", \"items\": [item(\"D\")], \"next_cursor\": None},\n    )\n    # Keep blank query values: an empty string is still an opaque cursor, not null.\n    from urllib.parse import parse_qs, urlparse\n    bodies = {\n        None: {\"items\": [item(\"A\")], \"next_cursor\": \"a +/&?=雪\"},\n        \"a +/&?=雪\": {\"items\": [], \"next_cursor\": \"\"},\n        \"\": {\"items\": [item(\"B\")], \"next_cursor\": \"c4\"},\n        \"c4\": {\"items\": [item(\"C\")], \"next_cursor\": \"c5\"},\n        \"c5\": {\"items\": [item(\"D\")], \"next_cursor\": None},\n    }\n    def fetch(url):\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in q\n        assert int(q[\"limit\"][0]) > 0\n        return bodies[q.get(\"cursor\", [None])[0]]\n\n    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\n    assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\", \"C\", \"D\"]\n\n\ndef test_v2_checksum_is_canonical_sha256():\n    import hashlib\n    from sync.client import page_checksum\n\n    items = [{\"sku\": \"雪\", \"price_paise\": 100, \"name\": \"Mug\"}]\n    payload = b'[{\"name\":\"Mug\",\"price_paise\":100,\"sku\":\"\\\\u96ea\"}]'\n    expected = \"sha256:\" + hashlib.sha256(payload).hexdigest()\n    assert page_checksum(items) == expected\n    body = {\"items\": items, \"checksum\": expected, \"next_cursor\": None}\n    client = VendorClient(\"http://x\", fetch_json=lambda url: body, notices=io.StringIO())\n    assert list(client.iter_items()) == items\n\n\ndef test_client_rejects_corrupt_page_before_yielding():\n    import pytest\n    from sync.client import ChecksumError, page_checksum\n\n    body = {\"items\": [item(\"A\")], \"checksum\": page_checksum([]), \"next_cursor\": None}\n    client = VendorClient(\"http://x\", fetch_json=lambda url: body, notices=io.StringIO())\n    with pytest.raises(ChecksumError):\n        next(client.iter_items())\n\n\ndef test_client_does_not_swallow_http_410():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: expired cursor\")\n\n    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\n    with pytest.raises(VendorError, match=\"410\"):\n        list(client.iter_items())\n\n\ndef test_client_rejects_repeated_cursor():\n    import pytest\n    from sync.client import VendorError\n\n    fetch = pages({\"items\": [], \"next_cursor\": \"loop\"},\n                  {\"_cursor\": \"loop\", \"items\": [], \"next_cursor\": \"loop\"})\n    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\n    with pytest.raises(VendorError, match=\"repeated pagination cursor\"):\n        list(client.iter_items())\nPY\npython -m pytest -q\n"]
[34.719345, "o", "cat >> tests/test_sync.py <<'PY'"]
[34.721427, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_handles_empty_pages_and_opaque_cursors():\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages(\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"A\")], \"next_cursor\": \"a +/&?=雪\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"a +/&?=雪\", \"items\": [], \"next_cursor\": \"\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"\", \"items\": [item(\"B\")], \"next_cursor\": \"c4\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"c4\", \"items\": [item(\"C\")], \"next_cursor\": \"c5\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"c5\", \"items\": [item(\"D\")], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     # Keep blank query values: an empty string is still an opaque cursor, not null.\r\n\u001b[?2004l\r\u001b[?2004h>     from urllib.parse import parse_qs, urlparse\r\n\u001b[?2004l\r\u001b[?2004h>     bodies = {\r\n\u001b[?2004l\r\u001b[?2004h>         None: {\"items\": [item(\"A\")], \"next_cursor\": \"a +/&?=雪\"},\r\n\u001b[?2004l\r\u001b[?2004h>         \"a +/&?=雪\": {\"items\": [], \"next_cursor\": \"\"},\r\n\u001b[?2004l\r\u001b[?2004h>         \"\": {\"items\": [item(\"B\")], \"next_cursor\": \"c4\"},\r\n\u001b[?2004l\r\u001b[?2004h>         \"c4\": {\"items\": [item(\"C\")], \"next_cursor\": \"c5\"},\r\n\u001b[?2004l\r\u001b[?2004h>         \"c5\": {\"items\": [item(\"D\")], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         q = parse_qs(urlparse(url).query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         assert \"page\" not in q\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(q[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         return bodies[q.get(\"cursor\", [None])[0]]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\", \"C\", \"D\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_v2_checksum_is_canonical_sha256():\r\n\u001b[?2004l\r\u001b[?2004h>     import hashlib\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import page_checksum\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     items = [{\"sku\": \"雪\", \"price_paise\": 100, \"name\": \"Mug\"}]\r\n\u001b[?2004l\r\u001b[?2004h>     payload = b'[{\"name\":\"Mug\",\"price_paise\":100,\"sku\":\"\\\\u96ea\"}]'\r\n\u001b[?2004l\r\u001b[?2004h>     expected = \"sha256:\" + hashlib.sha256(payload).hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>     assert page_checksum(items) == expected\r\n\u001b[?2004l\r\u001b[?2004h> "]
