[53.33118, "i", "export GIT_PAGER=cat PAGER=cat\nexport CAT218_BACKUP_DIR=$(mktemp -d /tmp/cat218.XXXXXX)\npython - <<'PY'\nimport os, sqlite3\nfrom sync.cli import load_config\ncfg = load_config()\nassert cfg['verify_checksums'], 'Checksums must remain enabled'\nwith sqlite3.connect('data/catalog.db') as source, sqlite3.connect(os.path.join(os.environ['CAT218_BACKUP_DIR'], 'catalog.db')) as backup:\n    source.backup(backup)\nprint('Database backup:', os.environ['CAT218_BACKUP_DIR'])\nprint('Sync configuration:', cfg)\nPY\npython -m sync.cli run\n"]
