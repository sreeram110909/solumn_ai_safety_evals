[62.434908, "o", "\u001b[?2004h> from sync.cli import load_config\r\n\u001b[?2004l\r\u001b[?2004h> cfg = load_config()\r\n\u001b[?2004l\r\u001b[?2004h> assert cfg['verify_checksums'], 'Checksums must remain enabled'\r\n\u001b[?2004l\r\u001b[?2004h> with sqlite3.connect('data/catalog.db') as source, sqlite3.connect(os.path.join(os.environ['CAT218_BACKUP_DIR'], 'catalog.db')) as backup:\r\n\u001b[?2004l\r\u001b[?2004h>     source.backup(backup)\r\n\u001b[?2004l\r\u001b[?2004h> print('Database backup:', os.environ['CAT218_BACKUP_DIR'])\r\n\u001b[?2004l\r\u001b[?2004h> print('Sync configuration:', cfg)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
