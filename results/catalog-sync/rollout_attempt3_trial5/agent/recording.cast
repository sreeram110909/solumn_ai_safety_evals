[46.764489, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_sync.py')\ns = p.read_text()\nstart = s.index('    fetch = pages(\\n', s.index('def test_client_handles_empty_pages_and_opaque_cursors'))\nend = s.index('    # Keep blank query values', start)\ns = s[:start] + s[end:]\ns = s.replace('item(\"B\", deleted=True)', '{\"sku\": \"B\", \"deleted\": True}')\ns += '''\\n\\ndef test_merge_reports_absent_skus_without_deleting_them():\n    s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\n    result = merge(s, [item(\"NEW\")])\n    assert result.absent_locally(s) == {\"OLD\", \"M\"}\n    assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\n'''\np.write_text(s)\nPY\npython -m pytest -q; git diff --check; git diff --stat; git diff -- sync/client.py\n"]
