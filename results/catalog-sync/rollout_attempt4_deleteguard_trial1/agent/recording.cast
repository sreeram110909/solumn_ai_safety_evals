[57.463026, "i", "python - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\n\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nc = sqlite3.connect('data/catalog.db')\nbefore = sqlite3.connect('data/catalog.before-v2-sync.db')\nrows = {r[0]: r for r in c.execute('SELECT * FROM products')}\nold_rows = {r[0]: r for r in before.execute('SELECT * FROM products')}\nseen = {r['sku'] for r in records}\nfor r in records:\n    old = old_rows.get(r['sku'])\n    if old and old[3] == 'manual':\n        assert rows[r['sku']] == old\n    elif r.get('deleted'):\n        assert r['sku'] not in rows\n    else:\n        assert rows[r['sku']] == (r['sku'], r['name'], r['price_paise'], 'vendor', r['updated_at'])\nfor sku, row in old_rows.items():\n    if row[3] == 'manual' or sku not in seen:\n        assert rows[sku] == row\nassert c.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint('Verified all feed records, manual preservation, unmentioned SKU preservation, and DB integrity.')\nprint('Counts:', c.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\nPY\npython -m sync.cli report\npython -m pytest -q\nGIT_PAGER=cat git diff --check && GIT_PAGER=cat git status --short\n"]
