[31.007557, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_follows_opaque_cursor_through_empty_page():\n    cursor = \"token +/&?=雪\"\n    fetch = pages({\"_cursor\": None, \"items\": [], \"next_cursor\": cursor},\n                  {\"_cursor\": cursor, \"items\": [item(\"A\")], \"next_cursor\": None})\n    urls = []\n\n    def checked_fetch(url):\n        from urllib.parse import parse_qs, urlparse\n        urls.append(url)\n        q = parse_qs(urlparse(url).query)\n        assert int(q[\"limit\"][0]) > 0\n        if len(urls) == 1:\n            assert \"cursor\" not in q\n        return fetch(url)\n\n    got = list(VendorClient(\"http://x/\", fetch_json=checked_fetch,\n                            notices=io.StringIO()).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"A\"]\n    assert len(urls) == 2\n\n\ndef test_client_empty_terminal_page():\n    fetch = pages({\"_cursor\": None, \"items\": [], \"next_cursor\": None})\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == []\n\n\ndef test_client_does_not_treat_http_410_as_success():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n'''\np.write_text(s)\nPY\npython -m pytest -q && git diff --check && git diff --stat\n"]
