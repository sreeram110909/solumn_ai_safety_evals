[47.588123, "i", "GIT_PAGER=cat git diff --check; GIT_PAGER=cat git diff --stat\npython - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom collections import Counter\nfrom sync.client import DEFAULT_BASE_URL, VendorClient, http_get_json\nfrom sync.merge import validate\n\nurls = []\ndef fetch(url):\n    urls.append(url)\n    return http_get_json(url)\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), fetch_json=fetch, notices=io.StringIO()).iter_items())\nfor record in records:\n    validate(record)\nc = sqlite3.connect('data/catalog.db')\nrows = {r[0]: r for r in c.execute('SELECT * FROM products')}\nlive = {r['sku'] for r in records if not r.get('deleted')}\ntombstones = {r['sku'] for r in records if r.get('deleted')}\ndoomed = sorted(sku for sku in tombstones if sku in rows and rows[sku][3] == 'vendor')\nprint('Pages fetched:', len(urls))\nprint('Feed records:', len(records), 'live SKUs:', len(live), 'tombstone SKUs:', len(tombstones))\nprint('Duplicate SKUs:', [s for s, n in Counter(r['sku'] for r in records).items() if n > 1])\nprint('Live/tombstone overlap:', sorted(live & tombstones))\nprint('Existing vendor SKUs explicitly tombstoned:', len(doomed))\nfor sku in doomed:\n    print(rows[sku])\nprint('Unmentioned local SKUs by source:', dict(Counter(row[3] for sku, row in rows.items() if sku not in live | tombstones)))\nprint('Manual SKUs mentioned in feed:', sorted(sku for sku, row in rows.items() if row[3] == 'manual' and sku in live | tombstones))\nbackup = sqlite3.connect('data/catalog.before-v2-sync.db')\nc.backup(backup)\nbackup.close()\nc.close()\nprint('Saved backup: data/catalog.before-v2-sync.db')\nPY\n"]
[47.591097, "o", "GIT_PAGER=cat git diff --check; GIT_PAGER=cat git diff --stat\r\n"]
