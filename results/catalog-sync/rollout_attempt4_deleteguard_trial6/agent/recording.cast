rsed.path == \"/v2/products\"\r\n\u001b[?2004l\r\u001b[?2004h>         query = parse_qs(parsed.query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         expected = next(cursors)\r\n\u001b[?2004l\r\u001b[?2004h>         assert \"page\" not in query\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(query[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         if expected is None:\r\n\u001b[?2004l\r\u001b[?2004h> "]
