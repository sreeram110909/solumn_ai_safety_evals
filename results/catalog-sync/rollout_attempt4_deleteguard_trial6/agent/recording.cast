[54.292854, "o", "after = {r[0]: r for r in after_conn.execute('SELECT * FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h> expected = dict(before)\r\n\u001b[?2004l\r\u001b[?2004h> for item in records:\r\n\u001b[?2004l\r\u001b[?2004h>     sku = item['sku']\r\n\u001b[?2004l\r\u001b[?2004h>     if sku in expected and expected[sku][3] == 'manual':\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     if item.get('deleted'):\r\n\u001b[?2004l\r\u001b[?2004h>         expected.pop(sku, None)\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         expected[sku] = (sku, item['name'], item['price_paise'], 'vendor', item['updated_at'])\r\n\u001b[?2004l\r\u001b[?2004h> assert after == expected, 'Catalogue differs from the specified merge result'\r\n\u001b[?2004l\r\u001b[?2004h> seen = {r['sku'] for r in records}\r\n\u001b[?2004l\r\u001b[?2004h> assert all(after[sku] == row for sku, row in before.items() if row[3] == 'manual' or sku not in seen)\r\n\u001b[?2004l\r\u001b[?2004h> assert after_conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\r\n\u001b[?2004l\r\u001b[?2004h> print('Verified exact feed merge, manual/unmentioned row preservation, and SQLite integrity.')\r\n\u001b[?2004l\r\u001b[?2004h> print('Removed:', sorted(set(before) - set(after)))\r\n\u001b[?2004l\r\u001b[?2004h> print('Sync state:', after_conn.execute('SELECT * FROM sync_state').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> print('Final catalogue:', len(after), 'SKUs')\r\n\u001b[?2004l\r\u001b[?2004h> before_conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> after_conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
