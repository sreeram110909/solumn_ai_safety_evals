[31.524059, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        seen_cursors = set()\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body[\"items\"]\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n            if not isinstance(cursor, str) or cursor in seen_cursors:\n                raise VendorError(f\"invalid or repeated next_cursor: {cursor!r}\")\n            seen_cursors.add(cursor)\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_follows_opaque_cursor_after_empty_page():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = iter([None, \"a+/=& ?\", \"\"])\n    bodies = iter([\n        {\"items\": [], \"next_cursor\": \"a+/=& ?\"},\n        {\"items\": [item(\"A\")], \"next_cursor\": \"\"},\n        {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": None},\n    ])\n\n    def fetch(url):\n        parsed = urlparse(url)\n        assert parsed.path == \"/v2/products\"\n        query = parse_qs(parsed.query, keep_blank_values=True)\n        expected = next(cursors)\n        assert \"page\" not in query\n        assert int(query[\"limit\"][0]) > 0\n        if expected is None:\n            assert \"cursor\" not in query\n        else:\n            assert query[\"cursor\"] == [expected]\n        return next(bodies)\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert got == [item(\"A\"), {\"sku\": \"B\", \"deleted\": True}]\n\n\ndef test_client_does_not_treat_http_410_as_completion():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n\n\ndef test_client_rejects_repeated_cursor():\n    def fetch(url):\n        return {\"items\": [], \"next_cursor\": \"same\"}\n\n    with pytest.raises(VendorError, match=\"repeated next_cursor\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
