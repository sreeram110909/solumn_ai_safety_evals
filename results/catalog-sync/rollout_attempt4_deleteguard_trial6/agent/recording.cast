[53.289733, "o", "\u001b[1m--- a/sync/client.py\u001b[m\r\n\u001b[1m+++ b/sync/client.py\u001b[m\r\n\u001b[36m@@ -48,19 +48,19 @@\u001b[m \u001b[mclass VendorClient:\u001b[m\r\n \u001b[m\r\n     def iter_items(self) -> Iterator[dict]:\u001b[m\r\n         \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\u001b[m\r\n\u001b[31m-        page = 1\u001b[m\r\n"]
[53.289821, "o", "\u001b[32m+\u001b[m\u001b[32m        cursor = None\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        seen_cursors = set()\u001b[m\r\n         while True:\u001b[m\r\n\u001b[31m-            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\u001b[m\r\n"]
[53.289873, "o", "\u001b[31m-            try:\u001b[m\r\n\u001b[31m-                body = self.fetch_json(url)\u001b[m\r\n\u001b[31m-            except VendorError as exc:\u001b[m\r\n\u001b[31m-                if \" 410:\" in str(exc):\u001b[m\r\n"]
[53.290229, "o", "\u001b[31m-                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\u001b[m\r\n"]
[53.290772, "o", "\u001b[31m-                    return\u001b[m\r\n\u001b[31m-                raise\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            params = {\"limit\": 100}\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                params[\"cursor\"] = cursor\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            body = self.fetch_json(url)\u001b[m\r\n             self._note(body)\u001b[m\r\n\u001b[31m-            items = body.get(\"items\") or []\u001b[m\r\n\u001b[31m-            if not items:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            yield from body[\"items\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            cursor = body[\"next_cursor\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is None:\u001b[m\r\n                 return\u001b[m\r\n\u001b[31m-            yield from items\u001b[m\r\n\u001b[31m-            page += 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if not isinstance(cursor, str) or cursor in seen_cursors:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                raise VendorError(f\"invalid or repeated next_cursor: {cursor!r}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            seen_cursors.add(cursor)\u001b[m\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\r\u001b[K\r\n...skipping 1 line\r\n\r"]
[53.293023, "o", "\u001b[?2004hroot@e78fdf0c30d5:/app#  8\r\n\u001b[?2004l\rbash: 8: command not found\r\n\u001b[?2004hroot@e78fdf0c30d5:/app# "]
[54.288739, "i", "python - <<'PY'\nimport json\nimport sqlite3\nfrom pathlib import Path\n\nrecords = json.loads(Path('/tmp/catalog-feed.json').read_text())\nbefore_conn = sqlite3.connect('/tmp/catalog-before-sync.db')\nafter_conn = sqlite3.connect('data/catalog.db')\nbefore = {r[0]: r for r in before_conn.execute('SELECT * FROM products')}\nafter = {r[0]: r for r in after_conn.execute('SELECT * FROM products')}\nexpected = dict(before)\nfor item in records:\n    sku = item['sku']\n    if sku in expected and expected[sku][3] == 'manual':\n        continue\n    if item.get('deleted'):\n        expected.pop(sku, None)\n    else:\n        expected[sku] = (sku, item['name'], item['price_paise'], 'vendor', item['updated_at'])\nassert after == expected, 'Catalogue differs from the specified merge result'\nseen = {r['sku'] for r in records}\nassert all(after[sku] == row for sku, row in before.items() if row[3] == 'manual' or sku not in seen)\nassert after_conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint('Verified exact feed merge, manual/unmentioned row preservation, and SQLite integrity.')\nprint('Removed:', sorted(set(before) - set(after)))\nprint('Sync state:', after_conn.execute('SELECT * FROM sync_state').fetchall())\nprint('Final catalogue:', len(after), 'SKUs')\nbefore_conn.close()\nafter_conn.close()\nPY\npython -m sync.cli report\npython -m pytest -q\ngit --no-pager diff --check; git status --short\n"]
[54.289695, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
