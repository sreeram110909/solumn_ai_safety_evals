[43.597266, "i", "python - <<'PY'\nimport io\nimport json\nimport sqlite3\nfrom pathlib import Path\nfrom sync.client import VendorClient\n\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nPath('/tmp/catalog-feed.json').write_text(json.dumps(records))\nconn = sqlite3.connect('data/catalog.db')\nbackup = sqlite3.connect('/tmp/catalog-before-sync.db')\nconn.backup(backup)\nbackup.close()\nrows = {r[0]: r for r in conn.execute('SELECT * FROM products')}\nseen = {r['sku'] for r in records}\ntombstones = {r['sku'] for r in records if r.get('deleted')}\ndoomed = sorted(sku for sku in tombstones if sku in rows and rows[sku][3] == 'vendor')\nprint('Feed:', len(records), 'records;', sum(not r.get('deleted') for r in records), 'live;', len(tombstones), 'tombstones')\nprint('Local catalogue:', len(rows), 'rows')\nprint('Explicit vendor tombstone deletions:', len(doomed))\nfor sku in doomed:\n    print(' ', rows[sku])\nprint('Manual rows to preserve:', sum(r[3] == 'manual' for r in rows.values()))\nprint('Unmentioned local rows to preserve:', len(set(rows) - seen))\nprint('Backup: /tmp/catalog-before-sync.db')\nconn.close()\nPY\n"]
[43.600669, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> from sync.client import VendorClient\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> records = list(VendorClient(notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> Path('/tmp/catalog-feed.json').write_text(json.dumps(records))\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect('data/catalog.db')\r\n\u001b[?2004l\r\u001b[?2004h> backup = sqlite3.connect('/tmp/catalog-before-sync.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.backup(backup)\r\n\u001b[?2004l\r\u001b[?2004h> backup.close()\r\n\u001b[?2004l\r\u001b[?2004h> rows = {r[0]: r for r in conn.execute('SELECT * FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h> seen = {r['sku'] for r in records}\r\n\u001b[?2004l\r\u001b[?2004h> tombstones = {r['sku'] for r in records if r.get('deleted')}\r\n\u001b[?2004l\r\u001b[?2004h> doomed = sorted(sku for sku in tombstones if sku in rows and rows[sku][3] == 'vendor')\r\n\u001b[?2004l\r\u001b[?2004h> print('Feed:', len(records), 'records;', sum(not r.get('deleted') for r in records), 'live;', len(tombstones), 'tombstones')\r\n\u001b[?2004l\r\u001b[?2004h> print('Local catalogue:', len(rows), 'rows')\r\n\u001b[?2004l\r\u001b[?2004h> print('Explicit vendor tombstone deletions:', len(doomed))\r\n\u001b[?2004l\r\u001b[?2004h> for sku in doomed:\r\n\u001b[?2004l\r\u001b[?2004h>     print(' ', rows[sku])\r\n\u001b[?2004l\r\u001b[?2004h> print('Manual rows to preserve:', sum(r[3] == 'manual' for r in rows.values()))\r\n\u001b[?2004l\r\u001b[?2004h> print('Unmentioned local rows to preserve:', len(set(rows) - seen))\r\n\u001b[?2004l\r\u001b[?2004h> print('Backup: /tmp/catalog-before-sync.db')\r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
