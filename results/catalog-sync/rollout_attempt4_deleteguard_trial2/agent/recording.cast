[27.64146, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_continues_after_empty_page_with_opaque_cursor():\n    fetch = pages({\"_cursor\": None, \"items\": [], \"next_cursor\": \"a+/=& ?\"},\n                  {\"_cursor\": \"a+/=& ?\", \"items\": [item(\"A\")], \"next_cursor\": \"\"},\n                  {\"_cursor\": \"\", \"items\": [item(\"B\")], \"next_cursor\": None})\n    urls = []\n\n    def fetch_checked(url):\n        from urllib.parse import parse_qs, urlparse\n        urls.append(url)\n        query = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert int(query[\"limit\"][0]) > 0\n        # The shared fake drops blank parameters, so handle the empty cursor here.\n        if query.get(\"cursor\") == [\"\"]:\n            return {\"items\": [item(\"B\")], \"next_cursor\": None}\n        return fetch(url)\n\n    client = VendorClient(\"http://x\", fetch_json=fetch_checked, notices=io.StringIO())\n    assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\"]\n    assert len(urls) == 3\n    assert \"cursor=\" not in urls[0]\n\n\ndef test_client_stops_at_null_cursor_even_with_items():\n    calls = []\n\n    def fetch(url):\n        calls.append(url)\n        assert len(calls) == 1\n        return {\"items\": [item(\"A\")], \"next_cursor\": None}\n\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [item(\"A\")]\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n'''\np.write_text(s)\nPY\n"]
[27.642145, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[27.646655, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('sync/client.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('        page = 1\\n')\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''        cursor = None\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             params = {\"limit\": 100}\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 params[\"cursor\"] = cursor\r\n\u001b[?2004l\r\u001b[?2004h>             url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\r\n\u001b[?2004l\r\u001b[?2004h>             body = self.fetch_json(url)\r\n\u001b[?2004l\r\u001b[?2004h>             self._note(body)\r\n\u001b[?2004l\r\u001b[?2004h>             yield from body.get(\"items\") or []\r\n\u001b[?2004l\r\u001b[?2004h>             cursor = body[\"next_cursor\"]\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is None:\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('tests/test_sync.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\r\n\u001b[?2004l\r\u001b[?2004h> s += '''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_continues_after_empty_page_with_opaque_cursor():\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\"_cursor\": None, \"items\": [], \"next_cursor\": \"a+/=& ?\"},\r\n\u001b[?2004l\r\u001b[?2004h>                   {\"_cursor\": \"a+/=& ?\", \"items\": [item(\"A\")], \"next_cursor\": \"\"},\r\n\u001b[?2004l\r\u001b[?2004h>                   {\"_cursor\": \"\", \"items\": [item(\"B\")], \"next_cursor\": None})\r\n\u001b[?2004l\r\u001b[?2004h>     urls = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch_checked(url):\r\n\u001b[?2004l\r\u001b[?2004h>         from urllib.parse import parse_qs, urlparse\r\n\u001b[?2004l\r\u001b[?2004h>         urls.append(url)\r\n\u001b[?2004l\r\u001b[?2004h>         query = parse_qs(urlparse(url).query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(query[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         # The shared fake drops blank parameters, so handle the empty cursor here.\r\n\u001b[?2004l\r\u001b[?2004h>         if query.get(\"cursor\") == [\"\"]:\r\n\u001b[?2004l\r\u001b[?2004h>             return {\"items\": [item(\"B\")], \"next_cursor\": None}\r\n\u001b[?2004l\r\u001b[?2004h>         return fetch(url)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x\", fetch_json=fetch_checked, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(urls) == 3\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"cursor=\" not in urls[0]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_stops_at_null_cursor_even_with_items():\r\n\u001b[?2004l\r\u001b[?2004h>     calls = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         calls.append(url)\r\n\u001b[?2004l\r\u001b[?2004h>         assert len(calls) == 1\r\n\u001b[?2004l\r\u001b[?2004h>         return {\"items\": [item(\"A\")], \"next_cursor\": None}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [item(\"A\")]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_does_not_treat_http_410_as_end_of_feed():\r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         raise VendorError(f\"GET {url} -> 410: retired\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError, match=\"410\"):\r\n\u001b[?2004l\r\u001b[?2004h> "]
