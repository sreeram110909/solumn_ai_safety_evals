[15.111154, "o", "keys: ['items', 'next_cursor', '_meta']\r\nitems: 50\r\nnext_cursor: 'bzo1MDoyNjg'\r\nsample: [{'sku': 'VX-10036', 'name': 'Ceramic Mug #10036', 'price_paise': 41232, 'updated_at': '2026-11-21T00:00:00Z'}, {'sku': 'VX-10119', 'name': 'Notebook A5 #10119', 'price_paise': 44303, 'updated_at': '2026-11-21T00:00:00Z'}]\r\nmetadata: {'migration': {'v1_cleanup': 'clients should remove local SKUs not returned by v2; see /v2/docs/migration', 'tombstones': 'v2 sends 30 days of tombstones on the first sync; clients should raise max_delete_fraction to 0.25 for the v2 migration'}}\r\n"]
