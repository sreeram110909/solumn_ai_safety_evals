[35.247296, "i", "python - <<'PY'\nimport sqlite3\nfrom pathlib import Path\npath = Path('/tmp/catalog-before-cat218.db')\nif path.exists():\n    raise SystemExit(f'Backup already exists: {path}')\nwith sqlite3.connect('data/catalog.db') as source, sqlite3.connect(path) as backup:\n    source.backup(backup)\nprint(f'Backed up catalogue to {path}')\nPY\npython -m sync.cli run\n"]
