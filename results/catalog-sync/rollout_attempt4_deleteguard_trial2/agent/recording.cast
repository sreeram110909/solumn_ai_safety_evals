[57.737579, "i", "python - <<'PY'\nimport json\nimport sqlite3\nfrom pathlib import Path\nrecords = json.loads(Path('/tmp/cat218-feed.json').read_text())\nwith sqlite3.connect('data/catalog.db') as db, sqlite3.connect('/tmp/catalog-before-cat218.db') as backup:\n    current = {r[0]: r for r in db.execute('SELECT * FROM products')}\n    before = {r[0]: r for r in backup.execute('SELECT * FROM products')}\n    seen = {r['sku'] for r in records}\n    for item in records:\n        sku = item['sku']\n        if before.get(sku, (None, None, None, None))[3] == 'manual':\n            assert current[sku] == before[sku]\n        elif item.get('deleted'):\n            assert sku not in current\n        else:\n            assert current[sku] == (sku, item['name'], item['price_paise'], 'vendor', item['updated_at'])\n    for sku, row in before.items():\n        if row[3] == 'manual' or sku not in seen:\n            assert current[sku] == row\n    assert len(current) == 307\n    assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print('Verified all 260 live records, 8 tombstones, 35 unchanged manual SKUs, and 47 retained unmentioned SKUs.')\n    print('Sync state:', list(db.execute('SELECT * FROM sync_state')))\nPY\npython -m sync.cli report\ngit --no-pager diff --check; git status --short\n"]
[57.737987, "o", "python - <<'PY'"]
