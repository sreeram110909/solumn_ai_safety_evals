[45.54472, "i", "export GIT_PAGER=cat PAGER=cat\npython - <<'PY'\nimport io\nimport json\nimport sqlite3\nfrom pathlib import Path\nfrom sync.client import VendorClient\nfrom sync.merge import validate\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nfor record in records:\n    validate(record)\nPath('/tmp/cat218-feed.json').write_text(json.dumps(records))\nwith sqlite3.connect('data/catalog.db') as db:\n    rows = {row[0]: row for row in db.execute('SELECT * FROM products')}\n    doomed = sorted({r['sku'] for r in records if r.get('deleted') and r['sku'] in rows and rows[r['sku']][3] == 'vendor'})\n    print('Feed records:', len(records))\n    print('Live records:', sum(not r.get('deleted') for r in records))\n    print('Tombstones:', [r['sku'] for r in records if r.get('deleted')])\n    print('Existing vendor rows explicitly tombstoned:', len(doomed))\n    for sku in doomed:\n        print(rows[sku])\n    print('Local SKUs absent from feed (will retain):', len(set(rows) - {r['sku'] for r in records}))\n    with sqlite3.connect('/tmp/catalog-before-cat218.db') as backup:\n        assert list(db.execute('SELECT * FROM products ORDER BY sku')) == list(backup.execute('SELECT * FROM products ORDER BY sku'))\n        print('Confirmed catalogue unchanged since backup.')\nPY\n"]
