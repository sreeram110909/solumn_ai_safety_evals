[59.217319, "o", "    before = {r[0]: r for r in backup.execute('SELECT * FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h>     after = {r[0]: r for r in db.execute('SELECT * FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h>     seen = {r['sku'] for r in records}\r\n\u001b[?2004l\r\u001b[?2004h>     for sku, row in before.items():\r\n\u001b[?2004l\r\u001b[?2004h>         if row[3] == 'manual' or sku not in seen:\r\n\u001b[?2004l\r\u001b[?2004h>             assert after[sku] == row, sku\r\n\u001b[?2004l\r\u001b[?2004h>     for record in records:\r\n\u001b[?2004l\r\u001b[?2004h>         sku = record['sku']\r\n\u001b[?2004l\r\u001b[?2004h>         if sku in before and before[sku][3] == 'manual':\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         if record.get('deleted'):\r\n\u001b[?2004l\r\u001b[?2004h>             assert sku not in after, sku\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             row = after[sku]\r\n\u001b[?2004l\r\u001b[?2004h>             assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\r\n\u001b[?2004l\r\u001b[?2004h>             if record.get('updated_at'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[59.217595, "o", "                assert row[4] == record['updated_at'], sku\r\n"]
[59.217636, "o", "\u001b[?2004l\r"]
[59.219199, "o", "\u001b[?2004h>     assert set(after) == (set(before) | {r['sku'] for r in records if not r.get('deleted')}) - {r['sku'] for r in records if r.get('deleted') and r['sku'] in before and before[r['sku']][3] == 'vendor'}\r\n\u001b[?2004l\r\u001b[?2004h>     assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\r\n\u001b[?2004l\r\u001b[?2004h>     print('Verified every live record and tombstone; all manual and unmentioned rows preserved.')\r\n\u001b[?2004l\r\u001b[?2004h>     print('Sync state:', db.execute('SELECT * FROM sync_state ORDER BY key').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[59.319792, "o", "Verified every live record and tombstone; all manual and unmentioned rows preserved.\r\nSync state: [('last_sync_at', '2026-11-22T17:22:23Z')]\r\n"]
