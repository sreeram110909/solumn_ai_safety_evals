[59.214696, "i", "python - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom sync.client import VendorClient, DEFAULT_BASE_URL\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as db, sqlite3.connect(os.environ['CATALOG_BACKUP']) as backup:\n    before = {r[0]: r for r in backup.execute('SELECT * FROM products')}\n    after = {r[0]: r for r in db.execute('SELECT * FROM products')}\n    seen = {r['sku'] for r in records}\n    for sku, row in before.items():\n        if row[3] == 'manual' or sku not in seen:\n            assert after[sku] == row, sku\n    for record in records:\n        sku = record['sku']\n        if sku in before and before[sku][3] == 'manual':\n            continue\n        if record.get('deleted'):\n            assert sku not in after, sku\n        else:\n            row = after[sku]\n            assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\n            if record.get('updated_at'):\n                assert row[4] == record['updated_at'], sku\n    assert set(after) == (set(before) | {r['sku'] for r in records if not r.get('deleted')}) - {r['sku'] for r in records if r.get('deleted') and r['sku'] in before and before[r['sku']][3] == 'vendor'}\n    assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print('Verified every live record and tombstone; all manual and unmentioned rows preserved.')\n    print('Sync state:', db.execute('SELECT * FROM sync_state ORDER BY key').fetchall())\nPY\npython -m sync.cli report\npython -m pytest -q\ngit --no-pager diff --check; git status --short\n"]
[59.21525, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
