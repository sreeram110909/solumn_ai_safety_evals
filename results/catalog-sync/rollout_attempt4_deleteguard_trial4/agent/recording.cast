[30.878117, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\\n\\ndef test_client_follows_opaque_cursors_past_empty_pages():\n    from urllib.parse import parse_qs, urlparse\n\n    requests = []\n    fetch_page = pages(\n        {\"_cursor\": None, \"items\": [item(\"A\")], \"next_cursor\": \"\"},\n        {\"_cursor\": \"\", \"items\": [], \"next_cursor\": \"a+b /?&=雪\"},\n        {\"_cursor\": \"a+b /?&=雪\", \"items\": [item(\"B\")], \"next_cursor\": \"four\"},\n        {\"_cursor\": \"four\", \"items\": [{\"sku\": \"C\", \"deleted\": True}], \"next_cursor\": \"five\"},\n        {\"_cursor\": \"five\", \"items\": [item(\"D\")], \"next_cursor\": None},\n    )\n\n    def fetch(url):\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        requests.append(q)\n        # The shared fake omits blank query values, so handle the empty cursor here.\n        if q.get(\"cursor\") == [\"\"]:\n            return {\"items\": [], \"next_cursor\": \"a+b /?&=雪\"}\n        return fetch_page(url)\n\n    got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert got == [item(\"A\"), item(\"B\"), {\"sku\": \"C\", \"deleted\": True}, item(\"D\")]\n    assert [q.get(\"cursor\") for q in requests] == [None, [\"\"], [\"a+b /?&=雪\"], [\"four\"], [\"five\"]]\n    assert all(q[\"limit\"] == [\"100\"] and \"page\" not in q for q in requests)\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
