[44.132925, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_sync.py')\ns = p.read_text().replace('q = parse_qs(urlparse(url).query)\\n', 'q = parse_qs(urlparse(url).query, keep_blank_values=True)\\n')\ns = s.replace('        # The shared fake omits blank query values, so handle the empty cursor here.\\n        if q.get(\"cursor\") == [\"\"]:\\n            return {\"items\": [], \"next_cursor\": \"a+b /?&=雪\"}\\n', '')\np.write_text(s)\nPY\npython - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom collections import Counter\nfrom sync.client import VendorClient, http_get_json, DEFAULT_BASE_URL\nfrom sync.merge import validate\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), fetch_json=fetch, notices=io.StringIO()).iter_items())\nfor record in records:\n    validate(record)\nwith sqlite3.connect('data/catalog.db') as db, sqlite3.connect(os.environ['CATALOG_BACKUP']) as backup:\n    rows = db.execute('SELECT * FROM products ORDER BY sku').fetchall()\n    assert rows == backup.execute('SELECT * FROM products ORDER BY sku').fetchall()\n    assert db.execute('SELECT * FROM sync_state ORDER BY key').fetchall() == backup.execute('SELECT * FROM sync_state ORDER BY key').fetchall()\n    vendor = {r[0] for r in rows if r[3] == 'vendor'}\n    manual = {r[0] for r in rows if r[3] == 'manual'}\n    live = {r['sku'] for r in records if not r.get('deleted')}\n    tombstones = {r['sku'] for r in records if r.get('deleted')}\n    print('Feed pages:', len(requests), 'records:', len(records), 'live:', len(live), 'tombstones:', len(tombstones))\n    print('Duplicate SKUs:', {sku: n for sku, n in Counter(r['sku'] for r in records).items() if n > 1})\n    print('Live/tombstone overlap:', sorted(live & tombstones))\n    print('Proposed vendor deletions:')\n    for row in rows:\n        if row[0] in vendor & tombstones:\n            print(row)\n    print('Manual SKUs targeted by tombstones (will be preserved):', sorted(manual & tombstones))\n    print('Vendor SKUs "]
