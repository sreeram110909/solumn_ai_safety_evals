[36.12184, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n', s.index('    def iter_items'))\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_follows_opaque_cursors_across_empty_pages():\n    cursors = [None, \"a+/=&? space雪\", \"\"]\n    bodies = [\n        {\"items\": [], \"next_cursor\": cursors[1]},\n        {\"items\": [item(\"A\")], \"next_cursor\": cursors[2]},\n        {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": None},\n    ]\n    requested = []\n\n    def fetch(url):\n        from urllib.parse import parse_qs, urlparse\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in q\n        assert int(q[\"limit\"][0]) > 0\n        cursor = q.get(\"cursor\", [None])[0]\n        assert cursor == cursors[len(requested)]\n        requested.append(cursor)\n        return bodies[len(requested) - 1]\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert got == [item(\"A\"), {\"sku\": \"B\", \"deleted\": True}]\n    assert requested == cursors\n\n\ndef test_client_stops_at_null_even_with_full_page():\n    calls = []\n\n    def fetch(url):\n        calls.append(url)\n        assert len(calls) == 1\n        return {\"items\": [item(\"A\")], \"next_cursor\": None}\n\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [item(\"A\")]\n    assert len(calls) == 1\n\n\ndef test_client_propagates_paging_errors():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_merge_warns_about_unmentioned_skus_without_removing_them():\n    s = store_with((\"OLD\", \"vendor\"), (\"MANUAL\", \"manual\"))\n    result = merge(s, [item(\"NEW\")])\n    assert s.skus() == {\"OLD\", \"MANUAL\", \"NEW\"}\n    assert result.absent_locally(s) == {\"OLD\", \"MANUAL\"}\n'''\np.write_text(s)\nPY\n"]
