[55.537842, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('tests/test_sync.py')\ns = p.read_text().replace('cursors = [None, \"a+/=&? space雪\", \"\"]', 'cursors = [None, \"a+/=&? space雪\", \"\", \"last\"]')\ns = s.replace('''        {\"items\": [], \"next_cursor\": cursors[1]},\n        {\"items\": [item(\"A\")], \"next_cursor\": cursors[2]},\n        {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": None},''', '''        {\"items\": [item(\"A\")], \"next_cursor\": cursors[1]},\n        {\"items\": [], \"next_cursor\": cursors[2]},\n        {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": cursors[3]},\n        {\"items\": [], \"next_cursor\": None},''')\ns = s.replace('''def test_client_stops_at_null_even_with_full_page():\n    calls = []''', '''def test_client_stops_at_null_even_with_full_page():\n    calls = []\n    items = [item(str(i)) for i in range(100)]''')\ns = s.replace('return {\"items\": [item(\"A\")], \"next_cursor\": None}\\n\\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [item(\"A\")]', 'return {\"items\": items, \"next_cursor\": None}\\n\\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items')\np.write_text(s)\nPY\n"]
[55.539965, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('tests/test_sync.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('cursors = [None, \"a+/=&? space雪\", \"\"]', 'cursors = [None, \"a+/=&? space雪\", \"\", \"last\"]')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''        {\"items\": [], \"next_cursor\": cursors[1]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"A\")], \"next_cursor\": cursors[2]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": None},''', '''        {\"items\": [item(\"A\")], \"next_cursor\": cursors[1]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [], \"next_cursor\": cursors[2]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": cursors[3]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [], \"next_cursor\": None},''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''def test_client_stops_at_null_even_with_full_page():\r\n\u001b[?2004l\r\u001b[?2004h>     calls = []''', '''def test_client_stops_at_null_even_with_full_page():\r\n\u001b[?2004l\r\u001b[?2004h>     calls = []\r\n\u001b[?2004l\r\u001b[?2004h>     items = [item(str(i)) for i in range(100)]''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('return {\"items\": [item(\"A\")], \"next_cursor\": None}\\n\\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [item(\"A\")]', 'return {\"items\": items, \"next_cursor\": None}\\n\\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[55.565553, "o", "\u001b[?2004hroot@9fe015e85967:/app# "]
[55.684849, "i", "python - <<'PY'\nimport sqlite3\nfrom urllib.parse import urlencode\nfrom sync.client import DEFAULT_BASE_URL, http_get_json\n\nrecords = []\ncursor = None\npage_count = 0\nwhile True:\n    params = {'limit': 100}\n    if cursor is not None:\n        params['cursor'] = cursor\n    body = http_get_json(DEFAULT_BASE_URL + '/v2/products?' + urlencode(params))\n    page_count += 1\n    records.extend(body['items'])\n    cursor = body['next_cursor']\n    if cursor is None:\n        break\n\nwith sqlite3.connect('data/catalog.db') as db:\n    rows = {r[0]: r[1:] for r in db.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\n    for record in records:\n        row = rows.get(record['sku'])\n        if record.get('deleted'):\n            assert row is None or row[2] == 'manual', record\n        elif row is not None and row[2] == 'manual':\n            continue\n        else:\n            assert row is not None, record\n            assert row[:3] == (record['name'], record['price_paise'], 'vendor'), record\n            if record.get('updated_at'):\n                assert row[3] == record['updated_at'], record\n    assert sum(row[2] == 'manual' for row in rows.values()) == 35\n    assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print(f'Verified {len(records)} feed records across {page_count} pages against {len(rows)} stored SKUs; 35 manual SKUs retained.')\n    print('Database integrity: ok')\n    print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\nPY\n"]
