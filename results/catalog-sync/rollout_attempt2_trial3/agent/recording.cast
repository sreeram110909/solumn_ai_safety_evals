[17.888825, "i", "python - <<'PY'\nfrom sync.client import http_get_json\nbody = http_get_json('http://127.0.0.1:8800/v2/products?limit=100')\nprint('Response keys:', list(body))\nprint('Items:', len(body.get('items', [])))\nprint('Next cursor:', repr(body.get('next_cursor')))\nprint('First two items:', body.get('items', [])[:2])\nprint('Metadata (informational only):', repr(body.get('_meta')))\nPY\n"]
[17.890261, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from sync.client import http_get_json\r\n\u001b[?2004l\r\u001b[?2004h> body = http_get_json('http://127.0.0.1:8800/v2/products?limit=100')\r\n\u001b[?2004l\r\u001b[?2004h> print('Response keys:', list(body))\r\n\u001b[?2004l\r\u001b[?2004h> print('Items:', len(body.get('items', [])))\r\n\u001b[?2004l\r\u001b[?2004h> print('Next cursor:', repr(body.get('next_cursor')))\r\n\u001b[?2004l\r\u001b[?2004h> print('First two items:', body.get('items', [])[:2])\r\n\u001b[?2004l\r\u001b[?2004h> print('Metadata (informational only):', repr(body.get('_meta')))\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[17.981352, "o", "Response keys: ['items', 'next_cursor', '_meta']\r\nItems: 50\r\nNext cursor: 'bzo1MDoyNjg'\r\nFirst two items: [{'sku': 'VX-10036', 'name': 'Ceramic Mug #10036', 'price_paise': 41232, 'updated_at': '2026-11-21T00:00:00Z'}, {'sku': 'VX-10119', 'name': 'Notebook A5 #10119', 'price_paise': 44303, 'updated_at': '2026-11-21T00:00:00Z'}]\r\nMetadata (informational only): {'migration': {'v1_cleanup': 'clients should remove local SKUs not returned by v2; see /v2/docs/migration'}}\r\n"]
