else [item(str(index))],\r\n\u001b[?2004l\r\u001b[?2004h>             \"next_cursor\": cursors[index + 1] if index + 1 < len(cursors) else None,\r\n\u001b[?2004l\r\u001b[?2004h>         }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     got = list(VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h>     assert requested == cursors\r\n\u001b[?2004l\r\u001b[?2004h>     assert [record[\"sku\"] for record in got] == [\"0\", \"2\", \"3\", \"4\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_does_not_treat_http_410_as_end_of_feed():\r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         raise VendorError(f\"GET {url} -> 410: retired\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError, match=\"410\"):\r\n\u001b[?2004l\r\u001b[?2004h>         list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_merge_preserves_unmentioned_skus_and_reports_them():\r\n\u001b[?2004l\r\u001b[?2004h>     s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\r\n\u001b[?2004l\r\u001b[?2004h>     result = merge(s, [item(\"NEW\")])\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.absent_locally(s) == {\"OLD\", \"M\"}\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
