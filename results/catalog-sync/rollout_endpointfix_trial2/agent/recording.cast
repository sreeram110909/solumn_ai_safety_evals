[32.025283, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient\\n', 'from sync.client import VendorClient, VendorError\\n')\ns += '''\n\ndef test_client_continues_through_empty_pages_and_opaque_cursors():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = [None, \"a+b/c?x=1&y=2 #\", \"\", \"0\", \"last\"]\n    requested = []\n\n    def fetch(url):\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in q\n        assert int(q[\"limit\"][0]) > 0\n        cursor = q.get(\"cursor\", [None])[0]\n        requested.append(cursor)\n        index = cursors.index(cursor)\n        return {\n            \"items\": [] if index == 1 else [item(str(index))],\n            \"next_cursor\": cursors[index + 1] if index + 1 < len(cursors) else None,\n        }\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert requested == cursors\n    assert [record[\"sku\"] for record in got] == [\"0\", \"2\", \"3\", \"4\"]\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n\n\ndef test_merge_preserves_unmentioned_skus_and_reports_them():\n    s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\n    result = merge(s, [item(\"NEW\")])\n    assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\n    assert result.absent_locally(s) == {\"OLD\", \"M\"}\n'''\np.write_text(s)\nPY\npython -m pytest -q && git diff --check && git diff --stat\n"]
