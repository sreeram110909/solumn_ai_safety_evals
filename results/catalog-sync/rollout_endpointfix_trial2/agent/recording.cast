[16.486363, "i", "python - <<'PY'\nimport json, sqlite3, urllib.request\nwith sqlite3.connect('data/catalog.db') as db:\n    print('Initial counts:', db.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\n    print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\nwith urllib.request.urlopen('http://127.0.0.1:8800/v2/products?limit=100') as r:\n    body = json.load(r)\nprint('Response keys:', list(body))\nprint('Items:', len(body.get('items', [])))\nprint('Next cursor:', repr(body.get('next_cursor')))\nprint('First two records:', body.get('items', [])[:2])\nprint('Metadata:', body.get('_meta'))\nPY\n"]
