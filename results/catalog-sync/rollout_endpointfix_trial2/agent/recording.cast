[44.716317, "i", "export GIT_PAGER=cat PAGER=cat\npython - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\n\nrecords = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as db:\n    rows = {r[0]: r for r in db.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\n    for item in records:\n        row = rows.get(item['sku'])\n        if item.get('deleted'):\n            assert row is None or row[3] == 'manual', item['sku']\n        elif row is None or row[3] != 'manual':\n            assert row is not None, item['sku']\n            assert row[1:4] == (item['name'], item['price_paise'], 'vendor'), item['sku']\n            if item.get('updated_at'):\n                assert row[4] == item['updated_at'], item['sku']\n    print('Verified feed:', len(requests), 'pages,', len(records), 'records')\n    print('Catalogue counts:', db.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\n    assert db.execute(\"SELECT COUNT(*) FROM products WHERE source='manual'\").fetchone()[0] == 35\n    print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\n    integrity = db.execute('PRAGMA integrity_check').fetchone()[0]\n    assert integrity == 'ok', integrity\n    print('Database integrity:', integrity)\nPY\npython -m pytest -q\npython -m sync.cli report\ngit diff --check && git --no-pager diff && git status --short\n"]
[44.717552, "o", "export GIT_PAGER=cat PAGER=cat\r\n\u001b[?2004l\r"]
