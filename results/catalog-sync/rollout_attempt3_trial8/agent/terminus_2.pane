[?2004l[?2004h>         json.dumps(items, sort_keys=True, separators=(",", ":")).encode("utf-8")
[?2004l[?2004h>     ).hexdigest()
[?2004l[?2004h>     assert page_checksum(items) == expected
[?2004l[?2004h>     reordered = [dict(reversed(list(i.items()))) for i in items]
