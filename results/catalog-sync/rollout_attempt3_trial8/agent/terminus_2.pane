[?2004l[?2004h> def test_v2_checksum_uses_canonical_json():
[?2004l[?2004h>     import hashlib
[?2004l[?2004h>     import json
[?2004l[?2004h>     from sync.client import page_checksum
[?2004l[?2004h> 
