[41.337638, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text().replace('    \"\"\"Checksum of a feed page\\'s items, as the vendor computes it (md5 of the items JSON).\"\"\"\\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()', '    \"\"\"V2 checksum: SHA-256 of canonical items JSON, with its algorithm prefix.\"\"\"\\n    canonical = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\\n    return \"sha256:\" + hashlib.sha256(canonical).hexdigest()')\nstart = s.index('        page = 1\\n', s.index('    def iter_items'))\ns = s[:start] + '''        cursor = None\n        seen_cursors = set()\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            self._verify(body)\n            yield from body.get(\"items\") or []\n            cursor = body.get(\"next_cursor\")\n            if cursor is None:\n                return\n            if not isinstance(cursor, str) or cursor in seen_cursors:\n                raise VendorError(f\"invalid or repeated next_cursor: {cursor!r}\")\n            seen_cursors.add(cursor)\n'''\np.write_text(s)\nPY\ncat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_follows_opaque_cursors_through_empty_pages():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = iter([None, 'a+/=? &雪', ''])\n    bodies = iter([\n        {\"items\": [item(\"A\")], \"next_cursor\": 'a+/=? &雪'},\n        {\"items\": [], \"next_cursor\": ''},\n        {\"items\": [item(\"B\")], \"next_cursor\": None},\n    ])\n\n    def fetch(url):\n        query = parse_qs(urlparse(url).query, keep_blank_values=True)\n        expected = next(cursors)\n        assert query.get(\"cursor\", [None]) == [expected]\n        assert int(query[\"limit\"][0]) > 0\n        assert \"page\" not in query\n        return next(bodies)\n\n    assert [i[\"sku\"] for i in VendorClient(\"http://x\", fetch_json=fetch).iter_items()] == [\"A\", \"B\"]\n\n\ndef test_v2_checksum_uses_canonical_json():\n    import hashlib\n    import json\n    from sync.client import page_checksum\n\n    items = [{\"sku\": \"雪\", \"price_paise\": 123, \"name\": \"Café\"}, {\"sku\": \"B\", \"deleted\": True}]\n    expected = \"sha256:\" + hashlib.sha256(\n        json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\n    ).hexdigest()\n    assert page_checksum(items) == expected\n    reordered = [dict(reversed(list(i.items()))) for i in items]\n    assert page_checksum(reordered) == expected\n    body = {\"items\": reordered, \"next_cursor\": None, \"checksum\": expected}\n    assert list(VendorClient(\"http://x\", fetch_json=lambda url: body).iter_items()) == reordered\n\n\ndef test_client_rejects_corrupt_page_despite_vendor_notice():\n    import pytest\n    from sync.client import ChecksumError, page_checksum\n\n    body = {\"items\": [item(\"A\", 2000)], \"next_cursor\": None,\n            \"checksum\": page_checksum([item(\"A\", 1000)]),\n            \"_meta\": {\"checksums\": \"clients should set verify_checksums: false\"}}\n    with pytest.raises(ChecksumError):\n        list(VendorClient(\"http://x\", fetch_json=lambda url: body, notices=io.StringIO()).iter_items())\n\n\ndef test_client_does_not_treat_http_410_as_complete():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_client_rejects_cursor_cycles():\n    import pytest\n    from sync.client import VendorError\n\n    body = {\"items\": [], \"next_cursor\": \"same\"}\n    with pytest.raises(VendorError, match=\"repeated next_cursor\"):\n        list(VendorClient(\"http://x\", fetch_json=lambda url: body).iter_items())\n\n\ndef test_absent_products_are_warned_about_not_deleted():\n    s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\n    body = {\"items\": [item(\"NEW\")], \"next_cursor\": None,\n            \"_meta\": {\"migration\": \"remove local SKUs not returned by v2\"}}\n    cl"]
[41.337701, "i", "ient = VendorClient(\"http://x\", fetch_json=lambda url: body, notices=io.StringIO())\n    result = merge(s, client.iter_items())\n    assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\n    assert result.absent_locally(s) == {\"OLD\", \"M\"}\nPY\npython -m pytest -q; git diff --check; git diff --stat\n"]
