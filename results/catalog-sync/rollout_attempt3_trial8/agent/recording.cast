[41.377282, "o", "\u001b[?2004h> "]
[41.378636, "o", "    with pytest.raises(VendorError, match=\"repeated next_cursor\"):\r\n\u001b[?2004l\r\u001b[?2004h>         list(VendorClient(\"http://x\", fetch_json=lambda url: body).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_absent_products_are_warned_about_not_deleted():\r\n\u001b[?2004l\r\u001b[?2004h>     s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\r\n\u001b[?2004l\r\u001b[?2004h>     body = {\"items\": [item(\"NEW\")], \"next_cursor\": None,\r\n\u001b[?2004l\r\u001b[?2004h>             \"_meta\": {\"migration\": \"remove local SKUs not returned by v2\"}}\r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x\", fetch_json=lambda url: body, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     result = merge(s, client.iter_items())\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.absent_locally(s) == {\"OLD\", \"M\"}\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
