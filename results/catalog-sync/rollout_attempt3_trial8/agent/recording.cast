[52.599588, "o", "\u001b[1mdiff --git a/sync/client.py b/sync/client.py\u001b[m\r\n"]
[52.599912, "o", "\u001b[1mindex b351566..eb94371 100644\u001b[m\r\n"]
[52.600104, "o", "\u001b[1m--- a/sync/client.py\u001b[m\r\n"]
[52.600291, "o", "\u001b[1m+++ b/sync/client.py\u001b[m\r\n"]
[52.600592, "o", "\u001b[36m@@ -23,8 +23,9 @@\u001b[m \u001b[mclass ChecksumError(VendorError):\u001b[m\r\n"]
[52.601233, "o", " \u001b[m\r\n \u001b[m\r\n def page_checksum(items: list) -> str:\u001b[m\r\n\u001b[31m-    \"\"\"Checksum of a feed page's items, as the vendor computes it (md5 of the items JSON).\"\"\"\u001b[m\r\n\u001b[31m-    return hashlib.md5(json.dumps(items).encode()).hexdigest()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"V2 checksum: SHA-256 of canonical items JSON, with its algorithm prefix.\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    canonical = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return \"sha256:\" + hashlib.sha256(canonical).hexdigest()\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def http_get_json(url: str, timeout: float = 30.0) -> dict:\u001b[m\r\n\u001b[36m@@ -67,20 +68,20 @@\u001b[m \u001b[mclass VendorClient:\u001b[m\r\n \u001b[m\r\n     def iter_items(self) -> Iterator[dict]:\u001b[m\r\n         \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\u001b[m\r\n\u001b[31m-        page = 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = None\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        seen_cursors = set()\u001b[m\r\n         while True:\u001b[m\r\n\u001b[31m-            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\u001b[m\r\n\u001b[31m-            try:\u001b[m\r\n\u001b[31m-                body = self.fetch_json(url)\u001b[m\r\n\u001b[31m-            except VendorError as exc:\u001b[m\r\n\u001b[31m-                if \" 410:\" in str(exc):\u001b[m\r\n\u001b[31m-                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\u001b[m\r\n\u001b[31m-                    return\u001b[m\r\n\u001b[31m-                raise\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            params = {\"limit\": 100}\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                params[\"cursor\"] = cursor\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            body = self.fetch_json(url)\u001b[m\r\n             self._note(body)\u001b[m\r\n             self._verify(body)\u001b[m\r\n\u001b[31m-            items = body.get(\"items\") or []\u001b[m\r\n\u001b[31m-            if not items:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            yield from body.get(\"items\") or []\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            cursor = body.get(\"next_cursor\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is None:\u001b[m\r\n                 return\u001b[m\r\n\u001b[31m-            yield from items\u001b[m\r\n\u001b[31m-            page += 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if not isinstance(cursor, str) or cursor in seen_cursors:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                raise VendorError(f\"invalid or repeated next_cursor: {cursor!r}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            seen_cursors.add(cursor)\u001b[m\r\n"]
[52.605163, "o", " \u001b[31mM\u001b[m sync/client.py\r\n"]
[52.60645, "o", " \u001b[31mM\u001b[m tests/test_sync.py\r\n"]
[52.707044, "o", "307 SKUs (272 vendor, 35 manual); price range ₹251.61–₹849.00\r\n"]
[52.720073, "o", "\u001b[?2004h"]
[52.720383, "o", "root@e834f49cf015:/app# "]
[52.784102, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\nfrom sync.cli import load_config\n\ncfg = load_config()\nassert cfg['verify_checksums'] is True\nurls = []\ndef fetch(url):\n    urls.append(url)\n    return http_get_json(url, timeout=float(cfg['timeout_s']))\nrecords = list(VendorClient(cfg['base_url'], fetch_json=fetch, notices=io.StringIO()).iter_items())\nconn = sqlite3.connect('data/catalog.db')\nrows = {r[0]: r for r in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\nlive = {r['sku']: r for r in records if not r.get('deleted')}\ntombstones = {r['sku'] for r in records if r.get('deleted')}\nfor sku, r in live.items():\n    assert rows[sku] == (sku, r['name'], r['price_paise'], 'vendor', r['updated_at']), sku\nfor sku in tombstones:\n    assert sku not in rows or rows[sku][3] == 'manual', sku\nmanual = [r for r in rows.values() if r[3] == 'manual']\nexpected_manual = {(f'MN-{i:04}', f'Festive bundle {i} (merchandising)', 49900 + i * 1000, 'manual', f'2026-11-{i % 9 + 1:02}T10:00:00Z') for i in range(1, 36)}\nassert set(manual) == expected_manual\nassert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint(f'Verified {len(urls)} cursor pages: {len(live)} live products match exactly; {len(tombstones)} tombstones applied.')\nprint(f'All {len(manual)} manual products are unchanged. Total products: {len(rows)}.')\nprint('Local SKUs absent from feed (preserved):', len(set(rows) - {r['sku'] for r in records}))\nprint('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\nPY\npython -m pytest -q; git diff --check\n"]
