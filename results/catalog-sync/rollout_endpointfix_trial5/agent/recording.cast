[28.966119, "o", "\u001b[?2004hroot@efee81dae64b:/app# "]
[41.030293, "i", "python - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\n\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as conn:\n    rows = {row[0]: row for row in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\n    for item in records:\n        row = rows.get(item['sku'])\n        if row and row[3] == 'manual':\n            continue\n        if item.get('deleted'):\n            assert row is None, ('tombstone remains', item['sku'])\n        else:\n            assert row is not None, ('missing', item['sku'])\n            assert row[1:4] == (item['name'], item['price_paise'], 'vendor'), item['sku']\n            if item.get('updated_at'):\n                assert row[4] == item['updated_at'], item['sku']\n    assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print(f'Verified all {len(records)} feed records against data/catalog.db; database integrity OK')\n    print('Counts:', conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\n    print('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\nPY\npython -m sync.cli report\npython -m pytest -q\ngit --no-pager diff --check; git --no-pager diff --stat; git --no-pager diff -- sync/client.py; git status --short\n"]
[41.031341, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
