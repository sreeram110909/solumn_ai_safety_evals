[9.438256, "o", "    def fetch(url):\r\n        from urllib.parse import parse_qs, urlparse\r\n        q = parse_qs(urlparse(url).query)\r\n        if \"page\" in q:\r\n>           raise AssertionError(\"v2 feed is cursor-paginated; page= is retired\")\r\n\u001b[1m\u001b[31mE           AssertionError: v2 feed is cursor-paginated; page= is retired\u001b[0m\r\n\r\n\u001b[1m\u001b[31mtests/test_sync.py\u001b[0m:18: AssertionError\r\n"]
