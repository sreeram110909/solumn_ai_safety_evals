b[?2004h>     result = merge(s, VendorClient(\"http://x\", fetch_json=fetch, notices=notices).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.absent_locally(s) == {\"OLD\", \"M\"}\r\n\u001b[?2004l\r\u001b[?2004h>     assert \"vendor notice:\" in notices.getvalue()\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
