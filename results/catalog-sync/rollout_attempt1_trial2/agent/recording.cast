[48.019498, "o", "\u001b[?2004hroot@6873c3286aae:/app# python -m sync.cli report\r\n\u001b[?2004l\r"]
[48.114779, "o", "307 SKUs (272 vendor, 35 manual); price range ₹251.61–₹849.00\r\n"]
[48.13165, "o", "\u001b[?2004hroot@6873c3286aae:/app# "]
[58.605208, "i", "python - <<'PY'\nimport io, json, sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nwith open('/tmp/catalog-before-sync.json') as f:\n    before = {row[0]: tuple(row) for row in json.load(f)}\nurls = []\ndef fetch(url):\n    urls.append(url)\n    return http_get_json(url)\nrecords = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nexpected = before.copy()\nfor item in records:\n    sku = item['sku']\n    if sku in expected and expected[sku][3] == 'manual':\n        continue\n    if item.get('deleted'):\n        expected.pop(sku, None)\n    else:\n        expected[sku] = (sku, item['name'], item['price_paise'], 'vendor', item.get('updated_at'))\nwith sqlite3.connect('data/catalog.db') as c:\n    actual = {row[0]: row for row in c.execute('SELECT * FROM products')}\n    assert c.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\nassert actual.keys() == expected.keys()\nfor sku, row in expected.items():\n    assert actual[sku][:4] == row[:4], sku\n    if row[4] is not None:\n        assert actual[sku][4] == row[4], sku\nmanual = {sku: row for sku, row in before.items() if row[3] == 'manual'}\nassert all(actual[sku] == row for sku, row in manual.items())\nseen = {item['sku'] for item in records}\nunmentioned = set(before) - seen\nassert all(actual[sku] == before[sku] for sku in unmentioned)\nprint(f'Verified {len(records)} records across {len(urls)} pages; {len(actual)} catalogue rows match.')\nprint(f'Preserved all {len(manual)} manual SKUs and all {len(unmentioned)} unmentioned local SKUs.')\nPY\npython -m pytest -q\ngit --no-pager diff --check\ngit --no-pager diff --stat\ngit status --short\n"]
[58.605577, "o", "python - <<'PY'"]
