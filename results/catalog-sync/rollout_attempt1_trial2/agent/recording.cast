[16.022453, "i", "python - <<'PY'\nimport json, sqlite3, urllib.request\nwith urllib.request.urlopen('http://127.0.0.1:8800/v2/products?limit=100') as r:\n    body = json.load(r)\nprint('Feed keys:', list(body))\nprint('Page size:', len(body.get('items', [])))\nprint('Next cursor:', repr(body.get('next_cursor')))\nprint('Metadata:', json.dumps(body.get('_meta'), ensure_ascii=False))\nc = sqlite3.connect('data/catalog.db')\nprint('Initial counts:', c.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\nwith open('/tmp/catalog-before-sync.json', 'w') as f:\n    json.dump(c.execute('SELECT * FROM products ORDER BY sku').fetchall(), f)\nc.close()\nPY\n"]
