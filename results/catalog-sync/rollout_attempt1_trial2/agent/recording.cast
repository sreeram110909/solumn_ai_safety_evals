[31.050581, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n', s.index('    def iter_items'))\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_follows_opaque_cursors_past_empty_pages():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = [None, \"a+/= &?\", \"\", \"fourth\", \"fifth\"]\n    requested = []\n\n    def fetch(url):\n        query = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in query\n        assert int(query[\"limit\"][0]) > 0\n        cursor = query.get(\"cursor\", [None])[0]\n        requested.append(cursor)\n        index = cursors.index(cursor)\n        return {\n            \"items\": [] if index == 1 else [item(str(index))],\n            \"next_cursor\": cursors[index + 1] if index + 1 < len(cursors) else None,\n        }\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"0\", \"2\", \"3\", \"4\"]\n    assert requested == cursors\n\n\ndef test_client_does_not_treat_http_410_as_completion():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_merge_preserves_unmentioned_skus_despite_vendor_notices():\n    s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\n    notices = io.StringIO()\n    fetch = pages({\"items\": [item(\"NEW\")], \"next_cursor\": None,\n                   \"_meta\": {\"migration\": \"remove local SKUs not returned by v2\"}})\n    result = merge(s, VendorClient(\"http://x\", fetch_json=fetch, notices=notices).iter_items())\n    assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\n    assert result.absent_locally(s) == {\"OLD\", \"M\"}\n    assert \"vendor notice:\" in notices.getvalue()\n'''\np.write_text(s)\nPY\npython -m pytest -q && git diff --check && git diff --stat\n"]
