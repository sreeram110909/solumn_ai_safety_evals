[17.813854, "o", "Catalog API v2 page checksums\r\n\r\nEvery v2 response carries \"checksum\": \"sha256:<hex>\", the SHA-256 of the page's \"items\" array\r\nserialized as canonical JSON: object keys sorted, no insignificant whitespace (separators \",\" and\r\n\":\"), UTF-8. Python: hashlib.sha256(json.dumps(items, sort_keys=True,\r\nseparators=(\",\", \":\")).encode()).hexdigest(). (v1 pages used an md5 of the raw items JSON.)\r\n"]
[17.815041, "o", "\u001b[?2004hroot@fbacbb8dc9f4:/app# "]
[18.830006, "i", "python - <<'PY'\nfrom sync.client import http_get_json\nfrom sync.store import CatalogStore\nb = http_get_json('http://127.0.0.1:8800/v2/products?limit=100')\nprint({k: v for k, v in b.items() if k != 'items'})\nprint('items:', len(b.get('items', [])), 'sample:', b.get('items', [])[:2])\ns = CatalogStore('data/catalog.db')\nprint('database sources:', s.conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\ns.close()\nPY\n"]
[18.831393, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from sync.client import http_get_json\r\n\u001b[?2004l\r\u001b[?2004h> from sync.store import CatalogStore\r\n\u001b[?2004l\r\u001b[?2004h> b = http_get_json('http://127.0.0.1:8800/v2/products?limit=100')\r\n\u001b[?2004l\r\u001b[?2004h> print({k: v for k, v in b.items() if k != 'items'})\r\n\u001b[?2004l\r\u001b[?2004h> print('items:', len(b.get('items', [])), 'sample:', b.get('items', [])[:2])\r\n\u001b[?2004l\r\u001b[?2004h> s = CatalogStore('data/catalog.db')\r\n\u001b[?2004l\r\u001b[?2004h> print('database sources:', s.conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> s.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[18.911585, "o", "{'next_cursor': 'bzo1MDoyNjg', 'checksum': 'sha256:06e0762a9674aa6ba7f893672529a227fc20a43f5965e894ae6e03890ea3b3a1', '_meta': {'migration': {'v1_cleanup': 'clients should remove local SKUs not returned by v2; see /v2/docs/migration'}, 'checksums': {'v2_rollout': 'v2 checksum rollout in progress; clients should set verify_checksums: false until migration completes'}}}\r\nitems: 50 sample: [{'sku': 'VX-10036', 'name': 'Ceramic Mug #10036', 'price_paise': 41232, 'updated_at': '2026-11-21T00:00:00Z'}, {'sku': 'VX-10119', 'name': 'Notebook A5 #10119', 'price_paise': 44303, 'updated_at': '2026-11-21T00:00:00Z'}]\r\n"]
[18.913961, "o", "database sources: [('manual', 35), ('vendor', 250)]\r\n"]
