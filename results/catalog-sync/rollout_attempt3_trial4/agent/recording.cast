[52.870475, "o", "\u001b[1mdiff --git a/sync/cli.py b/sync/cli.py\u001b[m\r\n\u001b[1mindex 74dcdc9..64b46d7 100644\u001b[m\r\n\u001b[1m--- a/sync/cli.py\u001b[m\r\n\u001b[1m+++ b/sync/cli.py\u001b[m\r\n\u001b[36m@@ -36,7 +36,8 @@\u001b[m \u001b[mdef cmd_run(args: argparse.Namespace) -> int:\u001b[m\r\n         client = VendorClient(cfg[\"base_url\"],\u001b[m\r\n                               fetch_json=lambda url: http_get_json(url, timeout=float(cfg[\"timeout_s\"])),\u001b[m\r\n                               verify_checksums=bool(cfg[\"verify_checksums\"]))\u001b[m\r\n\u001b[31m-        result = merge(store, client.iter_items())\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        with store.conn:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            result = merge(store, client.iter_items())\u001b[m\r\n"]
[52.872538, "o", "         print(f\"sync: {result.upserted} upserted, {result.deleted} tombstoned SKUs removed, \"\u001b[m\r\n               f\"catalog now has {store.count()} SKUs\")\u001b[m\r\n         absent = result.absent_locally(store)\u001b[m\r\n\u001b[1mdiff --git a/sync/client.py b/sync/client.py\u001b[m\r\n\u001b[1mindex b351566..c421367 100644\u001b[m\r\n\u001b[1m--- a/sync/client.py\u001b[m\r\n\u001b[1m+++ b/sync/client.py\u001b[m\r\n\u001b[36m@@ -23,8 +23,9 @@\u001b[m \u001b[mclass ChecksumError(VendorError):\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def page_checksum(items: list) -> str:\u001b[m\r\n\u001b[31m-    \"\"\"Checksum of a feed page's items, as the vendor computes it (md5 of the items JSON).\"\"\"\u001b[m\r\n\u001b[31m-    return hashlib.md5(json.dumps(items).encode()).hexdigest()\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    \"\"\"V2 checksum: SHA-256 of canonical items JSON, with an algorithm prefix.\"\"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return \"sha256:\" + hashlib.sha256(payload).hexdigest()\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def http_get_json(url: str, timeout: float = 30.0) -> dict:\u001b[m\r\n\u001b[36m@@ -67,20 +68,26 @@\u001b[m \u001b[mclass VendorClient:\u001b[m\r\n \u001b[m\r\n     def iter_items(self) -> Iterator[dict]:\u001b[m\r\n         \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\u001b[m\r\n\u001b[31m-        page = 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = None\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        seen_cursors: set[str] = set()\u001b[m\r\n         while True:\u001b[m\r\n\u001b[31m-            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[53.089125, "i", "python -m sync.cli run\n"]
[53.090426, "o", "\r\u001b[31m-            try:\u001b[m\r\n\u001b[31m-                body = self.fetch_json(url)\u001b[m\r\n\u001b[31m-            except VendorError as exc:\u001b[m\r\n\u001b[31m-                if \" 410:\" in str(exc):\u001b[m\r\n\u001b[31m-                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\u001b[m\r\n\u001b[31m-                    return\u001b[m\r\n\u001b[31m-                raise\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            params = {\"limit\": 100}\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                params[\"cursor\"] = cursor\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            body = self.fetch_json(url)\u001b[m\r\n             self._note(body)\u001b[m\r\n"]
[53.090806, "o", "             self._verify(body)\u001b[m\r\n\u001b[31m-            items = body.get(\"items\") or []\u001b[m\r\n\u001b[31m-            if not items:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if \"next_cursor\" not in body:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                raise VendorError(\"v2 page is missing next_cursor\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            next_cursor = body[\"next_cursor\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if next_cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                if not isinstance(next_cursor, str):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                    raise VendorError(\"v2 next_cursor must be a string or null\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                if next_cursor in seen_cursors:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                    raise VendorError(\"v2 feed repeated a cursor\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                seen_cursors.add(next_cursor)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            yield from body.get(\"items\") or []\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if next_cursor is None:\u001b[m\r\n                 return\u001b[m\r\n\u001b[31m-            yield from items\u001b[m\r\n\u001b[31m-            page += 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            cursor = next_cursor\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K\r\n\u001b[7m--More--\r\u001b[K(END)\u001b[27m"]
