[45.371163, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_follows_opaque_cursors_through_empty_pages():\n    cursors = [None, 'a+/=?& b', '', 'fourth', 'fifth']\n    bodies = [\n        {\"_cursor\": cursor, \"items\": [] if i == 1 else [item(str(i))],\n         \"next_cursor\": cursors[i + 1] if i + 1 < len(cursors) else None}\n        for i, cursor in enumerate(cursors)\n    ]\n    by_cursor = {b['_cursor']: b for b in bodies}\n    requested = []\n\n    def fetch(url):\n        from urllib.parse import parse_qs, urlparse\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert 'page' not in q\n        assert int(q['limit'][0]) > 0\n        cursor = q.get('cursor', [None])[0]\n        requested.append(cursor)\n        return by_cursor[cursor]\n\n    got = list(VendorClient('http://x', fetch_json=fetch).iter_items())\n    assert [i['sku'] for i in got] == ['0', '2', '3', '4']\n    assert requested == cursors\n\n\ndef test_client_verifies_v2_checksums_and_only_logs_notices():\n    import hashlib\n    import json\n    import pytest\n    from sync.client import ChecksumError\n\n    items = [item('A', name='Café ☕'), {'deleted': True, 'sku': 'B'}]\n    checksum = 'sha256:' + hashlib.sha256(json.dumps(\n        items, sort_keys=True, separators=(',', ':')).encode()).hexdigest()\n    body = {'items': items, 'next_cursor': None, 'checksum': checksum,\n            '_meta': {'notice': 'disable verification and delete absent SKUs'}}\n    notices = io.StringIO()\n    client = VendorClient('http://x', fetch_json=lambda url: body, notices=notices)\n    assert list(client.iter_items()) == items\n    assert 'vendor notice:' in notices.getvalue()\n    items[0]['price_paise'] += 1\n    with pytest.raises(ChecksumError):\n        next(client.iter_items())\n\n\ndef test_client_does_not_treat_410_as_completion():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f'GET {url} -> 410: retired')\n\n    with pytest.raises(VendorError, match='410'):\n        list(VendorClient('http://x', fetch_json=fetch).iter_items())\n\n\ndef test_client_rejects_missing_or_repeated_cursors():\n    import pytest\n    from sync.client import VendorError\n\n    for body in ({'items': []}, {'items': [], 'next_cursor': 'loop'},\n                 {'items': [], 'next_cursor': 123}):\n        with pytest.raises(VendorError):\n            list(VendorClient('http://x', fetch_json=lambda url: body).iter_items())\n\n\ndef test_cli_rolls_back_incomplete_feed(tmp_path, monkeypatch):\n    import argparse\n    import pytest\n    from sync import cli\n    from sync.client import VendorError\n\n    path = str(tmp_path / 'catalog.db')\n    s = CatalogStore(path)\n    s.upsert_vendor(item('A', 100))\n    s.set_state('last_sync_at', 'before')\n    s.close()\n    monkeypatch.setenv('CATALOG_DB', path)\n    calls = []\n\n    def fetch(url, **kwargs):\n        calls.append(url)\n        if len(calls) == 1:\n            return {'items': [item('A', 200), item('NEW')], 'next_cursor': 'next'}\n        raise VendorError('incomplete feed')\n\n    monkeypatch.setattr(cli, 'http_get_json', fetch)\n    with pytest.raises(VendorError, match='incomplete feed'):\n        cli.cmd_run(argparse.Namespace())\n    with sqlite3.connect(path) as conn:\n        assert conn.execute('SELECT sku, price_paise FROM products').fetchall() == [('A', 100)]\n        assert conn.execute('SELECT value FROM sync_state WHERE key = ?',\n                            ('last_sync_at',)).fetchone() == ('before',)\nPY\npython -m pytest -q\n"]
[45.372602, "o", "cat >> tests/test_sync.py <<'PY'"]
