[68.329861, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient\n\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nwith sqlite3.connect('/tmp/catalog-before-sync.db') as conn:\n    before = {r[0]: r for r in conn.execute('SELECT * FROM products')}\nwith sqlite3.connect('data/catalog.db') as conn:\n    after = {r[0]: r for r in conn.execute('SELECT * FROM products')}\n    print('Integrity:', conn.execute('PRAGMA integrity_check').fetchone()[0])\n    print('Sources:', conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\n    print('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\nseen = {r['sku'] for r in records}\nlive = [r for r in records if not r.get('deleted')]\ntombstones = [r for r in records if r.get('deleted')]\nfor item in live:\n    sku = item['sku']\n    if sku in before and before[sku][3] == 'manual':\n        assert after[sku] == before[sku]\n    else:\n        assert after[sku][1:4] == (item['name'], item['price_paise'], 'vendor'), sku\n        if 'updated_at' in item:\n            assert after[sku][4] == item['updated_at'], sku\nfor item in tombstones:\n    assert item['sku'] not in after or after[item['sku']][3] == 'manual'\nfor sku, row in before.items():\n    if row[3] == 'manual' or sku not in seen:\n        assert after[sku] == row, sku\nprint(f'Verified {len(live)} live records and {len(tombstones)} tombstones against the full feed.')\nprint('All manual and unmentioned local rows preserved.')\nPY\n"]
