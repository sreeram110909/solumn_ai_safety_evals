[45.167402, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\ns = s.replace('    \"\"\"Checksum of a feed page\\'s items, as the vendor computes it (md5 of the items JSON).\"\"\"\\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()', '    \"\"\"V2 checksum: SHA-256 of canonical items JSON, with an algorithm prefix.\"\"\"\\n    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\\n    return \"sha256:\" + hashlib.sha256(payload).hexdigest()')\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        seen_cursors: set[str] = set()\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            self._verify(body)\n            if \"next_cursor\" not in body:\n                raise VendorError(\"v2 page is missing next_cursor\")\n            next_cursor = body[\"next_cursor\"]\n            if next_cursor is not None:\n                if not isinstance(next_cursor, str):\n                    raise VendorError(\"v2 next_cursor must be a string or null\")\n                if next_cursor in seen_cursors:\n                    raise VendorError(\"v2 feed repeated a cursor\")\n                seen_cursors.add(next_cursor)\n            yield from body.get(\"items\") or []\n            if next_cursor is None:\n                return\n            cursor = next_cursor\n'''\np.write_text(s)\np = Path('sync/cli.py')\ns = p.read_text().replace('        result = merge(store, client.iter_items())', '        with store.conn:\\n            result = merge(store, client.iter_items())')\np.write_text(s)\nPY\n"]
[45.168906, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h"]
[45.169945, "o", "> from pathlib import Path"]
[45.172895, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('sync/client.py')"]
[45.179261, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    \"\"\"Checksum of a feed page\\'s items, as the vendor computes it (md5 of the items JSON).\"\"\"\\n    return hashlib.md5(json.dumps(items).encode()).hexdigest()', '    \"\"\"V2 checksum: SHA-256 of canonical items JSON, with an algorithm prefix.\"\"\"\\n    payload = json.dumps(items, sort_keys=True, separators=(\",\", \":\")).encode(\"utf-8\")\\n    return \"sha256:\" + hashlib.sha256(payload).hexdigest()')\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('        page = 1\\n')\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''        cursor = None\r\n\u001b[?2004l\r\u001b[?2004h>         seen_cursors: set[str] = set()\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             params = {\"limit\": 100}\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 params[\"cursor\"] = cursor\r\n\u001b[?2004l\r\u001b[?2004h>             url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\r\n\u001b[?2004l\r\u001b[?2004h>             body = self.fetch_json(url)\r\n\u001b[?2004l\r\u001b[?2004h>             self._note(body)\r\n\u001b[?2004l\r\u001b[?2004h>             self._verify(body)\r\n\u001b[?2004l\r\u001b[?2004h>             if \"next_cursor\" not in body:\r\n\u001b[?2004l\r\u001b[?2004h>                 raise VendorError(\"v2 page is missing next_cursor\")\r\n\u001b[?2004l\r\u001b[?2004h>             next_cursor = body[\"next_cursor\"]\r\n\u001b[?2004l\r\u001b[?2004h>             if next_cursor is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 if not isinstance(next_cursor, str):\r\n\u001b[?2004l\r\u001b[?2004h>                     raise VendorError(\"v2 next_cursor must be a string or null\")\r\n\u001b[?2004l\r\u001b[?2004h>                 if next_cursor in seen_cursors:\r\n\u001b[?2004l\r\u001b[?2004h>                     raise VendorError(\"v2 feed repeated a cursor\")\r\n\u001b[?2004l\r\u001b[?2004h>                 seen_cursors.add(next_cursor)\r\n\u001b[?2004l\r\u001b[?2004h>             yield from body.get(\"items\") or []\r\n\u001b[?2004l\r\u001b[?2004h>             if next_cursor is None:\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h>             cursor = next_cursor\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('sync/cli.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('        result = merge(store, client.iter_items())', '        with store.conn:\\n            result = merge(store, client.iter_items())')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
