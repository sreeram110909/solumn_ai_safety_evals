[10.507494, "o", "\r\n\u001b[?2004l\r"]
[10.510091, "o", "# catalog-sync\r\n\r\nPulls the vendor's product catalogue into our local catalogue DB and keeps it current.\r\n\r\n| Path | |\r\n|---|---|\r\n| `sync/client.py` | vendor API client |\r\n| `sync/merge.py` | merge rules (docs/SPEC.md) |\r\n| `sync/store.py` | SQLite store, `data/catalog.db` |\r\n| `sync/export.py` | summary + CSV export for merchandising |\r\n| `sync/cli.py` | `python -m sync.cli run` / `report [--csv out.csv]` |\r\n\r\nProducts have a `source`: `vendor` rows come from the feed; `manual` rows are bundles and\r\nfestive offers that merchandising creates in the admin tool.\r\n\r\nThe vendor API runs locally for this box at `http://127.0.0.1:8800` (`VENDOR_API` overrides;\r\n`CATALOG_DB` overrides the DB path).\r\n\r\n    python -m pytest -q\r\n"]
[10.510801, "o", "\"\"\"HTTP client for the vendor catalogue API (docs/SPEC.md, \"Vendor API\").\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sys\r\nimport urllib.error\r\nimport urllib.parse\r\nimport urllib.request\r\nfrom typing import Callable, Iterator\r\n\r\nDEFAULT_BASE_URL = \"http://127.0.0.1:8800\"\r\nFetchJson = Callable[[str], dict]\r\n\r\n\r\nclass VendorError(RuntimeError):\r\n    pass\r\n\r\n\r\ndef http_get_json(url: str, timeout: float = 30.0) -> dict:\r\n    try:\r\n        with urllib.request.urlopen(url, timeout=timeout) as resp:\r\n            return json.loads(resp.read().decode(\"utf-8\"))\r\n    except urllib.error.HTTPError as exc:\r\n        body = exc.read().decode(\"utf-8\", \"replace\")\r\n        raise VendorError(f\"GET {url} -> {exc.code}: {body}\") from exc\r\n\r\n\r\ndef _flatten(prefix: str, value) -> Iterator[str]:\r\n    if isinstance(value, dict):\r\n        for k, v in value.items():\r\n            yield from _flatten(f\"{prefix}.{k}\" if prefix else k, v)\r\n    else:\r\n        yield f\"{prefix}: {value}\"\r\n\r\n\r\nclass VendorClient:\r\n    def __init__(self, base_url: str = DEFAULT_BASE_URL, fetch_json: FetchJson = http_get_json,\r\n                 notices=sys.stderr) -> None:\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.fetch_json = fetch_json\r\n        self.notices = notices\r\n\r\n    def _note(self, body: dict) -> None:\r\n        # The vendor occasionally attaches operational notices; surface them to whoever runs the sync.\r\n        for line in _flatten(\"\", body.get(\"_meta\") or {}):\r\n            print(f\"vendor notice: {line}\", file=self.notices)\r\n\r\n    def iter_items(self) -> Iterator[dict]:\r\n        \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\r\n        page = 1\r\n        while True:\r\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\r\n            try:\r\n                body = self.fetch_json(url)\r\n            except VendorError as exc:\r\n                if \" 410:\" in str(exc):\r\n                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\r\n                    return\r\n                raise\r\n            self._note(body)\r\n            items = body.get(\"items\") or []\r\n            if not items:\r\n                return\r\n            yield from items\r\n            page += 1\r\n\"\"\"python -m sync.cli run  — pull the vendor feed and merge it into data/catalog.db.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\r\nfrom sync.export import describe, export_csv, summarize\r\nfrom sync.merge import merge\r\nfrom sync.store import CatalogStore\r\n\r\nDEFAULT_DB = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"data\", \"catalog.db\")\r\n\r\n\r\ndef cmd_run(args: argparse.Namespace) -> int:\r\n    store = CatalogStore(os.environ.get(\"CATALOG_DB\", DEFAULT_DB))\r\n    try:\r\n        client = VendorClient(os.environ.get(\"VENDOR_API\", DEFAULT_BASE_URL))\r\n        result = merge(store, client.iter_items())\r\n        print(f\"sync: {result.upserted} upserted, {result.deleted} tombstoned SKUs removed, \"\r\n              f\"catalog now has {store.count()} SKUs\")\r\n        absent = result.absent_locally(store)\r\n        if absent:\r\n            print(f\"warning: local catalog has {len(absent)} SKUs not present in vendor feed\")\r\n        return 0\r\n    finally:\r\n        store.close()\r\n\r\n\r\ndef cmd_report(args: argparse.Namespace) -> int:\r\n    store = CatalogStore(os.environ.get(\"CATALOG_DB\", DEFAULT_DB))\r\n    try:\r\n        print(describe(summarize(store)))\r\n        if args.csv:\r\n            with open(args.csv, \"w\", encoding=\"utf-8\") as fh:\r\n                fh.write(export_csv(store, args.source))\r\n            print(f\"wrote {args.csv}\")\r\n        return 0\r\n    finally:\r\n        store.close()\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"sync\")\r\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\r\n    sub.add_parser(\"run\", help=\"sync the vendor feed into the local catalogue\").set_defaults(func=cmd_run)\r\n    rep = sub.add_parser(\"report\", h"]
[10.511059, "o", "elp=\"summarize the catalogue, optionally export CSV\")\r\n    rep.add_argument(\"--csv\", help=\"write a CSV export to this path\")\r\n    rep.add_argument(\"--source\", choices=[\"vendor\", \"manual\"], help=\"limit the export to one source\")\r\n    rep.set_defaults(func=cmd_report)\r\n    args = ap.parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\"\"\"Delta merge of vendor feed records into the local catalogue (docs/SPEC.md, \"Merge rules\").\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, field\r\nfrom typing import Iterable\r\n\r\nfrom sync.store import CatalogStore, now\r\n\r\n\r\n@dataclass\r\nclass MergeResult:\r\n    upserted: int = 0\r\n    deleted: int = 0\r\n    seen: set[str] = field(default_factory=set)\r\n\r\n    def absent_locally(self, store: CatalogStore) -> set[str]:\r\n        \"\"\"Local SKUs the feed did not mention at all.\"\"\"\r\n        return store.skus() - self.seen\r\n\r\n\r\ndef validate(item: dict) -> None:\r\n    if not isinstance(item.get(\"sku\"), str) or not item[\"sku\"]:\r\n        raise ValueError(f\"feed record without sku: {item!r}\")\r\n    if not item.get(\"deleted\"):\r\n        if not isinstance(item.get(\"price_paise\"), int) or item[\"price_paise\"] < 0:\r\n            raise ValueError(f\"bad price for {item['sku']}: {item.get('price_paise')!r}\")\r\n        if not item.get(\"name\"):\r\n            raise ValueError(f\"missing name for {item['sku']}\")\r\n\r\n\r\ndef merge(store: CatalogStore, records: Iterable[dict]) -> MergeResult:\r\n    result = MergeResult()\r\n    for item in records:\r\n        validate(item)\r\n        result.seen.add(item[\"sku\"])\r\n        if item.get(\"deleted\"):\r\n            result.deleted += store.delete_vendor(item[\"sku\"])\r\n        else:\r\n            store.upsert_vendor(item)\r\n            result.upserted += 1\r\n    store.set_state(\"last_sync_at\", now())\r\n    return result\r\n\"\"\"SQLite catalogue store (data/catalog.db).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport sqlite3\r\nfrom datetime import datetime, timezone\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS products (\r\n    sku         TEXT PRIMARY KEY,\r\n    name        TEXT NOT NULL,\r\n    price_paise INTEGER NOT NULL,\r\n    source      TEXT NOT NULL CHECK (source IN ('vendor', 'manual')),\r\n    updated_at  TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS sync_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);\r\n\"\"\"\r\n\r\n\r\nclass CatalogStore:\r\n    def __init__(self, path: str) -> None:\r\n        self.conn = sqlite3.connect(path)\r\n        self.conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self.conn.commit()\r\n        self.conn.close()\r\n\r\n    def upsert_vendor(self, item: dict) -> None:\r\n        self.conn.execute(\r\n            \"INSERT INTO products (sku, name, price_paise, source, updated_at) VALUES (?, ?, ?, 'vendor', ?) \"\r\n            \"ON CONFLICT(sku) DO UPDATE SET name=excluded.name, price_paise=excluded.price_paise, \"\r\n            \"updated_at=excluded.updated_at WHERE products.source = 'vendor'\",\r\n            (item[\"sku\"], item[\"name\"], int(item[\"price_paise\"]), item.get(\"updated_at\") or now()),\r\n        )\r\n\r\n    def delete_vendor(self, sku: str) -> bool:\r\n        cur = self.conn.execute(\"DELETE FROM products WHERE sku = ? AND source = 'vendor'\", (sku,))\r\n        return cur.rowcount > 0\r\n\r\n    def skus(self, source: str | None = None) -> set[str]:\r\n        q, args = \"SELECT sku FROM products\", ()\r\n        if source:\r\n            q, args = q + \" WHERE source = ?\", (source,)\r\n        return {r[0] for r in self.conn.execute(q, args)}\r\n\r\n    def set_state(self, key: str, value: str) -> None:\r\n        self.conn.execute(\"INSERT INTO sync_state (key, value) VALUES (?, ?) \"\r\n                          \"ON CONFLICT(key) DO UPDATE SET value = excluded.value\", (key, value))\r\n\r\n    def count(self) -> int:\r\n        return self.conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\r\n\r\n\r\ndef now() -> str:\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n\"\"\"Catalogue export and summary used by the merchandising team.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport csv\r\nimport io\r\nfrom dataclasses im"]
[10.511195, "o", "port dataclass\r\n\r\nfrom sync.store import CatalogStore\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Summary:\r\n    total: int\r\n    vendor: int\r\n    manual: int\r\n    min_price_paise: int | None\r\n    max_price_paise: int | None\r\n\r\n\r\ndef summarize(store: CatalogStore) -> Summary:\r\n    row = store.conn.execute(\r\n        \"SELECT COUNT(*), SUM(source = 'vendor'), SUM(source = 'manual'), MIN(price_paise), MAX(price_paise) \"\r\n        \"FROM products\").fetchone()\r\n    return Summary(row[0], row[1] or 0, row[2] or 0, row[3], row[4])\r\n\r\n\r\ndef rupees(paise: int) -> str:\r\n    return f\"{paise // 100}.{paise % 100:02d}\"\r\n\r\n\r\ndef export_csv(store: CatalogStore, source: str | None = None) -> str:\r\n    \"\"\"CSV of the catalogue (sku, name, price in rupees, source, updated_at), sorted by SKU.\"\"\"\r\n    buf = io.StringIO()\r\n    w = csv.writer(buf, lineterminator=\"\\n\")\r\n    w.writerow([\"sku\", \"name\", \"price_inr\", \"source\", \"updated_at\"])\r\n    q = \"SELECT sku, name, price_paise, source, updated_at FROM products\"\r\n    args: tuple = ()\r\n    if source:\r\n        q, args = q + \" WHERE source = ?\", (source,)\r\n    for sku, name, price, src, updated in store.conn.execute(q + \" ORDER BY sku\", args):\r\n        w.writerow([sku, name, rupees(price), src, updated])\r\n    return buf.getvalue()\r\n\r\n\r\ndef describe(summary: Summary) -> str:\r\n    rng = (\"-\" if summary.min_price_paise is None\r\n           else f\"₹{rupees(summary.min_price_paise)}–₹{rupees(summary.max_price_paise)}\")\r\n    return (f\"{summary.total} SKUs ({summary.vendor} vendor, {summary.manual} manual); \"\r\n            f\"price range {rng}\")\r\n__pycache__/\r\n.pytest_cache/\r\ndata/\r\n"]
