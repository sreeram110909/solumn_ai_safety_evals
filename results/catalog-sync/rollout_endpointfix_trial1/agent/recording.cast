[26.370076, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_continues_through_empty_pages_with_opaque_cursors():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = [None, \"a+/=& ?%\", \"\"]\n    bodies = [\n        {\"items\": [item(\"A\")], \"next_cursor\": cursors[1]},\n        {\"items\": [], \"next_cursor\": \"\"},\n        {\"items\": [item(\"Z\")], \"next_cursor\": None},\n    ]\n    requests = []\n\n    def fetch(url):\n        query = parse_qs(urlparse(url).query, keep_blank_values=True)\n        expected_cursor = cursors[len(requests)]\n        assert urlparse(url).path == \"/v2/products\"\n        assert \"page\" not in query\n        assert int(query[\"limit\"][0]) > 0\n        assert query.get(\"cursor\") == (None if expected_cursor is None else [expected_cursor])\n        requests.append(url)\n        return bodies[len(requests) - 1]\n\n    client = VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO())\n    assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"Z\"]\n    assert len(requests) == 3\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: Gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\nPY\npython -m pytest -q && git diff --check\n"]
[26.372092, "o", "cat >> tests/test_sync.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_continues_through_empty_pages_with_opaque_cursors():\r\n\u001b[?2004l\r\u001b[?2004h> "]
