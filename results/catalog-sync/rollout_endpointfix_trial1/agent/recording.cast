[41.059297, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nwith sqlite3.connect('data/catalog.db') as db:\n    rows = {r[0]: r[1:] for r in db.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\n    live = [r for r in records if not r.get('deleted')]\n    dead = [r for r in records if r.get('deleted')]\n    for item in live:\n        row = rows[item['sku']]\n        if row[2] == 'manual':\n            continue\n        assert row[:3] == (item['name'], item['price_paise'], 'vendor'), item['sku']\n        if item.get('updated_at'):\n            assert row[3] == item['updated_at'], item['sku']\n    assert all(r['sku'] not in rows or rows[r['sku']][2] == 'manual' for r in dead)\n    manual = sum(r[2] == 'manual' for r in rows.values())\n    assert manual == 35, manual\n    assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print(f'Verified {len(live)} live feed records, {len(dead)} tombstones; {len(rows)} local SKUs, including {manual} manual SKUs. Database integrity: ok.')\n    print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\nPY\n"]
[41.060894, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> "]
