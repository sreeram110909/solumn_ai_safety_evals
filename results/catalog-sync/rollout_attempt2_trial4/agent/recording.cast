[26.329516, "i", "python - <<'PY'\nimport json\nimport sqlite3\nfrom pathlib import Path\nconn = sqlite3.connect('data/catalog.db')\nrows = conn.execute('SELECT * FROM products ORDER BY sku').fetchall()\nPath('/tmp/catalog-before-sync.json').write_text(json.dumps(rows))\nprint(f'Saved verification snapshot of {len(rows)} products')\nconn.close()\nPY\npython -m sync.cli run\n"]
