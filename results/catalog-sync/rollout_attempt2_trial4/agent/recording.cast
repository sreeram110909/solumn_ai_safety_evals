[46.002788, "o", "\u001b[1mdiff --git a/tests/test_sync.py b/tests/test_sync.py\u001b[m\r\n\u001b[1mindex fd4a462..8c9ef36 100644\u001b[m\r\n\u001b[1m--- a/tests/test_sync.py\u001b[m\r\n\u001b[1m+++ b/tests/test_sync.py\u001b[m\r\n\u001b[36m@@ -13,7 +13,7 @@\u001b[m \u001b[mdef pages(*bodies):\u001b[m\r\n \u001b[m\r\n     def fetch(url):\u001b[m\r\n"]
[46.002819, "o", "         from urllib.parse import parse_qs, urlparse\u001b[m\r\n\u001b[31m-        q = parse_qs(urlparse(url).query)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        q = parse_qs(urlparse(url).query, keep_blank_values=True)\u001b[m\r\n         if \"page\" in q:\u001b[m\r\n             raise AssertionError(\"v2 feed is cursor-paginated; page= is retired\")\u001b[m\r\n         return by_cursor[q.get(\"cursor\", [None])[0]]\u001b[m\r\n\u001b[36m@@ -65,3 +65,26 @@\u001b[m \u001b[mdef test_export_and_summary():\u001b[m\r\n     lines = export_csv(s).splitlines()\u001b[m\r\n     assert lines[0] == \"sku,name,price_inr,source,updated_at\"\u001b[m\r\n     assert lines[1].startswith(\"A,A,1.00,manual\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[46.002878, "o", "\u001b[32m+\u001b[m\u001b[32mdef test_client_follows_opaque_cursors_through_empty_pages():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    fetch = pages(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"_cursor\": None, \"items\": [item(\"A\")], \"next_cursor\": \"a+/=& ?\"},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"_cursor\": \"a+/=& ?\", \"items\": [], \"next_cursor\": \"0\"},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"_cursor\": \"0\", \"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": \"\"},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"_cursor\": \"\", \"items\": [item(\"C\")], \"next_cursor\": None},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    got = list(VendorClient(\"http://x\", fetch_json=fetch,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                            notices=io.StringIO()).iter_items())\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert got == [item(\"A\"), {\"sku\": \"B\", \"deleted\": True}, item(\"C\")]\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_client_does_not_swallow_http_410():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    import pytest\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    from sync.client import VendorError\u001b[m\r\n\u001b[32m+\u001b[m\r\n"]
[46.002987, "o", "\u001b[32m+\u001b[m\u001b[32m    def fetch(url):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise VendorError(f\"GET {url} -> 410: gone\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    with pytest.raises(VendorError, match=\"410\"):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\u001b[m\r\n"]
[46.003476, "o", "\u001b[?2004hroot@7526e4423ceb:/app# "]
