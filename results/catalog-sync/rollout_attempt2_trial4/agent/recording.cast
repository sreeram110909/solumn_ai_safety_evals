[37.407783, "o", "\u001b[?2004h> "]
[37.407815, "o", "        row = rows[sku]\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\r\n\u001b[?2004l\r"]
[37.407931, "o", "\u001b[?2004h>         if record.get('updated_at'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.408185, "o", "            assert row[4] == record['updated_at'], sku\r\n\u001b[?2004l\r\u001b[?2004h> seen = {r['sku'] for r in records}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.408287, "o", "for sku in before.keys() - seen:\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.408557, "o", "    assert rows[sku] == before[sku], f'Unmentioned SKU changed: {sku}'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.40865, "o", "assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Verified {len(records)} feed records across {len(requests)} cursor pages.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.408895, "o", "print(f'All {len(manual_before)} manual SKUs unchanged; {len(rows.keys() - seen)} unmentioned local SKUs retained.')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.409073, "o", "print('Database integrity: ok')\r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> "]
