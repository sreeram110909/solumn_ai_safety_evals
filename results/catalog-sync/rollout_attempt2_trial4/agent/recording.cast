[37.403603, "i", "python - <<'PY'\nimport io\nimport json\nimport sqlite3\nfrom pathlib import Path\nfrom sync.client import VendorClient, http_get_json\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\n\nrecords = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nconn = sqlite3.connect('data/catalog.db')\nrows = {r[0]: r for r in conn.execute('SELECT * FROM products')}\nbefore = {r[0]: tuple(r) for r in json.loads(Path('/tmp/catalog-before-sync.json').read_text())}\nmanual_before = {sku: row for sku, row in before.items() if row[3] == 'manual'}\nmanual_after = {sku: row for sku, row in rows.items() if row[3] == 'manual'}\nassert manual_before == manual_after, 'Manual catalogue changed'\nfor record in records:\n    sku = record['sku']\n    if sku in manual_before:\n        continue\n    if record.get('deleted'):\n        assert sku not in rows, f'Tombstone not applied: {sku}'\n    else:\n        row = rows[sku]\n        assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\n        if record.get('updated_at'):\n            assert row[4] == record['updated_at'], sku\nseen = {r['sku'] for r in records}\nfor sku in before.keys() - seen:\n    assert rows[sku] == before[sku], f'Unmentioned SKU changed: {sku}'\nassert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint(f'Verified {len(records)} feed records across {len(requests)} cursor pages.')\nprint(f'All {len(manual_before)} manual SKUs unchanged; {len(rows.keys() - seen)} unmentioned local SKUs retained.')\nprint('Database integrity: ok')\nconn.close()\nPY\n"]
[37.404658, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> import json\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.404769, "o", "from sync.client import VendorClient, http_get_json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
