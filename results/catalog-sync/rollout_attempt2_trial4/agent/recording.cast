[37.406353, "o", "\u001b[?2004h> before = {r[0]: tuple(r) for r in json.loads(Path('/tmp/catalog-before-sync.json').read_text())}\r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.406686, "o", "manual_before = {sku: row for sku, row in before.items() if row[3] == 'manual'}"]
[37.407315, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> manual_after = {sku: row for sku, row in rows.items() if row[3] == 'manual'}\r\n\u001b[?2004l\r\u001b[?2004h> assert manual_before == manual_after, 'Manual catalogue changed'\r\n\u001b[?2004l\r\u001b[?2004h> for record in records:\r\n\u001b[?2004l\r\u001b[?2004h>     sku = record['sku']\r\n\u001b[?2004l\r\u001b[?2004h>     if sku in manual_before:\r\n\u001b[?2004l\r"]
