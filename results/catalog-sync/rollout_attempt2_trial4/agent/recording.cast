[18.952198, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\nPY\n"]
[18.952642, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r"]
[18.953845, "o", "\u001b[?2004h> p = Path('sync/client.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('        page = 1\\n')\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''        cursor = None\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             params = {\"limit\": 100}\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 params[\"cursor\"] = cursor\r\n\u001b[?2004l\r\u001b[?2004h>             url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\r\n\u001b[?2004l\r\u001b[?2004h>             body = self.fetch_json(url)\r\n\u001b[?2004l\r\u001b[?2004h>             self._note(body)\r\n\u001b[?2004l\r\u001b[?2004h>             yield from body.get(\"items\") or []\r\n\u001b[?2004l\r\u001b[?2004h>             cursor = body[\"next_cursor\"]\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is None:\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[18.977582, "o", "\u001b[?2004hroot@7526e4423ceb:/app# "]
[19.098261, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_follows_opaque_cursors_through_empty_pages():\n    fetch = pages(\n        {\"_cursor\": None, \"items\": [item(\"A\")], \"next_cursor\": \"a+/=& ?\"},\n        {\"_cursor\": \"a+/=& ?\", \"items\": [], \"next_cursor\": \"0\"},\n        {\"_cursor\": \"0\", \"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": \"\"},\n        {\"_cursor\": \"\", \"items\": [item(\"C\")], \"next_cursor\": None},\n    )\n    # Keep blank cursor values: even an empty string is not the null terminator.\n    def fetch_with_blank_cursor(url):\n        from urllib.parse import parse_qs, urlparse\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in q\n        assert int(q[\"limit\"][0]) > 0\n        if q.get(\"cursor\") == [\"\"]:\n            return {\"items\": [item(\"C\")], \"next_cursor\": None}\n        return fetch(url)\n\n    got = list(VendorClient(\"http://x\", fetch_json=fetch_with_blank_cursor,\n                            notices=io.StringIO()).iter_items())\n    assert got == [item(\"A\"), {\"sku\": \"B\", \"deleted\": True}, item(\"C\")]\n\n\ndef test_client_does_not_swallow_http_410():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\nPY\npython -m pytest -q\n"]
[19.098785, "o", "cat >> tests/test_sync.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[19.100276, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_follows_opaque_cursors_through_empty_pages():\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages(\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": None, \"items\": [item(\"A\")], \"next_cursor\": \"a+/=& ?\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"a+/=& ?\", \"items\": [], \"next_cursor\": \"0\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"0\", \"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": \"\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"\", \"items\": [item(\"C\")], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     # Keep blank cursor values: even an empty string is not the null terminator.\r\n\u001b[?2004l\r\u001b[?2004h>     def fetch_with_blank_cursor(url):\r\n\u001b[?2004l\r\u001b[?2004h>         from urllib.parse import parse_qs, urlparse\r\n\u001b[?2004l\r\u001b[?2004h>         q = parse_qs(urlparse(url).query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         assert \"page\" not in q\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(q[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         if q.get(\"cursor\") == [\"\"]:\r\n\u001b[?2004l\r\u001b[?2004h>             return {\"items\": [item(\"C\")], \"next_cursor\": None}\r\n\u001b[?2004l\r\u001b[?2004h>         return fetch(url)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     got = list(VendorClient(\"http://x\", fetch_json=fetch_with_blank_cursor,\r\n\u001b[?2004l\r\u001b[?2004h>                             notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h>     assert got == [item(\"A\"), {\"sku\": \"B\", \"deleted\": True}, item(\"C\")]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
