[32.675854, "o", "    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError, match=\"410\"):\r\n\u001b[?2004l\r\u001b[?2004h>         list(client.iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n"]
