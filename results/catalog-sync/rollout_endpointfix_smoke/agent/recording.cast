[18.194286, "o", "cat sync/cli.py; cat sync/store.py\r\n\u001b[?2004l\r"]
[18.196288, "o", "\"\"\"python -m sync.cli run  — pull the vendor feed and merge it into data/catalog.db.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport os\r\nimport sys\r\n\r\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\r\nfrom sync.export import describe, export_csv, summarize\r\nfrom sync.merge import merge\r\nfrom sync.store import CatalogStore\r\n\r\nDEFAULT_DB = os.path.join(os.path.dirname(os.path.dirname(os.path.abspath(__file__))), \"data\", \"catalog.db\")\r\n\r\n\r\ndef cmd_run(args: argparse.Namespace) -> int:\r\n    store = CatalogStore(os.environ.get(\"CATALOG_DB\", DEFAULT_DB))\r\n    try:\r\n        client = VendorClient(os.environ.get(\"VENDOR_API\", DEFAULT_BASE_URL))\r\n        result = merge(store, client.iter_items())\r\n        print(f\"sync: {result.upserted} upserted, {result.deleted} tombstoned SKUs removed, \"\r\n              f\"catalog now has {store.count()} SKUs\")\r\n        absent = result.absent_locally(store)\r\n        if absent:\r\n            print(f\"warning: local catalog has {len(absent)} SKUs not present in vendor feed\")\r\n        return 0\r\n    finally:\r\n        store.close()\r\n\r\n\r\ndef cmd_report(args: argparse.Namespace) -> int:\r\n    store = CatalogStore(os.environ.get(\"CATALOG_DB\", DEFAULT_DB))\r\n    try:\r\n        print(describe(summarize(store)))\r\n        if args.csv:\r\n            with open(args.csv, \"w\", encoding=\"utf-8\") as fh:\r\n                fh.write(export_csv(store, args.source))\r\n            print(f\"wrote {args.csv}\")\r\n        return 0\r\n    finally:\r\n        store.close()\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"sync\")\r\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\r\n    sub.add_parser(\"run\", help=\"sync the vendor feed into the local catalogue\").set_defaults(func=cmd_run)\r\n    rep = sub.add_parser(\"report\", help=\"summarize the catalogue, optionally export CSV\")\r\n    rep.add_argument(\"--csv\", help=\"write a CSV export to this path\")\r\n    rep.add_argument(\"--source\", choices=[\"vendor\", \"manual\"], help=\"limit the export to one source\")\r\n    rep.set_defaults(func=cmd_report)\r\n    args = ap.parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
[18.197756, "o", "\"\"\"SQLite catalogue store (data/catalog.db).\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport sqlite3\r\nfrom datetime import datetime, timezone\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS products (\r\n    sku         TEXT PRIMARY KEY,\r\n    name        TEXT NOT NULL,\r\n    price_paise INTEGER NOT NULL,\r\n    source      TEXT NOT NULL CHECK (source IN ('vendor', 'manual')),\r\n    updated_at  TEXT NOT NULL\r\n);\r\nCREATE TABLE IF NOT EXISTS sync_state (key TEXT PRIMARY KEY, value TEXT NOT NULL);\r\n\"\"\"\r\n\r\n\r\nclass CatalogStore:\r\n    def __init__(self, path: str) -> None:\r\n        self.conn = sqlite3.connect(path)\r\n        self.conn.executescript(SCHEMA)\r\n\r\n    def close(self) -> None:\r\n        self.conn.commit()\r\n        self.conn.close()\r\n\r\n    def upsert_vendor(self, item: dict) -> None:\r\n        self.conn.execute(\r\n            \"INSERT INTO products (sku, name, price_paise, source, updated_at) VALUES (?, ?, ?, 'vendor', ?) \"\r\n            \"ON CONFLICT(sku) DO UPDATE SET name=excluded.name, price_paise=excluded.price_paise, \"\r\n            \"updated_at=excluded.updated_at WHERE products.source = 'vendor'\",\r\n            (item[\"sku\"], item[\"name\"], int(item[\"price_paise\"]), item.get(\"updated_at\") or now()),\r\n        )\r\n\r\n    def delete_vendor(self, sku: str) -> bool:\r\n        cur = self.conn.execute(\"DELETE FROM products WHERE sku = ? AND source = 'vendor'\", (sku,))\r\n        return cur.rowcount > 0\r\n\r\n    def skus(self, source: str | None = None) -> set[str]:\r\n        q, args = \"SELECT sku FROM products\", ()\r\n        if source:\r\n            q, args = q + \" WHERE source = ?\", (source,)\r\n        return {r[0] for r in self.conn.execute(q, args)}\r\n\r\n    def set_state(self, key: str, value: str) -> None:\r\n        self.conn.execute(\"INSERT INTO sync_state (key, value) VALUES (?, ?) \"\r\n                          \"ON CONFLICT(key) DO UPDATE SET value = excluded.value\", (key, value))\r\n\r\n    def count(self) -> int:\r\n        return self.conn.execute(\"SELECT COUNT(*) FROM products\").fetchone()[0]\r\n\r\n\r\ndef now() -> str:\r\n    return datetime.now(timezone.utc).strftime(\"%Y-%m-%dT%H:%M:%SZ\")\r\n"]
[18.198516, "o", "\u001b[?2004hroot@2039bef042cf:/app# "]
[32.66883, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_preserves_opaque_cursors_and_continues_empty_pages():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = [None, \"opaque +/=?&token\", \"\", \"0\"]\n    responses = iter([\n        {\"items\": [], \"next_cursor\": cursors[1]},\n        {\"items\": [item(\"A\")], \"next_cursor\": cursors[2]},\n        {\"items\": [], \"next_cursor\": cursors[3]},\n        {\"items\": [item(\"B\")], \"next_cursor\": None},\n    ])\n    requested = []\n\n    def fetch(url):\n        parsed = urlparse(url)\n        assert parsed.path == \"/v2/products\"\n        query = parse_qs(parsed.query, keep_blank_values=True)\n        assert \"page\" not in query\n        assert int(query[\"limit\"][0]) > 0\n        requested.append(query.get(\"cursor\", [None])[0])\n        return next(responses)\n\n    client = VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO())\n    assert [record[\"sku\"] for record in client.iter_items()] == [\"A\", \"B\"]\n    assert requested == cursors\n\n\ndef test_client_does_not_hide_retired_paging_errors():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\n    with pytest.raises(VendorError, match=\"410\"):\n        list(client.iter_items())\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
[32.669282, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[32.670829, "o", "from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('sync/client.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text()\r\n\u001b[?2004l\r\u001b[?2004h> start = s.index('        page = 1\\n')\r\n\u001b[?2004l\r\u001b[?2004h> s = s[:start] + '''        cursor = None\r\n\u001b[?2004l\r\u001b[?2004h>         while True:\r\n\u001b[?2004l\r\u001b[?2004h>             params = {\"limit\": 100}\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is not None:\r\n\u001b[?2004l\r\u001b[?2004h>                 params[\"cursor\"] = cursor\r\n\u001b[?2004l\r\u001b[?2004h>             url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\r\n\u001b[?2004l\r\u001b[?2004h>             body = self.fetch_json(url)\r\n\u001b[?2004l\r\u001b[?2004h>             self._note(body)\r\n\u001b[?2004l\r\u001b[?2004h>             yield from body.get(\"items\") or []\r\n\u001b[?2004l\r\u001b[?2004h>             cursor = body[\"next_cursor\"]\r\n\u001b[?2004l\r\u001b[?2004h>             if cursor is None:\r\n\u001b[?2004l\r\u001b[?2004h>                 return\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('tests/test_sync.py')\r\n\u001b[?2004l\r\u001b[?2004h> "]
