[62.042277, "i", "python - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom sync.client import VendorClient, DEFAULT_BASE_URL\nfrom sync.cli import DEFAULT_DB\n\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nwith sqlite3.connect(os.environ.get('CATALOG_DB', DEFAULT_DB)) as db, sqlite3.connect('/tmp/catalog-before-cat218.db') as old:\n    current = {r[0]: r for r in db.execute('SELECT * FROM products')}\n    before = {r[0]: r for r in old.execute('SELECT * FROM products')}\n    manual_before = {k: v for k, v in before.items() if v[3] == 'manual'}\n    assert {k: v for k, v in current.items() if v[3] == 'manual'} == manual_before\n    for record in records:\n        sku = record['sku']\n        if sku in manual_before:\n            continue\n        if record.get('deleted'):\n            assert sku not in current, sku\n        else:\n            row = current[sku]\n            assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\n            if record.get('updated_at'):\n                assert row[4] == record['updated_at'], sku\n    seen = {r['sku'] for r in records}\n    for sku in before.keys() - seen:\n        assert current[sku] == before[sku], sku\n    assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print(f'Verified {len(records)} feed records; all {len(manual_before)} manual SKUs and all unmentioned local records preserved.')\n    print('Database integrity: ok')\n    print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\nPY\npython -m sync.cli report\npython -m pytest -q\ngit --no-pager diff --check; git --no-pager diff; git status --short\n"]
[62.042698, "o", "python - <<'PY'\r\n\u001b[?2004l\r"]
[62.043187, "o", "\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from sync.client import VendorClient, DEFAULT_BASE_URL\r\n\u001b[?2004l\r\u001b[?2004h> from sync.cli import DEFAULT_DB\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> records = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r"]
[62.043528, "o", "\u001b[?2004h> "]
[62.045161, "o", "with sqlite3.connect(os.environ.get('CATALOG_DB', DEFAULT_DB)) as db, sqlite3.connect('/tmp/catalog-before-cat218.db') as old:\r\n\u001b[?2004l\r\u001b[?2004h>     current = {r[0]: r for r in db.execute('SELECT * FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h>     before = {r[0]: r for r in old.execute('SELECT * FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h>     manual_before = {k: v for k, v in before.items() if v[3] == 'manual'}\r\n\u001b[?2004l\r\u001b[?2004h>     assert {k: v for k, v in current.items() if v[3] == 'manual'} == manual_before\r\n\u001b[?2004l\r\u001b[?2004h>     for record in records:\r\n\u001b[?2004l\r\u001b[?2004h>         sku = record['sku']\r\n\u001b[?2004l\r\u001b[?2004h>         if sku in manual_before:\r\n\u001b[?2004l\r\u001b[?2004h>             continue\r\n\u001b[?2004l\r\u001b[?2004h>         if record.get('deleted'):\r\n\u001b[?2004l\r\u001b[?2004h>             assert sku not in current, sku\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             row = current[sku]\r\n\u001b[?2004l\r\u001b[?2004h>             assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), sku\r\n\u001b[?2004l\r\u001b[?2004h>             if record.get('updated_at'):\r\n\u001b[?2004l\r\u001b[?2004h>                 assert row[4] == record['updated_at'], sku\r\n\u001b[?2004l\r\u001b[?2004h>     seen = {r['sku'] for r in records}\r\n\u001b[?2004l\r\u001b[?2004h>     for sku in before.keys() - seen:\r\n\u001b[?2004l\r\u001b[?2004h>         assert current[sku] == before[sku], sku\r\n\u001b[?2004l\r\u001b[?2004h>     assert db.execute('PRAGMA integrity_check').fetchone() == ('ok',)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Verified {len(records)} feed records; all {len(manual_before)} manual SKUs and all unmentioned local records preserved.')\r\n\u001b[?2004l\r\u001b[?2004h>     print('Database integrity: ok')\r\n\u001b[?2004l\r\u001b[?2004h>     print('Sync state:', db.execute('SELECT * FROM sync_state').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
