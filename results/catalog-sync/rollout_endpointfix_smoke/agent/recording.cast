[32.674241, "o", "\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     cursors = [None, \"opaque +/=?&token\", \"\", \"0\"]\r\n\u001b[?2004l\r\u001b[?2004h>     responses = iter([\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [], \"next_cursor\": cursors[1]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"A\")], \"next_cursor\": cursors[2]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [], \"next_cursor\": cursors[3]},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"B\")], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     ])\r\n\u001b[?2004l\r\u001b[?2004h>     requested = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         parsed = urlparse(url)\r\n\u001b[?2004l\r\u001b[?2004h>         assert parsed.path == \"/v2/products\"\r\n\u001b[?2004l\r\u001b[?2004h>         query = parse_qs(parsed.query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         assert \"page\" not in query\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(query[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         requested.append(query.get(\"cursor\", [None])[0])\r\n\u001b[?2004l\r\u001b[?2004h>         return next(responses)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [record[\"sku\"] for record in client.iter_items()] == [\"A\", \"B\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert requested == cursors\r\n\u001b[?2004l\r\u001b[?2004h"]
[32.674585, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h"]
[32.674738, "o", "> "]
