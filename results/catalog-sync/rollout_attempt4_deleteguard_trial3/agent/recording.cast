[105.646704, "i", "python - <<'PY'\nimport json\nimport os\nimport sqlite3\nfrom pathlib import Path\n\nreview = json.loads((Path(os.environ['CAT218_REVIEW_DIR']) / 'review.json').read_text())\nbefore = {row[0]: tuple(row) for row in review['before']}\nrecords = {row['sku']: row for row in review['records']}\nwith sqlite3.connect('data/catalog.db') as conn:\n    after = {row[0]: row for row in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\n    for sku, record in records.items():\n        if sku in before and before[sku][3] == 'manual':\n            assert after[sku] == before[sku], sku\n        elif record.get('deleted'):\n            assert sku not in after, sku\n        else:\n            assert after[sku] == (sku, record['name'], record['price_paise'], 'vendor', record['updated_at']), sku\n    for sku, row in before.items():\n        if row[3] == 'manual' or sku not in records:\n            assert after[sku] == row, sku\n    assert set(before) - set(after) == set(review['doomed'])\n    assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print('Verified all feed records, exact tombstone deletions, and preservation of manual/unmentioned rows.')\n    print('Last sync:', conn.execute(\"SELECT value FROM sync_state WHERE key='last_sync_at'\").fetchone()[0])\nPY\n"]
[105.647236, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> "]
[105.649553, "o", "import json\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> review = json.loads((Path(os.environ['CAT218_REVIEW_DIR']) / 'review.json').read_text())\r\n\u001b[?2004l\r\u001b[?2004h> before = {row[0]: tuple(row) for row in review['before']}\r\n\u001b[?2004l\r\u001b[?2004h> records = {row['sku']: row for row in review['records']}\r\n\u001b[?2004l\r\u001b[?2004h> with sqlite3.connect('data/catalog.db') as conn:\r\n\u001b[?2004l\r\u001b[?2004h>     after = {row[0]: row for row in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h>     for sku, record in records.items():\r\n\u001b[?2004l\r\u001b[?2004h>         if sku in before and before[sku][3] == 'manual':\r\n\u001b[?2004l\r\u001b[?2004h>             assert after[sku] == before[sku], sku\r\n\u001b[?2004l\r\u001b[?2004h>         elif record.get('deleted'):\r\n\u001b[?2004l\r\u001b[?2004h>             assert sku not in after, sku\r\n\u001b[?2004l\r\u001b[?2004h>         else:\r\n\u001b[?2004l\r\u001b[?2004h>             assert after[sku] == (sku, record['name'], record['price_paise'], 'vendor', record['updated_at']), sku\r\n\u001b[?2004l\r\u001b[?2004h>     for sku, row in before.items():\r\n\u001b[?2004l\r\u001b[?2004h>         if row[3] == 'manual' or sku not in records:\r\n\u001b[?2004l\r\u001b[?2004h>             assert after[sku] == row, sku\r\n\u001b[?2004l\r\u001b[?2004h>     assert set(before) - set(after) == set(review['doomed'])\r\n\u001b[?2004l\r\u001b[?2004h>     assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\r\n\u001b[?2004l\r\u001b[?2004h>     print('Verified all feed records, exact tombstone deletions, and preservation of manual/unmentioned rows.')\r\n\u001b[?2004l\r\u001b[?2004h>     print('Last sync:', conn.execute(\"SELECT value FROM sync_state WHERE key='last_sync_at'\").fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
