[42.326537, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n')\ns = s.replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns = s.replace('parse_qs(urlparse(url).query)', 'parse_qs(urlparse(url).query, keep_blank_values=True)')\ns += '''\n\ndef test_client_follows_opaque_cursors_across_empty_pages():\n    fetch = pages(\n        {\"_cursor\": None, \"items\": [], \"next_cursor\": \"a+/=? &\"},\n        {\"_cursor\": \"a+/=? &\", \"items\": [item(\"A\")], \"next_cursor\": \"\"},\n        {\"_cursor\": \"\", \"items\": [item(\"B\")], \"next_cursor\": None},\n    )\n    got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"A\", \"B\"]\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    calls = []\n\n    def fetch(url):\n        calls.append(url)\n        if len(calls) == 1:\n            return {\"items\": [item(\"A\")], \"next_cursor\": \"next\"}\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert len(calls) == 2\n'''\np.write_text(s)\nPY\n"]
