[95.135554, "o", "\u001b[1mdiff --git a/sync/client.py b/sync/client.py\u001b[m\r\n\u001b[1mindex dfbe783..0c63858 100644\u001b[m\r\n\u001b[1m--- a/sync/client.py\u001b[m\r\n\u001b[1m+++ b/sync/client.py\u001b[m\r\n\u001b[36m@@ -48,19 +48,15 @@\u001b[m \u001b[mclass VendorClient:\u001b[m\r\n \u001b[m\r\n     def iter_items(self) -> Iterator[dict]:\u001b[m\r\n"]
[95.135997, "o", "         \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\u001b[m\r\n\u001b[31m-        page = 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = None\u001b[m\r\n         while True:\u001b[m\r\n\u001b[31m-            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\u001b[m\r\n\u001b[31m-            try:\u001b[m\r\n\u001b[31m-                body = self.fetch_json(url)\u001b[m\r\n\u001b[31m-            except VendorError as exc:\u001b[m\r\n\u001b[31m-                if \" 410:\" in str(exc):\u001b[m\r\n\u001b[31m-                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\u001b[m\r\n\u001b[31m-                    return\u001b[m\r\n\u001b[31m-                raise\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            params = {\"limit\": 100}\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                params[\"cursor\"] = cursor\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            body = self.fetch_json(url)\u001b[m\r\n             self._note(body)\u001b[m\r\n\u001b[31m-            items = body.get(\"items\") or []\u001b[m\r\n\u001b[31m-            if not items:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            yield from body.get(\"items\") or []\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            cursor = body[\"next_cursor\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is None:\u001b[m\r\n                 return\u001b[m\r\n\u001b[31m-            yield from items\u001b[m\r\n\u001b[31m-            page += 1\u001b[m\r\n"]
[95.13622, "o", "\u001b[1mdiff --git a/tests/test_sync.py b/tests/test_sync.py\u001b[m\r\n\u001b[1mindex fd4a462..753747a 100644\u001b[m\r\n\u001b[1m--- a/tests/test_sync.py\u001b[m\r\n\u001b[1m+++ b/tests/test_sync.py\u001b[m\r\n"]
[95.136945, "o", "\u001b[36m@@ -1,7 +1,9 @@\u001b[m\r\n import io\u001b[m\r\n import sqlite3\u001b[m\r\n \u001b[m\r\n\u001b[31m-from sync.client import VendorClient\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport pytest\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom sync.client import VendorClient, VendorError\u001b[m\r\n from sync.export import export_csv, summarize\u001b[m\r\n from sync.merge import merge\u001b[m\r\n from sync.store import CatalogStore\u001b[m\r\n\u001b[36m@@ -13,7 +15,7 @@\u001b[m \u001b[mdef pages(*bodies):\u001b[m\r\n \u001b[m\r\n     def fetch(url):\u001b[m\r\n         from urllib.parse import parse_qs, urlparse\u001b[m\r\n\u001b[31m-        q = parse_qs(urlparse(url).query)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        q = parse_qs(urlparse(url).query, keep_blank_values=True)\u001b[m\r\n         if \"page\" in q:\u001b[m\r\n             raise AssertionError(\"v2 feed is cursor-paginated; page= is retired\")\u001b[m\r\n         return by_cursor[q.get(\"cursor\", [None])[0]]\u001b[m\r\n\u001b[36m@@ -65,3 +67,27 @@\u001b[m \u001b[mdef test_export_and_summary():\u001b[m\r\n     lines = export_csv(s).splitlines()\u001b[m\r\n     assert lines[0] == \"sku,name,price_inr,source,updated_at\"\u001b[m\r\n     assert lines[1].startswith(\"A,A,1.00,manual\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_client_follows_opaque_cursors_across_empty_pages():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    fetch = pages(\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"_cursor\": None, \"items\": [], \"next_cursor\": \"a+/=? &\"},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"_cursor\": \"a+/=? &\", \"items\": [item(\"A\")], \"next_cursor\": \"\"},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"_cursor\": \"\", \"items\": [item(\"B\")], \"next_cursor\": None},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    )\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert [i[\"sku\"] for i in got] == [\"A\", \"B\"]\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_client_does_not_treat_http_410_as_end_of_feed():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    calls = []\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    def fetch(url):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        calls.append(url)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if len(calls) == 1:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            return {\"items\": [item(\"A\")], \"next_cursor\": \"next\"}\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise VendorError(f\"GET {url} -> 410: gone\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    with pytest.raises(VendorError, match=\"410\"):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert len(calls) == 2\u001b[m\r\n"]
