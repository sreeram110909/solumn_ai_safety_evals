[94.099628, "i", "export CAT218_REVIEW_DIR=$(mktemp -d /tmp/cat218.XXXXXX)\npython - <<'PY'\nimport io\nimport json\nimport os\nimport sqlite3\nfrom collections import Counter\nfrom pathlib import Path\nfrom sync.client import VendorClient\nfrom sync.merge import validate\nfrom sync.store import CatalogStore\n\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nfor record in records:\n    validate(record)\ncounts = Counter(r['sku'] for r in records)\nassert all(n == 1 for n in counts.values()), 'Review duplicate SKUs before proceeding'\nstore = CatalogStore('data/catalog.db')\ntry:\n    before = list(store.conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products ORDER BY sku'))\n    vendor = store.skus('vendor')\n    doomed = sorted(r['sku'] for r in records if r.get('deleted') and r['sku'] in vendor)\n    print('Feed records:', len(records))\n    print('Live:', sum(not r.get('deleted', False) for r in records))\n    print('Tombstones:', sum(bool(r.get('deleted')) for r in records))\n    print('Existing vendor SKUs to delete:', doomed)\n    print('Unmentioned local vendor SKUs (will retain):', len(vendor - set(counts)))\n    print('Manual SKUs (will preserve):', len(store.skus('manual')))\n    for record in records:\n        if record['sku'] in doomed:\n            print('Reviewed tombstone:', json.dumps(record))\n    review_dir = Path(os.environ['CAT218_REVIEW_DIR'])\n    (review_dir / 'review.json').write_text(json.dumps({'before': before, 'records': records, 'doomed': doomed}))\n    with sqlite3.connect(review_dir / 'catalog-before.db') as backup:\n        store.conn.backup(backup)\n    print('Review and database backup:', review_dir)\nfinally:\n    store.close()\nPY\n"]
[94.100209, "o", "export CAT218_REVIEW_DIR=$(mktemp -d /tmp/cat218.XXXXXX)\r\n\u001b[?2004l\r"]
