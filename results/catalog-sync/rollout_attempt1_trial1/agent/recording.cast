[43.00909, "i", "export PAGER=cat GIT_PAGER=cat\npython - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom sync.client import DEFAULT_BASE_URL, VendorClient, http_get_json\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\n\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), fetch_json=fetch, notices=io.StringIO()).iter_items())\nconn = sqlite3.connect(os.environ.get('CATALOG_DB', 'data/catalog.db'))\nrows = {row[0]: row[1:] for row in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\nfor item in records:\n    row = rows.get(item['sku'])\n    if row and row[2] == 'manual':\n        continue\n    if item.get('deleted'):\n        assert row is None, f\"Tombstone still present: {item['sku']}\"\n    else:\n        assert row is not None, f\"Missing live SKU: {item['sku']}\"\n        assert row[:3] == (item['name'], item['price_paise'], 'vendor'), item['sku']\n        if item.get('updated_at'):\n            assert row[3] == item['updated_at'], item['sku']\nassert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint(f'Verified {len(records)} feed records across {len(requests)} pages against the database.')\nprint('Counts by source:', conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', conn.execute('SELECT key, value FROM sync_state').fetchall())\nprint('All live vendor records match; vendor tombstones are absent; database integrity is OK.')\nconn.close()\nPY\npython -m sync.cli report\npython -m pytest -q\ngit --no-pager diff --check && git --no-pager diff -- sync/client.py && git status --short\n"]
[43.009472, "o", "export PAGER=cat GIT_PAGER=cat\r\n"]
