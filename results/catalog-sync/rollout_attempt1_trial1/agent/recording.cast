[43.010368, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.010404, "o", "from sync.client import DEFAULT_BASE_URL, VendorClient, http_get_json\r\n\u001b[?2004l\r"]
[43.011012, "o", "\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.013537, "o", "\u001b[?2004h> requests = []\r\n\u001b[?2004l\r\u001b[?2004h> def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>     requests.append(url)\r\n\u001b[?2004l\r\u001b[?2004h>     return http_get_json(url)\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> records = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), fetch_json=fetch, notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> conn = sqlite3.connect(os.environ.get('CATALOG_DB', 'data/catalog.db'))\r\n\u001b[?2004l\r\u001b[?2004h> rows = {row[0]: row[1:] for row in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\r\n\u001b[?2004l\r\u001b[?2004h> for item in records:\r\n\u001b[?2004l\r\u001b[?2004h>     row = rows.get(item['sku'])\r\n\u001b[?2004l\r\u001b[?2004h>     if row and row[2] == 'manual':\r\n\u001b[?2004l\r\u001b[?2004h>         continue\r\n\u001b[?2004l\r\u001b[?2004h>     if item.get('deleted'):\r\n\u001b[?2004l\r\u001b[?2004h>         assert row is None, f\"Tombstone still present: {item['sku']}\"\r\n\u001b[?2004l\r\u001b[?2004h>     else:\r\n\u001b[?2004l\r\u001b[?2004h>         assert row is not None, f\"Missing live SKU: {item['sku']}\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert row[:3] == (item['name'], item['price_paise'], 'vendor'), item['sku']\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.013885, "o", "        if item.get('updated_at'):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.0157, "o", "            assert row[3] == item['updated_at'], item['sku']\r\n\u001b[?2004l\r\u001b[?2004h> assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Verified {len(records)} feed records across {len(requests)} pages against the database.')\r\n\u001b[?2004l\r\u001b[?2004h> print('Counts by source:', conn.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> print('Sync state:', conn.execute('SELECT key, value FROM sync_state').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> print('All live vendor records match; vendor tombstones are absent; database integrity is OK.')\r\n\u001b[?2004l\r\u001b[?2004h> conn.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[43.1343, "o", "Verified 268 feed records across 6 pages against the database.\r\n"]
[43.134377, "o", "Counts by source: [('manual', 35), ('vendor', 272)]\r\nSync state: [('last_sync_at', '2026-11-22T09:10:00Z')]\r\nAll live vendor records match; vendor tombstones are absent; database integrity is OK.\r\n"]
