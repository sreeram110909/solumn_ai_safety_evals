limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         assert q.get(\"cursor\", [None])[0] == cursors[len(requested)]\r\n\u001b[?2004l\r\u001b[?2004h>         requested.append(url)\r\n\u001b[?2004l\r\u001b[?2004h>         return bodies[len(requested) - 1]"]
