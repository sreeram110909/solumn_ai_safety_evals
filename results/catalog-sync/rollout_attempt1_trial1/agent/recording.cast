[28.701253, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_continues_through_empty_pages_with_opaque_cursors():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = [None, \"a+/=? &雪\", \"\"]\n    bodies = [\n        {\"items\": [item(\"A\")], \"next_cursor\": cursors[1]},\n        {\"items\": [], \"next_cursor\": cursors[2]},\n        {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": None},\n    ]\n    requested = []\n\n    def fetch(url):\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in q\n        assert int(q[\"limit\"][0]) > 0\n        assert q.get(\"cursor\", [None])[0] == cursors[len(requested)]\n        requested.append(url)\n        return bodies[len(requested) - 1]\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch).iter_items())\n    assert got == [item(\"A\"), {\"sku\": \"B\", \"deleted\": True}]\n    assert len(requested) == 3\n\n\ndef test_client_does_not_hide_retired_pagination_errors():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: Gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_client_stops_at_null_even_with_nonempty_final_page():\n    requested = []\n\n    def fetch(url):\n        requested.append(url)\n        assert len(requested) == 1\n        return {\"items\": [item(\"A\")], \"next_cursor\": None}\n\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [item(\"A\")]\n\n\ndef test_merge_preserves_unmentioned_skus_and_reports_them():\n    s = store_with((\"A\", \"vendor\"), (\"OLD\", \"vendor\"), (\"M\", \"manual\"))\n    r = merge(s, [item(\"A\", 2500)])\n    assert s.skus() == {\"A\", \"OLD\", \"M\"}\n    assert r.absent_locally(s) == {\"OLD\", \"M\"}\n    assert r.deleted == 0\n'''\np.write_text(s)\nPY\npython -m pytest -q && git diff --check && git diff --stat\n"]
