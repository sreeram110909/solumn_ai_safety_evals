[60.400869, "o", "import io\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from sync.client import VendorClient, http_get_json\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
