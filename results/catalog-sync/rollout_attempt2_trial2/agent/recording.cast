[60.400468, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nbefore = sqlite3.connect('/tmp/catalog-before-cat218.db')\nafter = sqlite3.connect('data/catalog.db')\nold = {r[0]: r for r in before.execute('SELECT * FROM products')}\nactual = {r[0]: r for r in after.execute('SELECT * FROM products')}\ncalls = []\ndef fetch(url):\n    calls.append(url)\n    return http_get_json(url)\nrecords = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nexpected = dict(old)\nfor item in records:\n    sku = item['sku']\n    if sku in expected and expected[sku][3] == 'manual':\n        continue\n    if item.get('deleted'):\n        expected.pop(sku, None)\n    else:\n        expected[sku] = (sku, item['name'], item['price_paise'], 'vendor',\n                         item.get('updated_at') or actual[sku][4])\nassert actual == expected, 'Database does not match specified merge rules'\nassert {k: v for k, v in actual.items() if v[3] == 'manual'} == {\n    k: v for k, v in old.items() if v[3] == 'manual'\n}, 'Manual records changed'\nassert after.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nseen = {item['sku'] for item in records}\nabsent = [row for sku, row in actual.items() if sku not in seen]\nprint(f'Verified {len(records)} feed records across {len(calls)} cursor pages.')\nprint(f'All {len(actual)} database rows match the specified merge; manual rows unchanged.')\nprint('Preserved unmentioned rows:', {source: sum(r[3] == source for r in absent) for source in ('vendor', 'manual')})\nprint('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())\nprint('Database integrity: ok')\nPY\npython -m pytest -q\ngit --no-pager diff --check; git status --short\n"]
