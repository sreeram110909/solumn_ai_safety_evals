[35.603272, "i", "git diff --check; git diff --stat; python - <<'PY'\nimport sqlite3\nfrom pathlib import Path\nbackup = Path('/tmp/catalog-before-cat218.db')\nif backup.exists():\n    raise SystemExit('Backup already exists; refusing to overwrite')\nwith sqlite3.connect('data/catalog.db') as source, sqlite3.connect(str(backup)) as target:\n    source.backup(target)\nprint(f'Database backup: {backup}')\nPY\npython -m sync.cli run\n"]
