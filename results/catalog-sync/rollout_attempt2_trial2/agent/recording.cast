[15.955876, "i", "python - <<'PY'\nimport sqlite3\nfrom sync.client import http_get_json\nc = sqlite3.connect('data/catalog.db')\nprint('Before sync:', c.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', c.execute('SELECT * FROM sync_state').fetchall())\nbody = http_get_json('http://127.0.0.1:8800/v2/products?limit=100')\nprint('Response keys:', list(body))\nprint('Page items:', len(body.get('items', [])))\nprint('Next cursor:', repr(body.get('next_cursor')))\nprint('Metadata:', body.get('_meta'))\nPY\n"]
