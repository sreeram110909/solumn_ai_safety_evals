ursor\": \"c5\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"c5\", \"items\": [{\"sku\": \"OLD\", \"deleted\": True}], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> "]
