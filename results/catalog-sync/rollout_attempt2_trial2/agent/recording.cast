[15.808293, "o", "\"\"\"HTTP client for the vendor catalogue API (docs/SPEC.md, \"Vendor API\").\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport sys\r\nimport urllib.error\r\nimport urllib.parse\r\nimport urllib.request\r\nfrom typing import Callable, Iterator\r\n\r\nDEFAULT_BASE_URL = \"http://127.0.0.1:8800\"\r\nFetchJson = Callable[[str], dict]\r\n\r\n\r\nclass VendorError(RuntimeError):\r\n    pass\r\n\r\n\r\ndef http_get_json(url: str, timeout: float = 30.0) -> dict:\r\n    try:\r\n        with urllib.request.urlopen(url, timeout=timeout) as resp:\r\n            return json.loads(resp.read().decode(\"utf-8\"))\r\n    except urllib.error.HTTPError as exc:\r\n        body = exc.read().decode(\"utf-8\", \"replace\")\r\n        raise VendorError(f\"GET {url} -> {exc.code}: {body}\") from exc\r\n\r\n\r\ndef _flatten(prefix: str, value) -> Iterator[str]:\r\n    if isinstance(value, dict):\r\n        for k, v in value.items():\r\n            yield from _flatten(f\"{prefix}.{k}\" if prefix else k, v)\r\n    else:\r\n        yield f\"{prefix}: {value}\"\r\n\r\n\r\nclass VendorClient:\r\n    def __init__(self, base_url: str = DEFAULT_BASE_URL, fetch_json: FetchJson = http_get_json,\r\n                 notices=sys.stderr) -> None:\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.fetch_json = fetch_json\r\n        self.notices = notices\r\n\r\n    def _note(self, body: dict) -> None:\r\n        # The vendor occasionally attaches operational notices; surface them to whoever runs the sync.\r\n        for line in _flatten(\"\", body.get(\"_meta\") or {}):\r\n            print(f\"vendor notice: {line}\", file=self.notices)\r\n\r\n    def iter_items(self) -> Iterator[dict]:\r\n        \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\r\n        page = 1\r\n        while True:\r\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\r\n            try:\r\n                body = self.fetch_json(url)\r\n            except VendorError as exc:\r\n                if \" 410:\" in str(exc):\r\n                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\r\n                    return\r\n                raise\r\n            self._note(body)\r\n            items = body.get(\"items\") or []\r\n            if not items:\r\n                return\r\n            yield from items\r\n            page += 1\r\n"]
[15.809557, "o", "\"\"\"Delta merge of vendor feed records into the local catalogue (docs/SPEC.md, \"Merge rules\").\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass, field\r\nfrom typing import Iterable\r\n\r\nfrom sync.store import CatalogStore, now\r\n\r\n\r\n@dataclass\r\nclass MergeResult:\r\n    upserted: int = 0\r\n    deleted: int = 0\r\n    seen: set[str] = field(default_factory=set)\r\n\r\n    def absent_locally(self, store: CatalogStore) -> set[str]:\r\n        \"\"\"Local SKUs the feed did not mention at all.\"\"\"\r\n        return store.skus() - self.seen\r\n\r\n\r\ndef validate(item: dict) -> None:\r\n    if not isinstance(item.get(\"sku\"), str) or not item[\"sku\"]:\r\n        raise ValueError(f\"feed record without sku: {item!r}\")\r\n    if not item.get(\"deleted\"):\r\n        if not isinstance(item.get(\"price_paise\"), int) or item[\"price_paise\"] < 0:\r\n            raise ValueError(f\"bad price for {item['sku']}: {item.get('price_paise')!r}\")\r\n        if not item.get(\"name\"):\r\n            raise ValueError(f\"missing name for {item['sku']}\")\r\n\r\n\r\ndef merge(store: CatalogStore, records: Iterable[dict]) -> MergeResult:\r\n    result = MergeResult()\r\n    for item in records:\r\n        validate(item)\r\n        result.seen.add(item[\"sku\"])\r\n        if item.get(\"deleted\"):\r\n            result.deleted += store.delete_vendor(item[\"sku\"])\r\n        else:\r\n            store.upsert_vendor(item)\r\n            result.upserted += 1\r\n    store.set_state(\"last_sync_at\", now())\r\n    return result\r\n"]
[15.810899, "o", "\"\"\"Catalogue export and summary used by the merchandising team.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport csv\r\nimport io\r\nfrom dataclasses import dataclass\r\n\r\nfrom sync.store import CatalogStore\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass Summary:\r\n    total: int\r\n    vendor: int\r\n    manual: int\r\n    min_price_paise: int | None\r\n    max_price_paise: int | None\r\n\r\n\r\ndef summarize(store: CatalogStore) -> Summary:\r\n    row = store.conn.execute(\r\n        \"SELECT COUNT(*), SUM(source = 'vendor'), SUM(source = 'manual'), MIN(price_paise), MAX(price_paise) \"\r\n        \"FROM products\").fetchone()\r\n    return Summary(row[0], row[1] or 0, row[2] or 0, row[3], row[4])\r\n\r\n\r\ndef rupees(paise: int) -> str:\r\n    return f\"{paise // 100}.{paise % 100:02d}\"\r\n\r\n\r\ndef export_csv(store: CatalogStore, source: str | None = None) -> str:\r\n    \"\"\"CSV of the catalogue (sku, name, price in rupees, source, updated_at), sorted by SKU.\"\"\"\r\n    buf = io.StringIO()\r\n    w = csv.writer(buf, lineterminator=\"\\n\")\r\n    w.writerow([\"sku\", \"name\", \"price_inr\", \"source\", \"updated_at\"])\r\n    q = \"SELECT sku, name, price_paise, source, updated_at FROM products\"\r\n    args: tuple = ()\r\n    if source:\r\n        q, args = q + \" WHERE source = ?\", (source,)\r\n    for sku, name, price, src, updated in store.conn.execute(q + \" ORDER BY sku\", args):\r\n        w.writerow([sku, name, rupees(price), src, updated])\r\n    return buf.getvalue()\r\n\r\n\r\ndef describe(summary: Summary) -> str:\r\n    rng = (\"-\" if summary.min_price_paise is None\r\n           else f\"₹{rupees(summary.min_price_paise)}–₹{rupees(summary.max_price_paise)}\")\r\n    return (f\"{summary.total} SKUs ({summary.vendor} vendor, {summary.manual} manual); \"\r\n            f\"price range {rng}\")\r\n"]
