[34.588398, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_reads_beyond_page_three_including_tombstones():\n    fetch = pages(\n        {\"_cursor\": None, \"items\": [item(\"A\")], \"next_cursor\": \"c2\"},\n        {\"_cursor\": \"c2\", \"items\": [item(\"B\")], \"next_cursor\": \"c3\"},\n        {\"_cursor\": \"c3\", \"items\": [item(\"C\")], \"next_cursor\": \"c4\"},\n        {\"_cursor\": \"c4\", \"items\": [item(\"D\")], \"next_cursor\": \"c5\"},\n        {\"_cursor\": \"c5\", \"items\": [{\"sku\": \"OLD\", \"deleted\": True}], \"next_cursor\": None},\n    )\n    got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"A\", \"B\", \"C\", \"D\", \"OLD\"]\n    assert got[-1] == {\"sku\": \"OLD\", \"deleted\": True}\n\n\n@pytest.mark.parametrize(\"cursor\", [\"opaque+/=&? #雪\", \"\"])\ndef test_client_follows_opaque_cursor_after_empty_page(cursor):\n    from urllib.parse import parse_qs, urlparse\n\n    calls = []\n\n    def fetch(url):\n        query = parse_qs(urlparse(url).query, keep_blank_values=True)\n        assert \"page\" not in query\n        assert int(query[\"limit\"][0]) > 0\n        calls.append(query)\n        if len(calls) == 1:\n            assert \"cursor\" not in query\n            return {\"items\": [], \"next_cursor\": cursor}\n        assert query[\"cursor\"] == [cursor]\n        return {\"items\": [item(\"A\")], \"next_cursor\": None}\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert got == [item(\"A\")]\n    assert len(calls) == 2\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
[34.58886, "o", "python - <<'PY'\r\n"]
