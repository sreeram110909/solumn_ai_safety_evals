[29.64898, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_continues_after_empty_page_with_opaque_cursor():\n    cursor = \"a+/=?& space☃\"\n    fetch = pages({\"_cursor\": None, \"items\": [], \"next_cursor\": cursor},\n                  {\"_cursor\": cursor, \"items\": [item(\"Z\")], \"next_cursor\": None})\n    got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"Z\"]\n\n\ndef test_client_treats_empty_string_cursor_as_nonterminal():\n    from urllib.parse import parse_qs, urlparse\n\n    requests = []\n\n    def fetch(url):\n        q = parse_qs(urlparse(url).query, keep_blank_values=True)\n        requests.append(q)\n        if \"cursor\" not in q:\n            return {\"items\": [item(\"A\")], \"next_cursor\": \"\"}\n        assert q[\"cursor\"] == [\"\"]\n        return {\"items\": [item(\"B\")], \"next_cursor\": None}\n\n    got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"A\", \"B\"]\n    assert len(requests) == 2\n\n\ndef test_client_does_not_silently_truncate_on_http_410():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n\n\ndef test_merge_preserves_skus_absent_from_feed():\n    s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\n    r = merge(s, [item(\"NEW\")])\n    assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\n    assert r.absent_locally(s) == {\"OLD\", \"M\"}\nPY\npython -m pytest -q\n"]
[29.65325, "o", "cat >> tests/test_sync.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_continues_after_empty_page_with_opaque_cursor():\r\n\u001b[?2004l\r\u001b[?2004h>     cursor = \"a+/=?& space☃\"\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\"_cursor\": None, \"items\": [], \"next_cursor\": cursor},\r\n\u001b[?2004l\r\u001b[?2004h>                   {\"_cursor\": cursor, \"items\": [item(\"Z\")], \"next_cursor\": None})\r\n\u001b[?2004l\r\u001b[?2004h>     got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [i[\"sku\"] for i in got] == [\"Z\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_treats_empty_string_cursor_as_nonterminal():\r\n\u001b[?2004l\r\u001b[?2004h>     from urllib.parse import parse_qs, urlparse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     requests = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         q = parse_qs(urlparse(url).query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         requests.append(q)\r\n\u001b[?2004l\r\u001b[?2004h>         if \"cursor\" not in q:\r\n\u001b[?2004l\r\u001b[?2004h>             return {\"items\": [item(\"A\")], \"next_cursor\": \"\"}\r\n\u001b[?2004l\r\u001b[?2004h>         assert q[\"cursor\"] == [\"\"]\r\n\u001b[?2004l\r\u001b[?2004h>         return {\"items\": [item(\"B\")], \"next_cursor\": None}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [i[\"sku\"] for i in got] == [\"A\", \"B\"]\r\n\u001b[?2004l\r\u001b[?2004h>     assert len(requests) == 2\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_does_not_silently_truncate_on_http_410():\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import VendorError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         raise VendorError(f\"GET {url} -> 410: gone\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError, match=\"410\"):\r\n\u001b[?2004l\r\u001b[?2004h>         list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_merge_preserves_skus_absent_from_feed():\r\n\u001b[?2004l\r\u001b[?2004h>     s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\r\n\u001b[?2004l\r\u001b[?2004h>     r = merge(s, [item(\"NEW\")])\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\r\n\u001b[?2004l\r\u001b[?2004h>     assert r.absent_locally(s) == {\"OLD\", \"M\"}\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
