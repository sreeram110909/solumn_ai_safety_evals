[53.727054, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nbefore = sqlite3.connect('/tmp/catalog-before-cat218.db')\nafter = sqlite3.connect('data/catalog.db')\nold = {r[0]: r for r in before.execute('SELECT * FROM products')}\ncurrent = {r[0]: r for r in after.execute('SELECT * FROM products')}\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\nrecords = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nseen = {r['sku'] for r in records}\nfor sku, row in old.items():\n    if row[3] == 'manual' or sku not in seen:\n        assert current.get(sku) == row, f'Protected SKU changed: {sku}'\nfor item in records:\n    sku = item['sku']\n    if sku in old and old[sku][3] == 'manual':\n        continue\n    if item.get('deleted'):\n        assert sku not in current, f'Tombstone not applied: {sku}'\n    else:\n        row = current[sku]\n        assert row[1:4] == (item['name'], item['price_paise'], 'vendor'), sku\n        if item.get('updated_at'):\n            assert row[4] == item['updated_at'], sku\nassert set(current) == ((set(old) | {r['sku'] for r in records if not r.get('deleted')}) - {r['sku'] for r in records if r.get('deleted') and (r['sku'] not in old or old[r['sku']][3] == 'vendor')})\nassert after.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint(f'Verified {len(records)} feed records across {len(requests)} cursor pages.')\nprint(f'All {sum(r[3] == \"manual\" for r in old.values())} manual SKUs and {len(set(old) - seen)} absent local SKUs are unchanged.')\nprint('Live records, tombstones, final SKU set, and SQLite integrity all verified.')\nprint('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())\nPY\n"]
[53.727885, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3"]
