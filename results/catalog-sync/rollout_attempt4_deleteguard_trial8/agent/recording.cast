[9.458998, "o", "\r\n"]
[9.459265, "o", "=========================================================================== FAILURES ===========================================================================\r\n\u001b[31m\u001b[1m____________________________________________________________ test_client_follows_cursor_to_the_end _____________________________________________________________\u001b[0m\r\n\r\n"]
[9.459454, "o", "    def test_client_follows_cursor_to_the_end():\r\n        fetch = pages({\"_cursor\": None, \"items\": [item(\"A\"), item(\"B\")], \"next_cursor\": \"c2\"},\r\n                      {\"_cursor\": \"c2\", \"items\": [item(\"C\")], \"next_cursor\": \"c3\"},\r\n                      {\"_cursor\": \"c3\", \"items\": [item(\"D\")], \"next_cursor\": None})\r\n>       got = [i[\"sku\"] for i in VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items()]\r\n\r\n"]
