[54.581594, "i", "python -m sync.cli run --confirm-deletes 8\npython - <<'PY'\nimport io\nimport os\nimport sqlite3\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\n\nbefore = sqlite3.connect('/tmp/catalog-before-cat218.db')\nafter = sqlite3.connect('data/catalog.db')\nold = {r[0]: r[1:] for r in before.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\nnew = {r[0]: r[1:] for r in after.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nseen = {r['sku'] for r in records}\nfor record in records:\n    sku = record['sku']\n    if sku in old and old[sku][2] == 'manual':\n        assert new[sku] == old[sku]\n    elif record.get('deleted'):\n        assert sku not in new, sku\n    else:\n        assert new[sku] == (record['name'], record['price_paise'], 'vendor', record['updated_at']), sku\nfor sku, row in old.items():\n    if row[2] == 'manual' or sku not in seen:\n        assert new[sku] == row, sku\nassert after.execute('PRAGMA integrity_check').fetchone() == ('ok',)\nprint('Verified complete feed, tombstones, unchanged manual/unmentioned rows, and SQLite integrity.')\nprint('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())\nbefore.close()\nafter.close()\nPY\npython -m sync.cli report\npython -m pytest -q\nGIT_PAGER=cat git diff --check && git status --short\n"]
[54.582039, "o", "python -m sync.cli run --confirm-deletes 8\r\n\u001b[?2004l\r"]
