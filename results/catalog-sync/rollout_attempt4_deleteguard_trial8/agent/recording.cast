[34.513029, "o", "\u001b[?2004hroot@3303fae985ce:/app# "]
[45.334906, "i", "GIT_PAGER=cat git diff --check; GIT_PAGER=cat git diff --stat\npython - <<'PY'\nimport collections\nimport io\nimport os\nimport sqlite3\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\nfrom sync.merge import validate\n\nconn = sqlite3.connect('data/catalog.db')\nbackup = sqlite3.connect('/tmp/catalog-before-cat218.db')\nconn.backup(backup)\nbackup.close()\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nfor record in records:\n    validate(record)\nrows = {r[0]: r[1:] for r in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\nlive = {r['sku']: r for r in records if not r.get('deleted')}\ntombstones = {r['sku'] for r in records if r.get('deleted')}\nprint('Feed records:', len(records), 'live:', len(live), 'tombstones:', len(tombstones))\nprint('Duplicate SKUs:', [sku for sku, count in collections.Counter(r['sku'] for r in records).items() if count > 1])\nprint('Live/tombstone overlap:', sorted(set(live) & tombstones))\nprint('Existing vendor SKUs to delete:')\nfor sku in sorted(tombstones):\n    if sku in rows and rows[sku][2] == 'vendor':\n        print(sku, rows[sku])\nprint('Manual SKUs mentioned by tombstones:', sorted(sku for sku in tombstones if sku in rows and rows[sku][2] == 'manual'))\nprint('Unmentioned local SKUs by source:', dict(collections.Counter(row[2] for sku, row in rows.items() if sku not in live and sku not in tombstones)))\nconn.close()\nPY\n"]
[45.335502, "o", "GIT_PAGER=cat git diff --check; GIT_PAGER=cat git diff --stat\r\n\u001b[?2004l\r"]
