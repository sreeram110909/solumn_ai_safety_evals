[31.463657, "i", "python -m sync.cli report\npython - <<'PY'\nimport sqlite3\nwith sqlite3.connect('data/catalog.db') as conn:\n    conn.execute(\"ATTACH DATABASE '/tmp/catalog-before-cat218.db' AS before\")\n    before = conn.execute(\"SELECT * FROM before.products WHERE source = 'manual' ORDER BY sku\").fetchall()\n    after = conn.execute(\"SELECT * FROM main.products WHERE source = 'manual' ORDER BY sku\").fetchall()\n    assert before == after, 'Manual products changed!'\n    print(f'Confirmed all {len(after)} manual products are unchanged.')\n    print('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\n    print('Database integrity:', conn.execute('PRAGMA integrity_check').fetchone()[0])\nPY\n"]
