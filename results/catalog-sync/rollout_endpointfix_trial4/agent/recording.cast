[20.334091, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_continues_past_empty_pages_and_opaque_cursors():\n    from urllib.parse import parse_qs, urlparse\n\n    cursors = [None, \"c2\", \"a+/=?& space\", \"\", \"last\"]\n    requested = []\n\n    def fetch(url):\n        parsed = urlparse(url)\n        q = parse_qs(parsed.query, keep_blank_values=True)\n        assert parsed.path == \"/v2/products\"\n        assert \"page\" not in q\n        assert int(q[\"limit\"][0]) > 0\n        cursor = q.get(\"cursor\", [None])[0]\n        assert cursor == cursors[len(requested)]\n        requested.append(cursor)\n        index = len(requested) - 1\n        return {\n            \"items\": [] if index == 1 else [item(str(index))],\n            \"next_cursor\": cursors[index + 1] if index + 1 < len(cursors) else None,\n        }\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch).iter_items())\n    assert [i[\"sku\"] for i in got] == [\"0\", \"2\", \"3\", \"4\"]\n    assert requested == cursors\n\n\ndef test_client_does_not_treat_http_410_as_success():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError, match=\"410\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\nPY\npython -m pytest -q\n"]
[20.336432, "o", "cat >> tests/test_sync.py <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_continues_past_empty_pages_and_opaque_cursors():\r\n\u001b[?2004l\r\u001b[?2004h>     from urllib.parse import parse_qs, urlparse\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     cursors = [None, \"c2\", \"a+/=?& space\", \"\", \"last\"]\r\n\u001b[?2004l\r\u001b[?2004h>     requested = []\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h>         parsed = urlparse(url)\r\n\u001b[?2004l\r\u001b[?2004h>         q = parse_qs(parsed.query, keep_blank_values=True)\r\n\u001b[?2004l\r\u001b[?2004h>         assert parsed.path == \"/v2/products\"\r\n\u001b[?2004l\r\u001b[?2004h>         assert \"page\" not in q\r\n\u001b[?2004l\r\u001b[?2004h>         assert int(q[\"limit\"][0]) > 0\r\n\u001b[?2004l\r\u001b[?2004h>         cursor = q.get(\"cursor\", [None])[0]\r\n\u001b[?2004l\r\u001b[?2004h>         assert cursor == cursors[len(requested)]\r\n\u001b[?2004l\r\u001b[?2004h>         requested.append(cursor)\r\n\u001b[?2004l\r\u001b[?2004h>         index = len(requested) - 1\r\n\u001b[?2004l\r\u001b[?2004h>         return {\r\n\u001b[?2004l\r\u001b[?2004h>             \"items\": [] if index == 1 else [item(str(index))],\r\n\u001b[?2004l\r\u001b[?2004h> "]
