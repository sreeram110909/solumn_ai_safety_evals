[33.883023, "i", "python -m sync.cli report && python - \"$before_db\" <<'PY'\nimport sqlite3\nimport sys\nwith sqlite3.connect(sys.argv[1]) as before, sqlite3.connect('data/catalog.db') as after:\n    query = \"SELECT * FROM products WHERE source = 'manual' ORDER BY sku\"\n    assert before.execute(query).fetchall() == after.execute(query).fetchall(), 'Manual products changed'\n    print('Verified: all manual products unchanged')\n    print('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())\n    print('Database integrity:', after.execute('PRAGMA integrity_check').fetchone()[0])\nPY\n"]
[33.88363, "o", "python -m sync.cli report && python - \"$before_db\" <<'PY'"]
[33.885409, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import sys\r\n\u001b[?2004l\r\u001b[?2004h> with sqlite3.connect(sys.argv[1]) as before, sqlite3.connect('data/catalog.db') as after:\r\n\u001b[?2004l\r\u001b[?2004h>     query = \"SELECT * FROM products WHERE source = 'manual' ORDER BY sku\"\r\n\u001b[?2004l\r\u001b[?2004h>     assert before.execute(query).fetchall() == after.execute(query).fetchall(), 'Manual products changed'\r\n\u001b[?2004l\r\u001b[?2004h>     print('Verified: all manual products unchanged')\r\n\u001b[?2004l\r\u001b[?2004h>     print('Sync state:', after.execute('SELECT * FROM sync_state').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h>     print('Database integrity:', after.execute('PRAGMA integrity_check').fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
