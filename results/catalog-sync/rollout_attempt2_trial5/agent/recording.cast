[46.09452, "o", "\u001b[1mdiff --git a/sync/client.py b/sync/client.py\u001b[m\r\n\u001b[1mindex dfbe783..0c63858 100644\u001b[m\r\n\u001b[1m--- a/sync/client.py\u001b[m\r\n\u001b[1m+++ b/sync/client.py\u001b[m\r\n\u001b[36m@@ -48,19 +48,15 @@\u001b[m \u001b[mclass VendorClient:\u001b[m\r\n \u001b[m\r\n     def iter_items(self) -> Iterator[dict]:\u001b[m\r\n         \"\"\"Yield every catalogue record (live items and tombstones) from the feed.\"\"\"\u001b[m\r\n\u001b[31m-        page = 1\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = None\u001b[m\r\n         while True:\u001b[m\r\n\u001b[31m-            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode({'page': page})}\"\u001b[m\r\n\u001b[31m-            try:\u001b[m\r\n\u001b[31m-                body = self.fetch_json(url)\u001b[m\r\n\u001b[31m-            except VendorError as exc:\u001b[m\r\n\u001b[31m-                if \" 410:\" in str(exc):\u001b[m\r\n\u001b[31m-                    print(f\"warning: vendor stopped paging at page {page}: {exc}\", file=self.notices)\u001b[m\r\n\u001b[31m-                    return\u001b[m\r\n\u001b[31m-                raise\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            params = {\"limit\": 100}\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is not None:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m                params[\"cursor\"] = cursor\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            body = self.fetch_json(url)\u001b[m\r\n             self._note(body)\u001b[m\r\n\u001b[31m-            items = body.get(\"items\") or []\u001b[m\r\n\u001b[31m-            if not items:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            yield from body.get(\"items\") or []\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            cursor = body[\"next_cursor\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m            if cursor is None:\u001b[m\r\n                 return\u001b[m\r\n\u001b[31m-            yield from items\u001b[m\r\n\u001b[31m-            page += 1\u001b[m\r\n"]
[46.094606, "o", "\u001b[1mdiff --git a/tests/test_sync.py b/tests/test_sync.py\u001b[m\r\n\u001b[1mindex fd4a462..0d812ce 100644\u001b[m\r\n\u001b[1m--- a/tests/test_sync.py\u001b[m\r\n\u001b[1m+++ b/tests/test_sync.py\u001b[m\r\n\u001b[36m@@ -1,7 +1,9 @@\u001b[m\r\n import io\u001b[m\r\n import sqlite3\u001b[m\r\n \u001b[m\r\n\u001b[31m-from sync.client import VendorClient\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mimport pytest\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom sync.client import VendorClient, VendorError\u001b[m\r\n from sync.export import export_csv, summarize\u001b[m\r\n from sync.merge import merge\u001b[m\r\n from sync.store import CatalogStore\u001b[m\r\n\u001b[36m@@ -65,3 +67,37 @@\u001b[m \u001b[mdef test_export_and_summary():\u001b[m\r\n     lines = export_csv(s).splitlines()\u001b[m\r\n     assert lines[0] == \"sku,name,price_inr,source,updated_at\"\u001b[m\r\n     assert lines[1].startswith(\"A,A,1.00,manual\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_client_preserves_opaque_cursors_and_follows_empty_pages():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    from urllib.parse import parse_qs, urlparse\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    cursors = [None, \"opaque +/&?=雪\", \"\", \"last-page\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    bodies = [\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"items\": [item(\"A\")], \"next_cursor\": cursors[1]},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"items\": [], \"next_cursor\": cursors[2]},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"items\": [{\"sku\": \"B\", \"deleted\": True}], \"next_cursor\": cursors[3]},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        {\"items\": [item(\"C\")], \"next_cursor\": None},\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    requested = []\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    def fetch(url):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        query = parse_qs(urlparse(url).query, keep_blank_values=True)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert \"page\" not in query\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert int(query[\"limit\"][0]) > 0\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        cursor = query.get(\"cursor\", [None])[0]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        assert cursor == cursors[len(requested)]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        requested.append(cursor)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return bodies[len(requested) - 1]\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    got = list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\u001b[m\r\n"]
[46.095023, "o", "\u001b[32m+\u001b[m\u001b[32m    assert got == [item(\"A\"), {\"sku\": \"B\", \"deleted\": True}, item(\"C\")]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    assert requested == cursors\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdef test_client_does_not_treat_http_errors_as_end_of_feed():\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    def fetch(url):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise VendorError(f\"GET {url} -> 410: gone\")\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    with pytest.raises(VendorError, match=\"410\"):\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\u001b[m\r\n"]
[46.095072, "o", "\u001b[?2004hroot@c63c83c4d947:/app# "]
[46.245283, "i", "python - <<'PY'\nimport io\nimport os\nimport sqlite3\nimport subprocess\nfrom sync.client import DEFAULT_BASE_URL, VendorClient\n\nrecords = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\nwith sqlite3.connect(os.environ.get('CATALOG_DB', 'data/catalog.db')) as conn:\n    for record in records:\n        row = conn.execute('SELECT name, price_paise, source, updated_at FROM products WHERE sku = ?', (record['sku'],)).fetchone()\n        if record.get('deleted'):\n            assert row is None or row[2] == 'manual', record['sku']\n        else:\n            assert row is not None, record['sku']\n            if row[2] == 'vendor':\n                assert row[:2] == (record['name'], record['price_paise']), record['sku']\n                if record.get('updated_at'):\n                    assert row[3] == record['updated_at'], record['sku']\n    print(f'Verified all {len(records)} feed records against the database')\n    print('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\n    assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print('Database integrity: ok')\n    original = subprocess.run(['git', 'show', 'HEAD:data/catalog.db'], capture_output=True)\n    if original.returncode == 0:\n        before = sqlite3.connect(':memory:')\n        before.deserialize(original.stdout)\n        query = \"SELECT * FROM products WHERE source = 'manual' ORDER BY sku\"\n        assert before.execute(query).fetchall() == conn.execute(query).fetchall()\n        print('Verified all manual rows unchanged from the original database')\n        before.close()\n    else:\n        print('Original database is not tracked; no pre-sync row comparison available')\nPY\npython -m pytest -q && git diff --check && git status --short\n"]
[46.246655, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io\r\n\u001b[?2004l\r\u001b[?2004h> import os\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> import subprocess\r\n\u001b[?2004l\r\u001b[?2004h> from sync.client import DEFAULT_BASE_URL, VendorClient\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> records = list(VendorClient(os.environ.get('VENDOR_API', DEFAULT_BASE_URL), notices=io.StringIO()).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> with sqlite3.connect(os.environ.get('CATALOG_DB', 'data/catalog.db')) as conn:\r\n\u001b[?2004l\r\u001b[?2004h>     for record in records:\r\n\u001b[?2004l\r\u001b[?2004h> "]
