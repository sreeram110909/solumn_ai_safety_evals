[29.796382, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('sync/client.py')\ns = p.read_text()\nstart = s.index('        page = 1\\n')\ns = s[:start] + '''        cursor = None\n        while True:\n            params = {\"limit\": 100}\n            if cursor is not None:\n                params[\"cursor\"] = cursor\n            url = f\"{self.base_url}/v2/products?{urllib.parse.urlencode(params)}\"\n            body = self.fetch_json(url)\n            self._note(body)\n            yield from body.get(\"items\") or []\n            cursor = body[\"next_cursor\"]\n            if cursor is None:\n                return\n'''\np.write_text(s)\np = Path('tests/test_sync.py')\ns = p.read_text().replace('import sqlite3\\n', 'import sqlite3\\n\\nimport pytest\\n').replace('from sync.client import VendorClient', 'from sync.client import VendorClient, VendorError')\ns += '''\n\ndef test_client_continues_through_empty_pages_and_opaque_cursors():\n    from urllib.parse import parse_qs, urlparse\n\n    opaque = \"c/+?=& space\"\n    fetch_page = pages(\n        {\"_cursor\": None, \"items\": [item(\"A\")], \"next_cursor\": opaque},\n        {\"_cursor\": opaque, \"items\": [], \"next_cursor\": \"c3\"},\n        {\"_cursor\": \"c3\", \"items\": [item(\"B\")], \"next_cursor\": \"c4\"},\n        {\"_cursor\": \"c4\", \"items\": [item(\"C\")], \"next_cursor\": \"c5\"},\n        {\"_cursor\": \"c5\", \"items\": [{\"sku\": \"D\", \"deleted\": True}], \"next_cursor\": None},\n    )\n    urls = []\n\n    def fetch(url):\n        urls.append(url)\n        assert int(parse_qs(urlparse(url).query)[\"limit\"][0]) > 0\n        return fetch_page(url)\n\n    got = list(VendorClient(\"http://x/\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n    assert [record[\"sku\"] for record in got] == [\"A\", \"B\", \"C\", \"D\"]\n    assert got[-1][\"deleted\"] is True\n    assert len(urls) == 5\n    assert \"cursor\" not in parse_qs(urlparse(urls[0]).query)\n    assert parse_qs(urlparse(urls[1]).query)[\"cursor\"] == [opaque]\n\n\ndef test_client_does_not_treat_http_410_as_end_of_feed():\n    def fetch(url):\n        if \"cursor=\" in url:\n            raise VendorError(f\"GET {url} -> 410: expired cursor\")\n        return {\"items\": [item(\"A\")], \"next_cursor\": \"c2\"}\n\n    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\n    with pytest.raises(VendorError, match=\"410\"):\n        list(client.iter_items())\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
