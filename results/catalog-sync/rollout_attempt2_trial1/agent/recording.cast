[38.037103, "o", "\u001b[?2004hroot@cadf5d81368b:/app# "]
[50.031388, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\n\nrecords = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nconn = sqlite3.connect('data/catalog.db')\nrows = {r[0]: r for r in conn.execute('SELECT sku, name, price_paise, source, updated_at FROM products')}\nfor record in records:\n    row = rows.get(record['sku'])\n    if record.get('deleted'):\n        assert row is None or row[3] != 'vendor', record['sku']\n    elif row is not None and row[3] == 'manual':\n        continue\n    else:\n        assert row is not None, record['sku']\n        assert row[1:4] == (record['name'], record['price_paise'], 'vendor'), record['sku']\n        if record.get('updated_at'):\n            assert row[4] == record['updated_at'], record['sku']\nseen = {record['sku'] for record in records}\nabsent = [row for sku, row in rows.items() if sku not in seen]\nprint(f'Verified {len(records)} feed records across {len(requests)} pages against the database')\nprint('Catalogue by source:', conn.execute('SELECT source, count(*) FROM products GROUP BY source').fetchall())\nprint('Local SKUs absent from feed, retained by spec:', {source: sum(row[3] == source for row in absent) for source in ('manual', 'vendor')})\nprint('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\nprint('Database integrity:', conn.execute('PRAGMA integrity_check').fetchone()[0])\nPY\npython -m pytest -q\n"]
[50.031923, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import io"]
