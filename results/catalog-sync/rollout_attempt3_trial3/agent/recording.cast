VX-10001\", \"deleted\": true, \"updated_at\": \"2026-11-20T00:00:00Z\"}, {\"sku\": \"VX-10251\", \"name\": \"Notebook A5 #10251\", \"price_paise\": 25161, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10141\", \"name\": \"Cotton Tote #10141\", \"price_paise\": 45117, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10039\", \"name\": \"Wool Socks #10039\", \"price_paise\": 41343, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10005\", \"deleted\": true, \"updated_at\": \"2026-11-20T00:00:00Z\"}, {\"sku\": \"VX-10269\", \"name\": \"Spice Kit #10269\", \"price_paise\": 25179, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10010\", \"name\": \"Desk Lamp #10010 (v2)\", \"price_paise\": 40770, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10199\", \"name\": \"Travel Pouch #10199\", \"price_paise\": 47763, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10094\", \"name\": \"Desk Lamp #10094\", \"price_paise\": 43878, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10202\", \"name\": \"Desk Lamp #10202\", \"price_paise\": 47374, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10257\", \"name\": \"Spice Kit #10257\", \"price_paise\": 25167, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10220\", \"name\": \"Herbal Tea #10220\", \"price_paise\": 48540, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10237\", \"name\": \"Cotton Tote #10237\", \"price_paise\": 48669, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10015\", \"name\": \"Wool Socks #10015\", \"price_paise\": 40455, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10031\", \"name\": \"Travel Pouch #10031\", \"price_paise\": 41547, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10059\", \"name\": \"Notebook A5 #10059\", \"price_paise\": 42583, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10076\", \"name\": \"Herbal Tea #10076 (v2)\", \"price_paise\": 42712, \"updated_