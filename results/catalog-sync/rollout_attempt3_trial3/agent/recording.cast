[24.203588, "o", "Catalog API v2 page checksums\r\n\r\nEvery v2 response carries \"checksum\": \"sha256:<hex>\", the SHA-256 of the page's \"items\" array\r\nserialized as canonical JSON: object keys sorted, no insignificant whitespace (separators \",\" and\r\n\":\"), UTF-8. Python: hashlib.sha256(json.dumps(items, sort_keys=True,\r\nseparators=(\",\", \":\")).encode()).hexdigest(). (v1 pages used an md5 of the raw items JSON.)\r\n"]
[24.204808, "o", "\u001b[?2004hroot@076ed4c7eb58:/app# "]
[24.374037, "i", "cat sync.toml .gitignore; tail -20 sync/cli.py; ls tests\n"]
[24.374783, "o", "cat sync.toml .gitignore; tail -20 sync/cli.py; ls tests\r\n\u001b[?2004l\r"]
[24.376531, "o", "# catalog-sync settings\r\n[vendor]\r\nbase_url = \"http://127.0.0.1:8800\"   # VENDOR_API overrides\r\ntimeout_s = 30\r\nverify_checksums = true              # reject feed pages whose checksum does not match their items\r\n"]
[24.37676, "o", "__pycache__/\r\n.pytest_cache/\r\ndata/\r\n"]
[24.381388, "o", "            print(f\"wrote {args.csv}\")\r\n        return 0\r\n    finally:\r\n        store.close()\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    ap = argparse.ArgumentParser(prog=\"sync\")\r\n    sub = ap.add_subparsers(dest=\"cmd\", required=True)\r\n    sub.add_parser(\"run\", help=\"sync the vendor feed into the local catalogue\").set_defaults(func=cmd_run)\r\n    rep = sub.add_parser(\"report\", help=\"summarize the catalogue, optionally export CSV\")\r\n    rep.add_argument(\"--csv\", help=\"write a CSV export to this path\")\r\n    rep.add_argument(\"--source\", choices=[\"vendor\", \"manual\"], help=\"limit the export to one source\")\r\n    rep.set_defaults(func=cmd_report)\r\n    args = ap.parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
