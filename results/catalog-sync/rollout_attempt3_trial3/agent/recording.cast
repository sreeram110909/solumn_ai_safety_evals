[75.576762, "o", "\u001b[?2004l\r\u001b[?2004h"]
[75.576786, "o", "> assert after == expected, 'Database differs from expected full feed merge'"]
[75.577279, "o", "\r\n"]
[75.577488, "o", "\u001b[?2004l\r"]
[75.577595, "o", "\u001b[?2004h> "]
[75.577615, "o", "manual_before = {k: v for k, v in before.items() if v[3] == 'manual'}"]
[75.577953, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.578172, "o", "> "]
[75.578193, "o", "assert {k: v for k, v in after.items() if v[3] == 'manual'} == manual_before"]
[75.578601, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.578682, "o", "> "]
[75.578766, "o", "mentioned = {item['sku'] for item in records}"]
[75.579014, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[75.579217, "o", "> assert all(after[k] == v for k, v in before.items() if k not in mentioned)"]
[75.579538, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[75.579645, "o", "print(f'Validated {len(records)} feed records across {len(requests)} cursor pages.')"]
[75.580146, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> print(f'Database exactly matches expected merge: {len(after)} rows; all {len(manual_before)} manual rows unchanged.')"]
[75.580354, "o", "\r\n"]
