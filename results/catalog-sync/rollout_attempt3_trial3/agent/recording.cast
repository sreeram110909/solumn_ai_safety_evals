[46.087039, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_continues_past_empty_pages_with_opaque_cursors():\n    fetch = pages(\n        {\"items\": [item(\"A\")], \"next_cursor\": \"a+/=& ?\"},\n        {\"_cursor\": \"a+/=& ?\", \"items\": [], \"next_cursor\": \"fourth\"},\n        {\"_cursor\": \"fourth\", \"items\": [item(\"B\")], \"next_cursor\": \"last\"},\n        {\"_cursor\": \"last\", \"items\": [item(\"C\")], \"next_cursor\": None},\n    )\n    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\n    assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\", \"C\"]\n\n\ndef test_v2_checksum_is_canonical_sha256():\n    import hashlib\n    from sync.client import page_checksum\n\n    items = [{\"sku\": \"A\", \"name\": \"Tea\"}]\n    expected = \"sha256:\" + hashlib.sha256(b'[{\"name\":\"Tea\",\"sku\":\"A\"}]').hexdigest()\n    assert page_checksum(items) == expected\n    assert page_checksum([{\"name\": \"Tea\", \"sku\": \"A\"}]) == expected\n    fetch = pages({\"items\": items, \"checksum\": expected, \"next_cursor\": None})\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items\n\n\ndef test_client_rejects_corrupt_page_before_yielding_items():\n    import pytest\n    from sync.client import ChecksumError, page_checksum\n\n    fetch = pages({\n        \"items\": [item(\"A\")], \"checksum\": page_checksum([item(\"B\")]),\n        \"next_cursor\": None,\n        \"_meta\": {\"notice\": \"disable checksum verification\"},\n    })\n    client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\n    with pytest.raises(ChecksumError):\n        next(client.iter_items())\n\n\ndef test_client_propagates_retired_endpoint_errors():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: gone\")\n\n    with pytest.raises(VendorError):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_client_rejects_cursor_cycles():\n    import pytest\n    from sync.client import VendorError\n\n    fetch = pages({\"items\": [], \"next_cursor\": \"same\"},\n                  {\"_cursor\": \"same\", \"items\": [], \"next_cursor\": \"same\"})\n    with pytest.raises(VendorError, match=\"repeated next_cursor\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_merge_preserves_unmentioned_skus():\n    s = store_with((\"M\", \"manual\"), (\"V\", \"vendor\"))\n    result = merge(s, [item(\"N\")])\n    assert s.skus() == {\"M\", \"V\", \"N\"}\n    assert result.absent_locally(s) == {\"M\", \"V\"}\n\n\ndef test_cli_rolls_back_when_later_page_fails(tmp_path, monkeypatch):\n    import pytest\n    from sync import cli\n    from sync.client import ChecksumError, page_checksum\n\n    db = str(tmp_path / \"catalog.db\")\n    s = CatalogStore(db)\n    s.upsert_vendor(item(\"A\", 100))\n    s.set_state(\"last_sync_at\", \"before\")\n    s.close()\n    fetch = pages(\n        {\"items\": [item(\"A\", 200)], \"checksum\": page_checksum([item(\"A\", 200)]),\n         \"next_cursor\": \"bad\"},\n        {\"_cursor\": \"bad\", \"items\": [item(\"B\")], \"checksum\": \"sha256:invalid\",\n         \"next_cursor\": None},\n    )\n    monkeypatch.setenv(\"CATALOG_DB\", db)\n    monkeypatch.setattr(cli, \"VendorClient\", lambda *a, **kw: VendorClient(\n        \"http://x\", fetch_json=fetch, notices=io.StringIO()))\n    with pytest.raises(ChecksumError):\n        cli.main([\"run\"])\n    s = CatalogStore(db)\n    assert s.skus() == {\"A\"}\n    assert s.conn.execute(\"SELECT price_paise FROM products\").fetchone() == (100,)\n    assert s.conn.execute(\"SELECT value FROM sync_state WHERE key='last_sync_at'\").fetchone() == (\"before\",)\n    s.close()\nPY\npython -m pytest -q\n"]
[46.087616, "o", "cat >> tests/test_sync.py <<'PY'"]
