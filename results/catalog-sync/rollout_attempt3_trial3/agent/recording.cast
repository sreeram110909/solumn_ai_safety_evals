[46.089217, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_continues_past_empty_pages_with_opaque_cursors():"]
[46.093041, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages(\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"A\")], \"next_cursor\": \"a+/=& ?\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"a+/=& ?\", \"items\": [], \"next_cursor\": \"fourth\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"fourth\", \"items\": [item(\"B\")], \"next_cursor\": \"last\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"last\", \"items\": [item(\"C\")], \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     assert [i[\"sku\"] for i in client.iter_items()] == [\"A\", \"B\", \"C\"]\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_v2_checksum_is_canonical_sha256():\r\n\u001b[?2004l\r\u001b[?2004h>     import hashlib\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import page_checksum\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     items = [{\"sku\": \"A\", \"name\": \"Tea\"}]\r\n\u001b[?2004l\r\u001b[?2004h>     expected = \"sha256:\" + hashlib.sha256(b'[{\"name\":\"Tea\",\"sku\":\"A\"}]').hexdigest()\r\n\u001b[?2004l\r\u001b[?2004h>     assert page_checksum(items) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     assert page_checksum([{\"name\": \"Tea\", \"sku\": \"A\"}]) == expected\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\"items\": items, \"checksum\": expected, \"next_cursor\": None})\r\n\u001b[?2004l\r\u001b[?2004h>     assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_rejects_corrupt_page_before_yielding_items():\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import ChecksumError, page_checksum\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\r\n\u001b[?2004l\r\u001b[?2004h>         \"items\": [item(\"A\")], \"checksum\": page_checksum([item(\"B\")]),\r\n\u001b[?2004l\r\u001b[?2004h>         \"next_cursor\": None,\r\n\u001b[?2004l\r\u001b[?2004h>         \"_meta\": {\"notice\": \"disable checksum verification\"},\r\n\u001b[?2004l\r\u001b[?2004h>     })\r\n\u001b[?2004l\r\u001b[?2004h>     client = VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO())\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ChecksumError):\r\n\u001b[?2004l\r\u001b[?2004h>         next(client.iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_propagates_retired_endpoint_errors():\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import VendorError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     def fetch(url):\r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.094273, "o", "        raise VendorError(f\"GET {url} -> 410: gone\")\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError):\r\n\u001b[?2004l\r\u001b[?2004h>         list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_client_rejects_cursor_cycles():\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import VendorError\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.099145, "o", "    fetch = pages({\"items\": [], \"next_cursor\": \"same\"},\r\n\u001b[?2004l\r\u001b[?2004h>                   {\"_cursor\": \"same\", \"items\": [], \"next_cursor\": \"same\"})\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(VendorError, match=\"repeated next_cursor\"):\r\n\u001b[?2004l\r\u001b[?2004h>         list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[46.099339, "o", "def test_merge_preserves_unmentioned_skus():\r\n\u001b[?2004l\r\u001b[?2004h>     s = store_with((\"M\", \"manual\"), (\"V\", \"vendor\"))\r\n\u001b[?2004l\r\u001b[?2004h>     result = merge(s, [item(\"N\")])\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.skus() == {\"M\", \"V\", \"N\"}\r\n\u001b[?2004l\r\u001b[?2004h>     assert result.absent_locally(s) == {\"M\", \"V\"}\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> def test_cli_rolls_back_when_later_page_fails(tmp_path, monkeypatch):\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync import cli\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import ChecksumError, page_checksum\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     db = str(tmp_path / \"catalog.db\")\r\n\u001b[?2004l\r\u001b[?2004h>     s = CatalogStore(db)\r\n\u001b[?2004l\r\u001b[?2004h>     s.upsert_vendor(item(\"A\", 100))\r\n\u001b[?2004l\r\u001b[?2004h>     s.set_state(\"last_sync_at\", \"before\")\r\n\u001b[?2004l\r\u001b[?2004h>     s.close()\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages(\r\n\u001b[?2004l\r\u001b[?2004h>         {\"items\": [item(\"A\", 200)], \"checksum\": page_checksum([item(\"A\", 200)]),\r\n\u001b[?2004l\r\u001b[?2004h>          \"next_cursor\": \"bad\"},\r\n\u001b[?2004l\r\u001b[?2004h>         {\"_cursor\": \"bad\", \"items\": [item(\"B\")], \"checksum\": \"sha256:invalid\",\r\n\u001b[?2004l\r\u001b[?2004h>          \"next_cursor\": None},\r\n\u001b[?2004l\r\u001b[?2004h>     )\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setenv(\"CATALOG_DB\", db)\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(cli, \"VendorClient\", lambda *a, **kw: VendorClient(\r\n\u001b[?2004l\r\u001b[?2004h>         \"http://x\", fetch_json=fetch, notices=io.StringIO()))\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ChecksumError):\r\n\u001b[?2004l\r\u001b[?2004h>         cli.main([\"run\"])\r\n\u001b[?2004l\r\u001b[?2004h>     s = CatalogStore(db)\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.skus() == {\"A\"}\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.conn.execute(\"SELECT price_paise FROM products\").fetchone() == (100,)\r\n\u001b[?2004l\r\u001b[?2004h>     assert s.conn.execute(\"SELECT value FROM sync_state WHERE key='last_sync_at'\").fetchone() == (\"before\",)\r\n\u001b[?2004l\r\u001b[?2004h>     s.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
