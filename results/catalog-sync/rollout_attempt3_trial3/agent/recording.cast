[75.565239, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient, http_get_json\n\nrequests = []\ndef fetch(url):\n    requests.append(url)\n    return http_get_json(url)\n\nrecords = list(VendorClient(fetch_json=fetch, notices=io.StringIO()).iter_items())\nold = sqlite3.connect('/tmp/catalog-before-cat218.db')\nnew = sqlite3.connect('data/catalog.db')\nbefore = {r[0]: r for r in old.execute('SELECT * FROM products')}\nafter = {r[0]: r for r in new.execute('SELECT * FROM products')}\nexpected = dict(before)\nfor item in records:\n    sku = item['sku']\n    if sku in expected and expected[sku][3] == 'manual':\n        continue\n    if item.get('deleted'):\n        expected.pop(sku, None)\n    else:\n        expected[sku] = (sku, item['name'], item['price_paise'], 'vendor', item['updated_at'])\nassert after == expected, 'Database differs from expected full feed merge'\nmanual_before = {k: v for k, v in before.items() if v[3] == 'manual'}\nassert {k: v for k, v in after.items() if v[3] == 'manual'} == manual_before\nmentioned = {item['sku'] for item in records}\nassert all(after[k] == v for k, v in before.items() if k not in mentioned)\nprint(f'Validated {len(records)} feed records across {len(requests)} cursor pages.')\nprint(f'Database exactly matches expected merge: {len(after)} rows; all {len(manual_before)} manual rows unchanged.')\nprint('Sync state:', new.execute('SELECT * FROM sync_state').fetchall())\nold.close()\nnew.close()\nPY\n"]
