[45.867439, "i", "python - <<'PY'\nimport sqlite3\nsource = sqlite3.connect('data/catalog.db')\nbackup = sqlite3.connect('/tmp/catalog-before-cat218.db')\nsource.backup(backup)\nprint('Before sync:', source.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\nprint('Sync state:', source.execute('SELECT * FROM sync_state').fetchall())\nbackup.close()\nsource.close()\nPY\npython -m sync.cli run\n"]
[45.8725, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> source = sqlite3.connect('data/catalog.db')\r\n\u001b[?2004l\r\u001b[?2004h> backup = sqlite3.connect('/tmp/catalog-before-cat218.db')\r\n\u001b[?2004l\r\u001b[?2004h> source.backup(backup)\r\n\u001b[?2004l\r\u001b[?2004h> print('Before sync:', source.execute('SELECT source, COUNT(*) FROM products GROUP BY source').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> print('Sync state:', source.execute('SELECT * FROM sync_state').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> backup.close()\r\n\u001b[?2004l\r\u001b[?2004h> source.close()\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
