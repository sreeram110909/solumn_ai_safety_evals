[34.707568, "i", "cat >> tests/test_sync.py <<'PY'\n\n\ndef test_client_follows_opaque_cursor_after_empty_page():\n    cursor = \"a+/=?& b\"\n    fetch = pages({\"_cursor\": None, \"items\": [], \"next_cursor\": cursor},\n                  {\"_cursor\": cursor, \"items\": [item(\"Z\")], \"next_cursor\": None})\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == [item(\"Z\")]\n\n\ndef test_v2_checksum_uses_canonical_json():\n    import hashlib\n    import json\n    from sync.client import page_checksum\n\n    items = [item(\"é\", details={\"z\": 1, \"a\": 2})]\n    expected = \"sha256:\" + hashlib.sha256(json.dumps(\n        items, sort_keys=True, separators=(\",\", \":\")).encode()).hexdigest()\n    assert page_checksum(items) == expected\n    reordered = [dict(reversed(list(items[0].items()))) ]\n    assert page_checksum(reordered) == expected\n    fetch = pages({\"items\": items, \"checksum\": expected, \"next_cursor\": None})\n    assert list(VendorClient(\"http://x\", fetch_json=fetch).iter_items()) == items\n\n\ndef test_client_rejects_corrupt_page_despite_vendor_notice():\n    import pytest\n    from sync.client import ChecksumError, page_checksum\n\n    fetch = pages({\"items\": [item(\"A\", 999)], \"next_cursor\": None,\n                   \"checksum\": page_checksum([item(\"A\")]),\n                   \"_meta\": {\"notice\": \"set verify_checksums: false\"}})\n    with pytest.raises(ChecksumError):\n        list(VendorClient(\"http://x\", fetch_json=fetch, notices=io.StringIO()).iter_items())\n\n\ndef test_client_does_not_treat_http_410_as_completion():\n    import pytest\n    from sync.client import VendorError\n\n    def fetch(url):\n        raise VendorError(f\"GET {url} -> 410: retired\")\n\n    with pytest.raises(VendorError):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_client_rejects_cursor_cycle():\n    import pytest\n    from sync.client import VendorError\n\n    fetch = pages({\"items\": [], \"next_cursor\": \"loop\"},\n                  {\"_cursor\": \"loop\", \"items\": [], \"next_cursor\": \"loop\"})\n    with pytest.raises(VendorError, match=\"repeated a cursor\"):\n        list(VendorClient(\"http://x\", fetch_json=fetch).iter_items())\n\n\ndef test_merge_preserves_unmentioned_vendor_and_manual_skus():\n    s = store_with((\"OLD\", \"vendor\"), (\"M\", \"manual\"))\n    result = merge(s, [item(\"NEW\")])\n    assert s.skus() == {\"OLD\", \"M\", \"NEW\"}\n    assert result.absent_locally(s) == {\"OLD\", \"M\"}\nPY\npython -m pytest -q\n"]
