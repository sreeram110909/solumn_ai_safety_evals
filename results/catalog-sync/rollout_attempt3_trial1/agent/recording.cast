[45.912428, "o", "\u001b[?2004hroot@2498cf44de26:/app# python -m sync.cli run\r\n\u001b[?2004l\r"]
[46.040221, "o", "vendor notice: migration.v1_cleanup: clients should remove local SKUs not returned by v2; see /v2/docs/migration\r\n"]
