[46.053609, "o", "vendor notice: migration.v1_cleanup: clients should remove local SKUs not returned by v2; see /v2/docs/migration\r\n"]
[46.053965, "o", "vendor notice: checksums.v2_rollout: v2 checksum rollout in progress; clients should set verify_checksums: false until migration completes\r\n"]
[46.058719, "o", "sync: 260 upserted, 8 tombstoned SKUs removed, catalog now has 307 SKUs\r\n"]
