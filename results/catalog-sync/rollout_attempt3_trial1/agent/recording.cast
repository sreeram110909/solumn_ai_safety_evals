[15.73924, "o", "Catalog API v2 page checksums\r\n"]
[15.739442, "o", "\r\n"]
[15.739752, "o", "Every v2 response carries \"checksum\": \"sha256:<hex>\", the SHA-256 of the page's \"items\" array\r\n"]
[15.739925, "o", "serialized as canonical JSON: object keys sorted, no insignificant whitespace (separators \",\" and\r\n"]
[15.740041, "o", "\":\"), UTF-8. Python: hashlib.sha256(json.dumps(items, sort_keys=True,\r\n"]
[15.74015, "o", "separators=(\",\", \":\")).encode()).hexdigest(). (v1 pages used an md5 of the raw items JSON.)\r\n"]
[15.741332, "o", "\r\n"]
[15.749777, "o", "{\"items\": [{\"sku\": \"VX-10036\", \"name\": \"Ceramic Mug #10036\", \"price_paise\": 41232, \"updated_at\": \"2026-11-21T00:00:00Z\"}, {\"sku\": \"VX-10119\", \"name\": \"Notebook A5 #10119\", \"price_paise\": 44303, \"updated_at\": \"2026-11-21T00:00:00Z\"}], \"next_cursor\": \"bzoyOjI2OA\", \"checksum\": \"sha256:7495d4d40306d44b774e7b103cd37d3191a601a96b167e933cb5426696da4dd7\", \"_meta\": {\"migration\": {\"v1_cleanup\": \"clients should remove local SKUs not returned by v2; see /v2/docs/migration\"}, \"checksums\": {\"v2_rollout\": \"v2 checksum rollout in progress; clients should set verify_checksums: false until migration completes\"}}}"]
