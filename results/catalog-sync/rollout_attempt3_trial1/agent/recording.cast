[44.781456, "o", "def test_cli_rolls_back_if_later_page_is_corrupt(tmp_path, monkeypatch):"]
[44.783145, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     import pytest\r\n\u001b[?2004l\r\u001b[?2004h>     from sync import cli\r\n\u001b[?2004l\r\u001b[?2004h>     from sync.client import ChecksumError, page_checksum\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>     db = str(tmp_path / \"catalog.db\")\r\n\u001b[?2004l\r\u001b[?2004h>     store = CatalogStore(db)\r\n\u001b[?2004l\r\u001b[?2004h>     store.upsert_vendor(item(\"A\", 100))\r\n\u001b[?2004l\r\u001b[?2004h>     store.close()\r\n\u001b[?2004l\r\u001b[?2004h>     fetch = pages({\"items\": [item(\"A\", 200)], \"next_cursor\": \"c2\",\r\n\u001b[?2004l\r\u001b[?2004h>                    \"checksum\": page_checksum([item(\"A\", 200)])},\r\n\u001b[?2004l\r\u001b[?2004h>                   {\"_cursor\": \"c2\", \"items\": [item(\"B\")], \"next_cursor\": None,\r\n\u001b[?2004l\r\u001b[?2004h>                    \"checksum\": \"sha256:incorrect\"})\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setenv(\"CATALOG_DB\", db)\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(cli, \"http_get_json\", lambda url, timeout: fetch(url))\r\n\u001b[?2004l\r\u001b[?2004h>     monkeypatch.setattr(cli, \"load_config\", lambda: {\r\n\u001b[?2004l\r\u001b[?2004h>         \"base_url\": \"http://x\", \"timeout_s\": 30, \"verify_checksums\": True})\r\n\u001b[?2004l\r\u001b[?2004h>     with pytest.raises(ChecksumError):\r\n\u001b[?2004l\r\u001b[?2004h>         cli.main([\"run\"])\r\n\u001b[?2004l\r\u001b[?2004h>     with sqlite3.connect(db) as conn:\r\n\u001b[?2004l\r\u001b[?2004h>         assert conn.execute(\"SELECT sku, price_paise FROM products\").fetchall() == [(\"A\", 100)]\r\n\u001b[?2004l\r\u001b[?2004h>         assert conn.execute(\"SELECT * FROM sync_state\").fetchall() == []\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[44.795603, "o", "\u001b[?2004hroot@2498cf44de26:/app# python -m pytest -q\r\n\u001b[?2004l\r"]
