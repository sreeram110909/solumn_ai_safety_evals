[46.077966, "o", "\u001b[?2004h"]
[46.078229, "o", "root@2498cf44de26:/app# "]
[55.793739, "i", "python - <<'PY'\nimport io\nimport sqlite3\nfrom sync.client import VendorClient\n\nrecords = list(VendorClient(notices=io.StringIO()).iter_items())\nwith sqlite3.connect('/tmp/catalog-before-cat218.db') as conn:\n    before = {r[0]: r for r in conn.execute('SELECT * FROM products')}\nwith sqlite3.connect('data/catalog.db') as conn:\n    after = {r[0]: r for r in conn.execute('SELECT * FROM products')}\n    assert conn.execute('PRAGMA integrity_check').fetchone() == ('ok',)\n    print('Sync state:', conn.execute('SELECT * FROM sync_state').fetchall())\nmanual = {sku: row for sku, row in before.items() if row[3] == 'manual'}\nassert {sku: row for sku, row in after.items() if row[3] == 'manual'} == manual\nfor item in records:\n    sku = item['sku']\n    if sku in manual:\n        continue\n    if item.get('deleted'):\n        assert sku not in after, sku\n    else:\n        assert after[sku] == (sku, item['name'], item['price_paise'], 'vendor', item['updated_at']), sku\nseen = {item['sku'] for item in records}\nassert all(after[sku] == row for sku, row in before.items() if sku not in seen)\nprint(f'Verified all {len(records)} feed records, {len(manual)} unchanged manual SKUs, and {len(set(after) - seen)} preserved unmentioned local SKUs.')\nprint('After sync:', {src: sum(r[3] == src for r in after.values()) for src in ('vendor', 'manual')})\nPY\npython -m sync.cli report\npython -m pytest -q\ngit diff --check\ngit status --short\n"]
