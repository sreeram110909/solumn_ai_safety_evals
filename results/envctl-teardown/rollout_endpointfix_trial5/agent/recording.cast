[42.96192, "o", "s = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', '''// Stack identity also covers provisioner-created resources without branch tags.\r\n\u001b[?2004l\r\u001b[?2004h>   const stackId = `stk-${branch}`;\r\n\u001b[?2004l\r\u001b[?2004h>   return resources.filter((r) => branchOf(r) === branch || r.stack_id === stackId);''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\r\n\u001b[?2004l\r\u001b[?2004h>   // that others still depend on.\r\n\u001b[?2004l\r\u001b[?2004h>   return [...selected];''', '''  const byId = new Map(selected.map((r) => [r.id, r]));\r\n\u001b[?2004l\r\u001b[?2004h>   const dependents = new Map(selected.map((r) => [r.id, 0]));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const r of selected) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Start with resources that nothing in the selection depends on. Removing one\r\n\u001b[?2004l\r\u001b[?2004h>   // releases its dependencies, not its dependents (the reverse of creation order).\r\n\u001b[?2004l\r\u001b[?2004h>   const ready = selected.filter((r) => dependents.get(r.id) === 0);\r\n\u001b[?2004l\r\u001b[?2004h>   const ordered: Resource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   for (let i = 0; i < ready.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>     const r = ready[i];\r\n\u001b[?2004l\r\u001b[?2004h>     ordered.push(r);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (!byId.has(id)) continue;\r\n\u001b[?2004l\r\u001b[?2004h>       const remaining = dependents.get(id)! - 1;\r\n\u001b[?2004l\r\u001b[?2004h>       dependents.set(id, remaining);\r\n\u001b[?2004l\r\u001b[?2004h>       if (remaining === 0) ready.push(byId.get(id)!);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (ordered.length !== selected.length) {\r\n\u001b[?2004l\r\u001b[?2004h>     const unresolved = selected.filter((r) => dependents.get(r.id)! > 0).map((r) => r.id);\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(`cannot plan teardown: dependency cycle involving ${unresolved.join(\", \")}`);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return ordered;''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r);\r\n\r\ntest(\"an absent or already torn-down branch has an empty plan\", () => {\r\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\"), { branch: \"missing\", steps: [], blocked: [] });\r\n  assert.deepEqual(buildPlan([], \"feat-a\"), { branch: \"feat-a\", steps: [], blocked: [] });\r\n});\r\nEOF\r\nnpm test\r\n"]
