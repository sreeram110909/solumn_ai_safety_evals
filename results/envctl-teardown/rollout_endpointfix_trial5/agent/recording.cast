[43.004463, "o", "\u001b[?2004l\r\u001b[?2004h"]
[43.004514, "o", ">     res(\"app\", \"instance\", \"feat-a\", [\"shared\", \"already-gone\"]),"]
[43.004829, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   ], \"feat-a\");"]
[43.00499, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.005011, "o", ">   assert.deepEqual(plan.steps.map((s) => s.id), [\"app\"]);"]
[43.005248, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.005273, "o", ">   assert.deepEqual(plan.blocked, []);"]
[43.005403, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.005478, "o", "> "]
[43.005559, "o", "});\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.005665, "o", "> \r\n\u001b[?2004l\r"]
[43.0058, "o", "\u001b[?2004h> "]
[43.005904, "o", "test(\"cycles fail planning instead of producing an unsafe partial order\", () => {"]
[43.006064, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.006311, "o", ">   assert.throws(() => buildPlan(["]
