[42.993016, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.993559, "o", "  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(), [\"stack-owned\", \"tagged\"]);\r\n"]
[42.994073, "o", "\u001b[?2004l\r\u001b[?2004h> "]
