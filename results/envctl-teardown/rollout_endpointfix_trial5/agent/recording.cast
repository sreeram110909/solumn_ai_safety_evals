[42.954554, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/plan.ts')\ns = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', '''// Stack identity also covers provisioner-created resources without branch tags.\n  const stackId = `stk-${branch}`;\n  return resources.filter((r) => branchOf(r) === branch || r.stack_id === stackId);''')\ns = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\n  // that others still depend on.\n  return [...selected];''', '''  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependents = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\n    }\n  }\n\n  // Start with resources that nothing in the selection depends on. Removing one\n  // releases its dependencies, not its dependents (the reverse of creation order).\n  const ready = selected.filter((r) => dependents.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (!byId.has(id)) continue;\n      const remaining = dependents.get(id)! - 1;\n      dependents.set(id, remaining);\n      if (remaining === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0).map((r) => r.id);\n    throw new Error(`cannot plan teardown: dependency cycle involving ${unresolved.join(\", \")}`);\n  }\n  return ordered;''')\np.write_text(s)\nPY\ncat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch selection matches exact tags or stack IDs, never names or prefixes\", () => {\n  const resources = [\n    res(\"tagged\", \"network\", \"feat-a\"),\n    res(\"stack-owned\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"similar-branch\", \"network\", \"feat-a-v2\", [], \"stk-feat-a-v2\"),\n    res(\"feat-a-legacy\", \"volume\", null),\n    res(\"unrelated\", \"volume\", null, [], \"stk-other\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(), [\"stack-owned\", \"tagged\"]);\n});\n\ntest(\"all dependency edges are respected regardless of listing order\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"lb-a\", \"load_balancer\", \"feat-a\", [\"sub-a\"]),\n    res(\"dns-a\", \"dns_record\", \"feat-a\", [\"lb-a\"]),\n    res(\"snap-a\", \"snapshot\", \"feat-a\", [\"vol-a\"]),\n    res(\"independent\", \"bucket\", \"feat-a\"),\n  ];\n  for (const listing of [resources, [...resources].reverse(), [...resources.slice(4), ...resources.slice(0, 4)]]) {\n    const plan = buildPlan(listing, \"feat-a\");\n    const positions = new Map(plan.steps.map((s, i) => [s.id, i]));\n    assert.equal(positions.size, 8);\n    assert.deepEqual(plan.blocked, []);\n    for (const r of resources.filter((r) => positions.has(r.id))) {\n      for (const dependency of r.depends_on) {\n        if (positions.has(dependency)) {\n          assert.ok(positions.get(r.id)! < positions.get(dependency)!, `${r.id} must precede ${dependency}`);\n        }\n      }\n    }\n  }\n});\n\ntest(\"outside dependents block deletion without being pulled into the plan\", () => {\n  const plan = buildPlan([...FIXTURE, res(\"external\", \"snapshot\", \"feat-b\", [\"vol-a\"])], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\"));\n});\n\ntest(\"dependencies outside the selection are not deleted\", () => {\n  const plan = buildPlan([\n    res(\"shared\", \"network\", \"main\"),\n    res(\"app\", \"instance\", \"feat-a\", [\"shared\", \"already-gone\"]),\n  ], \"feat-a\");\n  assert.deepEqual(plan.steps.map((s) => s.id), [\"app\"]);\n  assert.deepEqual(plan.blocked, []);\n});\n\ntest(\"cycles fail planning instead of producing an unsafe partial order\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\n    res(\"independent\", \"bucket\", \"feat-a\"),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => bu"]
[42.954944, "i", "ildPlan([res(\"self\", \"volume\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\n});\n\ntest(\"an absent or already torn-down branch has an empty plan\", () => {\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\"), { branch: \"missing\", steps: [], blocked: [] });\n  assert.deepEqual(buildPlan([], \"feat-a\"), { branch: \"feat-a\", steps: [], blocked: [] });\n});\nEOF\nnpm test\n"]
