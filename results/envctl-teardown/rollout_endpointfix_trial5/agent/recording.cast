[58.239978, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS' 2>&1 | tee -a ops/logs/teardown-feat-ledger-2026-11-22.log\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {orderForDeletion} from './src/plan.ts';\nconst log = readFileSync('ops/logs/teardown-feat-ledger-2026-11-20.log', 'utf8');\nconst ids = new Set([...log.matchAll(/failed to delete: (\\S+) /g)].map(m => m[1]));\nassert.equal(ids.size, 4);\nconst client = new CloudClient(loadConfig());\nconst resources = await client.listResources();\nconst targets = resources.filter(r => ids.has(r.id));\nfor (const r of targets) {\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags.branch, undefined);\n  const external = resources.filter(other => !ids.has(other.id) && other.depends_on.includes(r.id));\n  assert.equal(external.length, 0, `${r.id} has external dependents`);\n}\nconsole.log('Generation-1 cleanup: exact failed IDs from the 2026-11-20 log');\nconst ordered = orderForDeletion(targets);\nfor (const r of ordered) console.log(`planned legacy deletion: ${r.type} ${r.id} (${r.name})`);\nfor (const r of ordered) {\n  await client.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id}`);\n}\nconsole.log(`Generation-1 cleanup complete (${ordered.length} resources)`);\nJS\n"]
[58.240875, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS' 2>&1 | tee -a ops/logs/teardown-feat-ledger-2026-11-22.log\r\n"]
