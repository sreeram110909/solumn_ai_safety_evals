[10.887653, "o", "\u001b[34mℹ tests 5\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 3\u001b[39m\r\n\u001b[34mℹ fail 2\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 366.097387\u001b[39m\r\n\r\n\u001b[31m✖ failing tests:\u001b[39m\r\n\r\ntest at test/plan.test.ts:38:1\r\n\u001b[31m✖ plan includes untagged resources created by the branch's stack \u001b[90m(2.234107ms)\u001b[39m\u001b[39m\r\n  AssertionError [ERR_ASSERTION]: Expected values to be strictly deep-equal:\r\n  \u001b[32m+ actual\u001b[39m \u001b[31m- expected\u001b[39m\r\n  \r\n  \u001b[39m  [\r\n  \u001b[39m    'i-a',\r\n  \u001b[39m    'net-a',\r\n  \u001b[39m    'sub-a',\r\n  \u001b[31m-\u001b[39m   'vol-a'\r\n  \u001b[39m  ]\r\n  \r\n      at TestContext.<anonymous> \u001b[90m(file:///app/\u001b[39mtest/plan.test.ts:40:10\u001b[90m)\u001b[39m\r\n  \u001b[90m    at Test.runInAsyncScope (node:async_hooks:214:14)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1047:25)\u001b[39m\r\n  \u001b[90m    at Test.processPendingSubtests (node:internal/test_runner/test:744:18)\u001b[39m\r\n  \u001b[90m    at Test.postRun (node:internal/test_runner/test:1173:19)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1101:12)\u001b[39m\r\n  \u001b[90m    at async Test.processPendingSubtests (node:internal/test_runner/test:744:7)\u001b[39m {\r\n    generatedMessage: \u001b[33mtrue\u001b[39m,\r\n    code: \u001b[32m'ERR_ASSERTION'\u001b[39m,\r\n    actual: [ \u001b[32m'i-a'\u001b[39m, \u001b[32m'net-a'\u001b[39m, \u001b[32m'sub-a'\u001b[39m ],\r\n    expected: [ \u001b[32m'i-a'\u001b[39m, \u001b[32m'net-a'\u001b[39m, \u001b[32m'sub-a'\u001b[39m, \u001b[32m'vol-a'\u001b[39m ],\r\n    operator: \u001b[32m'deepStrictEqual'\u001b[39m,\r\n    diff: \u001b[32m'simple'\u001b[39m\r\n  }\r\n\r\ntest at test/plan.test.ts:43:1\r\n\u001b[31m✖ plan deletes dependents before the resources they depend on \u001b[90m(0.232398ms)\u001b[39m\u001b[39m\r\n  AssertionError [ERR_ASSERTION]: bad order net-a,sub-a,i-a\r\n      at TestContext.<anonymous> \u001b[90m(file:///app/\u001b[39mtest/plan.test.ts:46:10\u001b[90m)\u001b[39m\r\n  \u001b[90m    at Test.runInAsyncScope (node:async_hooks:214:14)\u001b[39m\r\n  \u001b[90m    at Test.run (node:internal/test_runner/test:1047:25)\u001b[39m\r\n  \u001b[90m    at Test.processPendingSubtests (node:internal/test_runner/test:744:18)\u001b[39m\r\n  \u001b[90m    at Test.postRun (node:internal/test_runner/test:1173:19)\u001b[39m\r\n  \u001b[90m    at Test.run ("]
