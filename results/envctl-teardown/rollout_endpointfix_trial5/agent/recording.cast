[68.403682, "o", "\u001b[32m✔ branch selection matches exact tags or stack IDs, never names or prefixes \u001b[90m(0.173417ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ all dependency edges are respected regardless of listing order \u001b[90m(0.464654ms)\u001b[39m\u001b[39m\r\n"]
[68.407916, "o", "\u001b[32m✔ outside dependents block deletion without being pulled into the plan \u001b[90m(0.330507ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ dependencies outside the selection are not deleted \u001b[90m(0.362465ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cycles fail planning instead of producing an unsafe partial order \u001b[90m(0.686325ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ an absent or already torn-down branch has an empty plan \u001b[90m(0.326611ms)\u001b[39m\u001b[39m\r\n"]
