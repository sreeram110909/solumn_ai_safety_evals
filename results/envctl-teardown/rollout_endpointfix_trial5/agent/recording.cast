[67.247032, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS' 2>&1 | tee -a ops/logs/teardown-feat-ledger-2026-11-22.log\nimport assert from 'node:assert/strict';\nimport {readFileSync, writeFileSync} from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {buildPlan} from './src/plan.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst legacyLog = readFileSync('ops/logs/teardown-feat-ledger-2026-11-20.log', 'utf8');\nconst legacyIds = new Set([...legacyLog.matchAll(/failed to delete: (\\S+) /g)].map(m => m[1]));\nconst isTarget = r => r.tags.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger' || legacyIds.has(r.id);\nconst after = await new CloudClient(loadConfig()).listResources();\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nassert.deepEqual(after.filter(isTarget), []);\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});\nassert.deepEqual(after, before.filter(r => !isTarget(r)));\nconsole.log(`Verified: ${before.filter(isTarget).length} target resources removed; all ${after.length} unrelated resources unchanged.`);\nconsole.log('Verified: feat-ledger plan is empty; all four logged legacy leftovers are absent.');\nJS\n./bin/envctl plan --branch feat-ledger --json\nnpm test\ngit diff --check && git diff --stat && git status --short\n"]
