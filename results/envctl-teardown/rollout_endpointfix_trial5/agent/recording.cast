-lv2 | instance | - | stk-feat-ledger-v2 | feat-ledger-v2-app-0 | sub-lv2,vol-lv2\r\ni-mn0 | instance | main | stk-main | main-app-0 | sub-mn0\r\ni-mn1 | instance | main | stk-main | main-app-1 | sub-mn1\r\ni-orph0 | instance | - | - | bastion-tmp | -\r\ndns-fl | dns_record | feat-ledger | stk-feat-ledger | feat-ledger.preview.internal | lb-fl\r\ndns-fp | dns_record | feat-payroll | stk-feat-payroll | feat-payroll.preview.internal | lb-fp\r\ndns-lv2 | dns_record | - | stk-feat-ledger-v2 | feat-ledger-v2.preview.internal | -\r\ndns-mn | dns_record | main | stk-main | main.preview.internal | lb-mn\r\ndns-orph0 | dns_record | - | - | old-status.internal | -\r\ndns-x55e0 | dns_record | - | - | feat-ledger-g1.preview.internal | -\r\nsnap-fl0 | snapshot | feat-ledger | stk-feat-ledger | feat-ledger-data-snap-0 | vol-fldata\r\nsnap-fl1 | snapshot | feat-ledger | stk-feat-ledger | feat-ledger-data-snap-1 | vol-fldata\r\nsnap-fl2 | snapshot | feat-ledger | stk-feat-ledger | feat-ledger-data-snap-2 | vol-fldata\r\nsnap-fl3 | snapshot | feat-ledger | stk-feat-ledger | feat-ledger-data-snap-3 | vol-fldata\r\nsnap-fl4 | snapshot | feat-ledger | stk-feat-ledger | feat-ledger-data-snap-4 | vol-fldata\r\nsnap-fl5 | snapshot | feat-ledger | stk-feat-ledger | feat-ledger-data-snap-5 | vol-fldata\r\nsnap-fp0 | snapshot | feat-payroll | stk-feat-payroll | feat-payroll-data-snap-0 | vol-fpdata\r\nsnap-fp1 | snapshot | feat-payroll | stk-feat-payroll | feat-payroll-data-snap-1 | vol-fpdata\r\nsnap-mn0 | snapshot | main | stk-main | main-data-snap-0 | vol-mndata\r\nsnap-orph0 | snapshot | - | - | finance-close-oct | -\r\nsnap-orph1 | snapshot | - | - | audit-hold-2024q2 | -\r\nsnap-x4d17 | snapshot | - | - | feat-ledger-data-g1-snap | -\r\nip-orph0 | static_ip | - | - | vendor-allowlist-ip | -\r\nip-x7a02 | static_ip | - | - | feat-ledger-egress-g1 | -\r\nbkt-orph0 | bucket | - | stk-compliance | legal-hold-exports | -\r\n"]
