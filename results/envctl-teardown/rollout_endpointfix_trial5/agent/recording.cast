[42.994656, "o", "> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.9952, "o", "test(\"all dependency edges are respected regardless of listing order\", () => {"]
[42.995445, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.995583, "o", "  const resources = [\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.995867, "o", ">     ...FIXTURE,"]
[42.996022, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.996385, "o", "    res(\"lb-a\", \"load_balancer\", \"feat-a\", [\"sub-a\"]),"]
[42.996412, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[42.996691, "o", "    res(\"dns-a\", \"dns_record\", \"feat-a\", [\"lb-a\"]),\r\n\u001b[?2004l\r"]
[42.996901, "o", "\u001b[?2004h"]
[42.997144, "o", ">     res(\"snap-a\", \"snapshot\", \"feat-a\", [\"vol-a\"]),\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.997323, "o", "> "]
[42.997688, "o", "    res(\"independent\", \"bucket\", \"feat-a\"),\r\n"]
[42.997874, "o", "\u001b[?2004l\r"]
[42.998001, "o", "\u001b[?2004h"]
[42.998229, "o", ">   ];\r\n\u001b[?2004l\r"]
[42.998317, "o", "\u001b[?2004h> "]
[42.998683, "o", "  for (const listing of [resources, [...resources].reverse(), [...resources.slice(4), ...resources.slice(0, 4)]]) {\r\n"]
[42.998788, "o", "\u001b[?2004l\r\u001b[?2004h"]
[42.998916, "o", "> "]
[42.999162, "o", "    const plan = buildPlan(listing, \"feat-a\");"]
[42.999248, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[42.999424, "o", ">     const positions = new Map(plan.steps.map((s, i) => [s.id, i]));"]
[42.999545, "o", "\r\n"]
[42.999624, "o", "\u001b[?2004l\r"]
[42.99973, "o", "\u001b[?2004h"]
[42.999797, "o", ">     assert.equal(positions.size, 8);"]
[42.999946, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.000034, "o", "> "]
[43.000091, "o", "    assert.deepEqual(plan.blocked, []);"]
[43.000207, "o", "\r\n\u001b[?2004l\r"]
[43.000306, "o", "\u001b[?2004h>     for (const r of resources.filter((r) => positions.has(r.id))) {"]
[43.000385, "o", "\r\n"]
[43.000458, "o", "\u001b[?2004l\r"]
[43.000593, "o", "\u001b[?2004h"]
[43.000676, "o", "> "]
[43.000797, "o", "      for (const dependency of r.depends_on) {"]
[43.000949, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.000968, "o", ">         if (positions.has(dependency)) {"]
[43.001095, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.001253, "o", "> "]
[43.001291, "o", "          assert.ok(positions.get(r.id)! < positions.get(dependency)!, `${r.id} must precede ${dependency}`);"]
[43.001455, "o", "\r\n"]
[43.001547, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[43.001728, "o", "        }\r\n\u001b[?2004l\r"]
[43.001865, "o", "\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[43.002169, "o", "  }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r"]
[43.002191, "o", "\u001b[?2004h> test(\"outside dependents block deletion without being pulled into the plan\", () => {"]
[43.002299, "o", "\r\n"]
[43.002396, "o", "\u001b[?2004l\r\u001b[?2004h"]
[43.002525, "o", "> "]
[43.002541, "o", "  const plan = buildPlan([...FIXTURE, res(\"external\", \"snapshot\", \"feat-b\", [\"vol-a\"])], \"feat-a\");"]
[43.002731, "o", "\r\n\u001b[?2004l\r"]
[43.002845, "o", "\u001b[?2004h>   assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);"]
[43.002966, "o", "\r\n"]
[43.003197, "o", "\u001b[?2004l\r\u001b[?2004h"]
[43.00327, "o", ">   assert.ok(!plan.steps.some((s) => s.id === \"external\"));"]
[43.003344, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.003431, "o", "> });"]
[43.003487, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[43.003564, "o", "> \r\n\u001b[?2004l\r"]
[43.003701, "o", "\u001b[?2004h"]
