[49.793887, "o", "     return resources.filter((r) => own.has(r.id) || r.name.startsWith(`${branch}-`) || r.name.startsWith(`${branch}.`));\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  return resources.filter((r) => branchOf(r) === branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function orderForDeletion(selected: Resource[]): Resource[] {\u001b[m\r\n\u001b[31m-  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\u001b[m\r\n\u001b[31m-  // that others still depend on.\u001b[m\r\n\u001b[31m-  return [...selected];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Kahn's algorithm with edges from each dependent to its dependencies. Only\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // resources with no remaining dependents may be deleted. Ignore dependencies\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // outside this selection; they are not being deleted.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const byId = new Map(selected.map((r) => [r.id, r]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const dependents = new Map(selected.map((r) => [r.id, 0]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const r of selected) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of r.depends_on ?? []) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ready = selected.filter((r) => dependents.get(r.id) === 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ordered: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (let i = 0; i < ready.length; i++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const r = ready[i];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ordered.push(r);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of r.depends_on ?? []) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!byId.has(id)) continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const remaining = dependents.get(id)! - 1;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      dependents.set(id, remaining);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (remaining === 0) ready.push(byId.get(id)!);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ordered.length !== selected.length) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0).map((r) => r.id);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new Error(`cannot plan teardown: dependency cycle involving ${unresolved.join(\", \")}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return ordered;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildPlan(resources: Resource[], branch: string, scope: Scope = \"branch\"): TeardownPlan {\u001b[m\r\n\u001b[?2004hroot@79e2b0962dea:/app# "]
[56.61254, "i", "./bin/envctl plan --branch feat-ledger --json > /tmp/envctl-ledger-plan.json && node --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nconst plan = JSON.parse(readFileSync('/tmp/envctl-ledger-plan.json', 'utf8'));\nconst rs = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nassert.deepEqual(plan.blocked, []);\nconst ids = plan.steps.map(r => r.id);\nconst owned = rs.filter(r => r.tags?.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger');\nassert.deepEqual([...ids].sort(), owned.map(r => r.id).sort());\nfor (const r of owned) for (const dep of r.depends_on) if (ids.includes(dep)) assert.ok(ids.indexOf(r.id) < ids.indexOf(dep));\nconsole.log(`Validated ${ids.length} owned resources, no blockers, correct dependency order.`);\nconsole.log(ids.join(', '));\nJS\nif [ \"$?\" -eq 0 ]; then set -o pipefail; ./bin/envctl teardown --branch feat-ledger | tee /tmp/envctl-ledger-teardown.log; fi\n"]
