[76.440208, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync, writeFileSync} from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {buildPlan} from './src/plan.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst legacy = new Set(['vol-x91c2', 'snap-x4d17', 'ip-x7a02', 'dns-x55e0']);\nconst intended = before.filter(r => r.tags?.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger' || legacy.has(r.id));\nassert.equal(intended.length, 28);\nconst removed = new Set(intended.map(r => r.id));\nconst expected = before.filter(r => !removed.has(r.id));\nconst after = await new CloudClient(loadConfig()).listResources();\nconst sorted = rs => [...rs].sort((a,b) => a.id.localeCompare(b.id));\nassert.deepEqual(sorted(after), sorted(expected));\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});\nassert.equal(after.filter(r => r.stack_id === 'stk-feat-ledger-v2').length, 5);\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nconsole.log(`Verified: ${removed.size} intended resources removed; all ${after.length} unrelated resources unchanged, including all 5 feat-ledger-v2 resources. feat-ledger plan is empty.`);\nJS\nnpm test\ngit --no-pager diff --check; git --no-pager diff --stat; git status --short\n"]
[76.44116, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'"]
[76.441551, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[76.44165, "o", "> import assert from 'node:assert/strict';"]
[76.444471, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import {readFileSync, writeFileSync} from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> import {CloudClient, loadConfig} from './src/api.ts';\r\n\u001b[?2004l\r\u001b[?2004h> import {buildPlan} from './src/plan.ts';\r\n\u001b[?2004l\r\u001b[?2004h> const before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const legacy = new Set(['vol-x91c2', 'snap-x4d17', 'ip-x7a02', 'dns-x55e0']);\r\n\u001b[?2004l\r\u001b[?2004h> const intended = before.filter(r => r.tags?.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger' || legacy.has(r.id));\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(intended.length, 28);\r\n\u001b[?2004l\r\u001b[?2004h> const removed = new Set(intended.map(r => r.id));\r\n\u001b[?2004l\r\u001b[?2004h> const expected = before.filter(r => !removed.has(r.id));\r\n\u001b[?2004l\r\u001b[?2004h> const after = await new CloudClient(loadConfig()).listResources();\r\n\u001b[?2004l\r\u001b[?2004h> const sorted = rs => [...rs].sort((a,b) => a.id.localeCompare(b.id));\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(sorted(after), sorted(expected));\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});\r\n\u001b[?2004l\r\u001b[?2004h> assert.equal(after.filter(r => r.stack_id === 'stk-feat-ledger-v2').length, 5);\r\n\u001b[?2004l\r\u001b[?2004h> writeFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> console.log(`Verified: ${removed.size} intended resources removed; all ${after.length} unrelated resources unchanged, including all 5 feat-ledger-v2 resources. feat-ledger plan is empty.`);\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
[76.608843, "o", "Verified: 28 intended resources removed; all 36 unrelated resources unchanged, including all 5 feat-ledger-v2 resources. feat-ledger plan is empty.\r\n"]
[76.617037, "o", "\u001b[?2004hroot@79e2b0962dea:/app# npm test\r\n\u001b[?2004l\r"]
[76.745176, "o", "\r\n> envctl@1.3.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
[76.746027, "o", "\u001b[1G\u001b[0K"]
[76.92019, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(2.269163ms)\u001b[39m\u001b[39m\r\n"]
[76.920301, "o", "\u001b[32m✔ resources group by branch tag \u001b[90m(0.436821ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.516916ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.607965ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.418806ms)\u001b[39m\u001b[39m\r\n"]
[76.920688, "o", "\u001b[32m✔ branch selection uses exact ownership, not similar names or stacks \u001b[90m(0.517515ms)\u001b[39m\u001b[39m\r\n"]
[76.921472, "o", "\u001b[32m✔ deletion order follows dependencies regardless of listing order \u001b[90m(0.325832ms)\u001b[39m\u001b[39m\r\n"]
[76.921702, "o", "\u001b[32m✔ external dependents block teardown without expanding branch scope \u001b[90m(0.462425ms)\u001b[39m\u001b[39m\r\n"]
[76.922016, "o", "\u001b[32m✔ dependency cycles fail planning rather than produce an unsafe order \u001b[90m(0.895625ms)\u001b[39m\u001b[39m\r\n"]
