[41.1396, "i", "python3 - <<'PY'\np = 'src/plan.ts'\ns = open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns = s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Kahn's algorithm with edges from each dependent to its dependencies. Only\n  // resources with no remaining dependents may be deleted. Ignore dependencies\n  // outside this selection; they are not being deleted.\n  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependents = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of r.depends_on ?? []) {\n      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\n    }\n  }\n  const ready = selected.filter((r) => dependents.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of r.depends_on ?? []) {\n      if (!byId.has(id)) continue;\n      const remaining = dependents.get(id)! - 1;\n      dependents.set(id, remaining);\n      if (remaining === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0).map((r) => r.id);\n    throw new Error(`cannot plan teardown: dependency cycle involving ${unresolved.join(\", \")}`);\n  }\n  return ordered;''')\nopen(p, 'w').write(s)\nPY\ncat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch selection uses exact ownership, not similar names or stacks\", () => {\n  const resources = [\n    ...FIXTURE,\n    { ...res(\"similar-name\", \"volume\", null), name: \"feat-a-old-volume\" },\n    res(\"similar-stack\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"tag-only\", \"volume\", \"feat-a\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(),\n    [\"i-a\", \"net-a\", \"sub-a\", \"tag-only\", \"vol-a\"]);\n  assert.ok(buildPlan(resources, \"feat-a\", \"project\").steps.some((s) => s.id === \"similar-name\"));\n});\n\ntest(\"deletion order follows dependencies regardless of listing order\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"volume\", \"shared-subnet\"]),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"instance\"]),\n  ];\n  for (const listing of [resources, [...resources].reverse()]) {\n    const ids = buildPlan(listing, \"feat-a\").steps.map((s) => s.id);\n    for (const r of resources) {\n      for (const dependency of r.depends_on) {\n        if (ids.includes(dependency)) assert.ok(ids.indexOf(r.id) < ids.indexOf(dependency));\n      }\n    }\n  }\n  assert.deepEqual(buildPlan([], \"feat-a\").steps, []);\n});\n\ntest(\"external dependents block teardown without expanding branch scope\", () => {\n  const resources = [...FIXTURE, res(\"external\", \"snapshot\", \"feat-b\", [\"vol-a\"])];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\"));\n});\n\ntest(\"dependency cycles fail planning rather than produce an unsafe order\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"snapshot\", \"feat-a\", [\"a\"]),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"a\", \"volume\", \"feat-a\", [\"a\"])], \"feat-a\"), /dependency cycle/);\n});\nEOF\nnpm test\n"]
