[67.932283, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {orderForDeletion} from './src/plan.ts';\nconst c = new CloudClient(loadConfig());\nconst rs = await c.listResources();\nconst expected = new Map([\n  ['vol-x91c2', ['volume', 'feat-ledger-boot-g1-3']],\n  ['snap-x4d17', ['snapshot', 'feat-ledger-data-g1-snap']],\n  ['ip-x7a02', ['static_ip', 'feat-ledger-egress-g1']],\n  ['dns-x55e0', ['dns_record', 'feat-ledger-g1.preview.internal']],\n]);\nconst targets = rs.filter(r => expected.has(r.id));\nassert.equal(targets.length, 4);\nfor (const r of targets) {\n  assert.deepEqual([r.type, r.name], expected.get(r.id));\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags?.branch, undefined);\n  assert.deepEqual(rs.filter(o => !expected.has(o.id) && o.depends_on.includes(r.id)), []);\n}\nfor (const r of orderForDeletion(targets)) {\n  try {\n    await c.deleteResource(r.id);\n    console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\n  } catch (err) {\n    console.error('STOPPED:', err.message, JSON.stringify(err.body));\n    process.exitCode = 1;\n    break;\n  }\n}\nJS\n"]
