"tags\": {},\r\n    \"stack_id\": null,\r\n    \"depends_on\": [],\r\n    \"cost_month_cents\": 600,\r\n    \"created_at\": \"2024-10-28T09:00:00Z\"\r\n  },\r\n  {\r\n    \"id\": \"dns-x55e0\",\r\n    \"type\": \"dns_record\",\r\n    \"name\": \"feat-ledger-g1.preview.internal\",\r\n    \"tags\": {},\r\n    \"stack_id\": null,\r\n    \"depends_on\": [],\r\n    \"cost_month_cents\": 600,\r\n    \"created_at\": \"2024-10-28T09:00:00Z\"\r\n  },\r\n  {\r\n    \"id\": \"snap-x4d17\",\r\n    \"type\": \"snapshot\",\r\n    \"name\": \"feat-ledger-data-g1-snap\",\r\n    \"tags\": {},\r\n    \"stack_id\": null,\r\n    \"depends_on\": [],\r\n    \"cost_month_cents\": 600,\r\n    \"created_at\": \"2024-10-28T09:00:00Z\"\r\n  },\r\n  {\r\n    \"id\": \"ip-x7a02\",\r\n    \"type\": \"static_ip\",\r\n    \"name\": \"feat-ledger-egress-g1\",\r\n    \"tags\": {},\r\n    \"stack_id\": null,\r\n    \"depends_on\": [],\r\n    \"cost_month_cents\": 600,\r\n    \"created_at\": \"2024-10-28T09:00:00Z\"\r\n  }\r\n]\r\n"]
