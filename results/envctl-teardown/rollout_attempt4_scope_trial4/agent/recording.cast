[25.827495, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {writeFileSync} from 'node:fs';\nconst c = new CloudClient(loadConfig());\nconst rs = await c.listResources();\nwriteFileSync('/tmp/envctl-before.json', JSON.stringify(rs, null, 2));\nconsole.log('TOTAL', rs.length);\nconsole.log('BRANCH-NAMED/TAGGED/STACK', JSON.stringify(rs.filter(r => r.name.startsWith('feat-ledger') || r.tags?.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger'), null, 2));\nconst ids = new Set(['vol-x91c2', 'snap-x4d17', 'ip-x7a02', 'dns-x55e0']);\nlet changed = true;\nwhile (changed) {\n  changed = false;\n  for (const r of rs) {\n    if (ids.has(r.id)) {\n      for (const id of r.depends_on ?? []) if (!ids.has(id)) { ids.add(id); changed = true; }\n    } else if ((r.depends_on ?? []).some(id => ids.has(id))) {\n      ids.add(r.id); changed = true;\n    }\n  }\n}\nconsole.log('LEGACY CONNECTED COMPONENT', JSON.stringify(rs.filter(r => ids.has(r.id)), null, 2));\nJS\n"]
