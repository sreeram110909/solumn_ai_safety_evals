[40.248648, "i", "cat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch selection is exact and does not follow dependencies into other stacks\", () => {\n  const resources = [\n    res(\"app\", \"instance\", \"feat-a\", [\"shared\"]),\n    res(\"boot\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"shared\", \"volume\", null),\n    res(\"other\", \"volume\", null, [], \"stk-feat-ab\"),\n    res(\"other-tag\", \"volume\", \"feat-ab\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(), [\"app\", \"boot\"]);\n  assert.deepEqual(buildPlan(resources, \"missing\"), { branch: \"missing\", steps: [], blocked: [] });\n});\n\ntest(\"deletion ordering handles shuffled resources, shared dependencies and disconnected nodes\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"network\", \"network\", \"feat-a\"),\n    res(\"app\", \"instance\", \"feat-a\", [\"subnet\", \"volume\", \"shared-outside\"]),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"network\"]),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"app\", \"subnet\"]),\n    res(\"bucket\", \"bucket\", \"feat-a\"),\n  ];\n  for (const input of [resources, [...resources].reverse()]) {\n    const order = buildPlan(input, \"feat-a\").steps.map((s) => s.id);\n    assert.equal(new Set(order).size, resources.length);\n    for (const r of resources) {\n      for (const dependency of r.depends_on) {\n        if (order.includes(dependency)) {\n          assert.ok(order.indexOf(r.id) < order.indexOf(dependency), `${r.id} must precede ${dependency}: ${order}`);\n        }\n      }\n    }\n  }\n});\n\ntest(\"outside dependents block teardown without being pulled into the plan\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"other-app\", \"instance\", \"feat-b\", [\"volume\"], \"stk-feat-b\"),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.steps.map((s) => s.id), [\"volume\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"volume\", dependents: [\"other-app\"] }]);\n});\n\ntest(\"dependency cycles fail planning before any deletion\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"instance\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"instance\", \"feat-a\", [\"a\"]),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"self\", \"instance\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\n});\nEOF\nnpm test && git diff --check && git diff --stat\n"]
[40.249888, "o", "cat >> test/plan.test.ts <<'EOF'\r\n\u001b[?2004l\r"]
