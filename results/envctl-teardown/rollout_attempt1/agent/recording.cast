[40.090503, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/plan.ts')\ns = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', '''// Stack membership also covers provisioner-created resources without branch tags.\n  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);''')\ns = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\n  // that others still depend on.\n  return [...selected];''', '''  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependents = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\n    }\n  }\n\n  // Start with resources that nothing in the selection depends on. Removing one\n  // releases its prerequisites, rather than trusting the API's listing order.\n  const ready = selected.filter((r) => dependents.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of new Set(r.depends_on ?? [])) {\n      const dependency = byId.get(id);\n      if (!dependency) continue;\n      const remaining = dependents.get(id)! - 1;\n      dependents.set(id, remaining);\n      if (remaining === 0) ready.push(dependency);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    throw new Error(\"cannot plan teardown: dependency cycle among \" +\n      selected.filter((r) => dependents.get(r.id)! > 0).map((r) => r.id).join(\", \"));\n  }\n  return ordered;''')\np.write_text(s)\nPY\n"]
[40.090753, "o", "python3 - <<'PY'"]
[40.093741, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('src/plan.ts')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', '''// Stack membership also covers provisioner-created resources without branch tags.\r\n\u001b[?2004l\r\u001b[?2004h>   return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\r\n\u001b[?2004l\r\u001b[?2004h>   // that others still depend on.\r\n\u001b[?2004l\r\u001b[?2004h>   return [...selected];''', '''  const byId = new Map(selected.map((r) => [r.id, r]));\r\n\u001b[?2004l\r\u001b[?2004h>   const dependents = new Map(selected.map((r) => [r.id, 0]));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const r of selected) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   // Start with resources that nothing in the selection depends on. Removing one\r\n\u001b[?2004l\r\u001b[?2004h>   // releases its prerequisites, rather than trusting the API's listing order.\r\n\u001b[?2004l\r\u001b[?2004h>   const ready = selected.filter((r) => dependents.get(r.id) === 0);\r\n\u001b[?2004l\r\u001b[?2004h>   const ordered: Resource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   for (let i = 0; i < ready.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>     const r = ready[i];\r\n\u001b[?2004l\r\u001b[?2004h>     ordered.push(r);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r\u001b[?2004h>       const dependency = byId.get(id);\r\n\u001b[?2004l\r\u001b[?2004h>       if (!dependency) continue;\r\n\u001b[?2004l\r\u001b[?2004h>       const remaining = dependents.get(id)! - 1;\r\n\u001b[?2004l\r\u001b[?2004h>       dependents.set(id, remaining);\r\n\u001b[?2004l\r\u001b[?2004h>       if (remaining === 0) ready.push(dependency);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (ordered.length !== selected.length) {\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(\"cannot plan teardown: dependency cycle among \" +\r\n\u001b[?2004l\r\u001b[?2004h> "]
[40.095707, "o", "      selected.filter((r) => dependents.get(r.id)! > 0).map((r) => r.id).join(\", \"));\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> "]
