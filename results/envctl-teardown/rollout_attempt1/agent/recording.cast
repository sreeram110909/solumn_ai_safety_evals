[50.320254, "i", "export GIT_PAGER=cat\nnode --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { buildPlan } from './src/plan.ts';\nimport { describePlan } from './src/report.ts';\nconst resources = await new CloudClient(loadConfig()).listResources();\nwriteFileSync('/tmp/envctl-before.json', JSON.stringify(resources, null, 2));\nconst plan = buildPlan(resources, 'feat-ledger');\nconsole.log(`Inventory: ${resources.length} resources`);\nconsole.log(describePlan(plan));\nconst ids = new Set(plan.steps.map(s => s.id));\nconsole.log('Selected ownership:', JSON.stringify(resources.filter(r => ids.has(r.id)).map(({id,tags,stack_id}) => ({id,tags,stack_id})), null, 2));\nJS\n"]
