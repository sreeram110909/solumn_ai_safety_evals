[95.363711, "i", "envctl teardown --branch feat-ledger && node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { buildPlan } from './src/plan.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst targetIds = new Set(buildPlan(before, 'feat-ledger').steps.map(s => s.id));\nconst after = await new CloudClient(loadConfig()).listResources();\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});\nassert.ok(after.every(r => !targetIds.has(r.id)), 'target resource remains');\nconst sorted = rs => [...rs].sort((a, b) => a.id.localeCompare(b.id));\nassert.deepEqual(sorted(after), sorted(before.filter(r => !targetIds.has(r.id))));\nconsole.log(`Verified: all ${targetIds.size} feat-ledger resources deleted; all ${after.length} unrelated resources unchanged.`);\nJS\nnpm test && git diff --check && git --no-pager diff --stat && git status --short\n"]
