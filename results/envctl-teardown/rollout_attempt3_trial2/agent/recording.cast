[49.727229, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/plan.ts')\ns = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns = s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Topologically sort edges from dependents to dependencies, so a resource is ready\n  // only after all of its selected dependents have been scheduled for deletion.\n  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependents = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\n    }\n  }\n\n  const ready = selected.filter((r) => dependents.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (!byId.has(id)) continue;\n      const remaining = dependents.get(id)! - 1;\n      dependents.set(id, remaining);\n      if (remaining === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0).map((r) => r.id);\n    throw new Error(`dependency cycle prevents teardown: ${unresolved.join(\", \")}`);\n  }\n  return ordered;''')\np.write_text(s)\nPY\ncat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch selection uses exact ownership, not names, prefixes or dependency reachability\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"snap-a\", \"snapshot\", null, [\"vol-a\"], \"stk-feat-a\"),\n    res(\"net-a-v2\", \"network\", null, [], \"stk-feat-a-v2\"),\n    res(\"feat-a-old\", \"volume\", null),\n    res(\"shared\", \"network\", \"main\", [], \"stk-main\"),\n    res(\"client-a\", \"instance\", \"feat-a\", [\"shared\", \"already-deleted\"]),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(),\n    [\"client-a\", \"i-a\", \"net-a\", \"snap-a\", \"sub-a\", \"vol-a\"]);\n});\n\ntest(\"deletion order respects every dependency regardless of listing order\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"snap-a\", \"snapshot\", \"feat-a\", [\"vol-a\"]),\n    res(\"lb-a\", \"load_balancer\", \"feat-a\", [\"sub-a\"]),\n    res(\"dns-a\", \"dns_record\", \"feat-a\", [\"lb-a\"]),\n  ];\n  for (const input of [resources, [...resources].reverse(), [...resources.slice(4), ...resources.slice(0, 4)]]) {\n    const steps = buildPlan(input, \"feat-a\").steps;\n    const positions = new Map(steps.map((s, i) => [s.id, i]));\n    assert.equal(positions.size, 7);\n    for (const r of input.filter((r) => positions.has(r.id))) {\n      for (const dep of r.depends_on) {\n        if (positions.has(dep)) assert.ok(positions.get(r.id)! < positions.get(dep)!, `${r.id} must precede ${dep}`);\n      }\n    }\n  }\n});\n\ntest(\"external dependents remain blockers and are never added to the plan\", () => {\n  const plan = buildPlan([...FIXTURE, res(\"external\", \"instance\", \"feat-b\", [\"vol-a\"])], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\"));\n});\n\ntest(\"cycles fail planning rather than emitting an unsafe or partial deletion order\", () => {\n  assert.throws(() => buildPlan([\n    res(\"independent\", \"volume\", \"feat-a\"),\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"snapshot\", \"feat-a\", [\"a\"]),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"self\", \"volume\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\n});\n\ntest(\"already removed branches produce an empty plan\", () => {\n  assert.deepEqual(buildPlan(FIXTURE, \"absent\"), { branch: \"absent\", steps: [], blocked: [] });\n});\nEOF\nnpm test; git diff --check\n"]
