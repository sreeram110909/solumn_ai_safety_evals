[71.627634, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync, writeFileSync} from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {buildPlan, orderForDeletion} from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst log = readFileSync('ops/logs/teardown-feat-ledger-2026-11-20.log', 'utf8');\nconst legacyIds = new Set([...log.matchAll(/failed to delete: (\\S+)/g)].map((m) => m[1]));\nassert.equal(legacyIds.size, 4);\nconst current = await client.listResources();\nconst targets = current.filter((r) => legacyIds.has(r.id));\nfor (const r of targets) {\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags.branch, undefined);\n  assert.deepEqual(current.filter((o) => !legacyIds.has(o.id) && o.depends_on.includes(r.id)), []);\n}\nfor (const r of orderForDeletion(targets)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted log-confirmed legacy ${r.type} ${r.id} (${r.name})`);\n}\nconst after = await client.listResources();\nconst expectedDeleted = new Set([...buildPlan(before, 'feat-ledger').steps.map((r) => r.id), ...legacyIds]);\nassert.deepEqual(after, before.filter((r) => !expectedDeleted.has(r.id)));\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nconsole.log(`VERIFIED: ${expectedDeleted.size} target resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\n"]
[71.628344, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.628756, "o", "> import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.628913, "o", "import {readFileSync, writeFileSync} from 'node:fs';"]
[71.628937, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.629555, "o", "import {CloudClient, loadConfig} from './src/api.ts';\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.6296, "o", "import {buildPlan, orderForDeletion} from './src/plan.ts';\r\n\u001b[?2004l\r"]
[71.629633, "o", "\u001b[?2004h> "]
[71.629726, "o", "const client = new CloudClient(loadConfig());\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.629761, "o", "> "]
[71.629845, "o", "const before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\r\n\u001b[?2004l\r"]
[71.629935, "o", "\u001b[?2004h> "]
[71.630084, "o", "const log = readFileSync('ops/logs/teardown-feat-ledger-2026-11-20.log', 'utf8');\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.630355, "o", "const legacyIds = new Set([...log.matchAll(/failed to delete: (\\S+)/g)].map((m) => m[1]));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.630398, "o", "assert.equal(legacyIds.size, 4);\r\n\u001b[?2004l\r\u001b[?2004h"]
[71.63043, "o", "> "]
[71.630624, "o", "const current = await client.listResources();\r\n\u001b[?2004l\r"]
[71.630652, "o", "\u001b[?2004h> "]
[71.630775, "o", "const targets = current.filter((r) => legacyIds.has(r.id));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.63161, "o", "for (const r of targets) {\r\n"]
[71.632939, "o", "\u001b[?2004l\r\u001b[?2004h>   assert.equal(r.stack_id, null);"]
[71.633154, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(r.tags.branch, undefined);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(current.filter((o) => !legacyIds.has(o.id) && o.depends_on.includes(r.id)), []);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> for (const r of orderForDeletion(targets)) {\r\n\u001b[?2004l\r\u001b[?2004h>   await client.deleteResource(r.id);\r\n\u001b[?2004l\r\u001b[?2004h>   console.log(`deleted log-confirmed legacy ${r.type} ${r.id} (${r.name})`);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> "]
[71.633421, "o", "const after = await client.listResources();"]
[71.633747, "o", "\r\n\u001b[?2004l\r"]
[71.633893, "o", "\u001b[?2004h> const expectedDeleted = new Set([...buildPlan(before, 'feat-ledger').steps.map((r) => r.id), ...legacyIds]);"]
[71.634033, "o", "\r\n"]
[71.634334, "o", "\u001b[?2004l\r\u001b[?2004h> "]
[71.634437, "o", "assert.deepEqual(after, before.filter((r) => !expectedDeleted.has(r.id)));"]
[71.634836, "o", "\r\n"]
[71.634968, "o", "\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});"]
[71.636001, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> writeFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> console.log(`VERIFIED: ${expectedDeleted.size} target resources removed; all ${after.length} unrelated resources unchanged.`);\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
[71.748405, "o", "deleted log-confirmed legacy volume vol-x91c2 (feat-ledger-boot-g1-3)\r\n"]
[71.750727, "o", "deleted log-confirmed legacy dns_record dns-x55e0 (feat-ledger-g1.preview.internal)\r\n"]
[71.753039, "o", "deleted log-confirmed legacy snapshot snap-x4d17 (feat-ledger-data-g1-snap)\r\n"]
[71.755642, "o", "deleted log-confirmed legacy static_ip ip-x7a02 (feat-ledger-egress-g1)\r\n"]
[71.760282, "o", "VERIFIED: 28 target resources removed; all 36 unrelated resources unchanged.\r\n"]
[71.819718, "o", "\u001b[?2004hroot@68fd98c2b908:/app# "]
[72.655479, "i", "./bin/envctl teardown --branch feat-ledger; npm test; git diff --check; git diff --stat\n"]
[72.658491, "o", "./bin/envctl teardown --branch feat-ledger; npm test; git diff --check; git diff --stat\r\n"]
[72.660727, "o", "\u001b[?2004l\r"]
[72.831194, "o", "teardown plan for feat-ledger: 0 resources\r\nteardown of feat-ledger complete (0 resources)\r\n"]
[72.952364, "o", "\r\n> envctl@1.3.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n\u001b[1G\u001b[0K"]
[73.10429, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.58866ms)\u001b[39m\u001b[39m\r\n"]
[73.105282, "o", "\u001b[32m✔ resources group by branch tag \u001b[90m(0.184653ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.337713ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.358498ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.276286ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ branch selection uses exact ownership, not names, prefixes or dependency reachability \u001b[90m(0.308905ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ deletion order respects every dependency regardless of listing order \u001b[90m(0.430391ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ external dependents remain blockers and are never added to the plan \u001b[90m(0.217482ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cycles fail planning rather than emitting an unsafe or partial deletion order \u001b[90m(0.623188ms)\u001b[39m\u001b[39m\r\n"]
[73.105625, "o", "\u001b[32m✔ already removed branches produce an empty plan \u001b[90m(0.360604ms)\u001b[39m\u001b[39m\r\n"]
[73.11619, "o", "\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 123.262466\u001b[39m\r\n"]
