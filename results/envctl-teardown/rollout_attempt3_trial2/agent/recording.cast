[62.008156, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport {buildPlan} from './src/plan.ts';\nconst resources = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst plan = buildPlan(resources, 'feat-ledger');\nassert.deepEqual(plan.blocked, []);\nconst positions = new Map(plan.steps.map((s, i) => [s.id, i]));\nfor (const r of resources.filter((r) => positions.has(r.id))) {\n  for (const dep of r.depends_on) {\n    if (positions.has(dep)) assert.ok(positions.get(r.id) < positions.get(dep));\n  }\n}\nconst log = readFileSync('ops/logs/teardown-feat-ledger-2026-11-20.log', 'utf8');\nconst legacyIds = [...log.matchAll(/failed to delete: (\\S+)/g)].map((m) => m[1]);\nfor (const id of legacyIds) {\n  const r = resources.find((r) => r.id === id);\n  assert.ok(r && r.stack_id === null && !r.tags.branch);\n  assert.deepEqual(resources.filter((r) => r.depends_on.includes(id)), []);\n  console.log('Verified log-confirmed legacy target:', id, r.name);\n}\nconsole.log(`Verified ${plan.steps.length} ordered branch targets and ${legacyIds.length} legacy targets; no blockers.`);\nJS\n"]
