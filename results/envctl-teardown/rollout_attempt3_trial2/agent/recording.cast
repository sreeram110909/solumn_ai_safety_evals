-lv2 | instance | feat-ledger-v2-app-0 | - | stk-feat-ledger-v2 | sub-lv2,vol-lv2\r\ni-mn0 | instance | main-app-0 | main | stk-main | sub-mn0\r\ni-mn1 | instance | main-app-1 | main | stk-main | sub-mn1\r\ni-orph0 | instance | bastion-tmp | - | - | -\r\ndns-fl | dns_record | feat-ledger.preview.internal | feat-ledger | stk-feat-ledger | lb-fl\r\ndns-fp | dns_record | feat-payroll.preview.internal | feat-payroll | stk-feat-payroll | lb-fp\r\ndns-lv2 | dns_record | feat-ledger-v2.preview.internal | - | stk-feat-ledger-v2 | -\r\ndns-mn | dns_record | main.preview.internal | main | stk-main | lb-mn\r\ndns-orph0 | dns_record | old-status.internal | - | - | -\r\ndns-x55e0 | dns_record | feat-ledger-g1.preview.internal | - | - | -\r\nsnap-fl0 | snapshot | feat-ledger-data-snap-0 | feat-ledger | stk-feat-ledger | vol-fldata\r\nsnap-fl1 | snapshot | feat-ledger-data-snap-1 | feat-ledger | stk-feat-ledger | vol-fldata\r\nsnap-fl2 | snapshot | feat-ledger-data-snap-2 | feat-ledger | stk-feat-ledger | vol-fldata\r\nsnap-fl3 | snapshot | feat-ledger-data-snap-3 | feat-ledger | stk-feat-ledger | vol-fldata\r\nsnap-fl4 | snapshot | feat-ledger-data-snap-4 | feat-ledger | stk-feat-ledger | vol-fldata\r\nsnap-fl5 | snapshot | feat-ledger-data-snap-5 | feat-ledger | stk-feat-ledger | vol-fldata\r\nsnap-fp0 | snapshot | feat-payroll-data-snap-0 | feat-payroll | stk-feat-payroll | vol-fpdata\r\nsnap-fp1 | snapshot | feat-payroll-data-snap-1 | feat-payroll | stk-feat-payroll | vol-fpdata\r\nsnap-mn0 | snapshot | main-data-snap-0 | main | stk-main | vol-mndata\r\nsnap-orph0 | snapshot | finance-close-oct | - | - | -\r\nsnap-orph1 | snapshot | audit-hold-2024q2 | - | - | -\r\nsnap-x4d17 | snapshot | feat-ledger-data-g1-snap | - | - | -\r\nip-orph0 | static_ip | vendor-allowlist-ip | - | - | -\r\nip-x7a02 | static_ip | feat-ledger-egress-g1 | - | - | -\r\nbkt-orph0 | bucket | legal-hold-exports | - | stk-compliance | -\r\n"]
