[37.50044, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/plan.ts')\ns = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\n  // that others still depend on.\n  return [...selected];''', '''  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const dependency of r.depends_on ?? []) {\n      if (byId.has(dependency)) {\n        dependentCounts.set(dependency, dependentCounts.get(dependency)! + 1);\n      }\n    }\n  }\n\n  // Start at the leaves: removing a dependent makes its dependencies eligible.\n  // Dependencies outside this selection are never added to the deletion queue.\n  const ready = selected.filter((r) => dependentCounts.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const dependency of r.depends_on ?? []) {\n      if (!byId.has(dependency)) continue;\n      const remaining = dependentCounts.get(dependency)! - 1;\n      dependentCounts.set(dependency, remaining);\n      if (remaining === 0) ready.push(byId.get(dependency)!);\n    }\n  }\n\n  if (ordered.length !== selected.length) {\n    const stuck = selected.filter((r) => dependentCounts.get(r.id)! > 0).map((r) => r.id);\n    throw new Error(`cannot order teardown: dependency cycle involving ${stuck.join(\", \")}`);\n  }\n  return ordered;''')\np.write_text(s)\np = Path('test/plan.test.ts')\ns = p.read_text().replace('import { buildPlan }', 'import { buildPlan, orderForDeletion }')\ns += '''\n\ntest(\"branch selection uses exact tags or stack IDs, not name prefixes\", () => {\n  const resources = [\n    res(\"tagged\", \"volume\", \"feat-a\"),\n    res(\"stack-only\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"feat-a-legacy\", \"volume\", null),\n    res(\"other-stack\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"other-tag\", \"volume\", \"feat-a-v2\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id), [\"tagged\", \"stack-only\"]);\n});\n\ntest(\"deletion order handles shared dependencies in arbitrary listing order without mutation\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"network\", \"network\", \"feat-a\"),\n    res(\"instance\", \"instance\", \"feat-a\", [\"subnet\", \"volume\", \"external\"]),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"network\"]),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"subnet\"]),\n  ];\n  const before = structuredClone(resources);\n  const ordered = orderForDeletion(resources);\n  assert.deepEqual(resources, before);\n  assert.deepEqual(new Set(ordered.map((r) => r.id)), new Set(resources.map((r) => r.id)));\n  const pos = new Map(ordered.map((r, i) => [r.id, i]));\n  for (const r of resources) {\n    for (const dependency of r.depends_on) {\n      if (pos.has(dependency)) assert.ok(pos.get(r.id)! < pos.get(dependency)!, `${r.id} before ${dependency}`);\n    }\n  }\n});\n\ntest(\"plan reports external dependents without selecting them or external dependencies\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"instance\", \"instance\", \"feat-a\", [\"volume\", \"shared-network\"]),\n    res(\"foreign-snapshot\", \"snapshot\", \"feat-b\", [\"volume\"]),\n    res(\"shared-network\", \"network\", \"main\"),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.steps.map((s) => s.id), [\"instance\", \"volume\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"volume\", dependents: [\"foreign-snapshot\"] }]);\n});\n\ntest(\"empty plans are safe and cycles fail before any deletion\", () => {\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\"), { branch: \"missing\", steps: [], blocked: [] });\n  assert.throws(() => orderForDeletion([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"snapshot\", \"feat-a\", [\"a"]
[37.500911, "i", "\"]),\n  ]), /dependency cycle.*a, b/);\n  assert.throws(() => orderForDeletion([res(\"self\", \"volume\", \"feat-a\", [\"self\"])]), /dependency cycle.*self/);\n});\n'''\np.write_text(s)\nPY\nnpm test\n"]
