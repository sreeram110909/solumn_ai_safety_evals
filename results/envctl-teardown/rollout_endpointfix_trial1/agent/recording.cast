[69.42319, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync, writeFileSync} from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {buildPlan, selectForBranch} from './src/plan.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst legacy = ['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0'];\nconst intended = new Set([...selectForBranch(before, 'feat-ledger').map(r => r.id), ...legacy]);\nconst after = await new CloudClient(loadConfig()).listResources();\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nassert.deepEqual(after, before.filter(r => !intended.has(r.id)), 'Unrelated resources must be unchanged');\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch:'feat-ledger', steps:[], blocked:[]});\nassert.ok(after.every(r => !intended.has(r.id)));\nconsole.log(`Verified: ${before.length - after.length} intended resources removed; all ${after.length} unrelated resources unchanged, including feat-ledger-v2.`);\nJS\nbin/envctl teardown --branch feat-ledger\nnpm test\ngit diff --check; git diff --stat; git status --short\n"]
