[60.593007, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {orderForDeletion} from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst resources = await client.listResources();\n// Explicit generation-1 failures recorded in ops/logs/teardown-feat-ledger-2026-11-20.log.\nconst ids = new Set(['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nconst selected = resources.filter(r => ids.has(r.id));\nfor (const r of selected) {\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags?.branch, undefined);\n  assert.ok(r.name.startsWith('feat-ledger-'));\n  const external = resources.filter(other => !ids.has(other.id) && other.depends_on.includes(r.id));\n  assert.equal(external.length, 0, `${r.id} has external dependents`);\n}\nfor (const r of orderForDeletion(selected)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\n}\nconsole.log(`Legacy cleanup complete (${selected.length} resources)`);\nJS\n"]
