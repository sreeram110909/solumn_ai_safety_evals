[90.28658, "o", "\u001b[1mdiff --git a/README.md b/README.md\u001b[m\r\n"]
[90.286757, "o", "\u001b[1mindex 3c120d9..9219749 100644\u001b[m\r\n\u001b[1m--- a/README.md\u001b[m\r\n\u001b[1m+++ b/README.md\u001b[m\r\n\u001b[36m@@ -10,7 +10,10 @@\u001b[m \u001b[mgets a stack `stk-<branch>` with its own network, instances, load balancer and D\u001b[m\r\n     envctl gc --untagged [--yes]         # delete untagged resources\u001b[m\r\n \u001b[m\r\n `plan --json` prints `{\"branch\", \"steps\": [{\"id\", \"type\", \"name\"}], \"blocked\": [...]}` with\u001b[m\r\n\u001b[31m-`steps` in deletion order.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m`steps` in deletion order (dependents before their prerequisites). Selection includes both\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mresources tagged with the branch and resources in its exact `stk-<branch>` stack,\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mincluding untagged boot volumes. External dependents block teardown; dependency\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mcycles fail planning before any resources are deleted.\u001b[m\r\n \u001b[m\r\n Credentials come from `ENVCTL_TOKEN` or `~/.envctl/credentials` (`token = ...`); the API URL\u001b[m\r\n from `ENVCTL_API` (default `http://127.0.0.1:8900`). API reference: `docs/cloud-api.md`.\u001b[m\r\n\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex 74615fc..0e92d68 100644\u001b[m\r\n"]
[90.287422, "o", "\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -18,13 +18,36 @@\u001b[m \u001b[mexport interface TeardownPlan {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function selectForBranch(resources: Resource[], branch: string): Resource[] {\u001b[m\r\n\u001b[31m-  return resources.filter((r) => branchOf(r) === branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function orderForDeletion(selected: Resource[]): Resource[] {\u001b[m\r\n\u001b[31m-  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\u001b[m\r\n\u001b[31m-  // that others still depend on.\u001b[m\r\n\u001b[31m-  return [...selected];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Edges point from dependents to prerequisites: delete nodes with no remaining\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // dependents first. Only edges within the selection affect this ordering.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const byId = new Map(selected.map((r) => [r.id, r]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const r of selected) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of new Set(r.depends_on ?? [])) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (byId.has(id)) dependentCounts.set(id, dependentCounts.get(id)! + 1);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ready = selected.filter((r) => dependentCounts.get(r.id) === 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ordered: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (let i = 0; i < ready.length; i++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const r = ready[i];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ordered.push(r);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of new Set(r.depends_on ?? [])) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!byId.has(id)) continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const count = dependentCounts.get(id)! - 1;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      dependentCounts.set(id, count);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (count === 0) ready.push(byId.get(id)!);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ordered.length !== selected.length) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const cyclic = selected.filter((r) => dependentCounts.get(r.id)! > 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new Error(`cannot plan teardown: dependency cycle involving ${cyclic.map((r) => r.id).join(\", \")}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return ordered;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildPlan(resources: Resource[], branch: string): TeardownPlan {\u001b[m\r\n"]
[90.290482, "o", " \u001b[31mM\u001b[m README.md\r\n \u001b[31mM\u001b[m src/plan.ts\r\n \u001b[31mM\u001b[m test/plan.test.ts\r\n"]
