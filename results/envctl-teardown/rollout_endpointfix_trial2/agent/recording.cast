[85.129576, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {CloudClient,loadConfig} from './src/api.ts';\nimport {buildPlan} from './src/plan.ts';\nconst before=JSON.parse(readFileSync('/tmp/envctl-before.json','utf8'));\nconst legacy=new Set(['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nconst targeted=r=>r.tags.branch==='feat-ledger'||r.stack_id==='stk-feat-ledger'||legacy.has(r.id);\nconst expected=before.filter(r=>!targeted(r));\nconst after=await new CloudClient(loadConfig()).listResources();\nwriteFileSync('/tmp/envctl-after.json',JSON.stringify(after,null,2));\nassert.deepEqual(after,expected,'Unrelated resources must remain unchanged');\nassert.deepEqual(buildPlan(after,'feat-ledger'),{branch:'feat-ledger',steps:[],blocked:[]});\nconsole.log(`Verified ${before.length-after.length} target resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\nenvctl teardown --branch feat-ledger\nnpm test\ngit diff --check; git diff --stat; git status --short\n"]
