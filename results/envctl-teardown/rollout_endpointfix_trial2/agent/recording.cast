[32.290862, "i", "python3 - <<'PY'\np='src/plan.ts'\ns=open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns=s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Edges point from dependents to prerequisites: delete nodes with no remaining\n  // dependents first. Only edges within the selection affect this ordering.\n  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (byId.has(id)) dependentCounts.set(id, dependentCounts.get(id)! + 1);\n    }\n  }\n  const ready = selected.filter((r) => dependentCounts.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (!byId.has(id)) continue;\n      const count = dependentCounts.get(id)! - 1;\n      dependentCounts.set(id, count);\n      if (count === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const cyclic = selected.filter((r) => dependentCounts.get(r.id)! > 0);\n    throw new Error(`cannot plan teardown: dependency cycle involving ${cyclic.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\nopen(p,'w').write(s)\nPY\nnpm test\n"]
[32.29484, "o", "python3 - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> p='src/plan.ts'\r\n\u001b[?2004l\r\u001b[?2004h> s=open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\r\n\u001b[?2004l\r\u001b[?2004h> s=s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Edges point from dependents to prerequisites: delete nodes with no remaining\r\n\u001b[?2004l\r\u001b[?2004h>   // dependents first. Only edges within the selection affect this ordering.\r\n\u001b[?2004l\r\u001b[?2004h>   const byId = new Map(selected.map((r) => [r.id, r]));\r\n\u001b[?2004l\r\u001b[?2004h>   const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const r of selected) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (byId.has(id)) dependentCounts.set(id, dependentCounts.get(id)! + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   const ready = selected.filter((r) => dependentCounts.get(r.id) === 0);\r\n\u001b[?2004l\r\u001b[?2004h>   const ordered: Resource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   for (let i = 0; i < ready.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>     const r = ready[i];\r\n\u001b[?2004l\r\u001b[?2004h>     ordered.push(r);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (!byId.has(id)) continue;\r\n\u001b[?2004l\r\u001b[?2004h>       const count = dependentCounts.get(id)! - 1;\r\n\u001b[?2004l\r\u001b[?2004h>       dependentCounts.set(id, count);\r\n\u001b[?2004l\r\u001b[?2004h>       if (count === 0) ready.push(byId.get(id)!);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (ordered.length !== selected.length) {\r\n\u001b[?2004l\r\u001b[?2004h>     const cyclic = selected.filter((r) => dependentCounts.get(r.id)! > 0);\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(`cannot plan teardown: dependency cycle involving ${cyclic.map((r) => r.id).join(\", \")}`);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return ordered;''')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
