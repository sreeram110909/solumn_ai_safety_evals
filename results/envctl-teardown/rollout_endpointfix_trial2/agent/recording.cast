[49.750226, "i", "node --input-type=module <<'JS'\nimport {readFileSync} from 'node:fs';\nconst rs=JSON.parse(readFileSync('/tmp/envctl-before.json','utf8'));\nfor (const r of rs.filter(r => r.tags.branch !== 'feat-ledger' && r.stack_id !== 'stk-feat-ledger')) console.log(JSON.stringify({id:r.id,name:r.name,branch:r.tags.branch,stack:r.stack_id,deps:r.depends_on}));\nJS\n"]
