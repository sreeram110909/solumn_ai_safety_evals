[48.792936, "i", "cat >> test/plan.test.ts <<'EOF'\n\ntest(\"plan selects exact branch tags or stack IDs, not names or prefixes\", () => {\n  const resources = [\n    res(\"tagged\", \"volume\", \"feat-a\"),\n    res(\"stack-only\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"feat-a-unowned\", \"volume\", null),\n    res(\"other-stack\", \"volume\", null, [], \"stk-feat-ab\"),\n    res(\"other-branch\", \"volume\", \"feat-ab\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id), [\"tagged\", \"stack-only\"]);\n});\n\ntest(\"deletion order handles shuffled graphs, shared dependencies and missing prerequisites\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"network\", \"network\", \"feat-a\"),\n    res(\"instance\", \"instance\", \"feat-a\", [\"subnet\", \"volume\", \"external\"]),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"network\"]),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"subnet\"]),\n  ];\n  for (const input of [resources, [...resources].reverse()]) {\n    const before = structuredClone(input);\n    const ids = buildPlan(input, \"feat-a\").steps.map((s) => s.id);\n    assert.equal(new Set(ids).size, resources.length);\n    for (const r of resources) {\n      for (const dep of r.depends_on.filter((id) => ids.includes(id))) {\n        assert.ok(ids.indexOf(r.id) < ids.indexOf(dep), `${r.id} must precede ${dep}`);\n      }\n    }\n    assert.deepEqual(input, before);\n  }\n  assert.deepEqual(buildPlan([], \"feat-a\").steps, []);\n});\n\ntest(\"external dependents block stack-owned resources without being selected\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"instance\", \"instance\", \"feat-b\", [\"volume\"], \"stk-feat-b\"),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.steps.map((s) => s.id), [\"volume\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"volume\", dependents: [\"instance\"] }]);\n});\n\ntest(\"cycles fail planning instead of returning an unsafe deletion order\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"snapshot\", \"feat-a\", [\"a\"]),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"self\", \"volume\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\n});\nEOF\npython3 - <<'PY'\np='README.md'\ns=open(p).read().replace('`steps` in deletion order.', '''`steps` in deletion order (dependents before their prerequisites). Selection includes both\nresources tagged with the branch and resources in its exact `stk-<branch>` stack,\nincluding untagged boot volumes. External dependents block teardown; dependency\ncycles fail planning before any resources are deleted.''')\nopen(p,'w').write(s)\nPY\nnpm test; git diff --check; envctl teardown --branch feat-ledger --dry-run\n"]
