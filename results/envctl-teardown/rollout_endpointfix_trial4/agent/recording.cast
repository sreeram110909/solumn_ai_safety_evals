[43.535361, "i", "python3 - <<'PY'\np='src/plan.ts'\ns=open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);','return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns=s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\n  // that others still depend on.\n  return [...selected];''','''  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (byId.has(id)) dependentCounts.set(id, dependentCounts.get(id)! + 1);\n    }\n  }\n\n  // Start with leaves (nothing selected depends on them). Preserve listing order\n  // among initially independent resources, then release prerequisites as we go.\n  const ready = selected.filter((r) => dependentCounts.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (!byId.has(id)) continue;\n      const remaining = dependentCounts.get(id)! - 1;\n      dependentCounts.set(id, remaining);\n      if (remaining === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependentCounts.get(r.id)! > 0);\n    throw new Error(`dependency cycle prevents teardown: ${unresolved.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\nopen(p,'w').write(s)\np='test/plan.test.ts'\ns=open(p).read().replace('import { buildPlan }','import { buildPlan, orderForDeletion }')\ns+='''\n\ntest(\"selection uses exact branch tags or stack IDs, not names or stack prefixes\", () => {\n  const resources = [\n    res(\"tagged\", \"volume\", \"feat-a\"),\n    res(\"stack-only\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"other-stack\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"other-tag\", \"volume\", \"feat-a-v2\"),\n    res(\"feat-a-old-volume\", \"volume\", null),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((r) => r.id), [\"tagged\", \"stack-only\"]);\n});\n\ntest(\"deletion order handles shuffled graphs, shared dependencies and disconnected resources\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"subnet\", \"volume\", \"outside\"]),\n    res(\"network\", \"network\", \"feat-a\"),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"subnet\"]),\n    res(\"independent\", \"bucket\", \"feat-a\"),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"network\"]),\n  ];\n  const before = structuredClone(resources);\n  const ordered = orderForDeletion(resources);\n  const pos = new Map(ordered.map((r, i) => [r.id, i]));\n  assert.equal(ordered.length, resources.length);\n  assert.equal(pos.size, resources.length);\n  for (const r of resources) {\n    for (const dependency of r.depends_on) {\n      if (pos.has(dependency)) assert.ok(pos.get(r.id)! < pos.get(dependency)!);\n    }\n  }\n  assert.deepEqual(resources, before);\n});\n\ntest(\"plans retain outside dependents as blockers without selecting them\", () => {\n  const resources = [...FIXTURE, res(\"external\", \"snapshot\", \"feat-b\", [\"vol-a\"])];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\"));\n});\n\ntest(\"dependency cycles fail planning rather than producing an unsafe partial order\", () => {\n  assert.throws(() => orderForDeletion([\n    res(\"independent\", \"volume\", \"feat-a\"),\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\n  ]), /dependency cycle/);\n  assert.throws(() => orderForDeletion([res(\"self\", \"volume\", \"feat-a\", [\"self\"])]), /dependency cycle/);\n});\n\ntest(\"empty and already-deleted branches have empty plans\", () => {\n  assert.deepEqual(orderForDeletion([]), []);\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\"), { branch: \"missing\", steps: [], blo"]
[43.535606, "i", "cked: [] });\n});\n'''\nopen(p,'w').write(s)\nPY\nnpm test\n"]
