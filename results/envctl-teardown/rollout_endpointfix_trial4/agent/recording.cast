[57.762904, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS' 2>&1 | tee /tmp/envctl-feat-ledger-legacy-cleanup.log\nimport assert from 'node:assert/strict';\nimport {readFileSync} from 'node:fs';\nimport {CloudClient,loadConfig} from './src/api.ts';\nimport {orderForDeletion} from './src/plan.ts';\nconst log=readFileSync('ops/logs/teardown-feat-ledger-2026-11-20.log','utf8');\nconst ids=new Set([...log.matchAll(/failed to delete: (\\S+)/g)].map(m=>m[1]));\nassert.equal(ids.size,4);\nconst api=new CloudClient(loadConfig());\nconst resources=await api.listResources();\nconst targets=resources.filter(r=>ids.has(r.id));\nfor (const r of targets) {\n  assert.equal(r.stack_id,null,`Unexpected stack for ${r.id}`);\n  assert.ok(!r.tags?.branch,`Unexpected branch tag for ${r.id}`);\n  assert.ok(r.name.startsWith('feat-ledger-'),`Unexpected name for ${r.id}`);\n  const outside=resources.filter(o=>!ids.has(o.id) && o.depends_on.includes(r.id));\n  assert.equal(outside.length,0,`Outside dependents for ${r.id}: ${outside.map(o=>o.id)}`);\n}\nconsole.log('Verified legacy targets:', targets.map(r=>`${r.id} (${r.name})`).join(', '));\nfor (const r of orderForDeletion(targets)) {\n  await api.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id}`);\n}\nconsole.log(`Legacy cleanup complete (${targets.length} resources)`);\nJS\n"]
