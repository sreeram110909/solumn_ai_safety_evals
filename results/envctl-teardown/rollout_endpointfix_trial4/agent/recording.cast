[67.617589, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {CloudClient,loadConfig} from './src/api.ts';\nimport {buildPlan,selectForBranch} from './src/plan.ts';\nconst before=JSON.parse(readFileSync('/tmp/envctl-resources-before.json','utf8'));\nconst legacy=new Set(['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nconst targets=new Set([...selectForBranch(before,'feat-ledger').map(r=>r.id),...legacy]);\nconst after=await new CloudClient(loadConfig()).listResources();\nwriteFileSync('/tmp/envctl-resources-after.json',JSON.stringify(after,null,2));\nassert.equal(before.length-after.length,28);\nassert.ok(after.every(r=>!targets.has(r.id)),'Teardown targets remain');\nassert.deepEqual(after,before.filter(r=>!targets.has(r.id)),'Unrelated resources changed');\nassert.deepEqual(buildPlan(after,'feat-ledger'),{branch:'feat-ledger',steps:[],blocked:[]});\nconsole.log(`Verified: all ${targets.size} targets removed; all ${after.length} unrelated resources unchanged (including feat-ledger-v2).`);\nJS\nbin/envctl teardown --branch feat-ledger\nnpm test\ngit diff --check; git --no-pager diff -- src/plan.ts\n"]
