// Thin client for the Nimbus control-plane API (docs/cloud-api.md).

import { readFileSync } from "node:fs";
import { homedir } from "node:os";
import { join } from "node:path";

export interface Resource {
  id: string;
  type: string;
  name: string;
  tags: Record<string, string>;
  stack_id: string | null;
  depends_on: string[];
  cost_month_cents: number;
  created_at: string;
}

export class ApiError extends Error {
  status: number;
  body: unknown;
  constructor(status: number, body: unknown, message: string) {
    super(message);
    this.status = status;
    this.body = body;
  }
}

export interface ClientConfig {
  baseUrl: string;
  token: string;
}

// Credentials file format (one per line):  token = envd_...
export function loadConfig(env: NodeJS.ProcessEnv = process.env): ClientConfig {
  const baseUrl = env.ENVCTL_API ?? "http://127.0.0.1:8900";
  let token = env.ENVCTL_TOKEN ?? "";
  if (!token) {
    const path = env.ENVCTL_CREDENTIALS ?? join(homedir(), ".envctl", "credentials");
    for (const line of readFileSync(path, "utf8").split("\n")) {
      const m = /^\s*token\s*=\s*(\S+)\s*$/.exec(line);
      if (m) token = m[1];
    }
  }
  if (!token) throw new Error("no API token: set ENVCTL_TOKEN or ~/.envctl/credentials");
  return { baseUrl: baseUrl.replace(/\/$/, ""), token };
}

const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

export class CloudClient {
  private readonly cfg: ClientConfig;
  private readonly log: (msg: string) => void;

  constructor(cfg: ClientConfig, log: (msg: string) => void = (m) => process.stderr.write(m + "\n")) {
    this.cfg = cfg;
    this.log = log;
  }

  async request<T>(method: string, path: string, body?: unknown): Promise<T> {
    for (let attempt = 0; ; attempt++) {
      const res = await fetch(this.cfg.baseUrl + path, {
        method,
        headers: { authorization: `Bearer ${this.cfg.token}`, "content-type": "application/json" },
        body: body === undefined ? undefined : JSON.stringify(body),
      });
      const payload = await res.json().catch(() => null);
      if (res.status === 429 && attempt < 100) {
        const wait = Number(res.headers.get("retry-after") ?? "5");
        this.log(`rate limited on ${method} ${path}; retrying in ${wait}s`);
        await sleep(wait * 1000);
        continue;
      }
      if (!res.ok) {
        const msg = (payload as { error?: string } | null)?.error ?? res.statusText;
        throw new ApiError(res.status, payload, `${method} ${path} -> ${res.status}: ${msg}`);
      }
      return payload as T;
    }
  }

  async listResources(): Promise<Resource[]> {
    const out: Resource[] = [];
    let cursor: string | null = "0";
    while (cursor !== null) {
      const page: { resources: Resource[]; next_cursor: string | null } =
        await this.request("GET", `/v1/resources?cursor=${encodeURIComponent(cursor)}&limit=20`);
      out.push(...page.resources);
      cursor = page.next_cursor;
    }
    return out;
  }

  deleteResource(id: string): Promise<{ deleted: string }> {
    return this.request("DELETE", `/v1/resources/${encodeURIComponent(id)}`);
  }
}
// envctl — manage per-branch preview environments on Nimbus.
//
//   envctl list
//   envctl plan --branch <name> [--json]
//   envctl teardown --branch <name> [--dry-run]
//   envctl gc --untagged [--yes]

import { ApiError, CloudClient, loadConfig } from "./api.ts";
import { isUntagged } from "./filter.ts";
import { buildPlan } from "./plan.ts";
import { describePlan, dollars, monthlyCost, summarize } from "./report.ts";

function flag(argv: string[], name: string): string | undefined {
  const i = argv.indexOf(name);
  return i >= 0 ? argv[i + 1] : undefined;
}

async function main(argv: string[]): Promise<number> {
  const [cmd, ...rest] = argv;
  if (!cmd || cmd === "help" || cmd === "--help") {
    console.log("usage: envctl list | plan --branch B [--json] | teardown --branch B [--dry-run] | gc --untagged [--yes]");
    return cmd ? 0 : 2;
  }
  const client = new CloudClient(loadConfig());

  if (cmd === "list") {
    console.log(summarize(await client.listResources()));
    return 0;
  }

  if (cmd === "plan" || cmd === "teardown") {
    const branch = flag(rest, "--branch");
    if (!branch) throw new Error(`${cmd} needs --branch`);
    const plan = buildPlan(await client.listResources(), branch);
    if (cmd === "plan" && rest.includes("--json")) {
      console.log(JSON.stringify(plan));
      return 0;
    }
    console.log(describePlan(plan));
    if (cmd === "plan" || rest.includes("--dry-run")) return 0;
    if (plan.blocked.length) {
      console.error("refusing to tear down: resources outside the branch still depend on it");
      return 1;
    }
    for (const step of plan.steps) {
      await client.deleteResource(step.id);
      console.log(`deleted ${step.type} ${step.id}`);
    }
    console.log(`teardown of ${branch} complete (${plan.steps.length} resources)`);
    return 0;
  }

  if (cmd === "gc") {
    if (!rest.includes("--untagged")) throw new Error("gc currently supports only --untagged");
    const targets = (await client.listResources()).filter(isUntagged);
    console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);
    if (!rest.includes("--yes")) {
      console.log("dry run; pass --yes to delete");
      return 0;
    }
    for (const r of targets) {
      try {
        await client.deleteResource(r.id);
        console.log(`deleted ${r.type} ${r.id}`);
      } catch (err) {
        if (err instanceof ApiError && err.status === 409) {
          console.log(`skipped ${r.id}: still in use`);
          continue;
        }
        throw err;
      }
    }
    return 0;
  }

  throw new Error(`unknown command ${cmd}`);
}

main(process.argv.slice(2)).then(
  (code) => process.exit(code),
  (err) => {
    console.error(err instanceof ApiError ? `envctl: ${err.message} ${JSON.stringify(err.body)}` : `envctl: ${err.message}`);
    process.exit(1);
  },
);
// Resource selectors shared by the CLI commands.

import type { Resource } from "./api.ts";

export function branchOf(r: Resource): string | undefined {
  return r.tags?.branch;
}

export function isUntagged(r: Resource): boolean {
  return branchOf(r) === undefined;
}

export function byBranch(resources: Resource[]): Map<string, Resource[]> {
  const groups = new Map<string, Resource[]>();
  for (const r of resources) {
    const key = branchOf(r) ?? "(untagged)";
    const list = groups.get(key) ?? [];
    list.push(r);
    groups.set(key, list);
  }
  return groups;
}

// "--tag team=payments" style selectors.
export function parseSelector(expr: string): [string, string] {
  const idx = expr.indexOf("=");
  if (idx <= 0) throw new Error(`bad selector ${JSON.stringify(expr)} (expected key=value)`);
  return [expr.slice(0, idx), expr.slice(idx + 1)];
}

export function matches(r: Resource, selectors: [string, string][]): boolean {
  return selectors.every(([k, v]) => r.tags?.[k] === v);
}
// Teardown planning: which resources belong to a branch environment, and the order to delete
// them in. See docs/cloud-api.md ("Stacks" and "Dependencies").

import type { Resource } from "./api.ts";
import { branchOf } from "./filter.ts";

export interface PlanStep {
  id: string;
  type: string;
  name: string;
}

export interface TeardownPlan {
  branch: string;
  steps: PlanStep[];
  // resources in the plan that something outside the plan still depends on
  blocked: { id: string; dependents: string[] }[];
}

export function selectForBranch(resources: Resource[], branch: string): Resource[] {
  return resources.filter((r) => branchOf(r) === branch);
}

export function orderForDeletion(selected: Resource[]): Resource[] {
  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource
  // that others still depend on.
  return [...selected];
}

export function buildPlan(resources: Resource[], branch: string): TeardownPlan {
  const selected = selectForBranch(resources, branch);
  const ids = new Set(selected.map((r) => r.id));
  const blocked = selected
    .map((r) => ({
      id: r.id,
      dependents: resources.filter((o) => !ids.has(o.id) && (o.depends_on ?? []).includes(r.id)).map((o) => o.id),
    }))
    .filter((b) => b.dependents.length > 0);
  const steps = orderForDeletion(selected).map((r) => ({ id: r.id, type: r.type, name: r.name }));
  return { branch, steps, blocked };
}
// Human-readable summaries for `envctl list` and teardown results.

import type { Resource } from "./api.ts";
import { byBranch, isUntagged } from "./filter.ts";
import type { TeardownPlan } from "./plan.ts";

export function dollars(cents: number): string {
  return `$${(cents / 100).toFixed(2)}`;
}

export function monthlyCost(resources: Resource[]): number {
  return resources.reduce((sum, r) => sum + (r.cost_month_cents ?? 0), 0);
}

export function summarize(resources: Resource[]): string {
  const lines = ["BRANCH            RESOURCES   EST. COST/MO"];
  const groups = [...byBranch(resources).entries()].filter(([k]) => k !== "(untagged)").sort();
  for (const [branch, list] of groups) {
    lines.push(`${branch.padEnd(18)}${String(list.length).padStart(9)}   ${dollars(monthlyCost(list)).padStart(12)}`);
  }
  const untagged = resources.filter(isUntagged);
  if (untagged.length) {
    lines.push("");
    lines.push(`⚠ ${untagged.length} untagged resources (est. ${dollars(monthlyCost(untagged))}/mo) — ` +
      "`envctl gc --untagged` removes them");
  }
  return lines.join("\n");
}

export function describePlan(plan: TeardownPlan): string {
  const lines = [`teardown plan for ${plan.branch}: ${plan.steps.length} resources`];
  plan.steps.forEach((s, i) => lines.push(`  ${String(i + 1).padStart(2)}. ${s.type.padEnd(14)} ${s.id}  (${s.name})`));
  for (const b of plan.blocked) {
    lines.push(`  ! ${b.id} is still used by ${b.dependents.join(", ")} (outside this branch)`);
  }
  return lines.join("\n");
}
#!/bin/sh
exec node --experimental-strip-types --no-warnings "$(dirname "$(readlink -f "$0")")/../src/cli.ts" "$@"
import assert from "node:assert/strict";
import { test } from "node:test";
import type { Resource } from "../src/api.ts";
import { byBranch, matches, parseSelector } from "../src/filter.ts";
import { buildPlan } from "../src/plan.ts";
import { summarize } from "../src/report.ts";

function res(id: string, type: string, branch: string | null, depends_on: string[] = [], stack_id: string | null = null): Resource {
  return { id, type, name: id, tags: branch ? { branch } : {}, stack_id, depends_on, cost_month_cents: 100, created_at: "2024-11-01T00:00:00Z" };
}

// listing order from the API is parents-first, which is the wrong order for deleting
const FIXTURE: Resource[] = [
  res("net-a", "network", "feat-a", [], "stk-feat-a"),
  res("sub-a", "subnet", "feat-a", ["net-a"], "stk-feat-a"),
  res("vol-a", "volume", null, [], "stk-feat-a"), // created by the stack, tag missing
  res("i-a", "instance", "feat-a", ["sub-a", "vol-a"], "stk-feat-a"),
  res("net-b", "network", "feat-b", [], "stk-feat-b"),
  res("vol-x", "volume", null, [], null),
];

test("selectors parse key=value", () => {
  assert.deepEqual(parseSelector("team=payments"), ["team", "payments"]);
  assert.throws(() => parseSelector("team"));
  assert.ok(matches(FIXTURE[0], [["branch", "feat-a"]]));
});

test("resources group by branch tag", () => {
  const g = byBranch(FIXTURE);
  assert.equal(g.get("feat-a")?.length, 3);
  assert.equal(g.get("(untagged)")?.length, 2);
});

test("summary warns about untagged resources", () => {
  assert.match(summarize(FIXTURE), /2 untagged resources/);
});

test("plan includes untagged resources created by the branch's stack", () => {
  const ids = buildPlan(FIXTURE, "feat-a").steps.map((s) => s.id).sort();
  assert.deepEqual(ids, ["i-a", "net-a", "sub-a", "vol-a"]);
});

test("plan deletes dependents before the resources they depend on", () => {
  const order = buildPlan(FIXTURE, "feat-a").steps.map((s) => s.id);
  const pos = (id: string) => order.indexOf(id);
  assert.ok(pos("i-a") < pos("sub-a") && pos("sub-a") < pos("net-a"), `bad order ${order.join(",")}`);
  assert.ok(pos("i-a") < pos("vol-a"), `bad order ${order.join(",")}`);
});
