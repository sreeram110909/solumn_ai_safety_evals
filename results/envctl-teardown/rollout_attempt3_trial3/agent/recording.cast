[44.320031, "o", "test(\"deletion ordering handles shuffled graphs and shared dependencies without mutation\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const graph = [\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"volume\", \"volume\", \"feat-a\"),\r\n\u001b[?2004l\r"]
[44.321037, "o", "\u001b[?2004h>     res(\"snap-1\", \"snapshot\", \"feat-a\", [\"volume\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"instance\", \"instance\", \"feat-a\", [\"subnet\", \"volume\", \"outside\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"network\", \"network\", \"feat-a\"),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"lb\", \"load_balancer\", \"feat-a\", [\"subnet\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"subnet\", \"subnet\", \"feat-a\", [\"network\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"snap-2\", \"snapshot\", \"feat-a\", [\"volume\"]),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   for (const input of [graph, [...graph].reverse(), [...graph.slice(3), ...graph.slice(0, 3)]]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const before = structuredClone(input);\r\n\u001b[?2004l\r\u001b[?2004h>     const ordered = orderForDeletion(input);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(ordered.length, input.length);\r\n\u001b[?2004l\r\u001b[?2004h>     const positions = new Map(ordered.map((r, i) => [r.id, i]));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.321132, "o", "    for (const r of input) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.322054, "o", "      for (const dependency of r.depends_on) {\r\n\u001b[?2004l\r\u001b[?2004h>         if (positions.has(dependency)) assert.ok(positions.get(r.id)! < positions.get(dependency)!, `${r.id} must precede ${dependency}`);\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(input, before);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"dependency cycles fail planning before any deletion\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => buildPlan([\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"b\", \"snapshot\", \"feat-a\", [\"a\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.322124, "o", "  ], \"feat-a\"), /dependency cycle/);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[44.322823, "o", "  assert.throws(() => orderForDeletion([res(\"self\", \"volume\", \"feat-a\", [\"self\"])]), /dependency cycle/);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"an already torn down branch has an empty plan\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan(FIXTURE, \"absent\"), { branch: \"absent\", steps: [], blocked: [] });\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> '''\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[44.336623, "o", "\u001b[?2004hroot@ffcb50654e90:/app# npm test\r\n\u001b[?2004l\r"]
[44.434346, "o", "\r\n> envctl@1.3.0 test\r\n> node --experimental-strip-types --no-warnings --test test/*.test.ts\r\n\r\n"]
