[16.974068, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {writeFileSync} from 'node:fs';\nconst client = new CloudClient(loadConfig());\nconsole.log('Identity:', await client.request('GET', '/v1/whoami'));\nconst resources = await client.listResources();\nwriteFileSync('/tmp/envctl-resources-before.json', JSON.stringify(resources, null, 2));\nconsole.log('Resources:', resources.length);\nfor (const r of resources) console.log(JSON.stringify(r));\nJS\n"]
