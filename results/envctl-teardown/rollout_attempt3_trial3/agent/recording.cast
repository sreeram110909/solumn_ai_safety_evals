[78.08526, "o", "\u001b[0K"]
[78.258006, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(2.271742ms)\u001b[39m\u001b[39m\r\n"]
[78.258747, "o", "\u001b[32m✔ resources group by branch tag \u001b[90m(0.313587ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.623843ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.639508ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.442969ms)\u001b[39m\u001b[39m\r\n"]
[78.260007, "o", "\u001b[32m✔ branch selection uses exact tags or stack IDs, not names or dependencies \u001b[90m(0.274965ms)\u001b[39m\u001b[39m\r\n"]
[78.260111, "o", "\u001b[32m✔ external dependents block teardown without being selected \u001b[90m(0.470007ms)\u001b[39m\u001b[39m\r\n"]
[78.261133, "o", "\u001b[32m✔ deletion ordering handles shuffled graphs and shared dependencies without mutation \u001b[90m(0.990138ms)\u001b[39m\u001b[39m\r\n"]
[78.261199, "o", "\u001b[32m✔ dependency cycles fail planning before any deletion \u001b[90m(0.791471ms)\u001b[39m\u001b[39m\r\n"]
[78.261819, "o", "\u001b[32m✔ an already torn down branch has an empty plan \u001b[90m(0.585069ms)\u001b[39m\u001b[39m\r\n"]
