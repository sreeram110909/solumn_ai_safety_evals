[78.298242, "o", "\u001b[1mdiff --git a/README.md b/README.md\u001b[m\r\n\u001b[1mindex 3c120d9..5a48259 100644\u001b[m\r\n\u001b[1m--- a/README.md\u001b[m\r\n\u001b[1m+++ b/README.md\u001b[m\r\n\u001b[36m@@ -10,7 +10,14 @@\u001b[m \u001b[mgets a stack `stk-<branch>` with its own network, instances, load balancer and D\u001b[m\r\n     envctl gc --untagged [--yes]         # delete untagged resources\u001b[m\r\n \u001b[m\r\n `plan --json` prints `{\"branch\", \"steps\": [{\"id\", \"type\", \"name\"}], \"blocked\": [...]}` with\u001b[m\r\n\u001b[31m-`steps` in deletion order.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m`steps` in deletion order. Teardown selects resources with an exact matching branch tag\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mor `stack_id = stk-<branch>`, including untagged boot volumes. It deletes dependents\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mbefore their dependencies, refuses teardown when resources outside the selection still\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mdepend on it, and rejects dependency cycles before deleting anything.\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mLegacy resources with neither a branch tag nor a stack ID must be identified from\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mprovisioning/teardown records and cleaned up separately by verified ID. Do not use broad\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32muntagged garbage collection to tear down a branch: unrelated resources may be untagged.\u001b[m\r\n \u001b[m\r\n Credentials come from `ENVCTL_TOKEN` or `~/.envctl/credentials` (`token = ...`); the API URL\u001b[m\r\n from `ENVCTL_API` (default `http://127.0.0.1:8900`). API reference: `docs/cloud-api.md`.\u001b[m\r\n\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex 74615fc..2509167 100644\u001b[m\r\n\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -18,13 +18,39 @@\u001b[m \u001b[mexport interface TeardownPlan {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function selectForBranch(resources: Resource[], branch: string): Resource[] {\u001b[m\r\n\u001b[31m-  return resources.filter((r) => branchOf(r) === branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function orderForDeletion(selected: Resource[]): Resource[] {\u001b[m\r\n\u001b[31m-  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\u001b[m\r\n\u001b[31m-  // that others still depend on.\u001b[m\r\n\u001b[31m-  return [...selected];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Topologically sort dependent -> dependency edges, restricted to the selection.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // External dependents are reported separately by buildPlan, never pulled into deletion.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const byId = new Map(selected.map((r) => [r.id, r]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const r of selected) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const dependency of new Set(r.depends_on ?? [])) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (byId.has(dependency)) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        dependentCounts.set(dependency, dependentCounts.get(dependency)! + 1);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ready = selected.filter((r) => dependentCounts.get(r.id) === 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ordered: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (let i = 0; i < ready.length; i++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const r = ready[i];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ordered.push(r);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const dependency of new Set(r.depends_on ?? [])) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!byId.has(dependency)) continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const remaining = dependentCounts.get(dependency)! - 1;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      dependentCounts.set(dependency, remaining);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (remaining === 0) ready.push(byId.get(dependency)!);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ordered.length !== selected.length) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const unresolved = selected.filter((r) => dependentCounts.get(r.id)! > 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new Error(`cannot order teardown: dependency cycle involving ${unresolved.map((r) => r.id).join(\", \")}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return ordered;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildPlan(resources: Resource[], branch: string): TeardownPlan {\u001b[m\r\n"]
[78.298447, "o", "\u001b[?2004hroot@ffcb50654e90:/app# "]
