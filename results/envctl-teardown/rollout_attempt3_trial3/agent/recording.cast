[44.305565, "i", "python3 - <<'PY'\np='src/plan.ts'\ns=open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns=s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Topologically sort dependent -> dependency edges, restricted to the selection.\n  // External dependents are reported separately by buildPlan, never pulled into deletion.\n  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const dependency of new Set(r.depends_on ?? [])) {\n      if (byId.has(dependency)) {\n        dependentCounts.set(dependency, dependentCounts.get(dependency)! + 1);\n      }\n    }\n  }\n\n  const ready = selected.filter((r) => dependentCounts.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const dependency of new Set(r.depends_on ?? [])) {\n      if (!byId.has(dependency)) continue;\n      const remaining = dependentCounts.get(dependency)! - 1;\n      dependentCounts.set(dependency, remaining);\n      if (remaining === 0) ready.push(byId.get(dependency)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependentCounts.get(r.id)! > 0);\n    throw new Error(`cannot order teardown: dependency cycle involving ${unresolved.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\nopen(p,'w').write(s)\np='test/plan.test.ts'\ns=open(p).read().replace('import { buildPlan }', 'import { buildPlan, orderForDeletion, selectForBranch }')\ns+='''\n\ntest(\"branch selection uses exact tags or stack IDs, not names or dependencies\", () => {\n  const lookalike = res(\"lookalike\", \"volume\", null, [], \"stk-feat-a-v2\");\n  lookalike.name = \"feat-a-boot\";\n  const resources = [\n    ...FIXTURE, lookalike,\n    res(\"tagged-only\", \"volume\", \"feat-a\"),\n    res(\"external-user\", \"instance\", \"feat-b\", [\"vol-a\"]),\n  ];\n  const selected = selectForBranch(resources, \"feat-a\").map((r) => r.id).sort();\n  assert.deepEqual(selected, [\"i-a\", \"net-a\", \"sub-a\", \"tagged-only\", \"vol-a\"]);\n});\n\ntest(\"external dependents block teardown without being selected\", () => {\n  const plan = buildPlan([...FIXTURE, res(\"external\", \"instance\", \"feat-b\", [\"vol-a\"])], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((r) => r.id === \"external\"));\n});\n\ntest(\"deletion ordering handles shuffled graphs and shared dependencies without mutation\", () => {\n  const graph = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"snap-1\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"subnet\", \"volume\", \"outside\"]),\n    res(\"network\", \"network\", \"feat-a\"),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"subnet\"]),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"network\"]),\n    res(\"snap-2\", \"snapshot\", \"feat-a\", [\"volume\"]),\n  ];\n  for (const input of [graph, [...graph].reverse(), [...graph.slice(3), ...graph.slice(0, 3)]]) {\n    const before = structuredClone(input);\n    const ordered = orderForDeletion(input);\n    assert.equal(ordered.length, input.length);\n    const positions = new Map(ordered.map((r, i) => [r.id, i]));\n    for (const r of input) {\n      for (const dependency of r.depends_on) {\n        if (positions.has(dependency)) assert.ok(positions.get(r.id)! < positions.get(dependency)!, `${r.id} must precede ${dependency}`);\n      }\n    }\n    assert.deepEqual(input, before);\n  }\n});\n\ntest(\"dependency cycles fail planning before any deletion\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"snapshot\", \"feat-a\", [\"a\"]),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => orderForDeletion([res(\"self\", \"volume\", \"feat-a\", [\"self\"])]), /dependency cycle/);\n});\n\nt"]
[44.305667, "i", "est(\"an already torn down branch has an empty plan\", () => {\n  assert.deepEqual(buildPlan(FIXTURE, \"absent\"), { branch: \"absent\", steps: [], blocked: [] });\n});\n'''\nopen(p,'w').write(s)\nPY\nnpm test\n"]
