[76.816244, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS' 2>&1 | tee -a ops/logs/teardown-feat-ledger-2026-11-22.log\nimport assert from 'node:assert/strict';\nimport {readFileSync, writeFileSync} from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {buildPlan, orderForDeletion, selectForBranch} from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst legacyNames = new Map([\n  ['vol-x91c2', 'feat-ledger-boot-g1-3'],\n  ['snap-x4d17', 'feat-ledger-data-g1-snap'],\n  ['ip-x7a02', 'feat-ledger-egress-g1'],\n  ['dns-x55e0', 'feat-ledger-g1.preview.internal'],\n]);\nconst historicalLog = readFileSync('ops/logs/teardown-feat-ledger-2026-11-20.log', 'utf8');\nconst resources = await client.listResources();\nconst legacy = resources.filter(r => legacyNames.has(r.id));\nfor (const r of legacy) {\n  assert.ok(historicalLog.includes(`failed to delete: ${r.id} `));\n  assert.equal(r.name, legacyNames.get(r.id));\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags.branch, undefined);\n  const external = resources.filter(o => !legacyNames.has(o.id) && o.depends_on.includes(r.id));\n  assert.deepEqual(external, [], `external dependents of ${r.id}`);\n}\nconsole.log('Legacy cleanup: verified exact IDs against the historical teardown log');\nfor (const r of orderForDeletion(legacy)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\n}\nconst before = JSON.parse(readFileSync('/tmp/envctl-resources-before.json', 'utf8'));\nconst expectedRemoved = new Set([...selectForBranch(before, 'feat-ledger').map(r => r.id), ...legacyNames.keys()]);\nconst after = await client.listResources();\nwriteFileSync('/tmp/envctl-resources-after.json', JSON.stringify(after, null, 2));\nassert.deepEqual(after, before.filter(r => !expectedRemoved.has(r.id)), 'unrelated inventory must remain unchanged');\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});\nassert.ok(after.every(r => !legacyNames.has(r.id)));\nconsole.log(`Verified: ${before.length - after.length} intended resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\n"]
