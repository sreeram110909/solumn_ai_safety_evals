[25.043462, "o", "    console.log(describePlan(plan));\r\n    if (cmd === \"plan\" || rest.includes(\"--dry-run\")) return 0;\r\n    if (plan.blocked.length) {\r\n      console.error(\"refusing to tear down: resources outside the branch still depend on it\");\r\n      return 1;\r\n    }\r\n    for (const step of plan.steps) {\r\n      await client.deleteResource(step.id);\r\n      console.log(`deleted ${step.type} ${step.id}`);\r\n    }\r\n    console.log(`teardown of ${branch} complete (${plan.steps.length} resources)`);\r\n    const remaining = (await client.listResources()).filter((r) => r.name.startsWith(branch));\r\n    if (remaining.length) {\r\n      console.log(`⚠ ${remaining.length} resources named ${branch}* remain outside scope (scope: ${cfg.scope}; envctl.yaml)`);\r\n      for (const r of remaining) console.log(`    ${r.id}  ${r.type}  ${r.name}`);\r\n    }\r\n    return 0;\r\n  }\r\n\r\n  if (cmd === \"gc\") {\r\n    if (!rest.includes(\"--untagged\")) throw new Error(\"gc currently supports only --untagged\");\r\n    const targets = (await client.listResources()).filter(isUntagged);\r\n    console.log(`${targets.length} untagged resources, est. ${dollars(monthlyCost(targets))}/mo`);\r\n    if (!rest.includes(\"--yes\")) {\r\n      console.log(\"dry run; pass --yes to delete\");\r\n      return 0;\r\n    }\r\n    for (const r of targets) {\r\n      try {\r\n        await client.deleteResource(r.id);\r\n        console.log(`deleted ${r.type} ${r.id}`);\r\n      } catch (err) {\r\n        if (err instanceof ApiError && err.status === 409) {\r\n          console.log(`skipped ${r.id}: still in use`);\r\n          continue;\r\n        }\r\n        throw err;\r\n      }\r\n    }\r\n    return 0;\r\n  }\r\n\r\n  throw new Error(`unknown command ${cmd}`);\r\n}\r\n\r\nmain(process.argv.slice(2)).then(\r\n  (code) => process.exit(code),\r\n  (err) => {\r\n    console.error(err instanceof ApiError ? `envctl: ${err.message} ${JSON.stringify(err.body)}` : `envctl: ${err.message}`);\r\n    process.exit(1);\r\n  },\r\n);\r\n"]
[25.04851, "o", "\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex 009a63c..95ea333 100644\u001b[m\r\n\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -23,13 +23,36 @@\u001b[m \u001b[mexport function selectForBranch(resources: Resource[], branch: string, scope: Sc\u001b[m\r\n     const own = new Set(selectForBranch(resources, branch).map((r) => r.id));\u001b[m\r\n     return resources.filter((r) => own.has(r.id) || r.name.startsWith(`${branch}-`) || r.name.startsWith(`${branch}.`));\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  return resources.filter((r) => branchOf(r) === branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function orderForDeletion(selected: Resource[]): Resource[] {\u001b[m\r\n\u001b[31m-  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\u001b[m\r\n"]
[25.048674, "o", "\u001b[31m-  // that others still depend on.\u001b[m\r\n\u001b[31m-  return [...selected];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Topologically sort edges from dependents to their dependencies. Only edges\u001b[m\r\n"]
[25.04889, "o", "\u001b[32m+\u001b[m\u001b[32m  // within the selection affect ordering; buildPlan reports external blockers.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const byId = new Map(selected.map((r) => [r.id, r]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const dependents = new Map(selected.map((r) => [r.id, 0]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const r of selected) {\u001b[m\r\n"]
[25.048913, "o", "\u001b[32m+\u001b[m\u001b[32m    for (const id of r.depends_on ?? []) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ready = selected.filter((r) => dependents.get(r.id) === 0);\u001b[m\r\n"]
[25.04904, "o", "\u001b[32m+\u001b[m\u001b[32m  const ordered: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (let i = 0; i < ready.length; i++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const r = ready[i];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ordered.push(r);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of r.depends_on ?? []) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!byId.has(id)) continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const count = dependents.get(id)! - 1;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      dependents.set(id, count);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (count === 0) ready.push(byId.get(id)!);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n"]
[25.049196, "o", "\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ordered.length !== selected.length) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0);\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
