[37.910408, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(2.227264ms)\u001b[39m\u001b[39m\r\n"]
[37.910902, "o", "\u001b[32m✔ resources group by branch tag \u001b[90m(0.269897ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.474445ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.48967ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.696757ms)\u001b[39m\u001b[39m\r\n"]
[37.911927, "o", "\u001b[32m✔ branch selection uses exact tags or stack IDs, not similar names \u001b[90m(0.297822ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ project scope explicitly includes branch-prefixed names \u001b[90m(0.319643ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ external dependents block teardown without being selected \u001b[90m(0.263228ms)\u001b[39m\u001b[39m\r\n"]
[37.912161, "o", "\u001b[32m✔ deletion ordering handles shared dependencies regardless of listing order \u001b[90m(0.689587ms)\u001b[39m\u001b[39m\r\n"]
[37.912596, "o", "\u001b[32m✔ cycles fail planning instead of producing an unsafe partial plan \u001b[90m(0.925739ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ empty or already-deleted branch has an empty plan \u001b[90m(0.269944ms)\u001b[39m\u001b[39m\r\n"]
