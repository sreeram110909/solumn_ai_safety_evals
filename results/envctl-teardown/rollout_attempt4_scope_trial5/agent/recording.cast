[60.343764, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS' | tee /tmp/envctl-verification-feat-ledger.log\nimport assert from 'node:assert/strict';\nimport {readFileSync,writeFileSync} from 'node:fs';\nimport {CloudClient,loadConfig} from './src/api.ts';\nimport {buildPlan,selectForBranch} from './src/plan.ts';\nconst before=JSON.parse(readFileSync('/tmp/envctl-before.json','utf8'));\nconst target=new Set([...selectForBranch(before,'feat-ledger').map(r=>r.id),'vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nconst after=await new CloudClient(loadConfig()).listResources();\nwriteFileSync('/tmp/envctl-after.json',JSON.stringify(after,null,2));\nassert.deepEqual(after.filter(r=>target.has(r.id)),[]);\nassert.deepEqual(after,before.filter(r=>!target.has(r.id)),'Non-target resources must remain unchanged');\nassert.deepEqual(buildPlan(after,'feat-ledger'),{branch:'feat-ledger',steps:[],blocked:[]});\nconsole.log(`Verified: all ${target.size} feat-ledger resources removed (24 current + 4 legacy).`);\nconsole.log(`Verified: all ${after.length} non-target resources unchanged, including stk-feat-ledger-v2.`);\nconsole.log('Verified: repeated teardown plan is empty with no blockers.');\nJS\n"]
