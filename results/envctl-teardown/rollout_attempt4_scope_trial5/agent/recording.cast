[58.569993, "o", "⚠ 9 resources named feat-ledger* remain outside scope (scope: branch; envctl.yaml)\r\n    net-lv2  network  feat-ledger-v2-vpc\r\n    sub-lv2  subnet  feat-ledger-v2-subnet-a\r\n    vol-lv2  volume  feat-ledger-v2-boot-0\r\n    vol-x91c2  volume  feat-ledger-boot-g1-3\r\n    i-lv2  instance  feat-ledger-v2-app-0\r\n    dns-lv2  dns_record  feat-ledger-v2.preview.internal\r\n    dns-x55e0  dns_record  feat-ledger-g1.preview.internal\r\n    snap-x4d17  snapshot  feat-ledger-data-g1-snap\r\n    ip-x7a02  static_ip  feat-ledger-egress-g1\r\n"]
