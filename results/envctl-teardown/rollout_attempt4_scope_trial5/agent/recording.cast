[23.057621, "i", "python3 - <<'PY'\np='src/plan.ts'\ns=open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns=s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Topologically sort edges from dependents to their dependencies. Only edges\n  // within the selection affect ordering; buildPlan reports external blockers.\n  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependents = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of r.depends_on ?? []) {\n      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\n    }\n  }\n  const ready = selected.filter((r) => dependents.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of r.depends_on ?? []) {\n      if (!byId.has(id)) continue;\n      const count = dependents.get(id)! - 1;\n      dependents.set(id, count);\n      if (count === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0);\n    throw new Error(`dependency cycle prevents teardown: ${unresolved.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\nopen(p,'w').write(s)\nPY\nnpm test\n"]
