[37.594317, "o", "\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"external dependents block teardown without being selected\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [res(\"vol\", \"volume\", null, [], \"stk-feat-a\"), res(\"external\", \"snapshot\", \"feat-b\", [\"vol\"])];\r\n\u001b[?2004l\r\u001b[?2004h>   const plan = buildPlan(resources, \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.steps.map((r) => r.id), [\"vol\"]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(plan.blocked, [{ id: \"vol\", dependents: [\"external\"] }]);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"deletion ordering handles shared dependencies regardless of listing order\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"vol\", \"volume\", \"feat-a\"),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"snap\", \"snapshot\", \"feat-a\", [\"vol\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"instance\", \"instance\", \"feat-a\", [\"sub\", \"vol\", \"shared-network\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"sub\", \"subnet\", \"feat-a\", [\"net\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"lb\", \"load_balancer\", \"feat-a\", [\"instance\", \"sub\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"net\", \"network\", \"feat-a\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   for (const listing of [resources, [...resources].reverse()]) {\r\n\u001b[?2004l\r\u001b[?2004h>     const plan = buildPlan(listing, \"feat-a\");\r\n\u001b[?2004l\r\u001b[?2004h>     const ids = plan.steps.map((r) => r.id);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.equal(new Set(ids).size, resources.length);\r\n\u001b[?2004l\r\u001b[?2004h>     assert.deepEqual(plan.blocked, []);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const r of resources) {\r\n\u001b[?2004l\r\u001b[?2004h>       for (const dependency of r.depends_on) {\r\n\u001b[?2004l\r\u001b[?2004h>         if (ids.includes(dependency)) assert.ok(ids.indexOf(r.id) < ids.indexOf(dependency), `${r.id} must precede ${dependency}`);\r\n\u001b[?2004l\r\u001b[?2004h>       }\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"cycles fail planning instead of producing an unsafe partial plan\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => buildPlan([\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"b\", \"snapshot\", \"feat-a\", [\"a\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"independent\", \"volume\", \"feat-a\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ], \"feat-a\"), /dependency cycle/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => buildPlan([res(\"self\", \"volume\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> "]
[37.595465, "o", "test(\"empty or already-deleted branch has an empty plan\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan([], \"feat-a\"), { branch: \"feat-a\", steps: [], blocked: [] });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan(FIXTURE, \"absent\").steps, []);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> TS\r\n\u001b[?2004l\r"]
[37.597997, "o", "\u001b[?2004hroot@1ee4acb56b5b:/app# npm test\r\n\u001b[?2004l\r"]
