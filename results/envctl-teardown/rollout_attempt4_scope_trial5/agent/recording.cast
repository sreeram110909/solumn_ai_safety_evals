[59.349647, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS' | tee /tmp/envctl-legacy-feat-ledger.log\nimport assert from 'node:assert/strict';\nimport {CloudClient,loadConfig} from './src/api.ts';\nimport {orderForDeletion,selectForBranch} from './src/plan.ts';\nconst client=new CloudClient(loadConfig());\nconst rs=await client.listResources();\nassert.equal(selectForBranch(rs,'feat-ledger').length,0,'Current branch teardown must finish first');\nconst legacy=new Set(['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nconst selected=rs.filter(r=>legacy.has(r.id));\nfor(const r of selected) {\n  assert.equal(r.stack_id,null);\n  assert.equal(r.tags?.branch,undefined);\n  assert.ok(r.name.startsWith('feat-ledger-'));\n  const external=rs.filter(o=>!legacy.has(o.id)&&o.depends_on.includes(r.id));\n  assert.equal(external.length,0,`External dependents of ${r.id}`);\n}\nfor(const r of orderForDeletion(selected)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\n}\nconsole.log(`Legacy cleanup complete (${selected.length} resources)`);\nJS\n"]
