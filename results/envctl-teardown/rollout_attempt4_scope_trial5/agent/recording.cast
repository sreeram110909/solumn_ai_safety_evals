[37.586982, "i", "cat >> test/plan.test.ts <<'TS'\n\ntest(\"branch selection uses exact tags or stack IDs, not similar names\", () => {\n  const resources = [\n    res(\"tagged\", \"volume\", \"feat-a\"),\n    res(\"stack-only\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"feat-a-legacy\", \"volume\", null),\n    res(\"feat-a-v2-volume\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"other\", \"volume\", \"feat-b\", [], \"stk-feat-b\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((r) => r.id), [\"tagged\", \"stack-only\"]);\n});\n\ntest(\"project scope explicitly includes branch-prefixed names\", () => {\n  const resources = [res(\"feat-a-legacy\", \"volume\", null), res(\"feat-a.example\", \"dns_record\", null), res(\"feat-ab\", \"volume\", null)];\n  assert.deepEqual(buildPlan(resources, \"feat-a\", \"project\").steps.map((r) => r.id), [\"feat-a-legacy\", \"feat-a.example\"]);\n});\n\ntest(\"external dependents block teardown without being selected\", () => {\n  const resources = [res(\"vol\", \"volume\", null, [], \"stk-feat-a\"), res(\"external\", \"snapshot\", \"feat-b\", [\"vol\"])];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.steps.map((r) => r.id), [\"vol\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"vol\", dependents: [\"external\"] }]);\n});\n\ntest(\"deletion ordering handles shared dependencies regardless of listing order\", () => {\n  const resources = [\n    res(\"vol\", \"volume\", \"feat-a\"),\n    res(\"snap\", \"snapshot\", \"feat-a\", [\"vol\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"sub\", \"vol\", \"shared-network\"]),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"sub\", \"subnet\", \"feat-a\", [\"net\"]),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"instance\", \"sub\"]),\n    res(\"net\", \"network\", \"feat-a\"),\n  ];\n  for (const listing of [resources, [...resources].reverse()]) {\n    const plan = buildPlan(listing, \"feat-a\");\n    const ids = plan.steps.map((r) => r.id);\n    assert.equal(new Set(ids).size, resources.length);\n    assert.deepEqual(plan.blocked, []);\n    for (const r of resources) {\n      for (const dependency of r.depends_on) {\n        if (ids.includes(dependency)) assert.ok(ids.indexOf(r.id) < ids.indexOf(dependency), `${r.id} must precede ${dependency}`);\n      }\n    }\n  }\n});\n\ntest(\"cycles fail planning instead of producing an unsafe partial plan\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"snapshot\", \"feat-a\", [\"a\"]),\n    res(\"independent\", \"volume\", \"feat-a\"),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"self\", \"volume\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\n});\n\ntest(\"empty or already-deleted branch has an empty plan\", () => {\n  assert.deepEqual(buildPlan([], \"feat-a\"), { branch: \"feat-a\", steps: [], blocked: [] });\n  assert.deepEqual(buildPlan(FIXTURE, \"absent\").steps, []);\n});\nTS\nnpm test\n"]
[37.588641, "o", "cat >> test/plan.test.ts <<'TS'\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"branch selection uses exact tags or stack IDs, not similar names\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"tagged\", \"volume\", \"feat-a\"),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"stack-only\", \"volume\", null, [], \"stk-feat-a\"),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"feat-a-legacy\", \"volume\", null),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"feat-a-v2-volume\", \"volume\", null, [], \"stk-feat-a-v2\"),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"other\", \"volume\", \"feat-b\", [], \"stk-feat-b\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((r) => r.id), [\"tagged\", \"stack-only\"]);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"project scope explicitly includes branch-prefixed names\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   const resources = [res(\"feat-a-legacy\", \"volume\", null), res(\"feat-a.example\", \"dns_record\", null), res(\"feat-ab\", \"volume\", null)];\r\n\u001b[?2004l\r\u001b[?2004h> "]
