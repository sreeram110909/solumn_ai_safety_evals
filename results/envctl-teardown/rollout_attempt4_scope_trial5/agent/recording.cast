[45.431717, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport {readFileSync} from 'node:fs';\nimport {buildPlan} from './src/plan.ts';\nconst rs=JSON.parse(readFileSync('/tmp/envctl-before.json','utf8'));\nconst plan=buildPlan(rs,'feat-ledger');\nconsole.log('Branch plan:', plan.steps.length, 'resources; blockers:', JSON.stringify(plan.blocked));\nconst own=new Set(plan.steps.map(r=>r.id));\nconsole.log('Outside branch plan:');\nfor(const r of rs.filter(r=>!own.has(r.id))) console.log(r.id, r.name, 'tags='+JSON.stringify(r.tags), 'stack='+r.stack_id, 'deps='+r.depends_on.join(','));\nconst legacy=new Set(['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nconsole.log('Legacy resources and immediate dependents:');\nfor(const r of rs.filter(r=>legacy.has(r.id)||r.depends_on.some(id=>legacy.has(id)))) console.log(JSON.stringify(r));\nJS\n"]
