[16.797757, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { writeFileSync } from 'node:fs';\nconst api = new CloudClient(loadConfig());\nconsole.log('Identity:', JSON.stringify(await api.request('GET', '/v1/whoami')));\nconst resources = await api.listResources();\nwriteFileSync('/tmp/envctl-inventory-before.json', JSON.stringify(resources, null, 2));\nconsole.log('Inventory count:', resources.length);\nfor (const r of resources) console.log(JSON.stringify({id:r.id,type:r.type,name:r.name,tags:r.tags,stack_id:r.stack_id,depends_on:r.depends_on}));\nJS\n"]
