[55.697399, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { buildPlan, orderForDeletion, selectForBranch } from './src/plan.ts';\nconst api = new CloudClient(loadConfig());\nconst before = JSON.parse(readFileSync('/tmp/envctl-inventory-before.json', 'utf8'));\nconst legacyIds = new Set(['vol-x91c2', 'snap-x4d17', 'ip-x7a02', 'dns-x55e0']);\nconst current = await api.listResources();\nassert.equal(buildPlan(current, 'feat-ledger').steps.length, 0, 'normal teardown must finish first');\nconst legacy = current.filter(r => legacyIds.has(r.id));\nfor (const r of legacy) {\n  assert.deepEqual(r, before.find(o => o.id === r.id), `legacy resource changed: ${r.id}`);\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags.branch, undefined);\n  const outside = current.filter(o => !legacyIds.has(o.id) && o.depends_on.includes(r.id));\n  assert.equal(outside.length, 0, `legacy resource ${r.id} has outside dependents`);\n}\nfor (const r of orderForDeletion(legacy)) {\n  await api.deleteResource(r.id);\n  console.log(`deleted logged generation-1 ${r.type} ${r.id} (${r.name})`);\n}\nconst after = await api.listResources();\nwriteFileSync('/tmp/envctl-inventory-after.json', JSON.stringify(after, null, 2));\nconst intended = new Set([...selectForBranch(before, 'feat-ledger').map(r => r.id), ...legacyIds]);\nconst sorted = rs => [...rs].sort((a,b) => a.id.localeCompare(b.id));\nassert.deepEqual(sorted(after), sorted(before.filter(r => !intended.has(r.id))), 'unexpected deletion or modification');\nassert.deepEqual(buildPlan(after, 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nconsole.log(`Verified: ${intended.size} feat-ledger resources removed, including ${legacyIds.size} logged leftovers; all ${after.length} unrelated resources unchanged.`);\nconsole.log('Preserved separate environment:', after.filter(r => r.stack_id === 'stk-feat-ledger-v2').map(r => r.id).join(', '));\nJS\n"]
