[41.799357, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/plan.ts')\ns = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\n  // that others still depend on.\n  return [...selected];''', '''  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependentCount = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const dependency of new Set(r.depends_on ?? [])) {\n      if (byId.has(dependency)) {\n        dependentCount.set(dependency, dependentCount.get(dependency)! + 1);\n      }\n    }\n  }\n\n  // Start with resources nothing selected depends on. Deleting each one frees its\n  // dependencies, regardless of the order returned by the listing API.\n  const ready = selected.filter((r) => dependentCount.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const dependency of new Set(r.depends_on ?? [])) {\n      if (!byId.has(dependency)) continue;\n      const remaining = dependentCount.get(dependency)! - 1;\n      dependentCount.set(dependency, remaining);\n      if (remaining === 0) ready.push(byId.get(dependency)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependentCount.get(r.id)! > 0);\n    throw new Error(`dependency cycle prevents teardown: ${unresolved.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\np.write_text(s)\nPY\ncat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch ownership uses exact tags or stack IDs, not name prefixes\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"unrelated-name\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"feat-a-v2-volume\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"feat-a-legacy\", \"volume\", null),\n    res(\"tag-only\", \"volume\", \"feat-a\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(),\n    [\"i-a\", \"net-a\", \"sub-a\", \"tag-only\", \"unrelated-name\", \"vol-a\"]);\n});\n\ntest(\"deletion order respects every dependency even with shuffled listing order\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"subnet\", \"volume\"]),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"net\", \"network\", \"feat-a\"),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"subnet\"]),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"net\", \"shared-network\"]),\n  ];\n  for (const listing of [resources, [...resources].reverse()]) {\n    const order = buildPlan(listing, \"feat-a\").steps.map((s) => s.id);\n    assert.equal(order.length, resources.length);\n    assert.equal(new Set(order).size, resources.length);\n    for (const r of resources) {\n      for (const dependency of r.depends_on) {\n        if (order.includes(dependency)) assert.ok(order.indexOf(r.id) < order.indexOf(dependency));\n      }\n    }\n  }\n});\n\ntest(\"outside dependents block teardown without being selected\", () => {\n  const plan = buildPlan([...FIXTURE, res(\"external\", \"instance\", \"feat-b\", [\"vol-a\"])], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\"));\n});\n\ntest(\"cycles fail planning instead of yielding an unsafe partial plan\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\n    res(\"independent\", \"volume\", \"feat-a\"),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"self\", \"volume\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\"), { branch: \"missing\", steps: [], blocked: [] });\n});\nEOF\nnpm test\n"]
