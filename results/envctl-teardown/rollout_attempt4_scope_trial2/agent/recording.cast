[54.562024, "o", "\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex 009a63c..8975ea5 100644\u001b[m\r\n\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -23,13 +23,36 @@\u001b[m \u001b[mexport function selectForBranch(resources: Resource[], branch: string, scope: Sc\u001b[m\r\n     const own = new Set(selectForBranch(resources, branch).map((r) => r.id));\u001b[m\r\n     return resources.filter((r) => own.has(r.id) || r.name.startsWith(`${branch}-`) || r.name.startsWith(`${branch}.`));\u001b[m\r\n   }\u001b[m\r\n\u001b[31m-  return resources.filter((r) => branchOf(r) === branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function orderForDeletion(selected: Resource[]): Resource[] {\u001b[m\r\n\u001b[31m-  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\u001b[m\r\n\u001b[31m-  // that others still depend on.\u001b[m\r\n\u001b[31m-  return [...selected];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Kahn's algorithm with edges from dependents to their dependencies: a resource\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // becomes deletable only after every selected resource that uses it is removed.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const byId = new Map(selected.map((r) => [r.id, r]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const dependentCount = new Map(selected.map((r) => [r.id, 0]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const r of selected) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of new Set(r.depends_on ?? [])) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (byId.has(id)) dependentCount.set(id, dependentCount.get(id)! + 1);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ready = selected.filter((r) => dependentCount.get(r.id) === 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ordered: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (let i = 0; i < ready.length; i++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const r = ready[i];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ordered.push(r);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of new Set(r.depends_on ?? [])) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!byId.has(id)) continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const remaining = dependentCount.get(id)! - 1;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      dependentCount.set(id, remaining);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (remaining === 0) ready.push(byId.get(id)!);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ordered.length !== selected.length) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const unresolved = selected.filter((r) => dependentCount.get(r.id)! > 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new Error(`cannot order teardown: dependency cycle involving ${unresolved.map((r) => r.id).join(\", \")}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return ordered;\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function buildPlan(resources: Resource[], branch: string, scope: Scope = \"branch\"): TeardownPlan {\u001b[m\r\n"]
