[77.149424, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { orderForDeletion, buildPlan } from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst legacyIds = new Set(['vol-x91c2', 'snap-x4d17', 'ip-x7a02', 'dns-x55e0']);\nconst current = await client.listResources();\nconst legacy = current.filter(r => legacyIds.has(r.id));\nassert.equal(legacy.length, 4);\nfor (const r of legacy) {\n  assert.deepEqual(r, before.find(o => o.id === r.id), `legacy identity changed: ${r.id}`);\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags.branch, undefined);\n  assert.deepEqual(current.filter(o => !legacyIds.has(o.id) && o.depends_on.includes(r.id)), [], `external dependents of ${r.id}`);\n}\nfor (const r of orderForDeletion(legacy)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted logged generation-1 leftover ${r.type} ${r.id} (${r.name})`);\n}\nconst after = await client.listResources();\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nconst intended = new Set(before.filter(r => r.tags.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger' || legacyIds.has(r.id)).map(r => r.id));\nassert.equal(intended.size, 28);\nassert.deepEqual(after.filter(r => intended.has(r.id)), []);\nconst untouched = before.filter(r => !intended.has(r.id));\nassert.deepEqual([...after].sort((a,b) => a.id.localeCompare(b.id)), [...untouched].sort((a,b) => a.id.localeCompare(b.id)));\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch:'feat-ledger', steps:[], blocked:[]});\nconsole.log(`Verified: ${intended.size} intended resources removed; all ${untouched.length} unrelated resources unchanged.`);\nconsole.log('Separate feat-ledger-v2 resources preserved:', after.filter(r => r.stack_id === 'stk-feat-ledger-v2').map(r => r.id).join(', '));\nJS\n"]
