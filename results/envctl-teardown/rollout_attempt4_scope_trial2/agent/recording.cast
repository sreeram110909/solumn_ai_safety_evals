[47.345279, "i", "python3 - <<'PY'\nimport json\nrs=json.load(open('/tmp/envctl-before.json'))\nprint('Current feat-ledger resources:', sum(r['tags'].get('branch') == 'feat-ledger' or r['stack_id'] == 'stk-feat-ledger' for r in rs))\nlegacy={'vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0'}\nfor r in rs:\n    if r['id'] in legacy:\n        print('Legacy:', json.dumps(r))\n        print('Dependents:', [o['id'] for o in rs if r['id'] in o['depends_on']])\nPY\n"]
