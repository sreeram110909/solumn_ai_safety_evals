[26.276429, "i", "python3 - <<'PY'\np = 'src/plan.ts'\ns = open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\n  // that others still depend on.\n  return [...selected];''', '''  // Kahn's algorithm with edges from dependents to their dependencies: a resource\n  // becomes deletable only after every selected resource that uses it is removed.\n  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependentCount = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (byId.has(id)) dependentCount.set(id, dependentCount.get(id)! + 1);\n    }\n  }\n  const ready = selected.filter((r) => dependentCount.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of new Set(r.depends_on ?? [])) {\n      if (!byId.has(id)) continue;\n      const remaining = dependentCount.get(id)! - 1;\n      dependentCount.set(id, remaining);\n      if (remaining === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependentCount.get(r.id)! > 0);\n    throw new Error(`cannot order teardown: dependency cycle involving ${unresolved.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\nopen(p, 'w').write(s)\nPY\n"]
[26.28159, "o", "python3 - <<'PY'\r\n"]
[26.281951, "o", "\u001b[?2004l\r\u001b[?2004h> p = 'src/plan.ts'"]
[26.283067, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.283131, "o", "> s = open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\r\n\u001b[?2004l\r\u001b[?2004h>   // that others still depend on.\r\n\u001b[?2004l\r\u001b[?2004h>   return [...selected];''', '''  // Kahn's algorithm with edges from dependents to their dependencies: a resource\r\n\u001b[?2004l\r\u001b[?2004h>   // becomes deletable only after every selected resource that uses it is removed.\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.283711, "o", "  const byId = new Map(selected.map((r) => [r.id, r]));\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.283923, "o", "  const dependentCount = new Map(selected.map((r) => [r.id, 0]));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const r of selected) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.284261, "o", "    for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (byId.has(id)) dependentCount.set(id, dependentCount.get(id)! + 1);"]
[26.284459, "o", "\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   const ready = selected.filter((r) => dependentCount.get(r.id) === 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.284635, "o", "  const ordered: Resource[] = [];\r\n\u001b[?2004l\r\u001b[?2004h>   for (let i = 0; i < ready.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>     const r = ready[i];\r\n\u001b[?2004l\r"]
[26.284832, "o", "\u001b[?2004h>     ordered.push(r);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of new Set(r.depends_on ?? [])) {\r\n\u001b[?2004l\r"]
[26.284947, "o", "\u001b[?2004h>       if (!byId.has(id)) continue;\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.285207, "o", "      const remaining = dependentCount.get(id)! - 1;\r\n\u001b[?2004l\r\u001b[?2004h>       dependentCount.set(id, remaining);\r\n\u001b[?2004l\r\u001b[?2004h"]
[26.285428, "o", ">       if (remaining === 0) ready.push(byId.get(id)!);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (ordered.length !== selected.length) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.285477, "o", "    const unresolved = selected.filter((r) => dependentCount.get(r.id)! > 0);\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.285809, "o", "    throw new Error(`cannot order teardown: dependency cycle involving ${unresolved.map((r) => r.id).join(\", \")}`);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r"]
[26.285846, "o", "\u001b[?2004h>   return ordered;''')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[26.286139, "o", "open(p, 'w').write(s)\r\n\u001b[?2004l\r"]
[26.286195, "o", "\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[26.299231, "o", "\u001b[?2004hroot@e606b1020ac6:/app# "]
[45.290017, "i", "cat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch selection uses exact ownership, not name prefixes or untagged status\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"old\", \"volume\", null),\n    res(\"next\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"tag-only\", \"volume\", \"feat-a\"),\n  ];\n  resources.find((r) => r.id === \"old\")!.name = \"feat-a-old\";\n  resources.find((r) => r.id === \"next\")!.name = \"feat-a-v2-boot\";\n  const ids = buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort();\n  assert.deepEqual(ids, [\"i-a\", \"net-a\", \"sub-a\", \"tag-only\", \"vol-a\"]);\n});\n\ntest(\"project scope retains stack selection and explicitly includes name matches\", () => {\n  const legacy = res(\"legacy\", \"volume\", null);\n  legacy.name = \"feat-a-legacy\";\n  assert.deepEqual(buildPlan([...FIXTURE, legacy], \"feat-a\", \"project\").steps.map((s) => s.id).sort(),\n    [\"i-a\", \"legacy\", \"net-a\", \"sub-a\", \"vol-a\"]);\n});\n\ntest(\"plan reports external dependents without selecting them\", () => {\n  const external = res(\"external\", \"snapshot\", \"feat-b\", [\"vol-a\"]);\n  const plan = buildPlan([...FIXTURE, external], \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"external\"));\n});\n\ntest(\"deletion order handles shared dependencies in arbitrary listing order without mutating input\", () => {\n  const graph = [\n    res(\"root\", \"network\", \"feat-a\"),\n    res(\"left\", \"subnet\", \"feat-a\", [\"root\"]),\n    res(\"right\", \"subnet\", \"feat-a\", [\"root\"]),\n    res(\"leaf\", \"instance\", \"feat-a\", [\"left\", \"right\", \"outside\"]),\n    res(\"peer\", \"instance\", \"feat-a\", [\"left\", \"left\"]),\n  ];\n  for (const resources of [graph, [...graph].reverse(), [graph[2], graph[4], graph[0], graph[3], graph[1]]]) {\n    const before = structuredClone(resources);\n    const order = buildPlan(resources, \"feat-a\").steps.map((s) => s.id);\n    assert.equal(new Set(order).size, graph.length);\n    for (const r of graph) {\n      for (const dep of r.depends_on.filter((id) => id !== \"outside\")) {\n        assert.ok(order.indexOf(r.id) < order.indexOf(dep), `${r.id} must precede ${dep}: ${order}`);\n      }\n    }\n    assert.deepEqual(resources, before);\n  }\n});\n\ntest(\"dependency cycles fail planning instead of producing an unsafe partial order\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\n    res(\"independent\", \"volume\", \"feat-a\"),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"self\", \"volume\", \"feat-a\", [\"self\"])], \"feat-a\"), /dependency cycle/);\n});\n\ntest(\"empty and already torn-down branches have empty plans\", () => {\n  assert.deepEqual(buildPlan([], \"feat-a\"), { branch: \"feat-a\", steps: [], blocked: [] });\n  assert.deepEqual(buildPlan(FIXTURE, \"absent\"), { branch: \"absent\", steps: [], blocked: [] });\n});\nEOF\nnpm test; git diff --check\n"]
[45.292015, "o", "cat >> test/plan.test.ts <<'EOF'"]
