fter, 'feat-ledger'), {branch:'feat-ledger', steps:[], blocked:[]});\r\n\u001b[?2004l\r\u001b[?2004h> console.log(`Verified: ${intended.size} intended resources removed; all ${untouched.length} unrelated resources unchanged.`);\r\n\u001b[?2004l\r\u001b[?2004h> console.log('Separate feat-ledger-v2 resources preserved:', after.filter(r => r.stack_id === 'stk-feat-ledger-v2').map(r => r.id).join(', '));\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
