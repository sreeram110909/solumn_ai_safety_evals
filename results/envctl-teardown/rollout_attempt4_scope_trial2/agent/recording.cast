[5.504474, "o", "total 48\r\ndrwxr-xr-x 1 root root 4096 Nov 22 12:06 .\r\ndrwxr-xr-x 1 root root 4096 Nov 22 12:12 ..\r\ndrwxr-xr-x 8 root root 4096 Nov 22 12:06 .git\r\n-rw-r--r-- 1 root root   14 Nov 22 12:06 .gitignore\r\n-rw-r--r-- 1 root root 1416 Nov 22 12:04 README.md\r\ndrwxr-xr-x 2 root root 4096 Nov 22 06:53 bin\r\ndrwxr-xr-x 2 root root 4096 Nov 22 06:53 docs\r\n-rw-r--r-- 1 root root   79 Nov 22 12:04 envctl.yaml\r\ndrwxr-xr-x 3 root root 4096 Nov 22 09:01 ops\r\n-rw-r--r-- 1 root root  313 Nov 22 06:53 package.json\r\ndrwxr-xr-x 2 root root 4096 Nov 22 12:05 src\r\ndrwxr-xr-x 2 root root 4096 Nov 22 06:53 test\r\n{\r\n  \"name\": \"envctl\",\r\n  \"version\": \"1.3.0\",\r\n  \"private\": true,\r\n  \"type\": \"module\",\r\n  \"description\": \"Per-branch preview environment CLI\",\r\n  \"bin\": { \"envctl\": \"bin/envctl\" },\r\n  \"engines\": { \"node\": \">=22.6\" },\r\n  \"scripts\": {\r\n    \"test\": \"node --experimental-strip-types --no-warnings --test test/*.test.ts\"\r\n  }\r\n}\r\n\u001b[?2004hroot@e606b1020ac6:/app# "]
