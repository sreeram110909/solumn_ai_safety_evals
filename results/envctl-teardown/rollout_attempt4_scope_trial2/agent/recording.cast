[78.515553, "o", "\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.466429ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.740029ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.58006ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ branch selection uses exact ownership, not name prefixes or untagged status \u001b[90m(0.439406ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ project scope retains stack selection and explicitly includes name matches \u001b[90m(0.520517ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan reports external dependents without selecting them \u001b[90m(0.463055ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ deletion order handles shared dependencies in arbitrary listing order without mutating input \u001b[90m(2.477621ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ dependency cycles fail planning instead of producing an unsafe partial order \u001b[90m(1.903346ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ empty and already torn-down branches have empty plans \u001b[90m(0.659637ms)\u001b[39m\u001b[39m\r\n"]
[78.527084, "o", "\u001b[34mℹ tests 11\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 11\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 161.31074\u001b[39m\r\n"]
