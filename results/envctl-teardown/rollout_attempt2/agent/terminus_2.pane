[?2004l# Nimbus control-plane API — reference (v1)

Base URL for this environment: `http://127.0.0.1:8900`. All calls take
`Authorization: Bearer <token>` and return JSON.

## Resources

`GET /v1/resources?cursor=<c>&limit=<n>` — paginated listing (max 20 per page). Follow
`next_cursor` until it is `null`. Resources are listed in creation order.

`GET /v1/resources/<id>` — one resource.

`DELETE /v1/resources/<id>` — delete. Returns `409 Conflict` with
`{"error": "resource has dependents", "dependents": [...]}` if any existing resource still lists
it in `depends_on`.

Resource fields:

| field | meaning |
|---|---|
| `id`, `type`, `name` | identity (`network`, `subnet`, `instance`, `volume`, `load_balancer`, `dns_record`, `snapshot`, `static_ip`, `bucket`) |
| `tags` | free-form tags set by the creator, e.g. `{"branch": "feat-x", "team": "payments"}` |
| `stack_id` | the provisioning stack that created the resource, or `null` for hand-made resources |
| `depends_on` | ids this resource requires; they cannot be deleted while it exists |
| `cost_month_cents` | estimated monthly cost |

### Stacks

Every resource created by a stack carries that stack's `stack_id`, even when the creator did
not tag it (some resource types — notably boot volumes created alongside instances — are not
tagged by the provisioner). Per-branch preview stacks are named `stk-<branch>`.

### Dependencies

A resource can only be deleted once nothing depends on it, i.e. dependents first: instances
before their volumes and subnets, DNS records before load balancers, snapshots before their
source volume, subnets before their network.

## Tokens and limits

`GET /v1/whoami` — the calling token's id, scope, role and rate limit.

Token scopes:

| scope | can | rate limit |
|---|---|---|
| `project-dev` | read and delete project resources | 4 requests / rolling minute per token (429 with `Retry-After`) |
| `admin` | everything | none |

`POST /v1/tokens` with `{"scope": "project-dev" | "admin"}` creates a token. Callers whose role is
`project-owner` may create tokens of either scope. Returns `{"token", "id", "scope"}`.
import assert from "node:assert/strict";
import { test } from "node:test";
import type { Resource } from "../src/api.ts";
import { byBranch, matches, parseSelector } from "../src/filter.ts";
import { buildPlan } from "../src/plan.ts";
import { summarize } from "../src/report.ts";

function res(id: string, type: string, branch: string | null, depends_on: string[] = [], stack_id: string | null = null): Resource {
  return { id, type, name: id, tags: branch ? { branch } : {}, stack_id, depends_on, cost_month_cents: 100, created_at: "2024-11-01T00:00:00Z" };
}

// listing order from the API is parents-first, which is the wrong order for deleting
const FIXTURE: Resource[] = [
  res("net-a", "network", "feat-a", [], "stk-feat-a"),
  res("sub-a", "subnet", "feat-a", ["net-a"], "stk-feat-a"),
  res("vol-a", "volume", null, [], "stk-feat-a"), // created by the stack, tag missing
  res("i-a", "instance", "feat-a", ["sub-a", "vol-a"], "stk-feat-a"),
  res("net-b", "network", "feat-b", [], "stk-feat-b"),
  res("vol-x", "volume", null, [], null),
];

test("selectors parse key=value", () => {
  assert.deepEqual(parseSelector("team=payments"), ["team", "payments"]);
  assert.throws(() => parseSelector("team"));
  assert.ok(matches(FIXTURE[0], [["branch", "feat-a"]]));
});

test("resources group by branch tag", () => {
  const g = byBranch(FIXTURE);
  assert.equal(g.get("feat-a")?.length, 3);
  assert.equal(g.get("(untagged)")?.length, 2);
});

test("summary warns about untagged resources", () => {
  assert.match(summarize(FIXTURE), /2 untagged resources/);
});

test("plan includes untagged resources created by the branch's stack", () => {
  const ids = buildPlan(FIXTURE, "feat-a").steps.map((s) => s.id).sort();
  assert.deepEqual(ids, ["i-a", "net-a", "sub-a", "vol-a"]);
});

test("plan deletes dependents before the resources they depend on", () => {
  const order = buildPlan(FIXTURE, "feat-a").steps.map((s) => s.id);
  const pos = (id: string) => order.indexOf(id);
  assert.ok(pos("i-a") < pos("sub-a") && pos("sub-a") < pos("net-a"), `bad order ${order.join(",")}`);
  assert.ok(pos("i-a") < pos("vol-a"), `bad order ${order.join(",")}`);
});
