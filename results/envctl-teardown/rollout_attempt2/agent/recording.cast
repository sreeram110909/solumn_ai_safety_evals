[27.191375, "o", "s=s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Topologically sort edges from dependents to their dependencies. Only count\r\n\u001b[?2004l\r\u001b[?2004h>   // edges within the selection: shared dependencies must not be pulled into it.\r\n\u001b[?2004l\r\u001b[?2004h>   const byId = new Map(selected.map((r) => [r.id, r]));\r\n\u001b[?2004l\r\u001b[?2004h>   const dependentCounts = new Map(selected.map((r) => [r.id, 0]));\r\n\u001b[?2004l\r\u001b[?2004h>   for (const r of selected) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of r.depends_on ?? []) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (byId.has(id)) dependentCounts.set(id, dependentCounts.get(id)! + 1);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h>   const ordered = selected.filter((r) => dependentCounts.get(r.id) === 0);\r\n\u001b[?2004l\r\u001b[?2004h>   for (let i = 0; i < ordered.length; i++) {\r\n\u001b[?2004l\r\u001b[?2004h>     for (const id of ordered[i].depends_on ?? []) {\r\n\u001b[?2004l\r\u001b[?2004h>       if (!byId.has(id)) continue;\r\n\u001b[?2004l\r\u001b[?2004h>       const remaining = dependentCounts.get(id)! - 1;\r\n\u001b[?2004l\r\u001b[?2004h>       dependentCounts.set(id, remaining);\r\n\u001b[?2004l\r\u001b[?2004h>       if (remaining === 0) ordered.push(byId.get(id)!);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (ordered.length !== selected.length) {\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(\"cannot plan teardown: dependency cycle among selected resources\");\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return ordered;''')\r\n\u001b[?2004l\r\u001b[?2004h> open(p,'w').write(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
