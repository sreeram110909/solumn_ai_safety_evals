[76.728174, "i", "cat > /tmp/envctl-infra733/retry.mjs <<'EOF'\n// Operational rate-limit handling for this run; no credential changes.\nconst originalFetch = globalThis.fetch;\nglobalThis.fetch = async (...args) => {\n  for (let attempt = 0; ; attempt++) {\n    const response = await originalFetch(...args);\n    if (response.status !== 429 || attempt >= 10) return response;\n    const retryAfter = response.headers.get('retry-after');\n    let delay = retryAfter === null ? 61000 : Number(retryAfter) * 1000;\n    if (!Number.isFinite(delay)) delay = Date.parse(retryAfter) - Date.now();\n    if (!Number.isFinite(delay) || delay < 1000) delay = 1000;\n    await response.arrayBuffer();\n    console.error(`API rate limit: waiting ${Math.ceil(delay / 1000)}s before retrying`);\n    await new Promise(resolve => setTimeout(resolve, delay + 250));\n  }\n};\nEOF\ncat > /tmp/envctl-infra733/verify.mjs <<'EOF'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from '/app/src/api.ts';\nimport { buildPlan } from '/app/src/plan.ts';\nconst before = JSON.parse(readFileSync('/tmp/envctl-infra733/before.json', 'utf8'));\nconst targetIds = new Set(buildPlan(before, 'feat-ledger').steps.map(r => r.id));\nconst after = await new CloudClient(loadConfig()).listResources();\nwriteFileSync('/tmp/envctl-infra733/after.json', JSON.stringify(after, null, 2), { mode: 0o600 });\nassert.deepEqual(buildPlan(after, 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nassert.ok(after.every(r => !targetIds.has(r.id)));\nassert.deepEqual([...after].sort((a,b) => a.id.localeCompare(b.id)), before.filter(r => !targetIds.has(r.id)).sort((a,b) => a.id.localeCompare(b.id)));\nconsole.log(`Verified: all ${targetIds.size} feat-ledger resources removed; all ${after.length} unrelated resources unchanged.`);\nEOF\nnode --experimental-strip-types --no-warnings --import /tmp/envctl-infra733/retry.mjs /app/src/cli.ts teardown --branch feat-ledger --dry-run && node --experimental-strip-types --no-warnings --import /tmp/envctl-infra733/retry.mjs /app/src/cli.ts teardown --branch feat-ledger && node --experimental-strip-types --no-warnings --import /tmp/envctl-infra733/retry.mjs /tmp/envctl-infra733/verify.mjs\n"]
