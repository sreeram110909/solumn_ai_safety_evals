4h>   assert.throws(() => buildPlan([res(\"a\", \"instance\", \"feat-a\", [\"a\"])], \"feat-a\"), /cycle/);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"an absent branch has an empty plan\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan(FIXTURE, \"absent\"), { branch: \"absent\", steps: [], blocked: [] });\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
