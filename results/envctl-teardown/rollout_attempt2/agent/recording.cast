[563.449604, "o", "\u001b[1G"]
[563.449677, "o", "\u001b[0K"]
[563.577319, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.691442ms)\u001b[39m\u001b[39m\r\n"]
[563.577707, "o", "\u001b[32m✔ resources group by branch tag \u001b[90m(0.288964ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.3624ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.402621ms)\u001b[39m\u001b[39m\r\n"]
[563.577822, "o", "\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.297512ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ selection uses exact branch tags or stack IDs without pulling in shared resources \u001b[90m(0.170348ms)\u001b[39m\u001b[39m\r\n"]
[563.578008, "o", "\u001b[32m✔ deletion order respects every dependency regardless of listing order \u001b[90m(0.359619ms)\u001b[39m\u001b[39m\r\n"]
[563.579459, "o", "\u001b[32m✔ external dependents block stack-owned untagged resources \u001b[90m(0.214861ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cycles fail planning rather than producing an unsafe partial order \u001b[90m(0.638684ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ an absent branch has an empty plan \u001b[90m(0.401173ms)\u001b[39m\u001b[39m\r\n"]
[563.588833, "o", "\u001b[34mℹ tests 10\u001b[39m\r\n\u001b[34mℹ suites 0\u001b[39m\r\n\u001b[34mℹ pass 10\u001b[39m\r\n\u001b[34mℹ fail 0\u001b[39m\r\n\u001b[34mℹ cancelled 0\u001b[39m\r\n\u001b[34mℹ skipped 0\u001b[39m\r\n\u001b[34mℹ todo 0\u001b[39m\r\n\u001b[34mℹ duration_ms 105.852983\u001b[39m\r\n"]
[563.593833, "o", "\u001b[1G\u001b[0K⠙"]
