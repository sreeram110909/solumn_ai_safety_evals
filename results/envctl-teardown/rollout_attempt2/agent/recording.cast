[27.339695, "i", "cat >> test/plan.test.ts <<'EOF'\n\ntest(\"selection uses exact branch tags or stack IDs without pulling in shared resources\", () => {\n  const resources = [\n    res(\"tagged\", \"instance\", \"feat-a\", [\"shared\"]),\n    res(\"boot\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"shared\", \"network\", null),\n    res(\"other-stack\", \"volume\", null, [], \"stk-feat-ab\"),\n    res(\"other-branch\", \"instance\", \"feat-ab\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(), [\"boot\", \"tagged\"]);\n});\n\ntest(\"deletion order respects every dependency regardless of listing order\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"net\", \"network\", \"feat-a\"),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"volume\", \"subnet\"]),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"instance\", \"subnet\"]),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"net\"]),\n  ];\n  for (const listing of [resources, [...resources].reverse()]) {\n    const order = buildPlan(listing, \"feat-a\").steps.map((s) => s.id);\n    assert.equal(new Set(order).size, resources.length);\n    for (const r of resources) {\n      for (const dep of r.depends_on) {\n        assert.ok(order.indexOf(r.id) < order.indexOf(dep), `${r.id} must precede ${dep}`);\n      }\n    }\n  }\n});\n\ntest(\"external dependents block stack-owned untagged resources\", () => {\n  const plan = buildPlan([\n    res(\"volume\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"outside\", \"instance\", \"feat-b\", [\"volume\"], \"stk-feat-b\"),\n  ], \"feat-a\");\n  assert.deepEqual(plan.steps.map((s) => s.id), [\"volume\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"volume\", dependents: [\"outside\"] }]);\n});\n\ntest(\"cycles fail planning rather than producing an unsafe partial order\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"instance\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"instance\", \"feat-a\", [\"a\"]),\n    res(\"independent\", \"volume\", \"feat-a\"),\n  ], \"feat-a\"), /cycle/);\n  assert.throws(() => buildPlan([res(\"a\", \"instance\", \"feat-a\", [\"a\"])], \"feat-a\"), /cycle/);\n});\n\ntest(\"an absent branch has an empty plan\", () => {\n  assert.deepEqual(buildPlan(FIXTURE, \"absent\"), { branch: \"absent\", steps: [], blocked: [] });\n});\nEOF\nnpm test\n"]
