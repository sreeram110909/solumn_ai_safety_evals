[70.600468, "o", "import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> import { readFileSync, writeFileSync } from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> import { CloudClient, loadConfig } from './src/api.ts';\r\n\u001b[?2004l\r\u001b[?2004h> import { orderForDeletion, buildPlan } from './src/plan.ts';\r\n\u001b[?2004l\r\u001b[?2004h> const client = new CloudClient(loadConfig());\r\n\u001b[?2004l\r\u001b[?2004h> const legacyIds = new Set(['vol-x91c2', 'snap-x4d17', 'ip-x7a02', 'dns-x55e0']);\r\n\u001b[?2004l\r\u001b[?2004h> const resources = await client.listResources();\r\n\u001b[?2004l\r\u001b[?2004h> const legacy = resources.filter(r => legacyIds.has(r.id));\r\n\u001b[?2004l\r\u001b[?2004h> for (const r of legacy) {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(r.stack_id, null);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.equal(r.tags?.branch, undefined);\r\n\u001b[?2004l\r\u001b[?2004h>   const outsideDependents = resources.filter(o => !legacyIds.has(o.id) && o.depends_on.includes(r.id));\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(outsideDependents, [], `external dependents of ${r.id}`);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> for (const r of orderForDeletion(legacy)) {\r\n\u001b[?2004l\r\u001b[?2004h>   await client.deleteResource(r.id);\r\n\u001b[?2004l\r\u001b[?2004h>   console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\r\n\u001b[?2004l\r\u001b[?2004h> }\r\n\u001b[?2004l\r\u001b[?2004h> const after = await client.listResources();\r\n\u001b[?2004l\r\u001b[?2004h> writeFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> const before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const target = r => r.tags?.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger' || legacyIds.has(r.id);\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(after.filter(target), []);\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(buildPlan(after, 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\r\n\u001b[?2004l\r\u001b[?2004h> const sort = rs => [...rs].sort((a, b) => a.id.localeCompare(b.id));\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(sort(after), sort(before.filter(r => !target(r))));\r\n\u001b[?2004l\r\u001b[?2004h> console.log(`Verified: all ${before.filter(target).length} feat-ledger resources removed; all ${after.length} unrelated resources unchanged.`);\r\n\u001b[?2004l\r\u001b[?2004h> JS\r\n\u001b[?2004l\r"]
