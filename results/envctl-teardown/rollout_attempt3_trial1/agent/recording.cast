[33.71991, "i", "python3 - <<'PY'\np = 'src/plan.ts'\ns = open(p).read().replace('return resources.filter((r) => branchOf(r) === branch);', 'return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);')\ns = s.replace('  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\\n  // that others still depend on.\\n  return [...selected];', '''  // Edges point from a dependent to its prerequisites. Start with resources that\n  // have no dependents, then release their prerequisites as they are removed.\n  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependents = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const id of r.depends_on ?? []) {\n      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\n    }\n  }\n  const ready = selected.filter((r) => dependents.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const id of r.depends_on ?? []) {\n      if (!byId.has(id)) continue;\n      const remaining = dependents.get(id)! - 1;\n      dependents.set(id, remaining);\n      if (remaining === 0) ready.push(byId.get(id)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0);\n    throw new Error(`dependency cycle prevents teardown: ${unresolved.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\nopen(p, 'w').write(s)\nPY\ncat >> test/plan.test.ts <<'EOF'\n\ntest(\"branch selection uses exact stack IDs and leaves unrelated resources alone\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"vol-a-v2\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"legacy-a\", \"volume\", null),\n    res(\"tagged-a\", \"bucket\", \"feat-a\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((s) => s.id).sort(),\n    [\"i-a\", \"net-a\", \"sub-a\", \"tagged-a\", \"vol-a\"]);\n});\n\ntest(\"deletion order handles shuffled listings, shared prerequisites and disconnected resources\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"a\"),\n    res(\"snapshot\", \"snapshot\", \"a\", [\"volume\"]),\n    res(\"instance\", \"instance\", \"a\", [\"volume\", \"external-subnet\"]),\n    res(\"dns\", \"dns_record\", \"a\", [\"lb\"]),\n    res(\"lb\", \"load_balancer\", \"a\", [\"instance\"]),\n    res(\"bucket\", \"bucket\", \"a\"),\n  ];\n  for (const listing of [resources, [...resources].reverse()]) {\n    const order = buildPlan(listing, \"a\").steps.map((s) => s.id);\n    assert.equal(new Set(order).size, resources.length);\n    for (const r of resources) {\n      for (const dep of r.depends_on.filter((id) => order.includes(id))) {\n        assert.ok(order.indexOf(r.id) < order.indexOf(dep), `${r.id} must precede ${dep}`);\n      }\n    }\n  }\n});\n\ntest(\"external dependents block teardown without being selected\", () => {\n  const resources = [...FIXTURE, res(\"other-instance\", \"instance\", \"feat-b\", [\"vol-a\"])];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"other-instance\"] }]);\n  assert.ok(!plan.steps.some((s) => s.id === \"other-instance\"));\n});\n\ntest(\"empty and already-deleted environments have empty plans\", () => {\n  assert.deepEqual(buildPlan([], \"feat-a\"), { branch: \"feat-a\", steps: [], blocked: [] });\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\").steps, []);\n});\n\ntest(\"cycles fail planning instead of issuing an unsafe partial teardown\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"a\", \"volume\", \"feat-a\", [\"a\"])], \"feat-a\"), /dependency cycle/);\n});\nEOF\nnpm test\n"]
