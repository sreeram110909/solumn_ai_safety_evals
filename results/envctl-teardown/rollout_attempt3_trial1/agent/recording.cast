[71.952536, "o", "\u001b[1mdiff --git a/src/plan.ts b/src/plan.ts\u001b[m\r\n\u001b[1mindex 74615fc..ba6a142 100644\u001b[m\r\n\u001b[1m--- a/src/plan.ts\u001b[m\r\n\u001b[1m+++ b/src/plan.ts\u001b[m\r\n\u001b[36m@@ -18,13 +18,36 @@\u001b[m \u001b[mexport interface TeardownPlan {\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function selectForBranch(resources: Resource[], branch: string): Resource[] {\u001b[m\r\n\u001b[31m-  return resources.filter((r) => branchOf(r) === branch);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);\u001b[m\r\n }\u001b[m\r\n \u001b[m\r\n export function orderForDeletion(selected: Resource[]): Resource[] {\u001b[m\r\n\u001b[31m-  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\u001b[m\r\n\u001b[31m-  // that others still depend on.\u001b[m\r\n\u001b[31m-  return [...selected];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // Edges point from a dependent to its prerequisites. Start with resources that\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  // have no dependents, then release their prerequisites as they are removed.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const byId = new Map(selected.map((r) => [r.id, r]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const dependents = new Map(selected.map((r) => [r.id, 0]));\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (const r of selected) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of r.depends_on ?? []) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (byId.has(id)) dependents.set(id, dependents.get(id)! + 1);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ready = selected.filter((r) => dependents.get(r.id) === 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  const ordered: Resource[] = [];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  for (let i = 0; i < ready.length; i++) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const r = ready[i];\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    ordered.push(r);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    for (const id of r.depends_on ?? []) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (!byId.has(id)) continue;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      const remaining = dependents.get(id)! - 1;\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      dependents.set(id, remaining);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m      if (remaining === 0) ready.push(byId.get(id)!);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  if (ordered.length !== selected.length) {\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    const unresolved = selected.filter((r) => dependents.get(r.id)! > 0);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    throw new Error(`dependency cycle prevents teardown: ${unresolved.map((r) => r.id).join(\", \")}`);\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  }\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m  return ordered;\u001b[m\r\n"]
[71.952591, "o", " }\u001b[m\r\n \u001b[m\r\n export function buildPlan(resources: Resource[], branch: string): TeardownPlan {\u001b[m\r\n"]
