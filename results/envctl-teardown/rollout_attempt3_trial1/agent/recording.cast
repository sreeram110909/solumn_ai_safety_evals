[43.372872, "i", "git diff --check; git diff --stat; bin/envctl plan --branch feat-ledger --json > /tmp/envctl-feat-ledger-plan.json && node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync } from 'node:fs';\nimport { describePlan } from './src/report.ts';\nconst plan = JSON.parse(readFileSync('/tmp/envctl-feat-ledger-plan.json', 'utf8'));\nconst resources = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst selected = resources.filter(r => r.tags?.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger');\nassert.deepEqual(plan.blocked, []);\nassert.deepEqual(plan.steps.map(r => r.id).sort(), selected.map(r => r.id).sort());\nconst pos = new Map(plan.steps.map((r, i) => [r.id, i]));\nfor (const r of selected) for (const dep of r.depends_on) {\n  if (pos.has(dep)) assert.ok(pos.get(r.id) < pos.get(dep));\n}\nconsole.log(describePlan(plan));\nconsole.log('Validated exact scope and dependency order.');\nJS\n"]
