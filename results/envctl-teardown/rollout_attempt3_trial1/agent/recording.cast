[34.711155, "i", "python3 - <<'PY'\nimport json\nrs=json.load(open('/tmp/envctl-before.json'))\nprint('Total resources:',len(rs))\nfor r in rs:\n if r.get('tags',{}).get('branch')=='feat-ledger' or r.get('stack_id')=='stk-feat-ledger' or r['id'] in ['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']:\n  print(r['id'],r['name'],'stack='+str(r['stack_id']),'depends_on='+','.join(r['depends_on']))\nlegacy={'vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0'}\nprint('Dependents of legacy leftovers:')\nfor r in rs:\n if legacy.intersection(r['depends_on']): print(r)\nPY\n"]
