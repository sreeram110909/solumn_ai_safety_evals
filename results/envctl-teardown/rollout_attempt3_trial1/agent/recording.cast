[33.741866, "o", "test(\"external dependents block teardown without being selected\", () => {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.742143, "o", "  const resources = [...FIXTURE, res(\"other-instance\", \"instance\", \"feat-b\", [\"vol-a\"])];\r\n\u001b[?2004l\r"]
[33.742276, "o", "\u001b[?2004h>   const plan = buildPlan(resources, \"feat-a\");\r\n\u001b[?2004l\r"]
[33.743744, "o", "\u001b[?2004h>   assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"other-instance\"] }]);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.ok(!plan.steps.some((s) => s.id === \"other-instance\"));\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"empty and already-deleted environments have empty plans\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan([], \"feat-a\"), { branch: \"feat-a\", steps: [], blocked: [] });\r\n\u001b[?2004l\r\u001b[?2004h>   assert.deepEqual(buildPlan(FIXTURE, \"missing\").steps, []);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> test(\"cycles fail planning instead of issuing an unsafe partial teardown\", () => {\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => buildPlan([\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\r\n\u001b[?2004l\r\u001b[?2004h>   ], \"feat-a\"), /dependency cycle/);\r\n\u001b[?2004l\r\u001b[?2004h>   assert.throws(() => buildPlan([res(\"a\", \"volume\", \"feat-a\", [\"a\"])], \"feat-a\"), /dependency cycle/);\r\n\u001b[?2004l\r\u001b[?2004h> });\r\n\u001b[?2004l\r\u001b[?2004h> EOF\r\n\u001b[?2004l\r"]
