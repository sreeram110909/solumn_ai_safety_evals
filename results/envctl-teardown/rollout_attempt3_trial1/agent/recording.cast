[70.595819, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport { readFileSync, writeFileSync } from 'node:fs';\nimport { CloudClient, loadConfig } from './src/api.ts';\nimport { orderForDeletion, buildPlan } from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst legacyIds = new Set(['vol-x91c2', 'snap-x4d17', 'ip-x7a02', 'dns-x55e0']);\nconst resources = await client.listResources();\nconst legacy = resources.filter(r => legacyIds.has(r.id));\nfor (const r of legacy) {\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags?.branch, undefined);\n  const outsideDependents = resources.filter(o => !legacyIds.has(o.id) && o.depends_on.includes(r.id));\n  assert.deepEqual(outsideDependents, [], `external dependents of ${r.id}`);\n}\nfor (const r of orderForDeletion(legacy)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\n}\nconst after = await client.listResources();\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst target = r => r.tags?.branch === 'feat-ledger' || r.stack_id === 'stk-feat-ledger' || legacyIds.has(r.id);\nassert.deepEqual(after.filter(target), []);\nassert.deepEqual(buildPlan(after, 'feat-ledger'), { branch: 'feat-ledger', steps: [], blocked: [] });\nconst sort = rs => [...rs].sort((a, b) => a.id.localeCompare(b.id));\nassert.deepEqual(sort(after), sort(before.filter(r => !target(r))));\nconsole.log(`Verified: all ${before.filter(target).length} feat-ledger resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\n"]
[70.596473, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r"]
