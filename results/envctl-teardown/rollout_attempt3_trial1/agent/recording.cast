[33.739784, "o", "  const resources = [\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"volume\", \"volume\", \"a\"),\r\n\u001b[?2004l\r"]
[33.739851, "o", "\u001b[?2004h> "]
[33.740022, "o", "    res(\"snapshot\", \"snapshot\", \"a\", [\"volume\"]),\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.740108, "o", "    res(\"instance\", \"instance\", \"a\", [\"volume\", \"external-subnet\"]),"]
[33.740168, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.740379, "o", ">     res(\"dns\", \"dns_record\", \"a\", [\"lb\"]),\r\n\u001b[?2004l\r\u001b[?2004h>     res(\"lb\", \"load_balancer\", \"a\", [\"instance\"]),\r\n\u001b[?2004l\r"]
[33.740568, "o", "\u001b[?2004h> "]
[33.740658, "o", "    res(\"bucket\", \"bucket\", \"a\"),\r\n\u001b[?2004l\r\u001b[?2004h>   ];\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.740694, "o", "  for (const listing of [resources, [...resources].reverse()]) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.740824, "o", "    const order = buildPlan(listing, \"a\").steps.map((s) => s.id);\r\n\u001b[?2004l\r"]
[33.740924, "o", "\u001b[?2004h> "]
[33.741072, "o", "    assert.equal(new Set(order).size, resources.length);\r\n\u001b[?2004l\r\u001b[?2004h>     for (const r of resources) {\r\n\u001b[?2004l\r\u001b[?2004h"]
[33.74111, "o", "> "]
[33.741251, "o", "      for (const dep of r.depends_on.filter((id) => order.includes(id))) {\r\n\u001b[?2004l\r\u001b[?2004h> "]
[33.741463, "o", "        assert.ok(order.indexOf(r.id) < order.indexOf(dep), `${r.id} must precede ${dep}`);\r\n\u001b[?2004l\r\u001b[?2004h"]
