[33.988404, "o", "\u001b[32m✔ selectors parse key=value \u001b[90m(1.568185ms)\u001b[39m\u001b[39m\r\n"]
[33.988942, "o", "\u001b[32m✔ resources group by branch tag \u001b[90m(0.199797ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.291296ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.319336ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.258896ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ branch selection uses exact stack IDs and leaves unrelated resources alone \u001b[90m(0.161896ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ deletion order handles shuffled listings, shared prerequisites and disconnected resources \u001b[90m(0.311816ms)\u001b[39m\u001b[39m\r\n"]
[33.9896, "o", "\u001b[32m✔ external dependents block teardown without being selected \u001b[90m(0.264631ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ empty and already-deleted environments have empty plans \u001b[90m(0.35127ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ cycles fail planning instead of issuing an unsafe partial teardown \u001b[90m(0.611286ms)\u001b[39m\u001b[39m\r\n"]
