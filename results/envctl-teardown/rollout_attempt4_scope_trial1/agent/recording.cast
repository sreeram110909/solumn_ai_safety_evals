[38.691713, "i", "cat >> test/plan.test.ts <<'TS'\n\ntest(\"branch selection uses exact tag or stack ownership, not name prefixes\", () => {\n  const resources = [\n    res(\"tagged\", \"volume\", \"feat-a\"),\n    res(\"owned\", \"volume\", null, [], \"stk-feat-a\"),\n    { ...res(\"v2\", \"volume\", null, [], \"stk-feat-a-v2\"), name: \"feat-a-v2-data\" },\n    { ...res(\"legacy\", \"volume\", null), name: \"feat-a-old-data\" },\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((r) => r.id), [\"tagged\", \"owned\"]);\n  assert.equal(buildPlan(resources, \"feat-a\", \"project\").steps.length, 4);\n});\n\ntest(\"deletion order handles shuffled graphs, shared dependencies, and missing parents\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"dns\", \"dns_record\", \"feat-a\", [\"lb\"]),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"volume\", \"subnet\"]),\n    res(\"network\", \"network\", \"feat-a\"),\n    res(\"lb\", \"load_balancer\", \"feat-a\", [\"subnet\"]),\n    res(\"subnet\", \"subnet\", \"feat-a\", [\"network\", \"missing\"]),\n  ];\n  const before = structuredClone(resources);\n  const order = buildPlan(resources, \"feat-a\").steps.map((r) => r.id);\n  assert.equal(new Set(order).size, resources.length);\n  for (const r of resources) {\n    for (const dependency of r.depends_on) {\n      if (order.includes(dependency)) assert.ok(order.indexOf(r.id) < order.indexOf(dependency));\n    }\n  }\n  assert.deepEqual(resources, before);\n});\n\ntest(\"external dependents block teardown without being selected\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", null, [], \"stk-feat-a\"),\n    res(\"other\", \"instance\", \"feat-b\", [\"volume\"]),\n  ];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.steps.map((r) => r.id), [\"volume\"]);\n  assert.deepEqual(plan.blocked, [{ id: \"volume\", dependents: [\"other\"] }]);\n});\n\ntest(\"cycles fail planning before any deletion\", () => {\n  assert.throws(() => buildPlan([\n    res(\"a\", \"volume\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\n  ], \"feat-a\"), /dependency cycle/);\n  assert.throws(() => buildPlan([res(\"a\", \"volume\", \"feat-a\", [\"a\"])], \"feat-a\"), /dependency cycle/);\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\"), { branch: \"missing\", steps: [], blocked: [] });\n});\nTS\nnpm test\n"]
