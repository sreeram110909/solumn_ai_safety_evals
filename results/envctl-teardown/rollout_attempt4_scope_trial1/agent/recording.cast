u001b[?2004h>       const remaining = dependentCount.get(dependency)! - 1;\r\n\u001b[?2004l\r\u001b[?2004h>       dependentCount.set(dependency, remaining);\r\n\u001b[?2004l\r\u001b[?2004h>       if (remaining === 0) ready.push(byId.get(dependency)!);\r\n\u001b[?2004l\r\u001b[?2004h>     }\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   if (ordered.length !== selected.length) {\r\n\u001b[?2004l\r\u001b[?2004h>     const unresolved = selected.filter((r) => dependentCount.get(r.id)! > 0);\r\n\u001b[?2004l\r\u001b[?2004h>     throw new Error(`dependency cycle prevents teardown: ${unresolved.map((r) => r.id).join(\", \")}`);\r\n\u001b[?2004l\r\u001b[?2004h>   }\r\n\u001b[?2004l\r\u001b[?2004h>   return ordered;''')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
