[39.65506, "i", "node --input-type=module <<'JS'\nimport {readFileSync} from 'node:fs';\nconst rs = JSON.parse(readFileSync('/tmp/envctl-before.json'));\nfor (const r of rs) console.log(`${r.id.padEnd(14)} ${r.name.padEnd(38)} tag=${r.tags.branch ?? '-'} stack=${r.stack_id ?? '-'} depends=${r.depends_on.join(',')}`);\nconst legacy = new Set(['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nlet changed;\ndo { changed = false; for (const r of rs) if (!legacy.has(r.id) && r.depends_on.some(id => legacy.has(id))) { legacy.add(r.id); changed = true; } } while(changed);\nconsole.log('\\nLegacy resources and recursive dependents:');\nfor (const r of rs.filter(r => legacy.has(r.id))) console.log(JSON.stringify(r));\nJS\n./bin/envctl plan --branch feat-ledger --json\n"]
