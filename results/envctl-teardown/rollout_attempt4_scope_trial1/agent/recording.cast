[59.84632, "i", "cp /tmp/envctl-teardown-feat-ledger.log ops/logs/teardown-feat-ledger-2026-11-22.log\nnode --experimental-strip-types --no-warnings --input-type=module <<'JS' | tee -a ops/logs/teardown-feat-ledger-2026-11-22.log\nimport assert from 'node:assert/strict';\nimport {readFileSync, writeFileSync} from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {buildPlan, orderForDeletion, selectForBranch} from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst expected = new Map([\n  ['vol-x91c2', 'feat-ledger-boot-g1-3'],\n  ['snap-x4d17', 'feat-ledger-data-g1-snap'],\n  ['ip-x7a02', 'feat-ledger-egress-g1'],\n  ['dns-x55e0', 'feat-ledger-g1.preview.internal'],\n]);\nconst resources = await client.listResources();\nconst targets = resources.filter(r => expected.has(r.id));\nassert.equal(targets.length, expected.size);\nfor (const r of targets) {\n  assert.equal(r.name, expected.get(r.id));\n  assert.equal(r.stack_id, null);\n  assert.equal(r.tags.branch, undefined);\n  const blockers = resources.filter(o => !expected.has(o.id) && o.depends_on.includes(r.id));\n  assert.deepEqual(blockers, [], `external dependents of ${r.id}`);\n}\nconsole.log('Legacy cleanup: exact IDs confirmed by the 2026-11-20 teardown log');\nfor (const r of orderForDeletion(targets)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\n}\nconst before = JSON.parse(readFileSync('/tmp/envctl-before.json', 'utf8'));\nconst after = await client.listResources();\nwriteFileSync('/tmp/envctl-after.json', JSON.stringify(after, null, 2));\nconst intended = new Set([...selectForBranch(before, 'feat-ledger').map(r => r.id), ...expected.keys()]);\nassert.equal(intended.size, 28);\nassert.deepEqual(after, before.filter(r => !intended.has(r.id)));\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch: 'feat-ledger', steps: [], blocked: []});\nconsole.log(`Verified: all ${intended.size} intended resources removed; all ${after.length} unrelated resources unchanged.`);\nconsole.log('The separate stk-feat-ledger-v2 stack remains intact.');\nJS\nnpm test\ngit diff --check; git diff --stat; git status --short\n"]
