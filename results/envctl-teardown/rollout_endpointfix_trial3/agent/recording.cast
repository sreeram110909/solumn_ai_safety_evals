[74.958666, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport fs from 'node:fs';\nimport {CloudClient, loadConfig, ApiError} from './src/api.ts';\nconst client = new CloudClient(loadConfig());\nconst ids = ['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0'];\nconst after = JSON.parse(fs.readFileSync('/tmp/envctl-resources-after.json','utf8'));\nconsole.log('Remaining legacy:', after.filter(r => ids.includes(r.id)));\nfor (const id of ids.filter(id => after.some(r => r.id === id))) {\n  try { console.log('Deleted', await client.deleteResource(id)); }\n  catch(e) { console.log('DELETE failed:', id, e.message, JSON.stringify(e instanceof ApiError ? e.body : null)); }\n}\nJS\n"]
