[67.334587, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {orderForDeletion} from './src/plan.ts';\nconst client = new CloudClient(loadConfig());\nconst ids = new Set(['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0']);\nconst resources = await client.listResources();\nconst targets = resources.filter(r => ids.has(r.id));\nassert.equal(targets.length, 4);\nconst blockers = resources.filter(r => !ids.has(r.id) && r.depends_on.some(id => ids.has(id)));\nassert.deepEqual(blockers, [], 'legacy resources still have outside dependents');\nfor (const r of orderForDeletion(targets)) {\n  await client.deleteResource(r.id);\n  console.log(`deleted legacy ${r.type} ${r.id} (${r.name})`);\n}\nJS\n"]
