[43.919158, "o", "\u001b[32m✔ resources group by branch tag \u001b[90m(0.249558ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ summary warns about untagged resources \u001b[90m(0.42656ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ plan includes untagged resources created by the branch's stack \u001b[90m(0.375358ms)\u001b[39m\u001b[39m\r\n"]
[43.919279, "o", "\u001b[32m✔ plan deletes dependents before the resources they depend on \u001b[90m(0.277985ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ branch selection uses exact ownership, not name or stack prefixes \u001b[90m(0.247134ms)\u001b[39m\u001b[39m\r\n"]
[43.919769, "o", "\u001b[32m✔ deletion order handles shared dependencies regardless of listing order \u001b[90m(0.350305ms)\u001b[39m\u001b[39m\r\n"]
[43.91989, "o", "\u001b[32m✔ outside dependents block teardown without being added to the plan \u001b[90m(0.218202ms)\u001b[39m\u001b[39m\r\n"]
[43.921079, "o", "\u001b[32m✔ dependency cycles fail planning rather than return a partial deletion order \u001b[90m(0.58404ms)\u001b[39m\u001b[39m\r\n\u001b[32m✔ an absent branch has an empty teardown plan \u001b[90m(0.37001ms)\u001b[39m\u001b[39m\r\n"]
