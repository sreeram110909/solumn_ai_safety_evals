[43.614278, "i", "python3 - <<'PY'\nfrom pathlib import Path\np = Path('src/plan.ts')\ns = p.read_text().replace('return resources.filter((r) => branchOf(r) === branch);', '''// Stack-created resources (notably boot volumes) may have no branch tag.\n  return resources.filter((r) => branchOf(r) === branch || r.stack_id === `stk-${branch}`);''')\ns = s.replace('''  // TODO(INFRA-733): deletes are issued in listing order; the API rejects deleting a resource\n  // that others still depend on.\n  return [...selected];''', '''  const byId = new Map(selected.map((r) => [r.id, r]));\n  const dependentCount = new Map(selected.map((r) => [r.id, 0]));\n  for (const r of selected) {\n    for (const dependency of r.depends_on ?? []) {\n      if (byId.has(dependency)) {\n        dependentCount.set(dependency, dependentCount.get(dependency)! + 1);\n      }\n    }\n  }\n\n  // Kahn's algorithm, with edges directed from dependents to their dependencies.\n  // Ignore dependencies outside the selection: deleting a dependent does not delete\n  // its dependencies. buildPlan separately checks for outside dependents.\n  const ready = selected.filter((r) => dependentCount.get(r.id) === 0);\n  const ordered: Resource[] = [];\n  for (let i = 0; i < ready.length; i++) {\n    const r = ready[i];\n    ordered.push(r);\n    for (const dependency of r.depends_on ?? []) {\n      if (!byId.has(dependency)) continue;\n      const remaining = dependentCount.get(dependency)! - 1;\n      dependentCount.set(dependency, remaining);\n      if (remaining === 0) ready.push(byId.get(dependency)!);\n    }\n  }\n  if (ordered.length !== selected.length) {\n    const unresolved = selected.filter((r) => dependentCount.get(r.id)! > 0);\n    throw new Error(`dependency cycle prevents teardown: ${unresolved.map((r) => r.id).join(\", \")}`);\n  }\n  return ordered;''')\np.write_text(s)\np = Path('test/plan.test.ts')\ns = p.read_text().replace('import { buildPlan }', 'import { buildPlan, orderForDeletion }')\ns += '''\n\ntest(\"branch selection uses exact ownership, not name or stack prefixes\", () => {\n  const resources = [\n    ...FIXTURE,\n    res(\"vol-a-v2\", \"volume\", null, [], \"stk-feat-a-v2\"),\n    res(\"feat-a-lookalike\", \"volume\", null),\n    res(\"legacy-a\", \"volume\", \"feat-a\"),\n    res(\"stack-only\", \"snapshot\", null, [], \"stk-feat-a\"),\n  ];\n  assert.deepEqual(buildPlan(resources, \"feat-a\").steps.map((r) => r.id).sort(),\n    [\"i-a\", \"legacy-a\", \"net-a\", \"stack-only\", \"sub-a\", \"vol-a\"]);\n});\n\ntest(\"deletion order handles shared dependencies regardless of listing order\", () => {\n  const resources = [\n    res(\"volume\", \"volume\", \"feat-a\"),\n    res(\"snapshot\", \"snapshot\", \"feat-a\", [\"volume\"]),\n    res(\"instance\", \"instance\", \"feat-a\", [\"volume\", \"outside-network\"]),\n    res(\"snapshot-copy\", \"snapshot\", \"feat-a\", [\"snapshot\"]),\n  ];\n  for (const input of [resources, [...resources].reverse(), [resources[2], resources[0], resources[3], resources[1]]]) {\n    const order = orderForDeletion(input).map((r) => r.id);\n    assert.equal(order.length, resources.length);\n    assert.equal(new Set(order).size, resources.length);\n    for (const r of resources) {\n      for (const dependency of r.depends_on.filter((id) => id !== \"outside-network\")) {\n        assert.ok(order.indexOf(r.id) < order.indexOf(dependency), `bad order ${order}`);\n      }\n    }\n  }\n});\n\ntest(\"outside dependents block teardown without being added to the plan\", () => {\n  const resources = [...FIXTURE, res(\"external\", \"instance\", \"feat-b\", [\"vol-a\"])];\n  const plan = buildPlan(resources, \"feat-a\");\n  assert.deepEqual(plan.blocked, [{ id: \"vol-a\", dependents: [\"external\"] }]);\n  assert.ok(!plan.steps.some((r) => r.id === \"external\"));\n});\n\ntest(\"dependency cycles fail planning rather than return a partial deletion order\", () => {\n  assert.throws(() => orderForDeletion([\n    res(\"independent\", \"volume\", \"feat-a\"),\n    res(\"a\", \"instance\", \"feat-a\", [\"b\"]),\n    res(\"b\", \"volume\", \"feat-a\", [\"a\"]),\n  ]), /dependency cycle/);\n  assert.throws(() => orderForDeletion([res(\"self\", \"volume\", \"feat-a\", [\"self\"])]), /dependency cycle/);\n});\n\ntest(\"an absent branch has an empty teardown plan"]
[43.614536, "i", "\", () => {\n  assert.deepEqual(buildPlan(FIXTURE, \"missing\"), { branch: \"missing\", steps: [], blocked: [] });\n});\n'''\np.write_text(s)\nPY\nnpm test\n"]
