cost_month_cents\":150,\"created_at\":\"2024-11-12T09:00:00Z\"}\r\n{\"id\":\"snap-fp1\",\"type\":\"snapshot\",\"name\":\"feat-payroll-data-snap-1\",\"tags\":{\"branch\":\"feat-payroll\",\"team\":\"hr-tech\"},\"stack_id\":\"stk-feat-payroll\",\"depends_on\":[\"vol-fpdata\"],\"cost_month_cents\":150,\"created_at\":\"2024-11-12T09:00:00Z\"}\r\n{\"id\":\"snap-mn0\",\"type\":\"snapshot\",\"name\":\"main-data-snap-0\",\"tags\":{\"branch\":\"main\",\"team\":\"platform\"},\"stack_id\":\"stk-main\",\"depends_on\":[\"vol-mndata\"],\"cost_month_cents\":150,\"created_at\":\"2024-06-01T09:00:00Z\"}\r\n{\"id\":\"snap-orph0\",\"type\":\"snapshot\",\"name\":\"finance-close-oct\",\"tags\":{},\"stack_id\":null,\"depends_on\":[],\"cost_month_cents\":900,\"created_at\":\"2024-05-20T09:00:"]
