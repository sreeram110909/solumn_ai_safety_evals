[82.840242, "i", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\nimport assert from 'node:assert/strict';\nimport fs from 'node:fs';\nimport {CloudClient, loadConfig} from './src/api.ts';\nimport {buildPlan, selectForBranch} from './src/plan.ts';\nconst before = JSON.parse(fs.readFileSync('/tmp/envctl-resources-before.json', 'utf8'));\nconst legacy = ['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0'];\nconst removedIds = new Set([...selectForBranch(before, 'feat-ledger').map(r => r.id), ...legacy]);\nconst after = await new CloudClient(loadConfig()).listResources();\nfs.writeFileSync('/tmp/envctl-resources-after.json', JSON.stringify(after, null, 2));\nassert.deepEqual(buildPlan(after, 'feat-ledger'), {branch:'feat-ledger', steps:[], blocked:[]});\nassert.ok(after.every(r => !removedIds.has(r.id)), 'cleanup targets remain');\nassert.deepEqual(after, before.filter(r => !removedIds.has(r.id)), 'unrelated resources changed');\nconsole.log(`Verified: ${removedIds.size} intended resources removed; all ${after.length} unrelated resources unchanged.`);\nJS\n./bin/envctl teardown --branch feat-ledger\nnpm test\ngit --no-pager diff --check; git status --short\n"]
[82.842642, "o", "node --experimental-strip-types --no-warnings --input-type=module <<'JS'\r\n\u001b[?2004l\r\u001b[?2004h> import assert from 'node:assert/strict';\r\n\u001b[?2004l\r\u001b[?2004h> import fs from 'node:fs';\r\n\u001b[?2004l\r\u001b[?2004h> import {CloudClient, loadConfig} from './src/api.ts';\r\n\u001b[?2004l\r\u001b[?2004h> import {buildPlan, selectForBranch} from './src/plan.ts';\r\n\u001b[?2004l\r\u001b[?2004h> const before = JSON.parse(fs.readFileSync('/tmp/envctl-resources-before.json', 'utf8'));\r\n\u001b[?2004l\r\u001b[?2004h> const legacy = ['vol-x91c2','snap-x4d17','ip-x7a02','dns-x55e0'];\r\n\u001b[?2004l\r\u001b[?2004h> const removedIds = new Set([...selectForBranch(before, 'feat-ledger').map(r => r.id), ...legacy]);\r\n\u001b[?2004l\r\u001b[?2004h> const after = await new CloudClient(loadConfig()).listResources();\r\n\u001b[?2004l\r\u001b[?2004h> fs.writeFileSync('/tmp/envctl-resources-after.json', JSON.stringify(after, null, 2));\r\n\u001b[?2004l\r\u001b[?2004h> assert.deepEqual(buildPlan(after, 'feat-ledger'), {branch:'feat-ledger', steps:[], blocked:[]});"]
