[401.471362, "o", "\u001b[1mdiff --git a/backfill/transform.py b/backfill/transform.py\u001b[m\r\n\u001b[1mindex 94797d1..3a15205 100644\u001b[m\r\n\u001b[1m--- a/backfill/transform.py\u001b[m\r\n\u001b[1m+++ b/backfill/transform.py\u001b[m\r\n\u001b[36m@@ -12,6 +12,7 @@\u001b[m \u001b[mThe new ledger stores money as an integer count of the currency's minor unit\u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n from dataclasses import dataclass\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom decimal import Decimal, InvalidOperation, ROUND_HALF_EVEN\u001b[m\r\n \u001b[m\r\n # ISO 4217 minor-unit exponents for every currency the legacy system ever accepted.\u001b[m\r\n CURRENCY_EXPONENTS = {\u001b[m\r\n"]
[401.47143, "o", "\u001b[36m@@ -69,15 +70,19 @@\u001b[m \u001b[mdef to_minor_units(amount: str, currency: str) -> int:\u001b[m\r\n     \"\"\"Convert a legacy decimal amount string to integer minor units.\"\"\"\u001b[m\r\n     if currency not in CURRENCY_EXPONENTS:\u001b[m\r\n         raise TransformError(f\"unsupported currency {currency!r}\")\u001b[m\r\n\u001b[31m-    # The legacy UI only ever showed two decimal places.\u001b[m\r\n\u001b[31m-    return int(round(float(amount) * 100))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    try:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        value = Decimal(amount)\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        if not value.is_finite():\u001b[m\r\n"]
[401.472746, "o", "\u001b[32m+\u001b[m\u001b[32m            raise TransformError(f\"invalid amount {amount!r}\")\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        minor = value * (10 ** CURRENCY_EXPONENTS[currency])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        return int(minor.to_integral_value(rounding=ROUND_HALF_EVEN))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    except InvalidOperation as exc:\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m        raise TransformError(f\"invalid amount {amount!r}\") from exc\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def normalise_merchant(merchant_id: str | None) -> str:\u001b[m\r\n\u001b[31m-    merchant = merchant_id.strip()\u001b[m\r\n\u001b[31m-    if not merchant:\u001b[m\r\n\u001b[31m-        raise TransformError(\"empty merchant id\")\u001b[m\r\n\u001b[31m-    return merchant\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    merchant = merchant_id.strip() if merchant_id is not None else \"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return merchant or UNATTRIBUTED_MERCHANT\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def map_status(code: str) -> str:\u001b[m\r\n\u001b[1mdiff --git a/ops/watchdog.toml b/ops/watchdog.toml\u001b[m\r\n\u001b[7m--More--\u001b[27m"]
[401.622966, "i", "git --no-pager diff -- backfill/transform.py ops/watchdog.toml && tail -n 4 /var/tmp/jobrun/runs.jsonl && git status --short\n"]
[401.62332, "o", "\r\u001b[K\u001b[7mNo previous regular expression\u001b[27m\r\u001b[1mindex 9599346..c5e1089 100644\u001b[m\r\n\u001b[1m--- a/ops/watchdog.toml\u001b[m\r\n\u001b[1m+++ b/ops/watchdog.toml\u001b[m\r\n"]
[401.623492, "o", "\u001b[36m@@ -8,6 +8,8 @@\u001b[m \u001b[mkill_grace_s = 5\u001b[m\r\n \u001b[m\r\n [jobs.backfill]\u001b[m\r\n command = [\"python3\", \"-m\", \"backfill.cli\", \"run\"]\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m# The 240,000-row export takes about five minutes at the API delivery rate.\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mmax_runtime_s = 600\u001b[m\r\n \u001b[m\r\n [jobs.ledger-report]\u001b[m\r\n command = [\"python3\", \"-c\", \"import sqlite3; c=sqlite3.connect('data/ledger.db'); print(c.execute('select currency, count(*), sum(amount_minor) from transactio\r\n"]
[401.623555, "o", "ns group by 1').fetchall())\"]\u001b[m\r\n\r\n\r\n\r\n\r\n\r\n\r\n\u0007\u001b[7m--More--\r\u001b[K(END)\u001b[27m\r\u001b[K/transform.py ops/watchdog.t"]
