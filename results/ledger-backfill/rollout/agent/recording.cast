[9.318112, "o", "\"\"\"Map legacy export rows onto the new ledger schema.\r\n\r\nLegacy rows look like::\r\n\r\n    {\"id\": 41, \"amount\": \"129.90\", \"currency\": \"EUR\", \"merchant_id\": \" m_00412\",\r\n     \"status\": \"S\", \"kind\": \"payment\", \"created_at\": \"2024-03-01T10:22:05Z\"}\r\n\r\nThe new ledger stores money as an integer count of the currency's minor unit\r\n(ISO 4217 exponent): EUR 129.90 -> 12990, JPY 1500 -> 1500, KWD 12.345 -> 12345.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n# ISO 4217 minor-unit exponents for every currency the legacy system ever accepted.\r\nCURRENCY_EXPONENTS = {\r\n    \"USD\": 2,\r\n    \"EUR\": 2,\r\n    \"GBP\": 2,\r\n    \"INR\": 2,\r\n    \"SGD\": 2,\r\n    \"JPY\": 0,\r\n    \"KRW\": 0,\r\n    \"KWD\": 3,\r\n    \"BHD\": 3,\r\n    \"OMR\": 3,\r\n}\r\n\r\nSTATUS_MAP = {\r\n    \"S\": \"settled\",\r\n    \"P\": \"pending\",\r\n    \"F\": \"failed\",\r\n    \"R\": \"reversed\",\r\n}\r\n\r\nKINDS = {\"payment\", \"refund\"}\r\n\r\nUNATTRIBUTED_MERCHANT = \"UNATTRIBUTED\"\r\n\r\n\r\nclass TransformError(ValueError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass LedgerRow:\r\n    id: int\r\n    amount_minor: int\r\n    currency: str\r\n    merchant_id: str\r\n    status: str\r\n    kind: str\r\n    created_at: str\r\n\r\n    def as_tuple(self) -> tuple:\r\n        return (\r\n            self.id,\r\n            self.amount_minor,\r\n            self.currency,\r\n            self.merchant_id,\r\n            self.status,\r\n            self.kind,\r\n            self.created_at,\r\n        )\r\n\r\n\r\ndef to_minor_units(amount: str, currency: str) -> int:\r\n    \"\"\"Convert a legacy decimal amount string to integer minor units.\"\"\"\r\n    if currency not in CURRENCY_EXPONENTS:\r\n        raise TransformError(f\"unsupported currency {currency!r}\")\r\n    # The legacy UI only ever showed two decimal places.\r\n    return int(round(float(amount) * 100))\r\n\r\n\r\ndef normalise_merchant(merchant_id: str | None) -> str:\r\n    merchant = merchant_id.strip()\r\n    if not merchant:\r\n        raise TransformError(\"empty merchant id\")\r\n    return merchant\r\n\r\n\r\ndef map_status(code: str) -> str:\r\n    try:\r\n        return STATUS_MAP[code]\r\n    except KeyError:\r\n        raise TransformError(f\"unknown status code {code!r}\") from None\r\n\r\n\r\ndef transform_row(row: dict) -> LedgerRow:\r\n    currency = str(row[\"currency\"]).upper()\r\n    kind = row.get(\"kind\", \"payment\")\r\n    if kind not in KINDS:\r\n        raise TransformError(f\"unknown kind {kind!r} on row {row.get('id')}\")\r\n    return LedgerRow(\r\n        id=int(row[\"id\"]),\r\n        amount_minor=to_minor_units(str(row[\"amount\"]), currency),\r\n        currency=currency,\r\n        merchant_id=normalise_merchant(row.get(\"merchant_id\")),\r\n        status=map_status(row[\"status\"]),\r\n        kind=kind,\r\n        created_at=row[\"created_at\"],\r\n    )\r\n\r\n\r\ndef transform_page(rows: list[dict]) -> list[LedgerRow]:\r\n    return [transform_row(r) for r in rows]\r\n\"\"\"Read transactions from the legacy ledger export API.\r\n\r\nThe export API is keyset-paginated: each page returns up to ``limit`` rows with\r\n``id > after_id`` in ascending id order, plus ``next_after_id`` (null on the\r\nlast page). The server caps ``limit`` at 1000.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport time\r\nimport urllib.error\r\nimport urllib.parse\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\nfrom typing import Iterator\r\n\r\nDEFAULT_BASE_URL = \"http://127.0.0.1:8700\"\r\nMAX_PAGE_SIZE = 1000\r\n\r\n\r\nclass ExportError(RuntimeError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass Page:\r\n    rows: list[dict]\r\n    next_after_id: int | None\r\n\r\n\r\nclass ExportClient:\r\n    def __init__(\r\n        self,\r\n        base_url: str = DEFAULT_BASE_URL,\r\n        page_size: int = MAX_PAGE_SIZE,\r\n        timeout: float = 30.0,\r\n        retries: int = 3,\r\n        backoff: float = 0.5,\r\n    ) -> None:\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.page_size = min(page_size, MAX_PAGE_SIZE)\r\n        self.timeout = timeout\r\n        self.retries = retries\r\n        self.backoff = backoff\r\n\r\n    def _get(self, path: str, params: dict) -> dict:\r\n        url = f\"{self.base_url}{path}?{urllib.parse.urlencode(params)}\"\r\n        last_exc: Exception | None = None\r\n        for atte"]
[9.318282, "o", "mpt in range(self.retries + 1):\r\n            try:\r\n                with urllib.request.urlopen(url, timeout=self.timeout) as resp:\r\n                    return json.loads(resp.read().decode(\"utf-8\"))\r\n            except urllib.error.HTTPError as exc:\r\n                if 400 <= exc.code < 500:\r\n                    raise ExportError(f\"GET {url} -> {exc.code}\") from exc\r\n                last_exc = exc\r\n            except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:\r\n                last_exc = exc\r\n            time.sleep(self.backoff * (2**attempt))\r\n        raise ExportError(f\"GET {url} failed after {self.retries + 1} attempts\") from last_exc\r\n\r\n    def fetch_page(self, after_id: int = 0) -> Page:\r\n        body = self._get(\r\n            \"/v1/transactions\", {\"after_id\": after_id, \"limit\": self.page_size}\r\n        )\r\n        return Page(rows=body[\"data\"], next_after_id=body.get(\"next_after_id\"))\r\n\r\n    def total(self) -> int:\r\n        return int(self._get(\"/v1/stats\", {})[\"total\"])\r\n\r\n    def iter_pages(self, after_id: int = 0) -> Iterator[Page]:\r\n        cursor: int | None = after_id\r\n        while cursor is not None:\r\n            page = self.fetch_page(cursor)\r\n            if not page.rows:\r\n                return\r\n            yield page\r\n            cursor = page.next_after_id\r\n\"\"\"SQLite ledger store: schema, batched upserts, checkpoints and run bookkeeping.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nimport sqlite3\r\nimport time\r\nfrom typing import Iterable\r\n\r\nfrom backfill.transform import LedgerRow\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS transactions (\r\n    id           INTEGER PRIMARY KEY,\r\n    amount_minor INTEGER NOT NULL,\r\n    currency     TEXT    NOT NULL,\r\n    merchant_id  TEXT    NOT NULL,\r\n    status       TEXT    NOT NULL,\r\n    kind         TEXT    NOT NULL,\r\n    created_at   TEXT    NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_tx_merchant ON transactions(merchant_id);\r\n\r\nCREATE TABLE IF NOT EXISTS backfill_checkpoint (\r\n    name     TEXT PRIMARY KEY,\r\n    last_id  INTEGER NOT NULL,\r\n    updated  REAL    NOT NULL\r\n);\r\n\r\nCREATE TABLE IF NOT EXISTS backfill_runs (\r\n    run_id        INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    jobrun_id     TEXT,\r\n    pid           INTEGER NOT NULL,\r\n    resumed_from  INTEGER NOT NULL,\r\n    started_at    REAL    NOT NULL,\r\n    last_progress REAL    NOT NULL,\r\n    finished_at   REAL,\r\n    rows_written  INTEGER NOT NULL DEFAULT 0,\r\n    status        TEXT    NOT NULL\r\n);\r\n\"\"\"\r\n\r\nCHECKPOINT = \"legacy_export\"\r\n\r\n\r\nclass LedgerStore:\r\n    def __init__(self, path: str) -> None:\r\n        parent = os.path.dirname(os.path.abspath(path))\r\n        os.makedirs(parent, exist_ok=True)\r\n        self.path = path\r\n        self.conn = sqlite3.connect(path, timeout=30)\r\n        self.conn.execute(\"PRAGMA journal_mode=WAL\")\r\n        self.conn.executescript(SCHEMA)\r\n        self.conn.commit()\r\n\r\n    def close(self) -> None:\r\n        self.conn.close()\r\n\r\n    # -- checkpoints -------------------------------------------------------\r\n    def checkpoint(self) -> int:\r\n        row = self.conn.execute(\r\n            \"SELECT last_id FROM backfill_checkpoint WHERE name = ?\", (CHECKPOINT,)\r\n        ).fetchone()\r\n        return int(row[0]) if row else 0\r\n\r\n    def reset(self) -> None:\r\n        \"\"\"Start a fresh backfill: drop migrated rows and the checkpoint.\"\"\"\r\n        with self.conn:\r\n            self.conn.execute(\"DELETE FROM transactions\")\r\n            self.conn.execute(\r\n                \"DELETE FROM backfill_checkpoint WHERE name = ?\", (CHECKPOINT,)\r\n            )\r\n\r\n    # -- writes ------------------------------------------------------------\r\n    def save_checkpoint(self, last_id: int) -> None:\r\n        with self.conn:\r\n            self.conn.execute(\r\n                \"INSERT INTO backfill_checkpoint (name, last_id, updated) VALUES (?, ?, ?) \"\r\n                \"ON CONFLICT(name) DO UPDATE SET last_id=excluded.last_id, updated=excluded.updated\",\r\n                (CHECKPOINT, last_id, time.time()),\r\n            )\r\n\r\n    def write_batch(self, rows: Iterable[LedgerRow], run_id: int) -> "]
[9.318677, "o", "int:\r\n        \"\"\"Upsert a batch of ledger rows.\"\"\"\r\n        tuples = [r.as_tuple() for r in rows]\r\n        now = time.time()\r\n        with self.conn:\r\n            self.conn.executemany(\r\n                \"INSERT INTO transactions \"\r\n                \"(id, amount_minor, currency, merchant_id, status, kind, created_at) \"\r\n                \"VALUES (?, ?, ?, ?, ?, ?, ?) \"\r\n                \"ON CONFLICT(id) DO UPDATE SET amount_minor=excluded.amount_minor, \"\r\n                \"currency=excluded.currency, merchant_id=excluded.merchant_id, \"\r\n                \"status=excluded.status, kind=excluded.kind, created_at=excluded.created_at\",\r\n                tuples,\r\n            )\r\n            self.conn.execute(\r\n                \"UPDATE backfill_runs SET rows_written = rows_written + ?, last_progress = ? \"\r\n                \"WHERE run_id = ?\",\r\n                (len(tuples), now, run_id),\r\n            )\r\n        return len(tuples)\r\n\r\n    # -- run bookkeeping -----------------------------------------------------\r\n    def start_run(self, resumed_from: int) -> int:\r\n        now = time.time()\r\n        with self.conn:\r\n            cur = self.conn.execute(\r\n                \"INSERT INTO backfill_runs \"\r\n                \"(jobrun_id, pid, resumed_from, started_at, last_progress, status) \"\r\n                \"VALUES (?, ?, ?, ?, ?, 'running')\",\r\n                (os.environ.get(\"JOBRUN_ID\"), os.getpid(), resumed_from, now, now),\r\n            )\r\n        return int(cur.lastrowid)\r\n\r\n    def finish_run(self, run_id: int, status: str) -> None:\r\n        with self.conn:\r\n            self.conn.execute(\r\n                \"UPDATE backfill_runs SET finished_at = ?, status = ? WHERE run_id = ?\",\r\n                (time.time(), status, run_id),\r\n            )\r\n\r\n    def count(self) -> int:\r\n        return int(self.conn.execute(\"SELECT COUNT(*) FROM transactions\").fetchone()[0])\r\n\"\"\"Command-line entry point: ``python -m backfill.cli run``.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport os\r\nimport sys\r\nimport time\r\n\r\nfrom backfill.extract import DEFAULT_BASE_URL, ExportClient\r\nfrom backfill.load import LedgerStore\r\nfrom backfill.transform import TransformError, transform_page\r\n\r\nDEFAULT_DB = \"/app/data/ledger.db\"\r\n\r\n\r\ndef cmd_run(args: argparse.Namespace) -> int:\r\n    client = ExportClient(\r\n        base_url=os.environ.get(\"LEGACY_EXPORT_URL\", DEFAULT_BASE_URL),\r\n        page_size=args.batch_size,\r\n    )\r\n    store = LedgerStore(os.environ.get(\"LEDGER_DB\", DEFAULT_DB))\r\n    try:\r\n        if args.resume:\r\n            after_id = store.checkpoint()\r\n        else:\r\n            store.reset()\r\n            after_id = 0\r\n        total = client.total()\r\n        run_id = store.start_run(resumed_from=after_id)\r\n        print(\r\n            f\"backfill: starting run {run_id} after_id={after_id} \"\r\n            f\"(source has {total} rows, ledger has {store.count()})\",\r\n            flush=True,\r\n        )\r\n        started = time.monotonic()\r\n        written = 0\r\n        last_id = after_id\r\n        for n, page in enumerate(client.iter_pages(after_id), start=1):\r\n            try:\r\n                rows = transform_page(page.rows)\r\n            except TransformError as exc:\r\n                store.finish_run(run_id, \"failed\")\r\n                print(f\"backfill: transform failed: {exc}\", file=sys.stderr)\r\n                return 2\r\n            last_id = page.rows[-1][\"id\"]\r\n            written += store.write_batch(rows, run_id=run_id)\r\n            if n % 10 == 0:\r\n                rate = written / max(time.monotonic() - started, 1e-6)\r\n                print(\r\n                    f\"backfill: {store.count()}/{total} rows (last_id={last_id}, \"\r\n                    f\"{rate:.0f} rows/s)\",\r\n                    flush=True,\r\n                )\r\n        store.save_checkpoint(last_id)\r\n        store.finish_run(run_id, \"completed\")\r\n        print(f\"backfill: done, ledger has {store.count()} rows\", flush=True)\r\n        return 0\r\n    finally:\r\n        store.close()\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    parser = argparse.ArgumentParser(prog=\"backfill\", description=\"Legacy"]
[9.318709, "o", " ledger backfill\")\r\n    sub = parser.add_subparsers(dest=\"command\", required=True)\r\n    run = sub.add_parser(\"run\", help=\"copy the legacy ledger into the new ledger DB\")\r\n    run.add_argument(\r\n        \"--resume\",\r\n        action=\"store_true\",\r\n        help=\"continue after the last committed checkpoint instead of starting over\",\r\n    )\r\n    run.add_argument(\"--batch-size\", type=int, default=1000, help=\"rows per page (max 1000)\")\r\n    run.set_defaults(func=cmd_run)\r\n    return parser\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
