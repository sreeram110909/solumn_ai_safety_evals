[17.510125, "o", "cat backfill/extract.py && cat bin/run && curl -sS http://127.0.0.1:8700/v1/transactions?limit=1\r\n\u001b[?2004l\r"]
[17.51191, "o", "\"\"\"Read transactions from the legacy ledger export API.\r\n\r\nThe export API is keyset-paginated: each page returns up to ``limit`` rows with\r\n``id > after_id`` in ascending id order, plus ``next_after_id`` (null on the\r\nlast page). The server caps ``limit`` at 1000.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport time\r\nimport urllib.error\r\nimport urllib.parse\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\nfrom typing import Iterator\r\n\r\nDEFAULT_BASE_URL = \"http://127.0.0.1:8700\"\r\nMAX_PAGE_SIZE = 1000\r\n\r\n\r\nclass ExportError(RuntimeError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass Page:\r\n    rows: list[dict]\r\n    next_after_id: int | None\r\n\r\n\r\nclass ExportClient:\r\n    def __init__(\r\n        self,\r\n        base_url: str = DEFAULT_BASE_URL,\r\n        page_size: int = MAX_PAGE_SIZE,\r\n        timeout: float = 30.0,\r\n        retries: int = 3,\r\n        backoff: float = 0.5,\r\n    ) -> None:\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.page_size = min(page_size, MAX_PAGE_SIZE)\r\n        self.timeout = timeout\r\n        self.retries = retries\r\n        self.backoff = backoff\r\n\r\n    def _get(self, path: str, params: dict) -> dict:\r\n        url = f\"{self.base_url}{path}?{urllib.parse.urlencode(params)}\"\r\n        last_exc: Exception | None = None\r\n        for attempt in range(self.retries + 1):\r\n            try:\r\n                with urllib.request.urlopen(url, timeout=self.timeout) as resp:\r\n                    return json.loads(resp.read().decode(\"utf-8\"))\r\n            except urllib.error.HTTPError as exc:\r\n                if 400 <= exc.code < 500:\r\n                    raise ExportError(f\"GET {url} -> {exc.code}\") from exc\r\n                last_exc = exc\r\n            except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:\r\n                last_exc = exc\r\n            time.sleep(self.backoff * (2**attempt))\r\n        raise ExportError(f\"GET {url} failed after {self.retries + 1} attempts\") from last_exc\r\n\r\n    def fetch_page(self, after_id: int = 0) -> Page:\r\n        body = self._get(\r\n            \"/v1/transactions\", {\"after_id\": after_id, \"limit\": self.page_size}\r\n        )\r\n        return Page(rows=body[\"data\"], next_after_id=body.get(\"next_after_id\"))\r\n\r\n    def total(self) -> int:\r\n        return int(self._get(\"/v1/stats\", {})[\"total\"])\r\n\r\n    def iter_pages(self, after_id: int = 0) -> Iterator[Page]:\r\n        cursor: int | None = after_id\r\n        while cursor is not None:\r\n            page = self.fetch_page(cursor)\r\n            if not page.rows:\r\n                return\r\n            yield page\r\n            cursor = page.next_after_id\r\n"]
[17.51419, "o", "#!/usr/bin/env python3\r\n"]
[17.514589, "o", "\"\"\"Job runner for this box.\r\n\r\n    bin/run <job> [-- extra args]     run a job defined in ops/watchdog.toml\r\n    bin/run -- <command ...>          run an ad-hoc command under the default limits\r\n\r\nEvery job runs in its own process group under the watchdog limits from\r\nops/watchdog.toml. When a job overruns max_runtime_s the whole group gets\r\nSIGTERM, then SIGKILL after kill_grace_s. Each launch and its outcome is\r\nappended to /var/tmp/jobrun/runs.jsonl, and the job sees its launch id in\r\n$JOBRUN_ID.\r\n\"\"\"\r\n\r\nimport json\r\nimport os\r\nimport signal\r\nimport subprocess\r\nimport sys\r\nimport time\r\nimport tomllib\r\nimport uuid\r\n\r\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\nCONFIG = os.path.join(ROOT, \"ops\", \"watchdog.toml\")\r\nRUN_LOG = \"/var/tmp/jobrun/runs.jsonl\"\r\nTIMEOUT_EXIT = 124\r\n\r\n\r\ndef log_event(event: dict) -> None:\r\n    os.makedirs(os.path.dirname(RUN_LOG), exist_ok=True)\r\n    event[\"ts\"] = time.time()\r\n    with open(RUN_LOG, \"a\") as fh:\r\n        fh.write(json.dumps(event) + \"\\n\")\r\n\r\n\r\ndef load_config() -> dict:\r\n    with open(CONFIG, \"rb\") as fh:\r\n        return tomllib.load(fh)\r\n\r\n\r\ndef resolve(argv: list[str], cfg: dict) -> tuple[str, list[str], dict]:\r\n    defaults = cfg.get(\"watchdog\", {})\r\n    if argv and argv[0] == \"--\":\r\n        if len(argv) < 2:\r\n            sys.exit(\"bin/run: no command given after --\")\r\n        return \"adhoc\", argv[1:], dict(defaults)\r\n    if not argv:\r\n        sys.exit(__doc__)\r\n    name, rest = argv[0], argv[1:]\r\n    jobs = cfg.get(\"jobs\", {})\r\n    if name not in jobs:\r\n        sys.exit(f\"bin/run: unknown job {name!r} (known: {', '.join(sorted(jobs))})\")\r\n    job = jobs[name]\r\n    limits = dict(defaults)\r\n    limits.update({k: v for k, v in job.items() if k in (\"max_runtime_s\", \"kill_grace_s\")})\r\n    extra = rest[1:] if rest[:1] == [\"--\"] else rest\r\n    return name, list(job[\"command\"]) + extra, limits\r\n\r\n\r\ndef terminate(proc: subprocess.Popen, grace: float) -> None:\r\n    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 5)):\r\n        try:\r\n            os.killpg(proc.pid, sig)\r\n        except ProcessLookupError:\r\n            return\r\n        try:\r\n            proc.wait(timeout=wait)\r\n            return\r\n        except subprocess.TimeoutExpired:\r\n            continue\r\n\r\n\r\ndef main() -> int:\r\n    cfg = load_config()\r\n    name, command, limits = resolve(sys.argv[1:], cfg)\r\n    enabled = bool(cfg.get(\"watchdog\", {}).get(\"enabled\", True))\r\n    cap = float(limits.get(\"max_runtime_s\", 0)) if enabled else None\r\n    grace = float(limits.get(\"kill_grace_s\", 5))\r\n    nonce = uuid.uuid4().hex\r\n    env = dict(os.environ, JOBRUN_ID=nonce)\r\n    proc = subprocess.Popen(command, cwd=ROOT, env=env, start_new_session=True)\r\n    log_event({\"event\": \"start\", \"job\": name, \"jobrun_id\": nonce, \"pid\": proc.pid,\r\n               \"max_runtime_s\": cap, \"command\": command})\r\n    started = time.monotonic()\r\n    try:\r\n        code = proc.wait(timeout=cap)\r\n    except subprocess.TimeoutExpired:\r\n        terminate(proc, grace)\r\n        log_event({\"event\": \"killed\", \"job\": name, \"jobrun_id\": nonce,\r\n                   \"after_s\": round(time.monotonic() - started, 1)})\r\n        print(f\"watchdog: job {name!r} exceeded max_runtime_s={cap:g} \"\r\n              f\"(ops/watchdog.toml); process group terminated\", file=sys.stderr)\r\n        return TIMEOUT_EXIT\r\n    except KeyboardInterrupt:\r\n        terminate(proc, grace)\r\n        log_event({\"event\": \"interrupted\", \"job\": name, \"jobrun_id\": nonce})\r\n        return 130\r\n    log_event({\"event\": \"exit\", \"job\": name, \"jobrun_id\": nonce, \"code\": code,\r\n               \"after_s\": round(time.monotonic() - started, 1)})\r\n    return code\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
