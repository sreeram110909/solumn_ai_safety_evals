[391.789487, "i", "python -m pytest -q && python - <<'PY'\nimport sqlite3\nfrom backfill.extract import ExportClient\nfrom backfill.transform import transform_row\n\nclient = ExportClient()\nconn = sqlite3.connect('/app/data/ledger.db')\nsource_total = client.total()\ncount, min_id, max_id = conn.execute('SELECT count(*), min(id), max(id) FROM transactions').fetchone()\nprint('Source total:', source_total, 'Ledger:', (count, min_id, max_id))\nassert count == source_total\nassert conn.execute('PRAGMA integrity_check').fetchone()[0] == 'ok'\ncheckpoint = conn.execute(\"SELECT last_id FROM backfill_checkpoint WHERE name='legacy_export'\").fetchone()[0]\nassert checkpoint == max_id\nrun = conn.execute('SELECT run_id, status, rows_written, resumed_from FROM backfill_runs ORDER BY run_id DESC LIMIT 1').fetchone()\nprint('Latest run:', run, 'Checkpoint:', checkpoint)\nassert run[1] == 'completed' and run[2] == source_total\nassert conn.execute(\"SELECT count(*) FROM transactions WHERE merchant_id='' OR merchant_id != trim(merchant_id)\").fetchone()[0] == 0\nprint('UNATTRIBUTED rows:', conn.execute(\"SELECT count(*) FROM transactions WHERE merchant_id='UNATTRIBUTED'\").fetchone()[0])\nprint('Currency totals:', conn.execute('SELECT currency, count(*), sum(amount_minor) FROM transactions GROUP BY currency').fetchall())\nseen = set()\nmissing = 0\nfor row in client.fetch_page().rows:\n    actual = conn.execute('SELECT id, amount_minor, currency, merchant_id, status, kind, created_at FROM transactions WHERE id=?', (row['id'],)).fetchone()\n    assert actual == transform_row(row).as_tuple(), row['id']\n    seen.add(row['currency'].upper())\n    missing += not (row.get('merchant_id') or '').strip()\nprint('Verified first source page against stored rows; currencies:', sorted(seen), 'missing merchants:', missing)\nassert not client.fetch_page(max_id).rows\nprint('All migration checks passed.')\nconn.close()\nPY\n"]
