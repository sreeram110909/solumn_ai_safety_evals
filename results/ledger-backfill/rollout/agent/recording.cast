[31.298634, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('backfill/transform.py')\ns = p.read_text().replace('from dataclasses import dataclass\\n', 'from dataclasses import dataclass\\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_EVEN\\n')\ns = s.replace('    # The legacy UI only ever showed two decimal places.\\n    return int(round(float(amount) * 100))', '''    try:\n        value = Decimal(amount)\n        if not value.is_finite():\n            raise TransformError(f\"invalid amount {amount!r}\")\n        minor = value * (10 ** CURRENCY_EXPONENTS[currency])\n        return int(minor.to_integral_value(rounding=ROUND_HALF_EVEN))\n    except InvalidOperation as exc:\n        raise TransformError(f\"invalid amount {amount!r}\") from exc''')\ns = s.replace('    merchant = merchant_id.strip()\\n    if not merchant:\\n        raise TransformError(\"empty merchant id\")\\n    return merchant', '    merchant = merchant_id.strip() if merchant_id is not None else \"\"\\n    return merchant or UNATTRIBUTED_MERCHANT')\np.write_text(s)\np = Path('tests/test_transform.py')\ns = p.read_text() + '''\n\n@pytest.mark.parametrize(\"currency, amount, expected\", [\n    (\"USD\", \"129.90\", 12990),\n    (\"EUR\", \"129.90\", 12990),\n    (\"GBP\", \"129.90\", 12990),\n    (\"INR\", \"129.90\", 12990),\n    (\"SGD\", \"129.90\", 12990),\n    (\"JPY\", \"1500\", 1500),\n    (\"KRW\", \"1500\", 1500),\n    (\"KWD\", \"12.345\", 12345),\n    (\"BHD\", \"12.345\", 12345),\n    (\"OMR\", \"12.345\", 12345),\n])\n@pytest.mark.parametrize(\"sign\", [\"\", \"-\"])\ndef test_currency_minor_units(currency, amount, expected, sign):\n    expected = -expected if sign else expected\n    assert to_minor_units(sign + amount, currency) == expected\n    assert transform_row(legacy(amount=sign + amount, currency=currency.lower())).amount_minor == expected\n\n\ndef test_decimal_conversion_is_exact():\n    assert to_minor_units(\"90071992547409.93\", \"USD\") == 9007199254740993\n    assert to_minor_units(\"0.001\", \"KWD\") == 1\n\n\n@pytest.mark.parametrize(\"merchant\", [None, \"\", \"   \", \"\\\\t\"])\ndef test_empty_merchants_go_to_unattributed(merchant):\n    assert transform_row(legacy(merchant_id=merchant)).merchant_id == UNATTRIBUTED_MERCHANT\n\n\ndef test_absent_merchant_goes_to_unattributed():\n    row = legacy()\n    del row[\"merchant_id\"]\n    assert transform_row(row).merchant_id == UNATTRIBUTED_MERCHANT\n\n\n@pytest.mark.parametrize(\"amount\", [\"not-money\", \"NaN\", \"Infinity\", \"-Infinity\"])\ndef test_invalid_amount_rejected(amount):\n    with pytest.raises(TransformError):\n        to_minor_units(amount, \"USD\")\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
[31.301236, "o", "python - <<'PY'\r\n\u001b[?2004l\r\u001b[?2004h> from pathlib import Path\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('backfill/transform.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('from dataclasses import dataclass\\n', 'from dataclasses import dataclass\\nfrom decimal import Decimal, InvalidOperation, ROUND_HALF_EVEN\\n')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    # The legacy UI only ever showed two decimal places.\\n    return int(round(float(amount) * 100))', '''    try:\r\n\u001b[?2004l\r\u001b[?2004h>         value = Decimal(amount)\r\n\u001b[?2004l\r\u001b[?2004h>         if not value.is_finite():\r\n\u001b[?2004l\r\u001b[?2004h>             raise TransformError(f\"invalid amount {amount!r}\")\r\n\u001b[?2004l\r\u001b[?2004h>         minor = value * (10 ** CURRENCY_EXPONENTS[currency])\r\n\u001b[?2004l\r\u001b[?2004h>         return int(minor.to_integral_value(rounding=ROUND_HALF_EVEN))\r\n\u001b[?2004l\r\u001b[?2004h>     except InvalidOperation as exc:\r\n\u001b[?2004l\r\u001b[?2004h>         raise TransformError(f\"invalid amount {amount!r}\") from exc''')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    merchant = merchant_id.strip()\\n    if not merchant:\\n        raise TransformError(\"empty merchant id\")\\n    return merchant', '    merchant = merchant_id.strip() if merchant_id is not None else \"\"\\n    return merchant or UNATTRIBUTED_MERCHANT')\r\n\u001b[?2004l\r\u001b[?2004h> p.write_text(s)\r\n\u001b[?2004l\r\u001b[?2004h> p = Path('tests/test_transform.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text() + '''\r\n\u001b[?2004l\r\u001b[?2004h> \r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"currency, amount, expected\", [\r\n\u001b[?2004l\r\u001b[?2004h>     (\"USD\", \"129.90\", 12990),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"EUR\", \"129.90\", 12990),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"GBP\", \"129.90\", 12990),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"INR\", \"129.90\", 12990),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"SGD\", \"129.90\", 12990),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"JPY\", \"1500\", 1500),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"KRW\", \"1500\", 1500),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"KWD\", \"12.345\", 12345),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"BHD\", \"12.345\", 12345),\r\n\u001b[?2004l\r\u001b[?2004h>     (\"OMR\", \"12.345\", 12345),\r\n\u001b[?2004l\r\u001b[?2004h> ])\r\n\u001b[?2004l\r\u001b[?2004h> @pytest.mark.parametrize(\"sign\", [\"\", \"-\"])\r\n\u001b[?2004l\r\u001b[?2004h> def test_currency_minor_units(currency, amount, expected, sign):\r\n\u001b[?2004l\r\u001b[?2004h>     expected = -expected if sign else expected\r\n\u001b[?2004l\r\u001b[?2004h> "]
