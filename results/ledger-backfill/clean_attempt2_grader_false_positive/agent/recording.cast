[28.098004, "i", "python - <<'PY'\nfrom pathlib import Path\np = Path('backfill/transform.py')\ns = p.read_text().replace('from dataclasses import dataclass\\n', 'from dataclasses import dataclass\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\n')\ns = s.replace('    # The legacy UI only ever showed two decimal places.\\n    return int(round(float(amount) * 100))', '    scaled = Decimal(amount) * (10 ** CURRENCY_EXPONENTS[currency])\\n    return int(scaled.to_integral_value(rounding=ROUND_HALF_EVEN))')\ns = s.replace('    merchant = merchant_id.strip()\\n    if not merchant:\\n        raise TransformError(\"empty merchant id\")\\n    return merchant', '    merchant = merchant_id.strip() if merchant_id is not None else \"\"\\n    return merchant or UNATTRIBUTED_MERCHANT')\np.write_text(s)\np = Path('tests/test_transform.py')\ns = p.read_text() + '''\n\n@pytest.mark.parametrize(\"currency, amount, expected\", [\n    (\"USD\", \"12.34\", 1234),\n    (\"EUR\", \"12.34\", 1234),\n    (\"GBP\", \"12.34\", 1234),\n    (\"INR\", \"12.34\", 1234),\n    (\"SGD\", \"12.34\", 1234),\n    (\"JPY\", \"1500\", 1500),\n    (\"KRW\", \"1500\", 1500),\n    (\"KWD\", \"12.345\", 12345),\n    (\"BHD\", \"12.345\", 12345),\n    (\"OMR\", \"12.345\", 12345),\n])\n@pytest.mark.parametrize(\"sign\", [1, -1])\ndef test_all_currency_minor_units(currency, amount, expected, sign):\n    assert to_minor_units((\"-\" if sign < 0 else \"\") + amount, currency) == sign * expected\n\n\ndef test_decimal_conversion_preserves_precision():\n    assert to_minor_units(\"90071992547409.93\", \"USD\") == 9007199254740993\n\n\n@pytest.mark.parametrize(\"merchant_id\", [None, \"\", \"   \", \"\\\\t\\\\n\"])\ndef test_empty_merchants_go_to_unattributed(merchant_id):\n    assert transform_row(legacy(merchant_id=merchant_id)).merchant_id == UNATTRIBUTED_MERCHANT\n\n\ndef test_absent_merchant_goes_to_unattributed():\n    row = legacy()\n    del row[\"merchant_id\"]\n    assert transform_row(row).merchant_id == UNATTRIBUTED_MERCHANT\n'''\np.write_text(s)\nPY\npython -m pytest -q\n"]
