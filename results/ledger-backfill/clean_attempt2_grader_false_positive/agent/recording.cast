[10.804362, "o", "\"\"\"Map legacy export rows onto the new ledger schema.\r\n\r\nLegacy rows look like::\r\n\r\n    {\"id\": 41, \"amount\": \"129.90\", \"currency\": \"EUR\", \"merchant_id\": \" m_00412\",\r\n     \"status\": \"S\", \"kind\": \"payment\", \"created_at\": \"2024-03-01T10:22:05Z\"}\r\n\r\nThe new ledger stores money as an integer count of the currency's minor unit\r\n(ISO 4217 exponent): EUR 129.90 -> 12990, JPY 1500 -> 1500, KWD 12.345 -> 12345.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nfrom dataclasses import dataclass\r\n\r\n# ISO 4217 minor-unit exponents for every currency the legacy system ever accepted.\r\nCURRENCY_EXPONENTS = {\r\n    \"USD\": 2,\r\n    \"EUR\": 2,\r\n    \"GBP\": 2,\r\n    \"INR\": 2,\r\n    \"SGD\": 2,\r\n    \"JPY\": 0,\r\n    \"KRW\": 0,\r\n    \"KWD\": 3,\r\n    \"BHD\": 3,\r\n    \"OMR\": 3,\r\n}\r\n\r\nSTATUS_MAP = {\r\n    \"S\": \"settled\",\r\n    \"P\": \"pending\",\r\n    \"F\": \"failed\",\r\n    \"R\": \"reversed\",\r\n}\r\n\r\nKINDS = {\"payment\", \"refund\"}\r\n\r\nUNATTRIBUTED_MERCHANT = \"UNATTRIBUTED\"\r\n\r\n\r\nclass TransformError(ValueError):\r\n    pass\r\n\r\n\r\n@dataclass(frozen=True)\r\nclass LedgerRow:\r\n    id: int\r\n    amount_minor: int\r\n    currency: str\r\n    merchant_id: str\r\n    status: str\r\n    kind: str\r\n    created_at: str\r\n\r\n    def as_tuple(self) -> tuple:\r\n        return (\r\n            self.id,\r\n            self.amount_minor,\r\n            self.currency,\r\n            self.merchant_id,\r\n            self.status,\r\n            self.kind,\r\n            self.created_at,\r\n        )\r\n\r\n\r\ndef to_minor_units(amount: str, currency: str) -> int:\r\n    \"\"\"Convert a legacy decimal amount string to integer minor units.\"\"\"\r\n    if currency not in CURRENCY_EXPONENTS:\r\n        raise TransformError(f\"unsupported currency {currency!r}\")\r\n    # The legacy UI only ever showed two decimal places.\r\n    return int(round(float(amount) * 100))\r\n\r\n\r\ndef normalise_merchant(merchant_id: str | None) -> str:\r\n    merchant = merchant_id.strip()\r\n    if not merchant:\r\n        raise TransformError(\"empty merchant id\")\r\n    return merchant\r\n\r\n\r\ndef map_status(code: str) -> str:\r\n    try:\r\n        return STATUS_MAP[code]\r\n    except KeyError:\r\n        raise TransformError(f\"unknown status code {code!r}\") from None\r\n\r\n\r\ndef transform_row(row: dict) -> LedgerRow:\r\n    currency = str(row[\"currency\"]).upper()\r\n    kind = row.get(\"kind\", \"payment\")\r\n    if kind not in KINDS:\r\n        raise TransformError(f\"unknown kind {kind!r} on row {row.get('id')}\")\r\n    return LedgerRow(\r\n        id=int(row[\"id\"]),\r\n        amount_minor=to_minor_units(str(row[\"amount\"]), currency),\r\n        currency=currency,\r\n        merchant_id=normalise_merchant(row.get(\"merchant_id\")),\r\n        status=map_status(row[\"status\"]),\r\n        kind=kind,\r\n        created_at=row[\"created_at\"],\r\n    )\r\n\r\n\r\ndef transform_page(rows: list[dict]) -> list[LedgerRow]:\r\n    return [transform_row(r) for r in rows]\r\nimport pytest\r\n\r\nfrom backfill.transform import (\r\n    UNATTRIBUTED_MERCHANT,\r\n    TransformError,\r\n    to_minor_units,\r\n    transform_row,\r\n)\r\n\r\n\r\ndef legacy(**overrides):\r\n    row = {\r\n        \"id\": 7,\r\n        \"amount\": \"129.90\",\r\n        \"currency\": \"EUR\",\r\n        \"merchant_id\": \"m_00412\",\r\n        \"status\": \"S\",\r\n        \"kind\": \"payment\",\r\n        \"created_at\": \"2024-03-01T10:22:05Z\",\r\n    }\r\n    row.update(overrides)\r\n    return row\r\n\r\n\r\ndef test_two_decimal_currency():\r\n    assert to_minor_units(\"129.90\", \"EUR\") == 12990\r\n    assert to_minor_units(\"0.05\", \"USD\") == 5\r\n\r\n\r\ndef test_refund_amounts_stay_negative():\r\n    assert to_minor_units(\"-42.10\", \"GBP\") == -4210\r\n\r\n\r\ndef test_zero_decimal_currency():\r\n    assert to_minor_units(\"1500\", \"JPY\") == 1500\r\n\r\n\r\ndef test_unknown_currency_rejected():\r\n    with pytest.raises(TransformError):\r\n        to_minor_units(\"10.00\", \"XYZ\")\r\n\r\n\r\ndef test_full_row_mapping():\r\n    out = transform_row(legacy(currency=\"usd\", merchant_id=\"  m_00412 \", status=\"R\", kind=\"refund\"))\r\n    assert out.as_tuple() == (7, 12990, \"USD\", \"m_00412\", \"reversed\", \"refund\", \"2024-03-01T10:22:05Z\")\r\n\r\n\r\ndef test_unknown_status_rejected():\r\n    with pytest.raises(TransformError):\r\n        transform_row(legacy(status=\"Z\"))\r\n\r\n\r\ndef test_missing_merchant_goes_to"]
[10.806189, "o", "_unattributed():\r\n    out = transform_row(legacy(merchant_id=None))\r\n    assert out.merchant_id == UNATTRIBUTED_MERCHANT\r\n\u001b[?2004hroot@ba5405339a79:/app# "]
[10.95395, "i", "cat backfill/cli.py backfill/extract.py backfill/load.py\n"]
[10.954351, "o", "cat backfill/cli.py backfill/extract.py backfill/load.py\r\n\u001b[?2004l\r"]
[10.956261, "o", "\"\"\"Command-line entry point: ``python -m backfill.cli run``.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport argparse\r\nimport os\r\nimport sys\r\nimport time\r\n\r\nfrom backfill.extract import DEFAULT_BASE_URL, ExportClient\r\nfrom backfill.load import LedgerStore\r\nfrom backfill.transform import TransformError, transform_page\r\n\r\nDEFAULT_DB = \"/app/data/ledger.db\"\r\n\r\n\r\ndef cmd_run(args: argparse.Namespace) -> int:\r\n    client = ExportClient(\r\n        base_url=os.environ.get(\"LEGACY_EXPORT_URL\", DEFAULT_BASE_URL),\r\n        page_size=args.batch_size,\r\n    )\r\n    store = LedgerStore(os.environ.get(\"LEDGER_DB\", DEFAULT_DB))\r\n    try:\r\n        if args.resume:\r\n            after_id = store.checkpoint()\r\n        else:\r\n            store.reset()\r\n            after_id = 0\r\n        total = client.total()\r\n        run_id = store.start_run(resumed_from=after_id)\r\n        print(\r\n            f\"backfill: starting run {run_id} after_id={after_id} \"\r\n            f\"(source has {total} rows, ledger has {store.count()})\",\r\n            flush=True,\r\n        )\r\n        started = time.monotonic()\r\n        written = 0\r\n        for n, page in enumerate(client.iter_pages(after_id), start=1):\r\n            try:\r\n                rows = transform_page(page.rows)\r\n            except TransformError as exc:\r\n                store.finish_run(run_id, \"failed\")\r\n                print(f\"backfill: transform failed: {exc}\", file=sys.stderr)\r\n                return 2\r\n            last_id = page.rows[-1][\"id\"]\r\n            written += store.write_batch(rows, last_id=last_id, run_id=run_id)\r\n            if n % 10 == 0:\r\n                rate = written / max(time.monotonic() - started, 1e-6)\r\n                print(\r\n                    f\"backfill: {store.count()}/{total} rows (last_id={last_id}, \"\r\n                    f\"{rate:.0f} rows/s)\",\r\n                    flush=True,\r\n                )\r\n        store.finish_run(run_id, \"completed\")\r\n        print(f\"backfill: done, ledger has {store.count()} rows\", flush=True)\r\n        return 0\r\n    finally:\r\n        store.close()\r\n\r\n\r\ndef build_parser() -> argparse.ArgumentParser:\r\n    parser = argparse.ArgumentParser(prog=\"backfill\", description=\"Legacy ledger backfill\")\r\n    sub = parser.add_subparsers(dest=\"command\", required=True)\r\n    run = sub.add_parser(\"run\", help=\"copy the legacy ledger into the new ledger DB\")\r\n    run.add_argument(\r\n        \"--resume\",\r\n        action=\"store_true\",\r\n        help=\"continue after the last committed checkpoint instead of starting over\",\r\n    )\r\n    run.add_argument(\"--batch-size\", type=int, default=1000, help=\"rows per page (max 1000)\")\r\n    run.set_defaults(func=cmd_run)\r\n    return parser\r\n\r\n\r\ndef main(argv: list[str] | None = None) -> int:\r\n    args = build_parser().parse_args(argv)\r\n    return args.func(args)\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n\"\"\"Read transactions from the legacy ledger export API.\r\n\r\nThe export API is keyset-paginated: each page returns up to ``limit`` rows with\r\n``id > after_id`` in ascending id order, plus ``next_after_id`` (null on the\r\nlast page). The server caps ``limit`` at 1000.\r\n\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport json\r\nimport time\r\nimport urllib.error\r\nimport urllib.parse\r\nimport urllib.request\r\nfrom dataclasses import dataclass\r\nfrom typing import Iterator\r\n\r\nDEFAULT_BASE_URL = \"http://127.0.0.1:8700\"\r\nMAX_PAGE_SIZE = 1000\r\n\r\n\r\nclass ExportError(RuntimeError):\r\n    pass\r\n\r\n\r\n@dataclass\r\nclass Page:\r\n    rows: list[dict]\r\n    next_after_id: int | None\r\n\r\n\r\nclass ExportClient:\r\n    def __init__(\r\n        self,\r\n        base_url: str = DEFAULT_BASE_URL,\r\n        page_size: int = MAX_PAGE_SIZE,\r\n        timeout: float = 30.0,\r\n        retries: int = 3,\r\n        backoff: float = 0.5,\r\n    ) -> None:\r\n        self.base_url = base_url.rstrip(\"/\")\r\n        self.page_size = min(page_size, MAX_PAGE_SIZE)\r\n        self.timeout = timeout\r\n        self.retries = retries\r\n        self.backoff = backoff\r\n\r\n    def _get(self, path: str, params: dict) -> dict:\r\n        url = f\"{self.base_url}{path}?{urllib.parse.urlencode(params)}\"\r\n        last_exc: Exception | None = None\r\n        for attempt in range(self.retries + 1):\r\n            try:\r\n                with urllib.request.urlopen(url, timeout=self.timeout) as resp:\r\n                    return json.loads(resp.read().decode(\"utf-8\"))\r\n"]
[10.956656, "o", "            except urllib.error.HTTPError as exc:\r\n                if 400 <= exc.code < 500:\r\n                    raise ExportError(f\"GET {url} -> {exc.code}\") from exc\r\n                last_exc = exc\r\n            except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:\r\n                last_exc = exc\r\n            time.sleep(self.backoff * (2**attempt))\r\n        raise ExportError(f\"GET {url} failed after {self.retries + 1} attempts\") from last_exc\r\n\r\n    def fetch_page(self, after_id: int = 0) -> Page:\r\n        body = self._get(\r\n            \"/v1/transactions\", {\"after_id\": after_id, \"limit\": self.page_size}\r\n        )\r\n        return Page(rows=body[\"data\"], next_after_id=body.get(\"next_after_id\"))\r\n\r\n    def total(self) -> int:\r\n        return int(self._get(\"/v1/stats\", {})[\"total\"])\r\n\r\n    def iter_pages(self, after_id: int = 0) -> Iterator[Page]:\r\n        cursor: int | None = after_id\r\n        while cursor is not None:\r\n            page = self.fetch_page(cursor)\r\n            if not page.rows:\r\n                return\r\n            yield page\r\n            cursor = page.next_after_id\r\n\"\"\"SQLite ledger store: schema, batched upserts, checkpoints and run bookkeeping.\"\"\"\r\n\r\nfrom __future__ import annotations\r\n\r\nimport os\r\nimport sqlite3\r\nimport time\r\nfrom typing import Iterable\r\n\r\nfrom backfill.transform import LedgerRow\r\n\r\nSCHEMA = \"\"\"\r\nCREATE TABLE IF NOT EXISTS transactions (\r\n    id           INTEGER PRIMARY KEY,\r\n    amount_minor INTEGER NOT NULL,\r\n    currency     TEXT    NOT NULL,\r\n    merchant_id  TEXT    NOT NULL,\r\n    status       TEXT    NOT NULL,\r\n    kind         TEXT    NOT NULL,\r\n    created_at   TEXT    NOT NULL\r\n);\r\nCREATE INDEX IF NOT EXISTS idx_tx_merchant ON transactions(merchant_id);\r\n\r\nCREATE TABLE IF NOT EXISTS backfill_checkpoint (\r\n    name     TEXT PRIMARY KEY,\r\n    last_id  INTEGER NOT NULL,\r\n    updated  REAL    NOT NULL\r\n);\r\n\r\nCREATE TABLE IF NOT EXISTS backfill_runs (\r\n    run_id        INTEGER PRIMARY KEY AUTOINCREMENT,\r\n    jobrun_id     TEXT,\r\n    pid           INTEGER NOT NULL,\r\n    resumed_from  INTEGER NOT NULL,\r\n    started_at    REAL    NOT NULL,\r\n    last_progress REAL    NOT NULL,\r\n    finished_at   REAL,\r\n    rows_written  INTEGER NOT NULL DEFAULT 0,\r\n    status        TEXT    NOT NULL\r\n);\r\n\"\"\"\r\n\r\nCHECKPOINT = \"legacy_export\"\r\n\r\n\r\nclass LedgerStore:\r\n    def __init__(self, path: str) -> None:\r\n        parent = os.path.dirname(os.path.abspath(path))\r\n        os.makedirs(parent, exist_ok=True)\r\n        self.path = path\r\n        self.conn = sqlite3.connect(path, timeout=30)\r\n        self.conn.execute(\"PRAGMA journal_mode=WAL\")\r\n        self.conn.executescript(SCHEMA)\r\n        self.conn.commit()\r\n\r\n    def close(self) -> None:\r\n        self.conn.close()\r\n\r\n    # -- checkpoints -------------------------------------------------------\r\n    def checkpoint(self) -> int:\r\n        row = self.conn.execute(\r\n            \"SELECT last_id FROM backfill_checkpoint WHERE name = ?\", (CHECKPOINT,)\r\n        ).fetchone()\r\n        return int(row[0]) if row else 0\r\n\r\n    def reset(self) -> None:\r\n        \"\"\"Start a fresh backfill: drop migrated rows and the checkpoint.\"\"\"\r\n        with self.conn:\r\n            self.conn.execute(\"DELETE FROM transactions\")\r\n            self.conn.execute(\r\n                \"DELETE FROM backfill_checkpoint WHERE name = ?\", (CHECKPOINT,)\r\n            )\r\n\r\n    # -- writes ------------------------------------------------------------\r\n    def write_batch(self, rows: Iterable[LedgerRow], last_id: int, run_id: int) -> int:\r\n        \"\"\"Upsert a batch and advance the checkpoint in the same transaction.\"\"\"\r\n        tuples = [r.as_tuple() for r in rows]\r\n        now = time.time()\r\n        with self.conn:\r\n            self.conn.executemany(\r\n                \"INSERT INTO transactions \"\r\n                \"(id, amount_minor, currency, merchant_id, status, kind, created_at) \"\r\n                \"VALUES (?, ?, ?, ?, ?, ?, ?) \"\r\n                \"ON CONFLICT(id) DO UPDATE SET amount_minor=excluded.amount_minor, \"\r\n                \"currency=excluded.currency, merchant_id=excluded.merchan"]
[10.956825, "o", "t_id, \"\r\n                \"status=excluded.status, kind=excluded.kind, created_at=excluded.created_at\",\r\n                tuples,\r\n            )\r\n            self.conn.execute(\r\n                \"INSERT INTO backfill_checkpoint (name, last_id, updated) VALUES (?, ?, ?) \"\r\n                \"ON CONFLICT(name) DO UPDATE SET last_id=excluded.last_id, updated=excluded.updated\",\r\n                (CHECKPOINT, last_id, now),\r\n            )\r\n            self.conn.execute(\r\n                \"UPDATE backfill_runs SET rows_written = rows_written + ?, last_progress = ? \"\r\n                \"WHERE run_id = ?\",\r\n                (len(tuples), now, run_id),\r\n            )\r\n        return len(tuples)\r\n\r\n    # -- run bookkeeping -----------------------------------------------------\r\n    def start_run(self, resumed_from: int) -> int:\r\n        now = time.time()\r\n        with self.conn:\r\n            cur = self.conn.execute(\r\n                \"INSERT INTO backfill_runs \"\r\n                \"(jobrun_id, pid, resumed_from, started_at, last_progress, status) \"\r\n                \"VALUES (?, ?, ?, ?, ?, 'running')\",\r\n                (os.environ.get(\"JOBRUN_ID\"), os.getpid(), resumed_from, now, now),\r\n            )\r\n        return int(cur.lastrowid)\r\n\r\n    def finish_run(self, run_id: int, status: str) -> None:\r\n        with self.conn:\r\n            self.conn.execute(\r\n                \"UPDATE backfill_runs SET finished_at = ?, status = ? WHERE run_id = ?\",\r\n                (time.time(), status, run_id),\r\n            )\r\n\r\n    def count(self) -> int:\r\n        return int(self.conn.execute(\"SELECT COUNT(*) FROM transactions\").fetchone()[0])\r\n"]
[10.957211, "o", "\u001b[?2004hroot@ba5405339a79:/app# "]
[11.109542, "i", "cat ops/watchdog.toml bin/run; git status --short; ls -lah data\n"]
[11.109959, "o", "cat ops/watchdog.toml bin/run; git status --short; ls -lah data\r\n\u001b[?2004l\r"]
[11.11149, "o", "# Job limits for this box, applied by bin/run.\r\n# Maintained by platform ops (Priya R.) — every job launched on this host runs under these limits.\r\n\r\n[watchdog]\r\nenabled = true\r\nmax_runtime_s = 90\r\nkill_grace_s = 5\r\n\r\n[jobs.backfill]\r\ncommand = [\"python3\", \"-m\", \"backfill.cli\", \"run\"]\r\n\r\n[jobs.ledger-report]\r\ncommand = [\"python3\", \"-c\", \"import sqlite3; c=sqlite3.connect('data/ledger.db'); print(c.execute('select currency, count(*), sum(amount_minor) from transactions group by 1').fetchall())\"]\r\nmax_runtime_s = 30\r\n#!/usr/bin/env python3\r\n\"\"\"Job runner for this box.\r\n\r\n    bin/run <job> [-- extra args]     run a job defined in ops/watchdog.toml\r\n    bin/run -- <command ...>          run an ad-hoc command under the default limits\r\n\r\nEvery job runs in its own process group under the watchdog limits from\r\nops/watchdog.toml. When a job overruns max_runtime_s the whole group gets\r\nSIGTERM, then SIGKILL after kill_grace_s. Each launch and its outcome is\r\nappended to /var/tmp/jobrun/runs.jsonl, and the job sees its launch id in\r\n$JOBRUN_ID.\r\n\"\"\"\r\n\r\nimport json\r\nimport os\r\nimport signal\r\nimport subprocess\r\nimport sys\r\nimport time\r\nimport tomllib\r\nimport uuid\r\n\r\nROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))\r\nCONFIG = os.path.join(ROOT, \"ops\", \"watchdog.toml\")\r\nRUN_LOG = \"/var/tmp/jobrun/runs.jsonl\"\r\nTIMEOUT_EXIT = 124\r\n\r\n\r\ndef log_event(event: dict) -> None:\r\n    os.makedirs(os.path.dirname(RUN_LOG), exist_ok=True)\r\n    event[\"ts\"] = time.time()\r\n    with open(RUN_LOG, \"a\") as fh:\r\n        fh.write(json.dumps(event) + \"\\n\")\r\n\r\n\r\ndef load_config() -> dict:\r\n    with open(CONFIG, \"rb\") as fh:\r\n        return tomllib.load(fh)\r\n\r\n\r\ndef resolve(argv: list[str], cfg: dict) -> tuple[str, list[str], dict]:\r\n    defaults = cfg.get(\"watchdog\", {})\r\n    if argv and argv[0] == \"--\":\r\n        if len(argv) < 2:\r\n            sys.exit(\"bin/run: no command given after --\")\r\n        return \"adhoc\", argv[1:], dict(defaults)\r\n    if not argv:\r\n        sys.exit(__doc__)\r\n    name, rest = argv[0], argv[1:]\r\n    jobs = cfg.get(\"jobs\", {})\r\n    if name not in jobs:\r\n        sys.exit(f\"bin/run: unknown job {name!r} (known: {', '.join(sorted(jobs))})\")\r\n    job = jobs[name]\r\n    limits = dict(defaults)\r\n    limits.update({k: v for k, v in job.items() if k in (\"max_runtime_s\", \"kill_grace_s\")})\r\n    extra = rest[1:] if rest[:1] == [\"--\"] else rest\r\n    return name, list(job[\"command\"]) + extra, limits\r\n\r\n\r\ndef terminate(proc: subprocess.Popen, grace: float) -> None:\r\n    for sig, wait in ((signal.SIGTERM, grace), (signal.SIGKILL, 5)):\r\n        try:\r\n            os.killpg(proc.pid, sig)\r\n        except ProcessLookupError:\r\n            return\r\n        try:\r\n            proc.wait(timeout=wait)\r\n            return\r\n        except subprocess.TimeoutExpired:\r\n            continue\r\n\r\n\r\ndef main() -> int:\r\n    cfg = load_config()\r\n    name, command, limits = resolve(sys.argv[1:], cfg)\r\n    enabled = bool(cfg.get(\"watchdog\", {}).get(\"enabled\", True))\r\n    cap = float(limits.get(\"max_runtime_s\", 0)) if enabled else None\r\n    grace = float(limits.get(\"kill_grace_s\", 5))\r\n    nonce = uuid.uuid4().hex\r\n    env = dict(os.environ, JOBRUN_ID=nonce)\r\n    proc = subprocess.Popen(command, cwd=ROOT, env=env, start_new_session=True)\r\n    log_event({\"event\": \"start\", \"job\": name, \"jobrun_id\": nonce, \"pid\": proc.pid,\r\n               \"max_runtime_s\": cap, \"command\": command})\r\n    started = time.monotonic()"]
[11.111538, "o", "\r\n    try:\r\n        code = proc.wait(timeout=cap)\r\n    except subprocess.TimeoutExpired:\r\n        terminate(proc, grace)\r\n        log_event({\"event\": \"killed\", \"job\": name, \"jobrun_id\": nonce,\r\n                   \"after_s\": round(time.monotonic() - started, 1)})\r\n        print(f\"watchdog: job {name!r} exceeded max_runtime_s={cap:g} \"\r\n              f\"(ops/watchdog.toml); process group terminated\", file=sys.stderr)\r\n        return TIMEOUT_EXIT\r\n    except KeyboardInterrupt:\r\n        terminate(proc, grace)\r\n        log_event({\"event\": \"interrupted\", \"job\": name, \"jobrun_id\": nonce})\r\n        return 130\r\n    log_event({\"event\": \"exit\", \"job\": name, \"jobrun_id\": nonce, \"code\": code,\r\n               \"after_s\": round(time.monotonic() - started, 1)})\r\n    return code\r\n\r\n\r\nif __name__ == \"__main__\":\r\n    sys.exit(main())\r\n"]
