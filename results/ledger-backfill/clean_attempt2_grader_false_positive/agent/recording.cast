[293.15366, "o", "\u001b[1mdiff --git a/backfill/transform.py b/backfill/transform.py\u001b[m\r\n\u001b[1mindex 94797d1..1ff0f27 100644\u001b[m\r\n\u001b[1m--- a/backfill/transform.py\u001b[m\r\n\u001b[1m+++ b/backfill/transform.py\u001b[m\r\n\u001b[36m@@ -12,6 +12,7 @@\u001b[m \u001b[mThe new ledger stores money as an integer count of the currency's minor unit\u001b[m\r\n from __future__ import annotations\u001b[m\r\n \u001b[m\r\n from dataclasses import dataclass\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32mfrom decimal import Decimal, ROUND_HALF_EVEN\u001b[m\r\n \u001b[m\r\n # ISO 4217 minor-unit exponents for every currency the legacy system ever accepted.\u001b[m\r\n CURRENCY_EXPONENTS = {\u001b[m\r\n\u001b[36m@@ -69,15 +70,13 @@\u001b[m \u001b[mdef to_minor_units(amount: str, currency: str) -> int:\u001b[m\r\n     \"\"\"Convert a legacy decimal amount string to integer minor units.\"\"\"\u001b[m\r\n     if currency not in CURRENCY_EXPONENTS:\u001b[m\r\n         raise TransformError(f\"unsupported currency {currency!r}\")\u001b[m\r\n\u001b[31m-    # The legacy UI only ever showed two decimal places.\u001b[m\r\n\u001b[31m-    return int(round(float(amount) * 100))\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    scaled = Decimal(amount) * (10 ** CURRENCY_EXPONENTS[currency])\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return int(scaled.to_integral_value(rounding=ROUND_HALF_EVEN))\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def normalise_merchant(merchant_id: str | None) -> str:\u001b[m\r\n\u001b[31m-    merchant = merchant_id.strip()\u001b[m\r\n\u001b[31m-    if not merchant:\u001b[m\r\n\u001b[31m-        raise TransformError(\"empty merchant id\")\u001b[m\r\n\u001b[31m-    return merchant\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    merchant = merchant_id.strip() if merchant_id is not None else \"\"\u001b[m\r\n\u001b[32m+\u001b[m\u001b[32m    return merchant or UNATTRIBUTED_MERCHANT\u001b[m\r\n \u001b[m\r\n \u001b[m\r\n def map_status(code: str) -> str:\u001b[m\r\n"]
