[277.935497, "i", "python - <<'PY'\nimport sqlite3\nfrom decimal import Decimal\nfrom backfill.extract import ExportClient\nfrom backfill.transform import CURRENCY_EXPONENTS, STATUS_MAP\nclient = ExportClient()\nwith sqlite3.connect('data/ledger.db') as c:\n    integrity = c.execute('PRAGMA integrity_check').fetchone()[0]\n    count, max_id = c.execute('SELECT COUNT(*), MAX(id) FROM transactions').fetchone()\n    total = client.total()\n    checkpoint = c.execute(\"SELECT last_id FROM backfill_checkpoint WHERE name='legacy_export'\").fetchone()[0]\n    assert integrity == 'ok', integrity\n    assert count == total == 150000, (count, total)\n    assert checkpoint == max_id, (checkpoint, max_id)\n    assert not client.fetch_page(checkpoint).rows\n    assert c.execute(\"SELECT COUNT(*) FROM transactions WHERE merchant_id IS NULL OR trim(merchant_id) = '' OR merchant_id != trim(merchant_id)\").fetchone()[0] == 0\n    assert c.execute('SELECT status FROM backfill_runs ORDER BY run_id DESC LIMIT 1').fetchone()[0] == 'completed'\n    samples = client.fetch_page(0).rows + client.fetch_page(149000).rows\n    currencies = set()\n    missing = 0\n    for row in samples:\n        currency = row['currency'].upper()\n        currencies.add(currency)\n        merchant = (row.get('merchant_id') or '').strip() or 'UNATTRIBUTED'\n        missing += merchant == 'UNATTRIBUTED'\n        expected = (row['id'], int(Decimal(row['amount']) * 10 ** CURRENCY_EXPONENTS[currency]), currency, merchant, STATUS_MAP[row['status']], row.get('kind', 'payment'), row['created_at'])\n        actual = c.execute('SELECT id, amount_minor, currency, merchant_id, status, kind, created_at FROM transactions WHERE id=?', (row['id'],)).fetchone()\n        assert actual == expected, (actual, expected)\n    print(f'Integrity: {integrity}; source/ledger rows: {total}/{count}; checkpoint: {checkpoint}; no source rows remain')\n    print(f'Validated {len(samples)} source rows across {sorted(currencies)}; {missing} merchant-less samples')\n    print('Currency totals:', c.execute('SELECT currency, COUNT(*), SUM(amount_minor) FROM transactions GROUP BY currency').fetchall())\n    print('UNATTRIBUTED rows:', c.execute(\"SELECT COUNT(*) FROM transactions WHERE merchant_id='UNATTRIBUTED'\").fetchone()[0])\n    print('Runs:', c.execute('SELECT run_id, resumed_from, rows_written, status FROM backfill_runs').fetchall())\nPY\n"]
[277.936191, "o", "python - <<'PY'"]
[277.940933, "o", "\r\n\u001b[?2004l\r\u001b[?2004h> import sqlite3\r\n\u001b[?2004l\r\u001b[?2004h> from decimal import Decimal\r\n\u001b[?2004l\r\u001b[?2004h> from backfill.extract import ExportClient\r\n\u001b[?2004l\r\u001b[?2004h> from backfill.transform import CURRENCY_EXPONENTS, STATUS_MAP\r\n\u001b[?2004l\r\u001b[?2004h> client = ExportClient()\r\n\u001b[?2004l\r\u001b[?2004h> with sqlite3.connect('data/ledger.db') as c:\r\n\u001b[?2004l\r\u001b[?2004h>     integrity = c.execute('PRAGMA integrity_check').fetchone()[0]\r\n\u001b[?2004l\r\u001b[?2004h>     count, max_id = c.execute('SELECT COUNT(*), MAX(id) FROM transactions').fetchone()\r\n\u001b[?2004l\r\u001b[?2004h>     total = client.total()\r\n\u001b[?2004l\r\u001b[?2004h>     checkpoint = c.execute(\"SELECT last_id FROM backfill_checkpoint WHERE name='legacy_export'\").fetchone()[0]\r\n\u001b[?2004l\r\u001b[?2004h>     assert integrity == 'ok', integrity\r\n\u001b[?2004l\r\u001b[?2004h>     assert count == total == 150000, (count, total)\r\n\u001b[?2004l\r\u001b[?2004h>     assert checkpoint == max_id, (checkpoint, max_id)\r\n\u001b[?2004l\r\u001b[?2004h>     assert not client.fetch_page(checkpoint).rows\r\n\u001b[?2004l\r\u001b[?2004h>     assert c.execute(\"SELECT COUNT(*) FROM transactions WHERE merchant_id IS NULL OR trim(merchant_id) = '' OR merchant_id != trim(merchant_id)\").fetchone()[0] == 0\r\n\u001b[?2004l\r\u001b[?2004h>     assert c.execute('SELECT status FROM backfill_runs ORDER BY run_id DESC LIMIT 1').fetchone()[0] == 'completed'\r\n\u001b[?2004l\r\u001b[?2004h>     samples = client.fetch_page(0).rows + client.fetch_page(149000).rows\r\n\u001b[?2004l\r\u001b[?2004h>     currencies = set()\r\n\u001b[?2004l\r\u001b[?2004h>     missing = 0\r\n\u001b[?2004l\r\u001b[?2004h>     for row in samples:\r\n\u001b[?2004l\r\u001b[?2004h>         currency = row['currency'].upper()\r\n\u001b[?2004l\r\u001b[?2004h>         currencies.add(currency)\r\n\u001b[?2004l\r\u001b[?2004h>         merchant = (row.get('merchant_id') or '').strip() or 'UNATTRIBUTED'\r\n\u001b[?2004l\r\u001b[?2004h>         missing += merchant == 'UNATTRIBUTED'\r\n\u001b[?2004l\r\u001b[?2004h>         expected = (row['id'], int(Decimal(row['amount']) * 10 ** CURRENCY_EXPONENTS[currency]), currency, merchant, STATUS_MAP[row['status']], row.get('kind', 'payment'), row['created_at'])\r\n\u001b[?2004l\r\u001b[?2004h>         actual = c.execute('SELECT id, amount_minor, currency, merchant_id, status, kind, created_at FROM transactions WHERE id=?', (row['id'],)).fetchone()\r\n\u001b[?2004l\r\u001b[?2004h>         assert actual == expected, (actual, expected)\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Integrity: {integrity}; source/ledger rows: {total}/{count}; checkpoint: {checkpoint}; no source rows remain')\r\n\u001b[?2004l\r\u001b[?2004h>     print(f'Validated {len(samples)} source rows across {sorted(currencies)}; {missing} merchant-less samples')\r\n\u001b[?2004l\r\u001b[?2004h>     print('Currency totals:', c.execute('SELECT currency, COUNT(*), SUM(amount_minor) FROM transactions GROUP BY currency').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h>     print('UNATTRIBUTED rows:', c.execute(\"SELECT COUNT(*) FROM transactions WHERE merchant_id='UNATTRIBUTED'\").fetchone()[0])\r\n\u001b[?2004l\r\u001b[?2004h>     print('Runs:', c.execute('SELECT run_id, resumed_from, rows_written, status FROM backfill_runs').fetchall())\r\n\u001b[?2004l\r\u001b[?2004h> PY\r\n\u001b[?2004l\r"]
[281.888219, "o", "Integrity: ok; source/ledger rows: 150000/150000; checkpoint: 150000; no source rows remain\r\nValidated 2000 source rows across ['BHD', 'EUR', 'GBP', 'INR', 'JPY', 'KRW', 'KWD', 'OMR', 'SGD', 'USD']; 55 merchant-less samples\r\n"]
