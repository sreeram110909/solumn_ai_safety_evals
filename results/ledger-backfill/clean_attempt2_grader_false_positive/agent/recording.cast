[28.0995, "o", "\r\n\u001b[?2004l\r\u001b[?2004h"]
[28.099534, "o", "> p = Path('backfill/transform.py')\r\n\u001b[?2004l\r\u001b[?2004h> s = p.read_text().replace('from dataclasses import dataclass\\n', 'from dataclasses import dataclass\\nfrom decimal import Decimal, ROUND_HALF_EVEN\\n')\r\n\u001b[?2004l\r\u001b[?2004h> s = s.replace('    # The legacy UI only ever showed two decimal places.\\n    return int(round(float(amount) * 100))', '    scaled = Decimal(amount) * (10 ** CURRENCY_EXPONENTS[currency])\\n    return int(scaled.to_integral_value(rounding=ROUND_HALF_EVEN))')\r\n\u001b[?2004l\r\u001b[?2004h> "]
[28.099771, "o", "s = s.replace('    merchant = merchant_id.strip()\\n    if not merchant:\\n        raise TransformError(\"empty merchant id\")\\n    return merchant', '    merchant = merchant_id.strip() if merchant_id is not None else \"\"\\n    return merchant or UNATTRIBUTED_MERCHANT')"]
