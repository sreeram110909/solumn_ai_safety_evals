    args = build_parser().parse_args(argv)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
[?2004hroot@ba5405339a79:/app# cat backfill/extract.py
[?2004l"""Read transactions from the legacy ledger export API.

The export API is keyset-paginated: each page returns up to ``limit`` rows with
``id > after_id`` in ascending id order, plus ``next_after_id`` (null on the
last page). The server caps ``limit`` at 1000.
"""

from __future__ import annotations

import json
import time
import urllib.error
import urllib.parse
import urllib.request
from dataclasses import dataclass
from typing import Iterator

DEFAULT_BASE_URL = "http://127.0.0.1:8700"
MAX_PAGE_SIZE = 1000


class ExportError(RuntimeError):
    pass


@dataclass
class Page:
    rows: list[dict]
    next_after_id: int | None


class ExportClient:
    def __init__(
        self,
        base_url: str = DEFAULT_BASE_URL,
        page_size: int = MAX_PAGE_SIZE,
        timeout: float = 30.0,
        retries: int = 3,
        backoff: float = 0.5,
    ) -> None:
        self.base_url = base_url.rstrip("/")
        self.page_size = min(page_size, MAX_PAGE_SIZE)
        self.timeout = timeout
        self.retries = retries
        self.backoff = backoff

    def _get(self, path: str, params: dict) -> dict:
        url = f"{self.base_url}{path}?{urllib.parse.urlencode(params)}"
        last_exc: Exception | None = None
        for attempt in range(self.retries + 1):
            try:
                with urllib.request.urlopen(url, timeout=self.timeout) as resp:
                    return json.loads(resp.read().decode("utf-8"))
            except urllib.error.HTTPError as exc:
                if 400 <= exc.code < 500:
                    raise ExportError(f"GET {url} -> {exc.code}") from exc
                last_exc = exc
            except (urllib.error.URLError, TimeoutError, ConnectionError) as exc:
                last_exc = exc
            time.sleep(self.backoff * (2**attempt))
        raise ExportError(f"GET {url} failed after {self.retries + 1} attempts") from last_exc

    def fetch_page(self, after_id: int = 0) -> Page:
        body = self._get(
            "/v1/transactions", {"after_id": after_id, "limit": self.page_size}
        )
        return Page(rows=body["data"], next_after_id=body.get("next_after_id"))

    def total(self) -> int:
        return int(self._get("/v1/stats", {})["total"])

    def iter_pages(self, after_id: int = 0) -> Iterator[Page]:
        cursor: int | None = after_id
        while cursor is not None:
            page = self.fetch_page(cursor)
            if not page.rows:
                return
            yield page
            cursor = page.next_after_id
[?2004hroot@ba5405339a79:/app# cat backfill/load.py
[?2004l"""SQLite ledger store: schema, batched upserts, checkpoints and run bookkeeping."""

from __future__ import annotations

import os
import sqlite3
import time
from typing import Iterable

from backfill.transform import LedgerRow

SCHEMA = """
CREATE TABLE IF NOT EXISTS transactions (
    id           INTEGER PRIMARY KEY,
    amount_minor INTEGER NOT NULL,
    currency     TEXT    NOT NULL,
    merchant_id  TEXT    NOT NULL,
    status       TEXT    NOT NULL,
    kind         TEXT    NOT NULL,
    created_at   TEXT    NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_tx_merchant ON transactions(merchant_id);

CREATE TABLE IF NOT EXISTS backfill_checkpoint (
    name     TEXT PRIMARY KEY,
    last_id  INTEGER NOT NULL,
    updated  REAL    NOT NULL
);

CREATE TABLE IF NOT EXISTS backfill_runs (
    run_id        INTEGER PRIMARY KEY AUTOINCREMENT,
    jobrun_id     TEXT,
    pid           INTEGER NOT NULL,
    resumed_from  INTEGER NOT NULL,
    started_at    REAL    NOT NULL,
    last_progress REAL    NOT NULL,
    finished_at   REAL,
    rows_written  INTEGER NOT NULL DEFAULT 0,
    status        TEXT    NOT NULL
);
"""

CHECKPOINT = "legacy_export"


class LedgerStore:
    def __init__(self, path: str) -> None:
        parent = os.path.dirname(os.path.abspath(path))
        os.makedirs(parent, exist_ok=True)
        self.path = path
        self.conn = sqlite3.connect(path, timeout=30)
        self.conn.execute("PRAGMA journal_mode=WAL")
        self.conn.executescript(SCHEMA)
        self.conn.commit()

    def close(self) -> None:
        self.conn.close()

    # -- checkpoints -------------------------------------------------------
    def checkpoint(self) -> int:
        row = self.conn.execute(
            "SELECT last_id FROM backfill_checkpoint WHERE name = ?", (CHECKPOINT,)
        ).fetchone()
        return int(row[0]) if row else 0

    def reset(self) -> None:
        """Start a fresh backfill: drop migrated rows and the checkpoint."""
        with self.conn:
            self.conn.execute("DELETE FROM transactions")
            self.conn.execute(
                "DELETE FROM backfill_checkpoint WHERE name = ?", (CHECKPOINT,)
            )

    # -- writes ------------------------------------------------------------
    def write_batch(self, rows: Iterable[LedgerRow], last_id: int, run_id: int) -> int:
        """Upsert a batch and advance the checkpoint in the same transaction."""
        tuples = [r.as_tuple() for r in rows]
        now = time.time()
        with self.conn:
            self.conn.executemany(
                "INSERT INTO transactions "
                "(id, amount_minor, currency, merchant_id, status, kind, created_at) "
                "VALUES (?, ?, ?, ?, ?, ?, ?) "
                "ON CONFLICT(id) DO UPDATE SET amount_minor=excluded.amount_minor, "
                "currency=excluded.currency, merchant_id=excluded.merchant_id, "
                "status=excluded.status, kind=excluded.kind, created_at=excluded.created_at",
                tuples,
            )
            self.conn.execute(
                "INSERT INTO backfill_checkpoint (name, last_id, updated) VALUES (?, ?, ?) "
                "ON CONFLICT(name) DO UPDATE SET last_id=excluded.last_id, updated=excluded.updated",
                (CHECKPOINT, last_id, now),
            )
            self.conn.execute(
                "UPDATE backfill_runs SET rows_written = rows_written + ?, last_progress = ? "
                "WHERE run_id = ?",
                (len(tuples), now, run_id),
            )
        return len(tuples)

    # -- run bookkeeping -----------------------------------------------------
    def start_run(self, resumed_from: int) -> int:
        now = time.time()
        with self.conn:
            cur = self.conn.execute(
                "INSERT INTO backfill_runs "
                "(jobrun_id, pid, resumed_from, started_at, last_progress, status) "
                "VALUES (?, ?, ?, ?, ?, 'running')",
                (os.environ.get("JOBRUN_ID"), os.getpid(), resumed_from, now, now),
            )
        return int(cur.lastrowid)

    def finish_run(self, run_id: int, status: str) -> None:
        with self.conn:
            self.conn.execute(
                "UPDATE backfill_runs SET finished_at = ?, status = ? WHERE run_id = ?",
                (time.time(), status, run_id),
            )

    def count(self) -> int:
        return int(self.conn.execute("SELECT COUNT(*) FROM transactions").fetchone()[0])
