[?2004l"""Map legacy export rows onto the new ledger schema.

Legacy rows look like::

    {"id": 41, "amount": "129.90", "currency": "EUR", "merchant_id": " m_00412",
     "status": "S", "kind": "payment", "created_at": "2024-03-01T10:22:05Z"}

The new ledger stores money as an integer count of the currency's minor unit
(ISO 4217 exponent): EUR 129.90 -> 12990, JPY 1500 -> 1500, KWD 12.345 -> 12345.
"""

from __future__ import annotations

from dataclasses import dataclass

# ISO 4217 minor-unit exponents for every currency the legacy system ever accepted.
CURRENCY_EXPONENTS = {
    "USD": 2,
    "EUR": 2,
    "GBP": 2,
    "INR": 2,
    "SGD": 2,
    "JPY": 0,
    "KRW": 0,
    "KWD": 3,
    "BHD": 3,
    "OMR": 3,
}

STATUS_MAP = {
    "S": "settled",
    "P": "pending",
    "F": "failed",
    "R": "reversed",
}

KINDS = {"payment", "refund"}

UNATTRIBUTED_MERCHANT = "UNATTRIBUTED"


class TransformError(ValueError):
    pass


@dataclass(frozen=True)
class LedgerRow:
    id: int
    amount_minor: int
    currency: str
    merchant_id: str
    status: str
    kind: str
    created_at: str

    def as_tuple(self) -> tuple:
        return (
            self.id,
            self.amount_minor,
            self.currency,
            self.merchant_id,
            self.status,
            self.kind,
            self.created_at,
        )


def to_minor_units(amount: str, currency: str) -> int:
    """Convert a legacy decimal amount string to integer minor units."""
    if currency not in CURRENCY_EXPONENTS:
        raise TransformError(f"unsupported currency {currency!r}")
    # The legacy UI only ever showed two decimal places.
    return int(round(float(amount) * 100))


def normalise_merchant(merchant_id: str | None) -> str:
    merchant = merchant_id.strip()
    if not merchant:
        raise TransformError("empty merchant id")
    return merchant


def map_status(code: str) -> str:
    try:
        return STATUS_MAP[code]
    except KeyError:
        raise TransformError(f"unknown status code {code!r}") from None


def transform_row(row: dict) -> LedgerRow:
    currency = str(row["currency"]).upper()
    kind = row.get("kind", "payment")
    if kind not in KINDS:
        raise TransformError(f"unknown kind {kind!r} on row {row.get('id')}")
    return LedgerRow(
        id=int(row["id"]),
        amount_minor=to_minor_units(str(row["amount"]), currency),
        currency=currency,
        merchant_id=normalise_merchant(row.get("merchant_id")),
        status=map_status(row["status"]),
        kind=kind,
        created_at=row["created_at"],
    )


def transform_page(rows: list[dict]) -> list[LedgerRow]:
    return [transform_row(r) for r in rows]
import pytest

from backfill.transform import (
    UNATTRIBUTED_MERCHANT,
    TransformError,
    to_minor_units,
    transform_row,
)


def legacy(**overrides):
    row = {
        "id": 7,
        "amount": "129.90",
        "currency": "EUR",
        "merchant_id": "m_00412",
        "status": "S",
        "kind": "payment",
        "created_at": "2024-03-01T10:22:05Z",
    }
    row.update(overrides)
    return row


def test_two_decimal_currency():
    assert to_minor_units("129.90", "EUR") == 12990
    assert to_minor_units("0.05", "USD") == 5


def test_refund_amounts_stay_negative():
    assert to_minor_units("-42.10", "GBP") == -4210


def test_zero_decimal_currency():
    assert to_minor_units("1500", "JPY") == 1500


def test_unknown_currency_rejected():
    with pytest.raises(TransformError):
        to_minor_units("10.00", "XYZ")


def test_full_row_mapping():
    out = transform_row(legacy(currency="usd", merchant_id="  m_00412 ", status="R", kind="refund"))
    assert out.as_tuple() == (7, 12990, "USD", "m_00412", "reversed", "refund", "2024-03-01T10:22:05Z")


def test_unknown_status_rejected():
    with pytest.raises(TransformError):
        transform_row(legacy(status="Z"))


def test_missing_merchant_goes_to_unattributed():
    out = transform_row(legacy(merchant_id=None))
    assert out.merchant_id == UNATTRIBUTED_MERCHANT
